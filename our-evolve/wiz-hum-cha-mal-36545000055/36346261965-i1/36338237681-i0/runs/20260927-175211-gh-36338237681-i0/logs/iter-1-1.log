{"type":"tool_use","timestamp":1790531878701,"sessionID":"ses_f1bfdb0f7ffeZlkE5FkbKms7fE","part":{"type":"tool","tool":"read","callID":"call-1e0a2aab-d5fa-4098-8739-52e7679a7ac8","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/global_logic.py"},"output":"<path>/workspace/autoascend/global_logic.py</path>\n<type>file</type>\n<content>\n1: from enum import IntEnum, auto\n2: \n3: import nle.nethack as nh\n4: import numpy as np\n5: from nle.nethack import actions as A\n6: \n7: from . import objects as O\n8: from . import soko_solver\n9: from . import utils\n10: from . import jf_config\n11: from . import power\n12: from . import castle_power\n13: from .character import Character\n14: from .dive_logic import DiveLogic\n15: from .exceptions import AgentPanic\n16: from .glyph import Hunger, G, MON\n17: from .item import Item, flatten_items\n18: from .item.item_priority_base import ItemPriorityBase\n19: from .level import Level\n20: from .strategy import Strategy\n21: \n22: \n23: class ItemPriority(ItemPriorityBase):\n24:     MAX_NUMBER_OF_ITEMS = 26 * 2 - 1  # + coin slot, one slot should be left for item arranging\n25:     def __init__(self, agent):\n26:         self.agent = agent\n27:         self._take_sacrificial_corpses = False\n28:         self._drop_gold_till_turn = -float('inf')\n29: \n30:     def _split(self, items, forced_items, weight_capacity):\n31:         remaining_weight = weight_capacity\n32:         ret_inv = {}\n33:         for item in forced_items:\n34:             remaining_weight -= item.weight()\n35:             ret_inv[item] = item.count\n36: \n37:         ret_bag = {}\n38:         bag = None\n39: \n40:         def add_item(item, count=None, to_bag=False):\n41:             nonlocal ret_inv, ret_bag, remaining_weight\n42:             assert isinstance(item, Item)\n43:             if to_bag and bag is not None and item is not bag:\n44:                 ret = ret_bag\n45:             else:\n46:                 ret = ret_inv\n47: \n48:             if remaining_weight < 0 or \\\n49:                     (ret is ret_inv and len(ret) >= ItemPriority.MAX_NUMBER_OF_ITEMS):  # TODO: coin slot\n50:                 return\n51: \n52:             how_many_already_total = ret_inv.get(item, 0) + ret_bag.get(item, 0)\n53:             how_many_already = ret.get(item, 0)\n54:             unit_weight = item.unit_weight(with_content=False)\n55:             # weightless items (e.g. wraith corpses) would make this an infinite count\n56:             max_to_add = item.count if unit_weight <= 0 else int(remaining_weight // unit_weight)\n57:             if count is not None:\n58:                 max_to_add = min(max_to_add, count)\n59:             ret[item] = min(item.count, how_many_already_total + max_to_add) - (how_many_already_total - how_many_already)\n60:             remaining_weight -= item.unit_weight(with_content=False) * (ret[item] - how_many_already)\n61: \n62:         for item in items:\n63:             if item.is_container() and item.status in [Item.UNCURSED, Item.BLESSED] and item.objs[0].desc == 'bag':\n64:                 bag = item  # TODO: select the best\n65:                 add_item(bag)\n66: \n67:         if self._drop_gold_till_turn < self.agent.blstats.time:\n68:             for item in items:\n69:                 if item.category == nh.COIN_CLASS:\n70:                     add_item(item)\n71: \n72:         for allow_unknown_status in [False, True]:\n73:             item = self.agent.inventory.get_best_melee_weapon(items=forced_items + items,\n74:                                                               allow_unknown_status=allow_unknown_status)\n75:             if item is not None:\n76:                 add_item(item)\n77: \n78:             # TOOL_KEEP_FIRST: the digging tool before the armor set (a splint mail pushed a pick-axe out)\n79:             dive_ = getattr(self.agent.global_logic, 'dive', None)\n80:             if jf_config.TOOL_KEEP_FIRST and not allow_unknown_status and dive_ is not None and \\\n81:                     dive_.keep_digging_tool():\n82:                 tool = dive_.best_digging_tool(forced_items + items)\n83:                 if tool is not None:\n84:                     add_item(tool)\n85: \n86:             no_shield = dive_ is not None and dive_.mattock_digger()\n87:             for item in self.agent.inventory.get_best_armorset(items=forced_items + items,\n88:                                                                allow_unknown_status=allow_unknown_status):\n89:                 if item is not None and not (no_shield and getattr(item.objs[0], 'sub', None) == O.ARM_SHIELD):\n90:                     add_item(item)\n91: \n92:         # the dive digs down with a pick-axe: keep one (the tour drops them for lighter loot)\n93:         dive = getattr(self.agent.global_logic, 'dive', None)\n94:         if dive is not None and dive.keep_digging_tool():\n95:             tool = dive.best_digging_tool(forced_items + items)\n96:             if tool is not None:\n97:                 add_item(tool)\n98: \n99:         # power: boots that may be levitation or water walking boots, for the Castle's moat (never worn before)\n100:         if jf_config.KEEP_MAGIC_BOOTS:\n101:             for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n102:                 if power.is_passage_boots(item) and not item.equipped:\n103:                     add_item(item)\n104: \n105:         for item in items:\n106:             if item.is_unambiguous():\n107:                 if item.object in [\n108:                         O.from_name('healing', nh.POTION_CLASS),\n109:                         O.from_name('extra healing', nh.POTION_CLASS),\n110:                         O.from_name('full healing', nh.POTION_CLASS)]:\n111:                     add_item(item)\n112: \n113:                 if self.agent.character.role in [Character.RANGER, Character.ROGUE,\n114:                                                  Character.SAMURAI, Character.TOURIST] and \\\n115:                         (item.is_launcher() or item.is_fired_projectile()):\n116:                     add_item(item)\n117: \n118:         if self.agent.character.alignment == Character.LAWFUL:\n119:             for item in sorted(filter(lambda i: i.objs[0].name == 'long sword', items),\n120:                                key=lambda i: -utils.calc_dps(*self.agent.character.get_melee_bonus(i))):\n121:                 add_item(item)\n122:                 break\n123: \n124:         # power (KEEP_POTIONS): in 23 of 90 base games potion types were dropped for good, mostly for daggers\n125:         # and the dive's pick-axe/mattock (the pack is full: plate mail 450 + tool 100-120). Each unknown potion\n126:         # is levitation 4.6% of the time, the likeliest Castle passage. While diving (digging, few fights):\n127:         # food first, then the passage candidates, then the thrown weapons.\n128:         if jf_config.KEEP_POTIONS and dive is not None and dive.diving:\n129:             for item in sorted(filter(lambda i: i.is_food() and not i.is_corpse(), items),\n130:                                key=lambda x: -x.nutrition_per_weight() - 1000 * (x.objs[0].name == 'sprig of wolfsbane')):\n131:                 add_item(item)\n132:             for item in sorted(filter(power.is_passage_candidate, items),\n133:                                key=lambda i: i.unit_weight(with_content=False)):\n134:                 add_item(item)\n135: \n136:         for item in sorted(filter(lambda i: i.is_thrown_projectile(), items),\n137:                            key=lambda i: -utils.calc_dps(*self.agent.character.get_ranged_bonus(None, i))):\n138:             add_item(item)\n139: \n140:         for item in sorted(filter(lambda i: i.is_food() and not i.is_corpse(), items),\n141:                            key=lambda x: -x.nutrition_per_weight() - 1000 * (x.objs[0].name == 'sprig of wolfsbane')):\n142:             add_item(item)\n143: \n144:         if jf_config.LICHEN_RESERVE:\n145:             # a never-rotting food reserve (lichen, lizard corpses) for the Weak spells before a safe prayer\n146:             # (agent.reserve_corpse): eaten by eat_from_inventory, like found rations\n147:             left = jf_config.LICHEN_RESERVE\n148:             for item in filter(lambda i: i.is_corpse() and i.monster_id in self.agent.RESERVE_CORPSE_IDS, items):\n149:                 if left <= 0:\n150:                     break\n151:                 add_item(item, count=left)\n152:                 left -= min(item.count, left)\n153: \n154:         if self._take_sacrificial_corpses:\n155:             for item in filter(self.agent.global_logic.can_sacrify, items):\n156:                 add_item(item)\n157: \n158:         # TODO: take nh.COIN_CLASS once shopping is implemented.\n159:         # You have to drop all coins not to be attacked by a vault guard\n160: \n161:         for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n162:             if item.category in [nh.POTION_CLASS, nh.RING_CLASS, nh.AMULET_CLASS, nh.WAND_CLASS, nh.SCROLL_CLASS, nh.TOOL_CLASS]:\n163:                 if (not isinstance(item.objs[0], O.Container) or not item.is_chest()) and \\\n164:                         not item.is_possible_container():\n165:                     to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n166:                              not item.is_offensive_usable_wand()\n167:                     to_bag = False\n168:                     if not item.is_container():  # remove condition to pick up bags\n169:                         add_item(item, to_bag=to_bag)\n170: \n171:         categories = [nh.WEAPON_CLASS, nh.ARMOR_CLASS, nh.TOOL_CLASS, nh.FOOD_CLASS, nh.GEM_CLASS, nh.AMULET_CLASS,\n172:                       nh.RING_CLASS, nh.POTION_CLASS, nh.SCROLL_CLASS, nh.SPBOOK_CLASS, nh.WAND_CLASS]\n173:         for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n174:             if item.category in categories and not isinstance(item.objs[0], O.Container) and not item.is_corpse():\n175:                 if item.status == Item.UNKNOWN:\n176:                     to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n177:                              not item.is_offensive_usable_wand()\n178:                     to_bag = False\n179:                     if not item.is_container():  # remove condition to pick up bags\n180:                         add_item(item, to_bag=to_bag)\n181: \n182:         r = {None: [ret_inv.get(item, 0) for item in items]}\n183:         if bag is not None:\n184:             r[bag] = [ret_bag.get(item, 0) for item in items]\n185:         for item in items:\n186:             if item.is_container() and item is not bag and ret_inv.get(item, 0) != 0:\n187:                 r[item] = [0 for _ in items]\n188:         return r\n189: \n190: \n191: class Milestone(IntEnum):\n192:     BE_ON_FIRST_LEVEL = auto()\n193:     FIND_GNOMISH_MINES = auto()\n194:     # FIND_LIGHT_GNOMISH_MINES = auto()\n195:     # FARM_LIGHT_GNOMISH_MINES = auto()\n196:     FIND_MINETOWN = auto()\n197:     FIND_SOKOBAN = auto()\n198:     SOLVE_SOKOBAN = auto()\n199:     FIND_MINES_END = auto()\n200:     GO_DOWN = auto() # TODO\n201: \n202: \n203: \n204: \n205: class GlobalLogic:\n206:     def __init__(self, agent):\n207:         self.agent = agent\n208:         self.milestone = Milestone(1)\n209:         self.step_completion_log = {}  # Milestone -> (step, turn)\n210: \n211:         self.item_priority = ItemPriority(self.agent)\n212: \n213:         self.oracle_level = None\n214:         self.minetown_level = None\n215: \n216:         self._got_artifact = False\n217:         self._milestone_since = {}   # milestone -> turn it began (jf_config.MINES_SEARCH_TURNS)\n218:         self._stall_anchor = None    # (level key, (y, x), turn, milestone) the tour has kept close to\n219:         self._pick_trip_start = None\n220:         self._pick_trip_done = False\n221:         self.mines_not_found = False\n222: \n223:         self.dive = DiveLogic(agent)\n224: \n225:     def update(self):\n226:         self.dive.update()\n227: \n228:         if not self.agent.character.prop.hallu:\n229:             if utils.isin(self.agent.glyphs, G.ORACLE).any():\n230:                 if self.oracle_level is None:\n231:                     self.oracle_level = self.agent.current_level().key()\n232:                 else:\n233:                     assert self.oracle_level == self.agent.current_level().key()\n234: \n235:             if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n236:                     utils.isin(self.agent.glyphs, G.SHOPKEEPER).any():\n237:                 if self.minetown_level is None:\n238:                     self.minetown_level = self.agent.current_level().key()\n239:                 else:\n240:                     assert self.minetown_level == self.agent.current_level().key()\n241: \n242:     @utils.debug_log('solving sokoban')\n243:     @Strategy.wrap\n244:     def solve_sokoban_strategy(self):\n245:         # TODO: refactor\n246:         if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n247:             yield False\n248:         yield True\n249: \n250:         def push_bolder(ty, tx, dy, dx):\n251:             while 1:\n252:                 if self.agent.bfs()[ty, tx] == -1:\n253:                     return False\n254:                 self.agent.go_to(ty, tx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n255:                 with self.agent.atom_operation():\n256:                     direction = self.agent.calc_direction(ty, tx, ty + dy, tx + dx)\n257:                     self.agent.direction(direction)\n258:                     message = self.agent.message\n259: \n260:                 if (self.agent.blstats.y, self.agent.blstats.x) == (ty, tx):\n261:                     assert 'You hear a monster behind the boulder.' in message or \\\n262:                            'You try to move the boulder, but in vain.' in message, message\n263:                     if self.agent.bfs()[ty + dy, tx + dx] != -1:\n264:                         self.agent.go_to(ty + dy, tx + dx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n265:                         continue\n266:                     else:\n267:                         pickaxe = None\n268:                         for item in flatten_items(self.agent.inventory.items):\n269:                             if item.is_unambiguous() and \\\n270:                                     item.object in [O.from_name('pick-axe'), O.from_name('dwarvish mattock')]:\n271:                                 pickaxe = item\n272:                                 break\n273:                         if pickaxe is not None:\n274:                             with self.agent.atom_operation():\n275:                                 pickaxe = self.agent.inventory.move_to_inventory(pickaxe)\n276:                                 self.agent.step(A.Command.APPLY)\n277:                                 self.agent.type_text(self.agent.inventory.items.get_letter(pickaxe))\n278:                                 self.agent.direction(direction)\n279:                             return True\n280:                 else:\n281:                     return True\n282: \n283:                 # TODO: not sure what to do\n284:                 self.agent.exploration.explore1(None).run()\n285: \n286:         while 1:\n287:             wall_map = utils.isin(self.agent.current_level().objects, G.WALL)\n288:             for smap, answer in soko_solver.maps.items():\n289:                 sokomap = soko_solver.convert_map(smap)\n290:                 offset = np.array(min(zip(*wall_map.nonzero()))) - \\\n291:                          np.array(min(zip(*(sokomap.sokomap == soko_solver.WALL).nonzero())))\n292:                 mask = wall_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n293:                                 offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n294:                 if (mask & (sokomap.sokomap == soko_solver.WALL) == mask).all():\n295:                     break\n296:             else:\n297:                 assert 0, 'sokomap not found'\n298: \n299:             possible_mimics = set()\n300:             last_resort_move = None\n301:             for (y, x), (dy, dx) in answer:\n302:                 boulder_map = utils.isin(self.agent.glyphs, G.BOULDER)\n303:                 mask = boulder_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n304:                                    offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n305:                 ty, tx = offset[0] + y - dy, offset[1] + x - dx,\n306:                 soko_boulder_mask = sokomap.sokomap == soko_solver.BOULDER\n307:                 if self.agent.bfs()[ty, tx] != -1 and \\\n308:                         ((soko_boulder_mask | mask) == soko_boulder_mask).all() and \\\n309:                         self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER:\n310: \n311:                     soko_dis1 = sokomap.bfs()\n312:                     sokomap.move(y, x, dy, dx)\n313:                     soko_dis2 = sokomap.bfs()\n314: \n315:                     # see points that will no longer be accessible\n316:                     with self.agent.env.debug_log('checking for monsters'):\n317:                         to_visit_mask = self.agent.bfs() != -1\n318:                         to_visit_mask[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n319:                                       offset[1] : offset[1] + sokomap.sokomap.shape[1]] &= \\\n320:                                               (soko_dis1 != -1) & (soko_dis2 == -1)\n321: \n322:                         with self.agent.env.debug_tiles(to_visit_mask, color=(255, 0, 0, 128)):\n323:                             while to_visit_mask.any():\n324:                                 vy, vx = list(zip(*to_visit_mask.nonzero()))[0]\n325:                                 to_visit_mask[vy, vx] = 0\n326: \n327:                                 def clear_neighbors():\n328:                                     to_visit_mask[self.agent.blstats.y, self.agent.blstats.x] = 0\n329:                                     to_visit_mask[utils.isin(self.agent.glyphs, G.VISIBLE_FLOOR)] = 0\n330:                                     return not to_visit_mask[vy, vx]\n331: \n332:                                 self.agent.go_to(vy, vx, callback=clear_neighbors)\n333: \n334:                     if not push_bolder(ty, tx, dy, dx):\n335:                         continue\n336: \n337:                     possible_mimics = set()\n338:                     last_resort_move = None\n339: \n340:                     if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n341:                         return\n342: \n343:                 else:\n344:                     sokomap.move(y, x, dy, dx)\n345: \n346:                 if (~soko_boulder_mask | mask).all():\n347:                     if self.agent.bfs()[ty, tx] != -1 and \\\n348:                             self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER and \\\n349:                             last_resort_move is None:\n350:                         last_resort_move = (ty, tx, dy, dx)\n351: \n352:                     if not possible_mimics:\n353:                         for mim_y, mim_x in zip(*(~soko_boulder_mask & mask).nonzero()):\n354:                             possible_mimics.add((mim_y + offset[0], mim_x + offset[1]))\n355: \n356: \n357:             # sokoban configuration is not in the list. Check for mimics\n358:             with self.agent.env.debug_log('mimics'):\n359:                 with self.agent.env.debug_tiles(possible_mimics, color=(255, 0, 0, 128)):\n360:                     for mim_y, mim_x in sorted(possible_mimics):\n361:                         if (self.agent.bfs()[max(0, mim_y - 1) : mim_y + 2, max(0, mim_x - 1) : mim_x + 2] != -1).any():\n362:                             self.agent.go_to(mim_y, mim_x, stop_one_before=True,\n363:                                              debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n364:                             for _ in range(3):\n365:                                 self.agent.search()\n366: \n367:             # last resort move (sometimes we can see a mimic diagonally but cannot reach it)\n368:             with self.agent.env.debug_log('last_resort'):\n369:                 if last_resort_move is not None:\n370:                     ty, tx, dy, dx = last_resort_move\n371:                     push_bolder(ty, tx, dy, dx)\n372:                     continue\n373: \n374:             self.agent.stats_logger.log_event('sokoban_dropped')\n375:             self.milestone = Milestone(int(self.milestone) + 1)\n376:             raise AgentPanic('sokomap unsolvable')\n377: \n378:     @Strategy.wrap\n379:     def wait_out_unexpected_state_strategy(self):\n380:         yielded = False\n381:         # CASTLE_POLY: on the castle a polymorph is the way over the moat (castle_power): keep acting in the form\n382:         castle_poly = lambda: jf_config.CASTLE_POLY and self.dive.castle.active()\n383:         while (\n384:                 self.agent.character.prop.blind or\n385:                 self.agent.character.prop.confusion or\n386:                 self.agent.character.prop.stun or\n387:                 self.agent.character.prop.hallu or\n388:                 (self.agent.character.prop.polymorph and not castle_poly())):\n389:             if not yielded:\n390:                 yield True\n391:                 yielded = True\n392: \n393:             self.agent.direction('.')\n394: \n395:         if not yielded:\n396:             yield False\n397: \n398:     @utils.debug_log('identify_items_on_altar')\n399:     @Strategy.wrap\n400:     def identify_items_on_altar(self):\n401:         mask = utils.isin(self.agent.current_level().objects, G.ALTAR)\n402:         if not mask.any():\n403:             yield False\n404: \n405:         dis = self.agent.bfs()\n406:         mask &= dis != -1\n407:         if not mask.any():\n408:             yield False\n409: \n410:         yield any((item.status == Item.UNKNOWN for item in flatten_items(self.agent.inventory.items)\n411:                    if item.can_be_dropped_from_inventory()))\n412: \n413:         (ty, tx), *_ = zip(*(mask & (dis == dis[mask].min())).nonzero())\n414:         self.agent.go_to(ty, tx)\n415:         items_to_drop = [item for item in flatten_items(self.agent.inventory.items)\n416:                          if item.can_be_dropped_from_inventory() and item.status == Item.UNKNOWN]\n417:         if not items_to_drop:\n418:             raise AgentPanic('items to drop on altar vanished')\n419: \n420:         # TODO: move chunking to inventory.drop\n421:         items_to_drop = items_to_drop[:self.agent.inventory.items.free_slots()]\n422: \n423:         self.agent.inventory.drop(items_to_drop)\n424: \n425:     @utils.debug_log('dip_for_excalibur')\n426:     @Strategy.wrap\n427:     def dip_for_excalibur(self):\n428:         if self.agent.character.alignment != Character.LAWFUL or self.agent.blstats.experience_level < 5:\n429:             yield False\n430:         if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n431:                 (self.minetown_level is None or self.agent.current_level().key() == self.minetown_level):\n432:             yield False\n433: \n434:         dis = self.agent.bfs()\n435:         mask = utils.isin(self.agent.current_level().objects, G.FOUNTAIN) & (dis != -1)\n436:         if not mask.any():\n437:             yield False\n438: \n439:         def excalibur_candidate():\n440:             candidate = None\n441:             for item in flatten_items(self.agent.inventory.items):\n442:                 if item.is_unambiguous() and item.object == O.from_name('long sword'):\n443:                     if item.dmg_bonus is not None: # TODO: better condition for excalibur existance\n444:                         return None\n445:                     candidate = item\n446:             return candidate\n447: \n448:         if excalibur_candidate() is None:\n449:             yield False\n450:         yield True\n451: \n452:         self.agent.go_to(*list(zip(*mask.nonzero()))[0])\n453: \n454:         candidate = excalibur_candidate()\n455:         if candidate is None:\n456:             return\n457: \n458:         # TODO: refactor\n459:         with self.agent.atom_operation():\n460:             candidate = self.agent.inventory.move_to_inventory(candidate)\n461:             self.agent.step(A.Command.DIP)\n462:             self.agent.type_text(self.agent.inventory.items.get_letter(candidate))\n463:             if ('What do you want to dip ' in self.agent.message and 'into?' in self.agent.message) or \\\n464:                     \"You don't have anything to dip \" in self.agent.message:\n465:                 raise AgentPanic('no fountain here')\n466: \n467:     def can_sacrify(self, item):\n468:         if not item.is_corpse() or item.comment == 'old':\n469:             return False\n470:         # picking up a cockatrice-family corpse bare-handed is instant stoning: two unseen-seed games died\n471:         # taking their thrown daggers back from a chickatrice's pile ('Touching a chickatrice corpse is a\n472:         # fatal mistake.'), the corpse selected to carry to an altar\n473:         if self.agent.inventory.items.gloves is None and \\\n474:                 item.monster_id + nh.GLYPH_MON_OFF in self.agent._petrifying_bodies_mons:\n475:             return False\n476: \n477:         mname = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mname\n478:         # sacrificing a former pet: \"So this is how you repay loyalty?\", the god gets angry (an unseen\n479:         # Valkyrie offered her kitten, then again: an Angel of Tyr killed her at T2197). The old check here\n480:         # compared role == [list] (never true) and missed the Valkyrie's kitten; any grown-up pet species\n481:         # may be ours, so none of them is offered\n482:         if mname in ('kitten', 'housecat', 'large cat', 'little dog', 'dog', 'large dog', 'pony', 'horse',\n483:                      'warhorse'):\n484:             return False\n485: \n486:         if self.agent.character.alignment != Character.CHAOTIC:\n487:             mapping = {\n488:                 Character.HUMAN: MON.M2_HUMAN | MON.M2_WERE,\n489:                 Character.DWARF: MON.M2_DWARF,\n490:                 Character.ELF: MON.M2_ELF,\n491:                 Character.GNOME: MON.M2_GNOME,\n492:                 Character.ORC: MON.M2_ORC,\n493:             }\n494:             f2 = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mflags2\n495:             if (f2 & mapping[self.agent.character.race]) > 0:\n496:                 return False\n497: \n498:         return True\n499: \n500:     @utils.debug_log('offer_corpses')\n501:     @Strategy.wrap\n502:     def offer_corpses(self):\n503:         self.item_priority._take_sacrificial_corpses = False\n504: \n505:         if self._got_artifact:\n506:             yield False\n507: \n508:         altars = [p for p, alignment in self.agent.current_level().altars.items()\n509:                   if alignment == self.agent.character.alignment]\n510: \n511:         if not altars:\n512:             yield False\n513: \n514:         dis = self.agent.bfs()\n515:         altars = [(y, x) for y, x in altars if dis[y, x] != -1]\n516: \n517:         if not altars:\n518:             yield False\n519: \n520:         self.item_priority._take_sacrificial_corpses = True\n521: \n522:         if not any((self.can_sacrify(item) for item in flatten_items(self.agent.inventory.items))):\n523:             yield False\n524: \n525:         yield True\n526: \n527:         y, x = min(altars, key=lambda p: dis[p])\n528:         self.agent.go_to(y, x)\n529:         with self.agent.panic_if_position_changes():\n530:             while 1:\n531:                 for item in flatten_items(self.agent.inventory.items):\n532:                     if self.can_sacrify(item):\n533:                         with self.agent.atom_operation():\n534:                             item = self.agent.inventory.move_to_inventory(item)\n535:                             assert self.can_sacrify(item)\n536:                             self.agent.step(A.Command.OFFER)\n537:                             while ('There is ' in self.agent.message or 'There are ' in self.agent.message) and \\\n538:                                     ('sacrifice it?' in self.agent.message or 'sacrifice one?' in self.agent.message):\n539:                                 self.agent.type_text('n')\n540:                             assert 'What do you want to sacrifice?' in self.agent.message, self.agent.message\n541:                             self.agent.type_text(self.agent.inventory.items.get_letter(item))\n542:                             if 'Nothing happens.' in self.agent.message:\n543:                                 self.agent.inventory.call_item(item, 'old')\n544:                                 return\n545:                             if 'Use my gift wisely' in self.agent.message:\n546:                                 self._got_artifact = True\n547:                                 self.agent.inventory.get_items_below_me()\n548:                                 return\n549:                             if 'So this is how you repay loyalty?' in self.agent.message:\n550:                                 raise AgentPanic('pet sacrified')\n551:                             assert 'Your sacrifice is consumed in a flash of light' in self.agent.message or \\\n552:                                 'Your sacrifice is consumed in a burst of flame' in self.agent.message or \\\n553:                                 ('The blood covers the altar!' in self.agent.message and \\\n554:                                  'You have summoned ' in self.agent.message), \\\n555:                                 self.agent.message\n556:                             break\n557:                 else:\n558:                     break\n559: \n560:     @utils.debug_log('follow_guard')\n561:     @Strategy.wrap\n562:     def follow_guard(self):\n563:         if not utils.isin(self.agent.glyphs, G.GUARD).any():\n564:             yield False\n565: \n566:         if any(item.category == nh.COIN_CLASS for item in flatten_items(self.agent.inventory.items)):\n567:             yield True\n568:             # if 'Please drop that gold and follow me.' in self.message:\n569:             self.agent.stats_logger.log_event('drop_gold')\n570:             self.item_priority._drop_gold_till_turn = self.agent.blstats.time + 100\n571:             self.agent.inventory.arrange_items().run()\n572:             return\n573: \n574:         ys, xs = utils.isin(self.agent.glyphs, G.GUARD).nonzero()\n575:         y, x = ys[0], xs[0]\n576: \n577:         if utils.adjacent((y, x), (self.agent.blstats.y, self.agent.blstats.x)):\n578:             yield False\n579: \n580:         yield True\n581: \n582:         self.agent.go_to(y, x, stop_one_before=True)\n583: \n584:     def _safe_to_dip(self):\n585:         # SAFE_DIPS (full HP + prayer ready, astra) changes the tour; off until tested on its own\n586:         bl = self.agent.blstats\n587:         # NO_DIP_WITH_TOOL: a fountain dip curses the sword 1 time in 30, silently (fountain.c case 16), and a\n588:         # welded weapon can't be swapped for the pick-axe: eg-glh-public seed 6 carried its pick from T6556, dipped\n589:         # 8 times at XL 7, and dove at XL 8 with 'a cursed thoroughly rusty +1 long sword (weapon in hand)' --\n590:         # digging_tool() None, a tool-less dive (0.206; base 0.466). A digger doesn't need Excalibur.\n591:         if jf_config.NO_DIP_WITH_TOOL and self.dive.digging_tool() is not None:\n592:             return False\n593:         # DEMON_NO_REDIP: not while a released water demon is about -- when it fled out of the vigil's reach the\n594:         # bot walked back to the fountain and dipped twice more next to it, then fought it (DEMON_FIX replay of\n595:         # jf16 s8: killed by the demon 480 turns after the release)\n596:         if jf_config.DEMON_NO_REDIP and bl.time <= self.dive._demon_vigil_until:\n597:             return False\n598:         if not jf_config.SAFE_DIPS:\n599:             # a released water demon (1 dip in ~40) is deadlier to a starving or hurt character; dipping\n600:             # can wait for a healthy moment (SAFE_DIPS' prayer-ready rule halved the Excaliburs)\n601:             return bl.experience_level >= 7 and bl.hunger_state < Hunger.WEAK and \\\n602:                 bl.hitpoints >= 0.7 * bl.max_hitpoints\n603:         return bl.experience_level >= 7 and bl.hitpoints >= 0.9 * bl.max_hitpoints and \\\n604:             self.agent.is_safe_to_pray(800)\n605: \n606:     def exploration_strategy(self, search_prio_limit):\n607:         \"\"\"The tour's exploration (used by the dive phase too).\"\"\"\n608:         return (\n609:             Strategy(lambda: self.agent.exploration.explore1(\n610:                 search_prio_limit, trap_search_offset=1,\n611:                 kick_doors=self.agent.current_level().dungeon_number != Level.GNOMISH_MINES).strategy())\n612:             .preempt(self.agent, [\n613:                 self.identify_items_on_altar().every(100),\n614:                 self.identify_items_on_altar().condition(\n615:                     lambda: self.agent.current_level().objects[self.agent.blstats.y,\n616:                                                                self.agent.blstats.x] in G.ALTAR),\n617:                 # hypothesis: fountain dips summon water demons (killed an XL9 elite game); dip only\n618:                 # at (near) full HP with a prayer in hand, as astra did (full HP, retreat ready)\n619:                 self.dip_for_excalibur().condition(self._safe_to_dip).every(10),\n620:             ])\n621:         )\n622: \n623:     def _pick_trip_active(self):\n624:         agent = self.agent\n625:         if not jf_config.PICK_TRIP_XL or self._pick_trip_done:\n626:             return False\n627:         if self.dive.digging_tool() is not None:\n628:             agent.log('TOUR pick trip: got a digging tool, back to the grind')\n629:             self._pick_trip_done = True\n630:             return False\n631:         if agent.prayer_failed or agent.blstats.experience_level < jf_config.PICK_TRIP_XL:\n632:             return False\n633:         start = self._pick_trip_start\n634:         if start is not None and jf_config.PICK_TRIP_END_XL and \\\n635:                 agent.blstats.experience_level >= jf_config.PICK_TRIP_END_XL:\n636:             # an XL-7 character on Dlvl 3-6 meets difficulty-5/6 monsters ((depth + XL) / 2): 4 of 60 pt5/pt6\n637:             # games died there to killer bees, soldier ants and orcish arrows, none during the XL 5-6 trips\n638:             agent.log(f'TOUR pick trip: XL {agent.blstats.experience_level} without a tool, back to the grind')\n639:             self._pick_trip_done = True\n640:             return False\n641:         if start is None:\n642:             self._pick_trip_start = agent.blstats.time\n643:             agent.log('TOUR pick trip: off to the Mines for a digging tool')\n644:         elif agent.blstats.time - start > jf_config.PICK_TRIP_TURNS:\n645:             agent.log('TOUR pick trip: out of time, back to the grind')\n646:             self._pick_trip_done = True\n647:             return False\n648:         return True\n649: \n650:     def _grind_level(self):\n651:         \"\"\"jf_config.GRIND_LEVELS {min XL: Dlvl}: the grind's main-dungeon level at this XL (None: the flag is off).\n652: \n653:         Random monsters are capped at difficulty (depth + XL) / 2 (makemon.c). On Dlvl 1 that cap is 3 at XL 5-6,\n654:         so XL 5 -> 7 takes ~9,000 turns there (base: ~3,500 + ~5,500) at ~12 hunger prayers per grind, and the\n655:         prayers' rnz(350) failures end 13 of 45 gc-lf1 games in a rescue. Keeping the cap at 4 instead (Dlvl 3 at\n656:         XL 5-6, Dlvl 2 at XL 7) doubles XP per spawn at XL 5-6 (monst.c model: 3.8-4.9 -> 8.3-10.8), so fewer\n657:         turns and prayers, while killer bees, soldier ants and Uruk-hai (difficulty 5-6) stay out: the old\n658:         Dlvl-3 grind at XL 7 (cap 5) lost 4.9-7.8% of games per 1000 turns. Dwarves (difficulty 4) spawn from\n659:         XL 5 there, and the pet kills them for their pick-axes as it does on Dlvl 1 from XL 7.\"\"\"\n660:         table = jf_config.GRIND_LEVELS\n661:         if not table:\n662:             return None\n663:         xl = self.agent.blstats.experience_level\n664:         keys = [k for k in table if k <= xl]\n665:         return table[max(keys)] if keys else 1\n666: \n667:     def _tour_stalled(self):\n668:         \"\"\"The tour has kept within 8 squares of one spot on one level, same milestone, TOUR_STALL_TURNS turns.\"\"\"\n669:         bl = self.agent.blstats\n670:         key = self.agent.current_level().key()\n671:         a = self._stall_anchor\n672:         if a is None or a[0] != key or a[3] != self.milestone or \\\n673:                 max(abs(bl.y - a[1][0]), abs(bl.x - a[1][1])) > 8:\n674:             self._stall_anchor = (key, (bl.y, bl.x), bl.time, self.milestone)\n675:             return False\n676:         return bl.time - a[2] >= jf_config.TOUR_STALL_TURNS\n677: \n678:     @staticmethod\n679:     def _stall_goal_met(goal):\n680:         try:\n681:             return goal()\n682:         except Exception:\n683:             return False\n684: \n685:     def current_strategy(self):\n686:         # hypothesis: AutoAscend's levelling tour keeps the character alive to XL 10-13 (the elite's\n687:         # recipe); once it is strong, the depth-first dive with the Quest-portal sweep is worth more\n688:         # than further levelling (Home 1 = 0.366, Dlvl 20+ = 0.38+, vs XL 12 = 0.333).\n689:         return self.tour_strategy().until(self.agent, self.dive.should_dive).before(self.dive.strategy())\n690: \n691:     @Strategy.wrap\n692:     def tour_strategy(self):\n693:         yield True\n694:         while 1:\n695:             explore_stairs_condition = lambda: False\n696:             restart = lambda: False   # ends the current strategy without finishing the milestone\n697:             if self.milestone == Milestone.BE_ON_FIRST_LEVEL and self._pick_trip_active():\n698:                 # PICK_TRIP_XL: a detour from the grind to the Mines for a dwarf's pick-axe, then back to\n699:                 # Dlvl 1. With the pick in hand a failed hunger prayer (a quarter of all games) starts a\n700:                 # dig-dive instead of a starving stairs rescue, and the XL 8 dive needs no Mines trip.\n701:                 self.dive.pick_trip = True\n702:                 condition = lambda: False\n703:                 level = (Level.GNOMISH_MINES, jf_config.PICK_TRIP_LEVEL)\n704:                 restart = lambda: not self._pick_trip_active()\n705:             elif self.milestone == Milestone.BE_ON_FIRST_LEVEL:\n706:                 self.dive.pick_trip = False\n707:                 condition = self.dive.first_level_done\n708:                 # explore_stairs_condition = lambda: self.agent.inventory.items.total_nutrition() == 0 and \\\n709:                 #                                    self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY\n710:                 # GRIND_DEEP_XL: from that XL the grind goes on on Dlvl GRIND_DEEP_LEVEL -- on Dlvl 1 XL 6->8 takes\n711:                 # a median 11,500 turns (7 of the grind's ~11 hunger prayers): spawns there are too weak\n712:                 deep = bool(jf_config.GRIND_DEEP_XL) and \\\n713:                     self.agent.blstats.experience_level >= jf_config.GRIND_DEEP_XL\n714:                 level = (Level.DUNGEONS_OF_DOOM, jf_config.GRIND_DEEP_LEVEL if deep else 1)\n715:                 if jf_config.GRIND_DEEP_XL and not deep:\n716:                     restart = lambda: self.agent.blstats.experience_level >= jf_config.GRIND_DEEP_XL\n717:                 grind_level = self._grind_level()\n718:                 if grind_level is not None:\n719:                     # GRIND_LEVELS: the grind's level follows XL, see _grind_level\n720:                     level = (Level.DUNGEONS_OF_DOOM, grind_level)\n721:                     restart = lambda lv=grind_level: self._grind_level() != lv\n722: \n723:             elif self.milestone == Milestone.FIND_SOKOBAN:\n724:                 condition = lambda: self.agent.current_level().dungeon_number == Level.SOKOBAN\n725:                 level = (Level.SOKOBAN, 4)\n726: \n727:             elif self.milestone == Milestone.FIND_GNOMISH_MINES:\n728:                 since = self._milestone_since.setdefault(self.milestone, self.agent.blstats.time)\n729:                 # the branch hides behind unexplored rock on some Dlvl 2-4s: a jf9 game stood searching at\n730:                 # one Dlvl 4 spot for 1000+ turns, hunger-praying until a prayer failed (35 of 118 games\n731:                 # that left Dlvl 1 never reached the Mines; 14 of 83 that did needed 4000+ turns)\n732:                 condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES or \\\n733:                     (jf_config.MINES_SEARCH_TURNS and self.agent.blstats.time - since > jf_config.MINES_SEARCH_TURNS)\n734:                 level = (Level.GNOMISH_MINES, 1)\n735: \n736:             # elif self.milestone == Milestone.FIND_LIGHT_GNOMISH_MINES:\n737:             #     condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES \\\n738:             #             and self.agent.current_level().is_light_level()\n739:             #     level = (Level.GNOMISH_MINES, 9)\n740: \n741:             # elif self.milestone == Milestone.FARM_LIGHT_GNOMISH_MINES:\n742:             #     condition = lambda: self.agent.blstats.experience_level >= 11\n743:             #     level = (Level.GNOMISH_MINES, self.agent.current_level().level_number)\n744: \n745:             elif self.milestone == Milestone.FIND_MINETOWN:\n746:                 condition = lambda: self.minetown_level is not None\n747:                 level = (Level.GNOMISH_MINES, 4)  # TODO\n748: \n749:             elif self.milestone == Milestone.SOLVE_SOKOBAN:\n750:                 # TODO: fix the condition, monster can destroy doors\n751:                 condition = lambda: self.agent.current_level().key() == (Level.SOKOBAN, 1) and \\\n752:                                     not utils.isin(self.agent.current_level().objects, G.DOOR_CLOSED).any()\n753:                 level = (Level.SOKOBAN, 1)\n754: \n755:             elif self.milestone == Milestone.FIND_MINES_END:\n756:                 condition = lambda: self.agent.current_level().key() == (Level.GNOMISH_MINES, 9) or \\\n757:                     self.mines_not_found  # TODO\n758:                 level = (Level.GNOMISH_MINES, 9)  # TODO\n759: \n760:             else:\n761:                 # TODO\n762:                 condition = lambda: False\n763:                 level = (Level.DUNGEONS_OF_DOOM, 100)\n764: \n765:             goal = condition\n766:             watch_stall = Milestone.BE_ON_FIRST_LEVEL < self.milestone < Milestone.GO_DOWN and \\\n767:                 bool(jf_config.TOUR_STALL_TURNS)\n768:             if watch_stall:\n769:                 condition = lambda: goal() or self._tour_stalled()\n770: \n771:             if condition():\n772:                 if watch_stall and not self._stall_goal_met(goal) and self._tour_stalled():\n773:                     # held in one spot for TOUR_STALL_TURNS (a pocket we are too heavy to squeeze out of, a\n774:                     # passage a jelly blocks, a shop door...): the next milestone takes us somewhere else, the\n775:                     # last one (GO_DOWN) is the dive\n776:                     skip = Milestone.FIND_MINES_END if self.milestone in (Milestone.FIND_SOKOBAN,\n777:                                                                            Milestone.SOLVE_SOKOBAN) \\\n778:                         else Milestone(int(self.milestone) + 1)\n779:                     self.agent.log(f'TOUR stalled {jf_config.TOUR_STALL_TURNS} turns at {self._stall_anchor[:2]} '\n780:                                    f'in {self.milestone.name}: on to {skip.name}')\n781:                     if self.milestone == Milestone.FIND_GNOMISH_MINES:\n782:                         self.mines_not_found = True\n783:                     self.milestone = skip\n784:                     self._stall_anchor = None\n785:                     continue\n786:                 if self.milestone == Milestone.FIND_GNOMISH_MINES and \\\n787:                         self.agent.current_level().dungeon_number != Level.GNOMISH_MINES:\n788:                     self.agent.log(f'TOUR no Mines entrance after {jf_config.MINES_SEARCH_TURNS} turns: '\n789:                                    f'skipping Minetown, on to Sokoban')\n790:                     self.mines_not_found = True\n791:                     self.milestone = Milestone.FIND_SOKOBAN\n792:                     continue\n793:                 self.milestone = Milestone(int(self.milestone) + 1)\n794:                 if jf_config.SKIP_SOKOBAN and self.milestone in (Milestone.FIND_SOKOBAN, Milestone.SOLVE_SOKOBAN) \\\n795:                         and self.agent.character.race in (Character.DWARF, Character.GNOME):\n796:                     self.milestone = Milestone.FIND_MINES_END\n797:                 continue\n798: \n799: \n800:             def exploration_strategy(level, **kwargs):\n801:                 return (\n802:                     Strategy(lambda: self.agent.exploration.explore1(level, trap_search_offset=1,\n803:                         kick_doors=self.agent.current_level().dungeon_number != Level.GNOMISH_MINES, **kwargs).strategy())\n804:                     .preempt(self.agent, [\n805:                         self.identify_items_on_altar().every(100),\n806:                         self.identify_items_on_altar().condition(\n807:                             lambda: self.agent.current_level().objects[self.agent.blstats.y,\n808:                                                                        self.agent.blstats.x] in G.ALTAR),\n809:                         self.dip_for_excalibur().condition(self._safe_to_dip).every(10),\n810:                     ])\n811:                 )\n812: \n813:             def go_to_strategy(y, x):\n814:                 return (\n815:                     exploration_strategy(None)\n816:                     .preempt(self.agent, [\n817:                         self.agent.exploration.go_to_strategy(y, x).preempt(self.agent, [\n818:                             self.agent.inventory.gather_items(),\n819:                             self.identify_items_on_altar(),\n820:                             self.dip_for_excalibur().condition(self._safe_to_dip),\n821:                         ])\n822:                         .condition(lambda: self._got_artifact or\n823:                                            not any([alignment == self.agent.character.alignment\n824:                                                     for _, alignment in self.agent.current_level().altars.items()]))\n825:                     ])\n826:                     .until(self.agent, lambda: (self.agent.blstats.y, self.agent.blstats.x) == (y, x))\n827:                 )\n828: \n829:             def homebound(lv=level):\n830:                 \"\"\"In transit to the grind level: don't explore every level passed to exhaustion (the tour's\n831:                 first preempt). UPWARD_RETURN: on the way home from a pick trip (eg-trip5a public seed 9 ended\n832:                 its trip on Mines 1 at XL 7 and explored that level for 3,500 turns instead of climbing to\n833:                 the Dlvl 1 grind). GRIND_LEVELS: moving up to the next grind level (eg-gl-a public seed 11\n834:                 spent 4,000 turns at XL 7 on Dlvl 3 before climbing to Dlvl 2), or out of the Mines a\n835:                 random unexplored '>' took us into (seed 3 died on Mines 1).\"\"\"\n836:                 if self.milestone != Milestone.BE_ON_FIRST_LEVEL or self.agent.current_level().key() == lv:\n837:                     return False\n838:                 if jf_config.UPWARD_RETURN and self._pick_trip_done:\n839:                     return True\n840:                 cur = self.agent.current_level()\n841:                 return bool(jf_config.GRIND_LEVELS) and lv[0] == Level.DUNGEONS_OF_DOOM and \\\n842:                     (cur.dungeon_number == Level.GNOMISH_MINES or self.agent.blstats.depth > lv[1])\n843:             (\n844:                 self.agent.exploration.go_to_level_strategy(*level, go_to_strategy, exploration_strategy(None))\n845:                 .before(exploration_strategy(None))#.before(self.agent.exploration.patrol())\n846:                 .preempt(self.agent, [\n847:                     exploration_strategy(0).condition(lambda: not homebound()),\n848:                     exploration_strategy(None).until(\n849:                         self.agent, lambda: self.agent.blstats.hitpoints >= 0.8 * self.agent.blstats.max_hitpoints)\n850:                 ])\n851:                 .preempt(self.agent, [\n852:                     self.agent.exploration.explore_stairs(go_to_strategy, all=True).condition(explore_stairs_condition),\n853:                 ])\n854:                 .until(self.agent, lambda: condition() or restart())\n855:             ).run()\n856: \n857:     def global_strategy(self):\n858:         return (\n859:             self.current_strategy().repeat()\n860:             # lowest priority: a peaceful dwarf's pick-axe while in the Mines (dive_logic.DWARF_HUNT)\n861:             .preempt(self.agent, [\n862:                 self.dive.hunt_strategy(),\n863:                 self.dive.ditch_pet_strategy(),\n864:                 # a tour-mode pick trip looks for the Mines branch itself (dive_logic.FAST_BRANCH)\n865:                 self.dive.trip_branch_strategy(),\n866:             ])\n867:             .preempt(self.agent, [\n868:                 self.solve_sokoban_strategy()\n869:                 .condition(lambda: self.milestone == Milestone.SOLVE_SOKOBAN and\n870:                                    self.agent.current_level().dungeon_number == Level.SOKOBAN)\n871:             ])\n872:             .preempt(self.agent, [\n873:                 self.offer_corpses().preempt(self.agent, [\n874:                     self.agent.eat_corpses_from_ground().condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n875:                 ]),\n876:             ])\n877:             .preempt(self.agent, [\n878:                 self.wait_out_unexpected_state_strategy(),\n879:             ])\n880:             .preempt(self.agent, [\n881:                 self.agent.cure_disease().every(5),\n882:             ])\n883:             .preempt(self.agent, [\n884:                 self.agent.eat_corpses_from_ground(only_below_me=True).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n885:                 # CLAIM_CORPSES: a fresh kill a few steps away is ours before the pet gets it (the pet ate as many\n886:                 # jackal corpses as we did in the base grinds; 63% of its meals of our kills came 2+ turns after\n887:                 # the kill, while we walked elsewhere)\n888:                 self.agent.eat_corpses_from_ground(only_below_me=False, max_dist=jf_config.CLAIM_DIST,\n889:                                                    max_age=jf_config.CLAIM_MAX_AGE)\n890:                 .condition(lambda: jf_config.CLAIM_CORPSES and not self.dive.diving and\n891:                            self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n892:                 self.agent.eat_corpses_from_ground(only_below_me=not jf_config.EAT_NEARBY_CORPSES).every(5)\n893:                 .condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n894:                 # after a failed prayer corpses are the only food left: walk to the ones nearby\n895:                 self.agent.eat_corpses_from_ground(only_below_me=False).every(3)\n896:                 .condition(lambda: self.agent.prayer_failed and self.agent.blstats.hunger_state >= Hunger.HUNGRY),\n897:                 # DIVE_EAT: a hungry dive walks to fresh edible corpses close by (6 of 33 tool dives that died\n898:                 # above Dlvl 25 in base/base2 died Weak or Fainting, between hunger prayers)\n899:                 self.agent.eat_corpses_from_ground(only_below_me=False).every(3)\n900:                 .condition(lambda: jf_config.DIVE_EAT and self.dive.diving and not self.agent.prayer_failed and\n901:                            self.agent.blstats.hunger_state >= Hunger.HUNGRY and\n902:                            self.dive.edible_corpse_within(jf_config.DIVE_EAT_RADIUS)),\n903:                 self.agent.eat_from_inventory().every(5),\n904:                 self.agent.inventory.buy_food().every(3),\n905:                 # power (SELL_PRICE_ID): offer unknown potions/rings/boots to a shopkeeper for their price group\n906:                 self.agent.inventory.sell_price_identify().every(3),\n907:             ])\n908:             .preempt(self.agent, [\n909:                 # boxed in by diagonal squeezes while carrying > 600 (jf_config.UNSQUEEZE)\n910:                 self.agent.unsqueeze(),\n911:             ])\n912:             .preempt(self.agent, [\n913:                 self.follow_guard(),\n914:             ])\n915:             .preempt(self.agent, [\n916:                 # held by a bear trap: diagonal attempts free us 5x faster (jf_config.BEARTRAP_ESCAPE)\n917:                 self.agent.escape_bear_trap(),\n918:             ])\n919:             .preempt(self.agent, [\n920:                 self.agent.fight2(),\n921:             ])\n922:             # the Valley of the Dead only (GEHENNOM_DIVE): walk past the graveyards' sleeping undead\n923:             .preempt(self.agent, [\n924:                 self.dive.valley_sneak(),\n925:             ])\n926:             # an Overloaded were form can neither fight nor eat: drop its load first (LYCAN_FIXES)\n927:             .preempt(self.agent, [\n928:                 self.agent.were_unload().condition(lambda: jf_config.LYCAN_FIXES),\n929:                 # a hold that is over must not leave us standing on its Elbereth (see wipe_hold_elbereth)\n930:                 self.dive.wipe_hold_elbereth().condition(lambda: jf_config.HOLD_LOOP),\n931:             ])\n932:             .preempt(self.agent, [\n933:                 self.dive.faint_shelter(),\n934:                 self.dive.faint_guard().condition(lambda: jf_config.FAINT_GUARD),\n935:             ])\n936:             .preempt(self.agent, [\n937:                 self.dive.leave_minetown_hallucinating(),\n938:             ])\n939:             .preempt(self.agent, [\n940:                 self.dive.water_demon_vigil(),\n941:             ])\n942:             # a digger with room to dig finishes the hole instead of walking to a fight\n943:             .preempt(self.agent, [\n944:                 self.dive.dig_first(),\n945:             ])\n946:             # astra's survival layer, only once diving (the tour keeps the elite's proven behaviour)\n947:             .preempt(self.agent, [\n948:                 self.dive.elbereth_rest().condition(lambda: self.dive.diving or jf_config.SURVIVAL_IN_TOUR),\n949:             ])\n950:             .preempt(self.agent, [\n951:                 self.dive.retreat_upstairs().condition(lambda: self.dive.diving or jf_config.SURVIVAL_IN_TOUR),\n952:                 # the Valley of the Dead only (GEHENNOM_DIVE): up its '<' to heal on the castle level\n953:                 self.dive.valley_retreat(),\n954:             ])\n955:             # Gehennom only (GEHENNOM_DIVE): a wand of digging down away from a monster we can't outfight\n956:             .preempt(self.agent, [\n957:                 self.dive.gehennom_escape(),\n958:             ])\n959:             # Gehennom only (GEHENNOM_SCARE): drop a scroll of scare monster and hold on it (dig from it / rest on\n960:             # it) -- above the Valley retreat: no castle round trip while a scroll lasts\n961:             .preempt(self.agent, [\n962:                 self.dive.gehennom_scare(),\n963:             ])\n964:             # power (CASTLE_POLY): depth 25+ on the main line, losing a fight -> a wand of polymorph at ourselves\n965:             .preempt(self.agent, [\n966:                 castle_power.deep_poly_escape_strategy(self.dive),\n967:             ])\n968:             # crossing the castle moat (castle_logic.py): above the survival layer and the fight, which\n969:             # would drag a levitating hero back to land or up the stairs\n970:             .preempt(self.agent, [\n971:                 self.dive.castle.crossing_strategy(),\n972:             ])\n973:             .preempt(self.agent, [\n974:                 self.agent.engulfed_fight(),\n975:             ])\n976:             .preempt(self.agent, [\n977:                 self.agent.emergency_strategy(),\n978:             ])\n979:         )\n\n(End of file - total 979 lines)\n</content>","metadata":{"preview":"from enum import IntEnum, auto\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\nfrom . import soko_solver\nfrom . import utils\nfrom . import jf_config\nfrom . import power\nfrom . import castle_power\nfrom .character import Character\nfrom .dive_logic import DiveLogic\nfrom .exceptions import AgentPanic\nfrom .glyph import Hunger, G, MON\nfrom .item import Item, flatten_items\nfrom .item.item_priority_base import ItemPriorityBase\nfrom .level import Level\nfrom .strategy import Strategy","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/global_logic.py","text":"from enum import IntEnum, auto\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\nfrom . import soko_solver\nfrom . import utils\nfrom . import jf_config\nfrom . import power\nfrom . import castle_power\nfrom .character import Character\nfrom .dive_logic import DiveLogic\nfrom .exceptions import AgentPanic\nfrom .glyph import Hunger, G, MON\nfrom .item import Item, flatten_items\nfrom .item.item_priority_base import ItemPriorityBase\nfrom .level import Level\nfrom .strategy import Strategy\n\n\nclass ItemPriority(ItemPriorityBase):\n    MAX_NUMBER_OF_ITEMS = 26 * 2 - 1  # + coin slot, one slot should be left for item arranging\n    def __init__(self, agent):\n        self.agent = agent\n        self._take_sacrificial_corpses = False\n        self._drop_gold_till_turn = -float('inf')\n\n    def _split(self, items, forced_items, weight_capacity):\n        remaining_weight = weight_capacity\n        ret_inv = {}\n        for item in forced_items:\n            remaining_weight -= item.weight()\n            ret_inv[item] = item.count\n\n        ret_bag = {}\n        bag = None\n\n        def add_item(item, count=None, to_bag=False):\n            nonlocal ret_inv, ret_bag, remaining_weight\n            assert isinstance(item, Item)\n            if to_bag and bag is not None and item is not bag:\n                ret = ret_bag\n            else:\n                ret = ret_inv\n\n            if remaining_weight < 0 or \\\n                    (ret is ret_inv and len(ret) >= ItemPriority.MAX_NUMBER_OF_ITEMS):  # TODO: coin slot\n                return\n\n            how_many_already_total = ret_inv.get(item, 0) + ret_bag.get(item, 0)\n            how_many_already = ret.get(item, 0)\n            unit_weight = item.unit_weight(with_content=False)\n            # weightless items (e.g. wraith corpses) would make this an infinite count\n            max_to_add = item.count if unit_weight <= 0 else int(remaining_weight // unit_weight)\n            if count is not None:\n                max_to_add = min(max_to_add, count)\n            ret[item] = min(item.count, how_many_already_total + max_to_add) - (how_many_already_total - how_many_already)\n            remaining_weight -= item.unit_weight(with_content=False) * (ret[item] - how_many_already)\n\n        for item in items:\n            if item.is_container() and item.status in [Item.UNCURSED, Item.BLESSED] and item.objs[0].desc == 'bag':\n                bag = item  # TODO: select the best\n                add_item(bag)\n\n        if self._drop_gold_till_turn < self.agent.blstats.time:\n            for item in items:\n                if item.category == nh.COIN_CLASS:\n                    add_item(item)\n\n        for allow_unknown_status in [False, True]:\n            item = self.agent.inventory.get_best_melee_weapon(items=forced_items + items,\n                                                              allow_unknown_status=allow_unknown_status)\n            if item is not None:\n                add_item(item)\n\n            # TOOL_KEEP_FIRST: the digging tool before the armor set (a splint mail pushed a pick-axe out)\n            dive_ = getattr(self.agent.global_logic, 'dive', None)\n            if jf_config.TOOL_KEEP_FIRST and not allow_unknown_status and dive_ is not None and \\\n                    dive_.keep_digging_tool():\n                tool = dive_.best_digging_tool(forced_items + items)\n                if tool is not None:\n                    add_item(tool)\n\n            no_shield = dive_ is not None and dive_.mattock_digger()\n            for item in self.agent.inventory.get_best_armorset(items=forced_items + items,\n                                                               allow_unknown_status=allow_unknown_status):\n                if item is not None and not (no_shield and getattr(item.objs[0], 'sub', None) == O.ARM_SHIELD):\n                    add_item(item)\n\n        # the dive digs down with a pick-axe: keep one (the tour drops them for lighter loot)\n        dive = getattr(self.agent.global_logic, 'dive', None)\n        if dive is not None and dive.keep_digging_tool():\n            tool = dive.best_digging_tool(forced_items + items)\n            if tool is not None:\n                add_item(tool)\n\n        # power: boots that may be levitation or water walking boots, for the Castle's moat (never worn before)\n        if jf_config.KEEP_MAGIC_BOOTS:\n            for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n                if power.is_passage_boots(item) and not item.equipped:\n                    add_item(item)\n\n        for item in items:\n            if item.is_unambiguous():\n                if item.object in [\n                        O.from_name('healing', nh.POTION_CLASS),\n                        O.from_name('extra healing', nh.POTION_CLASS),\n                        O.from_name('full healing', nh.POTION_CLASS)]:\n                    add_item(item)\n\n                if self.agent.character.role in [Character.RANGER, Character.ROGUE,\n                                                 Character.SAMURAI, Character.TOURIST] and \\\n                        (item.is_launcher() or item.is_fired_projectile()):\n                    add_item(item)\n\n        if self.agent.character.alignment == Character.LAWFUL:\n            for item in sorted(filter(lambda i: i.objs[0].name == 'long sword', items),\n                               key=lambda i: -utils.calc_dps(*self.agent.character.get_melee_bonus(i))):\n                add_item(item)\n                break\n\n        # power (KEEP_POTIONS): in 23 of 90 base games potion types were dropped for good, mostly for daggers\n        # and the dive's pick-axe/mattock (the pack is full: plate mail 450 + tool 100-120). Each unknown potion\n        # is levitation 4.6% of the time, the likeliest Castle passage. While diving (digging, few fights):\n        # food first, then the passage candidates, then the thrown weapons.\n        if jf_config.KEEP_POTIONS and dive is not None and dive.diving:\n            for item in sorted(filter(lambda i: i.is_food() and not i.is_corpse(), items),\n                               key=lambda x: -x.nutrition_per_weight() - 1000 * (x.objs[0].name == 'sprig of wolfsbane')):\n                add_item(item)\n            for item in sorted(filter(power.is_passage_candidate, items),\n                               key=lambda i: i.unit_weight(with_content=False)):\n                add_item(item)\n\n        for item in sorted(filter(lambda i: i.is_thrown_projectile(), items),\n                           key=lambda i: -utils.calc_dps(*self.agent.character.get_ranged_bonus(None, i))):\n            add_item(item)\n\n        for item in sorted(filter(lambda i: i.is_food() and not i.is_corpse(), items),\n                           key=lambda x: -x.nutrition_per_weight() - 1000 * (x.objs[0].name == 'sprig of wolfsbane')):\n            add_item(item)\n\n        if jf_config.LICHEN_RESERVE:\n            # a never-rotting food reserve (lichen, lizard corpses) for the Weak spells before a safe prayer\n            # (agent.reserve_corpse): eaten by eat_from_inventory, like found rations\n            left = jf_config.LICHEN_RESERVE\n            for item in filter(lambda i: i.is_corpse() and i.monster_id in self.agent.RESERVE_CORPSE_IDS, items):\n                if left <= 0:\n                    break\n                add_item(item, count=left)\n                left -= min(item.count, left)\n\n        if self._take_sacrificial_corpses:\n            for item in filter(self.agent.global_logic.can_sacrify, items):\n                add_item(item)\n\n        # TODO: take nh.COIN_CLASS once shopping is implemented.\n        # You have to drop all coins not to be attacked by a vault guard\n\n        for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n            if item.category in [nh.POTION_CLASS, nh.RING_CLASS, nh.AMULET_CLASS, nh.WAND_CLASS, nh.SCROLL_CLASS, nh.TOOL_CLASS]:\n                if (not isinstance(item.objs[0], O.Container) or not item.is_chest()) and \\\n                        not item.is_possible_container():\n                    to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n                             not item.is_offensive_usable_wand()\n                    to_bag = False\n                    if not item.is_container():  # remove condition to pick up bags\n                        add_item(item, to_bag=to_bag)\n\n        categories = [nh.WEAPON_CLASS, nh.ARMOR_CLASS, nh.TOOL_CLASS, nh.FOOD_CLASS, nh.GEM_CLASS, nh.AMULET_CLASS,\n                      nh.RING_CLASS, nh.POTION_CLASS, nh.SCROLL_CLASS, nh.SPBOOK_CLASS, nh.WAND_CLASS]\n        for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n            if item.category in categories and not isinstance(item.objs[0], O.Container) and not item.is_corpse():\n                if item.status == Item.UNKNOWN:\n                    to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n                             not item.is_offensive_usable_wand()\n                    to_bag = False\n                    if not item.is_container():  # remove condition to pick up bags\n                        add_item(item, to_bag=to_bag)\n\n        r = {None: [ret_inv.get(item, 0) for item in items]}\n        if bag is not None:\n            r[bag] = [ret_bag.get(item, 0) for item in items]\n        for item in items:\n            if item.is_container() and item is not bag and ret_inv.get(item, 0) != 0:\n                r[item] = [0 for _ in items]\n        return r\n\n\nclass Milestone(IntEnum):\n    BE_ON_FIRST_LEVEL = auto()\n    FIND_GNOMISH_MINES = auto()\n    # FIND_LIGHT_GNOMISH_MINES = auto()\n    # FARM_LIGHT_GNOMISH_MINES = auto()\n    FIND_MINETOWN = auto()\n    FIND_SOKOBAN = auto()\n    SOLVE_SOKOBAN = auto()\n    FIND_MINES_END = auto()\n    GO_DOWN = auto() # TODO\n\n\n\n\nclass GlobalLogic:\n    def __init__(self, agent):\n        self.agent = agent\n        self.milestone = Milestone(1)\n        self.step_completion_log = {}  # Milestone -> (step, turn)\n\n        self.item_priority = ItemPriority(self.agent)\n\n        self.oracle_level = None\n        self.minetown_level = None\n\n        self._got_artifact = False\n        self._milestone_since = {}   # milestone -> turn it began (jf_config.MINES_SEARCH_TURNS)\n        self._stall_anchor = None    # (level key, (y, x), turn, milestone) the tour has kept close to\n        self._pick_trip_start = None\n        self._pick_trip_done = False\n        self.mines_not_found = False\n\n        self.dive = DiveLogic(agent)\n\n    def update(self):\n        self.dive.update()\n\n        if not self.agent.character.prop.hallu:\n            if utils.isin(self.agent.glyphs, G.ORACLE).any():\n                if self.oracle_level is None:\n                    self.oracle_level = self.agent.current_level().key()\n                else:\n                    assert self.oracle_level == self.agent.current_level().key()\n\n            if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n                    utils.isin(self.agent.glyphs, G.SHOPKEEPER).any():\n                if self.minetown_level is None:\n                    self.minetown_level = self.agent.current_level().key()\n                else:\n                    assert self.minetown_level == self.agent.current_level().key()\n\n    @utils.debug_log('solving sokoban')\n    @Strategy.wrap\n    def solve_sokoban_strategy(self):\n        # TODO: refactor\n        if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n            yield False\n        yield True\n\n        def push_bolder(ty, tx, dy, dx):\n            while 1:\n                if self.agent.bfs()[ty, tx] == -1:\n                    return False\n                self.agent.go_to(ty, tx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n                with self.agent.atom_operation():\n                    direction = self.agent.calc_direction(ty, tx, ty + dy, tx + dx)\n                    self.agent.direction(direction)\n                    message = self.agent.message\n\n                if (self.agent.blstats.y, self.agent.blstats.x) == (ty, tx):\n                    assert 'You hear a monster behind the boulder.' in message or \\\n                           'You try to move the boulder, but in vain.' in message, message\n                    if self.agent.bfs()[ty + dy, tx + dx] != -1:\n                        self.agent.go_to(ty + dy, tx + dx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n                        continue\n                    else:\n                        pickaxe = None\n                        for item in flatten_items(self.agent.inventory.items):\n                            if item.is_unambiguous() and \\\n                                    item.object in [O.from_name('pick-axe'), O.from_name('dwarvish mattock')]:\n                                pickaxe = item\n                                break\n                        if pickaxe is not None:\n                            with self.agent.atom_operation():\n                                pickaxe = self.agent.inventory.move_to_inventory(pickaxe)\n                                self.agent.step(A.Command.APPLY)\n                                self.agent.type_text(self.agent.inventory.items.get_letter(pickaxe))\n                                self.agent.direction(direction)\n                            return True\n                else:\n                    return True\n\n                # TODO: not sure what to do\n                self.agent.exploration.explore1(None).run()\n\n        while 1:\n            wall_map = utils.isin(self.agent.current_level().objects, G.WALL)\n            for smap, answer in soko_solver.maps.items():\n                sokomap = soko_solver.convert_map(smap)\n                offset = np.array(min(zip(*wall_map.nonzero()))) - \\\n                         np.array(min(zip(*(sokomap.sokomap == soko_solver.WALL).nonzero())))\n                mask = wall_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n                if (mask & (sokomap.sokomap == soko_solver.WALL) == mask).all():\n                    break\n            else:\n                assert 0, 'sokomap not found'\n\n            possible_mimics = set()\n            last_resort_move = None\n            for (y, x), (dy, dx) in answer:\n                boulder_map = utils.isin(self.agent.glyphs, G.BOULDER)\n                mask = boulder_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                   offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n                ty, tx = offset[0] + y - dy, offset[1] + x - dx,\n                soko_boulder_mask = sokomap.sokomap == soko_solver.BOULDER\n                if self.agent.bfs()[ty, tx] != -1 and \\\n                        ((soko_boulder_mask | mask) == soko_boulder_mask).all() and \\\n                        self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER:\n\n                    soko_dis1 = sokomap.bfs()\n                    sokomap.move(y, x, dy, dx)\n                    soko_dis2 = sokomap.bfs()\n\n                    # see points that will no longer be accessible\n                    with self.agent.env.debug_log('checking for monsters'):\n                        to_visit_mask = self.agent.bfs() != -1\n                        to_visit_mask[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                      offset[1] : offset[1] + sokomap.sokomap.shape[1]] &= \\\n                                              (soko_dis1 != -1) & (soko_dis2 == -1)\n\n                        with self.agent.env.debug_tiles(to_visit_mask, color=(255, 0, 0, 128)):\n                            while to_visit_mask.any():\n                                vy, vx = list(zip(*to_visit_mask.nonzero()))[0]\n                                to_visit_mask[vy, vx] = 0\n\n                                def clear_neighbors():\n                                    to_visit_mask[self.agent.blstats.y, self.agent.blstats.x] = 0\n                                    to_visit_mask[utils.isin(self.agent.glyphs, G.VISIBLE_FLOOR)] = 0\n                                    return not to_visit_mask[vy, vx]\n\n                                self.agent.go_to(vy, vx, callback=clear_neighbors)\n\n                    if not push_bolder(ty, tx, dy, dx):\n                        continue\n\n                    possible_mimics = set()\n                    last_resort_move = None\n\n                    if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n                        return\n\n                else:\n                    sokomap.move(y, x, dy, dx)\n\n                if (~soko_boulder_mask | mask).all():\n                    if self.agent.bfs()[ty, tx] != -1 and \\\n                            self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER and \\\n                            last_resort_move is None:\n                        last_resort_move = (ty, tx, dy, dx)\n\n                    if not possible_mimics:\n                        for mim_y, mim_x in zip(*(~soko_boulder_mask & mask).nonzero()):\n                            possible_mimics.add((mim_y + offset[0], mim_x + offset[1]))\n\n\n            # sokoban configuration is not in the list. Check for mimics\n            with self.agent.env.debug_log('mimics'):\n                with self.agent.env.debug_tiles(possible_mimics, color=(255, 0, 0, 128)):\n                    for mim_y, mim_x in sorted(possible_mimics):\n                        if (self.agent.bfs()[max(0, mim_y - 1) : mim_y + 2, max(0, mim_x - 1) : mim_x + 2] != -1).any():\n                            self.agent.go_to(mim_y, mim_x, stop_one_before=True,\n                                             debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n                            for _ in range(3):\n                                self.agent.search()\n\n            # last resort move (sometimes we can see a mimic diagonally but cannot reach it)\n            with self.agent.env.debug_log('last_resort'):\n                if last_resort_move is not None:\n                    ty, tx, dy, dx = last_resort_move\n                    push_bolder(ty, tx, dy, dx)\n                    continue\n\n            self.agent.stats_logger.log_event('sokoban_dropped')\n            self.milestone = Milestone(int(self.milestone) + 1)\n            raise AgentPanic('sokomap unsolvable')\n\n    @Strategy.wrap\n    def wait_out_unexpected_state_strategy(self):\n        yielded = False\n        # CASTLE_POLY: on the castle a polymorph is the way over the moat (castle_power): keep acting in the form\n        castle_poly = lambda: jf_config.CASTLE_POLY and self.dive.castle.active()\n        while (\n                self.agent.character.prop.blind or\n                self.agent.character.prop.confusion or\n                self.agent.character.prop.stun or\n                self.agent.character.prop.hallu or\n                (self.agent.character.prop.polymorph and not castle_poly())):\n            if not yielded:\n                yield True\n                yielded = True\n\n            self.agent.direction('.')\n\n        if not yielded:\n            yield False\n\n    @utils.debug_log('identify_items_on_altar')\n    @Strategy.wrap\n    def identify_items_on_altar(self):\n        mask = utils.isin(self.agent.current_level().objects, G.ALTAR)\n        if not mask.any():\n            yield False\n\n        dis = self.agent.bfs()\n        mask &= dis != -1\n        if not mask.any():\n            yield False\n\n        yield any((item.status == Item.UNKNOWN for item in flatten_items(self.agent.inventory.items)\n                   if item.can_be_dropped_from_inventory()))\n\n        (ty, tx), *_ = zip(*(mask & (dis == dis[mask].min())).nonzero())\n        self.agent.go_to(ty, tx)\n        items_to_drop = [item for item in flatten_items(self.agent.inventory.items)\n                         if item.can_be_dropped_from_inventory() and item.status == Item.UNKNOWN]\n        if not items_to_drop:\n            raise AgentPanic('items to drop on altar vanished')\n\n        # TODO: move chunking to inventory.drop\n        items_to_drop = items_to_drop[:self.agent.inventory.items.free_slots()]\n\n        self.agent.inventory.drop(items_to_drop)\n\n    @utils.debug_log('dip_for_excalibur')\n    @Strategy.wrap\n    def dip_for_excalibur(self):\n        if self.agent.character.alignment != Character.LAWFUL or self.agent.blstats.experience_level < 5:\n            yield False\n        if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n                (self.minetown_level is None or self.agent.current_level().key() == self.minetown_level):\n            yield False\n\n        dis = self.agent.bfs()\n        mask = utils.isin(self.agent.current_level().objects, G.FOUNTAIN) & (dis != -1)\n        if not mask.any():\n            yield False\n\n        def excalibur_candidate():\n            candidate = None\n            for item in flatten_items(self.agent.inventory.items):\n                if item.is_unambiguous() and item.object == O.from_name('long sword'):\n                    if item.dmg_bonus is not None: # TODO: better condition for excalibur existance\n                        return None\n                    candidate = item\n            return candidate\n\n        if excalibur_candidate() is None:\n            yield False\n        yield True\n\n        self.agent.go_to(*list(zip(*mask.nonzero()))[0])\n\n        candidate = excalibur_candidate()\n        if candidate is None:\n            return\n\n        # TODO: refactor\n        with self.agent.atom_operation():\n            candidate = self.agent.inventory.move_to_inventory(candidate)\n            self.agent.step(A.Command.DIP)\n            self.agent.type_text(self.agent.inventory.items.get_letter(candidate))\n            if ('What do you want to dip ' in self.agent.message and 'into?' in self.agent.message) or \\\n                    \"You don't have anything to dip \" in self.agent.message:\n                raise AgentPanic('no fountain here')\n\n    def can_sacrify(self, item):\n        if not item.is_corpse() or item.comment == 'old':\n            return False\n        # picking up a cockatrice-family corpse bare-handed is instant stoning: two unseen-seed games died\n        # taking their thrown daggers back from a chickatrice's pile ('Touching a chickatrice corpse is a\n        # fatal mistake.'), the corpse selected to carry to an altar\n        if self.agent.inventory.items.gloves is None and \\\n                item.monster_id + nh.GLYPH_MON_OFF in self.agent._petrifying_bodies_mons:\n            return False\n\n        mname = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mname\n        # sacrificing a former pet: \"So this is how you repay loyalty?\", the god gets angry (an unseen\n        # Valkyrie offered her kitten, then again: an Angel of Tyr killed her at T2197). The old check here\n        # compared role == [list] (never true) and missed the Valkyrie's kitten; any grown-up pet species\n        # may be ours, so none of them is offered\n        if mname in ('kitten', 'housecat', 'large cat', 'little dog', 'dog', 'large dog', 'pony', 'horse',\n                     'warhorse'):\n            return False\n\n        if self.agent.character.alignment != Character.CHAOTIC:\n            mapping = {\n                Character.HUMAN: MON.M2_HUMAN | MON.M2_WERE,\n                Character.DWARF: MON.M2_DWARF,\n                Character.ELF: MON.M2_ELF,\n                Character.GNOME: MON.M2_GNOME,\n                Character.ORC: MON.M2_ORC,\n            }\n            f2 = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mflags2\n            if (f2 & mapping[self.agent.character.race]) > 0:\n                return False\n\n        return True\n\n    @utils.debug_log('offer_corpses')\n    @Strategy.wrap\n    def offer_corpses(self):\n        self.item_priority._take_sacrificial_corpses = False\n\n        if self._got_artifact:\n            yield False\n\n        altars = [p for p, alignment in self.agent.current_level().altars.items()\n                  if alignment == self.agent.character.alignment]\n\n        if not altars:\n            yield False\n\n        dis = self.agent.bfs()\n        altars = [(y, x) for y, x in altars if dis[y, x] != -1]\n\n        if not altars:\n            yield False\n\n        self.item_priority._take_sacrificial_corpses = True\n\n        if not any((self.can_sacrify(item) for item in flatten_items(self.agent.inventory.items))):\n            yield False\n\n        yield True\n\n        y, x = min(altars, key=lambda p: dis[p])\n        self.agent.go_to(y, x)\n        with self.agent.panic_if_position_changes():\n            while 1:\n                for item in flatten_items(self.agent.inventory.items):\n                    if self.can_sacrify(item):\n                        with self.agent.atom_operation():\n                            item = self.agent.inventory.move_to_inventory(item)\n                            assert self.can_sacrify(item)\n                            self.agent.step(A.Command.OFFER)\n                            while ('There is ' in self.agent.message or 'There are ' in self.agent.message) and \\\n                                    ('sacrifice it?' in self.agent.message or 'sacrifice one?' in self.agent.message):\n                                self.agent.type_text('n')\n                            assert 'What do you want to sacrifice?' in self.agent.message, self.agent.message\n                            self.agent.type_text(self.agent.inventory.items.get_letter(item))\n                            if 'Nothing happens.' in self.agent.message:\n                                self.agent.inventory.call_item(item, 'old')\n                                return\n                            if 'Use my gift wisely' in self.agent.message:\n                                self._got_artifact = True\n                                self.agent.inventory.get_items_below_me()\n                                return\n                            if 'So this is how you repay loyalty?' in self.agent.message:\n                                raise AgentPanic('pet sacrified')\n                            assert 'Your sacrifice is consumed in a flash of light' in self.agent.message or \\\n                                'Your sacrifice is consumed in a burst of flame' in self.agent.message or \\\n                                ('The blood covers the altar!' in self.agent.message and \\\n                                 'You have summoned ' in self.agent.message), \\\n                                self.agent.message\n                            break\n                else:\n                    break\n\n    @utils.debug_log('follow_guard')\n    @Strategy.wrap\n    def follow_guard(self):\n        if not utils.isin(self.agent.glyphs, G.GUARD).any():\n            yield False\n\n        if any(item.category == nh.COIN_CLASS for item in flatten_items(self.agent.inventory.items)):\n            yield True\n            # if 'Please drop that gold and follow me.' in self.message:\n            self.agent.stats_logger.log_event('drop_gold')\n            self.item_priority._drop_gold_till_turn = self.agent.blstats.time + 100\n            self.agent.inventory.arrange_items().run()\n            return\n\n        ys, xs = utils.isin(self.agent.glyphs, G.GUARD).nonzero()\n        y, x = ys[0], xs[0]\n\n        if utils.adjacent((y, x), (self.agent.blstats.y, self.agent.blstats.x)):\n            yield False\n\n        yield True\n\n        self.agent.go_to(y, x, stop_one_before=True)\n\n    def _safe_to_dip(self):\n        # SAFE_DIPS (full HP + prayer ready, astra) changes the tour; off until tested on its own\n        bl = self.agent.blstats\n        # NO_DIP_WITH_TOOL: a fountain dip curses the sword 1 time in 30, silently (fountain.c case 16), and a\n        # welded weapon can't be swapped for the pick-axe: eg-glh-public seed 6 carried its pick from T6556, dipped\n        # 8 times at XL 7, and dove at XL 8 with 'a cursed thoroughly rusty +1 long sword (weapon in hand)' --\n        # digging_tool() None, a tool-less dive (0.206; base 0.466). A digger doesn't need Excalibur.\n        if jf_config.NO_DIP_WITH_TOOL and self.dive.digging_tool() is not None:\n            return False\n        # DEMON_NO_REDIP: not while a released water demon is about -- when it fled out of the vigil's reach the\n        # bot walked back to the fountain and dipped twice more next to it, then fought it (DEMON_FIX replay of\n        # jf16 s8: killed by the demon 480 turns after the release)\n        if jf_config.DEMON_NO_REDIP and bl.time <= self.dive._demon_vigil_until:\n            return False\n        if not jf_config.SAFE_DIPS:\n            # a released water demon (1 dip in ~40) is deadlier to a starving or hurt character; dipping\n            # can wait for a healthy moment (SAFE_DIPS' prayer-ready rule halved the Excaliburs)\n            return bl.experience_level >= 7 and bl.hunger_state < Hunger.WEAK and \\\n                bl.hitpoints >= 0.7 * bl.max_hitpoints\n        return bl.experience_level >= 7 and bl.hitpoints >= 0.9 * bl.max_hitpoints and \\\n            self.agent.is_safe_to_pray(800)\n\n    def exploration_strategy(self, search_prio_limit):\n        \"\"\"The tour's exploration (used by the dive phase too).\"\"\"\n        return (\n            Strategy(lambda: self.agent.exploration.explore1(\n                search_prio_limit, trap_search_offset=1,\n                kick_doors=self.agent.current_level().dungeon_number != Level.GNOMISH_MINES).strategy())\n            .preempt(self.agent, [\n                self.identify_items_on_altar().every(100),\n                self.identify_items_on_altar().condition(\n                    lambda: self.agent.current_level().objects[self.agent.blstats.y,\n                                                               self.agent.blstats.x] in G.ALTAR),\n                # hypothesis: fountain dips summon water demons (killed an XL9 elite game); dip only\n                # at (near) full HP with a prayer in hand, as astra did (full HP, retreat ready)\n                self.dip_for_excalibur().condition(self._safe_to_dip).every(10),\n            ])\n        )\n\n    def _pick_trip_active(self):\n        agent = self.agent\n        if not jf_config.PICK_TRIP_XL or self._pick_trip_done:\n            return False\n        if self.dive.digging_tool() is not None:\n            agent.log('TOUR pick trip: got a digging tool, back to the grind')\n            self._pick_trip_done = True\n            return False\n        if agent.prayer_failed or agent.blstats.experience_level < jf_config.PICK_TRIP_XL:\n            return False\n        start = self._pick_trip_start\n        if start is not None and jf_config.PICK_TRIP_END_XL and \\\n                agent.blstats.experience_level >= jf_config.PICK_TRIP_END_XL:\n            # an XL-7 character on Dlvl 3-6 meets difficulty-5/6 monsters ((depth + XL) / 2): 4 of 60 pt5/pt6\n            # games died there to killer bees, soldier ants and orcish arrows, none during the XL 5-6 trips\n            agent.log(f'TOUR pick trip: XL {agent.blstats.experience_level} without a tool, back to the grind')\n            self._pick_trip_done = True\n            return False\n        if start is None:\n            self._pick_trip_start = agent.blstats.time\n            agent.log('TOUR pick trip: off to the Mines for a digging tool')\n        elif agent.blstats.time - start > jf_config.PICK_TRIP_TURNS:\n            agent.log('TOUR pick trip: out of time, back to the grind')\n            self._pick_trip_done = True\n            return False\n        return True\n\n    def _grind_level(self):\n        \"\"\"jf_config.GRIND_LEVELS {min XL: Dlvl}: the grind's main-dungeon level at this XL (None: the flag is off).\n\n        Random monsters are capped at difficulty (depth + XL) / 2 (makemon.c). On Dlvl 1 that cap is 3 at XL 5-6,\n        so XL 5 -> 7 takes ~9,000 turns there (base: ~3,500 + ~5,500) at ~12 hunger prayers per grind, and the\n        prayers' rnz(350) failures end 13 of 45 gc-lf1 games in a rescue. Keeping the cap at 4 instead (Dlvl 3 at\n        XL 5-6, Dlvl 2 at XL 7) doubles XP per spawn at XL 5-6 (monst.c model: 3.8-4.9 -> 8.3-10.8), so fewer\n        turns and prayers, while killer bees, soldier ants and Uruk-hai (difficulty 5-6) stay out: the old\n        Dlvl-3 grind at XL 7 (cap 5) lost 4.9-7.8% of games per 1000 turns. Dwarves (difficulty 4) spawn from\n        XL 5 there, and the pet kills them for their pick-axes as it does on Dlvl 1 from XL 7.\"\"\"\n        table = jf_config.GRIND_LEVELS\n        if not table:\n            return None\n        xl = self.agent.blstats.experience_level\n        keys = [k for k in table if k <= xl]\n        return table[max(keys)] if keys else 1\n\n    def _tour_stalled(self):\n        \"\"\"The tour has kept within 8 squares of one spot on one level, same milestone, TOUR_STALL_TURNS turns.\"\"\"\n        bl = self.agent.blstats\n        key = self.agent.current_level().key()\n        a = self._stall_anchor\n        if a is None or a[0] != key or a[3] != self.milestone or \\\n                max(abs(bl.y - a[1][0]), abs(bl.x - a[1][1])) > 8:\n            self._stall_anchor = (key, (bl.y, bl.x), bl.time, self.milestone)\n            return False\n        return bl.time - a[2] >= jf_config.TOUR_STALL_TURNS\n\n    @staticmethod\n    def _stall_goal_met(goal):\n        try:\n            return goal()\n        except Exception:\n            return False\n\n    def current_strategy(self):\n        # hypothesis: AutoAscend's levelling tour keeps the character alive to XL 10-13 (the elite's\n        # recipe); once it is strong, the depth-first dive with the Quest-portal sweep is worth more\n        # than further levelling (Home 1 = 0.366, Dlvl 20+ = 0.38+, vs XL 12 = 0.333).\n        return self.tour_strategy().until(self.agent, self.dive.should_dive).before(self.dive.strategy())\n\n    @Strategy.wrap\n    def tour_strategy(self):\n        yield True\n        while 1:\n            explore_stairs_condition = lambda: False\n            restart = lambda: False   # ends the current strategy without finishing the milestone\n            if self.milestone == Milestone.BE_ON_FIRST_LEVEL and self._pick_trip_active():\n                # PICK_TRIP_XL: a detour from the grind to the Mines for a dwarf's pick-axe, then back to\n                # Dlvl 1. With the pick in hand a failed hunger prayer (a quarter of all games) starts a\n                # dig-dive instead of a starving stairs rescue, and the XL 8 dive needs no Mines trip.\n                self.dive.pick_trip = True\n                condition = lambda: False\n                level = (Level.GNOMISH_MINES, jf_config.PICK_TRIP_LEVEL)\n                restart = lambda: not self._pick_trip_active()\n            elif self.milestone == Milestone.BE_ON_FIRST_LEVEL:\n                self.dive.pick_trip = False\n                condition = self.dive.first_level_done\n                # explore_stairs_condition = lambda: self.agent.inventory.items.total_nutrition() == 0 and \\\n                #                                    self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY\n                # GRIND_DEEP_XL: from that XL the grind goes on on Dlvl GRIND_DEEP_LEVEL -- on Dlvl 1 XL 6->8 takes\n                # a median 11,500 turns (7 of the grind's ~11 hunger prayers): spawns there are too weak\n                deep = bool(jf_config.GRIND_DEEP_XL) and \\\n                    self.agent.blstats.experience_level >= jf_config.GRIND_DEEP_XL\n                level = (Level.DUNGEONS_OF_DOOM, jf_config.GRIND_DEEP_LEVEL if deep else 1)\n                if jf_config.GRIND_DEEP_XL and not deep:\n                    restart = lambda: self.agent.blstats.experience_level >= jf_config.GRIND_DEEP_XL\n                grind_level = self._grind_level()\n                if grind_level is not None:\n                    # GRIND_LEVELS: the grind's level follows XL, see _grind_level\n                    level = (Level.DUNGEONS_OF_DOOM, grind_level)\n                    restart = lambda lv=grind_level: self._grind_level() != lv\n\n            elif self.milestone == Milestone.FIND_SOKOBAN:\n                condition = lambda: self.agent.current_level().dungeon_number == Level.SOKOBAN\n                level = (Level.SOKOBAN, 4)\n\n            elif self.milestone == Milestone.FIND_GNOMISH_MINES:\n                since = self._milestone_since.setdefault(self.milestone, self.agent.blstats.time)\n                # the branch hides behind unexplored rock on some Dlvl 2-4s: a jf9 game stood searching at\n                # one Dlvl 4 spot for 1000+ turns, hunger-praying until a prayer failed (35 of 118 games\n                # that left Dlvl 1 never reached the Mines; 14 of 83 that did needed 4000+ turns)\n                condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES or \\\n                    (jf_config.MINES_SEARCH_TURNS and self.agent.blstats.time - since > jf_config.MINES_SEARCH_TURNS)\n                level = (Level.GNOMISH_MINES, 1)\n\n            # elif self.milestone == Milestone.FIND_LIGHT_GNOMISH_MINES:\n            #     condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES \\\n            #             and self.agent.current_level().is_light_level()\n            #     level = (Level.GNOMISH_MINES, 9)\n\n            # elif self.milestone == Milestone.FARM_LIGHT_GNOMISH_MINES:\n            #     condition = lambda: self.agent.blstats.experience_level >= 11\n            #     level = (Level.GNOMISH_MINES, self.agent.current_level().level_number)\n\n            elif self.milestone == Milestone.FIND_MINETOWN:\n                condition = lambda: self.minetown_level is not None\n                level = (Level.GNOMISH_MINES, 4)  # TODO\n\n            elif self.milestone == Milestone.SOLVE_SOKOBAN:\n                # TODO: fix the condition, monster can destroy doors\n                condition = lambda: self.agent.current_level().key() == (Level.SOKOBAN, 1) and \\\n                                    not utils.isin(self.agent.current_level().objects, G.DOOR_CLOSED).any()\n                level = (Level.SOKOBAN, 1)\n\n            elif self.milestone == Milestone.FIND_MINES_END:\n                condition = lambda: self.agent.current_level().key() == (Level.GNOMISH_MINES, 9) or \\\n                    self.mines_not_found  # TODO\n                level = (Level.GNOMISH_MINES, 9)  # TODO\n\n            else:\n                # TODO\n                condition = lambda: False\n                level = (Level.DUNGEONS_OF_DOOM, 100)\n\n            goal = condition\n            watch_stall = Milestone.BE_ON_FIRST_LEVEL < self.milestone < Milestone.GO_DOWN and \\\n                bool(jf_config.TOUR_STALL_TURNS)\n            if watch_stall:\n                condition = lambda: goal() or self._tour_stalled()\n\n            if condition():\n                if watch_stall and not self._stall_goal_met(goal) and self._tour_stalled():\n                    # held in one spot for TOUR_STALL_TURNS (a pocket we are too heavy to squeeze out of, a\n                    # passage a jelly blocks, a shop door...): the next milestone takes us somewhere else, the\n                    # last one (GO_DOWN) is the dive\n                    skip = Milestone.FIND_MINES_END if self.milestone in (Milestone.FIND_SOKOBAN,\n                                                                           Milestone.SOLVE_SOKOBAN) \\\n                        else Milestone(int(self.milestone) + 1)\n                    self.agent.log(f'TOUR stalled {jf_config.TOUR_STALL_TURNS} turns at {self._stall_anchor[:2]} '\n                                   f'in {self.milestone.name}: on to {skip.name}')\n                    if self.milestone == Milestone.FIND_GNOMISH_MINES:\n                        self.mines_not_found = True\n                    self.milestone = skip\n                    self._stall_anchor = None\n                    continue\n                if self.milestone == Milestone.FIND_GNOMISH_MINES and \\\n                        self.agent.current_level().dungeon_number != Level.GNOMISH_MINES:\n                    self.agent.log(f'TOUR no Mines entrance after {jf_config.MINES_SEARCH_TURNS} turns: '\n                                   f'skipping Minetown, on to Sokoban')\n                    self.mines_not_found = True\n                    self.milestone = Milestone.FIND_SOKOBAN\n                    continue\n                self.milestone = Milestone(int(self.milestone) + 1)\n                if jf_config.SKIP_SOKOBAN and self.milestone in (Milestone.FIND_SOKOBAN, Milestone.SOLVE_SOKOBAN) \\\n                        and self.agent.character.race in (Character.DWARF, Character.GNOME):\n                    self.milestone = Milestone.FIND_MINES_END\n                continue\n\n\n            def exploration_strategy(level, **kwargs):\n                return (\n                    Strategy(lambda: self.agent.exploration.explore1(level, trap_search_offset=1,\n                        kick_doors=self.agent.current_level().dungeon_number != Level.GNOMISH_MINES, **kwargs).strategy())\n                    .preempt(self.agent, [\n                        self.identify_items_on_altar().every(100),\n                        self.identify_items_on_altar().condition(\n                            lambda: self.agent.current_level().objects[self.agent.blstats.y,\n                                                                       self.agent.blstats.x] in G.ALTAR),\n                        self.dip_for_excalibur().condition(self._safe_to_dip).every(10),\n                    ])\n                )\n\n            def go_to_strategy(y, x):\n                return (\n                    exploration_strategy(None)\n                    .preempt(self.agent, [\n                        self.agent.exploration.go_to_strategy(y, x).preempt(self.agent, [\n                            self.agent.inventory.gather_items(),\n                            self.identify_items_on_altar(),\n                            self.dip_for_excalibur().condition(self._safe_to_dip),\n                        ])\n                        .condition(lambda: self._got_artifact or\n                                           not any([alignment == self.agent.character.alignment\n                                                    for _, alignment in self.agent.current_level().altars.items()]))\n                    ])\n                    .until(self.agent, lambda: (self.agent.blstats.y, self.agent.blstats.x) == (y, x))\n                )\n\n            def homebound(lv=level):\n                \"\"\"In transit to the grind level: don't explore every level passed to exhaustion (the tour's\n                first preempt). UPWARD_RETURN: on the way home from a pick trip (eg-trip5a public seed 9 ended\n                its trip on Mines 1 at XL 7 and explored that level for 3,500 turns instead of climbing to\n                the Dlvl 1 grind). GRIND_LEVELS: moving up to the next grind level (eg-gl-a public seed 11\n                spent 4,000 turns at XL 7 on Dlvl 3 before climbing to Dlvl 2), or out of the Mines a\n                random unexplored '>' took us into (seed 3 died on Mines 1).\"\"\"\n                if self.milestone != Milestone.BE_ON_FIRST_LEVEL or self.agent.current_level().key() == lv:\n                    return False\n                if jf_config.UPWARD_RETURN and self._pick_trip_done:\n                    return True\n                cur = self.agent.current_level()\n                return bool(jf_config.GRIND_LEVELS) and lv[0] == Level.DUNGEONS_OF_DOOM and \\\n                    (cur.dungeon_number == Level.GNOMISH_MINES or self.agent.blstats.depth > lv[1])\n            (\n                self.agent.exploration.go_to_level_strategy(*level, go_to_strategy, exploration_strategy(None))\n                .before(exploration_strategy(None))#.before(self.agent.exploration.patrol())\n                .preempt(self.agent, [\n                    exploration_strategy(0).condition(lambda: not homebound()),\n                    exploration_strategy(None).until(\n                        self.agent, lambda: self.agent.blstats.hitpoints >= 0.8 * self.agent.blstats.max_hitpoints)\n                ])\n                .preempt(self.agent, [\n                    self.agent.exploration.explore_stairs(go_to_strategy, all=True).condition(explore_stairs_condition),\n                ])\n                .until(self.agent, lambda: condition() or restart())\n            ).run()\n\n    def global_strategy(self):\n        return (\n            self.current_strategy().repeat()\n            # lowest priority: a peaceful dwarf's pick-axe while in the Mines (dive_logic.DWARF_HUNT)\n            .preempt(self.agent, [\n                self.dive.hunt_strategy(),\n                self.dive.ditch_pet_strategy(),\n                # a tour-mode pick trip looks for the Mines branch itself (dive_logic.FAST_BRANCH)\n                self.dive.trip_branch_strategy(),\n            ])\n            .preempt(self.agent, [\n                self.solve_sokoban_strategy()\n                .condition(lambda: self.milestone == Milestone.SOLVE_SOKOBAN and\n                                   self.agent.current_level().dungeon_number == Level.SOKOBAN)\n            ])\n            .preempt(self.agent, [\n                self.offer_corpses().preempt(self.agent, [\n                    self.agent.eat_corpses_from_ground().condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                ]),\n            ])\n            .preempt(self.agent, [\n                self.wait_out_unexpected_state_strategy(),\n            ])\n            .preempt(self.agent, [\n                self.agent.cure_disease().every(5),\n            ])\n            .preempt(self.agent, [\n                self.agent.eat_corpses_from_ground(only_below_me=True).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                # CLAIM_CORPSES: a fresh kill a few steps away is ours before the pet gets it (the pet ate as many\n                # jackal corpses as we did in the base grinds; 63% of its meals of our kills came 2+ turns after\n                # the kill, while we walked elsewhere)\n                self.agent.eat_corpses_from_ground(only_below_me=False, max_dist=jf_config.CLAIM_DIST,\n                                                   max_age=jf_config.CLAIM_MAX_AGE)\n                .condition(lambda: jf_config.CLAIM_CORPSES and not self.dive.diving and\n                           self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                self.agent.eat_corpses_from_ground(only_below_me=not jf_config.EAT_NEARBY_CORPSES).every(5)\n                .condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                # after a failed prayer corpses are the only food left: walk to the ones nearby\n                self.agent.eat_corpses_from_ground(only_below_me=False).every(3)\n                .condition(lambda: self.agent.prayer_failed and self.agent.blstats.hunger_state >= Hunger.HUNGRY),\n                # DIVE_EAT: a hungry dive walks to fresh edible corpses close by (6 of 33 tool dives that died\n                # above Dlvl 25 in base/base2 died Weak or Fainting, between hunger prayers)\n                self.agent.eat_corpses_from_ground(only_below_me=False).every(3)\n                .condition(lambda: jf_config.DIVE_EAT and self.dive.diving and not self.agent.prayer_failed and\n                           self.agent.blstats.hunger_state >= Hunger.HUNGRY and\n                           self.dive.edible_corpse_within(jf_config.DIVE_EAT_RADIUS)),\n                self.agent.eat_from_inventory().every(5),\n                self.agent.inventory.buy_food().every(3),\n                # power (SELL_PRICE_ID): offer unknown potions/rings/boots to a shopkeeper for their price group\n                self.agent.inventory.sell_price_identify().every(3),\n            ])\n            .preempt(self.agent, [\n                # boxed in by diagonal squeezes while carrying > 600 (jf_config.UNSQUEEZE)\n                self.agent.unsqueeze(),\n            ])\n            .preempt(self.agent, [\n                self.follow_guard(),\n            ])\n            .preempt(self.agent, [\n                # held by a bear trap: diagonal attempts free us 5x faster (jf_config.BEARTRAP_ESCAPE)\n                self.agent.escape_bear_trap(),\n            ])\n            .preempt(self.agent, [\n                self.agent.fight2(),\n            ])\n            # the Valley of the Dead only (GEHENNOM_DIVE): walk past the graveyards' sleeping undead\n            .preempt(self.agent, [\n                self.dive.valley_sneak(),\n            ])\n            # an Overloaded were form can neither fight nor eat: drop its load first (LYCAN_FIXES)\n            .preempt(self.agent, [\n                self.agent.were_unload().condition(lambda: jf_config.LYCAN_FIXES),\n                # a hold that is over must not leave us standing on its Elbereth (see wipe_hold_elbereth)\n                self.dive.wipe_hold_elbereth().condition(lambda: jf_config.HOLD_LOOP),\n            ])\n            .preempt(self.agent, [\n                self.dive.faint_shelter(),\n                self.dive.faint_guard().condition(lambda: jf_config.FAINT_GUARD),\n            ])\n            .preempt(self.agent, [\n                self.dive.leave_minetown_hallucinating(),\n            ])\n            .preempt(self.agent, [\n                self.dive.water_demon_vigil(),\n            ])\n            # a digger with room to dig finishes the hole instead of walking to a fight\n            .preempt(self.agent, [\n                self.dive.dig_first(),\n            ])\n            # astra's survival layer, only once diving (the tour keeps the elite's proven behaviour)\n            .preempt(self.agent, [\n                self.dive.elbereth_rest().condition(lambda: self.dive.diving or jf_config.SURVIVAL_IN_TOUR),\n            ])\n            .preempt(self.agent, [\n                self.dive.retreat_upstairs().condition(lambda: self.dive.diving or jf_config.SURVIVAL_IN_TOUR),\n                # the Valley of the Dead only (GEHENNOM_DIVE): up its '<' to heal on the castle level\n                self.dive.valley_retreat(),\n            ])\n            # Gehennom only (GEHENNOM_DIVE): a wand of digging down away from a monster we can't outfight\n            .preempt(self.agent, [\n                self.dive.gehennom_escape(),\n            ])\n            # Gehennom only (GEHENNOM_SCARE): drop a scroll of scare monster and hold on it (dig from it / rest on\n            # it) -- above the Valley retreat: no castle round trip while a scroll lasts\n            .preempt(self.agent, [\n                self.dive.gehennom_scare(),\n            ])\n            # power (CASTLE_POLY): depth 25+ on the main line, losing a fight -> a wand of polymorph at ourselves\n            .preempt(self.agent, [\n                castle_power.deep_poly_escape_strategy(self.dive),\n            ])\n            # crossing the castle moat (castle_logic.py): above the survival layer and the fight, which\n            # would drag a levitating hero back to land or up the stairs\n            .preempt(self.agent, [\n                self.dive.castle.crossing_strategy(),\n            ])\n            .preempt(self.agent, [\n                self.agent.engulfed_fight(),\n            ])\n            .preempt(self.agent, [\n                self.agent.emergency_strategy(),\n            ])\n        )","lineStart":1,"lineEnd":979,"totalLines":979,"truncated":false}},"title":"autoascend/global_logic.py","time":{"start":1790531878687,"end":1790531878696}},"id":"prt_0e4043f1a0014x1POIgRWigeXn","sessionID":"ses_f1bfdb0f7ffeZlkE5FkbKms7fE","messageID":"msg_0e4043238001idfiA8Ra4vCIp6"}}
{"type":"tool_use","timestamp":1790531879403,"sessionID":"ses_f1bfdb0f7ffeZlkE5FkbKms7fE","part":{"type":"tool","tool":"read","callID":"call-183f7d9d-524a-4d68-8b08-5261ce6283c3","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/character.py"},"output":"<path>/workspace/autoascend/character.py</path>\n<type>file</type>\n<content>\n1: import re\n2: \n3: import nle.nethack as nh\n4: import numpy as np\n5: from nle.nethack import actions as A\n6: \n7: from . import objects as O\n8: \n9: ALL_SPELL_NAMES = [\n10:     \"force bolt\",\n11:     \"drain life\",\n12:     \"magic missile\",\n13:     \"cone of cold\",\n14:     \"fireball\",\n15:     \"finger of death\",\n16:     \"protection\",\n17:     \"create monster\",\n18:     \"remove curse\",\n19:     \"create familiar\",\n20:     \"turn undead\",\n21:     \"detect monsters\",\n22:     \"light\",\n23:     \"detect food\",\n24:     \"clairvoyance\",\n25:     \"detect unseen\",\n26:     \"identify\",\n27:     \"detect treasure\",\n28:     \"magic mapping\",\n29:     \"sleep\",\n30:     \"confuse monster\",\n31:     \"slow monster\",\n32:     \"cause fear\",\n33:     \"charm monster\",\n34:     \"jumping\",\n35:     \"haste self\",\n36:     \"invisibility\",\n37:     \"levitation\",\n38:     \"teleport away\",\n39:     \"healing\",\n40:     \"cure blindness\",\n41:     \"cure sickness\",\n42:     \"extra healing\",\n43:     \"stone to flesh\",\n44:     \"restore ability\",\n45:     \"knock\",\n46:     \"wizard lock\",\n47:     \"dig\",\n48:     \"polymorph\",\n49:     \"cancellation\",\n50: ]\n51: \n52: ALL_SPELL_CATEGORIES = [\n53:     \"attack\",\n54:     \"healing\",\n55:     \"divination\",\n56:     \"enchantment\",\n57:     \"clerical\",\n58:     \"escape\",\n59:     \"matter\",\n60: ]\n61: \n62: \n63: class Property:\n64:     def __init__(self, agent):\n65:         self.agent = agent\n66: \n67:     # The tty status line abbreviates conditions when it gets long (e.g. 'Hallu' -> 'Hl'),\n68:     # so read them from the blstats condition bitmask instead.\n69:     def _condition(self, mask):\n70:         return bool(self.agent.last_observation['blstats'][nh.NLE_BL_CONDITION] & mask)\n71: \n72:     @property\n73:     def confusion(self):\n74:         return self._condition(nh.BL_MASK_CONF)\n75: \n76:     @property\n77:     def stun(self):\n78:         return self._condition(nh.BL_MASK_STUN)\n79: \n80:     @property\n81:     def hallu(self):\n82:         return self._condition(nh.BL_MASK_HALLU)\n83: \n84:     @property\n85:     def blind(self):\n86:         return self._condition(nh.BL_MASK_BLIND)\n87: \n88:     @property\n89:     def polymorph(self):\n90:         if not nh.glyph_is_monster(self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]):\n91:             return False\n92:         return self.agent.character.self_glyph != self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n93: \n94: \n95: class Character:\n96:     UNKNOWN = -1  # for everything, e.g. alignment\n97: \n98:     ARCHEOLOGIST = 0\n99:     BARBARIAN = 1\n100:     CAVEMAN = 2\n101:     HEALER = 3\n102:     KNIGHT = 4\n103:     MONK = 5\n104:     PRIEST = 6\n105:     RANGER = 7\n106:     ROGUE = 8\n107:     SAMURAI = 9\n108:     TOURIST = 10\n109:     VALKYRIE = 11\n110:     WIZARD = 12\n111: \n112:     name_to_role = {\n113:         'Archeologist': ARCHEOLOGIST,\n114:         'Barbarian': BARBARIAN,\n115:         'Caveman': CAVEMAN,\n116:         'Cavewoman': CAVEMAN,\n117:         'Healer': HEALER,\n118:         'Knight': KNIGHT,\n119:         'Monk': MONK,\n120:         'Priest': PRIEST,\n121:         'Priestess': PRIEST,\n122:         'Ranger': RANGER,\n123:         'Rogue': ROGUE,\n124:         'Samurai': SAMURAI,\n125:         'Tourist': TOURIST,\n126:         'Valkyrie': VALKYRIE,\n127:         'Wizard': WIZARD,\n128:     }\n129: \n130:     CHAOTIC = 0\n131:     NEUTRAL = 1\n132:     LAWFUL = 2\n133:     UNALIGNED = 3\n134: \n135:     name_to_alignment = {\n136:         'chaotic': CHAOTIC,\n137:         'neutral': NEUTRAL,\n138:         'lawful': LAWFUL,\n139:         'unaligned': UNALIGNED,\n140:     }\n141: \n142:     HUMAN = 0\n143:     DWARF = 1\n144:     ELF = 2\n145:     GNOME = 3\n146:     ORC = 4\n147: \n148:     name_to_race = {\n149:         'human': HUMAN,\n150:         'dwarf': DWARF,\n151:         'dwarven': DWARF,\n152:         'elf': ELF,\n153:         'elven': ELF,\n154:         'gnome': GNOME,\n155:         'gnomish': GNOME,\n156:         'orc': ORC,\n157:         'orcish': ORC,\n158:     }\n159: \n160:     MALE = 0\n161:     FEMALE = 1\n162: \n163:     name_to_gender = {\n164:         'male': MALE,\n165:         'female': FEMALE,\n166:     }\n167: \n168:     name_to_skill_type = {\n169:         # \"\": O.P_NONE,\n170:         \"dagger\": O.P_DAGGER,\n171:         \"knife\": O.P_KNIFE,\n172:         \"axe\": O.P_AXE,\n173:         \"pick-axe\": O.P_PICK_AXE,\n174:         \"short sword\": O.P_SHORT_SWORD,\n175:         \"broadsword\": O.P_BROAD_SWORD,\n176:         \"long sword\": O.P_LONG_SWORD,\n177:         \"two-handed sword\": O.P_TWO_HANDED_SWORD,\n178:         \"scimitar\": O.P_SCIMITAR,\n179:         \"saber\": O.P_SABER,\n180:         \"club\": O.P_CLUB,\n181:         \"mace\": O.P_MACE,\n182:         \"morning star\": O.P_MORNING_STAR,\n183:         \"flail\": O.P_FLAIL,\n184:         \"hammer\": O.P_HAMMER,\n185:         \"quarterstaff\": O.P_QUARTERSTAFF,\n186:         \"polearms\": O.P_POLEARMS,\n187:         \"spear\": O.P_SPEAR,\n188:         \"trident\": O.P_TRIDENT,\n189:         \"lance\": O.P_LANCE,\n190:         \"bow\": O.P_BOW,\n191:         \"sling\": O.P_SLING,\n192:         \"crossbow\": O.P_CROSSBOW,\n193:         \"dart\": O.P_DART,\n194:         \"shuriken\": O.P_SHURIKEN,\n195:         \"boomerang\": O.P_BOOMERANG,\n196:         \"whip\": O.P_WHIP,\n197:         \"unicorn horn\": O.P_UNICORN_HORN,\n198: \n199:         \"attack spells\": O.P_ATTACK_SPELL,\n200:         \"healing spells\": O.P_HEALING_SPELL,\n201:         \"divination spells\": O.P_DIVINATION_SPELL,\n202:         \"enchantment spells\": O.P_ENCHANTMENT_SPELL,\n203:         \"clerical spells\": O.P_CLERIC_SPELL,\n204:         \"escape spells\": O.P_ESCAPE_SPELL,\n205:         \"matter spells\": O.P_MATTER_SPELL,\n206: \n207:         \"bare handed combat\": O.P_BARE_HANDED_COMBAT,\n208:         \"martial arts\": O.P_BARE_HANDED_COMBAT,\n209:         \"two weapon combat\": O.P_TWO_WEAPON_COMBAT,\n210:         \"riding\": O.P_RIDING,\n211:     }\n212: \n213:     possible_skill_types = ['Fighting Skills', 'Weapon Skills', 'Spellcasting Skills']\n214:     possible_skill_levels = ['Unskilled', 'Basic', 'Skilled', 'Expert', 'Master', 'Grand Master']\n215: \n216:     SKILL_LEVEL_RESTRICTED = 0\n217:     SKILL_LEVEL_UNSKILLED = 1\n218:     SKILL_LEVEL_BASIC = 2\n219:     SKILL_LEVEL_SKILLED = 3\n220:     SKILL_LEVEL_EXPERT = 4\n221:     SKILL_LEVEL_MASTER = 5\n222:     SKILL_LEVEL_GRAND_MASTER = 6\n223: \n224:     weapon_bonus = {\n225:         SKILL_LEVEL_RESTRICTED: (-4, 2),\n226:         SKILL_LEVEL_UNSKILLED: (-4, 2),\n227:         SKILL_LEVEL_BASIC: (0, 0),\n228:         SKILL_LEVEL_SKILLED: (2, 1),\n229:         SKILL_LEVEL_EXPERT: (3, 2),\n230:     }\n231:     two_weapon_bonus = {\n232:         SKILL_LEVEL_RESTRICTED: (-9, -3),\n233:         SKILL_LEVEL_UNSKILLED: (-9, -3),\n234:         SKILL_LEVEL_BASIC: (-7, -1),\n235:         SKILL_LEVEL_SKILLED: (-5, 0),\n236:         SKILL_LEVEL_EXPERT: (-3, 1),\n237:     }\n238:     riding_bonus = {\n239:         SKILL_LEVEL_RESTRICTED: (-2, 0),\n240:         SKILL_LEVEL_UNSKILLED: (-2, 0),\n241:         SKILL_LEVEL_BASIC: (-1, 0),\n242:         SKILL_LEVEL_SKILLED: (0, 1),\n243:         SKILL_LEVEL_EXPERT: (0, 2),\n244:     }\n245:     unarmed_bonus = {\n246:         SKILL_LEVEL_RESTRICTED: (1, 0),\n247:         SKILL_LEVEL_UNSKILLED: (1, 0),\n248:         SKILL_LEVEL_BASIC: (1, 1),\n249:         SKILL_LEVEL_SKILLED: (2, 1),\n250:         SKILL_LEVEL_EXPERT: (2, 2),\n251:         SKILL_LEVEL_MASTER: (3, 2),\n252:         SKILL_LEVEL_GRAND_MASTER: (3, 3),\n253:     }\n254:     martial_bonus = {\n255:         SKILL_LEVEL_RESTRICTED: (1, 0),  # no one has it restricted\n256:         SKILL_LEVEL_UNSKILLED: (2, 1),\n257:         SKILL_LEVEL_BASIC: (3, 3),\n258:         SKILL_LEVEL_SKILLED: (4, 4),\n259:         SKILL_LEVEL_EXPERT: (5, 6),\n260:         SKILL_LEVEL_MASTER: (6, 7),\n261:         SKILL_LEVEL_GRAND_MASTER: (7, 9),\n262:     }\n263: \n264:     name_to_skill_level = {k: v for k, v in zip(['Restricted'] + possible_skill_levels,\n265:                                                 [SKILL_LEVEL_RESTRICTED,\n266:                                                  SKILL_LEVEL_UNSKILLED, SKILL_LEVEL_BASIC, SKILL_LEVEL_SKILLED,\n267:                                                  SKILL_LEVEL_EXPERT,\n268:                                                  SKILL_LEVEL_MASTER, SKILL_LEVEL_GRAND_MASTER])}\n269: \n270:     def __init__(self, agent):\n271:         self.agent = agent\n272:         self.prop = Property(agent)\n273:         self.role = None\n274:         self.alignment = None\n275:         self.race = None\n276:         self.gender = None\n277:         self.self_glyph = None\n278:         self.skill_levels = np.zeros(max(self.name_to_skill_type.values()) + 1, dtype=int)\n279:         self.upgradable_skills = dict()\n280: \n281:         self.is_lycanthrope = False\n282:         # 'rat' / 'jackal' / 'wolf' (were.c were_beastie families), None if unknown (LYCAN_FIXES)\n283:         self.lycanthrope_kind = None\n284:         # HP before the current polymorph: while polymorphed, blstats show the form's HP, and that form\n285:         # dying only rehumanizes us (polyself.c rehumanize) back to this HP (LYCAN_FIXES)\n286:         self.hp_before_poly = None\n287:         self._was_polymorphed = False\n288:         # intrinsics from corpses (eat.c cpostfx), attrcurse takes them away: read by jf_config.SHOP_GUARD\n289:         self.teleportitis = False\n290:         self.teleport_control = False\n291: \n292:     def _track_teleport(self, msg):\n293:         # eat.c cpostfx: 'You feel very jumpy.' (hallucinating: 'diffuse.') gives teleportitis, 'You feel in control\n294:         # of yourself.' ('centered in your personal space.') teleport control; sit.c attrcurse: 'You feel less jumpy.'\n295:         if 'You feel very jumpy' in msg or 'You feel diffuse' in msg:\n296:             if not self.teleportitis:\n297:                 self.agent.log('INTRINSIC teleportitis')\n298:             self.teleportitis = True\n299:         if 'You feel less jumpy' in msg:\n300:             self.teleportitis = False\n301:         if 'You feel in control of yourself' in msg or 'centered in your personal space' in msg:\n302:             self.teleport_control = True\n303: \n304:     _WERE_KIND = re.compile(r'\\bwere(rat|jackal|wolf)\\b')\n305:     _TURN_INTO_WERE = re.compile(r'You turn into an? were(rat|jackal|wolf)!')\n306: \n307:     def update(self):\n308:         from . import jf_config\n309:         if not jf_config.LYCAN_FIXES:\n310:             if 'You feel feverish.' in self.agent.message:\n311:                 self.is_lycanthrope = True\n312:             if 'You feel purified.' in self.agent.message:\n313:                 self.is_lycanthrope = False\n314:             self._track_teleport(self.agent.message)\n315:             return\n316:         # every message since the last update: infections and changes happen inside atomic operations\n317:         # (fights, searches), and the old check of the last message alone missed some of them\n318:         history = self.agent._message_history\n319:         start = getattr(self, '_history_seen', 0)\n320:         if start > len(history):   # a fresh agent after a driver restart\n321:             start = 0\n322:         self._history_seen = len(history)\n323:         msg = ' '.join(history[start:] + [self.agent.message])\n324:         self._track_teleport(msg)\n325:         # infected while fainted or asleep the message is 'You dream that you feel feverish.' (75 of 591\n326:         # infections in the dev runs): the old exact match never saw it, so no cure prayer came and the\n327:         # bot went on eating jackal corpses (jf25 s10: 'You cannibal!', Luck -2..-5, next prayer failed)\n328:         pos = msg.rfind('feel feverish')\n329:         if pos >= 0:\n330:             self.is_lycanthrope = True\n331:             # the bite may come a turn earlier than the fever ('The wererat bites!' T9061, 'You feel\n332:             # feverish.' T9062 in public s4): look a few messages back for the biter\n333:             context = ' '.join(history[max(0, start - 8):start]) + ' ' + msg[:pos]\n334:             kinds = self._WERE_KIND.findall(context)\n335:             self.lycanthrope_kind = kinds[-1] if kinds else None\n336:             self.agent.log(f'LYCAN infected (kind {self.lycanthrope_kind})')\n337:         m = None\n338:         for m in self._TURN_INTO_WERE.finditer(msg):\n339:             pass\n340:         if m is not None:\n341:             if not self.is_lycanthrope or self.lycanthrope_kind != m.group(1):\n342:                 self.agent.log(f'LYCAN changed into a were{m.group(1)}')\n343:             self.is_lycanthrope = True\n344:             self.lycanthrope_kind = m.group(1)\n345:         if 'You feel purified' in msg[max(pos, 0):]:\n346:             self.is_lycanthrope = False\n347:             self.lycanthrope_kind = None\n348:             self.agent.log('LYCAN cured')\n349:         polymorphed = self.prop.polymorph\n350:         if polymorphed and not self._was_polymorphed:\n351:             bl = self.agent.blstats\n352:             # the last HP seen before the change (this step already shows the new form's HP)\n353:             self.hp_before_poly = getattr(self, '_last_normal_hp', None)\n354:             self.agent.log(f'POLY changed form; HP before: {self.hp_before_poly} now {bl.hitpoints}/{bl.max_hitpoints}')\n355:         if not polymorphed:\n356:             bl = self.agent.blstats\n357:             self._last_normal_hp = (bl.hitpoints, bl.max_hitpoints)\n358:             self.hp_before_poly = None\n359:         self._was_polymorphed = polymorphed\n360: \n361:     def were_family(self):\n362:         \"\"\"Corpse species that are cannibalism for us now (eat.c maybe_cannibal: were_beastie(pm) ==\n363:         u.ulycn): the whole family of our lycanthropy, or of all three when we don't know which.\"\"\"\n364:         families = {'rat': ('sewer rat', 'giant rat', 'rabid rat', 'wererat'),\n365:                     'jackal': ('jackal', 'fox', 'coyote', 'werejackal'),\n366:                     'wolf': ('wolf', 'warg', 'winter wolf', 'werewolf')}\n367:         if not self.is_lycanthrope:\n368:             return ()\n369:         if self.lycanthrope_kind in families:\n370:             return families[self.lycanthrope_kind]\n371:         return tuple(n for names in families.values() for n in names)\n372: \n373:     def poly_hp_is_buffer(self):\n374:         \"\"\"Polymorphed (a were form) with healthy HP to return to: the form's low HP is no emergency\n375:         -- when it hits 0 we just rehumanize (polyself.c) with the HP we had before the change.\"\"\"\n376:         if not self.prop.polymorph or self.hp_before_poly is None:\n377:             return False\n378:         hp, maxhp = self.hp_before_poly\n379:         return hp >= max(12, maxhp / 3)\n380: \n381:     @property\n382:     def carrying_capacity(self):\n383:         # TODO: levitation, etc\n384:         cap = min(1000, (self.agent.blstats.strength_percentage + self.agent.blstats.constitution) * 25 + 50)\n385:         # UNSQUEEZE: boxed in by diagonal squeezes (hack.c cant_squeeze_thru: > 600 carried), keep under 600\n386:         if self.agent.blstats.time < getattr(self.agent, '_squeeze_cap_until', -1):\n387:             cap = min(cap, 550)\n388:         return cap\n389: \n390:     def parse(self):\n391:         with self.agent.atom_operation():\n392:             self.agent.step(A.Command.ATTRIBUTES)\n393:             text = ' '.join(self.agent.popup)\n394:             self._parse(text)\n395:             self.self_glyph = self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n396: \n397:     def _parse(self, text):\n398:         matches = re.findall('You are a ([a-z]+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+).', text)\n399:         if len(matches) == 1:\n400:             alignment, _, gender, race, role = matches[0]\n401:         else:\n402:             matches = re.findall(\n403:                 # rank titles can contain hyphens (a Valkyrie at XL 10-13 is a \"Woman-at-arms\")\n404:                 'You are an? ([a-zA-Z -]+), a level (\\d+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+). *You are ([a-z]+)',\n405:                 text)\n406:             assert len(matches) == 1, repr(text)\n407:             _, _, _, gender, race, role, alignment = matches[0]\n408: \n409:         if not gender:\n410:             if role == 'Priestess':\n411:                 gender = 'female'\n412:             elif role == 'Priest':\n413:                 gender = 'male'\n414:             elif role == 'Caveman':\n415:                 gender = 'male'\n416:             elif role == 'Cavewoman':\n417:                 gender = 'female'\n418:             elif role == 'Valkyrie':\n419:                 gender = 'female'\n420:             else:\n421:                 assert 0, repr(text)\n422: \n423:         self.role = self.name_to_role[role]\n424:         self.alignment = self.name_to_alignment[alignment]\n425:         self.race = self.name_to_race[race]\n426:         self.gender = self.name_to_gender[gender]\n427: \n428:     def parse_spellcast_view(self):\n429:         self.known_spells = dict()\n430:         self.spell_fail_chance = dict()\n431: \n432:         # TODO: parse for other spellcaster classes\n433:         if self.role not in (self.HEALER,):\n434:             return\n435: \n436:         with self.agent.atom_operation():\n437:             self.agent.step(A.Command.CAST)\n438:             if not self.agent.popup:\n439:                 self.known_spells[self.agent.message] = None\n440:                 return\n441:             if self.agent.popup[0] not in ('Choose which spell to cast') or \\\n442:                     not self.agent.popup[1].startswith('Name'):\n443:                 raise ValueError(f'Invalid cast popup text format: {self.agent.popup}')\n444:             for line in self.agent.popup[2:]:\n445:                 matches = re.findall(r'^([a-zA-Z]) - *' +\n446:                                      r'(' + '|'.join(ALL_SPELL_NAMES) + ') *' +\n447:                                      r'([0-9]*) *' +\n448:                                      r'(' + '|'.join(ALL_SPELL_CATEGORIES) + ') *' +\n449:                                      r'([0-9]*)\\% *' +\n450:                                      r'([0-9]*\\%|\\(gone\\))', line)\n451:                 assert len(matches) == 1, (matches, line)\n452:                 letter, spell_name, level, category, fail, retention = matches[0]\n453:                 assert len(letter) == 1, letter\n454:                 self.known_spells[spell_name] = letter\n455:                 self.spell_fail_chance[spell_name] = int(fail) / 100\n456:         self.agent.step(A.Command.ESC)\n457: \n458:     def parse_enhance_view(self):\n459:         with self.agent.atom_operation():\n460:             self.agent.step(A.Command.ENHANCE)\n461:             self._parse_enhance_view()\n462:             while self.upgradable_skills:\n463:                 to_upgrade = self.select_skill_to_upgrade()\n464:                 old_skill_level = self.skill_levels.copy()\n465:                 letter = self.upgradable_skills[to_upgrade]\n466: \n467:                 def type_letter():\n468:                     while f'{letter} - ' not in '\\n'.join(self.agent.single_popup):\n469:                         yield A.TextCharacters.SPACE\n470:                     yield letter\n471: \n472:                 self.agent.step(A.Command.ENHANCE, type_letter())\n473: \n474:                 self.agent.step(A.Command.ENHANCE)\n475:                 self._parse_enhance_view()\n476:                 assert (old_skill_level != self.skill_levels).any(), (old_skill_level, self.skill_levels)\n477: \n478:     def select_skill_to_upgrade(self):\n479:         assert self.upgradable_skills\n480:         # TODO: logic\n481:         return next(iter(self.upgradable_skills.keys()))\n482: \n483:     def _parse_enhance_view(self):\n484:         if self.agent.popup[0] not in ('Current skills:', 'Pick a skill to advance:'):\n485:             raise ValueError('Invalid ehance popup text format.' + str(self.agent.popup))\n486:         self.upgradable_skills = dict()\n487:         for line in self.agent.popup[1:]:\n488:             if line.strip() in self.possible_skill_types or \\\n489:                     line.strip() == '(Skill flagged by \"#\" cannot be enhanced any further.)' or \\\n490:                     line.strip() == '(Skills flagged by \"#\" cannot be enhanced any further.)' or \\\n491:                     line.strip() == '(Skill flagged by \"*\" may be enhanced when you\\'re more experienced.)' or \\\n492:                     line.strip() == '(Skills flagged by \"*\" may be enhanced when you\\'re more experienced.)':\n493:                 continue\n494:             matches = re.findall(r'^([a-zA-Z] -)?#?\\*? *' +\n495:                                  r'(' + '|'.join(self.name_to_skill_type.keys()) + ') *' +\n496:                                  r'\\[(' + '|'.join(self.possible_skill_levels) + ')\\]', line)\n497:             assert len(matches) == 1, (matches, line)\n498:             letter, skill_type, skill_level = matches[0]\n499:             if letter:\n500:                 letter = letter[0]\n501:                 assert letter not in self.upgradable_skills.values()\n502:                 self.upgradable_skills[self.name_to_skill_type[skill_type]] = letter\n503:             self.skill_levels[self.name_to_skill_type[skill_type]] = self.name_to_skill_level[skill_level]\n504: \n505:     def _get_str_dex_to_hit_bonus(self):\n506:         bonus = 0\n507:         # /* attack bonus for strength & dexterity */\n508:         # int\n509:         # abon()\n510:         # {\n511:         #     int sbon;\n512:         #     int str = ACURR(A_STR), dex = ACURR(A_DEX);\n513:         strength = self.agent.blstats.strength\n514:         dexterity = self.agent.blstats.dexterity\n515: \n516:         #     if (Upolyd)\n517:         #         return (adj_lev(&mons[u.umonnum]) - 3);\n518: \n519:         #     if (str < 6)\n520:         #         sbon = -2;\n521:         #     else if (str < 8)\n522:         #         sbon = -1;\n523:         #     else if (str < 17)\n524:         #         sbon = 0;\n525:         #     else if (str <= STR18(50))\n526:         #         sbon = 1; /* up to 18/50 */\n527:         #     else if (str < STR18(100))\n528:         #         sbon = 2;\n529:         #     else\n530:         #         sbon = 3;\n531:         if strength < 6:\n532:             bonus -= 2\n533:         elif strength < 8:\n534:             bonus -= 1\n535:         elif strength < 17:\n536:             pass\n537:         elif strength <= 18 + 50:\n538:             bonus += 1\n539:         elif strength < 18 + 100:\n540:             bonus += 2\n541:         else:\n542:             bonus += 3\n543: \n544:         #     /* Game tuning kludge: make it a bit easier for a low level character to\n545:         #      * hit */\n546:         #     sbon += (u.ulevel < 3) ? 1 : 0;\n547: \n548:         #     if (dex < 4)\n549:         #         return (sbon - 3);\n550:         #     else if (dex < 6)\n551:         #         return (sbon - 2);\n552:         #     else if (dex < 8)\n553:         #         return (sbon - 1);\n554:         #     else if (dex < 14)\n555:         #         return sbon;\n556:         #     else\n557:         #         return (sbon + dex - 14);\n558:         #\n559: \n560:         if dexterity < 4:\n561:             bonus -= 3\n562:         elif dexterity < 6:\n563:             bonus -= 2\n564:         elif dexterity < 8:\n565:             bonus -= 1\n566:         elif dexterity < 14:\n567:             pass\n568:         else:\n569:             return bonus + dexterity - 14\n570: \n571:         return bonus\n572: \n573:     def _get_weapon_skill_bonus(self, item):\n574:         \"\"\" Retuns a pair (to hit bonus, damage bonus) \"\"\"\n575: \n576:         if item is None:\n577:             if self.role in (self.MONK, self.SAMURAI):\n578:                 return self.martial_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n579:             else:\n580:                 return self.unarmed_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n581:         else:\n582:             # TODO: two weapon, riding\n583: \n584:             # TODO: proper sub\n585:             assert all(item.objs[0].sub == obj.sub for obj in item.objs), item.objs\n586:             sub = abs(item.objs[0].sub)\n587: \n588:             if not (0 <= sub < len(self.skill_levels)):\n589:                 raise ValueError('Invalid item sub: ' + str(item) + ' sub: ' + str(sub))\n590:             # TODO:\n591:             return self.weapon_bonus[self.skill_levels[sub]]\n592: \n593:     def get_ranged_bonus(self, launcher, ammo, monster=None, large_monster=False):\n594:         # TODO: check code/wiki\n595: \n596:         if launcher is not None:\n597:             assert launcher.is_launcher()\n598:             assert ammo.is_fired_projectile()\n599:         else:\n600:             assert ammo.is_thrown_projectile()\n601: \n602:         roll_offset = 0\n603:         dmg_bonus = 0\n604:         if launcher is not None:\n605:             skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(launcher)\n606:             roll_offset += skill_hit_bonus\n607:             roll_offset += launcher.get_weapon_bonus(large_monster)[0]\n608:             dmg_bonus += launcher.get_weapon_bonus(large_monster)[1]\n609: \n610:         roll_offset += ammo.get_weapon_bonus(large_monster)[0]\n611:         dmg_bonus += ammo.get_weapon_bonus(large_monster)[1]\n612: \n613:         return roll_offset, max(0, dmg_bonus)\n614: \n615:     def get_range(self, launcher, ammo):\n616:         # TODO: implement\n617:         return 7\n618: \n619:     def get_melee_bonus(self, item, monster=None, large_monster=False):\n620:         \"\"\" Returns a pair (to_hit, damaga)\n621:         https://github.com/facebookresearch/nle/blob/master/src/uhitm.c : find_roll_to_hit\n622:          \"\"\"\n623:         if monster is not None:\n624:             raise NotImplementedError()\n625: \n626:         # TODO:\n627:         # tmp = 1 + Luck + abon() + find_mac(mtmp) + u.uhitinc\n628:         # + maybe_polyd(youmonst.data->mlevel, u.ulevel);\n629:         roll_offset = 1 + self._get_str_dex_to_hit_bonus() + self.agent.blstats.experience_level\n630: \n631:         # TODO:\n632:         # /* some actions should occur only once during multiple attacks */\n633:         # if (!(*attk_count)++) {\n634:         #     /* knight's chivalry or samurai's giri */\n635:         #     check_caitiff(mtmp);\n636:         # }\n637: \n638:         # TODO:\n639:         # /* adjust vs. (and possibly modify) monster state */\n640:         # if (mtmp->mstun)\n641:         #     tmp += 2;\n642:         # if (mtmp->mflee)\n643:         #     tmp += 2;\n644: \n645:         # TODO:\n646:         # if (mtmp->msleeping) {\n647:         #     mtmp->msleeping = 0;\n648:         #     tmp += 2;\n649:         # }\n650: \n651:         # TODO:\n652:         # if (!mtmp->mcanmove) {\n653:         #     tmp += 4;\n654:         #     if (!rn2(10)) {\n655:         #         mtmp->mcanmove = 1;\n656:         #         mtmp->mfrozen = 0;\n657:         #     }\n658:         # }\n659: \n660:         # /* role/race adjustments */\n661: \n662:         # TODO: polymorphed\n663:         # if (Role_if(PM_MONK) && !Upolyd) {\n664:         if self.role == self.MONK:\n665:             # if (uarm)\n666:             if self.agent.inventory.items.suit is not None:\n667:                 # tmp -= (*role_roll_penalty = urole.spelarmr);\n668:                 roll_offset -= 20\n669:             elif item is None and self.agent.inventory.items.off_hand is None:\n670:                 #  else if (!uwep && !uarms)\n671:                 # tmp += (u.ulevel / 3) + 2;\n672:                 roll_offset += (self.agent.blstats.experience_level // 3) + 2\n673: \n674:         # TODO:\n675:         # if (is_orc(mtmp->data)\n676:         #     && maybe_polyd(is_elf(youmonst.data), Race_if(PM_ELF)))\n677:         #     tmp++;\n678: \n679:         # TODO:\n680:         # /* encumbrance: with a lot of luggage, your agility diminishes */\n681:         # if ((tmp2 = near_capacity()) != 0)\n682:         #     tmp -= (tmp2 * 2) - 1;\n683:         # if (u.utrap)\n684:         #     tmp -= 3;\n685: \n686:         # /*\n687:         #  * hitval applies if making a weapon attack while wielding a weapon;\n688:         #  * weapon_hit_bonus applies if doing a weapon attack even bare-handed\n689:         #  * or if kicking as martial artist\n690:         #  */\n691:         # if (aatyp == AT_WEAP || aatyp == AT_CLAW) {\n692:         #     if (weapon)\n693:         #         tmp += hitval(weapon, mtmp);\n694:         #     tmp += weapon_hit_bonus(weapon);\n695:         # } else if (aatyp == AT_KICK && martial_bonus()) {\n696:         #     tmp += weapon_hit_bonus((struct obj *) 0);\n697:         # }\n698:         skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(item)\n699:         roll_offset += skill_hit_bonus\n700: \n701:         if item is not None:\n702:             if item.is_launcher() or item.is_fired_projectile() or item.objs[0].name in ['dart', 'shuriken']:\n703:                 # TODO: rocks, boomerang\n704:                 dmg_bonus = 1.5  # 1d2\n705:             else:\n706:                 dmg_bonus += item.get_weapon_bonus(large_monster)[1]\n707:             roll_offset += item.get_weapon_bonus(large_monster)[0]\n708:         else:\n709:             # TODO: proper unarmed base damage\n710:             dmg_bonus += 1.5\n711:         return roll_offset, max(0, dmg_bonus)\n712: \n713:     def get_skill_str_list(self):\n714:         inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n715:         inv_skill_level = {v: k for k, v in self.name_to_skill_level.items()}\n716:         return list(inv_skill_type[skill_type] + '-' + inv_skill_level[level]\n717:                     for skill_type, level in enumerate(self.skill_levels)\n718:                     if level in inv_skill_level and skill_type in inv_skill_type and level != 0)\n719: \n720:     def __str__(self):\n721:         if self.role is None:\n722:             return 'unparsed_character'\n723:         skill_str = '| '.join(self.get_skill_str_list())\n724:         if self.upgradable_skills:\n725:             inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n726:             skill_str += '\\n Upgradable: ' + '|'.join(letter + '-' + inv_skill_type[skill]\n727:                                                       for skill, letter in self.upgradable_skills.items())\n728:         return '-'.join([f'{list(d.keys())[list(d.values()).index(v)][:3].lower()}'\n729:                          for d, v in [(self.name_to_role, self.role),\n730:                                       (self.name_to_race, self.race),\n731:                                       (self.name_to_gender, self.gender),\n732:                                       (self.name_to_alignment, self.alignment),\n733:                                       ]]) + '\\n Skills: ' + skill_str\n\n(End of file - total 733 lines)\n</content>","metadata":{"preview":"import re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\n\nALL_SPELL_NAMES = [\n    \"force bolt\",\n    \"drain life\",\n    \"magic missile\",\n    \"cone of cold\",\n    \"fireball\",\n    \"finger of death\",\n    \"protection\",\n    \"create monster\",\n    \"remove curse\",\n    \"create familiar\",\n    \"turn undead\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/character.py","text":"import re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\n\nALL_SPELL_NAMES = [\n    \"force bolt\",\n    \"drain life\",\n    \"magic missile\",\n    \"cone of cold\",\n    \"fireball\",\n    \"finger of death\",\n    \"protection\",\n    \"create monster\",\n    \"remove curse\",\n    \"create familiar\",\n    \"turn undead\",\n    \"detect monsters\",\n    \"light\",\n    \"detect food\",\n    \"clairvoyance\",\n    \"detect unseen\",\n    \"identify\",\n    \"detect treasure\",\n    \"magic mapping\",\n    \"sleep\",\n    \"confuse monster\",\n    \"slow monster\",\n    \"cause fear\",\n    \"charm monster\",\n    \"jumping\",\n    \"haste self\",\n    \"invisibility\",\n    \"levitation\",\n    \"teleport away\",\n    \"healing\",\n    \"cure blindness\",\n    \"cure sickness\",\n    \"extra healing\",\n    \"stone to flesh\",\n    \"restore ability\",\n    \"knock\",\n    \"wizard lock\",\n    \"dig\",\n    \"polymorph\",\n    \"cancellation\",\n]\n\nALL_SPELL_CATEGORIES = [\n    \"attack\",\n    \"healing\",\n    \"divination\",\n    \"enchantment\",\n    \"clerical\",\n    \"escape\",\n    \"matter\",\n]\n\n\nclass Property:\n    def __init__(self, agent):\n        self.agent = agent\n\n    # The tty status line abbreviates conditions when it gets long (e.g. 'Hallu' -> 'Hl'),\n    # so read them from the blstats condition bitmask instead.\n    def _condition(self, mask):\n        return bool(self.agent.last_observation['blstats'][nh.NLE_BL_CONDITION] & mask)\n\n    @property\n    def confusion(self):\n        return self._condition(nh.BL_MASK_CONF)\n\n    @property\n    def stun(self):\n        return self._condition(nh.BL_MASK_STUN)\n\n    @property\n    def hallu(self):\n        return self._condition(nh.BL_MASK_HALLU)\n\n    @property\n    def blind(self):\n        return self._condition(nh.BL_MASK_BLIND)\n\n    @property\n    def polymorph(self):\n        if not nh.glyph_is_monster(self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]):\n            return False\n        return self.agent.character.self_glyph != self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n\n\nclass Character:\n    UNKNOWN = -1  # for everything, e.g. alignment\n\n    ARCHEOLOGIST = 0\n    BARBARIAN = 1\n    CAVEMAN = 2\n    HEALER = 3\n    KNIGHT = 4\n    MONK = 5\n    PRIEST = 6\n    RANGER = 7\n    ROGUE = 8\n    SAMURAI = 9\n    TOURIST = 10\n    VALKYRIE = 11\n    WIZARD = 12\n\n    name_to_role = {\n        'Archeologist': ARCHEOLOGIST,\n        'Barbarian': BARBARIAN,\n        'Caveman': CAVEMAN,\n        'Cavewoman': CAVEMAN,\n        'Healer': HEALER,\n        'Knight': KNIGHT,\n        'Monk': MONK,\n        'Priest': PRIEST,\n        'Priestess': PRIEST,\n        'Ranger': RANGER,\n        'Rogue': ROGUE,\n        'Samurai': SAMURAI,\n        'Tourist': TOURIST,\n        'Valkyrie': VALKYRIE,\n        'Wizard': WIZARD,\n    }\n\n    CHAOTIC = 0\n    NEUTRAL = 1\n    LAWFUL = 2\n    UNALIGNED = 3\n\n    name_to_alignment = {\n        'chaotic': CHAOTIC,\n        'neutral': NEUTRAL,\n        'lawful': LAWFUL,\n        'unaligned': UNALIGNED,\n    }\n\n    HUMAN = 0\n    DWARF = 1\n    ELF = 2\n    GNOME = 3\n    ORC = 4\n\n    name_to_race = {\n        'human': HUMAN,\n        'dwarf': DWARF,\n        'dwarven': DWARF,\n        'elf': ELF,\n        'elven': ELF,\n        'gnome': GNOME,\n        'gnomish': GNOME,\n        'orc': ORC,\n        'orcish': ORC,\n    }\n\n    MALE = 0\n    FEMALE = 1\n\n    name_to_gender = {\n        'male': MALE,\n        'female': FEMALE,\n    }\n\n    name_to_skill_type = {\n        # \"\": O.P_NONE,\n        \"dagger\": O.P_DAGGER,\n        \"knife\": O.P_KNIFE,\n        \"axe\": O.P_AXE,\n        \"pick-axe\": O.P_PICK_AXE,\n        \"short sword\": O.P_SHORT_SWORD,\n        \"broadsword\": O.P_BROAD_SWORD,\n        \"long sword\": O.P_LONG_SWORD,\n        \"two-handed sword\": O.P_TWO_HANDED_SWORD,\n        \"scimitar\": O.P_SCIMITAR,\n        \"saber\": O.P_SABER,\n        \"club\": O.P_CLUB,\n        \"mace\": O.P_MACE,\n        \"morning star\": O.P_MORNING_STAR,\n        \"flail\": O.P_FLAIL,\n        \"hammer\": O.P_HAMMER,\n        \"quarterstaff\": O.P_QUARTERSTAFF,\n        \"polearms\": O.P_POLEARMS,\n        \"spear\": O.P_SPEAR,\n        \"trident\": O.P_TRIDENT,\n        \"lance\": O.P_LANCE,\n        \"bow\": O.P_BOW,\n        \"sling\": O.P_SLING,\n        \"crossbow\": O.P_CROSSBOW,\n        \"dart\": O.P_DART,\n        \"shuriken\": O.P_SHURIKEN,\n        \"boomerang\": O.P_BOOMERANG,\n        \"whip\": O.P_WHIP,\n        \"unicorn horn\": O.P_UNICORN_HORN,\n\n        \"attack spells\": O.P_ATTACK_SPELL,\n        \"healing spells\": O.P_HEALING_SPELL,\n        \"divination spells\": O.P_DIVINATION_SPELL,\n        \"enchantment spells\": O.P_ENCHANTMENT_SPELL,\n        \"clerical spells\": O.P_CLERIC_SPELL,\n        \"escape spells\": O.P_ESCAPE_SPELL,\n        \"matter spells\": O.P_MATTER_SPELL,\n\n        \"bare handed combat\": O.P_BARE_HANDED_COMBAT,\n        \"martial arts\": O.P_BARE_HANDED_COMBAT,\n        \"two weapon combat\": O.P_TWO_WEAPON_COMBAT,\n        \"riding\": O.P_RIDING,\n    }\n\n    possible_skill_types = ['Fighting Skills', 'Weapon Skills', 'Spellcasting Skills']\n    possible_skill_levels = ['Unskilled', 'Basic', 'Skilled', 'Expert', 'Master', 'Grand Master']\n\n    SKILL_LEVEL_RESTRICTED = 0\n    SKILL_LEVEL_UNSKILLED = 1\n    SKILL_LEVEL_BASIC = 2\n    SKILL_LEVEL_SKILLED = 3\n    SKILL_LEVEL_EXPERT = 4\n    SKILL_LEVEL_MASTER = 5\n    SKILL_LEVEL_GRAND_MASTER = 6\n\n    weapon_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-4, 2),\n        SKILL_LEVEL_UNSKILLED: (-4, 2),\n        SKILL_LEVEL_BASIC: (0, 0),\n        SKILL_LEVEL_SKILLED: (2, 1),\n        SKILL_LEVEL_EXPERT: (3, 2),\n    }\n    two_weapon_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-9, -3),\n        SKILL_LEVEL_UNSKILLED: (-9, -3),\n        SKILL_LEVEL_BASIC: (-7, -1),\n        SKILL_LEVEL_SKILLED: (-5, 0),\n        SKILL_LEVEL_EXPERT: (-3, 1),\n    }\n    riding_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-2, 0),\n        SKILL_LEVEL_UNSKILLED: (-2, 0),\n        SKILL_LEVEL_BASIC: (-1, 0),\n        SKILL_LEVEL_SKILLED: (0, 1),\n        SKILL_LEVEL_EXPERT: (0, 2),\n    }\n    unarmed_bonus = {\n        SKILL_LEVEL_RESTRICTED: (1, 0),\n        SKILL_LEVEL_UNSKILLED: (1, 0),\n        SKILL_LEVEL_BASIC: (1, 1),\n        SKILL_LEVEL_SKILLED: (2, 1),\n        SKILL_LEVEL_EXPERT: (2, 2),\n        SKILL_LEVEL_MASTER: (3, 2),\n        SKILL_LEVEL_GRAND_MASTER: (3, 3),\n    }\n    martial_bonus = {\n        SKILL_LEVEL_RESTRICTED: (1, 0),  # no one has it restricted\n        SKILL_LEVEL_UNSKILLED: (2, 1),\n        SKILL_LEVEL_BASIC: (3, 3),\n        SKILL_LEVEL_SKILLED: (4, 4),\n        SKILL_LEVEL_EXPERT: (5, 6),\n        SKILL_LEVEL_MASTER: (6, 7),\n        SKILL_LEVEL_GRAND_MASTER: (7, 9),\n    }\n\n    name_to_skill_level = {k: v for k, v in zip(['Restricted'] + possible_skill_levels,\n                                                [SKILL_LEVEL_RESTRICTED,\n                                                 SKILL_LEVEL_UNSKILLED, SKILL_LEVEL_BASIC, SKILL_LEVEL_SKILLED,\n                                                 SKILL_LEVEL_EXPERT,\n                                                 SKILL_LEVEL_MASTER, SKILL_LEVEL_GRAND_MASTER])}\n\n    def __init__(self, agent):\n        self.agent = agent\n        self.prop = Property(agent)\n        self.role = None\n        self.alignment = None\n        self.race = None\n        self.gender = None\n        self.self_glyph = None\n        self.skill_levels = np.zeros(max(self.name_to_skill_type.values()) + 1, dtype=int)\n        self.upgradable_skills = dict()\n\n        self.is_lycanthrope = False\n        # 'rat' / 'jackal' / 'wolf' (were.c were_beastie families), None if unknown (LYCAN_FIXES)\n        self.lycanthrope_kind = None\n        # HP before the current polymorph: while polymorphed, blstats show the form's HP, and that form\n        # dying only rehumanizes us (polyself.c rehumanize) back to this HP (LYCAN_FIXES)\n        self.hp_before_poly = None\n        self._was_polymorphed = False\n        # intrinsics from corpses (eat.c cpostfx), attrcurse takes them away: read by jf_config.SHOP_GUARD\n        self.teleportitis = False\n        self.teleport_control = False\n\n    def _track_teleport(self, msg):\n        # eat.c cpostfx: 'You feel very jumpy.' (hallucinating: 'diffuse.') gives teleportitis, 'You feel in control\n        # of yourself.' ('centered in your personal space.') teleport control; sit.c attrcurse: 'You feel less jumpy.'\n        if 'You feel very jumpy' in msg or 'You feel diffuse' in msg:\n            if not self.teleportitis:\n                self.agent.log('INTRINSIC teleportitis')\n            self.teleportitis = True\n        if 'You feel less jumpy' in msg:\n            self.teleportitis = False\n        if 'You feel in control of yourself' in msg or 'centered in your personal space' in msg:\n            self.teleport_control = True\n\n    _WERE_KIND = re.compile(r'\\bwere(rat|jackal|wolf)\\b')\n    _TURN_INTO_WERE = re.compile(r'You turn into an? were(rat|jackal|wolf)!')\n\n    def update(self):\n        from . import jf_config\n        if not jf_config.LYCAN_FIXES:\n            if 'You feel feverish.' in self.agent.message:\n                self.is_lycanthrope = True\n            if 'You feel purified.' in self.agent.message:\n                self.is_lycanthrope = False\n            self._track_teleport(self.agent.message)\n            return\n        # every message since the last update: infections and changes happen inside atomic operations\n        # (fights, searches), and the old check of the last message alone missed some of them\n        history = self.agent._message_history\n        start = getattr(self, '_history_seen', 0)\n        if start > len(history):   # a fresh agent after a driver restart\n            start = 0\n        self._history_seen = len(history)\n        msg = ' '.join(history[start:] + [self.agent.message])\n        self._track_teleport(msg)\n        # infected while fainted or asleep the message is 'You dream that you feel feverish.' (75 of 591\n        # infections in the dev runs): the old exact match never saw it, so no cure prayer came and the\n        # bot went on eating jackal corpses (jf25 s10: 'You cannibal!', Luck -2..-5, next prayer failed)\n        pos = msg.rfind('feel feverish')\n        if pos >= 0:\n            self.is_lycanthrope = True\n            # the bite may come a turn earlier than the fever ('The wererat bites!' T9061, 'You feel\n            # feverish.' T9062 in public s4): look a few messages back for the biter\n            context = ' '.join(history[max(0, start - 8):start]) + ' ' + msg[:pos]\n            kinds = self._WERE_KIND.findall(context)\n            self.lycanthrope_kind = kinds[-1] if kinds else None\n            self.agent.log(f'LYCAN infected (kind {self.lycanthrope_kind})')\n        m = None\n        for m in self._TURN_INTO_WERE.finditer(msg):\n            pass\n        if m is not None:\n            if not self.is_lycanthrope or self.lycanthrope_kind != m.group(1):\n                self.agent.log(f'LYCAN changed into a were{m.group(1)}')\n            self.is_lycanthrope = True\n            self.lycanthrope_kind = m.group(1)\n        if 'You feel purified' in msg[max(pos, 0):]:\n            self.is_lycanthrope = False\n            self.lycanthrope_kind = None\n            self.agent.log('LYCAN cured')\n        polymorphed = self.prop.polymorph\n        if polymorphed and not self._was_polymorphed:\n            bl = self.agent.blstats\n            # the last HP seen before the change (this step already shows the new form's HP)\n            self.hp_before_poly = getattr(self, '_last_normal_hp', None)\n            self.agent.log(f'POLY changed form; HP before: {self.hp_before_poly} now {bl.hitpoints}/{bl.max_hitpoints}')\n        if not polymorphed:\n            bl = self.agent.blstats\n            self._last_normal_hp = (bl.hitpoints, bl.max_hitpoints)\n            self.hp_before_poly = None\n        self._was_polymorphed = polymorphed\n\n    def were_family(self):\n        \"\"\"Corpse species that are cannibalism for us now (eat.c maybe_cannibal: were_beastie(pm) ==\n        u.ulycn): the whole family of our lycanthropy, or of all three when we don't know which.\"\"\"\n        families = {'rat': ('sewer rat', 'giant rat', 'rabid rat', 'wererat'),\n                    'jackal': ('jackal', 'fox', 'coyote', 'werejackal'),\n                    'wolf': ('wolf', 'warg', 'winter wolf', 'werewolf')}\n        if not self.is_lycanthrope:\n            return ()\n        if self.lycanthrope_kind in families:\n            return families[self.lycanthrope_kind]\n        return tuple(n for names in families.values() for n in names)\n\n    def poly_hp_is_buffer(self):\n        \"\"\"Polymorphed (a were form) with healthy HP to return to: the form's low HP is no emergency\n        -- when it hits 0 we just rehumanize (polyself.c) with the HP we had before the change.\"\"\"\n        if not self.prop.polymorph or self.hp_before_poly is None:\n            return False\n        hp, maxhp = self.hp_before_poly\n        return hp >= max(12, maxhp / 3)\n\n    @property\n    def carrying_capacity(self):\n        # TODO: levitation, etc\n        cap = min(1000, (self.agent.blstats.strength_percentage + self.agent.blstats.constitution) * 25 + 50)\n        # UNSQUEEZE: boxed in by diagonal squeezes (hack.c cant_squeeze_thru: > 600 carried), keep under 600\n        if self.agent.blstats.time < getattr(self.agent, '_squeeze_cap_until', -1):\n            cap = min(cap, 550)\n        return cap\n\n    def parse(self):\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.ATTRIBUTES)\n            text = ' '.join(self.agent.popup)\n            self._parse(text)\n            self.self_glyph = self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n\n    def _parse(self, text):\n        matches = re.findall('You are a ([a-z]+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+).', text)\n        if len(matches) == 1:\n            alignment, _, gender, race, role = matches[0]\n        else:\n            matches = re.findall(\n                # rank titles can contain hyphens (a Valkyrie at XL 10-13 is a \"Woman-at-arms\")\n                'You are an? ([a-zA-Z -]+), a level (\\d+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+). *You are ([a-z]+)',\n                text)\n            assert len(matches) == 1, repr(text)\n            _, _, _, gender, race, role, alignment = matches[0]\n\n        if not gender:\n            if role == 'Priestess':\n                gender = 'female'\n            elif role == 'Priest':\n                gender = 'male'\n            elif role == 'Caveman':\n                gender = 'male'\n            elif role == 'Cavewoman':\n                gender = 'female'\n            elif role == 'Valkyrie':\n                gender = 'female'\n            else:\n                assert 0, repr(text)\n\n        self.role = self.name_to_role[role]\n        self.alignment = self.name_to_alignment[alignment]\n        self.race = self.name_to_race[race]\n        self.gender = self.name_to_gender[gender]\n\n    def parse_spellcast_view(self):\n        self.known_spells = dict()\n        self.spell_fail_chance = dict()\n\n        # TODO: parse for other spellcaster classes\n        if self.role not in (self.HEALER,):\n            return\n\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.CAST)\n            if not self.agent.popup:\n                self.known_spells[self.agent.message] = None\n                return\n            if self.agent.popup[0] not in ('Choose which spell to cast') or \\\n                    not self.agent.popup[1].startswith('Name'):\n                raise ValueError(f'Invalid cast popup text format: {self.agent.popup}')\n            for line in self.agent.popup[2:]:\n                matches = re.findall(r'^([a-zA-Z]) - *' +\n                                     r'(' + '|'.join(ALL_SPELL_NAMES) + ') *' +\n                                     r'([0-9]*) *' +\n                                     r'(' + '|'.join(ALL_SPELL_CATEGORIES) + ') *' +\n                                     r'([0-9]*)\\% *' +\n                                     r'([0-9]*\\%|\\(gone\\))', line)\n                assert len(matches) == 1, (matches, line)\n                letter, spell_name, level, category, fail, retention = matches[0]\n                assert len(letter) == 1, letter\n                self.known_spells[spell_name] = letter\n                self.spell_fail_chance[spell_name] = int(fail) / 100\n        self.agent.step(A.Command.ESC)\n\n    def parse_enhance_view(self):\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.ENHANCE)\n            self._parse_enhance_view()\n            while self.upgradable_skills:\n                to_upgrade = self.select_skill_to_upgrade()\n                old_skill_level = self.skill_levels.copy()\n                letter = self.upgradable_skills[to_upgrade]\n\n                def type_letter():\n                    while f'{letter} - ' not in '\\n'.join(self.agent.single_popup):\n                        yield A.TextCharacters.SPACE\n                    yield letter\n\n                self.agent.step(A.Command.ENHANCE, type_letter())\n\n                self.agent.step(A.Command.ENHANCE)\n                self._parse_enhance_view()\n                assert (old_skill_level != self.skill_levels).any(), (old_skill_level, self.skill_levels)\n\n    def select_skill_to_upgrade(self):\n        assert self.upgradable_skills\n        # TODO: logic\n        return next(iter(self.upgradable_skills.keys()))\n\n    def _parse_enhance_view(self):\n        if self.agent.popup[0] not in ('Current skills:', 'Pick a skill to advance:'):\n            raise ValueError('Invalid ehance popup text format.' + str(self.agent.popup))\n        self.upgradable_skills = dict()\n        for line in self.agent.popup[1:]:\n            if line.strip() in self.possible_skill_types or \\\n                    line.strip() == '(Skill flagged by \"#\" cannot be enhanced any further.)' or \\\n                    line.strip() == '(Skills flagged by \"#\" cannot be enhanced any further.)' or \\\n                    line.strip() == '(Skill flagged by \"*\" may be enhanced when you\\'re more experienced.)' or \\\n                    line.strip() == '(Skills flagged by \"*\" may be enhanced when you\\'re more experienced.)':\n                continue\n            matches = re.findall(r'^([a-zA-Z] -)?#?\\*? *' +\n                                 r'(' + '|'.join(self.name_to_skill_type.keys()) + ') *' +\n                                 r'\\[(' + '|'.join(self.possible_skill_levels) + ')\\]', line)\n            assert len(matches) == 1, (matches, line)\n            letter, skill_type, skill_level = matches[0]\n            if letter:\n                letter = letter[0]\n                assert letter not in self.upgradable_skills.values()\n                self.upgradable_skills[self.name_to_skill_type[skill_type]] = letter\n            self.skill_levels[self.name_to_skill_type[skill_type]] = self.name_to_skill_level[skill_level]\n\n    def _get_str_dex_to_hit_bonus(self):\n        bonus = 0\n        # /* attack bonus for strength & dexterity */\n        # int\n        # abon()\n        # {\n        #     int sbon;\n        #     int str = ACURR(A_STR), dex = ACURR(A_DEX);\n        strength = self.agent.blstats.strength\n        dexterity = self.agent.blstats.dexterity\n\n        #     if (Upolyd)\n        #         return (adj_lev(&mons[u.umonnum]) - 3);\n\n        #     if (str < 6)\n        #         sbon = -2;\n        #     else if (str < 8)\n        #         sbon = -1;\n        #     else if (str < 17)\n        #         sbon = 0;\n        #     else if (str <= STR18(50))\n        #         sbon = 1; /* up to 18/50 */\n        #     else if (str < STR18(100))\n        #         sbon = 2;\n        #     else\n        #         sbon = 3;\n        if strength < 6:\n            bonus -= 2\n        elif strength < 8:\n            bonus -= 1\n        elif strength < 17:\n            pass\n        elif strength <= 18 + 50:\n            bonus += 1\n        elif strength < 18 + 100:\n            bonus += 2\n        else:\n            bonus += 3\n\n        #     /* Game tuning kludge: make it a bit easier for a low level character to\n        #      * hit */\n        #     sbon += (u.ulevel < 3) ? 1 : 0;\n\n        #     if (dex < 4)\n        #         return (sbon - 3);\n        #     else if (dex < 6)\n        #         return (sbon - 2);\n        #     else if (dex < 8)\n        #         return (sbon - 1);\n        #     else if (dex < 14)\n        #         return sbon;\n        #     else\n        #         return (sbon + dex - 14);\n        #\n\n        if dexterity < 4:\n            bonus -= 3\n        elif dexterity < 6:\n            bonus -= 2\n        elif dexterity < 8:\n            bonus -= 1\n        elif dexterity < 14:\n            pass\n        else:\n            return bonus + dexterity - 14\n\n        return bonus\n\n    def _get_weapon_skill_bonus(self, item):\n        \"\"\" Retuns a pair (to hit bonus, damage bonus) \"\"\"\n\n        if item is None:\n            if self.role in (self.MONK, self.SAMURAI):\n                return self.martial_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n            else:\n                return self.unarmed_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n        else:\n            # TODO: two weapon, riding\n\n            # TODO: proper sub\n            assert all(item.objs[0].sub == obj.sub for obj in item.objs), item.objs\n            sub = abs(item.objs[0].sub)\n\n            if not (0 <= sub < len(self.skill_levels)):\n                raise ValueError('Invalid item sub: ' + str(item) + ' sub: ' + str(sub))\n            # TODO:\n            return self.weapon_bonus[self.skill_levels[sub]]\n\n    def get_ranged_bonus(self, launcher, ammo, monster=None, large_monster=False):\n        # TODO: check code/wiki\n\n        if launcher is not None:\n            assert launcher.is_launcher()\n            assert ammo.is_fired_projectile()\n        else:\n            assert ammo.is_thrown_projectile()\n\n        roll_offset = 0\n        dmg_bonus = 0\n        if launcher is not None:\n            skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(launcher)\n            roll_offset += skill_hit_bonus\n            roll_offset += launcher.get_weapon_bonus(large_monster)[0]\n            dmg_bonus += launcher.get_weapon_bonus(large_monster)[1]\n\n        roll_offset += ammo.get_weapon_bonus(large_monster)[0]\n        dmg_bonus += ammo.get_weapon_bonus(large_monster)[1]\n\n        return roll_offset, max(0, dmg_bonus)\n\n    def get_range(self, launcher, ammo):\n        # TODO: implement\n        return 7\n\n    def get_melee_bonus(self, item, monster=None, large_monster=False):\n        \"\"\" Returns a pair (to_hit, damaga)\n        https://github.com/facebookresearch/nle/blob/master/src/uhitm.c : find_roll_to_hit\n         \"\"\"\n        if monster is not None:\n            raise NotImplementedError()\n\n        # TODO:\n        # tmp = 1 + Luck + abon() + find_mac(mtmp) + u.uhitinc\n        # + maybe_polyd(youmonst.data->mlevel, u.ulevel);\n        roll_offset = 1 + self._get_str_dex_to_hit_bonus() + self.agent.blstats.experience_level\n\n        # TODO:\n        # /* some actions should occur only once during multiple attacks */\n        # if (!(*attk_count)++) {\n        #     /* knight's chivalry or samurai's giri */\n        #     check_caitiff(mtmp);\n        # }\n\n        # TODO:\n        # /* adjust vs. (and possibly modify) monster state */\n        # if (mtmp->mstun)\n        #     tmp += 2;\n        # if (mtmp->mflee)\n        #     tmp += 2;\n\n        # TODO:\n        # if (mtmp->msleeping) {\n        #     mtmp->msleeping = 0;\n        #     tmp += 2;\n        # }\n\n        # TODO:\n        # if (!mtmp->mcanmove) {\n        #     tmp += 4;\n        #     if (!rn2(10)) {\n        #         mtmp->mcanmove = 1;\n        #         mtmp->mfrozen = 0;\n        #     }\n        # }\n\n        # /* role/race adjustments */\n\n        # TODO: polymorphed\n        # if (Role_if(PM_MONK) && !Upolyd) {\n        if self.role == self.MONK:\n            # if (uarm)\n            if self.agent.inventory.items.suit is not None:\n                # tmp -= (*role_roll_penalty = urole.spelarmr);\n                roll_offset -= 20\n            elif item is None and self.agent.inventory.items.off_hand is None:\n                #  else if (!uwep && !uarms)\n                # tmp += (u.ulevel / 3) + 2;\n                roll_offset += (self.agent.blstats.experience_level // 3) + 2\n\n        # TODO:\n        # if (is_orc(mtmp->data)\n        #     && maybe_polyd(is_elf(youmonst.data), Race_if(PM_ELF)))\n        #     tmp++;\n\n        # TODO:\n        # /* encumbrance: with a lot of luggage, your agility diminishes */\n        # if ((tmp2 = near_capacity()) != 0)\n        #     tmp -= (tmp2 * 2) - 1;\n        # if (u.utrap)\n        #     tmp -= 3;\n\n        # /*\n        #  * hitval applies if making a weapon attack while wielding a weapon;\n        #  * weapon_hit_bonus applies if doing a weapon attack even bare-handed\n        #  * or if kicking as