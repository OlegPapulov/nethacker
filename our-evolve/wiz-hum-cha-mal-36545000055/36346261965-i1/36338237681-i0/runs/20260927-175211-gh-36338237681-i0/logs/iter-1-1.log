{"type":"tool_use","timestamp":1790531890051,"sessionID":"ses_f1bfdb0f7ffeZlkE5FkbKms7fE","part":{"type":"tool","tool":"read","callID":"call-efc7283e-bfac-43c6-bd1a-73dadd7e303b","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/dive_logic.py"},"output":"<path>/workspace/autoascend/dive_logic.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Depth-first plan for the BALROG progression score.\n2: \n3: The episode score is the best milestone ever reached (death costs nothing):\n4: depth dominates (Dlvl 12 = 0.21, Dlvl 20 = 0.38, Dlvl 25 = 0.47) and stepping\n5: into the Quest home through the magic portal on Dlvl 11-16 is worth 0.366 on\n6: its own. So instead of AutoAscend's Mines/Sokoban tour, this plan:\n7: \n8:   * explores the first levels fully while under-levelled (items, XP),\n9:   * then dives the Dungeons of Doom by the nearest '>' / trap door / hole,\n10:   * on the Quest portal level (announced by a telepathic message) sweeps the\n11:     candidate rooms until the hidden portal fires, then walks back out,\n12:   * and keeps diving afterwards.\n13: \n14: The plan is a restartable loop of short tasks: fights, eating, prayer etc.\n15: preempt it at any step, so all decisions are re-derived from game state.\n16: \"\"\"\n17: \n18: import functools\n19: import re\n20: \n21: import nle.nethack as nh\n22: import numpy as np\n23: from nle.nethack import actions as A\n24: from scipy import ndimage\n25: \n26: from . import objects as O\n27: \n28: from . import jf_config, jf_log, power, utils, valley\n29: from .castle_logic import CastlePassage\n30: from .character import Character\n31: from .exceptions import AgentPanic\n32: from .glyph import C, G, MON, SS, Hunger\n33: from .level import Level\n34: from .item import Item, flatten_items\n35: from .strategy import Strategy\n36: \n37: ROOM_FLOOR = frozenset({SS.S_room, SS.S_darkroom})\n38: PLAIN_FLOOR = frozenset({SS.S_room, SS.S_darkroom, SS.S_corr, SS.S_litcorr})\n39: WET = frozenset({SS.S_pool, SS.S_water, SS.S_lava})\n40: CORRIDORS = frozenset({SS.S_corr, SS.S_litcorr})\n41: DOORWAYS = frozenset({SS.S_ndoor}) | G.DOORS\n42: FALL_TRAPS = frozenset({SS.S_trap_door, SS.S_hole})\n43: PORTAL = frozenset({SS.S_magic_portal})\n44: \n45: GEHENNOM = 1\n46: MAIN_LINE = (Level.DUNGEONS_OF_DOOM, GEHENNOM)\n47: \n48: PORTAL_MESSAGES = ('telepathic message', 'pleading for help', 'demanding your attendance')\n49: \n50: # XP gate: while XL < REQUIRED_XL[depth of the next level], the current level is explored\n51: # fully first (items + XP), within FULL_EXPLORE_TURNS. Dlvl 1-4 are always explored fully.\n52: # Deeper than the table: the last entry applies.\n53: REQUIRED_XL = {2: 99, 3: 99, 4: 99, 5: 99, 6: 6, 7: 7, 8: 8, 9: 8, 10: 9, 11: 9, 12: 10}\n54: # trap doors and holes can drop several levels at once\n55: TRAPDOOR_LOOKAHEAD = 3\n56: # rest (search) to this fraction of max HP before taking a way down (astra: 95-100%)\n57: REST_BEFORE_DESCEND = 0.95   # astra left a level at >= 95% HP on 97% of descents\n58: # rest (search) whenever below this and nothing hostile is in view (astra guard.py: 2/3)\n59: REST_BELOW = 0.66\n60: # Dwarves and gnomes find nearly every Mines inhabitant peaceful: bank Mines' End depth\n61: # (Dlvl 10-13, up to 0.26) safely before the main-dungeon dive.\n62: MINES_ROUTE = True\n63: MINES_BRANCH_MAX_DEPTH = 4     # the Mines branch staircase is on Dlvl 2-4\n64: MINES_MIN_LEVELS = 8           # dungeon.def: the Mines have 8-9 levels, Mines' End is the last\n65: # XP gate inside the Mines: before going to Mines level k, explore the current level fully while\n66: # XL < MINES_REQUIRED_XL[k] (hostile orcs/ants there are the XP). Empty = no gate.\n67: MINES_REQUIRED_XL = {}\n68: # astra: retreat onto Elbereth at 45-65% HP, rest there with searches, never attack from it\n69: # hand-over from AutoAscend's levelling tour to the dive\n70: DIVE_XL = 8\n71: DIVE_TURN = 10 ** 9\n72: ELBERETH_REST_BELOW = 0.4\n73: ELBERETH_REST_UNTIL = 0.85\n74: # breathers, spitters and casters: Elbereth doesn't stop them hurting you from a distance\n75: RANGED_MONSTERS = frozenset((\n76:     'winter wolf cub', 'winter wolf', 'hell hound pup', 'hell hound', 'red naga', 'black naga',\n77:     'golden naga', 'guardian naga', 'cobra', 'lich', 'demilich', 'master lich', 'arch-lich',\n78:     'kobold shaman', 'orc shaman', 'gnomish wizard', 'energy vortex', 'yellow light', 'black light',\n79:     'mind flayer', 'master mind flayer', 'titan', 'couatl', 'ki-rin', 'Aleax', 'Angel',\n80:     'nalfeshnee', 'pit fiend', 'balrog', 'djinni', 'storm giant'))\n81: # XP farm: under-levelled on a fully explored level, wait on the up staircase (escape route)\n82: # for random spawns instead of descending. 0 disables.\n83: FARM_TURNS = 0\n84: # retreat: below this HP fraction, with prayer/Elbereth unavailable, climb the up stairs if close\n85: RETREAT_BELOW = 0.35\n86: RETREAT_MAX_DISTANCE = 12\n87: ARRIVAL_WATCH_TURNS = 30       # how long after arriving a crowd still sends us back up\n88: # ...or when this fraction of max HP was lost within RETREAT_WINDOW turns\n89: RETREAT_FAST_LOSS = 0.3\n90: RETREAT_WINDOW = 3\n91: # arrival check: back up the stairs at once into a crowd (a b1 dive died 12 turns after walking\n92: # onto Dlvl 12 among a leocrotta, ogre king, soldier ants, killer bee, Woodland-elf, ...)\n93: CROWD_SIZE = 3\n94: CROWD_RADIUS = 6\n95: BOSS_MONSTERS = ('minotaur', 'ettin', 'titan', 'lich', 'demilich', 'master lich', 'arch-lich',\n96:                  'purple worm', 'green slime', 'cockatrice', 'Olog-hai', 'ogre king', 'soldier',\n97:                  'sergeant', 'lieutenant', 'captain', 'mind flayer', 'master mind flayer',\n98:                  'energy vortex', 'black dragon', 'red dragon', 'white dragon', 'blue dragon',\n99:                  'green dragon', 'yellow dragon', 'orange dragon', 'silver dragon', 'gray dragon')\n100: ARRIVAL_RETREAT_REST = 150     # turns to wait upstairs before trying that staircase again\n101: # ARRIVAL_FIX: the crowded-arrival retreat almost never fired (31 retreats in 2678 dive stairs descents over\n102: # base/base2/base3/dsafe runs). descend() recorded the arrival AFTER agent.move('>'), but move() ends an atomic\n103: # operation whose update_state() runs the preempt checks, so anything preempting on arrival (fight2 with monsters\n104: # in view: exactly a crowd) raised AgentChangeStrategy out of move() and the arrival was never recorded\n105: # (base3-jf14 s7: down the stairs to Dlvl 10 into Green-elves, a Grey-elf and a straw golem, dead 3 turns later,\n106: # no retreat). And the '<' we arrive on shows us, not the stairs, so the retreat found no up staircase either.\n107: # With the fix: the arrival is recorded by update() from a pending note taken before the move, and the square\n108: # we arrived on counts as the up staircase.\n109: # ON (train 3): castle A034 v3 (74ed55b), bug B005: the crowded-arrival retreat fired 31 times in 2678 stair descents\n110: ARRIVAL_FIX = True\n111: FULL_EXPLORE_TURNS = 2500      # per level, while under-levelled\n112: PORTAL_SWEEP_TURNS = 3000      # per portal level visit\n113: STUCK_EXPLORE_TURNS = 4000     # searching for a hidden way down before trying other things\n114: # Digging down (pick-axe, or a wand of digging): a few turns per level instead of hundreds spent\n115: # finding the '>', and the only way past Medusa's island without levitation (4 of 8 s4 dives ended\n116: # on her level, walking into the water). A '>' this close is still taken (it keeps an up staircase\n117: # under us on arrival).\n118: DIG_STAIRS_RADIUS = 8\n119: # Dig before fighting: fight2 engages anything within 7 squares, but a hole takes a dwarf only 3-4 dig\n120: # steps and a monster interrupts the dig only once it attacks or first comes into view (monmove.c\n121: # disturb, mhitu.c): with no hostile within DIG_FIRST_RADIUS, keep digging out instead.\n122: DIG_FIRST = True\n123: DIG_FIRST_RADIUS = 2\n124: DIG_FIRST_MIN_HP = 0.35\n125: # Elbereth before each dig step when hostiles are in view: a monster that respects it neither attacks\n126: # nor, on first sight, interrupts the dig (monmove.c disturb() checks onscary). Digging the pit wipes it\n127: # (dig.c del_engr_at), so it is engraved again from inside the pit (can_reach_floor allows it there).\n128: # The early dig-dive deaths are crowd landings: ogre lord + owlbear, titan + warhorse, soldier ants...\n129: ELBERETH_DIG = False\n130: # dig under Elbereth: engrave before digging when an Elbereth-respecting hostile is within ELBERETH_DIG_RADIUS,\n131: # and keep digging (not fighting) while every monster within DIG_FIRST_RADIUS respects it; after\n132: # SHELTERED_DIG_STUCK turns on one level (and nothing hurting us) dig regardless\n133: SHELTERED_DIG = True\n134: SHELTERED_DIG_STUCK = 200\n135: # engrave Elbereth before every hole, monsters in view or not (CleverShovel's Archeologist dig-dive, 0.41):\n136: # whatever arrives during the ~4 dig turns then can't melee us\n137: ELBERETH_ALWAYS = False\n138: ELBERETH_DIG_RADIUS = 6\n139: # DIG_ESCAPE: with a digging tool, the hole is the way out of nearly every fight above the castle. In the 90\n140: # HEAD baseline games (base-*), 20 of the 34 tool dives whose castle depth is known died above it. Most of\n141: # them fought instead of digging:\n142: #  * ravens on Medusa-3 (7 games). Every square of its arrival island borders water, and dig_first\n143: #    accepted only dry squares, so fight2 took over; the ravens blind you and swarm.\n144: #  * snakes and cobras on Medusa-4. The cobra counted as 'ranged', which blocked sheltered digging.\n145: #  * the titan on Medusa-2. Titans cast only in melee range (buzzmu() does nothing for AD_SPEL), and\n146: #    there Elbereth stops them.\n147: #  * a treasure zoo, and landing in a crowd.\n148: # With DIG_ESCAPE:\n149: #  * dig_first judges our square by the level's driest square, like try_dig_down;\n150: #  * only an ADJACENT @ or minotaur (onscary() ignores Elbereth for them) makes us fight instead;\n151: #  * there is no HP floor (emergency prayers preempt dig_first anyway);\n152: #  * Elbereth is engraved before every dig step on Medusa's level (hidden snakes, 30 fast ravens);\n153: #  * digging the pit erases the engraving (maketrap -> unearth_objs -> del_engr_at), so the engrave cap is\n154: #    counted separately before and after the pit. A dust Elbereth gets a typo 28% of the time (engrave.c:\n155: #    1 in 25 per letter), so 3 tries per square left about 1 hole in 5 finished with no Elbereth\n156: #    (base-jf25 s0: bitten to death in its pit on Medusa-4).\n157: # ON (train 2): dive-safety A2, 45 games divergence +0.65; Medusa-4 3-4/7 vs 1/7, Medusa-3 2/7 vs 0/7\n158: DIG_ESCAPE = True\n159: ELBERETH_TRIES_ESCAPE = 4      # engravings per square and dig phase (before / after the pit)\n160: ELBERETH_TRIES_BLIND = 6       # the same while blind, each after being hurt since the last one\n161: # DIVE_REST: a digger rests only below DIG_REST_BELOW, never to 95% before stairs, never while its pit is\n162: # half dug, and on Elbereth. At XL 8 HP comes back at 1 per 5 turns (allmain.c), and the deep rests were\n163: # fatal:\n164: #  * base-jf25 s3 rested at 61% in its pit, 4 dig turns from the hole, and met a dwarf mummy and a xorn;\n165: #  * base-jf25 s13 rested 180 turns at a '>' on Dlvl 14 (soldier ant, yellow light, fire vortex);\n166: #  * base-public s12 rested at 62% on Medusa's level (pit viper).\n167: # ON (train 2): dive-safety A2\n168: DIVE_REST = True\n169: # Medusa's level: the first Dungeons-of-Doom level at depth >= 21 showing this many pool/water squares\n170: # (Medusa's maps are ~70% moat; the castle comes later and is found undiggable). Shared with the castle work.\n171: MEDUSA_MIN_DEPTH = 21\n172: MEDUSA_WET_SQUARES = 30\n173: # DIG_TRY_FIX: DIG_MAX_TRIES counts only applies that weren't interrupted. On jf27 s3 Dlvl 9 a bat interrupted\n174: # all 20 applies (\"You stop digging\"), and a diggable level was marked undiggable.\n175: # ON (train 2): dive-safety A2\n176: DIG_TRY_FIX = True\n177: DIG_MAX_APPLIES = 80           # hard cap on all applies on one level (interrupted ones included)\n178: DIG_WALK_RADIUS = 6            # DIG_ESCAPE walks this far (BFS steps) to a square it can dig\n179: MEDUSA_WALK_RADIUS = 30        # ... and this far on Medusa's level (ESCAPE_V2)\n180: # ESCAPE_V2 (with DIG_ESCAPE): the refinements found after A2 (train 2):\n181: #  * dig_first keeps acting while the escape applies. Returning after one action let one step of the strategy\n182: #    underneath leak in before this hook fired again: fight2's swing from our fresh Elbereth (grind-combat's\n183: #    HOLD_LOOP finding);\n184: #  * an eel/kraken that wraps us drowns us with its next hit: Elbereth at once (monflee releases the hero);\n185: #  * with monsters adjacent, engrave before walking to a dig square (a scared monster flees, not attacks);\n186: #  * on Medusa's level walk up to MEDUSA_WALK_RADIUS to a dry dig square rather than gamble on a flood.\n187: # ON (train 3): dive-safety A3, +0.233 pooled over 45 arm64 games vs base3arm, no new failure mode\n188: ESCAPE_V2 = True\n189: DIG_ESCAPE_ACTIONS = 40        # dig_first's escape acts at most this often per activation (see dig_first)\n190: MEDUSA_REROLL_WET = 2          # stranded where every square has this many moat neighbours: climb and re-fall\n191: MEDUSA_REROLLS = 3\n192: # MEDUSA_SKIP (with DIG_ESCAPE): reroll from Medusa's level (also Medusa-3) once a dig there has flooded\n193: # MEDUSA_SKIP_FLOODS times or the best square has MEDUSA_REROLL_WET moat neighbours; each hole dug from the level\n194: # above skips Medusa's level 1 time in 4 (see _medusa_reroll_stairs)\n195: MEDUSA_SKIP = False\n196: MEDUSA_SKIP_FLOODS = 1\n197: MEDUSA_SKIP_REROLLS = 8\n198: MEDUSA_SKIP_FIRST = False      # on Medusa-3 (ravens) reroll at once, before any dig, while the '<' is close\n199: MEDUSA_SKIP_FIRST_STEPS = 4\n200: # DROWN_GUARD (with DIG_ESCAPE): a hole that fills with water drops us into it, and we crawl out only to a free\n201: # adjacent land square (trap.c drown -> hack.c crawl_destination: no monster on it, no diagonal squeeze); with none\n202: # we drown on the spot. base3 lost 7 Medusa digs this way ('You sink like a rock', no 'try to crawl out'). Dig a\n203: # wet square only with DROWN_GUARD_EXITS such squares around it: walk to one if the ground is the problem, wait\n204: # on Elbereth up to DROWN_GUARD_WAIT turns if monsters are.\n205: DROWN_GUARD = False\n206: DROWN_GUARD_EXITS = 2\n207: DROWN_GUARD_WAIT = 15\n208: # DIG_WAND_ESCAPE (with DIG_ESCAPE): a known wand of digging, zapped down, holes the floor at once (zap.c\n209: # zap_dig -> dighole: one flood roll, no pit phase). Used where the pick-axe can't work -- an adjacent @, or\n210: # bitten with no Elbereth to be had -- and on Medusa's wet islands. (power: 4% of XL-8 castle arrivals carry\n211: # one, 13% at XL 10; try_dig_down only ever zapped it with no pick-axe in the pack.)\n212: # ON (train 2): dive-safety A2\n213: DIG_WAND_ESCAPE = True\n214: # WAND_FIRST (with DIG_WAND_ESCAPE): with hostiles in view, zap a known wand of digging down on a dry square\n215: # before digging with the pick (instant hole), and as the escape of a dive that has only the wand\n216: # ON (train 3): harness Big Room with a wand only 7/7 vs 5/7; inert without a known wand of digging\n217: WAND_FIRST = True\n218: # Resting to 95% on a deep level lets its monsters come to us (an s7 dig-dive rested for 150 turns on\n219: # Dlvl 15 until a leocrotta took it to 2 HP): with a digging tool, rest only below this.\n220: DIG_REST_BELOW = 0.6\n221: DIG_MAX_TRIES = 20             # applies on one level without falling through: floor can't be holed\n222: # A cursed pick-axe digs like any other (dig.c: the curse only matters on the Plane of Earth); applied, it\n223: # welds to the hand, which a dig-dive can live with. Without this, the first apply of an unidentified cursed\n224: # pick welded it, digging_tool() then rejected it as CURSED and the dive went looking for another tool\n225: # (eg-trip5 public seed 3: 'The pick-axe welds itself to your hand!' -> 'no digging tool at depth 1: early\n226: # detour to the Mines' -> killed at XL 6 on Mines 1, 0.037; the same seed without the trip scored 0.507).\n227: # A known-cursed mattock is still refused unless it is already welded: it takes both hands, leaving none\n228: # to engrave Elbereth with (agent.hands_welded).\n229: # ON (train 2): 56 of 74 games that welded a pick never dug again (0.163 vs 0.411)\n230: CURSED_PICK_OK = True\n231: # A dig try leaves a pit (dig.c: effort > 50 makes it and ends the occupation; the next apply digs on from\n232: # inside it to a hole). Once a #terrain check had shown that pit on our square, the square no longer counted\n233: # as plain floor and try_dig_down walked off to dig a fresh pit next door -- 'You are still in a pit', a\n234: # panic, another forced #terrain that recorded the new pit... A jf25 s12 digger marched pit by pit across\n235: # Dlvl 4-11, 20 tries per level, marked each one undiggable and took the stairs (~1000 turns a level; dead\n236: # on Dlvl 12 at T29790). A pit under us is where the hole gets finished.\n237: DIG_IN_PITS = True\n238: PITS = frozenset({SS.S_pit, SS.S_spiked_pit})\n239: # The budgets and task checks in plan_step (FULL_EXPLORE_TURNS, DWARF_SEARCH_TURNS, STUCK_EXPLORE_TURNS, the\n240: # tool quest's stuck test...) only run between tasks, and one exploration run can last thousands of turns (public\n241: # s9: a 2500-turn 'explore fully' budget overrun by 800). With EXPLORE_BUDGETS a dive exploration hands control\n242: # back once its budget is spent, and at least every EXPLORE_REPLAN_TURNS turns.\n243: # ON (train 2): robustness b2 guard 0.3480 vs 0.3479; +0.38 over the 4 games it fired in (b1)\n244: EXPLORE_BUDGETS = True\n245: EXPLORE_REPLAN_TURNS = 500\n246: # standing on a known trap door that didn't trigger, press '>' (the dive asserted in a loop there before)\n247: TRAPDOOR_PLUNGE = True\n248: FETCH_TOOL_TURNS = 3000        # budget for walking back to a pick-axe the tour dropped\n249: # Dwarves carry a pick-axe or a mattock 37.5% of the time (makemon.c) and are peaceful to a dwarf:\n250: # with no digging tool yet, the dive kills the peaceful dwarves it meets in the Mines (never in\n251: # Minetown: the Watch). Each kill costs Luck -1 half of the time, so prayer waits 600 turns per kill.\n252: DWARF_HUNT = True\n253: DWARF_HUNT_MAX_KILLS = 6\n254: HUNT_IN_TOUR = False           # the tour hunts too (in the Mines) from HUNT_MIN_XL\n255: HUNT_MIN_XL = 8\n256: # With a digging tool the dive is a few turns per level and XL matters much less (s7 public seed 10:\n257: # Dlvl 4 -> 26 in ~200 turns of digging, past Medusa): dive as soon as one is in hand from this XL,\n258: # and keep one during the tour (it drops them for lighter loot).\n259: # train 3 (early-game A027): a tool holder dives at XL 7 (public +0.056; 45 games neutral; grind losses 10 -> 5)\n260: DIG_DIVE_XL = 7\n261: KEEP_TOOL_IN_TOUR = False\n262: # A planned dive (the XL or tool trigger, never a rescue) waits until this many turns have passed since the last\n263: # prayer (0: off), so the emergency HP prayer is there on the way down: it needs the prayer timeout <= 200\n264: # (pray.c), and the timeout is rnz(350) right after a prayer. eg-t2glh7 XL-7 tool dives whose first dig came\n265: # < 800 turns after a prayer: 4 of 12 died above Dlvl 20 (Dlvl 10-17 crowds: soldiers and killer bees, elves, a\n266: # centaur's wand of fire), mean 0.414; >= 800 turns: 0 of 13, mean 0.513. base/base2 XL-8 dives: 28% vs 14%.\n267: # ON (train 3.1, early-game A044/A049): a tool holder digs only >= 800 turns after its last prayer; A049 0.399 vs base4 0.378, mid-dive deaths 1/32 vs 4/37\n268: DIVE_PRAYER_GAP = 800\n269: # ...and (DIVE_PRAYER_FOOD) not Hungry or carrying DIVE_PRAYER_FOOD_MIN nutrition: an HP prayer made while only\n270: # Hungry fixes the HP but not the hunger (pray.c fix_worst_trouble: Hungry is a minor trouble) and restarts the\n271: # clock, so the next hunger prayer is ~1100 turns away (rescue, ledger F032: 20-35 faints). The wait is capped at\n272: # DIVE_PRAYER_MAX_WAIT turns (a Hungry grinder with no food would otherwise wait through every prayer cycle).\n273: DIVE_PRAYER_FOOD = False\n274: # ...only when a digging tool is already in hand (the dive digs at once). A tool-less dive heads for the Mines camp\n275: # for thousands of turns, so its wait only reshuffles the hunt: eg-dpg lost 3 XL-8 tool-less dives that way.\n276: # ON (train 3.1): the wait only with a digging tool in hand (A044)\n277: DIVE_PRAYER_TOOL_ONLY = True\n278: DIVE_PRAYER_FOOD_MIN = 400\n279: DIVE_PRAYER_MAX_WAIT = 2500\n280: # DIVE_START_HP: a planned dive (the XL or tool trigger, never a rescue) starts with at least this fraction of max HP\n281: # (0: off); below it the grind goes on (and rests as usual) for up to DIVE_START_HP_WAIT turns. base5-8 dives that\n282: # started below 50% HP all died within 300 turns (3 of 3: base6-8 jf14 s8 dove at 32/74 right after a hunger prayer\n283: # and died on Dlvl 3 116 turns later), 50-80% scored 0.397 (13 dives), 95%+ 0.475 (269)\n284: # t35: jf16 s1 0.507 -> 0.075 -- the 'wait' is the grind, which fought on from 66/84 to 11/84 and prayed at gap 607;\n285: # a version would have to rest -- off\n286: DIVE_START_HP = 0\n287: DIVE_START_HP_WAIT = 300\n288: # The portal sweep (Home 1 = 0.366) costs ~1500 turns of exploring the level; digging reaches\n289: # Dlvl 20+ (0.38+) within a few hundred turns, so no sweep while holding a digging tool.\n290: SWEEP_WITH_TOOL = False\n291: # Tool run (off: None): end the tour's Dlvl 1 grind at this XL instead of XL 8 and head for the Mines\n292: # to take a dwarf's pick-axe (HUNT_MIN_XL / DIG_DIVE_XL follow it). The XL 5-8 grind is where unseen\n293: # games starve (9 of 30 died on Dlvl 1 at XL 3-7).\n294: TOOL_RUN_XL = None\n295: # Rescue dive: a failed prayer during the Dlvl 1 grind leaves the god angry and the game starving (92\n296: # past games: median survival ~1,050 turns after the first failure, 24 of 40 first failures on Dlvl 1).\n297: # Such a game dives at once: down the Mines (peaceful to a dwarf; Mines' End is Dlvl 10-13, 0.13-0.26),\n298: # hunting dwarves on the way, digging in the main dungeon if it gets a pick-axe. Fires only in games\n299: # that are otherwise lost.\n300: RESCUE_DIVE = True\n301: # The same later in the tour: a prayer failed (the god is angry or Luck < 0, so no more hunger prayers)\n302: # and the character is Weak with nothing to eat. The tour would starve on the spot (a clock-jf6 XL8\n303: # starved in the Mines 1700 turns after an unlucky prayer); the dive at least banks depth on the way.\n304: LATE_RESCUE = True\n305: # rescue dives take the main-dungeon stairs (not the Mines route): see should_dive\n306: RESCUE_MAIN_DUNGEON = True\n307: # Experiment: skip the Dlvl 1 grind altogether (38% of unseen games are lost there: prayer failures,\n308: # fainting deaths) and dive from EARLY_DIVE_TURN on the rescue route -- down the Mines (peaceful to a\n309: # dwarf), hunting dwarves for a pick-axe, digging the main dungeon once one is in hand. Even a failed\n310: # early dive that reaches Dlvl 10-12 scores 0.13-0.21, above a grind death (0.02-0.07).\n311: EARLY_DIVE = False\n312: EARLY_DIVE_TURN = 1\n313: # planned early dive from this XL (0: off): see should_dive\n314: EARLY_DIVE_XL = 0\n315: # Ditch the pet for the Dlvl 1 grind (off: experiment). On 15 unseen grinds the pet ate ~40% of the\n316: # corpses (497 meals vs our 732) and made ~10% of the kills (no XP for us); food is what the grind runs\n317: # out of (hunger prayers, their failures, starvation). Take it down to Dlvl 2 and come back up alone\n318: # (a pet only follows when adjacent, and can't climb stairs on its own).\n319: DITCH_PET = False\n320: DITCH_PET_AFTER = 300          # turns into the game (Dlvl 1 explored, its '>' known)\n321: DITCH_PET_BUDGET = 300\n322: DWARF_HUNT_TURNS = 400         # per level\n323: # a dive leaving the Mines without a digging tool explores each Mines level (not Minetown) this long\n324: # looking for dwarves before climbing on (about 2 dwarves per Mines filler level, 37.5% armed with one)\n325: DWARF_SEARCH_TURNS = 300\n326: # Tool quest: a tool-less dive stuck this deep with no way down (Medusa's water, half of all dives)\n327: # has banked its depth, so the long trip back to the Mines for a dwarf's pick-axe can only add.\n328: TOOL_QUEST_DEPTH = 18\n329: TOOL_QUEST_STUCK_TURNS = 800\n330: TOOL_QUEST_TURNS = 12000\n331: # Early detour: a dive with no digging tool that is still shallow (it started in Sokoban or the main\n332: # dungeon, never climbing out through the Mines) first visits Mines levels 1-3 for a dwarf's pick-axe:\n333: # ~50% find one, and a digger's dive is worth ~+0.1 over a stairs dive.\n334: EARLY_DETOUR = True\n335: EARLY_DETOUR_DEPTH = 12\n336: EARLY_DETOUR_MINES_LEVELS = 3\n337: EARLY_DETOUR_TURNS = 2500\n338: DWARF_NAMES = ('dwarf', 'dwarf lord', 'dwarf king')\n339: # Gehennom (jf_config.GEHENNOM_DIVE): with neither prayer nor Elbereth there, a wand of digging zapped down is\n340: # the one-turn escape from a monster we can't outfight, and it banks the next level. Which monsters count:\n341: # the maze fillers' minotaurs (0-2 per level; 116 of 550 games that reached Dlvl 25+ in our runs died to one)\n342: # and anything of level >= GEHENNOM_THREAT_LEVEL, plus the instadeath/brain/digestion attackers.\n343: GEHENNOM_THREAT_LEVEL = 10\n344: # Valley walk: attack only what blocks the next step while nothing hurts us (valley_sneak). At XL 10 (15\n345: # valley-x10 seeds) it walked into the crowds and died after 116 turns on average, vs 537 fighting them\n346: # (fight2) where they come, and neither variant got out; but with a strong kit (power agent: XL 14, gray\n347: # dragon scale mail, speed boots) 4 of 12 got past the '>' with it and 0 of 5 without.\n348: VALLEY_SNEAK = True\n349: # The Valley's '<' is the lifeline: below VALLEY_RETREAT_BELOW of max HP (or VALLEY_CROWD_BELOW with\n350: # CROWD_SIZE hostiles close) with a hostile near and the '<' within VALLEY_RETREAT_REACH steps, climb up to\n351: # the castle's east edge, where Elbereth and prayer work; the castle mode (castle agent) rests there and\n352: # comes back down through the trap door behind the castle's back door (dive.valley_retreats / _turn tell\n353: # it we came up to heal). 15 of 15 valley-x10 seeds (XL 10, 99 HP, AC -2) died in the Valley without it,\n354: # 3 of them swarmed at the landing spot (vampire bats, vampire lords in bat form, mummies, ghosts).\n355: VALLEY_RETREAT = True\n356: VALLEY_RETREAT_BELOW = 0.5\n357: VALLEY_CROWD_BELOW = 0.75\n358: VALLEY_RETREAT_REACH = 15\n359: # below REST_BELOW in the Valley, rest on the '<' when within VALLEY_REST_REACH steps, up to VALLEY_REST_UNTIL\n360: VALLEY_REST_REACH = 25\n361: VALLEY_REST_UNTIL = 0.9\n362: # Below the Valley a digger rests only under this HP fraction (DIG_REST_BELOW elsewhere, and no 2/3-HP rest):\n363: # a hole is ~5 turns and banks a level, while resting in place brings the level to us (a valley+1 dig-dive\n364: # rested at 47% on Juiblex's level and was engulfed: 'You feel deathly sick' -- no prayer to cure it there)\n365: GEHENNOM_DIG_REST_BELOW = 0.3\n366: GEHENNOM_THREATS = frozenset(('minotaur', 'mind flayer', 'master mind flayer', 'cockatrice', 'chickatrice',\n367:                               'green slime'))   # stoning and sliming: only prayer (none in Gehennom) cures them\n368: # Gehennom: a scroll of scare monster on our square scares every monster but the temple priest, lawful minions,\n369: # Riders and Rodney (monmove.c onscary: 'the scare monster scroll doesn't have any of the below restrictions'),\n370: # so unlike Elbereth also in Gehennom and against @ and minotaurs; a scared monster neither attacks (dochug:\n371: # !scared) nor stops our dig occupation (allmain monster_nearby: !onscary). When a fight goes badly (below\n372: # GEHENNOM_SCARE_BELOW with a hostile adjacent, or GEHENNOM_SCARE_CROWD adjacent below GEHENNOM_SCARE_CROWD_BELOW)\n373: # drop one (power.scare_scrolls) and hold on it: dig down from it, or in the Valley rest on it to\n374: # GEHENNOM_SCARE_UNTIL. It stays behind (picked up again it turns to dust, pickup.c).\n375: GEHENNOM_SCARE = False\n376: GEHENNOM_SCARE_BELOW = 0.5\n377: GEHENNOM_SCARE_CROWD = 2\n378: GEHENNOM_SCARE_CROWD_BELOW = 0.8\n379: GEHENNOM_SCARE_UNTIL = 0.9\n380: # with no known scroll, drop every carried unknown scroll that may be scare monster (a gamble: ~35/1000 of\n381: # random scrolls; power: a castle arrival carries 6-8 unknown types, ~25% that one is scare monster)\n382: GEHENNOM_SCARE_GAMBLE = False\n383: # Valley camp: first stand on the '<' (1-13 steps from every landing square) and take the wanderers there, one\n384: # group at a time, with the retreat up the '<' at hand; leave for the doors once no hostile has been in view for\n385: # VALLEY_CAMP_QUIET turns and HP >= VALLEY_REST_UNTIL, or after VALLEY_CAMP_MAX turns.\n386: VALLEY_CAMP = False\n387: VALLEY_CAMP_QUIET = 60\n388: VALLEY_CAMP_MAX = 800\n389: # The Valley's graveyards (valley.GRAVEYARD, 122 squares) hold a sleeping undead on every square, and a\n390: # Valkyrie's stealth keeps them asleep as we pass (monmove.c disturb: !Stealth). fight2 took on every one that came\n391: # into view (sneak or not, once anything hurt us): a monster standing on a graveyard square counts for the fight\n392: # only when it attacked us in the last VALLEY_ATTACKER_TURNS turns (its name in a hit/miss message); path\n393: # blockers are the sneak's business. gg1 deaths clustered at the graveyards' columns (21-26, 39-48).\n394: VALLEY_GRAVE_FILTER = False\n395: VALLEY_ATTACKER_TURNS = 5\n396: # --- dwarf hunt mechanics (pick-hunt) ---\n397: # Every dwarf death is a pile to check, whoever killed it (us, the pet, fight2 finishing an angry witness), and\n398: # at once: only the hunted target's pile was checked, 50 turns late (the fetch scan interval) -- base-jf26/14\n399: # killed a dwarf in its tunnel on Mines 2, walked down to Mines 3, came back and found the pile 'unreachable'.\n400: DWARF_PILES = False\n401: # Prefer dwarves seen digging: standing on known rock or wall, or on a '#' in the Mines (the Mines have no\n402: # corridors of their own: a '#' there is a dwarf's tunnel), or right after 'The dwarf wields a pick-axe!'.\n403: # makemon gives a dwarf a pick 25% / a mattock 12.5% of the time; a digger has one for sure.\n404: DIGGER_FIRST = False\n405: # 'You hear crashing rock.' (a digging dwarf went through a wall on this level): search this level longer\n406: CRASH_SEARCH_BONUS = 300\n407: CRASH_SEARCH_MAX = 1500\n408: # Alignment budget instead of a flat kill cap (3.6.6 source): hmon_hitmon wakes the dwarf -> setmangry\n409: # (mpeaceful = 0, alignment -1) before any damage, so xkilled never takes the 'peaceful: Luck -1' branch;\n410: # the kill costs adjalign(malign) = -12 (a coaligned peaceful's malign). Other peaceful humanoids in view\n411: # turn hostile (-1 each; an angered dwarf we then kill costs its -12 too). A Valkyrie starts at alignment 0\n412: # and it is capped at ALIGNLIM = 10 + turns/200 (hostile kills keep a grind near the cap); prayer fails\n413: # below 0. So: ~7 kills at turn 20000, ~3 at 9000, 1 at 3000.\n414: ALIGN_BUDGET = False\n415: ALIGN_MARGIN = 5\n416: # turns prayers wait after each dwarf we kill (assumed Luck -1; the Luck loss doesn't happen, see above)\n417: KILL_PRAYER_HOLD = 600\n418: # the Dlvl-1 grind (and the rest of the tour) hunts peaceful dwarves from this XL (0: off) and keeps the tool:\n419: # dwarves spawn on Dlvl 1 from XL 7 (difficulty 4 <= (1 + XL) / 2); 51 of 90 baseline grinds heard one\n420: # digging there ('You hear crashing rock.') and 5 of those dives still never got a tool\n421: # train 3 (A027): the grind hunts dwarves from XL 5 on its Dlvl 2-3 grind levels\n422: GRIND_HUNT_XL = 5\n423: GRIND_HUNT_DIGGERS_ONLY = False\n424: # the tool-less dive's Mines route explores Dlvl 2-4 only until the branch '>' is known (see _search_branch);\n425: # the tour-mode pick trip (jf_config.PICK_TRIP_XL) too, through trip_branch_strategy\n426: FAST_BRANCH = False\n427: BRANCH_HIDDEN_TURNS = 500          # per level (0: off), see _search_branch\n428: BRANCH_SEARCH_TURNS = 1500         # exploring one of Dlvl 2-4 for the branch before moving on (was FULL_EXPLORE_TURNS)\n429: BRANCH_CLIMB_MAX = 3               # climb back from at most this many levels below Dlvl 4 (see _climb_back_for_branch)\n430: BRANCH_CLIMB_TURNS = 1500          # per level, finding and taking its '<'\n431: # BRANCH_FIX2 (off): climb back up to 3 levels from below Dlvl 4 while the branch search there isn't done (trap\n432: # doors, holes, a candidate that was the main '>'), a 1500-turn branch search per level, and replanning\n433: # ON (train 3): pick-fix2arm +0.017 over 45 arm64 games, no-tool dives 6 -> 4\n434: BRANCH_FIX2 = True\n435: # CLIMB_FIX (off): the branch climb takes only a '<' that leads (or may lead) to the level above -- never one known\n436: # to go elsewhere: base4-jf14 s1 climbed Sokoban's '<' from Dlvl 7 and came straight back down, every turn -- and\n437: # each staircase at most BRANCH_STAIRS_CAP times; a branch '>' known on a level above with no known stairs there\n438: # (we came down a hole) is climbed to: base4-jf14 s14 took the main '>' of Dlvl 4 instead and the climb back from\n439: # Dlvl 5 brought it up again, 4 <-> 5 every turn\n440: # ON (train 3.1, pick-hunt 7e4ac3f, B012): no climb-back ping-pong (Dlvl 7<->Sokoban, 4<->5); replays jf14 s1/s14\n441: CLIMB_FIX = True\n442: BRANCH_STAIRS_CAP = 3\n443: # WAND_WAITS2 (off): WAND_FIRST's zap at any hostile in view waits too while the Mines route is pending (see\n444: # _wand_waits); the zaps against an adjacent @ or when bitten with no Elbereth to be had stay\n445: # ON (train 3.1): WAND_FIRST holds the digging-wand zap while the Mines route is pending (7 of 90 base4 tool-less dives zapped it at a distant hostile)\n446: WAND_WAITS2 = True\n447: # HIDDEN_SEARCH2 (off): the hidden-branch search searches from the squares next to the widest never-seen parts of\n448: # the map first (see _search_toward_void), HIDDEN_SEARCH2_TURNS per level\n449: HIDDEN_SEARCH2 = False\n450: HIDDEN_SEARCH2_TURNS = 800\n451: # Walk up to peaceful dwarves we see but can't reach: a digger inside its fresh tunnel (dark corridor squares\n452: # aren't on our map) was dropped as unreachable. Crash-heard Mines levels gave 9 tools in 30 baseline visits,\n453: # the rest 6 in 179, yet jf27/14 heard 53 crashes on Mines 2 in 3840 turns without one attack. Seeing the\n454: # dwarf along a straight line proves the squares between aren't rock: they are marked walkable.\n455: APPROACH_DWARVES = False\n456: APPROACH_STEPS = 60                # approach moves per APPROACH_WINDOW turns on a level\n457: APPROACH_WINDOW = 500\n458: # LURE_DWARVES (off): throw at a peaceful dwarf in line but out of reach (see _lure)\n459: LURE_DWARVES = False\n460: LURE_RANGE = 7\n461: # Minetown is Mines level 3 or 4 (dungeon.def minetn @ (3, 2)) and was only recognised by a shopkeeper in\n462: # view: a hunt-v2 smoke replay (jf16/9) attacked a dwarf there first -- 'Halt! You're under arrest!', three\n463: # watchmen killed ('You murderer!' x3: prayers held 3600 turns), fainted, killed by a fox. On Mines levels\n464: # 3-4 hunt only once the other one is known to be the town, or this one looks like a filler: 500+ squares\n465: # seen without a door, altar, fountain, shopkeeper, watchman or priest (500 squares: dropped, see _hunt_level_ok).\n466: MINETOWN_GUARD = False\n467: # A wand of digging doesn't fire on Dlvl 1-4 while the Mines route (a dwarf's pick) is pending: baseline jf27/4\n468: # zapped from Dlvl 1 at dive start, fell past the branch level, gave the Mines up at Dlvl 5 and died tool-less\n469: # on Dlvl 7 (4 of 62 regular dives zapped a wand early and dove without a pick: mean 0.18)\n470: WAND_WAITS = False\n471: # a tool-less dive gives the Mines route up after MINES_STUCK_TURNS on one level with its '>' cut off, instead of\n472: # STUCK_EXPLORE_TURNS (4000) (walking through traps to it is robustness's TRAP_LAST_RESORT); and in the Mines a\n473: # sleeping peaceful gnome boxing us in is attacked (see _clear_blocker)\n474: MINES_UNSTUCK = False\n475: MINES_STUCK_TURNS = 1500\n476: # Mines camp: a tool-less dive doesn't leave the Mines. It sweeps Mines levels 1..MINES_CAMP_MAX_LEVEL (not\n477: # Minetown) down and up, searching each visit CAMP_VISIT_TURNS for dwarves, for MINES_CAMP_TURNS in all; a\n478: # failed prayer or the end of the budget sends it on down the Mines as before. Early-game measured the tool-less\n479: # XL-8 phase: no deaths in 50k Mines turns, ~7% loss per 1000 turns back in the main dungeon without a tool,\n480: # 0.3-0.7 tools per 1000 Mines turns; base2 had 15 tool-less dives in 75 games (mean 0.14).\n481: # ON (train 2): with HUNT_V2 (pick-camp1); the camp ran in 12 dives and ended with a tool in 10\n482: MINES_CAMP = True\n483: MINES_CAMP_TURNS = 8000\n484: # RETURN_FIX (off): return_to_main_dungeon also knows the up stairs by their recorded destination, and a dive\n485: # boxed in with a digging tool digs sideways out (see _dig_out)\n486: RETURN_FIX = False\n487: DIG_OUT_REACH = 30                 # 'boxed in': the BFS reaches fewer squares than this ...\n488: DIG_OUT_TURNS = 20                 # ... for this many turns\n489: # The dive's first job on the level it starts from: a tool-less dive whose grind level held a digging dwarf\n490: # (seen in rock, or 'You hear crashing rock.', within HOME_DIGGER_WINDOW turns) searches that level for it first,\n491: # HOME_DIGGER_TURNS at most (0: off). Dwarves spawn on Dlvl 1 from XL 7; 51 of 90 baseline grinds heard one\n492: # there, and base2-public s1/s8/s14 (tool-less dives) all had one on Dlvl 1 in the old base; hunt-v2 jf16/12\n493: # watched a digger on Dlvl 1 for 2000 turns, then dove without a tool. Unlike GRIND_HUNT_XL it leaves the tour alone.\n494: # ON (train 3): 600 turns; +0.035 over 45 arm64 games vs base3arm, no-tool dives 6 -> 4\n495: HOME_DIGGER_TURNS = 600\n496: # train 3.1: only fresh digger evidence (B012: stale 2000-4800-turn evidence on the GRIND_LEVELS level cost 5 tool-less dives in base4)\n497: HOME_DIGGER_WINDOW = 300\n498: MINES_CAMP_MAX_LEVEL = 4\n499: CAMP_VISIT_TURNS = 400\n500: CAMP_STAIRS_TURNS = 1000         # looking for the way on to the next camp level before turning around\n501: # CAMP_FIX (off): town levels only on Mines 3-4 and not from a stair follower; camp stair timers reset per visit\n502: # ON (train 3): with BRANCH_FIX2 (pick-fix2arm)\n503: CAMP_FIX = True\n504: # master switch for the hunt mechanics above (individual flags stay for ablations)\n505: # ON (train 2): pick-camp1 45 games 0.393 vs 0.348, tool dives 85% vs 74%, no-tool dives 9 -> 5\n506: HUNT_V2 = True\n507: \n508: \n509: def _apply_dev_overrides():\n510:     \"\"\"Dev experiments only: JF_CFG='{\"REQUIRED_XL\": {...}, ...}' overrides the constants above.\n511:     The arena never sets it, so submissions always run the defaults.\"\"\"\n512:     import json\n513:     import os\n514:     raw = os.environ.get('JF_CFG')\n515:     if not raw:\n516:         return\n517:     for name, value in json.loads(raw).items():\n518:         if name in ('REQUIRED_XL', 'MINES_REQUIRED_XL'):\n519:             value = {int(k): int(v) for k, v in value.items()}\n520:         if name in globals():\n521:             globals()[name] = value\n522: \n523: \n524: _apply_dev_overrides()\n525: if HUNT_V2:\n526:     DWARF_PILES = DIGGER_FIRST = ALIGN_BUDGET = FAST_BRANCH = APPROACH_DWARVES = MINETOWN_GUARD = WAND_WAITS = \\\n527:         MINES_UNSTUCK = True\n528:     KILL_PRAYER_HOLD = 0\n529: \n530: \n531: def _only_ranged_monsters():\n532:     \"\"\"Monsters fight2 never melees (passive damage): not the rest's to fight either.\"\"\"\n533:     from .combat.monster_utils import ONLY_RANGED_SLOW_MONSTERS\n534:     return ONLY_RANGED_SLOW_MONSTERS\n535: \n536: \n537: def _hold_loop(func):\n538:     \"\"\"HOLD_LOOP for one-action 'hold' strategies (Elbereth rest, demon vigil, faint guard).\n539: \n540:     agent.preempt() re-runs the underlying strategy after a preempting body returns, and the upper hooks\n541:     fire only on the next step's update: one step of a lower strategy always ran between two hold actions --\n542:     an exploration move off the Elbereth (the IDLE guard re-engraved on a new square every turn, gc-idle\n543:     public T10183-10185), or fight2's attack/throw from the square. With the flag the body repeats while the\n544:     strategy's own condition holds, like fight2's loop; higher-priority preempts still interrupt it through\n545:     their update hooks. Apply below @Strategy.wrap.\"\"\"\n546:     @functools.wraps(func)\n547:     def wrapper(self, *args, **kwargs):\n548:         gen = func(self, *args, **kwargs)\n549:         if not next(gen):\n550:             yield False\n551:             return\n552:         yield True\n553:         agent = self.agent\n554:         while True:\n555:             steps = agent.step_count\n556:             try:\n557:                 next(gen)\n558:             except StopIteration:\n559:                 pass\n560:             # no step taken (e.g. an engrave that was refused): never spin\n561:             # HOLD_LOOP_RESCUE: the loop only once a prayer has failed (the rescue dive), the tour unchanged\n562:             looping = jf_config.HOLD_LOOP or (jf_config.HOLD_LOOP_RESCUE and agent.prayer_failed)\n563:             if not looping or agent.step_count == steps:\n564:                 return\n565:             gen = func(self, *args, **kwargs)\n566:             if not next(gen):\n567:                 return\n568:     return wrapper\n569: \n570: \n571: class DiveLogic:\n572:     def __init__(self, agent):\n573:         self.agent = agent\n574:         self.portal_level = None       # (dnum, lnum) of the Quest portal level\n575:         self.visited_quest = False\n576:         self.quest_arrival = None      # (y, x) of the portal on the Quest home level\n577:         self.level_first_turn = {}     # level key -> turn first seen\n578:         self.fully_explored = set()    # level keys explored to exhaustion\n579:         self.sweep_started = None      # turn the current portal sweep began\n580:         self.sweep_given_up = set()    # portal level keys whose sweep ran out of budget\n581:         self._last_key = None\n582:         self._last_task = None\n583:         self.mines_done = False        # reached the bottom of the Mines, or gave the route up\n584:         self._elbereth_resting = False\n585:         self.diving = False\n586:         self.dive_start_turn = None     # DIVE_TOOL_HUNGER_GAP: the turn the dive phase began (None: set by a scenario)\n587:         self.rescue = False                # the dive began as a rescue from a failed Dlvl 1 grind\n588:         self.pick_trip = False             # the grind's detour to the Mines for a pick-axe (PICK_TRIP_XL)\n589:         self.undiggable = set()            # level keys where the floor is too hard to dig\n590:         self._hp_history = []              # (turn, hp) of the last few turns\n591:         self._status_logged = -1\n592:         self._murder_turn = -1\n593:         self._demon_vigil_until = -1       # turn until which a released water demon is kept off with Elbereth\n594:         self._faint_start = None           # turn the current faint began (last awake observation)\n595:         self._guard_weak_since = None      # turn the current Weak spell began (FAINT_GUARD_IDLE)\n596:         self._guard_hold_until = -1        # keep holding the faint guard's Elbereth until this turn (IDLE)\n597:         self._ranged_hit_turn = -10 ** 9   # last turn a missile, wand or ray hit us (RANGED_ON_ELB)\n598:         self._hold_squares = set()         # (level key, y, x) where a hold (faint guard, Elbereth rest) stood\n599:         self._last_update_turn = 0\n600:         self.pet_seen = {}                 # level key -> last turn a pet glyph was in view\n601:         self._last_pos = None              # (level key, (y, x)) at the previous update\n602:         self._arrived = None               # (level key, turn) of the last stairs arrival\n603:         self._arrival_pending = None       # ARRIVAL_FIX: (level key, '>' position, turn) of a stairs descent\n604:         self._arrival_square = None        # ARRIVAL_FIX: (level key, position) of the '<' we arrived on\n605:         self._crowd_retreats = {}          # ARRIVAL_FIX: (level key, '>' position) above -> crowd retreats taken\n606:         self._avoid_stairs_until = {}      # (level key, (y, x)) -> turn: don't take this '>' before\n607:         self._retreat_blocked_until = -1   # turn until which a failed retreat isn't retried\n608:         self._dig_tries = {}               # level key -> pick-axe applies without falling through\n609:         self._dig_blocked_until = -1       # turn until which applying the pick-axe isn't retried\n610:         self._fetch = None                 # (level key, (y, x), turn started) of a known pick-axe\n611:         self._fetch_given_up = set()       # (level key, (y, x)) of pick-axes not worth another trip\n612:         self._fetch_scan_turn = -10 ** 9   # last turn the levels were scanned for pick-axes\n613:         self._bad_dig_spots = set()        # (level key, (y, x)) where a boulder etc. blocks digging\n614:         self._dead_traps = set()           # (level key, (y, x)) trap doors '>' didn't take us through\n615:         self.tool_spots = set()            # (level key, (y, x)) where a pick-axe was dropped or seen\n616:         self._dwarves_killed = 0\n617:         self._spot_visits = {}             # (level key, (y, x)) -> go_to attempts\n618:         self._climb_trap_tries = {}        # level key -> times traps were opened for a climb\n619:         self._ditch_state = 0              # pet ditch: 0 idle, 1 down with it, 2 up without it, 3 over\n620:         self._ditch_started = None\n621:         self._hunting = False              # our last attack was on a peaceful dwarf\n622:         self._hunt_started = {}            # level key -> turn the hunt began there\n623:         self._search_started = {}          # level key -> turn the dwarf search began there\n624:         self._quest_started = None         # turn the tool quest began\n625:         self._quest_over = False\n626:         self._quest_early = False          # the running quest is the early (shallow) Mines detour\n627:         self._early_done = False\n628:         self._valley_arrival = None        # turn we first stood in the Valley of the Dead\n629:         self._valley_misplaced = False     # the Valley's '>' wasn't where valley.py puts it: search the usual way\n630:         self._valley_undiggable_doors = set()  # door squares a pick-axe refused (dig them no more: search, kick)\n631:         # climbs up the Valley's '<' to heal on the castle level (read by the castle mode: rest before coming back)\n632:         self.valley_retreats = 0\n633:         self.valley_retreat_turn = None\n634:         self._valley_west = None           # westmost column reached in the Valley (progress log)\n635:         self._valley_resting = False       # resting in the Valley until VALLEY_REST_UNTIL\n636:         self._scare_spot = None            # (level key, (y, x)) where we dropped a scroll of scare monster\n637:         self._scare_drop_turn = None       # turn of that drop (CASTLE_SCARE hold cap)\n638:         self._not_scare_keys = set()       # scroll appearances a fake pile proved not to be scare monster\n639:         self._scare_drops = 0\n640:         self._hostile_seen_turn = -1       # last turn a hostile was in view (Valley camp)\n641:         self._valley_camp_start = None     # turn the Valley camp on the '<' began\n642:         self._valley_camp_done = False\n643:         self._valley_attackers = {}        # monster name -> last turn it attacked us (Valley)\n644:         self.castle = CastlePassage(self)  # castle_logic.py (jf_config.CASTLE_PASSAGE)\n645:         self._dwarf_seen = (None, [])      # (level key, [(y, x)]) of dwarf glyphs at the last update\n646:         self._diggers = {}                 # level key -> {(y, x): turn} where a dwarf was seen digging\n647:         self._crash_turn = {}              # level key -> last turn 'You hear crashing rock.'\n648:         self._align_est = None             # estimated alignment record (ALIGN_BUDGET)\n649:         self._approach_count = {}          # level key -> (window start turn, approach moves in that window)\n650:         self._town_levels = set()          # Mines level keys where the Watch, a shopkeeper or a priest was seen\n651:         self._visit_start = (None, 0)      # (level key, turn) we arrived on the current level\n652:         self._branch_hidden = False        # FAST_BRANCH: Dlvl 2-4 explored without the branch, searching walls\n653:         self._branch_search_start = {}     # level key -> turn the wall search for the hidden branch began there\n654:         self._branch_trap_walk = set()     # level keys explored once more past their known traps\n655:         self._branch_skip = set()          # (level key, (y, x)) candidate branch '>' we could not reach\n656:         self._branch_reach = {}            # (level key, (y, x)) -> turn we began trying to reach it\n657:         self._climb_start = {}             # level key -> turn we began climbing back from it for the branch\n658:         self._climb_count = {}             # CLIMB_FIX: (level key, (y, x)) -> times the branch climb took that '<'\n659:         self._camp_start = None            # MINES_CAMP: turn the camp began\n660:         self._camp_over = False\n661:         self._camp_dir = 1                 # sweep direction: +1 down, -1 up\n662:         self._camp_visit = None            # (level key, turn we arrived) of the current camp visit\n663:         self._camp_moves = {}              # (level key, direction) -> turn we began trying to leave that way\n664:         self._boxed_since = None           # (level key, turn) we have been boxed in by peacefuls since\n665:         self._boxed_dig = None             # (level key, turn) boxed in with a digging tool since (RETURN_FIX dig-out)\n666:         self._dig_out_bad = set()          # (level key, (y, x)) squares too hard to dig\n667:         self._dig_out_block = -1           # turn until which the dig-out isn't retried (no direction to dig)\n668:         self._home_search = {}             # level key -> turn the dive began searching it for its digger\n669:         self.medusa_level = None           # level key of Medusa's level once seen (see MEDUSA_WET_SQUARES)\n670:         self._pit_at = None                # (level key, (y, x)) of the pit we dug and still stand in\n671:         self._dig_applies = {}             # level key -> all pick-axe applies (DIG_TRY_FIX)\n672:         self._max_wet_cache = None         # (turn, level key, max_wet) for _dig_max_wet\n673:         self._hurt_on_elbereth = -1        # last turn HP fell while we stood on an intact Elbereth\n674:         self._medusa_rerolls = 0           # climbs off a wet Medusa islet to fall in again elsewhere\n675:         self._dig_walk_blocked_until = -1  # turn until which DIG_ESCAPE doesn't walk to a dig square\n676:         self._medusa_reroll_blocked_until = -1\n677:         self._raven_levels = set()         # Medusa's level key once ravens were seen there (Medusa-3)\n678:         self._medusa_floods = 0            # holes that flooded on Medusa's level (MEDUSA_SKIP)\n679:         self._eel_hold_turn = -10          # last turn an eel/kraken grabbed us (or we failed to break free)\n680:         self._eel_engraved = -10           # last turn we engraved Elbereth against such a hold\n681:         self._fed_wait_start = None     # DIVE_FED: turn the grind first reached its end XL\n682:         self._prayer_wait_start = None  # DIVE_PRAYER_GAP: turn the dive first had to wait for the prayer\n683:         self._hp_wait_start = None      # DIVE_START_HP: turn the dive first had to wait for its HP\n684:         self._hp_wait_over = False      # ... and the wait hit DIVE_START_HP_WAIT (logged once)\n685:         self._fed_wait_logged = False\n686: \n687:     # ------------------------------------------------------------------ state\n688: \n689:     def update(self):\n690:         agent = self.agent\n691:         level = agent.current_level()\n692:         key = level.key()\n693:         turn = agent.blstats.time\n694:         if not self._hp_history or self._hp_history[-1][0] != turn:\n695:             if self._hp_history and agent.blstats.hitpoints < self._hp_history[-1][1] and \\\n696:                     (agent.inventory.engraving_below_me or '').lower() == 'elbereth':\n697:                 # hurt while standing on an intact Elbereth: whatever did it ignores the engraving\n698:                 self._hurt_on_elbereth = turn\n699:             self._hp_history.append((turn, agent.blstats.hitpoints))\n700:             self._hp_history = self._hp_history[-12:]\n701:         if self._pit_at is not None and self._pit_at != (key, (agent.blstats.y, agent.blstats.x)):\n702:             self._pit_at = None\n703:         if self.medusa_level is None and level.dungeon_number == Level.DUNGEONS_OF_DOOM and \\\n704:                 agent.blstats.depth >= MEDUSA_MIN_DEPTH and key not in self.undiggable and \\\n705:                 utils.isin(level.objects, WET).sum() >= MEDUSA_WET_SQUARES:\n706:             self.medusa_level = key\n707:             agent.log(f'DIVE Medusa level detected: {key} depth {agent.blstats.depth}')\n708:         if key == self.medusa_level and key not in self._raven_levels:\n709:             if DiveLogic.RAVEN is None:\n710:                 DiveLogic.RAVEN = MON.from_name('raven')\n711:             if utils.isin(agent.glyphs, [DiveLogic.RAVEN]).any():\n712:                 self._raven_levels.add(key)   # Medusa-3 (medusa.des: 30 hostile ravens)\n713:                 agent.log('DIVE Medusa-3 (ravens)')\n714:         if agent.blstats.hunger_state >= Hunger.FAINTING:\n715:             if agent._fainting_since is None:\n716:                 agent._fainting_since = turn\n717:         else:\n718:             agent._fainting_since = None\n719:         if jf_config.RANGED_ON_ELB:\n720:             # every message since the last update: volleys and zaps arrive inside other atomic operations\n721:             hist = agent._message_history\n722:             start = getattr(self, '_ranged_seen', 0)\n723:             if start > len(hist):\n724:                 start = 0\n725:             self._ranged_seen = len(hist)\n726:             m = self._RANGED_HIT.search(' '.join(hist[start:] + [agent.message]))\n727:             if m:\n728:                 if turn - self._ranged_hit_turn > jf_config.RANGED_BREAK_TURNS:\n729:                     agent.log(f'RANGED hit: holds and Elbereth waits off for {jf_config.RANGED_BREAK_TURNS} turns')\n730:                 self._ranged_hit_turn = turn\n731:         if agent.blstats.hunger_state == Hunger.WEAK:\n732:             if agent._weak_since is None:\n733:                 agent._weak_since = turn\n734:             if self._guard_weak_since is None:\n735:                 self._guard_weak_since = turn\n736:         else:\n737:             agent._weak_since = None\n738:             self._guard_weak_since = None\n739:         # faint length -> hunger: the faint began after the last awake observation and ends with 'You\n\n(Output capped at 50 KB. Showing lines 1-739. Use offset=740 to continue.)\n</content>","metadata":{"preview":"\"\"\"Depth-first plan for the BALROG progression score.\n\nThe episode score is the best milestone ever reached (death costs nothing):\ndepth dominates (Dlvl 12 = 0.21, Dlvl 20 = 0.38, Dlvl 25 = 0.47) and stepping\ninto the Quest home through the magic portal on Dlvl 11-16 is worth 0.366 on\nits own. So instead of AutoAscend's Mines/Sokoban tour, this plan:\n\n  * explores the first levels fully while under-levelled (items, XP),\n  * then dives the Dungeons of Doom by the nearest '>' / trap door / hole,\n  * on the Quest portal level (announced by a telepathic message) sweeps the\n    candidate rooms until the hidden portal fires, then walks back out,\n  * and keeps diving afterwards.\n\nThe plan is a restartable loop of short tasks: fights, eating, prayer etc.\npreempt it at any step, so all decisions are re-derived from game state.\n\"\"\"\n\nimport functools\nimport re\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/dive_logic.py","text":"\"\"\"Depth-first plan for the BALROG progression score.\n\nThe episode score is the best milestone ever reached (death costs nothing):\ndepth dominates (Dlvl 12 = 0.21, Dlvl 20 = 0.38, Dlvl 25 = 0.47) and stepping\ninto the Quest home through the magic portal on Dlvl 11-16 is worth 0.366 on\nits own. So instead of AutoAscend's Mines/Sokoban tour, this plan:\n\n  * explores the first levels fully while under-levelled (items, XP),\n  * then dives the Dungeons of Doom by the nearest '>' / trap door / hole,\n  * on the Quest portal level (announced by a telepathic message) sweeps the\n    candidate rooms until the hidden portal fires, then walks back out,\n  * and keeps diving afterwards.\n\nThe plan is a restartable loop of short tasks: fights, eating, prayer etc.\npreempt it at any step, so all decisions are re-derived from game state.\n\"\"\"\n\nimport functools\nimport re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\nfrom scipy import ndimage\n\nfrom . import objects as O\n\nfrom . import jf_config, jf_log, power, utils, valley\nfrom .castle_logic import CastlePassage\nfrom .character import Character\nfrom .exceptions import AgentPanic\nfrom .glyph import C, G, MON, SS, Hunger\nfrom .level import Level\nfrom .item import Item, flatten_items\nfrom .strategy import Strategy\n\nROOM_FLOOR = frozenset({SS.S_room, SS.S_darkroom})\nPLAIN_FLOOR = frozenset({SS.S_room, SS.S_darkroom, SS.S_corr, SS.S_litcorr})\nWET = frozenset({SS.S_pool, SS.S_water, SS.S_lava})\nCORRIDORS = frozenset({SS.S_corr, SS.S_litcorr})\nDOORWAYS = frozenset({SS.S_ndoor}) | G.DOORS\nFALL_TRAPS = frozenset({SS.S_trap_door, SS.S_hole})\nPORTAL = frozenset({SS.S_magic_portal})\n\nGEHENNOM = 1\nMAIN_LINE = (Level.DUNGEONS_OF_DOOM, GEHENNOM)\n\nPORTAL_MESSAGES = ('telepathic message', 'pleading for help', 'demanding your attendance')\n\n# XP gate: while XL < REQUIRED_XL[depth of the next level], the current level is explored\n# fully first (items + XP), within FULL_EXPLORE_TURNS. Dlvl 1-4 are always explored fully.\n# Deeper than the table: the last entry applies.\nREQUIRED_XL = {2: 99, 3: 99, 4: 99, 5: 99, 6: 6, 7: 7, 8: 8, 9: 8, 10: 9, 11: 9, 12: 10}\n# trap doors and holes can drop several levels at once\nTRAPDOOR_LOOKAHEAD = 3\n# rest (search) to this fraction of max HP before taking a way down (astra: 95-100%)\nREST_BEFORE_DESCEND = 0.95   # astra left a level at >= 95% HP on 97% of descents\n# rest (search) whenever below this and nothing hostile is in view (astra guard.py: 2/3)\nREST_BELOW = 0.66\n# Dwarves and gnomes find nearly every Mines inhabitant peaceful: bank Mines' End depth\n# (Dlvl 10-13, up to 0.26) safely before the main-dungeon dive.\nMINES_ROUTE = True\nMINES_BRANCH_MAX_DEPTH = 4     # the Mines branch staircase is on Dlvl 2-4\nMINES_MIN_LEVELS = 8           # dungeon.def: the Mines have 8-9 levels, Mines' End is the last\n# XP gate inside the Mines: before going to Mines level k, explore the current level fully while\n# XL < MINES_REQUIRED_XL[k] (hostile orcs/ants there are the XP). Empty = no gate.\nMINES_REQUIRED_XL = {}\n# astra: retreat onto Elbereth at 45-65% HP, rest there with searches, never attack from it\n# hand-over from AutoAscend's levelling tour to the dive\nDIVE_XL = 8\nDIVE_TURN = 10 ** 9\nELBERETH_REST_BELOW = 0.4\nELBERETH_REST_UNTIL = 0.85\n# breathers, spitters and casters: Elbereth doesn't stop them hurting you from a distance\nRANGED_MONSTERS = frozenset((\n    'winter wolf cub', 'winter wolf', 'hell hound pup', 'hell hound', 'red naga', 'black naga',\n    'golden naga', 'guardian naga', 'cobra', 'lich', 'demilich', 'master lich', 'arch-lich',\n    'kobold shaman', 'orc shaman', 'gnomish wizard', 'energy vortex', 'yellow light', 'black light',\n    'mind flayer', 'master mind flayer', 'titan', 'couatl', 'ki-rin', 'Aleax', 'Angel',\n    'nalfeshnee', 'pit fiend', 'balrog', 'djinni', 'storm giant'))\n# XP farm: under-levelled on a fully explored level, wait on the up staircase (escape route)\n# for random spawns instead of descending. 0 disables.\nFARM_TURNS = 0\n# retreat: below this HP fraction, with prayer/Elbereth unavailable, climb the up stairs if close\nRETREAT_BELOW = 0.35\nRETREAT_MAX_DISTANCE = 12\nARRIVAL_WATCH_TURNS = 30       # how long after arriving a crowd still sends us back up\n# ...or when this fraction of max HP was lost within RETREAT_WINDOW turns\nRETREAT_FAST_LOSS = 0.3\nRETREAT_WINDOW = 3\n# arrival check: back up the stairs at once into a crowd (a b1 dive died 12 turns after walking\n# onto Dlvl 12 among a leocrotta, ogre king, soldier ants, killer bee, Woodland-elf, ...)\nCROWD_SIZE = 3\nCROWD_RADIUS = 6\nBOSS_MONSTERS = ('minotaur', 'ettin', 'titan', 'lich', 'demilich', 'master lich', 'arch-lich',\n                 'purple worm', 'green slime', 'cockatrice', 'Olog-hai', 'ogre king', 'soldier',\n                 'sergeant', 'lieutenant', 'captain', 'mind flayer', 'master mind flayer',\n                 'energy vortex', 'black dragon', 'red dragon', 'white dragon', 'blue dragon',\n                 'green dragon', 'yellow dragon', 'orange dragon', 'silver dragon', 'gray dragon')\nARRIVAL_RETREAT_REST = 150     # turns to wait upstairs before trying that staircase again\n# ARRIVAL_FIX: the crowded-arrival retreat almost never fired (31 retreats in 2678 dive stairs descents over\n# base/base2/base3/dsafe runs). descend() recorded the arrival AFTER agent.move('>'), but move() ends an atomic\n# operation whose update_state() runs the preempt checks, so anything preempting on arrival (fight2 with monsters\n# in view: exactly a crowd) raised AgentChangeStrategy out of move() and the arrival was never recorded\n# (base3-jf14 s7: down the stairs to Dlvl 10 into Green-elves, a Grey-elf and a straw golem, dead 3 turns later,\n# no retreat). And the '<' we arrive on shows us, not the stairs, so the retreat found no up staircase either.\n# With the fix: the arrival is recorded by update() from a pending note taken before the move, and the square\n# we arrived on counts as the up staircase.\n# ON (train 3): castle A034 v3 (74ed55b), bug B005: the crowded-arrival retreat fired 31 times in 2678 stair descents\nARRIVAL_FIX = True\nFULL_EXPLORE_TURNS = 2500      # per level, while under-levelled\nPORTAL_SWEEP_TURNS = 3000      # per portal level visit\nSTUCK_EXPLORE_TURNS = 4000     # searching for a hidden way down before trying other things\n# Digging down (pick-axe, or a wand of digging): a few turns per level instead of hundreds spent\n# finding the '>', and the only way past Medusa's island without levitation (4 of 8 s4 dives ended\n# on her level, walking into the water). A '>' this close is still taken (it keeps an up staircase\n# under us on arrival).\nDIG_STAIRS_RADIUS = 8\n# Dig before fighting: fight2 engages anything within 7 squares, but a hole takes a dwarf only 3-4 dig\n# steps and a monster interrupts the dig only once it attacks or first comes into view (monmove.c\n# disturb, mhitu.c): with no hostile within DIG_FIRST_RADIUS, keep digging out instead.\nDIG_FIRST = True\nDIG_FIRST_RADIUS = 2\nDIG_FIRST_MIN_HP = 0.35\n# Elbereth before each dig step when hostiles are in view: a monster that respects it neither attacks\n# nor, on first sight, interrupts the dig (monmove.c disturb() checks onscary). Digging the pit wipes it\n# (dig.c del_engr_at), so it is engraved again from inside the pit (can_reach_floor allows it there).\n# The early dig-dive deaths are crowd landings: ogre lord + owlbear, titan + warhorse, soldier ants...\nELBERETH_DIG = False\n# dig under Elbereth: engrave before digging when an Elbereth-respecting hostile is within ELBERETH_DIG_RADIUS,\n# and keep digging (not fighting) while every monster within DIG_FIRST_RADIUS respects it; after\n# SHELTERED_DIG_STUCK turns on one level (and nothing hurting us) dig regardless\nSHELTERED_DIG = True\nSHELTERED_DIG_STUCK = 200\n# engrave Elbereth before every hole, monsters in view or not (CleverShovel's Archeologist dig-dive, 0.41):\n# whatever arrives during the ~4 dig turns then can't melee us\nELBERETH_ALWAYS = False\nELBERETH_DIG_RADIUS = 6\n# DIG_ESCAPE: with a digging tool, the hole is the way out of nearly every fight above the castle. In the 90\n# HEAD baseline games (base-*), 20 of the 34 tool dives whose castle depth is known died above it. Most of\n# them fought instead of digging:\n#  * ravens on Medusa-3 (7 games). Every square of its arrival island borders water, and dig_first\n#    accepted only dry squares, so fight2 took over; the ravens blind you and swarm.\n#  * snakes and cobras on Medusa-4. The cobra counted as 'ranged', which blocked sheltered digging.\n#  * the titan on Medusa-2. Titans cast only in melee range (buzzmu() does nothing for AD_SPEL), and\n#    there Elbereth stops them.\n#  * a treasure zoo, and landing in a crowd.\n# With DIG_ESCAPE:\n#  * dig_first judges our square by the level's driest square, like try_dig_down;\n#  * only an ADJACENT @ or minotaur (onscary() ignores Elbereth for them) makes us fight instead;\n#  * there is no HP floor (emergency prayers preempt dig_first anyway);\n#  * Elbereth is engraved before every dig step on Medusa's level (hidden snakes, 30 fast ravens);\n#  * digging the pit erases the engraving (maketrap -> unearth_objs -> del_engr_at), so the engrave cap is\n#    counted separately before and after the pit. A dust Elbereth gets a typo 28% of the time (engrave.c:\n#    1 in 25 per letter), so 3 tries per square left about 1 hole in 5 finished with no Elbereth\n#    (base-jf25 s0: bitten to death in its pit on Medusa-4).\n# ON (train 2): dive-safety A2, 45 games divergence +0.65; Medusa-4 3-4/7 vs 1/7, Medusa-3 2/7 vs 0/7\nDIG_ESCAPE = True\nELBERETH_TRIES_ESCAPE = 4      # engravings per square and dig phase (before / after the pit)\nELBERETH_TRIES_BLIND = 6       # the same while blind, each after being hurt since the last one\n# DIVE_REST: a digger rests only below DIG_REST_BELOW, never to 95% before stairs, never while its pit is\n# half dug, and on Elbereth. At XL 8 HP comes back at 1 per 5 turns (allmain.c), and the deep rests were\n# fatal:\n#  * base-jf25 s3 rested at 61% in its pit, 4 dig turns from the hole, and met a dwarf mummy and a xorn;\n#  * base-jf25 s13 rested 180 turns at a '>' on Dlvl 14 (soldier ant, yellow light, fire vortex);\n#  * base-public s12 rested at 62% on Medusa's level (pit viper).\n# ON (train 2): dive-safety A2\nDIVE_REST = True\n# Medusa's level: the first Dungeons-of-Doom level at depth >= 21 showing this many pool/water squares\n# (Medusa's maps are ~70% moat; the castle comes later and is found undiggable). Shared with the castle work.\nMEDUSA_MIN_DEPTH = 21\nMEDUSA_WET_SQUARES = 30\n# DIG_TRY_FIX: DIG_MAX_TRIES counts only applies that weren't interrupted. On jf27 s3 Dlvl 9 a bat interrupted\n# all 20 applies (\"You stop digging\"), and a diggable level was marked undiggable.\n# ON (train 2): dive-safety A2\nDIG_TRY_FIX = True\nDIG_MAX_APPLIES = 80           # hard cap on all applies on one level (interrupted ones included)\nDIG_WALK_RADIUS = 6            # DIG_ESCAPE walks this far (BFS steps) to a square it can dig\nMEDUSA_WALK_RADIUS = 30        # ... and this far on Medusa's level (ESCAPE_V2)\n# ESCAPE_V2 (with DIG_ESCAPE): the refinements found after A2 (train 2):\n#  * dig_first keeps acting while the escape applies. Returning after one action let one step of the strategy\n#    underneath leak in before this hook fired again: fight2's swing from our fresh Elbereth (grind-combat's\n#    HOLD_LOOP finding);\n#  * an eel/kraken that wraps us drowns us with its next hit: Elbereth at once (monflee releases the hero);\n#  * with monsters adjacent, engrave before walking to a dig square (a scared monster flees, not attacks);\n#  * on Medusa's level walk up to MEDUSA_WALK_RADIUS to a dry dig square rather than gamble on a flood.\n# ON (train 3): dive-safety A3, +0.233 pooled over 45 arm64 games vs base3arm, no new failure mode\nESCAPE_V2 = True\nDIG_ESCAPE_ACTIONS = 40        # dig_first's escape acts at most this often per activation (see dig_first)\nMEDUSA_REROLL_WET = 2          # stranded where every square has this many moat neighbours: climb and re-fall\nMEDUSA_REROLLS = 3\n# MEDUSA_SKIP (with DIG_ESCAPE): reroll from Medusa's level (also Medusa-3) once a dig there has flooded\n# MEDUSA_SKIP_FLOODS times or the best square has MEDUSA_REROLL_WET moat neighbours; each hole dug from the level\n# above skips Medusa's level 1 time in 4 (see _medusa_reroll_stairs)\nMEDUSA_SKIP = False\nMEDUSA_SKIP_FLOODS = 1\nMEDUSA_SKIP_REROLLS = 8\nMEDUSA_SKIP_FIRST = False      # on Medusa-3 (ravens) reroll at once, before any dig, while the '<' is close\nMEDUSA_SKIP_FIRST_STEPS = 4\n# DROWN_GUARD (with DIG_ESCAPE): a hole that fills with water drops us into it, and we crawl out only to a free\n# adjacent land square (trap.c drown -> hack.c crawl_destination: no monster on it, no diagonal squeeze); with none\n# we drown on the spot. base3 lost 7 Medusa digs this way ('You sink like a rock', no 'try to crawl out'). Dig a\n# wet square only with DROWN_GUARD_EXITS such squares around it: walk to one if the ground is the problem, wait\n# on Elbereth up to DROWN_GUARD_WAIT turns if monsters are.\nDROWN_GUARD = False\nDROWN_GUARD_EXITS = 2\nDROWN_GUARD_WAIT = 15\n# DIG_WAND_ESCAPE (with DIG_ESCAPE): a known wand of digging, zapped down, holes the floor at once (zap.c\n# zap_dig -> dighole: one flood roll, no pit phase). Used where the pick-axe can't work -- an adjacent @, or\n# bitten with no Elbereth to be had -- and on Medusa's wet islands. (power: 4% of XL-8 castle arrivals carry\n# one, 13% at XL 10; try_dig_down only ever zapped it with no pick-axe in the pack.)\n# ON (train 2): dive-safety A2\nDIG_WAND_ESCAPE = True\n# WAND_FIRST (with DIG_WAND_ESCAPE): with hostiles in view, zap a known wand of digging down on a dry square\n# before digging with the pick (instant hole), and as the escape of a dive that has only the wand\n# ON (train 3): harness Big Room with a wand only 7/7 vs 5/7; inert without a known wand of digging\nWAND_FIRST = True\n# Resting to 95% on a deep level lets its monsters come to us (an s7 dig-dive rested for 150 turns on\n# Dlvl 15 until a leocrotta took it to 2 HP): with a digging tool, rest only below this.\nDIG_REST_BELOW = 0.6\nDIG_MAX_TRIES = 20             # applies on one level without falling through: floor can't be holed\n# A cursed pick-axe digs like any other (dig.c: the curse only matters on the Plane of Earth); applied, it\n# welds to the hand, which a dig-dive can live with. Without this, the first apply of an unidentified cursed\n# pick welded it, digging_tool() then rejected it as CURSED and the dive went looking for another tool\n# (eg-trip5 public seed 3: 'The pick-axe welds itself to your hand!' -> 'no digging tool at depth 1: early\n# detour to the Mines' -> killed at XL 6 on Mines 1, 0.037; the same seed without the trip scored 0.507).\n# A known-cursed mattock is still refused unless it is already welded: it takes both hands, leaving none\n# to engrave Elbereth with (agent.hands_welded).\n# ON (train 2): 56 of 74 games that welded a pick never dug again (0.163 vs 0.411)\nCURSED_PICK_OK = True\n# A dig try leaves a pit (dig.c: effort > 50 makes it and ends the occupation; the next apply digs on from\n# inside it to a hole). Once a #terrain check had shown that pit on our square, the square no longer counted\n# as plain floor and try_dig_down walked off to dig a fresh pit next door -- 'You are still in a pit', a\n# panic, another forced #terrain that recorded the new pit... A jf25 s12 digger marched pit by pit across\n# Dlvl 4-11, 20 tries per level, marked each one undiggable and took the stairs (~1000 turns a level; dead\n# on Dlvl 12 at T29790). A pit under us is where the hole gets finished.\nDIG_IN_PITS = True\nPITS = frozenset({SS.S_pit, SS.S_spiked_pit})\n# The budgets and task checks in plan_step (FULL_EXPLORE_TURNS, DWARF_SEARCH_TURNS, STUCK_EXPLORE_TURNS, the\n# tool quest's stuck test...) only run between tasks, and one exploration run can last thousands of turns (public\n# s9: a 2500-turn 'explore fully' budget overrun by 800). With EXPLORE_BUDGETS a dive exploration hands control\n# back once its budget is spent, and at least every EXPLORE_REPLAN_TURNS turns.\n# ON (train 2): robustness b2 guard 0.3480 vs 0.3479; +0.38 over the 4 games it fired in (b1)\nEXPLORE_BUDGETS = True\nEXPLORE_REPLAN_TURNS = 500\n# standing on a known trap door that didn't trigger, press '>' (the dive asserted in a loop there before)\nTRAPDOOR_PLUNGE = True\nFETCH_TOOL_TURNS = 3000        # budget for walking back to a pick-axe the tour dropped\n# Dwarves carry a pick-axe or a mattock 37.5% of the time (makemon.c) and are peaceful to a dwarf:\n# with no digging tool yet, the dive kills the peaceful dwarves it meets in the Mines (never in\n# Minetown: the Watch). Each kill costs Luck -1 half of the time, so prayer waits 600 turns per kill.\nDWARF_HUNT = True\nDWARF_HUNT_MAX_KILLS = 6\nHUNT_IN_TOUR = False           # the tour hunts too (in the Mines) from HUNT_MIN_XL\nHUNT_MIN_XL = 8\n# With a digging tool the dive is a few turns per level and XL matters much less (s7 public seed 10:\n# Dlvl 4 -> 26 in ~200 turns of digging, past Medusa): dive as soon as one is in hand from this XL,\n# and keep one during the tour (it drops them for lighter loot).\n# train 3 (early-game A027): a tool holder dives at XL 7 (public +0.056; 45 games neutral; grind losses 10 -> 5)\nDIG_DIVE_XL = 7\nKEEP_TOOL_IN_TOUR = False\n# A planned dive (the XL or tool trigger, never a rescue) waits until this many turns have passed since the last\n# prayer (0: off), so the emergency HP prayer is there on the way down: it needs the prayer timeout <= 200\n# (pray.c), and the timeout is rnz(350) right after a prayer. eg-t2glh7 XL-7 tool dives whose first dig came\n# < 800 turns after a prayer: 4 of 12 died above Dlvl 20 (Dlvl 10-17 crowds: soldiers and killer bees, elves, a\n# centaur's wand of fire), mean 0.414; >= 800 turns: 0 of 13, mean 0.513. base/base2 XL-8 dives: 28% vs 14%.\n# ON (train 3.1, early-game A044/A049): a tool holder digs only >= 800 turns after its last prayer; A049 0.399 vs base4 0.378, mid-dive deaths 1/32 vs 4/37\nDIVE_PRAYER_GAP = 800\n# ...and (DIVE_PRAYER_FOOD) not Hungry or carrying DIVE_PRAYER_FOOD_MIN nutrition: an HP prayer made while only\n# Hungry fixes the HP but not the hunger (pray.c fix_worst_trouble: Hungry is a minor trouble) and restarts the\n# clock, so the next hunger prayer is ~1100 turns away (rescue, ledger F032: 20-35 faints). The wait is capped at\n# DIVE_PRAYER_MAX_WAIT turns (a Hungry grinder with no food would otherwise wait through every prayer cycle).\nDIVE_PRAYER_FOOD = False\n# ...only when a digging tool is already in hand (the dive digs at once). A tool-less dive heads for the Mines camp\n# for thousands of turns, so its wait only reshuffles the hunt: eg-dpg lost 3 XL-8 tool-less dives that way.\n# ON (train 3.1): the wait only with a digging tool in hand (A044)\nDIVE_PRAYER_TOOL_ONLY = True\nDIVE_PRAYER_FOOD_MIN = 400\nDIVE_PRAYER_MAX_WAIT = 2500\n# DIVE_START_HP: a planned dive (the XL or tool trigger, never a rescue) starts with at least this fraction of max HP\n# (0: off); below it the grind goes on (and rests as usual) for up to DIVE_START_HP_WAIT turns. base5-8 dives that\n# started below 50% HP all died within 300 turns (3 of 3: base6-8 jf14 s8 dove at 32/74 right after a hunger prayer\n# and died on Dlvl 3 116 turns later), 50-80% scored 0.397 (13 dives), 95%+ 0.475 (269)\n# t35: jf16 s1 0.507 -> 0.075 -- the 'wait' is the grind, which fought on from 66/84 to 11/84 and prayed at gap 607;\n# a version would have to rest -- off\nDIVE_START_HP = 0\nDIVE_START_HP_WAIT = 300\n# The portal sweep (Home 1 = 0.366) costs ~1500 turns of exploring the level; digging reaches\n# Dlvl 20+ (0.38+) within a few hundred turns, so no sweep while holding a digging tool.\nSWEEP_WITH_TOOL = False\n# Tool run (off: None): end the tour's Dlvl 1 grind at this XL instead of XL 8 and head for the Mines\n# to take a dwarf's pick-axe (HUNT_MIN_XL / DIG_DIVE_XL follow it). The XL 5-8 grind is where unseen\n# games starve (9 of 30 died on Dlvl 1 at XL 3-7).\nTOOL_RUN_XL = None\n# Rescue dive: a failed prayer during the Dlvl 1 grind leaves the god angry and the game starving (92\n# past games: median survival ~1,050 turns after the first failure, 24 of 40 first failures on Dlvl 1).\n# Such a game dives at once: down the Mines (peaceful to a dwarf; Mines' End is Dlvl 10-13, 0.13-0.26),\n# hunting dwarves on the way, digging in the main dungeon if it gets a pick-axe. Fires only in games\n# that are otherwise lost.\nRESCUE_DIVE = True\n# The same later in the tour: a prayer failed (the god is angry or Luck < 0, so no more hunger prayers)\n# and the character is Weak with nothing to eat. The tour would starve on the spot (a clock-jf6 XL8\n# starved in the Mines 1700 turns after an unlucky prayer); the dive at least banks depth on the way.\nLATE_RESCUE = True\n# rescue dives take the main-dungeon stairs (not the Mines route): see should_dive\nRESCUE_MAIN_DUNGEON = True\n# Experiment: skip the Dlvl 1 grind altogether (38% of unseen games are lost there: prayer failures,\n# fainting deaths) and dive from EARLY_DIVE_TURN on the rescue route -- down the Mines (peaceful to a\n# dwarf), hunting dwarves for a pick-axe, digging the main dungeon once one is in hand. Even a failed\n# early dive that reaches Dlvl 10-12 scores 0.13-0.21, above a grind death (0.02-0.07).\nEARLY_DIVE = False\nEARLY_DIVE_TURN = 1\n# planned early dive from this XL (0: off): see should_dive\nEARLY_DIVE_XL = 0\n# Ditch the pet for the Dlvl 1 grind (off: experiment). On 15 unseen grinds the pet ate ~40% of the\n# corpses (497 meals vs our 732) and made ~10% of the kills (no XP for us); food is what the grind runs\n# out of (hunger prayers, their failures, starvation). Take it down to Dlvl 2 and come back up alone\n# (a pet only follows when adjacent, and can't climb stairs on its own).\nDITCH_PET = False\nDITCH_PET_AFTER = 300          # turns into the game (Dlvl 1 explored, its '>' known)\nDITCH_PET_BUDGET = 300\nDWARF_HUNT_TURNS = 400         # per level\n# a dive leaving the Mines without a digging tool explores each Mines level (not Minetown) this long\n# looking for dwarves before climbing on (about 2 dwarves per Mines filler level, 37.5% armed with one)\nDWARF_SEARCH_TURNS = 300\n# Tool quest: a tool-less dive stuck this deep with no way down (Medusa's water, half of all dives)\n# has banked its depth, so the long trip back to the Mines for a dwarf's pick-axe can only add.\nTOOL_QUEST_DEPTH = 18\nTOOL_QUEST_STUCK_TURNS = 800\nTOOL_QUEST_TURNS = 12000\n# Early detour: a dive with no digging tool that is still shallow (it started in Sokoban or the main\n# dungeon, never climbing out through the Mines) first visits Mines levels 1-3 for a dwarf's pick-axe:\n# ~50% find one, and a digger's dive is worth ~+0.1 over a stairs dive.\nEARLY_DETOUR = True\nEARLY_DETOUR_DEPTH = 12\nEARLY_DETOUR_MINES_LEVELS = 3\nEARLY_DETOUR_TURNS = 2500\nDWARF_NAMES = ('dwarf', 'dwarf lord', 'dwarf king')\n# Gehennom (jf_config.GEHENNOM_DIVE): with neither prayer nor Elbereth there, a wand of digging zapped down is\n# the one-turn escape from a monster we can't outfight, and it banks the next level. Which monsters count:\n# the maze fillers' minotaurs (0-2 per level; 116 of 550 games that reached Dlvl 25+ in our runs died to one)\n# and anything of level >= GEHENNOM_THREAT_LEVEL, plus the instadeath/brain/digestion attackers.\nGEHENNOM_THREAT_LEVEL = 10\n# Valley walk: attack only what blocks the next step while nothing hurts us (valley_sneak). At XL 10 (15\n# valley-x10 seeds) it walked into the crowds and died after 116 turns on average, vs 537 fighting them\n# (fight2) where they come, and neither variant got out; but with a strong kit (power agent: XL 14, gray\n# dragon scale mail, speed boots) 4 of 12 got past the '>' with it and 0 of 5 without.\nVALLEY_SNEAK = True\n# The Valley's '<' is the lifeline: below VALLEY_RETREAT_BELOW of max HP (or VALLEY_CROWD_BELOW with\n# CROWD_SIZE hostiles close) with a hostile near and the '<' within VALLEY_RETREAT_REACH steps, climb up to\n# the castle's east edge, where Elbereth and prayer work; the castle mode (castle agent) rests there and\n# comes back down through the trap door behind the castle's back door (dive.valley_retreats / _turn tell\n# it we came up to heal). 15 of 15 valley-x10 seeds (XL 10, 99 HP, AC -2) died in the Valley without it,\n# 3 of them swarmed at the landing spot (vampire bats, vampire lords in bat form, mummies, ghosts).\nVALLEY_RETREAT = True\nVALLEY_RETREAT_BELOW = 0.5\nVALLEY_CROWD_BELOW = 0.75\nVALLEY_RETREAT_REACH = 15\n# below REST_BELOW in the Valley, rest on the '<' when within VALLEY_REST_REACH steps, up to VALLEY_REST_UNTIL\nVALLEY_REST_REACH = 25\nVALLEY_REST_UNTIL = 0.9\n# Below the Valley a digger rests only under this HP fraction (DIG_REST_BELOW elsewhere, and no 2/3-HP rest):\n# a hole is ~5 turns and banks a level, while resting in place brings the level to us (a valley+1 dig-dive\n# rested at 47% on Juiblex's level and was engulfed: 'You feel deathly sick' -- no prayer to cure it there)\nGEHENNOM_DIG_REST_BELOW = 0.3\nGEHENNOM_THREATS = frozenset(('minotaur', 'mind flayer', 'master mind flayer', 'cockatrice', 'chickatrice',\n                              'green slime'))   # stoning and sliming: only prayer (none in Gehennom) cures them\n# Gehennom: a scroll of scare monster on our square scares every monster but the temple priest, lawful minions,\n# Riders and Rodney (monmove.c onscary: 'the scare monster scroll doesn't have any of the below restrictions'),\n# so unlike Elbereth also in Gehennom and against @ and minotaurs; a scared monster neither attacks (dochug:\n# !scared) nor stops our dig occupation (allmain monster_nearby: !onscary). When a fight goes badly (below\n# GEHENNOM_SCARE_BELOW with a hostile adjacent, or GEHENNOM_SCARE_CROWD adjacent below GEHENNOM_SCARE_CROWD_BELOW)\n# drop one (power.scare_scrolls) and hold on it: dig down from it, or in the Valley rest on it to\n# GEHENNOM_SCARE_UNTIL. It stays behind (picked up again it turns to dust, pickup.c).\nGEHENNOM_SCARE = False\nGEHENNOM_SCARE_BELOW = 0.5\nGEHENNOM_SCARE_CROWD = 2\nGEHENNOM_SCARE_CROWD_BELOW = 0.8\nGEHENNOM_SCARE_UNTIL = 0.9\n# with no known scroll, drop every carried unknown scroll that may be scare monster (a gamble: ~35/1000 of\n# random scrolls; power: a castle arrival carries 6-8 unknown types, ~25% that one is scare monster)\nGEHENNOM_SCARE_GAMBLE = False\n# Valley camp: first stand on the '<' (1-13 steps from every landing square) and take the wanderers there, one\n# group at a time, with the retreat up the '<' at hand; leave for the doors once no hostile has been in view for\n# VALLEY_CAMP_QUIET turns and HP >= VALLEY_REST_UNTIL, or after VALLEY_CAMP_MAX turns.\nVALLEY_CAMP = False\nVALLEY_CAMP_QUIET = 60\nVALLEY_CAMP_MAX = 800\n# The Valley's graveyards (valley.GRAVEYARD, 122 squares) hold a sleeping undead on every square, and a\n# Valkyrie's stealth keeps them asleep as we pass (monmove.c disturb: !Stealth). fight2 took on every one that came\n# into view (sneak or not, once anything hurt us): a monster standing on a graveyard square counts for the fight\n# only when it attacked us in the last VALLEY_ATTACKER_TURNS turns (its name in a hit/miss message); path\n# blockers are the sneak's business. gg1 deaths clustered at the graveyards' columns (21-26, 39-48).\nVALLEY_GRAVE_FILTER = False\nVALLEY_ATTACKER_TURNS = 5\n# --- dwarf hunt mechanics (pick-hunt) ---\n# Every dwarf death is a pile to check, whoever killed it (us, the pet, fight2 finishing an angry witness), and\n# at once: only the hunted target's pile was checked, 50 turns late (the fetch scan interval) -- base-jf26/14\n# killed a dwarf in its tunnel on Mines 2, walked down to Mines 3, came back and found the pile 'unreachable'.\nDWARF_PILES = False\n# Prefer dwarves seen digging: standing on known rock or wall, or on a '#' in the Mines (the Mines have no\n# corridors of their own: a '#' there is a dwarf's tunnel), or right after 'The dwarf wields a pick-axe!'.\n# makemon gives a dwarf a pick 25% / a mattock 12.5% of the time; a digger has one for sure.\nDIGGER_FIRST = False\n# 'You hear crashing rock.' (a digging dwarf went through a wall on this level): search this level longer\nCRASH_SEARCH_BONUS = 300\nCRASH_SEARCH_MAX = 1500\n# Alignment budget instead of a flat kill cap (3.6.6 source): hmon_hitmon wakes the dwarf -> setmangry\n# (mpeaceful = 0, alignment -1) before any damage, so xkilled never takes the 'peaceful: Luck -1' branch;\n# the kill costs adjalign(malign) = -12 (a coaligned peaceful's malign). Other peaceful humanoids in view\n# turn hostile (-1 each; an angered dwarf we then kill costs its -12 too). A Valkyrie starts at alignment 0\n# and it is capped at ALIGNLIM = 10 + turns/200 (hostile kills keep a grind near the cap); prayer fails\n# below 0. So: ~7 kills at turn 20000, ~3 at 9000, 1 at 3000.\nALIGN_BUDGET = False\nALIGN_MARGIN = 5\n# turns prayers wait after each dwarf we kill (assumed Luck -1; the Luck loss doesn't happen, see above)\nKILL_PRAYER_HOLD = 600\n# the Dlvl-1 grind (and the rest of the tour) hunts peaceful dwarves from this XL (0: off) and keeps the tool:\n# dwarves spawn on Dlvl 1 from XL 7 (difficulty 4 <= (1 + XL) / 2); 51 of 90 baseline grinds heard one\n# digging there ('You hear crashing rock.') and 5 of those dives still never got a tool\n# train 3 (A027): the grind hunts dwarves from XL 5 on its Dlvl 2-3 grind levels\nGRIND_HUNT_XL = 5\nGRIND_HUNT_DIGGERS_ONLY = False\n# the tool-less dive's Mines route explores Dlvl 2-4 only until the branch '>' is known (see _search_branch);\n# the tour-mode pick trip (jf_config.PICK_TRIP_XL) too, through trip_branch_strategy\nFAST_BRANCH = False\nBRANCH_HIDDEN_TURNS = 500          # per level (0: off), see _search_branch\nBRANCH_SEARCH_TURNS = 1500         # exploring one of Dlvl 2-4 for the branch before moving on (was FULL_EXPLORE_TURNS)\nBRANCH_CLIMB_MAX = 3               # climb back from at most this many levels below Dlvl 4 (see _climb_back_for_branch)\nBRANCH_CLIMB_TURNS = 1500          # per level, finding and taking its '<'\n# BRANCH_FIX2 (off): climb back up to 3 levels from below Dlvl 4 while the branch search there isn't done (trap\n# doors, holes, a candidate that was the main '>'), a 1500-turn branch search per level, and replanning\n# ON (train 3): pick-fix2arm +0.017 over 45 arm64 games, no-tool dives 6 -> 4\nBRANCH_FIX2 = True\n# CLIMB_FIX (off): the branch climb takes only a '<' that leads (or may lead) to the level above -- never one known\n# to go elsewhere: base4-jf14 s1 climbed Sokoban's '<' from Dlvl 7 and came straight back down, every turn -- and\n# each staircase at most BRANCH_STAIRS_CAP times; a branch '>' known on a level above with no known stairs there\n# (we came down a hole) is climbed to: base4-jf14 s14 took the main '>' of Dlvl 4 instead and the climb back from\n# Dlvl 5 brought it up again, 4 <-> 5 every turn\n# ON (train 3.1, pick-hunt 7e4ac3f, B012): no climb-back ping-pong (Dlvl 7<->Sokoban, 4<->5); replays jf14 s1/s14\nCLIMB_FIX = True\nBRANCH_STAIRS_CAP = 3\n# WAND_WAITS2 (off): WAND_FIRST's zap at any hostile in view waits too while the Mines route is pending (see\n# _wand_waits); the zaps against an adjacent @ or when bitten with no Elbereth to be had stay\n# ON (train 3.1): WAND_FIRST holds the digging-wand zap while the Mines route is pending (7 of 90 base4 tool-less dives zapped it at a distant hostile)\nWAND_WAITS2 = True\n# HIDDEN_SEARCH2 (off): the hidden-branch search searches from the squares next to the widest never-seen parts of\n# the map first (see _search_toward_void), HIDDEN_SEARCH2_TURNS per level\nHIDDEN_SEARCH2 = False\nHIDDEN_SEARCH2_TURNS = 800\n# Walk up to peaceful dwarves we see but can't reach: a digger inside its fresh tunnel (dark corridor squares\n# aren't on our map) was dropped as unreachable. Crash-heard Mines levels gave 9 tools in 30 baseline visits,\n# the rest 6 in 179, yet jf27/14 heard 53 crashes on Mines 2 in 3840 turns without one attack. Seeing the\n# dwarf along a straight line proves the squares between aren't rock: they are marked walkable.\nAPPROACH_DWARVES = False\nAPPROACH_STEPS = 60                # approach moves per APPROACH_WINDOW turns on a level\nAPPROACH_WINDOW = 500\n# LURE_DWARVES (off): throw at a peaceful dwarf in line but out of reach (see _lure)\nLURE_DWARVES = False\nLURE_RANGE = 7\n# Minetown is Mines level 3 or 4 (dungeon.def minetn @ (3, 2)) and was only recognised by a shopkeeper in\n# view: a hunt-v2 smoke replay (jf16/9) attacked a dwarf there first -- 'Halt! You're under arrest!', three\n# watchmen killed ('You murderer!' x3: prayers held 3600 turns), fainted, killed by a fox. On Mines levels\n# 3-4 hunt only once the other one is known to be the town, or this one looks like a filler: 500+ squares\n# seen without a door, altar, fountain, shopkeeper, watchman or priest (500 squares: dropped, see _hunt_level_ok).\nMINETOWN_GUARD = False\n# A wand of digging doesn't fire on Dlvl 1-4 while the Mines route (a dwarf's pick) is pending: baseline jf27/4\n# zapped from Dlvl 1 at dive start, fell past the branch level, gave the Mines up at Dlvl 5 and died tool-less\n# on Dlvl 7 (4 of 62 regular dives zapped a wand early and dove without a pick: mean 0.18)\nWAND_WAITS = False\n# a tool-less dive gives the Mines route up after MINES_STUCK_TURNS on one level with its '>' cut off, instead of\n# STUCK_EXPLORE_TURNS (4000) (walking through traps to it is robustness's TRAP_LAST_RESORT); and in the Mines a\n# sleeping peaceful gnome boxing us in is attacked (see _clear_blocker)\nMINES_UNSTUCK = False\nMINES_STUCK_TURNS = 1500\n# Mines camp: a tool-less dive doesn't leave the Mines. It sweeps Mines levels 1..MINES_CAMP_MAX_LEVEL (not\n# Minetown) down and up, searching each visit CAMP_VISIT_TURNS for dwarves, for MINES_CAMP_TURNS in all; a\n# failed prayer or the end of the budget sends it on down the Mines as before. Early-game measured the tool-less\n# XL-8 phase: no deaths in 50k Mines turns, ~7% loss per 1000 turns back in the main dungeon without a tool,\n# 0.3-0.7 tools per 1000 Mines turns; base2 had 15 tool-less dives in 75 games (mean 0.14).\n# ON (train 2): with HUNT_V2 (pick-camp1); the camp ran in 12 dives and ended with a tool in 10\nMINES_CAMP = True\nMINES_CAMP_TURNS = 8000\n# RETURN_FIX (off): return_to_main_dungeon also knows the up stairs by their recorded destination, and a dive\n# boxed in with a digging tool digs sideways out (see _dig_out)\nRETURN_FIX = False\nDIG_OUT_REACH = 30                 # 'boxed in': the BFS reaches fewer squares than this ...\nDIG_OUT_TURNS = 20                 # ... for this many turns\n# The dive's first job on the level it starts from: a tool-less dive whose grind level held a digging dwarf\n# (seen in rock, or 'You hear crashing rock.', within HOME_DIGGER_WINDOW turns) searches that level for it first,\n# HOME_DIGGER_TURNS at most (0: off). Dwarves spawn on Dlvl 1 from XL 7; 51 of 90 baseline grinds heard one\n# there, and base2-public s1/s8/s14 (tool-less dives) all had one on Dlvl 1 in the old base; hunt-v2 jf16/12\n# watched a digger on Dlvl 1 for 2000 turns, then dove without a tool. Unlike GRIND_HUNT_XL it leaves the tour alone.\n# ON (train 3): 600 turns; +0.035 over 45 arm64 games vs base3arm, no-tool dives 6 -> 4\nHOME_DIGGER_TURNS = 600\n# train 3.1: only fresh digger evidence (B012: stale 2000-4800-turn evidence on the GRIND_LEVELS level cost 5 tool-less dives in base4)\nHOME_DIGGER_WINDOW = 300\nMINES_CAMP_MAX_LEVEL = 4\nCAMP_VISIT_TURNS = 400\nCAMP_STAIRS_TURNS = 1000         # looking for the way on to the next camp level before turning around\n# CAMP_FIX (off): town levels only on Mines 3-4 and not from a stair follower; camp stair timers reset per visit\n# ON (train 3): with BRANCH_FIX2 (pick-fix2arm)\nCAMP_FIX = True\n# master switch for the hunt mechanics above (individual flags stay for ablations)\n# ON (train 2): pick-camp1 45 games 0.393 vs 0.348, tool dives 85% vs 74%, no-tool dives 9 -> 5\nHUNT_V2 = True\n\n\ndef _apply_dev_overrides():\n    \"\"\"Dev experiments only: JF_CFG='{\"REQUIRED_XL\": {...}, ...}' overrides the constants above.\n    The arena never sets it, so submissions always run the defaults.\"\"\"\n    import json\n    import os\n    raw = os.environ.get('JF_CFG')\n    if not raw:\n        return\n    for name, value in json.loads(raw).items():\n        if name in ('REQUIRED_XL', 'MINES_REQUIRED_XL'):\n            value = {int(k): int(v) for k, v in value.items()}\n        if name in globals():\n            globals()[name] = value\n\n\n_apply_dev_overrides()\nif HUNT_V2:\n    DWARF_PILES = DIGGER_FIRST = ALIGN_BUDGET = FAST_BRANCH = APPROACH_DWARVES = MINETOWN_GUARD = WAND_WAITS = \\\n        MINES_UNSTUCK = True\n    KILL_PRAYER_HOLD = 0\n\n\ndef _only_ranged_monsters():\n    \"\"\"Monsters fight2 never melees (passive damage): not the rest's to fight either.\"\"\"\n    from .combat.monster_utils import ONLY_RANGED_SLOW_MONSTERS\n    return ONLY_RANGED_SLOW_MONSTERS\n\n\ndef _hold_loop(func):\n    \"\"\"HOLD_LOOP for one-action 'hold' strategies (Elbereth rest, demon vigil, faint guard).\n\n    agent.preempt() re-runs the underlying strategy after a preempting body returns, and the upper hooks\n    fire only on the next step's update: one step of a lower strategy always ran between two hold actions --\n    an exploration move off the Elbereth (the IDLE guard re-engraved on a new square every turn, gc-idle\n    public T10183-10185), or fight2's attack/throw from the square. With the flag the body repeats while the\n    strategy's own condition holds, like fight2's loop; higher-priority preempts still interrupt it through\n    their update hooks. Apply below @Strategy.wrap.\"\"\"\n    @functools.wraps(func)\n    def wrapper(self, *args, **kwargs):\n        gen = func(self, *args, **kwargs)\n        if not next(gen):\n            yield False\n            return\n        yield True\n        agent = self.agent\n        while True:\n            steps = agent.step_count\n            try:\n                next(gen)\n            except StopIteration:\n                pass\n            # no step taken (e.g. an engrave that was refused): never spin\n            # HOLD_LOOP_RESCUE: the loop only once a prayer has failed (the rescue dive), the tour unchanged\n            looping = jf_config.HOLD_LOOP or (jf_config.HOLD_LOOP_RESCUE and agent.prayer_failed)\n            if not looping or agent.step_count == steps:\n                return\n            gen = func(self, *args, **kwargs)\n            if not next(gen):\n                return\n    return wrapper\n\n\nclass DiveLogic:\n    def __init__(self, agent):\n        self.agent = agent\n        self.portal_level = None       # (dnum, lnum) of the Quest portal level\n        self.visited_quest = False\n        self.quest_arrival = None      # (y, x) of the portal on the Quest home level\n        self.level_first_turn = {}     # level key -> turn first seen\n        self.fully_explored = set()    # level keys explored to exhaustion\n        self.sweep_started = None      # turn the current portal sweep began\n        self.sweep_given_up = set()    # portal level keys whose sweep ran out of budget\n        self._last_key = None\n        self._last_task = None\n        self.mines_done = False        # reached the bottom of the Mines, or gave the route up\n        self._elbereth_resting = False\n        self.diving = False\n        self.dive_start_turn = None     # DIVE_TOOL_HUNGER_GAP: the turn the dive phase began (None: set by a scenario)\n        self.rescue = False                # the dive began as a rescue from a failed Dlvl 1 grind\n        self.pick_trip = False             # the grind's detour to the Mines for a pick-axe (PICK_TRIP_XL)\n        self.undiggable = set()            # level keys where the floor is too hard to dig\n        self._hp_history = []              # (turn, hp) of the last few turns\n        self._status_logged = -1\n        self._murder_turn = -1\n        self._demon_vigil_until = -1       # turn until which a released water demon is kept off with Elbereth\n        self._faint_start = None           # turn the current faint began (last awake observation)\n        self._guard_weak_since = None      # turn the current Weak spell began (FAINT_GUARD_IDLE)\n        self._guard_hold_until = -1        # keep holding the faint guard's Elbereth until this turn (IDLE)\n        self._ranged_hit_turn = -10 ** 9   # last turn a missile, wand or ray hit us (RANGED_ON_ELB)\n        self._hold_squares = set()         # (level key, y, x) where a hold (faint guard, Elbereth rest) stood\n        self._last_update_turn = 0\n        self.pet_seen = {}                 # level key -> last turn a pet glyph was in view\n        self._last_pos = None              # (level key, (y, x)) at the previous update\n        self._arrived = None               # (level key, turn) of the last stairs arrival\n        self._arrival_pending = None       # ARRIVAL_FIX: (level key, '>' position, turn) of a stairs descent\n        self._arrival_square = None        # ARRIVAL_FIX: (level key, position) of the '<' we arrived on\n        self._crowd_retreats = {}          # ARRIVAL_FIX: (level key, '>' position) above -> crowd retreats taken\n        self._avoid_stairs_until = {}      # (level key, (y, x)) -> turn: don't take this '>' before\n        self._retreat_blocked_until = -1   # turn until which a failed retreat isn't retried\n        self._dig_tries = {}               # level key -> pick-axe applies without falling through\n        self._dig_blocked_until = -1       # turn until which applying the pick-axe isn't retried\n        self._fetch = None                 # (level key, (y, x), turn started) of a known pick-axe\n        self._fetch_given_up = set()       # (level key, (y, x)) of pick-axes not worth another trip\n        self._fetch_scan_turn = -10 ** 9   # last turn the levels were scanned for pick-axes\n        self._bad_dig_spots = set()        # (level key, (y, x)) where a boulder etc. blocks digging\n        self._dead_traps = set()           # (level key, (y, x)) trap doors '>' didn't take us through\n        self.tool_spots = set()            # (level key, (y, x)) where a pick-axe was dropped or seen\n        self._dwarves_killed = 0\n        self._spot_visits = {}             # (level key, (y, x)) -> go_to attempts\n        self._climb_trap_tries = {}        # level key -> times traps were opened for a climb\n        self._ditch_state = 0              # pet ditch: 0 idle, 1 down with it, 2 up without it, 3 over\n        self._ditch_started = None\n        self._hunting = False              # our last attack was on a peaceful dwarf\n        self._hunt_started = {}            # level key -> turn the hunt began there\n        self._search_started = {}          # level key -> turn the dwarf search began there\n        self._quest_started = None         # turn the tool quest began\n        self._quest_over = False\n        self._quest_early = False          # the running quest is the early (shallow) Mines detour\n        self._early_done = False\n        self._valley_arrival = None        # turn we first stood in the Valley of the Dead\n        self._valley_misplaced = False     # the Valley's '>' wasn't where valley.py puts it: search the usual way\n        self._valley_undiggable_doors = set()  # door squares a pick-axe refused (dig them no more: search, kick)\n        # climbs up the Valley's '<' to heal on the castle level (read by the castle mode: rest before coming back)\n        self.valley_retreats = 0\n        self.valley_retreat_turn = None\n        self._valley_west = None           # westmost column reached in the Valley (progress log)\n        self._valley_resting = False       # resting in the Valley until VALLEY_REST_UNTIL\n        self._scare_spot = None            # (level key, (y, x)) where we dropped a scroll of scare monster\n        self._scare_drop_turn = None       # turn of that drop (CASTLE_SCARE hold cap)\n        self._not_scare_keys = set()       # scroll appearances a fake pile proved not to be scare monster\n        self._scare_drops = 0\n        self._hostile_seen_turn = -1       # last turn a hostile was in view (Valley camp)\n        self._valley_camp_start = None     # turn the Valley camp on the '<' began\n        self._valley_camp_done = False\n        self._valley_attackers = {}        # monster name -> last turn it attacked us (Valley)\n        self.castle = CastlePassage(self)  # castle_logic.py (jf_config.CASTLE_PASSAGE)\n        self._dwarf_seen = (None, [])      # (level key, [(y, x)]) of dwarf glyphs at the last update\n        self._diggers = {}                 # level key -> {(y, x): turn} where a dwarf was seen digging\n        self._crash_turn = {}              # level key -> last turn 'You hear crashing rock.'\n        self._align_est = None             # estimated alignment record (ALIGN_BUDGET)\n        self._approach_count = {}          # level key -> (window start turn, approach moves in that window)\n        self._town_levels = set()          # Mines level keys where the Watch, a shopkeeper or a priest was seen\n        self._visit_start = (None, 0)      # (level key, turn) we arrived on the current level\n        self._branch_hidden = False        # FAST_BRANCH: Dlvl 2-4 explored without the branch, searching walls\n        self._branch_search_start = {}     # level key -> turn the wall search for the hidden branch began there\n        self._branch_trap_walk = set()     # level keys explored once more past their known traps\n        self._branch_skip = set()          # (level key, (y, x)) candidate branch '>' we could not reach\n        self._branch_reach = {}            # (level key, (y, x)) -> turn we began trying to reach it\n        self._climb_start = {}             # level key -> turn we began climbing back from it for the branch\n        self._climb_count = {}             # CLIMB_FIX: (level key, (y, x)) -> times the branch climb took that '<'\n        self._camp_start = None            # MINES_CAMP: turn the camp began\n        self._camp_over = False\n        self._camp_dir = 1                 # sweep direction: +1 down, -1 up\n        self._camp_visit = None            # (level key, turn we arrived) of the current camp visit\n        self._camp_moves = {}              # (level key, direction) -> turn we began trying to leave that way\n        self._boxed_since = None           # (level key, turn) we have been boxed in by peacefuls since\n        self._boxed_dig = None             # (level key, turn) boxed in with a digging tool since (RETURN_FIX dig-out)\n        self._dig_out_bad = set()          # (level key, (y, x)) squares too hard to dig\n        self._dig_out_block = -1           # turn until which the dig-out isn't retried (no direction to dig)\n        self._home_search = {}             # level key -> turn the dive began searching it for its digger\n        self.medusa_level = None           # level key of Medusa's level once seen (see MEDUSA_WET_SQUARES)\n        self._pit_at = None                # (level key, (y, x)) of the pit we dug and still stand in\n        self._dig_applies = {}             # level key -> all pick-axe applies (DIG_TRY_FIX)\n        self._max_wet_cache = None         # (turn, level key, max_wet) for _dig_max_wet\n        self._hurt_on_elbereth = -1        # last turn HP fell while we stood on an intact Elbereth\n        self._medusa_rerolls = 0           # climbs off a wet Medusa islet to fall in again elsewhere\n        self._dig_walk_blocked_until = -1  # turn until which DIG_ESCAPE doesn't walk to a dig square\n        self._medusa_reroll_blocked_until = -1\n        self._raven_levels = set()         # Medusa's level key once ravens were seen there (Medusa-3)\n        self._medusa_floods = 0            # holes that flooded on Medusa's level (MEDUSA_SKIP)\n        self._eel_hold_turn = -10          # last turn an eel/kraken grabbed us (or we failed to break free)\n        self._eel_engraved = -10           # last turn we engraved Elbereth against such a hold\n        self._fed_wait_start = None     # DIVE_FED: turn the grind first reached its end XL\n        self._prayer_wait_start = None  # DIVE_PRAYER_GAP: turn the dive first had to wait for the prayer\n        self._hp_wait_start = None      # DIVE_START_HP: turn the dive first had to wait for its HP\n        self._hp_wait_over = False      # ... and the wait hit DIVE_START_HP_WAIT (logged once)\n        self._fed_wait_logged = False\n\n    # ------------------------------------------------------------------ state\n\n    def update(self):\n        agent = self.agent\n        level = agent.current_level()\n        key = level.key()\n        turn = agent.blstats.time\n        if not self._hp_history or self._hp_history[-1][0] != turn:\n            if self._hp_history and agent.blstats.hitpoints < self._hp_history[-1][1] and \\\n                    (agent.inventory.engraving_below_me or '').lower() == 'elbereth':\n                # hurt while standing on an intact Elbereth: whatever did it ignores the engraving\n                self._hurt_on_elbereth = turn\n            self._hp_history.append((turn, agent.blstats.hitpoints))\n            self._hp_history = self._hp_history[-12:]\n        if self._pit_at is not None and self._pit_at != (key, (agent.blstats.y, agent.blstats.x)):\n            self._pit_at = None\n        if self.medusa_level is None and level.dungeon_number == Level.DUNGEONS_OF_DOOM and \\\n                agent.blstats.depth >= MEDUSA_MIN_DEPTH and key not in self.undiggable and \\\n                utils.isin(level.objects, WET).sum() >= MEDUSA_WET_SQUARES:\n            self.medusa_level = key\n            agent.log(f'DIVE Medusa level detected: {key} depth {agent.blstats.depth}')\n        if key == self.medusa_level and key not in self._raven_levels:\n            if DiveLogic.RAVEN is None:\n                DiveLogic.RAVEN = MON.from_name('raven')\n            if utils.isin(agent.glyphs, [DiveLogic.RAVEN]).any():\n                self._raven_levels.add(key)   # Medusa-3 (medusa.des: 30 hostile ravens)\n                agent.log('DIVE Medusa-3 (ravens)')\n        if agent.blstats.hunger_state >= Hunger.FAINTING:\n            if agent._fainting_since is None:\n                agent._fainting_since = turn\n        else:\n            agent._fainting_since = None\n        if jf_config.RANGED_ON_ELB:\n            # every message since the last update: volleys and zaps arrive inside other atomic operations\n            hist = agent._message_history\n            start = getattr(self, '_ranged_seen', 0)\n            if start > len(hist):\n                start = 0\n            self._ranged_seen = len(hist)\n            m = self._RANGED_HIT.search(' '.join(hist[start:] + [agent.message]))\n            if m:\n                if turn - self._ranged_hit_turn > jf_config.RANGED_BREAK_TURNS:\n                    agent.log(f'RANGED hit: holds and Elbereth waits off for {jf_config.RANGED_BREAK_TURNS} turns')\n                self._ranged_hit_turn = turn\n        if agent.blstats.hunger_state == Hunger.WEAK:\n            if agent._weak_since is None:\n                agent._weak_since = turn\n            if self._guard_weak_since is None:\n                self._guard_weak_since = turn\n        else:\n            agent._weak_since = None\n            self._guard_weak_since = None\n        # faint length -> hunger: the faint began after the last awake observation and ends with 'You","lineStart":1,"lineEnd":739,"totalLines":740,"truncated":true}},"title":"autoascend/dive_logic.py","time":{"start":1790531890028,"end":1790531890044}},"id":"prt_0e4046b65001JsanoNHJ1zYnSK","sessionID":"ses_f1bfdb0f7ffeZlkE5FkbKms7fE","messageID":"msg_0e4044568001of6zIWsONbGyDv"}}
{"type":"tool_use","timestamp":1790531890434,"sessionID":"ses_f1bfdb0f7ffeZlkE5FkbKms7fE","part":{"type":"tool","tool":"read","callID":"call-eef54238-7fba-4de0-b079-be6ed80ede8c","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/jf_config.py"},"output":"<path>/workspace/autoascend/jf_config.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Feature switches for A/B experiments.\n2: \n3: Dev runs may override them with JF_CFG='{\"TOUR_FIXES\": false, ...}'; the arena never sets\n4: JF_CFG, so submissions always run these defaults.\n5: \"\"\"\n6: import json\n7: import os\n8: \n9: # Fixes that change the levelling tour. Split by WHEN they first change a game:\n10: # LATE: only at a specific hazard (gas spore next to the pet, cockatrice corpse, passive-damage\n11: #   monster, deadly status, empty wand) -- the elite's early game is untouched until then.\n12: # EARLY: prayer at pray.c's critically_low_hp instead of 'HP < 12', eat carried food before a\n13: #   hunger prayer below XL 5 -- these reshuffle games from the first prayer on.\n14: EARLY_FIXES = False\n15: LATE_FIXES = True\n16: # the rarest-hazard subset of LATE_FIXES (gas spore next to the pet, cockatrice-family corpse\n17: # squares, spotted/ochre jelly and gelatinous cube melee): these first fire close to the deaths\n18: # they prevent, so they barely perturb the elite's public trajectories\n19: HAZARD_FIXES = False\n20: # master switch kept for older experiment configs: sets both\n21: TOUR_FIXES = None\n22: # Excalibur dips only at >= 90% HP with a prayer ready (astra); changes the tour\n23: SAFE_DIPS = False\n24: # when Weak or worse with HP > 40, poisonous/acidic corpses are acceptable food\n25: STARVING_EATS = True\n26: # astra's survival layer (Elbereth rest, retreat upstairs) also during the levelling tour\n27: SURVIVAL_IN_TOUR = True\n28: # at critically low HP with no safe prayer and a hostile adjacent: stairs, unknown wands/potions/scrolls\n29: LAST_RESORT = True\n30: # Komershan's verified leader (0.2033 on hidden seeds): dwarves and gnomes skip Sokoban and walk the\n31: # peaceful Mines from Minetown straight to Mines' End (Dlvl 10-13: 0.126-0.26 banked early)\n32: SKIP_SOKOBAN = False\n33: # pray for HP only at pray.c's critically_low_hp (DT6A's 'HP < 12' prays with no trouble to fix: no\n34: # heal, and a failure if the timeout isn't 0), and allow the first prayer from turn 100 (the timeout\n35: # starts at 300; major trouble needs <= 200)\n36: EXACT_PRAYER = False\n37: # minimum turns since the last prayer for a hunger prayer while Fainting (DT6A: 400). Most first prayer\n38: # failures were Fainting prayers 900-1100 turns after the last one (rnz(350) timeout: ~6% fail there,\n39: # ~2% past 1100); a longer gap means fainting longer instead\n40: FAINT_PRAYER_GAP = 1100\n41: # AutoAscend's periodic 'eat corpses' preempt was meant to walk to edible corpses on the level, but\n42: # only_below_me defaults to True, so it only ever eats what lies underfoot; the kills' corpses beside\n43: # us go to the pet (it ate ~40% of the grind's corpses)\n44: EAT_NEARBY_CORPSES = False\n45: # Weak/Fainting with nothing to eat and no safe prayer yet: wait on Elbereth instead of wandering (many\n46: # grind deaths came while fainted: rats, bats, ants; nearly everything on Dlvl 1 respects Elbereth).\n47: # OFF: calibrated against the frozen s13 on the same 60 games (jf14/jf16/jf25/jf26) the shelter +\n48: # starvation clock + 1400-turn Weak gap regime scored 0.207 vs s13's 0.251; with the three reverted\n49: # (the other fixes kept) 0.252. Sheltering stops the hunt/eat loop that keeps the grind fed.\n50: FAINT_SHELTER = False\n51: # Fainting prayers by the starvation clock instead of a fixed gap: eat.c kills at uhunger <\n52: # -(100 + 10 * Con) and uhunger drops at most 1 per turn once Fainting (almost not at all while\n53: # fainted), so death is at least 100 + 10 * Con turns after Fainting begins. Pray once the gap is\n54: # FAINT_PRAYER_GAP_LONG (= the Weak rule's gap), or STARVE_MARGIN turns before that deadline whatever\n55: # the gap (the fixed 1000-turn gap could starve a character whose last prayer was an HP one, and it\n56: # prays where rnz(350) still fails ~5.5% of the time; ~2.3% at 1200).\n57: STARVE_CLOCK = False\n58: # give up looking for the Mines entrance after this many turns and go on to Sokoban (0: never)\n59: MINES_SEARCH_TURNS = 3500\n60: # buy food in shops (never while carrying a digging tool) until carrying BUY_FOOD_UNTIL nutrition\n61: BUY_FOOD = True\n62: BUY_FOOD_UNTIL = 2400\n63: # give up an item for sale after 3 walks toward it failed (a shopkeeper in the path), for 2000 turns\n64: # ON (train 3.1): grind-food 43a08fa, replay-verified loop fix (base4-jf14 s6 paced 1500 turns at a shop)\n65: BUY_FOOD_GIVEUP = True\n66: # with at least FOOD_FIRST_MIN nutrition carried, eat instead of hunger-praying below FOOD_FIRST_GAP turns\n67: # (0: off). Off: the 20 games where it fired (mostly the grind, on found food) fell 5.11 -> 3.97 in total --\n68: # DT6A's reserve (eat only when no safe prayer) saves riskier Fainting prayers later.\n69: FOOD_FIRST_MIN = 0\n70: FOOD_FIRST_GAP = 1400\n71: # from this XL the grind detours to the Mines (level PICK_TRIP_LEVEL, PICK_TRIP_TURNS at most) for a dwarf's\n72: # pick-axe and keeps it (0: off)\n73: PICK_TRIP_XL = 0\n74: PICK_TRIP_LEVEL = 2\n75: PICK_TRIP_TURNS = 2500\n76: # a tool-less trip ends once the character reaches this XL (0: never): see _pick_trip_active\n77: PICK_TRIP_END_XL = 0\n78: # a tour headed for a shallower main-dungeon level (the grind, after a trip) explores for up staircases\n79: # only: after its trip, pt6-public seed 9 fell through a trap door to Dlvl 4, took that level's unexplored\n80: # '>' to Dlvl 5 and met soldier ants at XL 7 (the old rule takes any unexplored staircase, 50/50)\n81: UPWARD_RETURN = False\n82: # from this XL the Dlvl 1 grind moves to Dlvl GRIND_DEEP_LEVEL (0: never)\n83: GRIND_DEEP_XL = 0\n84: GRIND_DEEP_LEVEL = 3\n85: # no Excalibur dips while carrying a digging tool (a dip's silent curse welds the sword and locks the pick out)\n86: # ON (train 3, A027): no Excalibur dips while carrying a digging tool\n87: NO_DIP_WITH_TOOL = True\n88: # the grind's main-dungeon level by XL, {min XL: Dlvl} (empty: Dlvl 1 throughout; overrides GRIND_DEEP_*):\n89: # e.g. {5: 3, 7: 2} keeps the random-monster cap (depth + XL) / 2 at 4 from XL 5 (global_logic._grind_level)\n90: # train 3 (early-game A027): XL 5-6 grind on Dlvl 3, XL 7 on Dlvl 2 (cap 4): prayers 12.2 -> 7.2/game, grind losses 10 -> 5\n91: GRIND_LEVELS = {5: 3, 7: 2}\n92: # the tour skips to its next milestone after this many turns within 8 squares of one spot on one level\n93: # (0: never). Stalls held 12 of 90 games for 1500-14000 turns, fainting through hunger prayers.\n94: TOUR_STALL_TURNS = 1500\n95: FAINT_PRAYER_GAP_LONG = 1400\n96: STARVE_MARGIN = 60\n97: # Weak hunger prayers wait for this gap (DT6A/s13: 1200). Measured over ~2600 prayers, 900-1399-turn\n98: # gaps failed 3.5-5.4% of the time, 1400-1799 only 1.1% and 1800+ 0.6% -- but 1400 lost more games\n99: # to fainting than it saved from failed prayers (see FAINT_SHELTER).\n100: WEAK_PRAYER_GAP = 1200\n101: # corpses older than this (turns since the kill) are not eaten (AutoAscend: 50; tainting starts above 50)\n102: CORPSE_MAX_AGE = 30\n103: FAINT_ESTIMATE_MARGIN = 90\n104: # Gehennom (dive_logic.valley_step, valley_sneak, valley_retreat, gehennom_escape): walk the Valley of the Dead\n105: # to its '>' (fixed map in valley.py), digging through its three locked secret doors with the pick-axe; never\n106: # pray (pray.c: the god can't help there and may get angry) or rely on Elbereth (onscary: Inhell) in Gehennom;\n107: # the Valley's '<' only as the retreat to the castle's east edge (the castle mode rests and drops back through\n108: # the trap door behind the back door); a wand of digging zapped down as the escape; dig-dive below. Everything\n109: # keys on dnum == 1, which no game reached before the castle passage (msgs byte-identical on vs off).\n110: GEHENNOM_DIVE = True\n111: # Castle passage (castle_logic.py): on the castle level (the dig-dive's floor) walk to the west courtyard,\n112: # try every ring/potion that may be levitation (or freeze the moat with a cold ray), float round the moat\n113: # to the back door (56,08) and drop through the trap door behind it into the Valley (castle depth + 1).\n114: # Dying on the castle level costs nothing: the castle is as deep as a dig can go.\n115: # ON (train 3): fires only on the castle level, where the score is banked (A018 neutral); power/gehennom build on it\n116: CASTLE_PASSAGE = True\n117: # engulfed: wield the best melee weapon before fighting out (a dig-diver is swallowed with its pick-axe)\n118: ENGULF_WIELD = False\n119: # a Hungry (or worse) dive walks to fresh edible corpses within DIVE_EAT_RADIUS (BFS steps) and eats them\n120: DIVE_EAT = False\n121: DIVE_EAT_RADIUS = 8\n122: # LAST_RESORT: a known wand of digging is zapped down first (an escape that also banks a level)\n123: # ON (train 3): castle A018 guard neutral (+0.004); harness 8 of 10 escapes\n124: LAST_RESORT_DIG = True\n125: # fight2 on an Elbereth square: its -100 on every attack and its 'wait' bonus assume the engraving scares what is\n126: # next to us. With an @ (human/elf) or minotaur adjacent it doesn't: fight it (see combat/fight_heur.py\n127: # at_ignorer_adjacent; base4-jf16 s4 waited 5 turns in its dig pit while two Green-elves hit it 65 -> 12 HP)\n128: # ON (train 3.2, dive-safety A060): guard vs base5 neutral (0.4212 vs 0.4230, 38/45 identical); harness Big Room 34 -> 40/42, @ group 13 -> 14/14; base4+t31+base4arm: 18/135 games waited on Elbereth under @ attack, 15 died to that monster kind\n129: AT_ELBERETH_FIX = True\n130: # with AT_ELBERETH_FIX: melee priority bonus on the ignorer while an Elbereth could be (re)written here -- once it\n131: # is dead the engraving holds everything else off again and the dig resumes (0: no focus)\n132: AT_FOCUS = 10\n133: # with AT_ELBERETH_FIX: the dig out gives way to the fight for an ignorer this many steps away (1: adjacent only)\n134: AT_DIG_RADIUS = 2\n135: # LAST_RESORT: pray at critical HP beside a hostile once this many turns have passed since the last prayer\n136: # (0: off; the ordinary low-HP prayer waits 500)\n137: # ON (train 3): castle A038 guard neutral (-0.002); harness 2 Grey-elves at 12/72 HP deaths 9/10 -> 3/10\n138: DESPERATE_PRAYER_GAP = 250\n139: # LAST_RESORT: zap each unknown wand once (one still unknown after a zap at a monster is no attack wand)\n140: # ON (train 3): with DESPERATE_PRAYER_GAP (castle A038)\n141: LR_WAND_ONCE = True\n142: # --- power: what the character carries to the Castle (power.py) ---\n143: # Unidentified boots of the magic appearances (combat/jungle/hiking/mud/buckled/riding/snow) are 2/7 levitation\n144: # or water walking, the Castle's moat crossing. The bot never picked them up (get_best_armorset skips ambiguous\n145: # armour, and ItemPriority's unknown-status branch is dead: the parser maps UNKNOWN to UNCURSED); 26 of 90\n146: # base-* games walked over a pair. Keep them unworn for castle_logic; never wear levitation/fumble boots.\n147: KEEP_MAGIC_BOOTS = False\n148: # a known wand of wishing keeps rnd(3) - 1 charges after the engrave-test wish (51 of 3158 games got one):\n149: # zap them (power.wish_text: GDSM, then an amulet of life saving worn at once, then a ring of levitation for\n150: # the Castle, then speed boots). ON (coordinator, train 2): it fires only in wish games (~1%).\n151: SPARE_WISHES = True\n152: # a wished-for object is not formally identified (zap.c makewish: 'p - a granite ring'): name its appearance\n153: # after the wish (power.learn_wished). Without it SPARE_WISHES wished for an amulet of life saving again and\n154: # again and never wore one (base5-public s4, base5arm-jf16 s5), and castle_logic wished 3 rings of levitation,\n155: # never put one on and then zapped the empty wand until a minotaur came (pwc-dp10 jf14-s14)\n156: # ON (train 3.3, power B013): a wished-for object is recognised by its appearance (SPARE_WISHES never wore its amulet of life saving)\n157: WISH_LEARN = True\n158: # scrolls that may be scare monster are never dropped by arrange_items (a heavy armour swap dropped all light\n159: # loot and picked it up again: 250 of 3158 games turned one to dust), a scroll we dropped is never picked up\n160: # again, and a dust event names the scare monster label (power.scare_scrolls for castle/gehennom)\n161: SCARE_KEEP = False\n162: # while diving, ItemPriority keeps food and then the passage candidates (potions/rings that may be levitation,\n163: # ...) ahead of the thrown weapons: 23 of 90 base games dropped potion types for good, mostly for daggers\n164: # and the dive's pick-axe/mattock\n165: KEEP_POTIONS = False\n166: # inside a shop that buys them, drop each unknown potion/ring/candidate boots, read the shopkeeper's offer\n167: # (base/2, or 3/8 of it) and decline: the price group narrows levitation to 1 of 5 potions / 1 of 7 rings.\n168: # PROTOTYPE, keep off: in power-sell1-jf16 a ring's offer worked (100 -> the 200 zm group) but no potion\n169: # offer was captured, and one game (s13) looped with 4114 tracebacks before dying.\n170: SELL_PRICE_ID = False\n171: # --- power: the post-castle campaign (castle_power.py, hooks in castle_logic; inert before the castle) ---\n172: # on the castle's landing square: engrave-test unknown wands, drop every scroll that may be scare monster (the\n173: # minotaurs of the west maze killed 27 of 61 real kits, most before any item was tried), then try the\n174: # passage plan right there instead of after the walk to the courtyard\n175: # ON (train 3.3, power castle set)\n176: CASTLE_ARRIVAL_DRILL = True\n177: # polymorph forms that fly/swim/breathe water cross the moat (P 0.2 per random polymorph); a known wand of\n178: # polymorph is zapped at ourselves until one comes up; forms wait for their end at the door/trap door\n179: # ON (train 3.3, power castle set)\n180: CASTLE_POLY = True\n181: # on the castle's west side an Elbereth-ignorer (minotaur, @) within 2: drop every scroll that may be scare monster\n182: # and hold on the pile, striking what stays next to us (dive_logic.gehennom_scare's hold loop)\n183: # ON (train 3.3, power castle set; acts from depth 25 on the main line, same score in the inertness replay)\n184: CASTLE_SCARE = True\n185: # castle: rest before/while crossing one square in from the moat, never on the courtyard's moat edge\n186: # ON (train 3.3, power castle set)\n187: CASTLE_EDGE_REST = True\n188: # castle: go round by the south half when a sea monster was seen lately in the north half's west column (and\n189: # back out of a column whose next square a monster holds); the choice is made in the west courtyard only\n190: CASTLE_SEA_SWITCH = False\n191: CASTLE_SCARE_HOLD = 1500   # turns at most on the pile while an Elbereth-ignorer is about\n192: CASTLE_SCARE_DEPTH = 25    # from this depth on the main line (castle or the mazes right above it); a diggable\n193:                            # level is dug down from the pile (scared monsters don't interrupt a dig)\n194: # castle (castle_logic): dig straight east from the west maze into the courtyard instead of exploring for the\n195: # maze's single join (the maze walls outside the castle map are diggable)\n196: # ON (train 3.3, power): castle arrival kit suite 0/61 -> 3/61 crossings with the castle set; acts only on the castle level (score banked)\n197: CASTLE_WEST_DIG = True\n198: # castle: no retreat up the castle's '<' while the passage is on (it leads onto Medusa's level next to her\n199: # when she is castle-1: 2 of 61 real kits 'petrified by Medusa' in pwc-dp1)\n200: # ON (train 3.3, power castle set)\n201: CASTLE_NO_RETREAT = True\n202: # a hunger prayer from this gap (instead of FAINT_PRAYER_GAP / WEAK_PRAYER_GAP) when a hostile within\n203: # THREAT_RADIUS can reach us while Fainting, or while Weak with at most THREAT_WEAK_MARGIN nutrition left\n204: # (0: off). 9 of 10 Dlvl-1 deaths in the base runs were fainted next to ordinary monsters at gaps 950-1110.\n205: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0)\n206: THREAT_PRAYER_GAP = 1000\n207: THREAT_RADIUS = 5\n208: THREAT_WEAK_MARGIN = 15\n209: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 4)\n210: THREAT_MIN_DIFFICULTY = 99\n211: # the difficulty trigger only from this gap (0: THREAT_PRAYER_GAP)\n212: THREAT_DIFF_GAP = 0\n213: # this many walking hostiles within THREAT_RADIUS count as a threat (99: only difficulty / Elbereth-ignorers / HP)\n214: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 2)\n215: THREAT_MIN_COUNT = 99\n216: # ... or our HP below this fraction (a faint on a smudged Elbereth took a 90-HP XL7 to 49 in one faint)\n217: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0.5)\n218: THREAT_HP_FRAC = 0.75\n219: # ... or Fainting with no intact Elbereth under us and a walking hostile within THREAT_NE_RADIUS\n220: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\n221: THREAT_NO_ELBERETH = True\n222: THREAT_NE_RADIUS = 3\n223: THREAT_NE_MIN_DIFFICULTY = 3\n224: # find the kill square of our melee/thrown kills from the attack itself, and of pack kills from the corpse\n225: # glyph, when the glyph-disappearance test misses it (27% of kills: their corpses were never eaten)\n226: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\n227: CORPSE_TRACK = True\n228: # walk to fresh (<= CLAIM_MAX_AGE turns) edible corpses within CLAIM_DIST steps and eat them, before the pet\n229: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\n230: CLAIM_CORPSES = True\n231: CLAIM_DIST = 3\n232: CLAIM_MAX_AGE = 15\n233: # eat poisonous corpses (not only when Weak) at HP >= max(POISON_EATS_MIN_HP, 60%) during the tour\n234: POISON_EATS = False\n235: POISON_EATS_MIN_HP = 40\n236: # carry up to this many lichen/lizard corpses as a food reserve instead of eating them off the floor while not\n237: # Weak (0: off)\n238: LICHEN_RESERVE = 0\n239: # the Dlvl 1 grind ends (DIVE_XL) only fed: Not Hungry within DIVE_FED_GAP turns of the last hunger prayer, or\n240: # carrying >= DIVE_FED_FOOD nutrition; else it waits for the next hunger prayer (at most DIVE_FED_MAX_WAIT turns)\n241: DIVE_FED = False\n242: DIVE_FED_GAP = 500\n243: DIVE_FED_FOOD = 400\n244: DIVE_FED_MAX_WAIT = 2000\n245: # longer hunger-prayer gaps in the tour only (0: WEAK_PRAYER_GAP / FAINT_PRAYER_GAP): with FAINT_GUARD(_IDLE)\n246: # holding Elbereth through faints, rnz(350) fails 2.3% of prayers at a 1200 gap, 1.8% at 1400, 1.0% at 1700\n247: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0)\n248: TOUR_WEAK_PRAYER_GAP = 1700\n249: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0)\n250: TOUR_FAINT_PRAYER_GAP = 1600\n251: # per-XL tour gaps [[min_xl, weak_gap, faint_gap], ...] (the highest min_xl <= XL wins; overrides TOUR_*)\n252: TOUR_GAPS_BY_XL = []\n253: # the low-HP prayer only at pray.c's critically_low_hp (EXACT_PRAYER's HP rule without its turn-100 first prayer)\n254: LOWHP_EXACT = False\n255: # hunger-prayer gaps while diving at depth >= DIVE_GAP_MIN_DEPTH (0: WEAK_PRAYER_GAP / FAINT_PRAYER_GAP)\n256: DIVE_WEAK_PRAYER_GAP = 0\n257: DIVE_FAINT_PRAYER_GAP = 0\n258: DIVE_GAP_MIN_DEPTH = 5\n259: # the Weak and Fainting hunger-prayer gap while diving with a digging tool (0: the rules above); see\n260: # agent._dive_tool_hunger_gap\n261: # ON (train 3.3, dive-safety A061): first dive hunger cycle prays from gap 850; guard vs base6 +0.011 (flag fired in 4 games, +0.175, none worse); harness 13/14 vs 7/14\n262: DIVE_TOOL_HUNGER_GAP = 850\n263: # without STARVE_CLOCK: a Fainting prayer whatever the gap when the faint-length hunger estimate nears starvation\n264: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\n265: STARVE_DEADLINE = True\n266: # Fainting just after a paralysis ended ('You can move again'): pray from this gap (0: off)\n267: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0)\n268: STARVE_UNMEASURED_GAP = 1100\n269: # measure a faint from its own screen (not the last update), and not at all after an interrupted counted search\n270: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\n271: FAINT_MEASURE_FIX = True\n272: # log corpse bookkeeping (kills recorded, corpses we stand on and their known age); diagnostics only\n273: CORPSE_DEBUG = False\n274: \n275: # robustness (loops and stalls):\n276: # path() walks the BFS distances back obeying the BFS's own diagonal rule (a door entered diagonally was\n277: # retried 90 times in one jf26 game): only changes a path that would have failed\n278: PATH_DIAG_FIX = True\n279: # fight2 lets go of monsters it has faced this many turns without contact, a kill or damage (asleep, immobile,\n280: # out of reach), or after FIGHT_STALL_MOVES consecutive moves among <= 3 squares (the dance), for\n281: # FIGHT_IGNORE_TURNS or until they come adjacent / anything hurts us (0: off; < 0: log only)\n282: # ON (train 2) at 150 in the dive (the tour keeps FIGHT_STALL_TOUR_TURNS): robustness b2 guard 0.3480 vs 0.3479\n283: FIGHT_STALL_TURNS = 150\n284: FIGHT_STALL_MOVES = 30\n285: FIGHT_IGNORE_TURNS = 300\n286: # in the tour (the Dlvl 1 grind) only stalls this long are broken, and not by the dance trigger\n287: FIGHT_STALL_TOUR_TURNS = 400\n288: # the same in the Valley of the Dead only (GEHENNOM_DIVE; used while FIGHT_STALL_TURNS is 0)\n289: VALLEY_FIGHT_STALL_TURNS = 25\n290: # walking through known traps (AutoAscend's search relent, the dive's cut-off stairs, TRAP_LAST_RESORT) never\n291: # enters polymorph/fire/sleeping gas/magic/anti-magic/rust traps, nor trap doors/holes/level teleporters in the tour\n292: # ON (train 2): robustness b2 guard; +0.14 over the 2 games it fired in (b1)\n293: SAFE_TRAP_WALK = True\n294: # exploration with nothing left but searching, while unexplored ground lies beyond a known trap: walk through\n295: # (the safe kinds of) traps at once instead of after ~80 visits' worth of searching one square\n296: # ON (train 2): robustness b2 guard (dive only, after TRAP_RESORT_MIN_TURNS on the level)\n297: TRAP_LAST_RESORT = True\n298: TRAP_RESORT_MIN_TURNS = 1000   # ...once the dive has spent this long on the level\n299: # remember where molds/jellies/floating eyes/gas spores sit and keep the BFS off those squares while they are out of\n300: # sight (a mold on an item pile looks like the pile from afar: check_items looped on it for thousands of turns)\n301: SESSILE_MEMORY = True\n302: # go_to() re-plans to its real target after a path is blocked mid-way (its loop variables overwrote the target,\n303: # so the next round aimed at the blocked square: 'end point is no longer accessible' and a strategy restart)\n304: GOTO_TARGET_FIX = True\n305: # the panic-loop breaker closes a square for 100 turns, not for the rest of the game (the failing moves are\n306: # usually ours: a bear trap, a web; a permanent forbid boxed a Mines dive in for 5000+ turns)\n307: TEMP_FORBID = True\n308: # boxed in by diagonal squeezes while carrying > 600: drop to 550 for a while (a corridor bend held a grind 8000 turns)\n309: UNSQUEEZE = True\n310: UNSQUEEZE_TURNS = 30   # boxed in on one square this long first (the dive only)\n311: # after 3 failed use_container attempts on a floor container, leave that square's containers alone (a take-out\n312: # menu that never matched was retried 45,453 times in one game)\n313: # ON (train 2): the take-out loop (robustness B004) hit jf14 s0 in the train-2 smoke: 11399 panics and 317k steps; with the fix 152 and 36k\n314: CONTAINER_LOOP_FIX = True\n315: # climbing out of a branch (or on the tool quest), known trap doors and holes stay closed: the stairs-cut-off walk\n316: # stepped onto them again and again (base-jf26 s14 fell 42 times in 10k turns climbing out of Mines' End)\n317: CLIMB_NO_FALL = True\n318: # no fight2 moves while we are still in a pit (each try costs a turn and the attacker hits for free)\n319: PIT_AWARE_FIGHT = True\n320: # held by a bear trap: move-attempt diagonally (every diagonal attempt counts, 1 in 5 orthogonal ones: hack.c trapmove)\n321: BEARTRAP_ESCAPE = True\n322: # Lycanthropy (466 of 3158 dev games were infected; uncured Dlvl-1 lycanthropes died ~21% per 1000\n323: # turns): detect 'You dream that you feel feverish' and were changes, never eat our were family's corpses\n324: # (cannibalism: Luck -2..-5, the next prayer fails -- public s13, jf25 s10), treat a were form's HP as\n325: # a buffer (no HP prayers/last resort for it: jf16 s11 and jf25 s9 spent their hunger prayer on the\n326: # rat's HP and starved), and drop the load a rat can't carry so it can eat (public s4 starved Overloaded\n327: # with 5 food items)\n328: LYCAN_FIXES = True\n329: # no lycanthropy cure prayer while Hungry without food (wait for the Weak hunger prayer; see cure_disease)\n330: LYCAN_CURE_WAIT = False\n331: # were_unload drops a were form's load whenever Overtaxed or worse, not only when Weak with food to eat\n332: # t35: jf16 s6 0.602 -> 0.051 (a 9-HP were form dropped all 20 items on Dlvl 3 and never went back for them), jf14 s12\n333: # and arm-jf25 s0 -0.040 each -- off\n334: LYCAN_UNLOAD_ALWAYS = False\n335: # Weak/Fainting in the tour with no prayer due and a monster within FAINT_GUARD_RADIUS: hold on Elbereth\n336: # instead of fighting (dive_logic.faint_guard; fainted melee deaths were 8 of 18 Dlvl-1 grind deaths)\n337: FAINT_GUARD = True\n338: FAINT_GUARD_RADIUS = 4\n339: # with FAINT_GUARD: also hold on Elbereth with nothing in view, from FAINT_GUARD_IDLE_WEAK turns into Weak and\n340: # while Fainting, until the prayer is due (monsters arriving during a faint get no conscious turn to react to)\n341: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\n342: FAINT_GUARD_IDLE = True\n343: FAINT_GUARD_IDLE_WEAK = 30\n344: # the reactive guard also in the rescue dive after a failed prayer (no idle hold there: the dive must go on)\n345: FAINT_GUARD_RESCUE = False\n346: # one-action hold strategies (Elbereth rest, water demon vigil, faint shelter/guard) repeat while their own\n347: # condition holds, instead of letting one step of a lower strategy run between two hold actions\n348: # (dive_logic._hold_loop)\n349: # ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\n350: HOLD_LOOP = True\n351: # ... only after a failed prayer (the rescue dive): the tour's holds keep their old behaviour\n352: HOLD_LOOP_RESCUE = False\n353: # dev only (never set in the arena): the Nth tour hunger prayer is treated as failed, turning games into rescues\n354: SIM_RESCUE_PRAYER = 0\n355: # Water demon vigil fixes (dive_logic.water_demon_vigil): step off the fountain before engraving (the dip\n356: # leaves us on it: 'You can't write on the fountain!', so the vigil never held), hold while a demon is\n357: # within DEMON_VIGIL_RADIUS (not 2) for DEMON_VIGIL_TURNS. 74 of 975 dipping games released a demon, 22\n358: # of them died within 300 turns.\n359: DEMON_FIX = True\n360: DEMON_VIGIL_RADIUS = 5\n361: DEMON_VIGIL_TURNS = 400\n362: # fight2 never melees a floating eye we can see (the exploration stall breaker's attack-all mode did: 401\n363: # paralysis events in 223 dev games, 35 games died frozen)\n364: FEYE_FIX = False\n365: # no Excalibur dips during a water demon's vigil window (the bot went back to the fountain next to the demon)\n366: DEMON_NO_REDIP = False\n367: # the last resort (unknown wands/potions/scrolls) yields to the Elbereth rest while everything close respects\n368: # Elbereth and we are on one or can engrave (a zap erased it, a bounced ray / potion of sickness killed at 2-3 HP)\n369: LR_ELBERETH = False\n370: # the Elbereth rest never hides from a lone monster one blow kills (difficulty <= 2, not fast), at any HP\n371: REST_FIGHT_WEAK = False\n372: # never kill a gas spore whose blast reaches any @ (or anything in Minetown); its melee is filtered out of fight2\n373: SPORE_SAFE = False\n374: # a floating eye is hit blindfolded (blindfold/towel on, F-attack, off again), else by a throw, else as before\n375: # ON (train 3.4, grind-combat A063): blindfold/towel on before meleeing a floating eye (jf16 s12 replay: no freeze, no rock-mole death)\n376: FEYE_BLIND = True\n377: # a missile/wand/ray hit breaks the Elbereth holds (rest, faint guard/shelter, demon vigil) and fight2's\n378: # wait-on-Elbereth for RANGED_BREAK_TURNS turns: fight2 then closes in on a weak shooter or leaves its line\n379: # ON (train 3.4, A063): a hold breaks when shot/zapped from range; guard vs base7 45 amd64 0.446 vs 0.415, grind deaths 5 -> 1\n380: RANGED_ON_ELB = True\n381: RANGED_BREAK_TURNS = 8\n382: \n383: # the item split keeps the digging tool right after the melee weapon, before the armor set: it came after the\n384: # armor, so a heavy armor pickup could push it out -- base8-public s11 took a splint mail on Dlvl 3 and dropped its\n385: # pick-axe (and a food ration), the dive never knew the spot, camped tool-less in the Mines and died there (0.075;\n386: # its castle is at Dlvl 28)\n387: # ON (train 3.5): t35/t36 public s11 kept its pick at that drop step (0.075 -> 0.602 / 0.466), no other game changed by it\n388: TOOL_KEEP_FIRST = True\n389: # the faint guard (and its idle hold) also in a tool-less dive that is not a rescue -- the Mines camp waits\n390: # thousands of turns for a dwarf's pick like the grind waits for XP, but fainted unguarded among the Mines' hostiles:\n391: # base8 tool-less camps fainted 2-23 times, and all 6 died there (large dog, soldier ant, gargoyle, gray unicorn)\n392: # t35/t36: arm-jf25 s5 +0.187, but arm-jf16 s11 0.602 -> 0.126 (held Weak on Elbereth instead of eating and taking the\n393: # dwarf's pick base8 took) and it fired in a deep tool dive in were form (digging_tool() None) -- off\n394: CAMP_GUARD = False\n395: # a welded two-hander (a cursed dwarvish mattock the dive applied: 13% of dwarves' weapons are cursed) leaves no free\n396: # hand, so no Elbereth for the rest of the dive: base5-8 tool dives with a welded mattock scored 0.28-0.39 (4-5 per 90\n397: # games) vs 0.49-0.52 without. pray.c counts it as major trouble (TROUBLE_UNUSEABLE_HANDS: welded and !freehand())\n398: # and fix_worst_trouble uncurses the weapon, so the dive prays for it once WELD_PRAY_GAP turns have passed since the\n399: # last prayer (a major-trouble prayer fails when rnz(350) > gap + 200: 3.9% at 1100). The base8 welds came 806-2431\n400: # turns after the last prayer, all within 3 turns of the dive start\n401: # t36: uncursed the mattock in 3 of 4 welded games, but jf16 s8 0.602 -> 0.445 and s10 0.353 -> 0.206 (the spent prayer),\n402: # arm-jf14 s8 +0.015 -- off\n403: WELD_PRAY = False\n404: WELD_PRAY_GAP = 1100\n405: \n406: # Never dig or zap digging down on a staircase (rescue agent, 78a30e1; ported by hand for train 2): the square\n407: # under '@' is unknown on arrival, so _diggable_spot took the arrival '<' for floor, and a wand of digging\n408: # zapped there only says 'The beam bounces off the stairs' -- the dive zapped again until the wand was empty\n409: # (6 of 90 baseline games, up to 5 charges = 5 levels each; jf16/5, jf27/1).\n410: WAND_STAIRS_FIX = True\n411: \n412: # SHOP_GUARD (off, pick-hunt): BUY_FOOD picks up nothing for sale while we have teleportitis without teleport\n413: # control -- base4-jf14 s10 ate a leprechaun on its grind ('You feel very jumpy.'), picked up a food ration in a\n414: # Dlvl-3 shop and teleported out before paying it ('You escaped the shop without paying!'): Keystone Kops, then the\n415: # shopkeeper and his wand of striking killed the XL-8 dive; and the dive fetches no dwarf's pile in a shop.\n416: # ON (train 3.1): no shop pickups with uncontrolled teleportitis, no pile fetch in a shop (jf14 s10: teleported out unpaid, killed by the shopkeeper)\n417: SHOP_GUARD = True\n418: \n419: _raw = os.environ.get('JF_CFG')\n420: if _raw:\n421:     for _name, _value in json.loads(_raw).items():\n422:         if _name in globals() and not _name.startswith('_'):\n423:             globals()[_name] = _value\n424: \n425: # JSON object keys are strings\n426: GRIND_LEVELS = {int(_k): int(_v) for _k, _v in (GRIND_LEVELS or {}).items()}\n427: \n428: if TOUR_FIXES is not None:\n429:     EARLY_FIXES = LATE_FIXES = bool(TOUR_FIXES)\n430: if LATE_FIXES:\n431:     HAZARD_FIXES = True\n\n(End of file - total 431 lines)\n</content>","metadata":{"preview":"\"\"\"Feature switches for A/B experiments.\n\nDev runs may override them with JF_CFG='{\"TOUR_FIXES\": false, ...}'; the arena never sets\nJF_CFG, so submissions always run these defaults.\n\"\"\"\nimport json\nimport os\n\n# Fixes that change the levelling tour. Split by WHEN they first change a game:\n# LATE: only at a specific hazard (gas spore next to the pet, cockatrice corpse, passive-damage\n#   monster, deadly status, empty wand) -- the elite's early game is untouched until then.\n# EARLY: prayer at pray.c's critically_low_hp instead of 'HP < 12', eat carried food before a\n#   hunger prayer below XL 5 -- these reshuffle games from the first prayer on.\nEARLY_FIXES = False\nLATE_FIXES = True\n# the rarest-hazard subset of LATE_FIXES (gas spore next to the pet, cockatrice-family corpse\n# squares, spotted/ochre jelly and gelatinous cube melee): these first fire close to the deaths\n# they prevent, so they barely perturb the elite's public trajectories\nHAZARD_FIXES = False\n# master switch kept for older experiment configs: sets both","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/jf_config.py","text":"\"\"\"Feature switches for A/B experiments.\n\nDev runs may override them with JF_CFG='{\"TOUR_FIXES\": false, ...}'; the arena never sets\nJF_CFG, so submissions always run these defaults.\n\"\"\"\nimport json\nimport os\n\n# Fixes that change the levelling tour. Split by WHEN they first change a game:\n# LATE: only at a specific hazard (gas spore next to the pet, cockatrice corpse, passive-damage\n#   monster, deadly status, empty wand) -- the elite's early game is untouched until then.\n# EARLY: prayer at pray.c's critically_low_hp instead of 'HP < 12', eat carried food before a\n#   hunger prayer below XL 5 -- these reshuffle games from the first prayer on.\nEARLY_FIXES = False\nLATE_FIXES = True\n# the rarest-hazard subset of LATE_FIXES (gas spore next to the pet, cockatrice-family corpse\n# squares, spotted/ochre jelly and gelatinous cube melee): these first fire close to the deaths\n# they prevent, so they barely perturb the elite's public trajectories\nHAZARD_FIXES = False\n# master switch kept for older experiment configs: sets both\nTOUR_FIXES = None\n# Excalibur dips only at >= 90% HP with a prayer ready (astra); changes the tour\nSAFE_DIPS = False\n# when Weak or worse with HP > 40, poisonous/acidic corpses are acceptable food\nSTARVING_EATS = True\n# astra's survival layer (Elbereth rest, retreat upstairs) also during the levelling tour\nSURVIVAL_IN_TOUR = True\n# at critically low HP with no safe prayer and a hostile adjacent: stairs, unknown wands/potions/scrolls\nLAST_RESORT = True\n# Komershan's verified leader (0.2033 on hidden seeds): dwarves and gnomes skip Sokoban and walk the\n# peaceful Mines from Minetown straight to Mines' End (Dlvl 10-13: 0.126-0.26 banked early)\nSKIP_SOKOBAN = False\n# pray for HP only at pray.c's critically_low_hp (DT6A's 'HP < 12' prays with no trouble to fix: no\n# heal, and a failure if the timeout isn't 0), and allow the first prayer from turn 100 (the timeout\n# starts at 300; major trouble needs <= 200)\nEXACT_PRAYER = False\n# minimum turns since the last prayer for a hunger prayer while Fainting (DT6A: 400). Most first prayer\n# failures were Fainting prayers 900-1100 turns after the last one (rnz(350) timeout: ~6% fail there,\n# ~2% past 1100); a longer gap means fainting longer instead\nFAINT_PRAYER_GAP = 1100\n# AutoAscend's periodic 'eat corpses' preempt was meant to walk to edible corpses on the level, but\n# only_below_me defaults to True, so it only ever eats what lies underfoot; the kills' corpses beside\n# us go to the pet (it ate ~40% of the grind's corpses)\nEAT_NEARBY_CORPSES = False\n# Weak/Fainting with nothing to eat and no safe prayer yet: wait on Elbereth instead of wandering (many\n# grind deaths came while fainted: rats, bats, ants; nearly everything on Dlvl 1 respects Elbereth).\n# OFF: calibrated against the frozen s13 on the same 60 games (jf14/jf16/jf25/jf26) the shelter +\n# starvation clock + 1400-turn Weak gap regime scored 0.207 vs s13's 0.251; with the three reverted\n# (the other fixes kept) 0.252. Sheltering stops the hunt/eat loop that keeps the grind fed.\nFAINT_SHELTER = False\n# Fainting prayers by the starvation clock instead of a fixed gap: eat.c kills at uhunger <\n# -(100 + 10 * Con) and uhunger drops at most 1 per turn once Fainting (almost not at all while\n# fainted), so death is at least 100 + 10 * Con turns after Fainting begins. Pray once the gap is\n# FAINT_PRAYER_GAP_LONG (= the Weak rule's gap), or STARVE_MARGIN turns before that deadline whatever\n# the gap (the fixed 1000-turn gap could starve a character whose last prayer was an HP one, and it\n# prays where rnz(350) still fails ~5.5% of the time; ~2.3% at 1200).\nSTARVE_CLOCK = False\n# give up looking for the Mines entrance after this many turns and go on to Sokoban (0: never)\nMINES_SEARCH_TURNS = 3500\n# buy food in shops (never while carrying a digging tool) until carrying BUY_FOOD_UNTIL nutrition\nBUY_FOOD = True\nBUY_FOOD_UNTIL = 2400\n# give up an item for sale after 3 walks toward it failed (a shopkeeper in the path), for 2000 turns\n# ON (train 3.1): grind-food 43a08fa, replay-verified loop fix (base4-jf14 s6 paced 1500 turns at a shop)\nBUY_FOOD_GIVEUP = True\n# with at least FOOD_FIRST_MIN nutrition carried, eat instead of hunger-praying below FOOD_FIRST_GAP turns\n# (0: off). Off: the 20 games where it fired (mostly the grind, on found food) fell 5.11 -> 3.97 in total --\n# DT6A's reserve (eat only when no safe prayer) saves riskier Fainting prayers later.\nFOOD_FIRST_MIN = 0\nFOOD_FIRST_GAP = 1400\n# from this XL the grind detours to the Mines (level PICK_TRIP_LEVEL, PICK_TRIP_TURNS at most) for a dwarf's\n# pick-axe and keeps it (0: off)\nPICK_TRIP_XL = 0\nPICK_TRIP_LEVEL = 2\nPICK_TRIP_TURNS = 2500\n# a tool-less trip ends once the character reaches this XL (0: never): see _pick_trip_active\nPICK_TRIP_END_XL = 0\n# a tour headed for a shallower main-dungeon level (the grind, after a trip) explores for up staircases\n# only: after its trip, pt6-public seed 9 fell through a trap door to Dlvl 4, took that level's unexplored\n# '>' to Dlvl 5 and met soldier ants at XL 7 (the old rule takes any unexplored staircase, 50/50)\nUPWARD_RETURN = False\n# from this XL the Dlvl 1 grind moves to Dlvl GRIND_DEEP_LEVEL (0: never)\nGRIND_DEEP_XL = 0\nGRIND_DEEP_LEVEL = 3\n# no Excalibur dips while carrying a digging tool (a dip's silent curse welds the sword and locks the pick out)\n# ON (train 3, A027): no Excalibur dips while carrying a digging tool\nNO_DIP_WITH_TOOL = True\n# the grind's main-dungeon level by XL, {min XL: Dlvl} (empty: Dlvl 1 throughout; overrides GRIND_DEEP_*):\n# e.g. {5: 3, 7: 2} keeps the random-monster cap (depth + XL) / 2 at 4 from XL 5 (global_logic._grind_level)\n# train 3 (early-game A027): XL 5-6 grind on Dlvl 3, XL 7 on Dlvl 2 (cap 4): prayers 12.2 -> 7.2/game, grind losses 10 -> 5\nGRIND_LEVELS = {5: 3, 7: 2}\n# the tour skips to its next milestone after this many turns within 8 squares of one spot on one level\n# (0: never). Stalls held 12 of 90 games for 1500-14000 turns, fainting through hunger prayers.\nTOUR_STALL_TURNS = 1500\nFAINT_PRAYER_GAP_LONG = 1400\nSTARVE_MARGIN = 60\n# Weak hunger prayers wait for this gap (DT6A/s13: 1200). Measured over ~2600 prayers, 900-1399-turn\n# gaps failed 3.5-5.4% of the time, 1400-1799 only 1.1% and 1800+ 0.6% -- but 1400 lost more games\n# to fainting than it saved from failed prayers (see FAINT_SHELTER).\nWEAK_PRAYER_GAP = 1200\n# corpses older than this (turns since the kill) are not eaten (AutoAscend: 50; tainting starts above 50)\nCORPSE_MAX_AGE = 30\nFAINT_ESTIMATE_MARGIN = 90\n# Gehennom (dive_logic.valley_step, valley_sneak, valley_retreat, gehennom_escape): walk the Valley of the Dead\n# to its '>' (fixed map in valley.py), digging through its three locked secret doors with the pick-axe; never\n# pray (pray.c: the god can't help there and may get angry) or rely on Elbereth (onscary: Inhell) in Gehennom;\n# the Valley's '<' only as the retreat to the castle's east edge (the castle mode rests and drops back through\n# the trap door behind the back door); a wand of digging zapped down as the escape; dig-dive below. Everything\n# keys on dnum == 1, which no game reached before the castle passage (msgs byte-identical on vs off).\nGEHENNOM_DIVE = True\n# Castle passage (castle_logic.py): on the castle level (the dig-dive's floor) walk to the west courtyard,\n# try every ring/potion that may be levitation (or freeze the moat with a cold ray), float round the moat\n# to the back door (56,08) and drop through the trap door behind it into the Valley (castle depth + 1).\n# Dying on the castle level costs nothing: the castle is as deep as a dig can go.\n# ON (train 3): fires only on the castle level, where the score is banked (A018 neutral); power/gehennom build on it\nCASTLE_PASSAGE = True\n# engulfed: wield the best melee weapon before fighting out (a dig-diver is swallowed with its pick-axe)\nENGULF_WIELD = False\n# a Hungry (or worse) dive walks to fresh edible corpses within DIVE_EAT_RADIUS (BFS steps) and eats them\nDIVE_EAT = False\nDIVE_EAT_RADIUS = 8\n# LAST_RESORT: a known wand of digging is zapped down first (an escape that also banks a level)\n# ON (train 3): castle A018 guard neutral (+0.004); harness 8 of 10 escapes\nLAST_RESORT_DIG = True\n# fight2 on an Elbereth square: its -100 on every attack and its 'wait' bonus assume the engraving scares what is\n# next to us. With an @ (human/elf) or minotaur adjacent it doesn't: fight it (see combat/fight_heur.py\n# at_ignorer_adjacent; base4-jf16 s4 waited 5 turns in its dig pit while two Green-elves hit it 65 -> 12 HP)\n# ON (train 3.2, dive-safety A060): guard vs base5 neutral (0.4212 vs 0.4230, 38/45 identical); harness Big Room 34 -> 40/42, @ group 13 -> 14/14; base4+t31+base4arm: 18/135 games waited on Elbereth under @ attack, 15 died to that monster kind\nAT_ELBERETH_FIX = True\n# with AT_ELBERETH_FIX: melee priority bonus on the ignorer while an Elbereth could be (re)written here -- once it\n# is dead the engraving holds everything else off again and the dig resumes (0: no focus)\nAT_FOCUS = 10\n# with AT_ELBERETH_FIX: the dig out gives way to the fight for an ignorer this many steps away (1: adjacent only)\nAT_DIG_RADIUS = 2\n# LAST_RESORT: pray at critical HP beside a hostile once this many turns have passed since the last prayer\n# (0: off; the ordinary low-HP prayer waits 500)\n# ON (train 3): castle A038 guard neutral (-0.002); harness 2 Grey-elves at 12/72 HP deaths 9/10 -> 3/10\nDESPERATE_PRAYER_GAP = 250\n# LAST_RESORT: zap each unknown wand once (one still unknown after a zap at a monster is no attack wand)\n# ON (train 3): with DESPERATE_PRAYER_GAP (castle A038)\nLR_WAND_ONCE = True\n# --- power: what the character carries to the Castle (power.py) ---\n# Unidentified boots of the magic appearances (combat/jungle/hiking/mud/buckled/riding/snow) are 2/7 levitation\n# or water walking, the Castle's moat crossing. The bot never picked them up (get_best_armorset skips ambiguous\n# armour, and ItemPriority's unknown-status branch is dead: the parser maps UNKNOWN to UNCURSED); 26 of 90\n# base-* games walked over a pair. Keep them unworn for castle_logic; never wear levitation/fumble boots.\nKEEP_MAGIC_BOOTS = False\n# a known wand of wishing keeps rnd(3) - 1 charges after the engrave-test wish (51 of 3158 games got one):\n# zap them (power.wish_text: GDSM, then an amulet of life saving worn at once, then a ring of levitation for\n# the Castle, then speed boots). ON (coordinator, train 2): it fires only in wish games (~1%).\nSPARE_WISHES = True\n# a wished-for object is not formally identified (zap.c makewish: 'p - a granite ring'): name its appearance\n# after the wish (power.learn_wished). Without it SPARE_WISHES wished for an amulet of life saving again and\n# again and never wore one (base5-public s4, base5arm-jf16 s5), and castle_logic wished 3 rings of levitation,\n# never put one on and then zapped the empty wand until a minotaur came (pwc-dp10 jf14-s14)\n# ON (train 3.3, power B013): a wished-for object is recognised by its appearance (SPARE_WISHES never wore its amulet of life saving)\nWISH_LEARN = True\n# scrolls that may be scare monster are never dropped by arrange_items (a heavy armour swap dropped all light\n# loot and picked it up again: 250 of 3158 games turned one to dust), a scroll we dropped is never picked up\n# again, and a dust event names the scare monster label (power.scare_scrolls for castle/gehennom)\nSCARE_KEEP = False\n# while diving, ItemPriority keeps food and then the passage candidates (potions/rings that may be levitation,\n# ...) ahead of the thrown weapons: 23 of 90 base games dropped potion types for good, mostly for daggers\n# and the dive's pick-axe/mattock\nKEEP_POTIONS = False\n# inside a shop that buys them, drop each unknown potion/ring/candidate boots, read the shopkeeper's offer\n# (base/2, or 3/8 of it) and decline: the price group narrows levitation to 1 of 5 potions / 1 of 7 rings.\n# PROTOTYPE, keep off: in power-sell1-jf16 a ring's offer worked (100 -> the 200 zm group) but no potion\n# offer was captured, and one game (s13) looped with 4114 tracebacks before dying.\nSELL_PRICE_ID = False\n# --- power: the post-castle campaign (castle_power.py, hooks in castle_logic; inert before the castle) ---\n# on the castle's landing square: engrave-test unknown wands, drop every scroll that may be scare monster (the\n# minotaurs of the west maze killed 27 of 61 real kits, most before any item was tried), then try the\n# passage plan right there instead of after the walk to the courtyard\n# ON (train 3.3, power castle set)\nCASTLE_ARRIVAL_DRILL = True\n# polymorph forms that fly/swim/breathe water cross the moat (P 0.2 per random polymorph); a known wand of\n# polymorph is zapped at ourselves until one comes up; forms wait for their end at the door/trap door\n# ON (train 3.3, power castle set)\nCASTLE_POLY = True\n# on the castle's west side an Elbereth-ignorer (minotaur, @) within 2: drop every scroll that may be scare monster\n# and hold on the pile, striking what stays next to us (dive_logic.gehennom_scare's hold loop)\n# ON (train 3.3, power castle set; acts from depth 25 on the main line, same score in the inertness replay)\nCASTLE_SCARE = True\n# castle: rest before/while crossing one square in from the moat, never on the courtyard's moat edge\n# ON (train 3.3, power castle set)\nCASTLE_EDGE_REST = True\n# castle: go round by the south half when a sea monster was seen lately in the north half's west column (and\n# back out of a column whose next square a monster holds); the choice is made in the west courtyard only\nCASTLE_SEA_SWITCH = False\nCASTLE_SCARE_HOLD = 1500   # turns at most on the pile while an Elbereth-ignorer is about\nCASTLE_SCARE_DEPTH = 25    # from this depth on the main line (castle or the mazes right above it); a diggable\n                           # level is dug down from the pile (scared monsters don't interrupt a dig)\n# castle (castle_logic): dig straight east from the west maze into the courtyard instead of exploring for the\n# maze's single join (the maze walls outside the castle map are diggable)\n# ON (train 3.3, power): castle arrival kit suite 0/61 -> 3/61 crossings with the castle set; acts only on the castle level (score banked)\nCASTLE_WEST_DIG = True\n# castle: no retreat up the castle's '<' while the passage is on (it leads onto Medusa's level next to her\n# when she is castle-1: 2 of 61 real kits 'petrified by Medusa' in pwc-dp1)\n# ON (train 3.3, power castle set)\nCASTLE_NO_RETREAT = True\n# a hunger prayer from this gap (instead of FAINT_PRAYER_GAP / WEAK_PRAYER_GAP) when a hostile within\n# THREAT_RADIUS can reach us while Fainting, or while Weak with at most THREAT_WEAK_MARGIN nutrition left\n# (0: off). 9 of 10 Dlvl-1 deaths in the base runs were fainted next to ordinary monsters at gaps 950-1110.\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0)\nTHREAT_PRAYER_GAP = 1000\nTHREAT_RADIUS = 5\nTHREAT_WEAK_MARGIN = 15\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 4)\nTHREAT_MIN_DIFFICULTY = 99\n# the difficulty trigger only from this gap (0: THREAT_PRAYER_GAP)\nTHREAT_DIFF_GAP = 0\n# this many walking hostiles within THREAT_RADIUS count as a threat (99: only difficulty / Elbereth-ignorers / HP)\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 2)\nTHREAT_MIN_COUNT = 99\n# ... or our HP below this fraction (a faint on a smudged Elbereth took a 90-HP XL7 to 49 in one faint)\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0.5)\nTHREAT_HP_FRAC = 0.75\n# ... or Fainting with no intact Elbereth under us and a walking hostile within THREAT_NE_RADIUS\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\nTHREAT_NO_ELBERETH = True\nTHREAT_NE_RADIUS = 3\nTHREAT_NE_MIN_DIFFICULTY = 3\n# find the kill square of our melee/thrown kills from the attack itself, and of pack kills from the corpse\n# glyph, when the glyph-disappearance test misses it (27% of kills: their corpses were never eaten)\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\nCORPSE_TRACK = True\n# walk to fresh (<= CLAIM_MAX_AGE turns) edible corpses within CLAIM_DIST steps and eat them, before the pet\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\nCLAIM_CORPSES = True\nCLAIM_DIST = 3\nCLAIM_MAX_AGE = 15\n# eat poisonous corpses (not only when Weak) at HP >= max(POISON_EATS_MIN_HP, 60%) during the tour\nPOISON_EATS = False\nPOISON_EATS_MIN_HP = 40\n# carry up to this many lichen/lizard corpses as a food reserve instead of eating them off the floor while not\n# Weak (0: off)\nLICHEN_RESERVE = 0\n# the Dlvl 1 grind ends (DIVE_XL) only fed: Not Hungry within DIVE_FED_GAP turns of the last hunger prayer, or\n# carrying >= DIVE_FED_FOOD nutrition; else it waits for the next hunger prayer (at most DIVE_FED_MAX_WAIT turns)\nDIVE_FED = False\nDIVE_FED_GAP = 500\nDIVE_FED_FOOD = 400\nDIVE_FED_MAX_WAIT = 2000\n# longer hunger-prayer gaps in the tour only (0: WEAK_PRAYER_GAP / FAINT_PRAYER_GAP): with FAINT_GUARD(_IDLE)\n# holding Elbereth through faints, rnz(350) fails 2.3% of prayers at a 1200 gap, 1.8% at 1400, 1.0% at 1700\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0)\nTOUR_WEAK_PRAYER_GAP = 1700\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0)\nTOUR_FAINT_PRAYER_GAP = 1600\n# per-XL tour gaps [[min_xl, weak_gap, faint_gap], ...] (the highest min_xl <= XL wins; overrides TOUR_*)\nTOUR_GAPS_BY_XL = []\n# the low-HP prayer only at pray.c's critically_low_hp (EXACT_PRAYER's HP rule without its turn-100 first prayer)\nLOWHP_EXACT = False\n# hunger-prayer gaps while diving at depth >= DIVE_GAP_MIN_DEPTH (0: WEAK_PRAYER_GAP / FAINT_PRAYER_GAP)\nDIVE_WEAK_PRAYER_GAP = 0\nDIVE_FAINT_PRAYER_GAP = 0\nDIVE_GAP_MIN_DEPTH = 5\n# the Weak and Fainting hunger-prayer gap while diving with a digging tool (0: the rules above); see\n# agent._dive_tool_hunger_gap\n# ON (train 3.3, dive-safety A061): first dive hunger cycle prays from gap 850; guard vs base6 +0.011 (flag fired in 4 games, +0.175, none worse); harness 13/14 vs 7/14\nDIVE_TOOL_HUNGER_GAP = 850\n# without STARVE_CLOCK: a Fainting prayer whatever the gap when the faint-length hunger estimate nears starvation\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\nSTARVE_DEADLINE = True\n# Fainting just after a paralysis ended ('You can move again'): pray from this gap (0: off)\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: 0)\nSTARVE_UNMEASURED_GAP = 1100\n# measure a faint from its own screen (not the last update), and not at all after an interrupted counted search\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\nFAINT_MEASURE_FIX = True\n# log corpse bookkeeping (kills recorded, corpses we stand on and their known age); diagnostics only\nCORPSE_DEBUG = False\n\n# robustness (loops and stalls):\n# path() walks the BFS distances back obeying the BFS's own diagonal rule (a door entered diagonally was\n# retried 90 times in one jf26 game): only changes a path that would have failed\nPATH_DIAG_FIX = True\n# fight2 lets go of monsters it has faced this many turns without contact, a kill or damage (asleep, immobile,\n# out of reach), or after FIGHT_STALL_MOVES consecutive moves among <= 3 squares (the dance), for\n# FIGHT_IGNORE_TURNS or until they come adjacent / anything hurts us (0: off; < 0: log only)\n# ON (train 2) at 150 in the dive (the tour keeps FIGHT_STALL_TOUR_TURNS): robustness b2 guard 0.3480 vs 0.3479\nFIGHT_STALL_TURNS = 150\nFIGHT_STALL_MOVES = 30\nFIGHT_IGNORE_TURNS = 300\n# in the tour (the Dlvl 1 grind) only stalls this long are broken, and not by the dance trigger\nFIGHT_STALL_TOUR_TURNS = 400\n# the same in the Valley of the Dead only (GEHENNOM_DIVE; used while FIGHT_STALL_TURNS is 0)\nVALLEY_FIGHT_STALL_TURNS = 25\n# walking through known traps (AutoAscend's search relent, the dive's cut-off stairs, TRAP_LAST_RESORT) never\n# enters polymorph/fire/sleeping gas/magic/anti-magic/rust traps, nor trap doors/holes/level teleporters in the tour\n# ON (train 2): robustness b2 guard; +0.14 over the 2 games it fired in (b1)\nSAFE_TRAP_WALK = True\n# exploration with nothing left but searching, while unexplored ground lies beyond a known trap: walk through\n# (the safe kinds of) traps at once instead of after ~80 visits' worth of searching one square\n# ON (train 2): robustness b2 guard (dive only, after TRAP_RESORT_MIN_TURNS on the level)\nTRAP_LAST_RESORT = True\nTRAP_RESORT_MIN_TURNS = 1000   # ...once the dive has spent this long on the level\n# remember where molds/jellies/floating eyes/gas spores sit and keep the BFS off those squares while they are out of\n# sight (a mold on an item pile looks like the pile from afar: check_items looped on it for thousands of turns)\nSESSILE_MEMORY = True\n# go_to() re-plans to its real target after a path is blocked mid-way (its loop variables overwrote the target,\n# so the next round aimed at the blocked square: 'end point is no longer accessible' and a strategy restart)\nGOTO_TARGET_FIX = True\n# the panic-loop breaker closes a square for 100 turns, not for the rest of the game (the failing moves are\n# usually ours: a bear trap, a web; a permanent forbid boxed a Mines dive in for 5000+ turns)\nTEMP_FORBID = True\n# boxed in by diagonal squeezes while carrying > 600: drop to 550 for a while (a corridor bend held a grind 8000 turns)\nUNSQUEEZE = True\nUNSQUEEZE_TURNS = 30   # boxed in on one square this long first (the dive only)\n# after 3 failed use_container attempts on a floor container, leave that square's containers alone (a take-out\n# menu that never matched was retried 45,453 times in one game)\n# ON (train 2): the take-out loop (robustness B004) hit jf14 s0 in the train-2 smoke: 11399 panics and 317k steps; with the fix 152 and 36k\nCONTAINER_LOOP_FIX = True\n# climbing out of a branch (or on the tool quest), known trap doors and holes stay closed: the stairs-cut-off walk\n# stepped onto them again and again (base-jf26 s14 fell 42 times in 10k turns climbing out of Mines' End)\nCLIMB_NO_FALL = True\n# no fight2 moves while we are still in a pit (each try costs a turn and the attacker hits for free)\nPIT_AWARE_FIGHT = True\n# held by a bear trap: move-attempt diagonally (every diagonal attempt counts, 1 in 5 orthogonal ones: hack.c trapmove)\nBEARTRAP_ESCAPE = True\n# Lycanthropy (466 of 3158 dev games were infected; uncured Dlvl-1 lycanthropes died ~21% per 1000\n# turns): detect 'You dream that you feel feverish' and were changes, never eat our were family's corpses\n# (cannibalism: Luck -2..-5, the next prayer fails -- public s13, jf25 s10), treat a were form's HP as\n# a buffer (no HP prayers/last resort for it: jf16 s11 and jf25 s9 spent their hunger prayer on the\n# rat's HP and starved), and drop the load a rat can't carry so it can eat (public s4 starved Overloaded\n# with 5 food items)\nLYCAN_FIXES = True\n# no lycanthropy cure prayer while Hungry without food (wait for the Weak hunger prayer; see cure_disease)\nLYCAN_CURE_WAIT = False\n# were_unload drops a were form's load whenever Overtaxed or worse, not only when Weak with food to eat\n# t35: jf16 s6 0.602 -> 0.051 (a 9-HP were form dropped all 20 items on Dlvl 3 and never went back for them), jf14 s12\n# and arm-jf25 s0 -0.040 each -- off\nLYCAN_UNLOAD_ALWAYS = False\n# Weak/Fainting in the tour with no prayer due and a monster within FAINT_GUARD_RADIUS: hold on Elbereth\n# instead of fighting (dive_logic.faint_guard; fainted melee deaths were 8 of 18 Dlvl-1 grind deaths)\nFAINT_GUARD = True\nFAINT_GUARD_RADIUS = 4\n# with FAINT_GUARD: also hold on Elbereth with nothing in view, from FAINT_GUARD_IDLE_WEAK turns into Weak and\n# while Fainting, until the prayer is due (monsters arriving during a faint get no conscious turn to react to)\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\nFAINT_GUARD_IDLE = True\nFAINT_GUARD_IDLE_WEAK = 30\n# the reactive guard also in the rescue dive after a failed prayer (no idle hold there: the dive must go on)\nFAINT_GUARD_RESCUE = False\n# one-action hold strategies (Elbereth rest, water demon vigil, faint shelter/guard) repeat while their own\n# condition holds, instead of letting one step of a lower strategy run between two hold actions\n# (dive_logic._hold_loop)\n# ON (train 3.2, grind-food A047/A058/t32): 90 games 0.4025 vs 0.3964; in-lane losses 6 vs 10, failed prayers 3 vs 7 (was: False)\nHOLD_LOOP = True\n# ... only after a failed prayer (the rescue dive): the tour's holds keep their old behaviour\nHOLD_LOOP_RESCUE = False\n# dev only (never set in the arena): the Nth tour hunger prayer is treated as failed, turning games into rescues\nSIM_RESCUE_PRAYER = 0\n# Water demon vigil fixes (dive_logic.water_demon_vigil): step off the fountain before engraving (the dip\n# leaves us on it: 'You can't write on the fountain!', so the vigil never held), hold while a demon is\n# within DEMON_VIGIL_RADIUS (not 2) for DEMON_VIGIL_TURNS. 74 of 975 dipping games released a demon, 22\n# of them died within 300 turns.\nDEMON_FIX = True\nDEMON_VIGIL_RADIUS = 5\nDEMON_VIGIL_TURNS = 400\n# fight2 never melees a floating eye we can see (the exploration stall breaker's attack-all mode did: 401\n# paralysis events in 223 dev games, 35 games died frozen)\nFEYE_FIX = False\n# no Excalibur dips during a water demon's vigil window (the bot went back to the fountain next to the demon)\nDEMON_NO_REDIP = False\n# the last resort (unknown wands/potions/scrolls) yields to the Elbereth rest while everything close respects\n# Elbereth and we are on one or can engrave (a zap erased it, a bounced ray / potion of sickness killed at 2-3 HP)\nLR_ELBERETH = False\n# the Elbereth rest never hides from a lone monster one blow kills (difficulty <= 2, not fast), at any HP\nREST_FIGHT_WEAK = False\n# never kill a gas spore whose blast reaches any @ (or anything in Minetown); its melee is filtered out of fight2\nSPORE_SAFE = False\n# a floating eye is hit blindfolded (blindfold/towel on, F-attack, off again), else by a throw, else as before\n# ON (train 3.4, grind-combat A063): blindfold/towel on before meleeing a floating eye (jf16 s12 replay: no freeze, no rock-mole death)\nFEYE_BLIND = True\n# a missile/wand/ray hit breaks the Elbereth holds (rest, faint guard/shelter, demon vigil) and fight2's\n# wait-on-Elbereth for RANGED_BREAK_TURNS turns: fight2 then closes in on a weak shooter or leaves its line\n# ON (train 3.4, A063): a hold breaks when shot/zapped from range; guard vs base7 45 amd64 0.446 vs 0.415, grind deaths 5 -> 1\nRANGED_ON_ELB = True\nRANGED_BREAK_TURNS = 8\n\n# the item split keeps the digging tool right after the melee weapon, before the armor set: it came after the\n# armor, so a heavy armor pickup could push it out -- base8-public s11 took a splint mail on Dlvl 3 and dropped its\n# pick-axe (and a food ration), the dive never knew the spot, camped tool-less in the Mines and died there (0.075;\n# its castle is at Dlvl 28)\n# ON (train 3.5): t35/t36 public s11 kept its pick at that drop step (0.075 -> 0.602 / 0.466), no other game changed by it\nTOOL_KEEP_FIRST = True\n# the faint guard (and its idle hold) also in a tool-less dive that is not a rescue -- the Mines camp waits\n# thousands of turns for a dwarf's pick like the grind waits for XP, but fainted unguarded among the Mines' hostiles:\n# base8 tool-less camps fainted 2-23 times, and all 6 died there (large dog, soldier ant, gargoyle, gray unicorn)\n# t35/t36: arm-jf25 s5 +0.187, but arm-jf16 s11 0.602 -> 0.126 (held Weak on Elbereth instead of eating and taking the\n# dwarf's pick base8 took) and it fired in a deep tool dive in were form (digging_tool() None) -- off\nCAMP_GUARD = False\n# a welded two-hander (a cursed dwarvish mattock the dive applied: 13% of dwarves' weapons are cursed) leaves no free\n# hand, so no Elbereth for the rest of the dive: base5-8 tool dives with a welded mattock scored 0.28-0.39 (4-5 per 90\n# games) vs 0.49-0.52 without. pray.c counts it as major trouble (TROUBLE_UNUSEABLE_HANDS: welded and !freehand())\n# and fix_worst_trouble uncurses the weapon, so the dive prays for it once WELD_PRAY_GAP turns have passed since the\n# last prayer (a major-trouble prayer fails when rnz(350) > gap + 200: 3.9% at 1100). The base8 welds came 806-2431\n# turns after the last prayer, all within 3 turns of the dive start\n# t36: uncursed the mattock in 3 of 4 welded games, but jf16 s8 0.602 -> 0.445 and s10 0.353 -> 0.206 (the spent prayer),\n# arm-jf14 s8 +0.015 -- off\nWELD_PRAY = False\nWELD_PRAY_GAP = 1100\n\n# Never dig or zap digging down on a staircase (rescue agent, 78a30e1; ported by hand for train 2): the square\n# under '@' is unknown on arrival, so _diggable_spot took the arrival '<' for floor, and a wand of digging\n# zapped there only says 'The beam bounces off the stairs' -- the dive zapped again until the wand was empty\n# (6 of 90 baseline games, up to 5 charges = 5 levels each; jf16/5, jf27/1).\nWAND_STAIRS_FIX = True\n\n# SHOP_GUARD (off, pick-hunt): BUY_FOOD picks up nothing for sale while we have teleportitis without teleport\n# control -- base4-jf14 s10 ate a leprechaun on its grind ('You feel very jumpy.'), picked up a food ration in a\n# Dlvl-3 shop and teleported out before paying it ('You escaped the shop without paying!'): Keystone Kops, then the\n# shopkeeper and his wand of striking killed the XL-8 dive; and the dive fetches no dwarf's pile in a shop.\n# ON (train 3.1): no shop pickups with uncontrolled teleportitis, no pile fetch in a shop (jf14 s10: teleported out unpaid, killed by the shopkeeper)\nSHOP_GUARD = True\n\n_raw = os.environ.get('JF_CFG')\nif _raw:\n    for _name, _value in json.loads(_raw).items():\n        if _name in globals() and not _name.startswith('_'):\n            globals()[_name] = _value\n\n# JSON object keys are strings\nGRIND_LEVELS = {int(_k): int(_v) for _k, _v in (GRIND_LEVELS or {}).items()}\n\nif TOUR_FIXES is not None:\n    EARLY_FIXES = LATE_FIXES = bool(TOUR_FIXES)\nif LATE_FIXES:\n    HAZARD_FIXES = True","lineStart":1,"lineEnd":431,"totalLines":431,"truncated":false}},"title":"autoascend/jf_config.py","time":{"start":1790531890420,"end":1790531890429}},"id":"prt_0e4046ced001H9v4Vb6SUM1vN0","sessionID":"ses_f1bfdb0f7ffeZlkE5FkbKms7fE","messageID":"msg_0e4044568001of6zIWsONbGyDv"}}
