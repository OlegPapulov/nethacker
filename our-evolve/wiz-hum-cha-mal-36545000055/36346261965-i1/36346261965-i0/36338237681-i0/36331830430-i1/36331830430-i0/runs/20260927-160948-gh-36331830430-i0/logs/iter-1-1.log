so read them from the blstats condition bitmask instead.\n69:     def _condition(self, mask):\n70:         return bool(self.agent.last_observation['blstats'][nh.NLE_BL_CONDITION] & mask)\n71: \n72:     @property\n73:     def confusion(self):\n74:         return self._condition(nh.BL_MASK_CONF)\n75: \n76:     @property\n77:     def stun(self):\n78:         return self._condition(nh.BL_MASK_STUN)\n79: \n80:     @property\n81:     def hallu(self):\n82:         return self._condition(nh.BL_MASK_HALLU)\n83: \n84:     @property\n85:     def blind(self):\n86:         return self._condition(nh.BL_MASK_BLIND)\n87: \n88:     @property\n89:     def polymorph(self):\n90:         if not nh.glyph_is_monster(self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]):\n91:             return False\n92:         return self.agent.character.self_glyph != self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n93: \n94: \n95: class Character:\n96:     UNKNOWN = -1  # for everything, e.g. alignment\n97: \n98:     ARCHEOLOGIST = 0\n99:     BARBARIAN = 1\n100:     CAVEMAN = 2\n101:     HEALER = 3\n102:     KNIGHT = 4\n103:     MONK = 5\n104:     PRIEST = 6\n105:     RANGER = 7\n106:     ROGUE = 8\n107:     SAMURAI = 9\n108:     TOURIST = 10\n109:     VALKYRIE = 11\n110:     WIZARD = 12\n111: \n112:     name_to_role = {\n113:         'Archeologist': ARCHEOLOGIST,\n114:         'Barbarian': BARBARIAN,\n115:         'Caveman': CAVEMAN,\n116:         'Cavewoman': CAVEMAN,\n117:         'Healer': HEALER,\n118:         'Knight': KNIGHT,\n119:         'Monk': MONK,\n120:         'Priest': PRIEST,\n121:         'Priestess': PRIEST,\n122:         'Ranger': RANGER,\n123:         'Rogue': ROGUE,\n124:         'Samurai': SAMURAI,\n125:         'Tourist': TOURIST,\n126:         'Valkyrie': VALKYRIE,\n127:         'Wizard': WIZARD,\n128:     }\n129: \n130:     CHAOTIC = 0\n131:     NEUTRAL = 1\n132:     LAWFUL = 2\n133:     UNALIGNED = 3\n134: \n135:     name_to_alignment = {\n136:         'chaotic': CHAOTIC,\n137:         'neutral': NEUTRAL,\n138:         'lawful': LAWFUL,\n139:         'unaligned': UNALIGNED,\n140:     }\n141: \n142:     HUMAN = 0\n143:     DWARF = 1\n144:     ELF = 2\n145:     GNOME = 3\n146:     ORC = 4\n147: \n148:     name_to_race = {\n149:         'human': HUMAN,\n150:         'dwarf': DWARF,\n151:         'dwarven': DWARF,\n152:         'elf': ELF,\n153:         'elven': ELF,\n154:         'gnome': GNOME,\n155:         'gnomish': GNOME,\n156:         'orc': ORC,\n157:         'orcish': ORC,\n158:     }\n159: \n160:     MALE = 0\n161:     FEMALE = 1\n162: \n163:     name_to_gender = {\n164:         'male': MALE,\n165:         'female': FEMALE,\n166:     }\n167: \n168:     name_to_skill_type = {\n169:         # \"\": O.P_NONE,\n170:         \"dagger\": O.P_DAGGER,\n171:         \"knife\": O.P_KNIFE,\n172:         \"axe\": O.P_AXE,\n173:         \"pick-axe\": O.P_PICK_AXE,\n174:         \"short sword\": O.P_SHORT_SWORD,\n175:         \"broadsword\": O.P_BROAD_SWORD,\n176:         \"long sword\": O.P_LONG_SWORD,\n177:         \"two-handed sword\": O.P_TWO_HANDED_SWORD,\n178:         \"scimitar\": O.P_SCIMITAR,\n179:         \"saber\": O.P_SABER,\n180:         \"club\": O.P_CLUB,\n181:         \"mace\": O.P_MACE,\n182:         \"morning star\": O.P_MORNING_STAR,\n183:         \"flail\": O.P_FLAIL,\n184:         \"hammer\": O.P_HAMMER,\n185:         \"quarterstaff\": O.P_QUARTERSTAFF,\n186:         \"polearms\": O.P_POLEARMS,\n187:         \"spear\": O.P_SPEAR,\n188:         \"trident\": O.P_TRIDENT,\n189:         \"lance\": O.P_LANCE,\n190:         \"bow\": O.P_BOW,\n191:         \"sling\": O.P_SLING,\n192:         \"crossbow\": O.P_CROSSBOW,\n193:         \"dart\": O.P_DART,\n194:         \"shuriken\": O.P_SHURIKEN,\n195:         \"boomerang\": O.P_BOOMERANG,\n196:         \"whip\": O.P_WHIP,\n197:         \"unicorn horn\": O.P_UNICORN_HORN,\n198: \n199:         \"attack spells\": O.P_ATTACK_SPELL,\n200:         \"healing spells\": O.P_HEALING_SPELL,\n201:         \"divination spells\": O.P_DIVINATION_SPELL,\n202:         \"enchantment spells\": O.P_ENCHANTMENT_SPELL,\n203:         \"clerical spells\": O.P_CLERIC_SPELL,\n204:         \"escape spells\": O.P_ESCAPE_SPELL,\n205:         \"matter spells\": O.P_MATTER_SPELL,\n206: \n207:         \"bare handed combat\": O.P_BARE_HANDED_COMBAT,\n208:         \"martial arts\": O.P_BARE_HANDED_COMBAT,\n209:         \"two weapon combat\": O.P_TWO_WEAPON_COMBAT,\n210:         \"riding\": O.P_RIDING,\n211:     }\n212: \n213:     possible_skill_types = ['Fighting Skills', 'Weapon Skills', 'Spellcasting Skills']\n214:     possible_skill_levels = ['Unskilled', 'Basic', 'Skilled', 'Expert', 'Master', 'Grand Master']\n215: \n216:     SKILL_LEVEL_RESTRICTED = 0\n217:     SKILL_LEVEL_UNSKILLED = 1\n218:     SKILL_LEVEL_BASIC = 2\n219:     SKILL_LEVEL_SKILLED = 3\n220:     SKILL_LEVEL_EXPERT = 4\n221:     SKILL_LEVEL_MASTER = 5\n222:     SKILL_LEVEL_GRAND_MASTER = 6\n223: \n224:     weapon_bonus = {\n225:         SKILL_LEVEL_RESTRICTED: (-4, 2),\n226:         SKILL_LEVEL_UNSKILLED: (-4, 2),\n227:         SKILL_LEVEL_BASIC: (0, 0),\n228:         SKILL_LEVEL_SKILLED: (2, 1),\n229:         SKILL_LEVEL_EXPERT: (3, 2),\n230:     }\n231:     two_weapon_bonus = {\n232:         SKILL_LEVEL_RESTRICTED: (-9, -3),\n233:         SKILL_LEVEL_UNSKILLED: (-9, -3),\n234:         SKILL_LEVEL_BASIC: (-7, -1),\n235:         SKILL_LEVEL_SKILLED: (-5, 0),\n236:         SKILL_LEVEL_EXPERT: (-3, 1),\n237:     }\n238:     riding_bonus = {\n239:         SKILL_LEVEL_RESTRICTED: (-2, 0),\n240:         SKILL_LEVEL_UNSKILLED: (-2, 0),\n241:         SKILL_LEVEL_BASIC: (-1, 0),\n242:         SKILL_LEVEL_SKILLED: (0, 1),\n243:         SKILL_LEVEL_EXPERT: (0, 2),\n244:     }\n245:     unarmed_bonus = {\n246:         SKILL_LEVEL_RESTRICTED: (1, 0),\n247:         SKILL_LEVEL_UNSKILLED: (1, 0),\n248:         SKILL_LEVEL_BASIC: (1, 1),\n249:         SKILL_LEVEL_SKILLED: (2, 1),\n250:         SKILL_LEVEL_EXPERT: (2, 2),\n251:         SKILL_LEVEL_MASTER: (3, 2),\n252:         SKILL_LEVEL_GRAND_MASTER: (3, 3),\n253:     }\n254:     martial_bonus = {\n255:         SKILL_LEVEL_RESTRICTED: (1, 0),  # no one has it restricted\n256:         SKILL_LEVEL_UNSKILLED: (2, 1),\n257:         SKILL_LEVEL_BASIC: (3, 3),\n258:         SKILL_LEVEL_SKILLED: (4, 4),\n259:         SKILL_LEVEL_EXPERT: (5, 6),\n260:         SKILL_LEVEL_MASTER: (6, 7),\n261:         SKILL_LEVEL_GRAND_MASTER: (7, 9),\n262:     }\n263: \n264:     name_to_skill_level = {k: v for k, v in zip(['Restricted'] + possible_skill_levels,\n265:                                                 [SKILL_LEVEL_RESTRICTED,\n266:                                                  SKILL_LEVEL_UNSKILLED, SKILL_LEVEL_BASIC, SKILL_LEVEL_SKILLED,\n267:                                                  SKILL_LEVEL_EXPERT,\n268:                                                  SKILL_LEVEL_MASTER, SKILL_LEVEL_GRAND_MASTER])}\n269: \n270:     def __init__(self, agent):\n271:         self.agent = agent\n272:         self.prop = Property(agent)\n273:         self.role = None\n274:         self.alignment = None\n275:         self.race = None\n276:         self.gender = None\n277:         self.self_glyph = None\n278:         self.skill_levels = np.zeros(max(self.name_to_skill_type.values()) + 1, dtype=int)\n279:         self.upgradable_skills = dict()\n280: \n281:         self.is_lycanthrope = False\n282: \n283:         # populated lazily by parse_spellcast_view once the Healer reaches the deep-dive phase\n284:         self.known_spells = dict()\n285:         self.spell_fail_chance = dict()\n286: \n287:     def update(self):\n288:         if 'You feel feverish.' in self.agent.message:\n289:             self.is_lycanthrope = True\n290:         if 'You feel purified.' in self.agent.message:\n291:             self.is_lycanthrope = False\n292: \n293:     @property\n294:     def carrying_capacity(self):\n295:         # TODO: levitation, etc\n296:         return min(1000, (self.agent.blstats.strength_percentage + self.agent.blstats.constitution) * 25 + 50)\n297: \n298:     def parse(self):\n299:         with self.agent.atom_operation():\n300:             self.agent.step(A.Command.ATTRIBUTES)\n301:             text = ' '.join(self.agent.popup)\n302:             self._parse(text)\n303:             self.self_glyph = self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n304: \n305:     def _parse(self, text):\n306:         matches = re.findall('You are a ([a-z]+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+).', text)\n307:         if len(matches) == 1:\n308:             alignment, _, gender, race, role = matches[0]\n309:         else:\n310:             matches = re.findall(\n311:                 'You are an? ([a-zA-Z ]+), a level (\\d+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+). *You are ([a-z]+)',\n312:                 text)\n313:             assert len(matches) == 1, repr(text)\n314:             _, _, _, gender, race, role, alignment = matches[0]\n315: \n316:         if not gender:\n317:             if role == 'Priestess':\n318:                 gender = 'female'\n319:             elif role == 'Priest':\n320:                 gender = 'male'\n321:             elif role == 'Caveman':\n322:                 gender = 'male'\n323:             elif role == 'Cavewoman':\n324:                 gender = 'female'\n325:             elif role == 'Valkyrie':\n326:                 gender = 'female'\n327:             else:\n328:                 assert 0, repr(text)\n329: \n330:         self.role = self.name_to_role[role]\n331:         self.alignment = self.name_to_alignment[alignment]\n332:         self.race = self.name_to_race[race]\n333:         self.gender = self.name_to_gender[gender]\n334: \n335:     def parse_spellcast_view(self):\n336:         self.known_spells = dict()\n337:         self.spell_fail_chance = dict()\n338: \n339:         # TODO: parse for other spellcaster classes\n340:         if self.role not in (self.HEALER, self.WIZARD, self.MONK):\n341:             return\n342: \n343:         with self.agent.atom_operation():\n344:             self.agent.step(A.Command.CAST)\n345:             if not self.agent.popup:\n346:                 self.known_spells[self.agent.message] = None\n347:                 return\n348:             if self.agent.popup[0] not in ('Choose which spell to cast') or \\\n349:                     not self.agent.popup[1].startswith('Name'):\n350:                 raise ValueError(f'Invalid cast popup text format: {self.agent.popup}')\n351:             for line in self.agent.popup[2:]:\n352:                 matches = re.findall(r'^([a-zA-Z]) - *' +\n353:                                      r'(' + '|'.join(ALL_SPELL_NAMES) + ') *' +\n354:                                      r'([0-9]*) *' +\n355:                                      r'(' + '|'.join(ALL_SPELL_CATEGORIES) + ') *' +\n356:                                      r'([0-9]*)\\% *' +\n357:                                      r'([0-9]*\\%|\\(gone\\))', line)\n358:                 assert len(matches) == 1, (matches, line)\n359:                 letter, spell_name, level, category, fail, retention = matches[0]\n360:                 assert len(letter) == 1, letter\n361:                 self.known_spells[spell_name] = letter\n362:                 self.spell_fail_chance[spell_name] = int(fail) / 100\n363:         self.agent.step(A.Command.ESC)\n364: \n365:     def parse_enhance_view(self):\n366:         with self.agent.atom_operation():\n367:             self.agent.step(A.Command.ENHANCE)\n368:             self._parse_enhance_view()\n369:             while self.upgradable_skills:\n370:                 to_upgrade = self.select_skill_to_upgrade()\n371:                 old_skill_level = self.skill_levels.copy()\n372:                 letter = self.upgradable_skills[to_upgrade]\n373: \n374:                 def type_letter():\n375:                     while f'{letter} - ' not in '\\n'.join(self.agent.single_popup):\n376:                         yield A.TextCharacters.SPACE\n377:                     yield letter\n378: \n379:                 self.agent.step(A.Command.ENHANCE, type_letter())\n380: \n381:                 self.agent.step(A.Command.ENHANCE)\n382:                 self._parse_enhance_view()\n383:                 assert (old_skill_level != self.skill_levels).any(), (old_skill_level, self.skill_levels)\n384: \n385:     def select_skill_to_upgrade(self):\n386:         assert self.upgradable_skills\n387:         # TODO: logic\n388:         return next(iter(self.upgradable_skills.keys()))\n389: \n390:     def _parse_enhance_view(self):\n391:         if self.agent.popup[0] not in ('Current skills:', 'Pick a skill to advance:'):\n392:             raise ValueError('Invalid ehance popup text format.' + str(self.agent.popup))\n393:         self.upgradable_skills = dict()\n394:         for line in self.agent.popup[1:]:\n395:             if line.strip() in self.possible_skill_types or \\\n396:                     line.strip() == '(Skill flagged by \"#\" cannot be enhanced any further.)' or \\\n397:                     line.strip() == '(Skills flagged by \"#\" cannot be enhanced any further.)' or \\\n398:                     line.strip() == '(Skill flagged by \"*\" may be enhanced when you\\'re more experienced.)' or \\\n399:                     line.strip() == '(Skills flagged by \"*\" may be enhanced when you\\'re more experienced.)':\n400:                 continue\n401:             matches = re.findall(r'^([a-zA-Z] -)?#?\\*? *' +\n402:                                  r'(' + '|'.join(self.name_to_skill_type.keys()) + ') *' +\n403:                                  r'\\[(' + '|'.join(self.possible_skill_levels) + ')\\]', line)\n404:             assert len(matches) == 1, (matches, line)\n405:             letter, skill_type, skill_level = matches[0]\n406:             if letter:\n407:                 letter = letter[0]\n408:                 assert letter not in self.upgradable_skills.values()\n409:                 self.upgradable_skills[self.name_to_skill_type[skill_type]] = letter\n410:             self.skill_levels[self.name_to_skill_type[skill_type]] = self.name_to_skill_level[skill_level]\n411: \n412:     def _get_str_dex_to_hit_bonus(self):\n413:         bonus = 0\n414:         # /* attack bonus for strength & dexterity */\n415:         # int\n416:         # abon()\n417:         # {\n418:         #     int sbon;\n419:         #     int str = ACURR(A_STR), dex = ACURR(A_DEX);\n420:         strength = self.agent.blstats.strength\n421:         dexterity = self.agent.blstats.dexterity\n422: \n423:         #     if (Upolyd)\n424:         #         return (adj_lev(&mons[u.umonnum]) - 3);\n425: \n426:         #     if (str < 6)\n427:         #         sbon = -2;\n428:         #     else if (str < 8)\n429:         #         sbon = -1;\n430:         #     else if (str < 17)\n431:         #         sbon = 0;\n432:         #     else if (str <= STR18(50))\n433:         #         sbon = 1; /* up to 18/50 */\n434:         #     else if (str < STR18(100))\n435:         #         sbon = 2;\n436:         #     else\n437:         #         sbon = 3;\n438:         if strength < 6:\n439:             bonus -= 2\n440:         elif strength < 8:\n441:             bonus -= 1\n442:         elif strength < 17:\n443:             pass\n444:         elif strength <= 18 + 50:\n445:             bonus += 1\n446:         elif strength < 18 + 100:\n447:             bonus += 2\n448:         else:\n449:             bonus += 3\n450: \n451:         #     /* Game tuning kludge: make it a bit easier for a low level character to\n452:         #      * hit */\n453:         #     sbon += (u.ulevel < 3) ? 1 : 0;\n454: \n455:         #     if (dex < 4)\n456:         #         return (sbon - 3);\n457:         #     else if (dex < 6)\n458:         #         return (sbon - 2);\n459:         #     else if (dex < 8)\n460:         #         return (sbon - 1);\n461:         #     else if (dex < 14)\n462:         #         return sbon;\n463:         #     else\n464:         #         return (sbon + dex - 14);\n465:         #\n466: \n467:         if dexterity < 4:\n468:             bonus -= 3\n469:         elif dexterity < 6:\n470:             bonus -= 2\n471:         elif dexterity < 8:\n472:             bonus -= 1\n473:         elif dexterity < 14:\n474:             pass\n475:         else:\n476:             return bonus + dexterity - 14\n477: \n478:         return bonus\n479: \n480:     def _get_weapon_skill_bonus(self, item):\n481:         \"\"\" Retuns a pair (to hit bonus, damage bonus) \"\"\"\n482: \n483:         if item is None:\n484:             if self.role in (self.MONK, self.SAMURAI):\n485:                 return self.martial_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n486:             else:\n487:                 return self.unarmed_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n488:         else:\n489:             # TODO: two weapon, riding\n490: \n491:             # TODO: proper sub\n492:             assert all(item.objs[0].sub == obj.sub for obj in item.objs), item.objs\n493:             sub = abs(item.objs[0].sub)\n494: \n495:             if not (0 <= sub < len(self.skill_levels)):\n496:                 raise ValueError('Invalid item sub: ' + str(item) + ' sub: ' + str(sub))\n497:             # TODO:\n498:             return self.weapon_bonus[self.skill_levels[sub]]\n499: \n500:     def get_ranged_bonus(self, launcher, ammo, monster=None, large_monster=False):\n501:         # TODO: check code/wiki\n502: \n503:         if launcher is not None:\n504:             assert launcher.is_launcher()\n505:             assert ammo.is_fired_projectile()\n506:         else:\n507:             assert ammo.is_thrown_projectile()\n508: \n509:         roll_offset = 0\n510:         dmg_bonus = 0\n511:         if launcher is not None:\n512:             skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(launcher)\n513:             roll_offset += skill_hit_bonus\n514:             roll_offset += launcher.get_weapon_bonus(large_monster)[0]\n515:             dmg_bonus += launcher.get_weapon_bonus(large_monster)[1]\n516: \n517:         roll_offset += ammo.get_weapon_bonus(large_monster)[0]\n518:         dmg_bonus += ammo.get_weapon_bonus(large_monster)[1]\n519: \n520:         return roll_offset, max(0, dmg_bonus)\n521: \n522:     def get_range(self, launcher, ammo):\n523:         # TODO: implement\n524:         return 7\n525: \n526:     def get_melee_bonus(self, item, monster=None, large_monster=False):\n527:         \"\"\" Returns a pair (to_hit, damaga)\n528:         https://github.com/facebookresearch/nle/blob/master/src/uhitm.c : find_roll_to_hit\n529:          \"\"\"\n530:         if monster is not None:\n531:             raise NotImplementedError()\n532: \n533:         # TODO:\n534:         # tmp = 1 + Luck + abon() + find_mac(mtmp) + u.uhitinc\n535:         # + maybe_polyd(youmonst.data->mlevel, u.ulevel);\n536:         roll_offset = 1 + self._get_str_dex_to_hit_bonus() + self.agent.blstats.experience_level\n537: \n538:         # TODO:\n539:         # /* some actions should occur only once during multiple attacks */\n540:         # if (!(*attk_count)++) {\n541:         #     /* knight's chivalry or samurai's giri */\n542:         #     check_caitiff(mtmp);\n543:         # }\n544: \n545:         # TODO:\n546:         # /* adjust vs. (and possibly modify) monster state */\n547:         # if (mtmp->mstun)\n548:         #     tmp += 2;\n549:         # if (mtmp->mflee)\n550:         #     tmp += 2;\n551: \n552:         # TODO:\n553:         # if (mtmp->msleeping) {\n554:         #     mtmp->msleeping = 0;\n555:         #     tmp += 2;\n556:         # }\n557: \n558:         # TODO:\n559:         # if (!mtmp->mcanmove) {\n560:         #     tmp += 4;\n561:         #     if (!rn2(10)) {\n562:         #         mtmp->mcanmove = 1;\n563:         #         mtmp->mfrozen = 0;\n564:         #     }\n565:         # }\n566: \n567:         # /* role/race adjustments */\n568: \n569:         # TODO: polymorphed\n570:         # if (Role_if(PM_MONK) && !Upolyd) {\n571:         if self.role == self.MONK:\n572:             # if (uarm)\n573:             if self.agent.inventory.items.suit is not None:\n574:                 # tmp -= (*role_roll_penalty = urole.spelarmr);\n575:                 roll_offset -= 20\n576:             elif item is None and self.agent.inventory.items.off_hand is None:\n577:                 #  else if (!uwep && !uarms)\n578:                 # tmp += (u.ulevel / 3) + 2;\n579:                 roll_offset += (self.agent.blstats.experience_level // 3) + 2\n580: \n581:         # TODO:\n582:         # if (is_orc(mtmp->data)\n583:         #     && maybe_polyd(is_elf(youmonst.data), Race_if(PM_ELF)))\n584:         #     tmp++;\n585: \n586:         # TODO:\n587:         # /* encumbrance: with a lot of luggage, your agility diminishes */\n588:         # if ((tmp2 = near_capacity()) != 0)\n589:         #     tmp -= (tmp2 * 2) - 1;\n590:         # if (u.utrap)\n591:         #     tmp -= 3;\n592: \n593:         # /*\n594:         #  * hitval applies if making a weapon attack while wielding a weapon;\n595:         #  * weapon_hit_bonus applies if doing a weapon attack even bare-handed\n596:         #  * or if kicking as martial artist\n597:         #  */\n598:         # if (aatyp == AT_WEAP || aatyp == AT_CLAW) {\n599:         #     if (weapon)\n600:         #         tmp += hitval(weapon, mtmp);\n601:         #     tmp += weapon_hit_bonus(weapon);\n602:         # } else if (aatyp == AT_KICK && martial_bonus()) {\n603:         #     tmp += weapon_hit_bonus((struct obj *) 0);\n604:         # }\n605:         skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(item)\n606:         roll_offset += skill_hit_bonus\n607: \n608:         if item is not None:\n609:             if item.is_launcher() or item.is_fired_projectile() or item.objs[0].name in ['dart', 'shuriken']:\n610:                 # TODO: rocks, boomerang\n611:                 dmg_bonus = 1.5  # 1d2\n612:             else:\n613:                 dmg_bonus += item.get_weapon_bonus(large_monster)[1]\n614:             roll_offset += item.get_weapon_bonus(large_monster)[0]\n615:         else:\n616:             # TODO: proper unarmed base damage\n617:             dmg_bonus += 1.5\n618:         return roll_offset, max(0, dmg_bonus)\n619: \n620:     def get_skill_str_list(self):\n621:         inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n622:         inv_skill_level = {v: k for k, v in self.name_to_skill_level.items()}\n623:         return list(inv_skill_type[skill_type] + '-' + inv_skill_level[level]\n624:                     for skill_type, level in enumerate(self.skill_levels)\n625:                     if level in inv_skill_level and skill_type in inv_skill_type and level != 0)\n626: \n627:     def __str__(self):\n628:         if self.role is None:\n629:             return 'unparsed_character'\n630:         skill_str = '| '.join(self.get_skill_str_list())\n631:         if self.upgradable_skills:\n632:             inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n633:             skill_str += '\\n Upgradable: ' + '|'.join(letter + '-' + inv_skill_type[skill]\n634:                                                       for skill, letter in self.upgradable_skills.items())\n635:         return '-'.join([f'{list(d.keys())[list(d.values()).index(v)][:3].lower()}'\n636:                          for d, v in [(self.name_to_role, self.role),\n637:                                       (self.name_to_race, self.race),\n638:                                       (self.name_to_gender, self.gender),\n639:                                       (self.name_to_alignment, self.alignment),\n640:                                       ]]) + '\\n Skills: ' + skill_str\n\n(End of file - total 640 lines)\n</content>","metadata":{"preview":"import re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\n\nALL_SPELL_NAMES = [\n    \"force bolt\",\n    \"drain life\",\n    \"magic missile\",\n    \"cone of cold\",\n    \"fireball\",\n    \"finger of death\",\n    \"protection\",\n    \"create monster\",\n    \"remove curse\",\n    \"create familiar\",\n    \"turn undead\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/character.py","text":"import re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\n\nALL_SPELL_NAMES = [\n    \"force bolt\",\n    \"drain life\",\n    \"magic missile\",\n    \"cone of cold\",\n    \"fireball\",\n    \"finger of death\",\n    \"protection\",\n    \"create monster\",\n    \"remove curse\",\n    \"create familiar\",\n    \"turn undead\",\n    \"detect monsters\",\n    \"light\",\n    \"detect food\",\n    \"clairvoyance\",\n    \"detect unseen\",\n    \"identify\",\n    \"detect treasure\",\n    \"magic mapping\",\n    \"sleep\",\n    \"confuse monster\",\n    \"slow monster\",\n    \"cause fear\",\n    \"charm monster\",\n    \"jumping\",\n    \"haste self\",\n    \"invisibility\",\n    \"levitation\",\n    \"teleport away\",\n    \"healing\",\n    \"cure blindness\",\n    \"cure sickness\",\n    \"extra healing\",\n    \"stone to flesh\",\n    \"restore ability\",\n    \"knock\",\n    \"wizard lock\",\n    \"dig\",\n    \"polymorph\",\n    \"cancellation\",\n]\n\nALL_SPELL_CATEGORIES = [\n    \"attack\",\n    \"healing\",\n    \"divination\",\n    \"enchantment\",\n    \"clerical\",\n    \"escape\",\n    \"matter\",\n]\n\n\nclass Property:\n    def __init__(self, agent):\n        self.agent = agent\n\n    # The tty status line abbreviates conditions when it gets long (e.g. 'Hallu' -> 'Hl'),\n    # so read them from the blstats condition bitmask instead.\n    def _condition(self, mask):\n        return bool(self.agent.last_observation['blstats'][nh.NLE_BL_CONDITION] & mask)\n\n    @property\n    def confusion(self):\n        return self._condition(nh.BL_MASK_CONF)\n\n    @property\n    def stun(self):\n        return self._condition(nh.BL_MASK_STUN)\n\n    @property\n    def hallu(self):\n        return self._condition(nh.BL_MASK_HALLU)\n\n    @property\n    def blind(self):\n        return self._condition(nh.BL_MASK_BLIND)\n\n    @property\n    def polymorph(self):\n        if not nh.glyph_is_monster(self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]):\n            return False\n        return self.agent.character.self_glyph != self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n\n\nclass Character:\n    UNKNOWN = -1  # for everything, e.g. alignment\n\n    ARCHEOLOGIST = 0\n    BARBARIAN = 1\n    CAVEMAN = 2\n    HEALER = 3\n    KNIGHT = 4\n    MONK = 5\n    PRIEST = 6\n    RANGER = 7\n    ROGUE = 8\n    SAMURAI = 9\n    TOURIST = 10\n    VALKYRIE = 11\n    WIZARD = 12\n\n    name_to_role = {\n        'Archeologist': ARCHEOLOGIST,\n        'Barbarian': BARBARIAN,\n        'Caveman': CAVEMAN,\n        'Cavewoman': CAVEMAN,\n        'Healer': HEALER,\n        'Knight': KNIGHT,\n        'Monk': MONK,\n        'Priest': PRIEST,\n        'Priestess': PRIEST,\n        'Ranger': RANGER,\n        'Rogue': ROGUE,\n        'Samurai': SAMURAI,\n        'Tourist': TOURIST,\n        'Valkyrie': VALKYRIE,\n        'Wizard': WIZARD,\n    }\n\n    CHAOTIC = 0\n    NEUTRAL = 1\n    LAWFUL = 2\n    UNALIGNED = 3\n\n    name_to_alignment = {\n        'chaotic': CHAOTIC,\n        'neutral': NEUTRAL,\n        'lawful': LAWFUL,\n        'unaligned': UNALIGNED,\n    }\n\n    HUMAN = 0\n    DWARF = 1\n    ELF = 2\n    GNOME = 3\n    ORC = 4\n\n    name_to_race = {\n        'human': HUMAN,\n        'dwarf': DWARF,\n        'dwarven': DWARF,\n        'elf': ELF,\n        'elven': ELF,\n        'gnome': GNOME,\n        'gnomish': GNOME,\n        'orc': ORC,\n        'orcish': ORC,\n    }\n\n    MALE = 0\n    FEMALE = 1\n\n    name_to_gender = {\n        'male': MALE,\n        'female': FEMALE,\n    }\n\n    name_to_skill_type = {\n        # \"\": O.P_NONE,\n        \"dagger\": O.P_DAGGER,\n        \"knife\": O.P_KNIFE,\n        \"axe\": O.P_AXE,\n        \"pick-axe\": O.P_PICK_AXE,\n        \"short sword\": O.P_SHORT_SWORD,\n        \"broadsword\": O.P_BROAD_SWORD,\n        \"long sword\": O.P_LONG_SWORD,\n        \"two-handed sword\": O.P_TWO_HANDED_SWORD,\n        \"scimitar\": O.P_SCIMITAR,\n        \"saber\": O.P_SABER,\n        \"club\": O.P_CLUB,\n        \"mace\": O.P_MACE,\n        \"morning star\": O.P_MORNING_STAR,\n        \"flail\": O.P_FLAIL,\n        \"hammer\": O.P_HAMMER,\n        \"quarterstaff\": O.P_QUARTERSTAFF,\n        \"polearms\": O.P_POLEARMS,\n        \"spear\": O.P_SPEAR,\n        \"trident\": O.P_TRIDENT,\n        \"lance\": O.P_LANCE,\n        \"bow\": O.P_BOW,\n        \"sling\": O.P_SLING,\n        \"crossbow\": O.P_CROSSBOW,\n        \"dart\": O.P_DART,\n        \"shuriken\": O.P_SHURIKEN,\n        \"boomerang\": O.P_BOOMERANG,\n        \"whip\": O.P_WHIP,\n        \"unicorn horn\": O.P_UNICORN_HORN,\n\n        \"attack spells\": O.P_ATTACK_SPELL,\n        \"healing spells\": O.P_HEALING_SPELL,\n        \"divination spells\": O.P_DIVINATION_SPELL,\n        \"enchantment spells\": O.P_ENCHANTMENT_SPELL,\n        \"clerical spells\": O.P_CLERIC_SPELL,\n        \"escape spells\": O.P_ESCAPE_SPELL,\n        \"matter spells\": O.P_MATTER_SPELL,\n\n        \"bare handed combat\": O.P_BARE_HANDED_COMBAT,\n        \"martial arts\": O.P_BARE_HANDED_COMBAT,\n        \"two weapon combat\": O.P_TWO_WEAPON_COMBAT,\n        \"riding\": O.P_RIDING,\n    }\n\n    possible_skill_types = ['Fighting Skills', 'Weapon Skills', 'Spellcasting Skills']\n    possible_skill_levels = ['Unskilled', 'Basic', 'Skilled', 'Expert', 'Master', 'Grand Master']\n\n    SKILL_LEVEL_RESTRICTED = 0\n    SKILL_LEVEL_UNSKILLED = 1\n    SKILL_LEVEL_BASIC = 2\n    SKILL_LEVEL_SKILLED = 3\n    SKILL_LEVEL_EXPERT = 4\n    SKILL_LEVEL_MASTER = 5\n    SKILL_LEVEL_GRAND_MASTER = 6\n\n    weapon_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-4, 2),\n        SKILL_LEVEL_UNSKILLED: (-4, 2),\n        SKILL_LEVEL_BASIC: (0, 0),\n        SKILL_LEVEL_SKILLED: (2, 1),\n        SKILL_LEVEL_EXPERT: (3, 2),\n    }\n    two_weapon_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-9, -3),\n        SKILL_LEVEL_UNSKILLED: (-9, -3),\n        SKILL_LEVEL_BASIC: (-7, -1),\n        SKILL_LEVEL_SKILLED: (-5, 0),\n        SKILL_LEVEL_EXPERT: (-3, 1),\n    }\n    riding_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-2, 0),\n        SKILL_LEVEL_UNSKILLED: (-2, 0),\n        SKILL_LEVEL_BASIC: (-1, 0),\n        SKILL_LEVEL_SKILLED: (0, 1),\n        SKILL_LEVEL_EXPERT: (0, 2),\n    }\n    unarmed_bonus = {\n        SKILL_LEVEL_RESTRICTED: (1, 0),\n        SKILL_LEVEL_UNSKILLED: (1, 0),\n        SKILL_LEVEL_BASIC: (1, 1),\n        SKILL_LEVEL_SKILLED: (2, 1),\n        SKILL_LEVEL_EXPERT: (2, 2),\n        SKILL_LEVEL_MASTER: (3, 2),\n        SKILL_LEVEL_GRAND_MASTER: (3, 3),\n    }\n    martial_bonus = {\n        SKILL_LEVEL_RESTRICTED: (1, 0),  # no one has it restricted\n        SKILL_LEVEL_UNSKILLED: (2, 1),\n        SKILL_LEVEL_BASIC: (3, 3),\n        SKILL_LEVEL_SKILLED: (4, 4),\n        SKILL_LEVEL_EXPERT: (5, 6),\n        SKILL_LEVEL_MASTER: (6, 7),\n        SKILL_LEVEL_GRAND_MASTER: (7, 9),\n    }\n\n    name_to_skill_level = {k: v for k, v in zip(['Restricted'] + possible_skill_levels,\n                                                [SKILL_LEVEL_RESTRICTED,\n                                                 SKILL_LEVEL_UNSKILLED, SKILL_LEVEL_BASIC, SKILL_LEVEL_SKILLED,\n                                                 SKILL_LEVEL_EXPERT,\n                                                 SKILL_LEVEL_MASTER, SKILL_LEVEL_GRAND_MASTER])}\n\n    def __init__(self, agent):\n        self.agent = agent\n        self.prop = Property(agent)\n        self.role = None\n        self.alignment = None\n        self.race = None\n        self.gender = None\n        self.self_glyph = None\n        self.skill_levels = np.zeros(max(self.name_to_skill_type.values()) + 1, dtype=int)\n        self.upgradable_skills = dict()\n\n        self.is_lycanthrope = False\n\n        # populated lazily by parse_spellcast_view once the Healer reaches the deep-dive phase\n        self.known_spells = dict()\n        self.spell_fail_chance = dict()\n\n    def update(self):\n        if 'You feel feverish.' in self.agent.message:\n            self.is_lycanthrope = True\n        if 'You feel purified.' in self.agent.message:\n            self.is_lycanthrope = False\n\n    @property\n    def carrying_capacity(self):\n        # TODO: levitation, etc\n        return min(1000, (self.agent.blstats.strength_percentage + self.agent.blstats.constitution) * 25 + 50)\n\n    def parse(self):\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.ATTRIBUTES)\n            text = ' '.join(self.agent.popup)\n            self._parse(text)\n            self.self_glyph = self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n\n    def _parse(self, text):\n        matches = re.findall('You are a ([a-z]+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+).', text)\n        if len(matches) == 1:\n            alignment, _, gender, race, role = matches[0]\n        else:\n            matches = re.findall(\n                'You are an? ([a-zA-Z ]+), a level (\\d+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+). *You are ([a-z]+)',\n                text)\n            assert len(matches) == 1, repr(text)\n            _, _, _, gender, race, role, alignment = matches[0]\n\n        if not gender:\n            if role == 'Priestess':\n                gender = 'female'\n            elif role == 'Priest':\n                gender = 'male'\n            elif role == 'Caveman':\n                gender = 'male'\n            elif role == 'Cavewoman':\n                gender = 'female'\n            elif role == 'Valkyrie':\n                gender = 'female'\n            else:\n                assert 0, repr(text)\n\n        self.role = self.name_to_role[role]\n        self.alignment = self.name_to_alignment[alignment]\n        self.race = self.name_to_race[race]\n        self.gender = self.name_to_gender[gender]\n\n    def parse_spellcast_view(self):\n        self.known_spells = dict()\n        self.spell_fail_chance = dict()\n\n        # TODO: parse for other spellcaster classes\n        if self.role not in (self.HEALER, self.WIZARD, self.MONK):\n            return\n\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.CAST)\n            if not self.agent.popup:\n                self.known_spells[self.agent.message] = None\n                return\n            if self.agent.popup[0] not in ('Choose which spell to cast') or \\\n                    not self.agent.popup[1].startswith('Name'):\n                raise ValueError(f'Invalid cast popup text format: {self.agent.popup}')\n            for line in self.agent.popup[2:]:\n                matches = re.findall(r'^([a-zA-Z]) - *' +\n                                     r'(' + '|'.join(ALL_SPELL_NAMES) + ') *' +\n                                     r'([0-9]*) *' +\n                                     r'(' + '|'.join(ALL_SPELL_CATEGORIES) + ') *' +\n                                     r'([0-9]*)\\% *' +\n                                     r'([0-9]*\\%|\\(gone\\))', line)\n                assert len(matches) == 1, (matches, line)\n                letter, spell_name, level, category, fail, retention = matches[0]\n                assert len(letter) == 1, letter\n                self.known_spells[spell_name] = letter\n                self.spell_fail_chance[spell_name] = int(fail) / 100\n        self.agent.step(A.Command.ESC)\n\n    def parse_enhance_view(self):\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.ENHANCE)\n            self._parse_enhance_view()\n            while self.upgradable_skills:\n                to_upgrade = self.select_skill_to_upgrade()\n                old_skill_level = self.skill_levels.copy()\n                letter = self.upgradable_skills[to_upgrade]\n\n                def type_letter():\n                    while f'{letter} - ' not in '\\n'.join(self.agent.single_popup):\n                        yield A.TextCharacters.SPACE\n                    yield letter\n\n                self.agent.step(A.Command.ENHANCE, type_letter())\n\n                self.agent.step(A.Command.ENHANCE)\n                self._parse_enhance_view()\n                assert (old_skill_level != self.skill_levels).any(), (old_skill_level, self.skill_levels)\n\n    def select_skill_to_upgrade(self):\n        assert self.upgradable_skills\n        # TODO: logic\n        return next(iter(self.upgradable_skills.keys()))\n\n    def _parse_enhance_view(self):\n        if self.agent.popup[0] not in ('Current skills:', 'Pick a skill to advance:'):\n            raise ValueError('Invalid ehance popup text format.' + str(self.agent.popup))\n        self.upgradable_skills = dict()\n        for line in self.agent.popup[1:]:\n            if line.strip() in self.possible_skill_types or \\\n                    line.strip() == '(Skill flagged by \"#\" cannot be enhanced any further.)' or \\\n                    line.strip() == '(Skills flagged by \"#\" cannot be enhanced any further.)' or \\\n                    line.strip() == '(Skill flagged by \"*\" may be enhanced when you\\'re more experienced.)' or \\\n                    line.strip() == '(Skills flagged by \"*\" may be enhanced when you\\'re more experienced.)':\n                continue\n            matches = re.findall(r'^([a-zA-Z] -)?#?\\*? *' +\n                                 r'(' + '|'.join(self.name_to_skill_type.keys()) + ') *' +\n                                 r'\\[(' + '|'.join(self.possible_skill_levels) + ')\\]', line)\n            assert len(matches) == 1, (matches, line)\n            letter, skill_type, skill_level = matches[0]\n            if letter:\n                letter = letter[0]\n                assert letter not in self.upgradable_skills.values()\n                self.upgradable_skills[self.name_to_skill_type[skill_type]] = letter\n            self.skill_levels[self.name_to_skill_type[skill_type]] = self.name_to_skill_level[skill_level]\n\n    def _get_str_dex_to_hit_bonus(self):\n        bonus = 0\n        # /* attack bonus for strength & dexterity */\n        # int\n        # abon()\n        # {\n        #     int sbon;\n        #     int str = ACURR(A_STR), dex = ACURR(A_DEX);\n        strength = self.agent.blstats.strength\n        dexterity = self.agent.blstats.dexterity\n\n        #     if (Upolyd)\n        #         return (adj_lev(&mons[u.umonnum]) - 3);\n\n        #     if (str < 6)\n        #         sbon = -2;\n        #     else if (str < 8)\n        #         sbon = -1;\n        #     else if (str < 17)\n        #         sbon = 0;\n        #     else if (str <= STR18(50))\n        #         sbon = 1; /* up to 18/50 */\n        #     else if (str < STR18(100))\n        #         sbon = 2;\n        #     else\n        #         sbon = 3;\n        if strength < 6:\n            bonus -= 2\n        elif strength < 8:\n            bonus -= 1\n        elif strength < 17:\n            pass\n        elif strength <= 18 + 50:\n            bonus += 1\n        elif strength < 18 + 100:\n            bonus += 2\n        else:\n            bonus += 3\n\n        #     /* Game tuning kludge: make it a bit easier for a low level character to\n        #      * hit */\n        #     sbon += (u.ulevel < 3) ? 1 : 0;\n\n        #     if (dex < 4)\n        #         return (sbon - 3);\n        #     else if (dex < 6)\n        #         return (sbon - 2);\n        #     else if (dex < 8)\n        #         return (sbon - 1);\n        #     else if (dex < 14)\n        #         return sbon;\n        #     else\n        #         return (sbon + dex - 14);\n        #\n\n        if dexterity < 4:\n            bonus -= 3\n        elif dexterity < 6:\n            bonus -= 2\n        elif dexterity < 8:\n            bonus -= 1\n        elif dexterity < 14:\n            pass\n        else:\n            return bonus + dexterity - 14\n\n        return bonus\n\n    def _get_weapon_skill_bonus(self, item):\n        \"\"\" Retuns a pair (to hit bonus, damage bonus) \"\"\"\n\n        if item is None:\n            if self.role in (self.MONK, self.SAMURAI):\n                return self.martial_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n            else:\n                return self.unarmed_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n        else:\n            # TODO: two weapon, riding\n\n            # TODO: proper sub\n            assert all(item.objs[0].sub == obj.sub for obj in item.objs), item.objs\n            sub = abs(item.objs[0].sub)\n\n            if not (0 <= sub < len(self.skill_levels)):\n                raise ValueError('Invalid item sub: ' + str(item) + ' sub: ' + str(sub))\n            # TODO:\n            return self.weapon_bonus[self.skill_levels[sub]]\n\n    def get_ranged_bonus(self, launcher, ammo, monster=None, large_monster=False):\n        # TODO: check code/wiki\n\n        if launcher is not None:\n            assert launcher.is_launcher()\n            assert ammo.is_fired_projectile()\n        else:\n            assert ammo.is_thrown_projectile()\n\n        roll_offset = 0\n        dmg_bonus = 0\n        if launcher is not None:\n            skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(launcher)\n            roll_offset += skill_hit_bonus\n            roll_offset += launcher.get_weapon_bonus(large_monster)[0]\n            dmg_bonus += launcher.get_weapon_bonus(large_monster)[1]\n\n        roll_offset += ammo.get_weapon_bonus(large_monster)[0]\n        dmg_bonus += ammo.get_weapon_bonus(large_monster)[1]\n\n        return roll_offset, max(0, dmg_bonus)\n\n    def get_range(self, launcher, ammo):\n        # TODO: implement\n        return 7\n\n    def get_melee_bonus(self, item, monster=None, large_monster=False):\n        \"\"\" Returns a pair (to_hit, damaga)\n        https://github.com/facebookresearch/nle/blob/master/src/uhitm.c : find_roll_to_hit\n         \"\"\"\n        if monster is not None:\n            raise NotImplementedError()\n\n        # TODO:\n        # tmp = 1 + Luck + abon() + find_mac(mtmp) + u.uhitinc\n        # + maybe_polyd(youmonst.data->mlevel, u.ulevel);\n        roll_offset = 1 + self._get_str_dex_to_hit_bonus() + self.agent.blstats.experience_level\n\n        # TODO:\n        # /* some actions should occur only once during multiple attacks */\n        # if (!(*attk_count)++) {\n        #     /* knight's chivalry or samurai's giri */\n        #     check_caitiff(mtmp);\n        # }\n\n        # TODO:\n        # /* adjust vs. (and possibly modify) monster state */\n        # if (mtmp->mstun)\n        #     tmp += 2;\n        # if (mtmp->mflee)\n        #     tmp += 2;\n\n        # TODO:\n        # if (mtmp->msleeping) {\n        #     mtmp->msleeping = 0;\n        #     tmp += 2;\n        # }\n\n        # TODO:\n        # if (!mtmp->mcanmove) {\n        #     tmp += 4;\n        #     if (!rn2(10)) {\n        #         mtmp->mcanmove = 1;\n        #         mtmp->mfrozen = 0;\n        #     }\n        # }\n\n        # /* role/race adjustments */\n\n        # TODO: polymorphed\n        # if (Role_if(PM_MONK) && !Upolyd) {\n        if self.role == self.MONK:\n            # if (uarm)\n            if self.agent.inventory.items.suit is not None:\n                # tmp -= (*role_roll_penalty = urole.spelarmr);\n                roll_offset -= 20\n            elif item is None and self.agent.inventory.items.off_hand is None:\n                #  else if (!uwep && !uarms)\n                # tmp += (u.ulevel / 3) + 2;\n                roll_offset += (self.agent.blstats.experience_level // 3) + 2\n\n        # TODO:\n        # if (is_orc(mtmp->data)\n        #     && maybe_polyd(is_elf(youmonst.data), Race_if(PM_ELF)))\n        #     tmp++;\n\n        # TODO:\n        # /* encumbrance: with a lot of luggage, your agility diminishes */\n        # if ((tmp2 = near_capacity()) != 0)\n        #     tmp -= (tmp2 * 2) - 1;\n        # if (u.utrap)\n        #     tmp -= 3;\n\n        # /*\n        #  * hitval applies if making a weapon attack while wielding a weapon;\n        #  * weapon_hit_bonus applies if doing a weapon attack even bare-handed\n        #  * or if kicking as martial artist\n        #  */\n        # if (aatyp == AT_WEAP || aatyp == AT_CLAW) {\n        #     if (weapon)\n        #         tmp += hitval(weapon, mtmp);\n        #     tmp += weapon_hit_bonus(weapon);\n        # } else if (aatyp == AT_KICK && martial_bonus()) {\n        #     tmp += weapon_hit_bonus((struct obj *) 0);\n        # }\n        skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(item)\n        roll_offset += skill_hit_bonus\n\n        if item is not None:\n            if item.is_launcher() or item.is_fired_projectile() or item.objs[0].name in ['dart', 'shuriken']:\n                # TODO: rocks, boomerang\n                dmg_bonus = 1.5  # 1d2\n            else:\n                dmg_bonus += item.get_weapon_bonus(large_monster)[1]\n            roll_offset += item.get_weapon_bonus(large_monster)[0]\n        else:\n            # TODO: proper unarmed base damage\n            dmg_bonus += 1.5\n        return roll_offset, max(0, dmg_bonus)\n\n    def get_skill_str_list(self):\n        inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n        inv_skill_level = {v: k for k, v in self.name_to_skill_level.items()}\n        return list(inv_skill_type[skill_type] + '-' + inv_skill_level[level]\n                    for skill_type, level in enumerate(self.skill_levels)\n                    if level in inv_skill_level and skill_type in inv_skill_type and level != 0)\n\n    def __str__(self):\n        if self.role is None:\n            return 'unparsed_character'\n        skill_str = '| '.join(self.get_skill_str_list())\n        if self.upgradable_skills:\n            inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n            skill_str += '\\n Upgradable: ' + '|'.join(letter + '-' + inv_skill_type[skill]\n                                                      for skill, letter in self.upgradable_skills.items())\n        return '-'.join([f'{list(d.keys())[list(d.values()).index(v)][:3].lower()}'\n                         for d, v in [(self.name_to_role, self.role),\n                                      (self.name_to_race, self.race),\n                                      (self.name_to_gender, self.gender),\n                                      (self.name_to_alignment, self.alignment),\n                                      ]]) + '\\n Skills: ' + skill_str","lineStart":1,"lineEnd":640,"totalLines":640,"truncated":false}},"title":"autoascend/character.py","time":{"start":1790527679585,"end":1790527679592}},"id":"prt_0e3c42c5c0019tvp6aZWNFRXl0","sessionID":"ses_f1c5a4875ffeR5KO5Iu7pV8EKt","messageID":"msg_0e3c3dee2001wyou24a9EFSCuO"}}
