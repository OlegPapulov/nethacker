  # TODO: coin slot\n46:                 return\n47: \n48:             how_many_already_total = ret_inv.get(item, 0) + ret_bag.get(item, 0)\n49:             how_many_already = ret.get(item, 0)\n50:             max_to_add = int(remaining_weight // item.unit_weight(with_content=False))\n51:             if count is not None:\n52:                 max_to_add = min(max_to_add, count)\n53:             ret[item] = min(item.count, how_many_already_total + max_to_add) - (how_many_already_total - how_many_already)\n54:             remaining_weight -= item.unit_weight(with_content=False) * (ret[item] - how_many_already)\n55: \n56:         for item in items:\n57:             if item.is_container() and item.status in [Item.UNCURSED, Item.BLESSED] and item.objs[0].desc == 'bag':\n58:                 bag = item  # TODO: select the best\n59:                 add_item(bag)\n60: \n61:         if self._drop_gold_till_turn < self.agent.blstats.time:\n62:             for item in items:\n63:                 if item.category == nh.COIN_CLASS:\n64:                     add_item(item)\n65: \n66:         for allow_unknown_status in [False, True]:\n67:             item = self.agent.inventory.get_best_melee_weapon(items=forced_items + items,\n68:                                                               allow_unknown_status=allow_unknown_status)\n69:             if item is not None:\n70:                 add_item(item)\n71: \n72:             for item in self.agent.inventory.get_best_armorset(items=forced_items + items,\n73:                                                                allow_unknown_status=allow_unknown_status):\n74:                 if item is not None:\n75:                     add_item(item)\n76: \n77:         for item in items:\n78:             if item.is_unambiguous():\n79:                 if item.object in [\n80:                         O.from_name('healing', nh.POTION_CLASS),\n81:                         O.from_name('extra healing', nh.POTION_CLASS),\n82:                         O.from_name('full healing', nh.POTION_CLASS)]:\n83:                     add_item(item)\n84: \n85:                 if self.agent.character.role in [Character.RANGER, Character.ROGUE,\n86:                                                  Character.SAMURAI, Character.TOURIST] and \\\n87:                         (item.is_launcher() or item.is_fired_projectile()):\n88:                     add_item(item)\n89: \n90:         if self.agent.character.alignment == Character.LAWFUL:\n91:             for item in sorted(filter(lambda i: i.objs[0].name == 'long sword', items),\n92:                                key=lambda i: -utils.calc_dps(*self.agent.character.get_melee_bonus(i))):\n93:                 add_item(item)\n94:                 break\n95: \n96:         for item in sorted(filter(lambda i: i.is_thrown_projectile(), items),\n97:                            key=lambda i: -utils.calc_dps(*self.agent.character.get_ranged_bonus(None, i))):\n98:             add_item(item)\n99: \n100:         for item in sorted(filter(lambda i: i.is_food() and not i.is_corpse(), items),\n101:                            key=lambda x: -x.nutrition_per_weight() - 1000 * (x.objs[0].name == 'sprig of wolfsbane')):\n102:             add_item(item)\n103: \n104:         if self._take_sacrificial_corpses:\n105:             for item in filter(self.agent.global_logic.can_sacrify, items):\n106:                 add_item(item)\n107: \n108:         # TODO: take nh.COIN_CLASS once shopping is implemented.\n109:         # You have to drop all coins not to be attacked by a vault guard\n110: \n111:         for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n112:             if item.category in [nh.POTION_CLASS, nh.RING_CLASS, nh.AMULET_CLASS, nh.WAND_CLASS, nh.SCROLL_CLASS, nh.TOOL_CLASS]:\n113:                 if (not isinstance(item.objs[0], O.Container) or not item.is_chest()) and \\\n114:                         not item.is_possible_container():\n115:                     to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n116:                              not item.is_offensive_usable_wand()\n117:                     to_bag = False\n118:                     if not item.is_container():  # remove condition to pick up bags\n119:                         add_item(item, to_bag=to_bag)\n120: \n121:         categories = [nh.WEAPON_CLASS, nh.ARMOR_CLASS, nh.TOOL_CLASS, nh.FOOD_CLASS, nh.GEM_CLASS, nh.AMULET_CLASS,\n122:                       nh.RING_CLASS, nh.POTION_CLASS, nh.SCROLL_CLASS, nh.SPBOOK_CLASS, nh.WAND_CLASS]\n123:         for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n124:             if item.category in categories and not isinstance(item.objs[0], O.Container) and not item.is_corpse():\n125:                 if item.status == Item.UNKNOWN:\n126:                     to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n127:                              not item.is_offensive_usable_wand()\n128:                     to_bag = False\n129:                     if not item.is_container():  # remove condition to pick up bags\n130:                         add_item(item, to_bag=to_bag)\n131: \n132:         r = {None: [ret_inv.get(item, 0) for item in items]}\n133:         if bag is not None:\n134:             r[bag] = [ret_bag.get(item, 0) for item in items]\n135:         for item in items:\n136:             if item.is_container() and item is not bag and ret_inv.get(item, 0) != 0:\n137:                 r[item] = [0 for _ in items]\n138:         return r\n139: \n140: \n141: class Milestone(IntEnum):\n142:     BE_ON_FIRST_LEVEL = auto()\n143:     FIND_GNOMISH_MINES = auto()\n144:     # FIND_LIGHT_GNOMISH_MINES = auto()\n145:     # FARM_LIGHT_GNOMISH_MINES = auto()\n146:     FIND_MINETOWN = auto()\n147:     FIND_SOKOBAN = auto()\n148:     SOLVE_SOKOBAN = auto()\n149:     FIND_MINES_END = auto()\n150:     GO_DOWN = auto() # TODO\n151: \n152: \n153: class GlobalLogic:\n154:     def __init__(self, agent):\n155:         self.agent = agent\n156:         self.milestone = Milestone(1)\n157:         self.step_completion_log = {}  # Milestone -> (step, turn)\n158: \n159:         self.item_priority = ItemPriority(self.agent)\n160: \n161:         self.oracle_level = None\n162:         self.minetown_level = None\n163: \n164:         self._got_artifact = False\n165: \n166:     def update(self):\n167:         if not self.agent.character.prop.hallu:\n168:             if utils.isin(self.agent.glyphs, G.ORACLE).any():\n169:                 if self.oracle_level is None:\n170:                     self.oracle_level = self.agent.current_level().key()\n171:                 else:\n172:                     assert self.oracle_level == self.agent.current_level().key()\n173: \n174:             if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n175:                     utils.isin(self.agent.glyphs, G.SHOPKEEPER).any():\n176:                 if self.minetown_level is None:\n177:                     self.minetown_level = self.agent.current_level().key()\n178:                 else:\n179:                     assert self.minetown_level == self.agent.current_level().key()\n180: \n181:     @utils.debug_log('solving sokoban')\n182:     @Strategy.wrap\n183:     def solve_sokoban_strategy(self):\n184:         # TODO: refactor\n185:         if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n186:             yield False\n187:         yield True\n188: \n189:         def push_bolder(ty, tx, dy, dx):\n190:             while 1:\n191:                 if self.agent.bfs()[ty, tx] == -1:\n192:                     return False\n193:                 self.agent.go_to(ty, tx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n194:                 with self.agent.atom_operation():\n195:                     direction = self.agent.calc_direction(ty, tx, ty + dy, tx + dx)\n196:                     self.agent.direction(direction)\n197:                     message = self.agent.message\n198: \n199:                 if (self.agent.blstats.y, self.agent.blstats.x) == (ty, tx):\n200:                     assert 'You hear a monster behind the boulder.' in message or \\\n201:                            'You try to move the boulder, but in vain.' in message, message\n202:                     if self.agent.bfs()[ty + dy, tx + dx] != -1:\n203:                         self.agent.go_to(ty + dy, tx + dx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n204:                         continue\n205:                     else:\n206:                         pickaxe = None\n207:                         for item in flatten_items(self.agent.inventory.items):\n208:                             if item.is_unambiguous() and \\\n209:                                     item.object in [O.from_name('pick-axe'), O.from_name('dwarvish mattock')]:\n210:                                 pickaxe = item\n211:                                 break\n212:                         if pickaxe is not None:\n213:                             with self.agent.atom_operation():\n214:                                 pickaxe = self.agent.inventory.move_to_inventory(pickaxe)\n215:                                 self.agent.step(A.Command.APPLY)\n216:                                 self.agent.type_text(self.agent.inventory.items.get_letter(pickaxe))\n217:                                 self.agent.direction(direction)\n218:                             return True\n219:                 else:\n220:                     return True\n221: \n222:                 # TODO: not sure what to do\n223:                 self.agent.exploration.explore1(None).run()\n224: \n225:         while 1:\n226:             wall_map = utils.isin(self.agent.current_level().objects, G.WALL)\n227:             for smap, answer in soko_solver.maps.items():\n228:                 sokomap = soko_solver.convert_map(smap)\n229:                 offset = np.array(min(zip(*wall_map.nonzero()))) - \\\n230:                          np.array(min(zip(*(sokomap.sokomap == soko_solver.WALL).nonzero())))\n231:                 mask = wall_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n232:                                 offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n233:                 if (mask & (sokomap.sokomap == soko_solver.WALL) == mask).all():\n234:                     break\n235:             else:\n236:                 assert 0, 'sokomap not found'\n237: \n238:             possible_mimics = set()\n239:             last_resort_move = None\n240:             for (y, x), (dy, dx) in answer:\n241:                 boulder_map = utils.isin(self.agent.glyphs, G.BOULDER)\n242:                 mask = boulder_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n243:                                    offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n244:                 ty, tx = offset[0] + y - dy, offset[1] + x - dx,\n245:                 soko_boulder_mask = sokomap.sokomap == soko_solver.BOULDER\n246:                 if self.agent.bfs()[ty, tx] != -1 and \\\n247:                         ((soko_boulder_mask | mask) == soko_boulder_mask).all() and \\\n248:                         self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER:\n249: \n250:                     soko_dis1 = sokomap.bfs()\n251:                     sokomap.move(y, x, dy, dx)\n252:                     soko_dis2 = sokomap.bfs()\n253: \n254:                     # see points that will no longer be accessible\n255:                     with self.agent.env.debug_log('checking for monsters'):\n256:                         to_visit_mask = self.agent.bfs() != -1\n257:                         to_visit_mask[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n258:                                       offset[1] : offset[1] + sokomap.sokomap.shape[1]] &= \\\n259:                                               (soko_dis1 != -1) & (soko_dis2 == -1)\n260: \n261:                         with self.agent.env.debug_tiles(to_visit_mask, color=(255, 0, 0, 128)):\n262:                             while to_visit_mask.any():\n263:                                 vy, vx = list(zip(*to_visit_mask.nonzero()))[0]\n264:                                 to_visit_mask[vy, vx] = 0\n265: \n266:                                 def clear_neighbors():\n267:                                     to_visit_mask[self.agent.blstats.y, self.agent.blstats.x] = 0\n268:                                     to_visit_mask[utils.isin(self.agent.glyphs, G.VISIBLE_FLOOR)] = 0\n269:                                     return not to_visit_mask[vy, vx]\n270: \n271:                                 self.agent.go_to(vy, vx, callback=clear_neighbors)\n272: \n273:                     if not push_bolder(ty, tx, dy, dx):\n274:                         continue\n275: \n276:                     possible_mimics = set()\n277:                     last_resort_move = None\n278: \n279:                     if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n280:                         return\n281: \n282:                 else:\n283:                     sokomap.move(y, x, dy, dx)\n284: \n285:                 if (~soko_boulder_mask | mask).all():\n286:                     if self.agent.bfs()[ty, tx] != -1 and \\\n287:                             self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER and \\\n288:                             last_resort_move is None:\n289:                         last_resort_move = (ty, tx, dy, dx)\n290: \n291:                     if not possible_mimics:\n292:                         for mim_y, mim_x in zip(*(~soko_boulder_mask & mask).nonzero()):\n293:                             possible_mimics.add((mim_y + offset[0], mim_x + offset[1]))\n294: \n295: \n296:             # sokoban configuration is not in the list. Check for mimics\n297:             with self.agent.env.debug_log('mimics'):\n298:                 with self.agent.env.debug_tiles(possible_mimics, color=(255, 0, 0, 128)):\n299:                     for mim_y, mim_x in sorted(possible_mimics):\n300:                         if (self.agent.bfs()[max(0, mim_y - 1) : mim_y + 2, max(0, mim_x - 1) : mim_x + 2] != -1).any():\n301:                             self.agent.go_to(mim_y, mim_x, stop_one_before=True,\n302:                                              debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n303:                             for _ in range(3):\n304:                                 self.agent.search()\n305: \n306:             # last resort move (sometimes we can see a mimic diagonally but cannot reach it)\n307:             with self.agent.env.debug_log('last_resort'):\n308:                 if last_resort_move is not None:\n309:                     ty, tx, dy, dx = last_resort_move\n310:                     push_bolder(ty, tx, dy, dx)\n311:                     continue\n312: \n313:             self.agent.stats_logger.log_event('sokoban_dropped')\n314:             self.milestone = Milestone(int(self.milestone) + 1)\n315:             raise AgentPanic('sokomap unsolvable')\n316: \n317:     @Strategy.wrap\n318:     def wait_out_unexpected_state_strategy(self):\n319:         yielded = False\n320:         while (\n321:                 self.agent.character.prop.blind or\n322:                 self.agent.character.prop.confusion or\n323:                 self.agent.character.prop.stun or\n324:                 self.agent.character.prop.hallu or\n325:                 self.agent.character.prop.polymorph):\n326:             if not yielded:\n327:                 yield True\n328:                 yielded = True\n329: \n330:             self.agent.direction('.')\n331: \n332:         if not yielded:\n333:             yield False\n334: \n335:     @utils.debug_log('identify_items_on_altar')\n336:     @Strategy.wrap\n337:     def identify_items_on_altar(self):\n338:         mask = utils.isin(self.agent.current_level().objects, G.ALTAR)\n339:         if not mask.any():\n340:             yield False\n341: \n342:         dis = self.agent.bfs()\n343:         mask &= dis != -1\n344:         if not mask.any():\n345:             yield False\n346: \n347:         yield any((item.status == Item.UNKNOWN for item in flatten_items(self.agent.inventory.items)\n348:                    if item.can_be_dropped_from_inventory()))\n349: \n350:         (ty, tx), *_ = zip(*(mask & (dis == dis[mask].min())).nonzero())\n351:         self.agent.go_to(ty, tx)\n352:         items_to_drop = [item for item in flatten_items(self.agent.inventory.items)\n353:                          if item.can_be_dropped_from_inventory() and item.status == Item.UNKNOWN]\n354:         if not items_to_drop:\n355:             raise AgentPanic('items to drop on altar vanished')\n356: \n357:         # TODO: move chunking to inventory.drop\n358:         items_to_drop = items_to_drop[:self.agent.inventory.items.free_slots()]\n359: \n360:         self.agent.inventory.drop(items_to_drop)\n361: \n362:     @utils.debug_log('dip_for_excalibur')\n363:     @Strategy.wrap\n364:     def dip_for_excalibur(self):\n365:         if self.agent.character.alignment != Character.LAWFUL or self.agent.blstats.experience_level < 5:\n366:             yield False\n367:         if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n368:                 (self.minetown_level is None or self.agent.current_level().key() == self.minetown_level):\n369:             yield False\n370: \n371:         dis = self.agent.bfs()\n372:         mask = utils.isin(self.agent.current_level().objects, G.FOUNTAIN) & (dis != -1)\n373:         if not mask.any():\n374:             yield False\n375: \n376:         def excalibur_candidate():\n377:             candidate = None\n378:             for item in flatten_items(self.agent.inventory.items):\n379:                 if item.is_unambiguous() and item.object == O.from_name('long sword'):\n380:                     if item.dmg_bonus is not None: # TODO: better condition for excalibur existance\n381:                         return None\n382:                     candidate = item\n383:             return candidate\n384: \n385:         if excalibur_candidate() is None:\n386:             yield False\n387:         yield True\n388: \n389:         self.agent.go_to(*list(zip(*mask.nonzero()))[0])\n390: \n391:         candidate = excalibur_candidate()\n392:         if candidate is None:\n393:             return\n394: \n395:         # TODO: refactor\n396:         with self.agent.atom_operation():\n397:             candidate = self.agent.inventory.move_to_inventory(candidate)\n398:             self.agent.step(A.Command.DIP)\n399:             self.agent.type_text(self.agent.inventory.items.get_letter(candidate))\n400:             if 'What do you want to dip ' in self.agent.message and 'into?' in self.agent.message:\n401:                 raise AgentPanic('no fountain here')\n402: \n403:     def can_sacrify(self, item):\n404:         if not item.is_corpse() or item.comment == 'old':\n405:             return False\n406: \n407:         mname = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mname\n408:         if (mname == 'pony' and self.agent.character.role in [Character.KNIGHT, Character.BARBARIAN]) or \\\n409:                 (mname == 'kitten' and self.agent.character.role == [Character.BARBARIAN, Character.WIZARD]) or \\\n410:                 (mname == 'little dog' and item.naming):  # little dogs are always named\n411:             # sufficient condition for being an initial pet\n412:             return False\n413: \n414:         if self.agent.character.alignment != Character.CHAOTIC:\n415:             mapping = {\n416:                 Character.HUMAN: MON.M2_HUMAN | MON.M2_WERE,\n417:                 Character.DWARF: MON.M2_DWARF,\n418:                 Character.ELF: MON.M2_ELF,\n419:                 Character.GNOME: MON.M2_GNOME,\n420:                 Character.ORC: MON.M2_ORC,\n421:             }\n422:             f2 = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mflags2\n423:             if (f2 & mapping[self.agent.character.race]) > 0:\n424:                 return False\n425: \n426:         return True\n427: \n428:     @utils.debug_log('offer_corpses')\n429:     @Strategy.wrap\n430:     def offer_corpses(self):\n431:         self.item_priority._take_sacrificial_corpses = False\n432: \n433:         if self._got_artifact:\n434:             yield False\n435: \n436:         altars = [p for p, alignment in self.agent.current_level().altars.items()\n437:                   if alignment == self.agent.character.alignment]\n438: \n439:         if not altars:\n440:             yield False\n441: \n442:         dis = self.agent.bfs()\n443:         altars = [(y, x) for y, x in altars if dis[y, x] != -1]\n444: \n445:         if not altars:\n446:             yield False\n447: \n448:         self.item_priority._take_sacrificial_corpses = True\n449: \n450:         if not any((self.can_sacrify(item) for item in flatten_items(self.agent.inventory.items))):\n451:             yield False\n452: \n453:         yield True\n454: \n455:         y, x = min(altars, key=lambda p: dis[p])\n456:         self.agent.go_to(y, x)\n457:         with self.agent.panic_if_position_changes():\n458:             while 1:\n459:                 for item in flatten_items(self.agent.inventory.items):\n460:                     if self.can_sacrify(item):\n461:                         with self.agent.atom_operation():\n462:                             item = self.agent.inventory.move_to_inventory(item)\n463:                             assert self.can_sacrify(item)\n464:                             self.agent.step(A.Command.OFFER)\n465:                             while ('There is ' in self.agent.message or 'There are ' in self.agent.message) and \\\n466:                                     ('sacrifice it?' in self.agent.message or 'sacrifice one?' in self.agent.message):\n467:                                 self.agent.type_text('n')\n468:                             assert 'What do you want to sacrifice?' in self.agent.message, self.agent.message\n469:                             self.agent.type_text(self.agent.inventory.items.get_letter(item))\n470:                             if 'Nothing happens.' in self.agent.message:\n471:                                 self.agent.inventory.call_item(item, 'old')\n472:                                 return\n473:                             if 'Use my gift wisely' in self.agent.message:\n474:                                 self._got_artifact = True\n475:                                 self.agent.inventory.get_items_below_me()\n476:                                 return\n477:                             if 'So this is how you repay loyalty?' in self.agent.message:\n478:                                 raise AgentPanic('pet sacrified')\n479:                             assert 'Your sacrifice is consumed in a flash of light' in self.agent.message or \\\n480:                                 'Your sacrifice is consumed in a burst of flame' in self.agent.message or \\\n481:                                 ('The blood covers the altar!' in self.agent.message and \\\n482:                                  'You have summoned ' in self.agent.message), \\\n483:                                 self.agent.message\n484:                             break\n485:                 else:\n486:                     break\n487: \n488:     @utils.debug_log('follow_guard')\n489:     @Strategy.wrap\n490:     def follow_guard(self):\n491:         if not utils.isin(self.agent.glyphs, G.GUARD).any():\n492:             yield False\n493: \n494:         if any(item.category == nh.COIN_CLASS for item in flatten_items(self.agent.inventory.items)):\n495:             yield True\n496:             # if 'Please drop that gold and follow me.' in self.message:\n497:             self.agent.stats_logger.log_event('drop_gold')\n498:             self.item_priority._drop_gold_till_turn = self.agent.blstats.time + 100\n499:             self.agent.inventory.arrange_items().run()\n500:             return\n501: \n502:         ys, xs = utils.isin(self.agent.glyphs, G.GUARD).nonzero()\n503:         y, x = ys[0], xs[0]\n504: \n505:         if utils.adjacent((y, x), (self.agent.blstats.y, self.agent.blstats.x)):\n506:             yield False\n507: \n508:         yield True\n509: \n510:         self.agent.go_to(y, x, stop_one_before=True)\n511: \n512:     @Strategy.wrap\n513:     def current_strategy(self):\n514:         yield True\n515:         while 1:\n516:             explore_stairs_condition = lambda: False\n517:             if self.milestone == Milestone.BE_ON_FIRST_LEVEL:\n518:                 condition = lambda: self.agent.blstats.experience_level >= 8\n519:                 # explore_stairs_condition = lambda: self.agent.inventory.items.total_nutrition() == 0 and \\\n520:                 #                                    self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY\n521:                 level = (Level.DUNGEONS_OF_DOOM, 1)\n522: \n523:             elif self.milestone == Milestone.FIND_SOKOBAN:\n524:                 condition = lambda: self.agent.current_level().dungeon_number == Level.SOKOBAN\n525:                 level = (Level.SOKOBAN, 4)\n526: \n527:             elif self.milestone == Milestone.FIND_GNOMISH_MINES:\n528:                 condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES\n529:                 level = (Level.GNOMISH_MINES, 1)\n530: \n531:             # elif self.milestone == Milestone.FIND_LIGHT_GNOMISH_MINES:\n532:             #     condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES \\\n533:             #             and self.agent.current_level().is_light_level()\n534:             #     level = (Level.GNOMISH_MINES, 9)\n535: \n536:             # elif self.milestone == Milestone.FARM_LIGHT_GNOMISH_MINES:\n537:             #     condition = lambda: self.agent.blstats.experience_level >= 11\n538:             #     level = (Level.GNOMISH_MINES, self.agent.current_level().level_number)\n539: \n540:             elif self.milestone == Milestone.FIND_MINETOWN:\n541:                 condition = lambda: self.minetown_level is not None\n542:                 level = (Level.GNOMISH_MINES, 4)  # TODO\n543: \n544:             elif self.milestone == Milestone.SOLVE_SOKOBAN:\n545:                 # TODO: fix the condition, monster can destroy doors\n546:                 condition = lambda: self.agent.current_level().key() == (Level.SOKOBAN, 1) and \\\n547:                                     not utils.isin(self.agent.current_level().objects, G.DOOR_CLOSED).any()\n548:                 level = (Level.SOKOBAN, 1)\n549: \n550:             elif self.milestone == Milestone.FIND_MINES_END:\n551:                 condition = lambda: self.agent.current_level().key() == (Level.GNOMISH_MINES, 9)  # TODO\n552:                 level = (Level.GNOMISH_MINES, 9)  # TODO\n553: \n554:             else:\n555:                 # TODO\n556:                 condition = lambda: False\n557:                 level = (Level.DUNGEONS_OF_DOOM, 100)\n558: \n559:             if condition():\n560:                 self.milestone = Milestone(int(self.milestone) + 1)\n561:                 continue\n562: \n563: \n564:             def exploration_strategy(level, **kwargs):\n565:                 return (\n566:                     Strategy(lambda: self.agent.exploration.explore1(level, trap_search_offset=1,\n567:                         kick_doors=self.agent.current_level().dungeon_number != Level.GNOMISH_MINES, **kwargs).strategy())\n568:                     .preempt(self.agent, [\n569:                         self.identify_items_on_altar().every(100),\n570:                         self.identify_items_on_altar().condition(\n571:                             lambda: self.agent.current_level().objects[self.agent.blstats.y,\n572:                                                                        self.agent.blstats.x] in G.ALTAR),\n573:                         self.dip_for_excalibur().condition(\n574:                             lambda: self.agent.blstats.experience_level >= 7).every(10),\n575:                     ])\n576:                 )\n577: \n578:             def go_to_strategy(y, x):\n579:                 return (\n580:                     exploration_strategy(None)\n581:                     .preempt(self.agent, [\n582:                         self.agent.exploration.go_to_strategy(y, x).preempt(self.agent, [\n583:                             self.agent.inventory.gather_items(),\n584:                             self.identify_items_on_altar(),\n585:                             self.dip_for_excalibur().condition(lambda: self.agent.blstats.experience_level >= 7),\n586:                         ])\n587:                         .condition(lambda: self._got_artifact or\n588:                                            not any([alignment == self.agent.character.alignment\n589:                                                     for _, alignment in self.agent.current_level().altars.items()]))\n590:                     ])\n591:                     .until(self.agent, lambda: (self.agent.blstats.y, self.agent.blstats.x) == (y, x))\n592:                 )\n593: \n594:             (\n595:                 self.agent.exploration.go_to_level_strategy(*level, go_to_strategy, exploration_strategy(None))\n596:                 .before(exploration_strategy(None))#.before(self.agent.exploration.patrol())\n597:                 .preempt(self.agent, [\n598:                     exploration_strategy(0),\n599:                     exploration_strategy(None).until(\n600:                         self.agent, lambda: self.agent.blstats.hitpoints >= 0.8 * self.agent.blstats.max_hitpoints)\n601:                 ])\n602:                 .preempt(self.agent, [\n603:                     self.agent.exploration.explore_stairs(go_to_strategy, all=True).condition(explore_stairs_condition),\n604:                 ])\n605:                 .until(self.agent, condition)\n606:             ).run()\n607: \n608:     def global_strategy(self):\n609:         return (\n610:             self.current_strategy().repeat()\n611:             .preempt(self.agent, [\n612:                 self.solve_sokoban_strategy()\n613:                 .condition(lambda: self.milestone == Milestone.SOLVE_SOKOBAN and\n614:                                    self.agent.current_level().dungeon_number == Level.SOKOBAN)\n615:             ])\n616:             .preempt(self.agent, [\n617:                 self.offer_corpses().preempt(self.agent, [\n618:                     self.agent.eat_corpses_from_ground().condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n619:                 ]),\n620:             ])\n621:             .preempt(self.agent, [\n622:                 self.wait_out_unexpected_state_strategy(),\n623:             ])\n624:             .preempt(self.agent, [\n625:                 self.agent.cure_disease().every(5),\n626:             ])\n627:             .preempt(self.agent, [\n628:                 self.agent.eat_corpses_from_ground(only_below_me=True).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n629:                 self.agent.eat_corpses_from_ground().every(5).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n630:                 self.agent.eat_from_inventory().every(5),\n631:             ])\n632:             .preempt(self.agent, [\n633:                 self.follow_guard(),\n634:             ])\n635:             .preempt(self.agent, [\n636:                 self.agent.fight2(),\n637:             ])\n638:             .preempt(self.agent, [\n639:                 self.agent.engulfed_fight(),\n640:             ])\n641:             .preempt(self.agent, [\n642:                 self.agent.emergency_strategy(),\n643:             ])\n644:         )\n\n(End of file - total 644 lines)\n</content>","metadata":{"preview":"from enum import IntEnum, auto\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\nfrom . import soko_solver\nfrom . import utils\nfrom .character import Character\nfrom .exceptions import AgentPanic\nfrom .glyph import Hunger, G, MON\nfrom .item import Item, flatten_items\nfrom .item.item_priority_base import ItemPriorityBase\nfrom .level import Level\nfrom .strategy import Strategy\n\n\nclass ItemPriority(ItemPriorityBase):\n    MAX_NUMBER_OF_ITEMS = 26 * 2 - 1  # + coin slot, one slot should be left for item arranging","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/global_logic.py","text":"from enum import IntEnum, auto\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\nfrom . import soko_solver\nfrom . import utils\nfrom .character import Character\nfrom .exceptions import AgentPanic\nfrom .glyph import Hunger, G, MON\nfrom .item import Item, flatten_items\nfrom .item.item_priority_base import ItemPriorityBase\nfrom .level import Level\nfrom .strategy import Strategy\n\n\nclass ItemPriority(ItemPriorityBase):\n    MAX_NUMBER_OF_ITEMS = 26 * 2 - 1  # + coin slot, one slot should be left for item arranging\n    def __init__(self, agent):\n        self.agent = agent\n        self._take_sacrificial_corpses = False\n        self._drop_gold_till_turn = -float('inf')\n\n    def _split(self, items, forced_items, weight_capacity):\n        remaining_weight = weight_capacity\n        ret_inv = {}\n        for item in forced_items:\n            remaining_weight -= item.weight()\n            ret_inv[item] = item.count\n\n        ret_bag = {}\n        bag = None\n\n        def add_item(item, count=None, to_bag=False):\n            nonlocal ret_inv, ret_bag, remaining_weight\n            assert isinstance(item, Item)\n            if to_bag and bag is not None and item is not bag:\n                ret = ret_bag\n            else:\n                ret = ret_inv\n\n            if remaining_weight < 0 or \\\n                    (ret is ret_inv and len(ret) >= ItemPriority.MAX_NUMBER_OF_ITEMS):  # TODO: coin slot\n                return\n\n            how_many_already_total = ret_inv.get(item, 0) + ret_bag.get(item, 0)\n            how_many_already = ret.get(item, 0)\n            max_to_add = int(remaining_weight // item.unit_weight(with_content=False))\n            if count is not None:\n                max_to_add = min(max_to_add, count)\n            ret[item] = min(item.count, how_many_already_total + max_to_add) - (how_many_already_total - how_many_already)\n            remaining_weight -= item.unit_weight(with_content=False) * (ret[item] - how_many_already)\n\n        for item in items:\n            if item.is_container() and item.status in [Item.UNCURSED, Item.BLESSED] and item.objs[0].desc == 'bag':\n                bag = item  # TODO: select the best\n                add_item(bag)\n\n        if self._drop_gold_till_turn < self.agent.blstats.time:\n            for item in items:\n                if item.category == nh.COIN_CLASS:\n                    add_item(item)\n\n        for allow_unknown_status in [False, True]:\n            item = self.agent.inventory.get_best_melee_weapon(items=forced_items + items,\n                                                              allow_unknown_status=allow_unknown_status)\n            if item is not None:\n                add_item(item)\n\n            for item in self.agent.inventory.get_best_armorset(items=forced_items + items,\n                                                               allow_unknown_status=allow_unknown_status):\n                if item is not None:\n                    add_item(item)\n\n        for item in items:\n            if item.is_unambiguous():\n                if item.object in [\n                        O.from_name('healing', nh.POTION_CLASS),\n                        O.from_name('extra healing', nh.POTION_CLASS),\n                        O.from_name('full healing', nh.POTION_CLASS)]:\n                    add_item(item)\n\n                if self.agent.character.role in [Character.RANGER, Character.ROGUE,\n                                                 Character.SAMURAI, Character.TOURIST] and \\\n                        (item.is_launcher() or item.is_fired_projectile()):\n                    add_item(item)\n\n        if self.agent.character.alignment == Character.LAWFUL:\n            for item in sorted(filter(lambda i: i.objs[0].name == 'long sword', items),\n                               key=lambda i: -utils.calc_dps(*self.agent.character.get_melee_bonus(i))):\n                add_item(item)\n                break\n\n        for item in sorted(filter(lambda i: i.is_thrown_projectile(), items),\n                           key=lambda i: -utils.calc_dps(*self.agent.character.get_ranged_bonus(None, i))):\n            add_item(item)\n\n        for item in sorted(filter(lambda i: i.is_food() and not i.is_corpse(), items),\n                           key=lambda x: -x.nutrition_per_weight() - 1000 * (x.objs[0].name == 'sprig of wolfsbane')):\n            add_item(item)\n\n        if self._take_sacrificial_corpses:\n            for item in filter(self.agent.global_logic.can_sacrify, items):\n                add_item(item)\n\n        # TODO: take nh.COIN_CLASS once shopping is implemented.\n        # You have to drop all coins not to be attacked by a vault guard\n\n        for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n            if item.category in [nh.POTION_CLASS, nh.RING_CLASS, nh.AMULET_CLASS, nh.WAND_CLASS, nh.SCROLL_CLASS, nh.TOOL_CLASS]:\n                if (not isinstance(item.objs[0], O.Container) or not item.is_chest()) and \\\n                        not item.is_possible_container():\n                    to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n                             not item.is_offensive_usable_wand()\n                    to_bag = False\n                    if not item.is_container():  # remove condition to pick up bags\n                        add_item(item, to_bag=to_bag)\n\n        categories = [nh.WEAPON_CLASS, nh.ARMOR_CLASS, nh.TOOL_CLASS, nh.FOOD_CLASS, nh.GEM_CLASS, nh.AMULET_CLASS,\n                      nh.RING_CLASS, nh.POTION_CLASS, nh.SCROLL_CLASS, nh.SPBOOK_CLASS, nh.WAND_CLASS]\n        for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n            if item.category in categories and not isinstance(item.objs[0], O.Container) and not item.is_corpse():\n                if item.status == Item.UNKNOWN:\n                    to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n                             not item.is_offensive_usable_wand()\n                    to_bag = False\n                    if not item.is_container():  # remove condition to pick up bags\n                        add_item(item, to_bag=to_bag)\n\n        r = {None: [ret_inv.get(item, 0) for item in items]}\n        if bag is not None:\n            r[bag] = [ret_bag.get(item, 0) for item in items]\n        for item in items:\n            if item.is_container() and item is not bag and ret_inv.get(item, 0) != 0:\n                r[item] = [0 for _ in items]\n        return r\n\n\nclass Milestone(IntEnum):\n    BE_ON_FIRST_LEVEL = auto()\n    FIND_GNOMISH_MINES = auto()\n    # FIND_LIGHT_GNOMISH_MINES = auto()\n    # FARM_LIGHT_GNOMISH_MINES = auto()\n    FIND_MINETOWN = auto()\n    FIND_SOKOBAN = auto()\n    SOLVE_SOKOBAN = auto()\n    FIND_MINES_END = auto()\n    GO_DOWN = auto() # TODO\n\n\nclass GlobalLogic:\n    def __init__(self, agent):\n        self.agent = agent\n        self.milestone = Milestone(1)\n        self.step_completion_log = {}  # Milestone -> (step, turn)\n\n        self.item_priority = ItemPriority(self.agent)\n\n        self.oracle_level = None\n        self.minetown_level = None\n\n        self._got_artifact = False\n\n    def update(self):\n        if not self.agent.character.prop.hallu:\n            if utils.isin(self.agent.glyphs, G.ORACLE).any():\n                if self.oracle_level is None:\n                    self.oracle_level = self.agent.current_level().key()\n                else:\n                    assert self.oracle_level == self.agent.current_level().key()\n\n            if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n                    utils.isin(self.agent.glyphs, G.SHOPKEEPER).any():\n                if self.minetown_level is None:\n                    self.minetown_level = self.agent.current_level().key()\n                else:\n                    assert self.minetown_level == self.agent.current_level().key()\n\n    @utils.debug_log('solving sokoban')\n    @Strategy.wrap\n    def solve_sokoban_strategy(self):\n        # TODO: refactor\n        if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n            yield False\n        yield True\n\n        def push_bolder(ty, tx, dy, dx):\n            while 1:\n                if self.agent.bfs()[ty, tx] == -1:\n                    return False\n                self.agent.go_to(ty, tx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n                with self.agent.atom_operation():\n                    direction = self.agent.calc_direction(ty, tx, ty + dy, tx + dx)\n                    self.agent.direction(direction)\n                    message = self.agent.message\n\n                if (self.agent.blstats.y, self.agent.blstats.x) == (ty, tx):\n                    assert 'You hear a monster behind the boulder.' in message or \\\n                           'You try to move the boulder, but in vain.' in message, message\n                    if self.agent.bfs()[ty + dy, tx + dx] != -1:\n                        self.agent.go_to(ty + dy, tx + dx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n                        continue\n                    else:\n                        pickaxe = None\n                        for item in flatten_items(self.agent.inventory.items):\n                            if item.is_unambiguous() and \\\n                                    item.object in [O.from_name('pick-axe'), O.from_name('dwarvish mattock')]:\n                                pickaxe = item\n                                break\n                        if pickaxe is not None:\n                            with self.agent.atom_operation():\n                                pickaxe = self.agent.inventory.move_to_inventory(pickaxe)\n                                self.agent.step(A.Command.APPLY)\n                                self.agent.type_text(self.agent.inventory.items.get_letter(pickaxe))\n                                self.agent.direction(direction)\n                            return True\n                else:\n                    return True\n\n                # TODO: not sure what to do\n                self.agent.exploration.explore1(None).run()\n\n        while 1:\n            wall_map = utils.isin(self.agent.current_level().objects, G.WALL)\n            for smap, answer in soko_solver.maps.items():\n                sokomap = soko_solver.convert_map(smap)\n                offset = np.array(min(zip(*wall_map.nonzero()))) - \\\n                         np.array(min(zip(*(sokomap.sokomap == soko_solver.WALL).nonzero())))\n                mask = wall_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n                if (mask & (sokomap.sokomap == soko_solver.WALL) == mask).all():\n                    break\n            else:\n                assert 0, 'sokomap not found'\n\n            possible_mimics = set()\n            last_resort_move = None\n            for (y, x), (dy, dx) in answer:\n                boulder_map = utils.isin(self.agent.glyphs, G.BOULDER)\n                mask = boulder_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                   offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n                ty, tx = offset[0] + y - dy, offset[1] + x - dx,\n                soko_boulder_mask = sokomap.sokomap == soko_solver.BOULDER\n                if self.agent.bfs()[ty, tx] != -1 and \\\n                        ((soko_boulder_mask | mask) == soko_boulder_mask).all() and \\\n                        self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER:\n\n                    soko_dis1 = sokomap.bfs()\n                    sokomap.move(y, x, dy, dx)\n                    soko_dis2 = sokomap.bfs()\n\n                    # see points that will no longer be accessible\n                    with self.agent.env.debug_log('checking for monsters'):\n                        to_visit_mask = self.agent.bfs() != -1\n                        to_visit_mask[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                      offset[1] : offset[1] + sokomap.sokomap.shape[1]] &= \\\n                                              (soko_dis1 != -1) & (soko_dis2 == -1)\n\n                        with self.agent.env.debug_tiles(to_visit_mask, color=(255, 0, 0, 128)):\n                            while to_visit_mask.any():\n                                vy, vx = list(zip(*to_visit_mask.nonzero()))[0]\n                                to_visit_mask[vy, vx] = 0\n\n                                def clear_neighbors():\n                                    to_visit_mask[self.agent.blstats.y, self.agent.blstats.x] = 0\n                                    to_visit_mask[utils.isin(self.agent.glyphs, G.VISIBLE_FLOOR)] = 0\n                                    return not to_visit_mask[vy, vx]\n\n                                self.agent.go_to(vy, vx, callback=clear_neighbors)\n\n                    if not push_bolder(ty, tx, dy, dx):\n                        continue\n\n                    possible_mimics = set()\n                    last_resort_move = None\n\n                    if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n                        return\n\n                else:\n                    sokomap.move(y, x, dy, dx)\n\n                if (~soko_boulder_mask | mask).all():\n                    if self.agent.bfs()[ty, tx] != -1 and \\\n                            self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER and \\\n                            last_resort_move is None:\n                        last_resort_move = (ty, tx, dy, dx)\n\n                    if not possible_mimics:\n                        for mim_y, mim_x in zip(*(~soko_boulder_mask & mask).nonzero()):\n                            possible_mimics.add((mim_y + offset[0], mim_x + offset[1]))\n\n\n            # sokoban configuration is not in the list. Check for mimics\n            with self.agent.env.debug_log('mimics'):\n                with self.agent.env.debug_tiles(possible_mimics, color=(255, 0, 0, 128)):\n                    for mim_y, mim_x in sorted(possible_mimics):\n                        if (self.agent.bfs()[max(0, mim_y - 1) : mim_y + 2, max(0, mim_x - 1) : mim_x + 2] != -1).any():\n                            self.agent.go_to(mim_y, mim_x, stop_one_before=True,\n                                             debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n                            for _ in range(3):\n                                self.agent.search()\n\n            # last resort move (sometimes we can see a mimic diagonally but cannot reach it)\n            with self.agent.env.debug_log('last_resort'):\n                if last_resort_move is not None:\n                    ty, tx, dy, dx = last_resort_move\n                    push_bolder(ty, tx, dy, dx)\n                    continue\n\n            self.agent.stats_logger.log_event('sokoban_dropped')\n            self.milestone = Milestone(int(self.milestone) + 1)\n            raise AgentPanic('sokomap unsolvable')\n\n    @Strategy.wrap\n    def wait_out_unexpected_state_strategy(self):\n        yielded = False\n        while (\n                self.agent.character.prop.blind or\n                self.agent.character.prop.confusion or\n                self.agent.character.prop.stun or\n                self.agent.character.prop.hallu or\n                self.agent.character.prop.polymorph):\n            if not yielded:\n                yield True\n                yielded = True\n\n            self.agent.direction('.')\n\n        if not yielded:\n            yield False\n\n    @utils.debug_log('identify_items_on_altar')\n    @Strategy.wrap\n    def identify_items_on_altar(self):\n        mask = utils.isin(self.agent.current_level().objects, G.ALTAR)\n        if not mask.any():\n            yield False\n\n        dis = self.agent.bfs()\n        mask &= dis != -1\n        if not mask.any():\n            yield False\n\n        yield any((item.status == Item.UNKNOWN for item in flatten_items(self.agent.inventory.items)\n                   if item.can_be_dropped_from_inventory()))\n\n        (ty, tx), *_ = zip(*(mask & (dis == dis[mask].min())).nonzero())\n        self.agent.go_to(ty, tx)\n        items_to_drop = [item for item in flatten_items(self.agent.inventory.items)\n                         if item.can_be_dropped_from_inventory() and item.status == Item.UNKNOWN]\n        if not items_to_drop:\n            raise AgentPanic('items to drop on altar vanished')\n\n        # TODO: move chunking to inventory.drop\n        items_to_drop = items_to_drop[:self.agent.inventory.items.free_slots()]\n\n        self.agent.inventory.drop(items_to_drop)\n\n    @utils.debug_log('dip_for_excalibur')\n    @Strategy.wrap\n    def dip_for_excalibur(self):\n        if self.agent.character.alignment != Character.LAWFUL or self.agent.blstats.experience_level < 5:\n            yield False\n        if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n                (self.minetown_level is None or self.agent.current_level().key() == self.minetown_level):\n            yield False\n\n        dis = self.agent.bfs()\n        mask = utils.isin(self.agent.current_level().objects, G.FOUNTAIN) & (dis != -1)\n        if not mask.any():\n            yield False\n\n        def excalibur_candidate():\n            candidate = None\n            for item in flatten_items(self.agent.inventory.items):\n                if item.is_unambiguous() and item.object == O.from_name('long sword'):\n                    if item.dmg_bonus is not None: # TODO: better condition for excalibur existance\n                        return None\n                    candidate = item\n            return candidate\n\n        if excalibur_candidate() is None:\n            yield False\n        yield True\n\n        self.agent.go_to(*list(zip(*mask.nonzero()))[0])\n\n        candidate = excalibur_candidate()\n        if candidate is None:\n            return\n\n        # TODO: refactor\n        with self.agent.atom_operation():\n            candidate = self.agent.inventory.move_to_inventory(candidate)\n            self.agent.step(A.Command.DIP)\n            self.agent.type_text(self.agent.inventory.items.get_letter(candidate))\n            if 'What do you want to dip ' in self.agent.message and 'into?' in self.agent.message:\n                raise AgentPanic('no fountain here')\n\n    def can_sacrify(self, item):\n        if not item.is_corpse() or item.comment == 'old':\n            return False\n\n        mname = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mname\n        if (mname == 'pony' and self.agent.character.role in [Character.KNIGHT, Character.BARBARIAN]) or \\\n                (mname == 'kitten' and self.agent.character.role == [Character.BARBARIAN, Character.WIZARD]) or \\\n                (mname == 'little dog' and item.naming):  # little dogs are always named\n            # sufficient condition for being an initial pet\n            return False\n\n        if self.agent.character.alignment != Character.CHAOTIC:\n            mapping = {\n                Character.HUMAN: MON.M2_HUMAN | MON.M2_WERE,\n                Character.DWARF: MON.M2_DWARF,\n                Character.ELF: MON.M2_ELF,\n                Character.GNOME: MON.M2_GNOME,\n                Character.ORC: MON.M2_ORC,\n            }\n            f2 = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mflags2\n            if (f2 & mapping[self.agent.character.race]) > 0:\n                return False\n\n        return True\n\n    @utils.debug_log('offer_corpses')\n    @Strategy.wrap\n    def offer_corpses(self):\n        self.item_priority._take_sacrificial_corpses = False\n\n        if self._got_artifact:\n            yield False\n\n        altars = [p for p, alignment in self.agent.current_level().altars.items()\n                  if alignment == self.agent.character.alignment]\n\n        if not altars:\n            yield False\n\n        dis = self.agent.bfs()\n        altars = [(y, x) for y, x in altars if dis[y, x] != -1]\n\n        if not altars:\n            yield False\n\n        self.item_priority._take_sacrificial_corpses = True\n\n        if not any((self.can_sacrify(item) for item in flatten_items(self.agent.inventory.items))):\n            yield False\n\n        yield True\n\n        y, x = min(altars, key=lambda p: dis[p])\n        self.agent.go_to(y, x)\n        with self.agent.panic_if_position_changes():\n            while 1:\n                for item in flatten_items(self.agent.inventory.items):\n                    if self.can_sacrify(item):\n                        with self.agent.atom_operation():\n                            item = self.agent.inventory.move_to_inventory(item)\n                            assert self.can_sacrify(item)\n                            self.agent.step(A.Command.OFFER)\n                            while ('There is ' in self.agent.message or 'There are ' in self.agent.message) and \\\n                                    ('sacrifice it?' in self.agent.message or 'sacrifice one?' in self.agent.message):\n                                self.agent.type_text('n')\n                            assert 'What do you want to sacrifice?' in self.agent.message, self.agent.message\n                            self.agent.type_text(self.agent.inventory.items.get_letter(item))\n                            if 'Nothing happens.' in self.agent.message:\n                                self.agent.inventory.call_item(item, 'old')\n                                return\n                            if 'Use my gift wisely' in self.agent.message:\n                                self._got_artifact = True\n                                self.agent.inventory.get_items_below_me()\n                                return\n                            if 'So this is how you repay loyalty?' in self.agent.message:\n                                raise AgentPanic('pet sacrified')\n                            assert 'Your sacrifice is consumed in a flash of light' in self.agent.message or \\\n                                'Your sacrifice is consumed in a burst of flame' in self.agent.message or \\\n                                ('The blood covers the altar!' in self.agent.message and \\\n                                 'You have summoned ' in self.agent.message), \\\n                                self.agent.message\n                            break\n                else:\n                    break\n\n    @utils.debug_log('follow_guard')\n    @Strategy.wrap\n    def follow_guard(self):\n        if not utils.isin(self.agent.glyphs, G.GUARD).any():\n            yield False\n\n        if any(item.category == nh.COIN_CLASS for item in flatten_items(self.agent.inventory.items)):\n            yield True\n            # if 'Please drop that gold and follow me.' in self.message:\n            self.agent.stats_logger.log_event('drop_gold')\n            self.item_priority._drop_gold_till_turn = self.agent.blstats.time + 100\n            self.agent.inventory.arrange_items().run()\n            return\n\n        ys, xs = utils.isin(self.agent.glyphs, G.GUARD).nonzero()\n        y, x = ys[0], xs[0]\n\n        if utils.adjacent((y, x), (self.agent.blstats.y, self.agent.blstats.x)):\n            yield False\n\n        yield True\n\n        self.agent.go_to(y, x, stop_one_before=True)\n\n    @Strategy.wrap\n    def current_strategy(self):\n        yield True\n        while 1:\n            explore_stairs_condition = lambda: False\n            if self.milestone == Milestone.BE_ON_FIRST_LEVEL:\n                condition = lambda: self.agent.blstats.experience_level >= 8\n                # explore_stairs_condition = lambda: self.agent.inventory.items.total_nutrition() == 0 and \\\n                #                                    self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY\n                level = (Level.DUNGEONS_OF_DOOM, 1)\n\n            elif self.milestone == Milestone.FIND_SOKOBAN:\n                condition = lambda: self.agent.current_level().dungeon_number == Level.SOKOBAN\n                level = (Level.SOKOBAN, 4)\n\n            elif self.milestone == Milestone.FIND_GNOMISH_MINES:\n                condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES\n                level = (Level.GNOMISH_MINES, 1)\n\n            # elif self.milestone == Milestone.FIND_LIGHT_GNOMISH_MINES:\n            #     condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES \\\n            #             and self.agent.current_level().is_light_level()\n            #     level = (Level.GNOMISH_MINES, 9)\n\n            # elif self.milestone == Milestone.FARM_LIGHT_GNOMISH_MINES:\n            #     condition = lambda: self.agent.blstats.experience_level >= 11\n            #     level = (Level.GNOMISH_MINES, self.agent.current_level().level_number)\n\n            elif self.milestone == Milestone.FIND_MINETOWN:\n                condition = lambda: self.minetown_level is not None\n                level = (Level.GNOMISH_MINES, 4)  # TODO\n\n            elif self.milestone == Milestone.SOLVE_SOKOBAN:\n                # TODO: fix the condition, monster can destroy doors\n                condition = lambda: self.agent.current_level().key() == (Level.SOKOBAN, 1) and \\\n                                    not utils.isin(self.agent.current_level().objects, G.DOOR_CLOSED).any()\n                level = (Level.SOKOBAN, 1)\n\n            elif self.milestone == Milestone.FIND_MINES_END:\n                condition = lambda: self.agent.current_level().key() == (Level.GNOMISH_MINES, 9)  # TODO\n                level = (Level.GNOMISH_MINES, 9)  # TODO\n\n            else:\n                # TODO\n                condition = lambda: False\n                level = (Level.DUNGEONS_OF_DOOM, 100)\n\n            if condition():\n                self.milestone = Milestone(int(self.milestone) + 1)\n                continue\n\n\n            def exploration_strategy(level, **kwargs):\n                return (\n                    Strategy(lambda: self.agent.exploration.explore1(level, trap_search_offset=1,\n                        kick_doors=self.agent.current_level().dungeon_number != Level.GNOMISH_MINES, **kwargs).strategy())\n                    .preempt(self.agent, [\n                        self.identify_items_on_altar().every(100),\n                        self.identify_items_on_altar().condition(\n                            lambda: self.agent.current_level().objects[self.agent.blstats.y,\n                                                                       self.agent.blstats.x] in G.ALTAR),\n                        self.dip_for_excalibur().condition(\n                            lambda: self.agent.blstats.experience_level >= 7).every(10),\n                    ])\n                )\n\n            def go_to_strategy(y, x):\n                return (\n                    exploration_strategy(None)\n                    .preempt(self.agent, [\n                        self.agent.exploration.go_to_strategy(y, x).preempt(self.agent, [\n                            self.agent.inventory.gather_items(),\n                            self.identify_items_on_altar(),\n                            self.dip_for_excalibur().condition(lambda: self.agent.blstats.experience_level >= 7),\n                        ])\n                        .condition(lambda: self._got_artifact or\n                                           not any([alignment == self.agent.character.alignment\n                                                    for _, alignment in self.agent.current_level().altars.items()]))\n                    ])\n                    .until(self.agent, lambda: (self.agent.blstats.y, self.agent.blstats.x) == (y, x))\n                )\n\n            (\n                self.agent.exploration.go_to_level_strategy(*level, go_to_strategy, exploration_strategy(None))\n                .before(exploration_strategy(None))#.before(self.agent.exploration.patrol())\n                .preempt(self.agent, [\n                    exploration_strategy(0),\n                    exploration_strategy(None).until(\n                        self.agent, lambda: self.agent.blstats.hitpoints >= 0.8 * self.agent.blstats.max_hitpoints)\n                ])\n                .preempt(self.agent, [\n                    self.agent.exploration.explore_stairs(go_to_strategy, all=True).condition(explore_stairs_condition),\n                ])\n                .until(self.agent, condition)\n            ).run()\n\n    def global_strategy(self):\n        return (\n            self.current_strategy().repeat()\n            .preempt(self.agent, [\n                self.solve_sokoban_strategy()\n                .condition(lambda: self.milestone == Milestone.SOLVE_SOKOBAN and\n                                   self.agent.current_level().dungeon_number == Level.SOKOBAN)\n            ])\n            .preempt(self.agent, [\n                self.offer_corpses().preempt(self.agent, [\n                    self.agent.eat_corpses_from_ground().condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                ]),\n            ])\n            .preempt(self.agent, [\n                self.wait_out_unexpected_state_strategy(),\n            ])\n            .preempt(self.agent, [\n                self.agent.cure_disease().every(5),\n            ])\n            .preempt(self.agent, [\n                self.agent.eat_corpses_from_ground(only_below_me=True).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                self.agent.eat_corpses_from_ground().every(5).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                self.agent.eat_from_inventory().every(5),\n            ])\n            .preempt(self.agent, [\n                self.follow_guard(),\n            ])\n            .preempt(self.agent, [\n                self.agent.fight2(),\n            ])\n            .preempt(self.agent, [\n                self.agent.engulfed_fight(),\n            ])\n            .preempt(self.agent, [\n                self.agent.emergency_strategy(),\n            ])\n        )","lineStart":1,"lineEnd":644,"totalLines":644,"truncated":false}},"title":"workspace/autoascend/global_logic.py","time":{"start":1790707936157,"end":1790707936164}},"id":"prt_0ee82ab9b001KRSi3iptkXQ4TC","sessionID":"ses_f117d708affeghrZ43p7nR0Pzo","messageID":"msg_0ee82a3df001010aGxarF0s00c"}}
{"type":"tool_use","timestamp":1790707936263,"sessionID":"ses_f117d708affeghrZ43p7nR0Pzo","part":{"type":"tool","tool":"read","callID":"call_function_nb39yobzzfyx_2","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/character.py"},"output":"<path>/workspace/autoascend/character.py</path>\n<type>file</type>\n<content>\n1: import re\n2: \n3: import nle.nethack as nh\n4: import numpy as np\n5: from nle.nethack import actions as A\n6: \n7: from . import objects as O\n8: \n9: ALL_SPELL_NAMES = [\n10:     \"force bolt\",\n11:     \"drain life\",\n12:     \"magic missile\",\n13:     \"cone of cold\",\n14:     \"fireball\",\n15:     \"finger of death\",\n16:     \"protection\",\n17:     \"create monster\",\n18:     \"remove curse\",\n19:     \"create familiar\",\n20:     \"turn undead\",\n21:     \"detect monsters\",\n22:     \"light\",\n23:     \"detect food\",\n24:     \"clairvoyance\",\n25:     \"detect unseen\",\n26:     \"identify\",\n27:     \"detect treasure\",\n28:     \"magic mapping\",\n29:     \"sleep\",\n30:     \"confuse monster\",\n31:     \"slow monster\",\n32:     \"cause fear\",\n33:     \"charm monster\",\n34:     \"jumping\",\n35:     \"haste self\",\n36:     \"invisibility\",\n37:     \"levitation\",\n38:     \"teleport away\",\n39:     \"healing\",\n40:     \"cure blindness\",\n41:     \"cure sickness\",\n42:     \"extra healing\",\n43:     \"stone to flesh\",\n44:     \"restore ability\",\n45:     \"knock\",\n46:     \"wizard lock\",\n47:     \"dig\",\n48:     \"polymorph\",\n49:     \"cancellation\",\n50: ]\n51: \n52: ALL_SPELL_CATEGORIES = [\n53:     \"attack\",\n54:     \"healing\",\n55:     \"divination\",\n56:     \"enchantment\",\n57:     \"clerical\",\n58:     \"escape\",\n59:     \"matter\",\n60: ]\n61: \n62: \n63: class Property:\n64:     def __init__(self, agent):\n65:         self.agent = agent\n66: \n67:     @property\n68:     def confusion(self):\n69:         return 'Conf' in bytes(self.agent.last_observation['tty_chars'][-1]).decode()\n70: \n71:     @property\n72:     def stun(self):\n73:         return 'Stun' in bytes(self.agent.last_observation['tty_chars'][-1]).decode()\n74: \n75:     @property\n76:     def hallu(self):\n77:         return 'Hallu' in bytes(self.agent.last_observation['tty_chars'][-1]).decode()\n78: \n79:     @property\n80:     def blind(self):\n81:         return 'Blind' in bytes(self.agent.last_observation['tty_chars'][-1]).decode()\n82: \n83:     @property\n84:     def polymorph(self):\n85:         if not nh.glyph_is_monster(self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]):\n86:             return False\n87:         return self.agent.character.self_glyph != self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n88: \n89: \n90: class Character:\n91:     UNKNOWN = -1  # for everything, e.g. alignment\n92: \n93:     ARCHEOLOGIST = 0\n94:     BARBARIAN = 1\n95:     CAVEMAN = 2\n96:     HEALER = 3\n97:     KNIGHT = 4\n98:     MONK = 5\n99:     PRIEST = 6\n100:     RANGER = 7\n101:     ROGUE = 8\n102:     SAMURAI = 9\n103:     TOURIST = 10\n104:     VALKYRIE = 11\n105:     WIZARD = 12\n106: \n107:     name_to_role = {\n108:         'Archeologist': ARCHEOLOGIST,\n109:         'Barbarian': BARBARIAN,\n110:         'Caveman': CAVEMAN,\n111:         'Cavewoman': CAVEMAN,\n112:         'Healer': HEALER,\n113:         'Knight': KNIGHT,\n114:         'Monk': MONK,\n115:         'Priest': PRIEST,\n116:         'Priestess': PRIEST,\n117:         'Ranger': RANGER,\n118:         'Rogue': ROGUE,\n119:         'Samurai': SAMURAI,\n120:         'Tourist': TOURIST,\n121:         'Valkyrie': VALKYRIE,\n122:         'Wizard': WIZARD,\n123:     }\n124: \n125:     CHAOTIC = 0\n126:     NEUTRAL = 1\n127:     LAWFUL = 2\n128:     UNALIGNED = 3\n129: \n130:     name_to_alignment = {\n131:         'chaotic': CHAOTIC,\n132:         'neutral': NEUTRAL,\n133:         'lawful': LAWFUL,\n134:         'unaligned': UNALIGNED,\n135:     }\n136: \n137:     HUMAN = 0\n138:     DWARF = 1\n139:     ELF = 2\n140:     GNOME = 3\n141:     ORC = 4\n142: \n143:     name_to_race = {\n144:         'human': HUMAN,\n145:         'dwarf': DWARF,\n146:         'dwarven': DWARF,\n147:         'elf': ELF,\n148:         'elven': ELF,\n149:         'gnome': GNOME,\n150:         'gnomish': GNOME,\n151:         'orc': ORC,\n152:         'orcish': ORC,\n153:     }\n154: \n155:     MALE = 0\n156:     FEMALE = 1\n157: \n158:     name_to_gender = {\n159:         'male': MALE,\n160:         'female': FEMALE,\n161:     }\n162: \n163:     name_to_skill_type = {\n164:         # \"\": O.P_NONE,\n165:         \"dagger\": O.P_DAGGER,\n166:         \"knife\": O.P_KNIFE,\n167:         \"axe\": O.P_AXE,\n168:         \"pick-axe\": O.P_PICK_AXE,\n169:         \"short sword\": O.P_SHORT_SWORD,\n170:         \"broadsword\": O.P_BROAD_SWORD,\n171:         \"long sword\": O.P_LONG_SWORD,\n172:         \"two-handed sword\": O.P_TWO_HANDED_SWORD,\n173:         \"scimitar\": O.P_SCIMITAR,\n174:         \"saber\": O.P_SABER,\n175:         \"club\": O.P_CLUB,\n176:         \"mace\": O.P_MACE,\n177:         \"morning star\": O.P_MORNING_STAR,\n178:         \"flail\": O.P_FLAIL,\n179:         \"hammer\": O.P_HAMMER,\n180:         \"quarterstaff\": O.P_QUARTERSTAFF,\n181:         \"polearms\": O.P_POLEARMS,\n182:         \"spear\": O.P_SPEAR,\n183:         \"trident\": O.P_TRIDENT,\n184:         \"lance\": O.P_LANCE,\n185:         \"bow\": O.P_BOW,\n186:         \"sling\": O.P_SLING,\n187:         \"crossbow\": O.P_CROSSBOW,\n188:         \"dart\": O.P_DART,\n189:         \"shuriken\": O.P_SHURIKEN,\n190:         \"boomerang\": O.P_BOOMERANG,\n191:         \"whip\": O.P_WHIP,\n192:         \"unicorn horn\": O.P_UNICORN_HORN,\n193: \n194:         \"attack spells\": O.P_ATTACK_SPELL,\n195:         \"healing spells\": O.P_HEALING_SPELL,\n196:         \"divination spells\": O.P_DIVINATION_SPELL,\n197:         \"enchantment spells\": O.P_ENCHANTMENT_SPELL,\n198:         \"clerical spells\": O.P_CLERIC_SPELL,\n199:         \"escape spells\": O.P_ESCAPE_SPELL,\n200:         \"matter spells\": O.P_MATTER_SPELL,\n201: \n202:         \"bare handed combat\": O.P_BARE_HANDED_COMBAT,\n203:         \"martial arts\": O.P_BARE_HANDED_COMBAT,\n204:         \"two weapon combat\": O.P_TWO_WEAPON_COMBAT,\n205:         \"riding\": O.P_RIDING,\n206:     }\n207: \n208:     possible_skill_types = ['Fighting Skills', 'Weapon Skills', 'Spellcasting Skills']\n209:     possible_skill_levels = ['Unskilled', 'Basic', 'Skilled', 'Expert', 'Master', 'Grand Master']\n210: \n211:     SKILL_LEVEL_RESTRICTED = 0\n212:     SKILL_LEVEL_UNSKILLED = 1\n213:     SKILL_LEVEL_BASIC = 2\n214:     SKILL_LEVEL_SKILLED = 3\n215:     SKILL_LEVEL_EXPERT = 4\n216:     SKILL_LEVEL_MASTER = 5\n217:     SKILL_LEVEL_GRAND_MASTER = 6\n218: \n219:     weapon_bonus = {\n220:         SKILL_LEVEL_RESTRICTED: (-4, 2),\n221:         SKILL_LEVEL_UNSKILLED: (-4, 2),\n222:         SKILL_LEVEL_BASIC: (0, 0),\n223:         SKILL_LEVEL_SKILLED: (2, 1),\n224:         SKILL_LEVEL_EXPERT: (3, 2),\n225:     }\n226:     two_weapon_bonus = {\n227:         SKILL_LEVEL_RESTRICTED: (-9, -3),\n228:         SKILL_LEVEL_UNSKILLED: (-9, -3),\n229:         SKILL_LEVEL_BASIC: (-7, -1),\n230:         SKILL_LEVEL_SKILLED: (-5, 0),\n231:         SKILL_LEVEL_EXPERT: (-3, 1),\n232:     }\n233:     riding_bonus = {\n234:         SKILL_LEVEL_RESTRICTED: (-2, 0),\n235:         SKILL_LEVEL_UNSKILLED: (-2, 0),\n236:         SKILL_LEVEL_BASIC: (-1, 0),\n237:         SKILL_LEVEL_SKILLED: (0, 1),\n238:         SKILL_LEVEL_EXPERT: (0, 2),\n239:     }\n240:     unarmed_bonus = {\n241:         SKILL_LEVEL_RESTRICTED: (1, 0),\n242:         SKILL_LEVEL_UNSKILLED: (1, 0),\n243:         SKILL_LEVEL_BASIC: (1, 1),\n244:         SKILL_LEVEL_SKILLED: (2, 1),\n245:         SKILL_LEVEL_EXPERT: (2, 2),\n246:         SKILL_LEVEL_MASTER: (3, 2),\n247:         SKILL_LEVEL_GRAND_MASTER: (3, 3),\n248:     }\n249:     martial_bonus = {\n250:         SKILL_LEVEL_RESTRICTED: (1, 0),  # no one has it restricted\n251:         SKILL_LEVEL_UNSKILLED: (2, 1),\n252:         SKILL_LEVEL_BASIC: (3, 3),\n253:         SKILL_LEVEL_SKILLED: (4, 4),\n254:         SKILL_LEVEL_EXPERT: (5, 6),\n255:         SKILL_LEVEL_MASTER: (6, 7),\n256:         SKILL_LEVEL_GRAND_MASTER: (7, 9),\n257:     }\n258: \n259:     name_to_skill_level = {k: v for k, v in zip(['Restricted'] + possible_skill_levels,\n260:                                                 [SKILL_LEVEL_RESTRICTED,\n261:                                                  SKILL_LEVEL_UNSKILLED, SKILL_LEVEL_BASIC, SKILL_LEVEL_SKILLED,\n262:                                                  SKILL_LEVEL_EXPERT,\n263:                                                  SKILL_LEVEL_MASTER, SKILL_LEVEL_GRAND_MASTER])}\n264: \n265:     def __init__(self, agent):\n266:         self.agent = agent\n267:         self.prop = Property(agent)\n268:         self.role = None\n269:         self.alignment = None\n270:         self.race = None\n271:         self.gender = None\n272:         self.self_glyph = None\n273:         self.skill_levels = np.zeros(max(self.name_to_skill_type.values()) + 1, dtype=int)\n274:         self.upgradable_skills = dict()\n275: \n276:         self.is_lycanthrope = False\n277: \n278:     def update(self):\n279:         if 'You feel feverish.' in self.agent.message:\n280:             self.is_lycanthrope = True\n281:         if 'You feel purified.' in self.agent.message:\n282:             self.is_lycanthrope = False\n283: \n284:     @property\n285:     def carrying_capacity(self):\n286:         # TODO: levitation, etc\n287:         return min(1000, (self.agent.blstats.strength_percentage + self.agent.blstats.constitution) * 25 + 50)\n288: \n289:     def parse(self):\n290:         with self.agent.atom_operation():\n291:             self.agent.step(A.Command.ATTRIBUTES)\n292:             text = ' '.join(self.agent.popup)\n293:             self._parse(text)\n294:             self.self_glyph = self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n295: \n296:     def _parse(self, text):\n297:         matches = re.findall('You are a ([a-z]+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+).', text)\n298:         if len(matches) == 1:\n299:             alignment, _, gender, race, role = matches[0]\n300:         else:\n301:             matches = re.findall(\n302:                 'You are an? ([a-zA-Z ]+), a level (\\d+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+). *You are ([a-z]+)',\n303:                 text)\n304:             assert len(matches) == 1, repr(text)\n305:             _, _, _, gender, race, role, alignment = matches[0]\n306: \n307:         if not gender:\n308:             if role == 'Priestess':\n309:                 gender = 'female'\n310:             elif role == 'Priest':\n311:                 gender = 'male'\n312:             elif role == 'Caveman':\n313:                 gender = 'male'\n314:             elif role == 'Cavewoman':\n315:                 gender = 'female'\n316:             elif role == 'Valkyrie':\n317:                 gender = 'female'\n318:             else:\n319:                 assert 0, repr(text)\n320: \n321:         self.role = self.name_to_role[role]\n322:         self.alignment = self.name_to_alignment[alignment]\n323:         self.race = self.name_to_race[race]\n324:         self.gender = self.name_to_gender[gender]\n325: \n326:     def parse_spellcast_view(self):\n327:         self.known_spells = dict()\n328:         self.spell_fail_chance = dict()\n329: \n330:         # TODO: parse for other spellcaster classes\n331:         if self.role not in (self.HEALER,):\n332:             return\n333: \n334:         with self.agent.atom_operation():\n335:             self.agent.step(A.Command.CAST)\n336:             if not self.agent.popup:\n337:                 self.known_spells[self.agent.message] = None\n338:                 return\n339:             if self.agent.popup[0] not in ('Choose which spell to cast') or \\\n340:                     not self.agent.popup[1].startswith('Name'):\n341:                 raise ValueError(f'Invalid cast popup text format: {self.agent.popup}')\n342:             for line in self.agent.popup[2:]:\n343:                 matches = re.findall(r'^([a-zA-Z]) - *' +\n344:                                      r'(' + '|'.join(ALL_SPELL_NAMES) + ') *' +\n345:                                      r'([0-9]*) *' +\n346:                                      r'(' + '|'.join(ALL_SPELL_CATEGORIES) + ') *' +\n347:                                      r'([0-9]*)\\% *' +\n348:                                      r'([0-9]*\\%|\\(gone\\))', line)\n349:                 assert len(matches) == 1, (matches, line)\n350:                 letter, spell_name, level, category, fail, retention = matches[0]\n351:                 assert len(letter) == 1, letter\n352:                 self.known_spells[spell_name] = letter\n353:                 self.spell_fail_chance[spell_name] = int(fail) / 100\n354:         self.agent.step(A.Command.ESC)\n355: \n356:     def parse_enhance_view(self):\n357:         with self.agent.atom_operation():\n358:             self.agent.step(A.Command.ENHANCE)\n359:             self._parse_enhance_view()\n360:             while self.upgradable_skills:\n361:                 to_upgrade = self.select_skill_to_upgrade()\n362:                 old_skill_level = self.skill_levels.copy()\n363:                 letter = self.upgradable_skills[to_upgrade]\n364: \n365:                 def type_letter():\n366:                     while f'{letter} - ' not in '\\n'.join(self.agent.single_popup):\n367:                         yield A.TextCharacters.SPACE\n368:                     yield letter\n369: \n370:                 self.agent.step(A.Command.ENHANCE, type_letter())\n371: \n372:                 self.agent.step(A.Command.ENHANCE)\n373:                 self._parse_enhance_view()\n374:                 assert (old_skill_level != self.skill_levels).any(), (old_skill_level, self.skill_levels)\n375: \n376:     def select_skill_to_upgrade(self):\n377:         assert self.upgradable_skills\n378:         # TODO: logic\n379:         return next(iter(self.upgradable_skills.keys()))\n380: \n381:     def _parse_enhance_view(self):\n382:         if self.agent.popup[0] not in ('Current skills:', 'Pick a skill to advance:'):\n383:             raise ValueError('Invalid ehance popup text format.' + str(self.agent.popup))\n384:         self.upgradable_skills = dict()\n385:         for line in self.agent.popup[1:]:\n386:             if line.strip() in self.possible_skill_types or \\\n387:                     line.strip() == '(Skill flagged by \"#\" cannot be enhanced any further.)' or \\\n388:                     line.strip() == '(Skills flagged by \"#\" cannot be enhanced any further.)' or \\\n389:                     line.strip() == '(Skill flagged by \"*\" may be enhanced when you\\'re more experienced.)' or \\\n390:                     line.strip() == '(Skills flagged by \"*\" may be enhanced when you\\'re more experienced.)':\n391:                 continue\n392:             matches = re.findall(r'^([a-zA-Z] -)?#?\\*? *' +\n393:                                  r'(' + '|'.join(self.name_to_skill_type.keys()) + ') *' +\n394:                                  r'\\[(' + '|'.join(self.possible_skill_levels) + ')\\]', line)\n395:             assert len(matches) == 1, (matches, line)\n396:             letter, skill_type, skill_level = matches[0]\n397:             if letter:\n398:                 letter = letter[0]\n399:                 assert letter not in self.upgradable_skills.values()\n400:                 self.upgradable_skills[self.name_to_skill_type[skill_type]] = letter\n401:             self.skill_levels[self.name_to_skill_type[skill_type]] = self.name_to_skill_level[skill_level]\n402: \n403:     def _get_str_dex_to_hit_bonus(self):\n404:         bonus = 0\n405:         # /* attack bonus for strength & dexterity */\n406:         # int\n407:         # abon()\n408:         # {\n409:         #     int sbon;\n410:         #     int str = ACURR(A_STR), dex = ACURR(A_DEX);\n411:         strength = self.agent.blstats.strength\n412:         dexterity = self.agent.blstats.dexterity\n413: \n414:         #     if (Upolyd)\n415:         #         return (adj_lev(&mons[u.umonnum]) - 3);\n416: \n417:         #     if (str < 6)\n418:         #         sbon = -2;\n419:         #     else if (str < 8)\n420:         #         sbon = -1;\n421:         #     else if (str < 17)\n422:         #         sbon = 0;\n423:         #     else if (str <= STR18(50))\n424:         #         sbon = 1; /* up to 18/50 */\n425:         #     else if (str < STR18(100))\n426:         #         sbon = 2;\n427:         #     else\n428:         #         sbon = 3;\n429:         if strength < 6:\n430:             bonus -= 2\n431:         elif strength < 8:\n432:             bonus -= 1\n433:         elif strength < 17:\n434:             pass\n435:         elif strength <= 18 + 50:\n436:             bonus += 1\n437:         elif strength < 18 + 100:\n438:             bonus += 2\n439:         else:\n440:             bonus += 3\n441: \n442:         #     /* Game tuning kludge: make it a bit easier for a low level character to\n443:         #      * hit */\n444:         #     sbon += (u.ulevel < 3) ? 1 : 0;\n445: \n446:         #     if (dex < 4)\n447:         #         return (sbon - 3);\n448:         #     else if (dex < 6)\n449:         #         return (sbon - 2);\n450:         #     else if (dex < 8)\n451:         #         return (sbon - 1);\n452:         #     else if (dex < 14)\n453:         #         return sbon;\n454:         #     else\n455:         #         return (sbon + dex - 14);\n456:         #\n457: \n458:         if dexterity < 4:\n459:             bonus -= 3\n460:         elif dexterity < 6:\n461:             bonus -= 2\n462:         elif dexterity < 8:\n463:             bonus -= 1\n464:         elif dexterity < 14:\n465:             pass\n466:         else:\n467:             return bonus + dexterity - 14\n468: \n469:         return bonus\n470: \n471:     def _get_weapon_skill_bonus(self, item):\n472:         \"\"\" Retuns a pair (to hit bonus, damage bonus) \"\"\"\n473: \n474:         if item is None:\n475:             if self.role in (self.MONK, self.SAMURAI):\n476:                 return self.martial_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n477:             else:\n478:                 return self.unarmed_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n479:         else:\n480:             # TODO: two weapon, riding\n481: \n482:             # TODO: proper sub\n483:             assert all(item.objs[0].sub == obj.sub for obj in item.objs), item.objs\n484:             sub = abs(item.objs[0].sub)\n485: \n486:             if not (0 <= sub < len(self.skill_levels)):\n487:                 raise ValueError('Invalid item sub: ' + str(item) + ' sub: ' + str(sub))\n488:             # TODO:\n489:             return self.weapon_bonus[self.skill_levels[sub]]\n490: \n491:     def get_ranged_bonus(self, launcher, ammo, monster=None, large_monster=False):\n492:         # TODO: check code/wiki\n493: \n494:         if launcher is not None:\n495:             assert launcher.is_launcher()\n496:             assert ammo.is_fired_projectile()\n497:         else:\n498:             assert ammo.is_thrown_projectile()\n499: \n500:         roll_offset = 0\n501:         dmg_bonus = 0\n502:         if launcher is not None:\n503:             skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(launcher)\n504:             roll_offset += skill_hit_bonus\n505:             roll_offset += launcher.get_weapon_bonus(large_monster)[0]\n506:             dmg_bonus += launcher.get_weapon_bonus(large_monster)[1]\n507: \n508:         roll_offset += ammo.get_weapon_bonus(large_monster)[0]\n509:         dmg_bonus += ammo.get_weapon_bonus(large_monster)[1]\n510: \n511:         return roll_offset, max(0, dmg_bonus)\n512: \n513:     def get_range(self, launcher, ammo):\n514:         # TODO: implement\n515:         return 7\n516: \n517:     def get_melee_bonus(self, item, monster=None, large_monster=False):\n518:         \"\"\" Returns a pair (to_hit, damaga)\n519:         https://github.com/facebookresearch/nle/blob/master/src/uhitm.c : find_roll_to_hit\n520:          \"\"\"\n521:         if monster is not None:\n522:             raise NotImplementedError()\n523: \n524:         # TODO:\n525:         # tmp = 1 + Luck + abon() + find_mac(mtmp) + u.uhitinc\n526:         # + maybe_polyd(youmonst.data->mlevel, u.ulevel);\n527:         roll_offset = 1 + self._get_str_dex_to_hit_bonus() + self.agent.blstats.experience_level\n528: \n529:         # TODO:\n530:         # /* some actions should occur only once during multiple attacks */\n531:         # if (!(*attk_count)++) {\n532:         #     /* knight's chivalry or samurai's giri */\n533:         #     check_caitiff(mtmp);\n534:         # }\n535: \n536:         # TODO:\n537:         # /* adjust vs. (and possibly modify) monster state */\n538:         # if (mtmp->mstun)\n539:         #     tmp += 2;\n540:         # if (mtmp->mflee)\n541:         #     tmp += 2;\n542: \n543:         # TODO:\n544:         # if (mtmp->msleeping) {\n545:         #     mtmp->msleeping = 0;\n546:         #     tmp += 2;\n547:         # }\n548: \n549:         # TODO:\n550:         # if (!mtmp->mcanmove) {\n551:         #     tmp += 4;\n552:         #     if (!rn2(10)) {\n553:         #         mtmp->mcanmove = 1;\n554:         #         mtmp->mfrozen = 0;\n555:         #     }\n556:         # }\n557: \n558:         # /* role/race adjustments */\n559: \n560:         # TODO: polymorphed\n561:         # if (Role_if(PM_MONK) && !Upolyd) {\n562:         if self.role == self.MONK:\n563:             # if (uarm)\n564:             if self.agent.inventory.items.suit is not None:\n565:                 # tmp -= (*role_roll_penalty = urole.spelarmr);\n566:                 roll_offset -= 20\n567:             elif item is None and self.agent.inventory.items.off_hand is None:\n568:                 #  else if (!uwep && !uarms)\n569:                 # tmp += (u.ulevel / 3) + 2;\n570:                 roll_offset += (self.agent.blstats.experience_level // 3) + 2\n571: \n572:         # TODO:\n573:         # if (is_orc(mtmp->data)\n574:         #     && maybe_polyd(is_elf(youmonst.data), Race_if(PM_ELF)))\n575:         #     tmp++;\n576: \n577:         # TODO:\n578:         # /* encumbrance: with a lot of luggage, your agility diminishes */\n579:         # if ((tmp2 = near_capacity()) != 0)\n580:         #     tmp -= (tmp2 * 2) - 1;\n581:         # if (u.utrap)\n582:         #     tmp -= 3;\n583: \n584:         # /*\n585:         #  * hitval applies if making a weapon attack while wielding a weapon;\n586:         #  * weapon_hit_bonus applies if doing a weapon attack even bare-handed\n587:         #  * or if kicking as martial artist\n588:         #  */\n589:         # if (aatyp == AT_WEAP || aatyp == AT_CLAW) {\n590:         #     if (weapon)\n591:         #         tmp += hitval(weapon, mtmp);\n592:         #     tmp += weapon_hit_bonus(weapon);\n593:         # } else if (aatyp == AT_KICK && martial_bonus()) {\n594:         #     tmp += weapon_hit_bonus((struct obj *) 0);\n595:         # }\n596:         skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(item)\n597:         roll_offset += skill_hit_bonus\n598: \n599:         if item is not None:\n600:             if item.is_launcher() or item.is_fired_projectile() or item.objs[0].name in ['dart', 'shuriken']:\n601:                 # TODO: rocks, boomerang\n602:                 dmg_bonus = 1.5  # 1d2\n603:             else:\n604:                 dmg_bonus += item.get_weapon_bonus(large_monster)[1]\n605:             roll_offset += item.get_weapon_bonus(large_monster)[0]\n606:         else:\n607:             # TODO: proper unarmed base damage\n608:             dmg_bonus += 1.5\n609:         return roll_offset, max(0, dmg_bonus)\n610: \n611:     def get_skill_str_list(self):\n612:         inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n613:         inv_skill_level = {v: k for k, v in self.name_to_skill_level.items()}\n614:         return list(inv_skill_type[skill_type] + '-' + inv_skill_level[level]\n615:                     for skill_type, level in enumerate(self.skill_levels)\n616:                     if level in inv_skill_level and skill_type in inv_skill_type and level != 0)\n617: \n618:     def __str__(self):\n619:         if self.role is None:\n620:             return 'unparsed_character'\n621:         skill_str = '| '.join(self.get_skill_str_list())\n622:         if self.upgradable_skills:\n623:             inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n624:             skill_str += '\\n Upgradable: ' + '|'.join(letter + '-' + inv_skill_type[skill]\n625:                                                       for skill, letter in self.upgradable_skills.items())\n626:         return '-'.join([f'{list(d.keys())[list(d.values()).index(v)][:3].lower()}'\n627:                          for d, v in [(self.name_to_role, self.role),\n628:                                       (self.name_to_race, self.race),\n629:                                       (self.name_to_gender, self.gender),\n630:                                       (self.name_to_alignment, self.alignment),\n631:                                       ]]) + '\\n Skills: ' + skill_str\n\n(End of file - total 631 lines)\n</content>","metadata":{"preview":"import re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\n\nALL_SPELL_NAMES = [\n    \"force bolt\",\n    \"drain life\",\n    \"magic missile\",\n    \"cone of cold\",\n    \"fireball\",\n    \"finger of death\",\n    \"protection\",\n    \"create monster\",\n    \"remove curse\",\n    \"create familiar\",\n    \"turn undead\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/character.py","text":"import re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\n\nALL_SPELL_NAMES = [\n    \"force bolt\",\n    \"drain life\",\n    \"magic missile\",\n    \"cone of cold\",\n    \"fireball\",\n    \"finger of death\",\n    \"protection\",\n    \"create monster\",\n    \"remove curse\",\n    \"create familiar\",\n    \"turn undead\",\n    \"detect monsters\",\n    \"light\",\n    \"detect food\",\n    \"clairvoyance\",\n    \"detect unseen\",\n    \"identify\",\n    \"detect treasure\",\n    \"magic mapping\",\n    \"sleep\",\n    \"confuse monster\",\n    \"slow monster\",\n    \"cause fear\",\n    \"charm monster\",\n    \"jumping\",\n    \"haste self\",\n    \"invisibility\",\n    \"levitation\",\n    \"teleport away\",\n    \"healing\",\n    \"cure blindness\",\n    \"cure sickness\",\n    \"extra healing\",\n    \"stone to flesh\",\n    \"restore ability\",\n    \"knock\",\n    \"wizard lock\",\n    \"dig\",\n    \"polymorph\",\n    \"cancellation\",\n]\n\nALL_SPELL_CATEGORIES = [\n    \"attack\",\n    \"healing\",\n    \"divination\",\n    \"enchantment\",\n    \"clerical\",\n    \"escape\",\n    \"matter\",\n]\n\n\nclass Property:\n    def __init__(self, agent):\n        self.agent = agent\n\n    @property\n    def confusion(self):\n        return 'Conf' in bytes(self.agent.last_observation['tty_chars'][-1]).decode()\n\n    @property\n    def stun(self):\n        return 'Stun' in bytes(self.agent.last_observation['tty_chars'][-1]).decode()\n\n    @property\n    def hallu(self):\n        return 'Hallu' in bytes(self.agent.last_observation['tty_chars'][-1]).decode()\n\n    @property\n    def blind(self):\n        return 'Blind' in bytes(self.agent.last_observation['tty_chars'][-1]).decode()\n\n    @property\n    def polymorph(self):\n        if not nh.glyph_is_monster(self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]):\n            return False\n        return self.agent.character.self_glyph != self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n\n\nclass Character:\n    UNKNOWN = -1  # for everything, e.g. alignment\n\n    ARCHEOLOGIST = 0\n    BARBARIAN = 1\n    CAVEMAN = 2\n    HEALER = 3\n    KNIGHT = 4\n    MONK = 5\n    PRIEST = 6\n    RANGER = 7\n    ROGUE = 8\n    SAMURAI = 9\n    TOURIST = 10\n    VALKYRIE = 11\n    WIZARD = 12\n\n    name_to_role = {\n        'Archeologist': ARCHEOLOGIST,\n        'Barbarian': BARBARIAN,\n        'Caveman': CAVEMAN,\n        'Cavewoman': CAVEMAN,\n        'Healer': HEALER,\n        'Knight': KNIGHT,\n        'Monk': MONK,\n        'Priest': PRIEST,\n        'Priestess': PRIEST,\n        'Ranger': RANGER,\n        'Rogue': ROGUE,\n        'Samurai': SAMURAI,\n        'Tourist': TOURIST,\n        'Valkyrie': VALKYRIE,\n        'Wizard': WIZARD,\n    }\n\n    CHAOTIC = 0\n    NEUTRAL = 1\n    LAWFUL = 2\n    UNALIGNED = 3\n\n    name_to_alignment = {\n        'chaotic': CHAOTIC,\n        'neutral': NEUTRAL,\n        'lawful': LAWFUL,\n        'unaligned': UNALIGNED,\n    }\n\n    HUMAN = 0\n    DWARF = 1\n    ELF = 2\n    GNOME = 3\n    ORC = 4\n\n    name_to_race = {\n        'human': HUMAN,\n        'dwarf': DWARF,\n        'dwarven': DWARF,\n        'elf': ELF,\n        'elven': ELF,\n        'gnome': GNOME,\n        'gnomish': GNOME,\n        'orc': ORC,\n        'orcish': ORC,\n    }\n\n    MALE = 0\n    FEMALE = 1\n\n    name_to_gender = {\n        'male': MALE,\n        'female': FEMALE,\n    }\n\n    name_to_skill_type = {\n        # \"\": O.P_NONE,\n        \"dagger\": O.P_DAGGER,\n        \"knife\": O.P_KNIFE,\n        \"axe\": O.P_AXE,\n        \"pick-axe\": O.P_PICK_AXE,\n        \"short sword\": O.P_SHORT_SWORD,\n        \"broadsword\": O.P_BROAD_SWORD,\n        \"long sword\": O.P_LONG_SWORD,\n        \"two-handed sword\": O.P_TWO_HANDED_SWORD,\n        \"scimitar\": O.P_SCIMITAR,\n        \"saber\": O.P_SABER,\n        \"club\": O.P_CLUB,\n        \"mace\": O.P_MACE,\n        \"morning star\": O.P_MORNING_STAR,\n        \"flail\": O.P_FLAIL,\n        \"hammer\": O.P_HAMMER,\n        \"quarterstaff\": O.P_QUARTERSTAFF,\n        \"polearms\": O.P_POLEARMS,\n        \"spear\": O.P_SPEAR,\n        \"trident\": O.P_TRIDENT,\n        \"lance\": O.P_LANCE,\n        \"bow\": O.P_BOW,\n        \"sling\": O.P_SLING,\n        \"crossbow\": O.P_CROSSBOW,\n        \"dart\": O.P_DART,\n        \"shuriken\": O.P_SHURIKEN,\n        \"boomerang\": O.P_BOOMERANG,\n        \"whip\": O.P_WHIP,\n        \"unicorn horn\": O.P_UNICORN_HORN,\n\n        \"attack spells\": O.P_ATTACK_SPELL,\n        \"healing spells\": O.P_HEALING_SPELL,\n        \"divination spells\": O.P_DIVINATION_SPELL,\n        \"enchantment spells\": O.P_ENCHANTMENT_SPELL,\n        \"clerical spells\": O.P_CLERIC_SPELL,\n        \"escape spells\": O.P_ESCAPE_SPELL,\n        \"matter spells\": O.P_MATTER_SPELL,\n\n        \"bare handed combat\": O.P_BARE_HANDED_COMBAT,\n        \"martial arts\": O.P_BARE_HANDED_COMBAT,\n        \"two weapon combat\": O.P_TWO_WEAPON_COMBAT,\n        \"riding\": O.P_RIDING,\n    }\n\n    possible_skill_types = ['Fighting Skills', 'Weapon Skills', 'Spellcasting Skills']\n    possible_skill_levels = ['Unskilled', 'Basic', 'Skilled', 'Expert', 'Master', 'Grand Master']\n\n    SKILL_LEVEL_RESTRICTED = 0\n    SKILL_LEVEL_UNSKILLED = 1\n    SKILL_LEVEL_BASIC = 2\n    SKILL_LEVEL_SKILLED = 3\n    SKILL_LEVEL_EXPERT = 4\n    SKILL_LEVEL_MASTER = 5\n    SKILL_LEVEL_GRAND_MASTER = 6\n\n    weapon_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-4, 2),\n        SKILL_LEVEL_UNSKILLED: (-4, 2),\n        SKILL_LEVEL_BASIC: (0, 0),\n        SKILL_LEVEL_SKILLED: (2, 1),\n        SKILL_LEVEL_EXPERT: (3, 2),\n    }\n    two_weapon_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-9, -3),\n        SKILL_LEVEL_UNSKILLED: (-9, -3),\n        SKILL_LEVEL_BASIC: (-7, -1),\n        SKILL_LEVEL_SKILLED: (-5, 0),\n        SKILL_LEVEL_EXPERT: (-3, 1),\n    }\n    riding_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-2, 0),\n        SKILL_LEVEL_UNSKILLED: (-2, 0),\n        SKILL_LEVEL_BASIC: (-1, 0),\n        SKILL_LEVEL_SKILLED: (0, 1),\n        SKILL_LEVEL_EXPERT: (0, 2),\n    }\n    unarmed_bonus = {\n        SKILL_LEVEL_RESTRICTED: (1, 0),\n        SKILL_LEVEL_UNSKILLED: (1, 0),\n        SKILL_LEVEL_BASIC: (1, 1),\n        SKILL_LEVEL_SKILLED: (2, 1),\n        SKILL_LEVEL_EXPERT: (2, 2),\n        SKILL_LEVEL_MASTER: (3, 2),\n        SKILL_LEVEL_GRAND_MASTER: (3, 3),\n    }\n    martial_bonus = {\n        SKILL_LEVEL_RESTRICTED: (1, 0),  # no one has it restricted\n        SKILL_LEVEL_UNSKILLED: (2, 1),\n        SKILL_LEVEL_BASIC: (3, 3),\n        SKILL_LEVEL_SKILLED: (4, 4),\n        SKILL_LEVEL_EXPERT: (5, 6),\n        SKILL_LEVEL_MASTER: (6, 7),\n        SKILL_LEVEL_GRAND_MASTER: (7, 9),\n    }\n\n    name_to_skill_level = {k: v for k, v in zip(['Restricted'] + possible_skill_levels,\n                                                [SKILL_LEVEL_RESTRICTED,\n                                                 SKILL_LEVEL_UNSKILLED, SKILL_LEVEL_BASIC, SKILL_LEVEL_SKILLED,\n                                                 SKILL_LEVEL_EXPERT,\n                                                 SKILL_LEVEL_MASTER, SKILL_LEVEL_GRAND_MASTER])}\n\n    def __init__(self, agent):\n        self.agent = agent\n        self.prop = Property(agent)\n        self.role = None\n        self.alignment = None\n        self.race = None\n        self.gender = None\n        self.self_glyph = None\n        self.skill_levels = np.zeros(max(self.name_to_skill_type.values()) + 1, dtype=int)\n        self.upgradable_skills = dict()\n\n        self.is_lycanthrope = False\n\n    def update(self):\n        if 'You feel feverish.' in self.agent.message:\n            self.is_lycanthrope = True\n        if 'You feel purified.' in self.agent.message:\n            self.is_lycanthrope = False\n\n    @property\n    def carrying_capacity(self):\n        # TODO: levitation, etc\n        return min(1000, (self.agent.blstats.strength_percentage + self.agent.blstats.constitution) * 25 + 50)\n\n    def parse(self):\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.ATTRIBUTES)\n            text = ' '.join(self.agent.popup)\n            self._parse(text)\n            self.self_glyph = self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n\n    def _parse(self, text):\n        matches = re.findall('You are a ([a-z]+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+).', text)\n        if len(matches) == 1:\n            alignment, _, gender, race, role = matches[0]\n        else:\n            matches = re.findall(\n                'You are an? ([a-zA-Z ]+), a level (\\d+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+). *You are ([a-z]+)',\n                text)\n            assert len(matches) == 1, repr(text)\n            _, _, _, gender, race, role, alignment = matches[0]\n\n        if not gender:\n            if role == 'Priestess':\n                gender = 'female'\n            elif role == 'Priest':\n                gender = 'male'\n            elif role == 'Caveman':\n                gender = 'male'\n            elif role == 'Cavewoman':\n                gender = 'female'\n            elif role == 'Valkyrie':\n                gender = 'female'\n            else:\n                assert 0, repr(text)\n\n        self.role = self.name_to_role[role]\n        self.alignment = self.name_to_alignment[alignment]\n        self.race = self.name_to_race[race]\n        self.gender = self.name_to_gender[gender]\n\n    def parse_spellcast_view(self):\n        self.known_spells = dict()\n        self.spell_fail_chance = dict()\n\n        # TODO: parse for other spellcaster classes\n        if self.role not in (self.HEALER,):\n            return\n\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.CAST)\n            if not self.agent.popup:\n                self.known_spells[self.agent.message] = None\n                return\n            if self.agent.popup[0] not in ('Choose which spell to cast') or \\\n                    not self.agent.popup[1].startswith('Name'):\n                raise ValueError(f'Invalid cast popup text format: {self.agent.popup}')\n            for line in self.agent.popup[2:]:\n                matches = re.findall(r'^([a-zA-Z]) - *' +\n                                     r'(' + '|'.join(ALL_SPELL_NAMES) + ') *' +\n                                     r'([0-9]*) *' +\n                                     r'(' + '|'.join(ALL_SPELL_CATEGORIES) + ') *' +\n                                     r'([0-9]*)\\% *' +\n                                     r'([0-9]*\\%|\\(gone\\))', line)\n                assert len(matches) == 1, (matches, line)\n                letter, spell_name, level, category, fail, retention = matches[0]\n                assert len(letter) == 1, letter\n                self.known_spells[spell_name] = letter\n                self.spell_fail_chance[spell_name] = int(fail) / 100\n        self.agent.step(A.Command.ESC)\n\n    def parse_enhance_view(self):\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.ENHANCE)\n            self._parse_enhance_view()\n            while self.upgradable_skills:\n                to_upgrade = self.select_skill_to_upgrade()\n                old_skill_level = self.skill_levels.copy()\n                letter = self.upgradable_skills[to_upgrade]\n\n                def type_letter():\n                    while f'{letter} - ' not in '\\n'.join(self.agent.single_popup):\n                        yield A.TextCharacters.SPACE\n                    yield letter\n\n                self.agent.step(A.Command.ENHANCE, type_letter())\n\n                self.agent.step(A.Command.ENHANCE)\n                self._parse_enhance_view()\n                assert (old_skill_level != self.skill_levels).any(), (old_skill_level, self.skill_levels)\n\n    def select_skill_to_upgrade(self):\n        assert self.upgradable_skills\n        # TODO: logic\n        return next(iter(self.upgradable_skills.keys()))\n\n    def _parse_enhance_view(self):\n        if self.agent.popup[0] not in ('Current skills:', 'Pick a skill to advance:'):\n            raise ValueError('Invalid ehance popup text format.' + str(self.agent.popup))\n        self.upgradable_skills = dict()\n        for line in self.agent.popup[1:]:\n            if line.strip() in self.possible_skill_types or \\\n                    line.strip() == '(Skill flagged by \"#\" cannot be enhanced any further.)' or \\\n                    line.strip() == '(Skills flagged by \"#\" cannot be enhanced any further.)' or \\\n                    line.strip() == '(Skill flagged by \"*\" may be enhanced when you\\'re more experienced.)' or \\\n                    line.strip() == '(Skills flagged by \"*\" may be enhanced when you\\'re more experienced.)':\n                continue\n            matches = re.findall(r'^([a-zA-Z] -)?#?\\*? *' +\n                                 r'(' + '|'.join(self.name_to_skill_type.keys()) + ') *' +\n                                 r'\\[(' + '|'.join(self.possible_skill_levels) + ')\\]', line)\n            assert len(matches) == 1, (matches, line)\n            letter, skill_type, skill_level = matches[0]\n            if letter:\n                letter = letter[0]\n                assert letter not in self.upgradable_skills.values()\n                self.upgradable_skills[self.name_to_skill_type[skill_type]] = letter\n            self.skill_levels[self.name_to_skill_type[skill_type]] = self.name_to_skill_level[skill_level]\n\n    def _get_str_dex_to_hit_bonus(self):\n        bonus = 0\n        # /* attack bonus for strength & dexterity */\n        # int\n        # abon()\n        # {\n        #     int sbon;\n        #     int str = ACURR(A_STR), dex = ACURR(A_DEX);\n        strength = self.agent.blstats.strength\n        dexterity = self.agent.blstats.dexterity\n\n        #     if (Upolyd)\n        #         return (adj_lev(&mons[u.umonnum]) - 3);\n\n        #     if (str < 6)\n        #         sbon = -2;\n        #     else if (str < 8)\n        #         sbon = -1;\n        #     else if (str < 17)\n        #         sbon = 0;\n        #     else if (str <= STR18(50))\n        #         sbon = 1; /* up to 18/50 */\n        #     else if (str < STR18(100))\n        #         sbon = 2;\n        #     else\n        #         sbon = 3;\n        if strength < 6:\n            bonus -= 2\n        elif strength < 8:\n            bonus -= 1\n        elif strength < 17:\n            pass\n        elif strength <= 18 + 50:\n            bonus += 1\n        elif strength < 18 + 100:\n            bonus += 2\n        else:\n            bonus += 3\n\n        #     /* Game tuning kludge: make it a bit easier for a low level character to\n        #      * hit */\n        #     sbon += (u.ulevel < 3) ? 1 : 0;\n\n        #     if (dex < 4)\n        #         return (sbon - 3);\n        #     else if (dex < 6)\n        #         return (sbon - 2);\n        #     else if (dex < 8)\n        #         return (sbon - 1);\n        #     else if (dex < 14)\n        #         return sbon;\n        #     else\n        #         return (sbon + dex - 14);\n        #\n\n        if dexterity < 4:\n            bonus -= 3\n        elif dexterity < 6:\n            bonus -= 2\n        elif dexterity < 8:\n            bonus -= 1\n        elif dexterity < 14:\n            pass\n        else:\n            return bonus + dexterity - 14\n\n        return bonus\n\n    def _get_weapon_skill_bonus(self, item):\n        \"\"\" Retuns a pair (to hit bonus, damage bonus) \"\"\"\n\n        if item is None:\n            if self.role in (self.MONK, self.SAMURAI):\n                return self.martial_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n            else:\n                return self.unarmed_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n        else:\n            # TODO: two weapon, riding\n\n            # TODO: proper sub\n            assert all(item.objs[0].sub == obj.sub for obj in item.objs), item.objs\n            sub = abs(item.objs[0].sub)\n\n            if not (0 <= sub < len(self.skill_levels)):\n                raise ValueError('Invalid item sub: ' + str(item) + ' sub: ' + str(sub))\n            # TODO:\n            return self.weapon_bonus[self.skill_levels[sub]]\n\n    def get_ranged_bonus(self, launcher, ammo, monster=None, large_monster=False):\n        # TODO: check code/wiki\n\n        if launcher is not None:\n            assert launcher.is_launcher()\n            assert ammo.is_fired_projectile()\n        else:\n            assert ammo.is_thrown_projectile()\n\n        roll_offset = 0\n        dmg_bonus = 0\n        if launcher is not None:\n            skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(launcher)\n            roll_offset += skill_hit_bonus\n            roll_offset += launcher.get_weapon_bonus(large_monster)[0]\n            dmg_bonus += launcher.get_weapon_bonus(large_monster)[1]\n\n        roll_offset += ammo.get_weapon_bonus(large_monster)[0]\n        dmg_bonus += ammo.get_weapon_bonus(large_monster)[1]\n\n        return roll_offset, max(0, dmg_bonus)\n\n    def get_range(self, launcher, ammo):\n        # TODO: implement\n        return 7\n\n    def get_melee_bonus(self, item, monster=None, large_monster=False):\n        \"\"\" Returns a pair (to_hit, damaga)\n        https://github.com/facebookresearch/nle/blob/master/src/uhitm.c : find_roll_to_hit\n         \"\"\"\n        if monster is not None:\n            raise NotImplementedError()\n\n        # TODO:\n        # tmp = 1 + Luck + abon() + find_mac(mtmp) + u.uhitinc\n        # + maybe_polyd(youmonst.data->mlevel, u.ulevel);\n        roll_offset = 1 + self._get_str_dex_to_hit_bonus() + self.agent.blstats.experience_level\n\n        # TODO:\n        # /* some actions should occur only once during multiple attacks */\n        # if (!(*attk_count)++) {\n        #     /* knight's chivalry or samurai's giri */\n        #     check_caitiff(mtmp);\n        # }\n\n        # TODO:\n        # /* adjust vs. (and possibly modify) monster state */\n        # if (mtmp->mstun)\n        #     tmp += 2;\n        # if (mtmp->mflee)\n        #     tmp += 2;\n\n        # TODO:\n        # if (mtmp->msleeping) {\n        #     mtmp->msleeping = 0;\n        #     tmp += 2;\n        # }\n\n        # TODO:\n        # if (!mtmp->mcanmove) {\n        #     tmp += 4;\n        #     if (!rn2(10)) {\n        #         mtmp->mcanmove = 1;\n        #         mtmp->mfrozen = 0;\n        #     }\n        # }\n\n        # /* role/race adjustments */\n\n        # TODO: polymorphed\n        # if (Role_if(PM_MONK) && !Upolyd) {\n        if self.role == self.MONK:\n            # if (uarm)\n            if self.agent.inventory.items.suit is not None:\n                # tmp -= (*role_roll_penalty = urole.spelarmr);\n                roll_offset -= 20\n            elif item is None and self.agent.inventory.items.off_hand is None:\n                #  else if (!uwep && !uarms)\n                # tmp += (u.ulevel / 3) + 2;\n                roll_offset += (self.agent.blstats.experience_level // 3) + 2\n\n        # TODO:\n        # if (is_orc(mtmp->data)\n        #     && maybe_polyd(is_elf(youmonst.data), Race_if(PM_ELF)))\n        #     tmp++;\n\n        # TODO:\n        # /* encumbrance: with a lot of luggage, your agility diminishes */\n        # if ((tmp2 = near_capacity()) != 0)\n        #     tmp -= (tmp2 * 2) - 1;\n        # if (u.utrap)\n        #     tmp -= 3;\n\n        # /*\n        #  * hitval applies if making a weapon attack while wielding a weapon;\n        #  * weapon_hit_bonus applies if doing a weapon attack even bare-handed\n        #  * or if kicking as martial artist\n        #  */\n        # if (aatyp == AT_WEAP || aatyp == AT_CLAW) {\n        #     if (weapon)\n        #         tmp += hitval(weapon, mtmp);\n        #     tmp += weapon_hit_bonus(weapon);\n        # } else if (aatyp == AT_KICK && martial_bonus()) {\n        #     tmp += weapon_hit_bonus((struct obj *) 0);\n        # }\n        skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(item)\n        roll_offset += skill_hit_bonus\n\n        if item is not None:\n            if item.is_launcher() or item.is_fired_projectile() or item.objs[0].name in ['dart', 'shuriken']:\n                # TODO: rocks, boomerang\n                dmg_bonus = 1.5  # 1d2\n            else:\n                dmg_bonus += item.get_weapon_bonus(large_monster)[1]\n            roll_offset += item.get_weapon_bonus(large_monster)[0]\n        else:\n            # TODO: proper unarmed base damage\n            dmg_bonus += 1.5\n        return roll_offset, max(0, dmg_bonus)\n\n    def get_skill_str_list(self):\n        inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n        inv_skill_level = {v: k for k, v in self.name_to_skill_level.items()}\n        return list(inv_skill_type[skill_type] + '-' + inv_skill_level[level]\n                    for skill_type, level in enumerate(self.skill_levels)\n                    if level in inv_skill_level and skill_type in inv_skill_type and level != 0)\n\n    def __str__(self):\n        if self.role is None:\n            return 'unparsed_character'\n        skill_str = '| '.join(self.get_skill_str_list())\n        if self.upgradable_skills:\n            inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n            skill_str += '\\n Upgradable: ' + '|'.join(letter + '-' + inv_skill_type[skill]\n                                                      for skill, letter in self.upgradable_skills.items())\n        return '-'.join([f'{list(d.keys())[list(d.values()).index(v)][:3].lower()}'\n                         for d, v in [(self.name_to_role, self.role),\n                                      (self.name_to_race, self.race),\n                                      (self.name_to_gender, self.gender),\n                                      (self.name_to_alignment, self.alignment),\n                                      ]]) + '\\n Skills: ' + skill_str","lineStart":1,"lineEnd":631,"totalLines":631,"truncated":false}},"title":"workspace/autoascend/character.py","time":{"start":1790707936256,"end":1790707936261}},"id":"prt_0ee82ab9f001e93x5TioyVrJ0v","sessionID":"ses_f117d708affeghrZ43p7nR0Pzo","messageID":"msg_0ee82a3df001010aGxarF0s00c"}}
