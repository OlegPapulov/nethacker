\n90:     \"Xp:25\": 0.7585537128343045,\n91:     \"Xp:26\": 0.7642151855635002,\n92:     \"Xp:27\": 0.7703376822716808,\n93:     \"Xp:28\": 0.7759810263044415,\n94:     \"Xp:29\": 0.7783345263660224,\n95:     \"Xp:30\": 0.7804561949196475,\n96:     \"You ascend t\": 1.0,\n97: }\n98: \n99: # Stable indices into NLE's 27-element blstats (bottom-line statistics).\n100: BL_DEPTH = 12\n101: BL_XP = 18\n102: BL_DUNGEON_NUMBER = 23\n103: BL_LEVEL_NUMBER = 24\n104: \n105: # Dungeon numbers are the 0-based load order in dat/dungeon.def: Dungeons of\n106: # Doom=0, Gehennom=1, Gnomish Mines=2, Quest=3, Sokoban=4, Fort Ludios=5,\n107: # Vlad's Tower=6, Elemental Planes=7. The Astral Plane is level 1 of the\n108: # Elemental Planes: the endgame builds up, so with depth(astral)=-5 ..\n109: # depth(earth)=-1 the astral level is dlevel 1 (the dummy surface is dlevel 6).\n110: QUEST_DUNGEON_NUMBER = 3\n111: ELEMENTAL_PLANES_DUNGEON_NUMBER = 7\n112: ASTRAL_PLANE_LEVEL_NUMBER = 1\n113: ASCENSION_ACHIEVEMENT = \"You ascend t\"\n114: \n115: \n116: @dataclass\n117: class NetHackProgress:\n118:     progression: float = 0.0\n119:     highest_achievement: str | None = None\n120: \n121:     def update(\n122:         self,\n123:         observation: Mapping[str, Any],\n124:         info: Mapping[str, Any] | None = None,\n125:     ) -> float:\n126:         \"\"\"Update and return the best BALROG progress seen so far.\n127: \n128:         Depth and experience level come from blstats. The location milestones\n129:         (quest ``Home`` levels and the ``Astral Plane``) are detected from the\n130:         authoritative dungeon-number / level-number in blstats -- mirroring\n131:         NetHack's ``In_quest`` / ``In_endgame`` -- not from on-screen text.\n132:         Scanning the message line or full tty for these names matched floor\n133:         graffiti, quest dialogue, and farlook encyclopedia entries that merely\n134:         mention these places, crediting e.g. ``Astral Plane`` (0.875) on Dlvl 4.\n135:         Ascension comes from ``info['is_ascended']``.\n136:         \"\"\"\n137:         blstats = observation[\"blstats\"]\n138:         self._record(f\"Dlvl:{int(blstats[BL_DEPTH])}\")\n139:         self._record(f\"Xp:{int(blstats[BL_XP])}\")\n140: \n141:         dungeon_number = int(blstats[BL_DUNGEON_NUMBER])\n142:         level_number = int(blstats[BL_LEVEL_NUMBER])\n143:         if dungeon_number == QUEST_DUNGEON_NUMBER and 1 <= level_number <= 5:\n144:             self._record(f\"Home {level_number}\")\n145:         if (\n146:             dungeon_number == ELEMENTAL_PLANES_DUNGEON_NUMBER\n147:             and level_number == ASTRAL_PLANE_LEVEL_NUMBER\n148:         ):\n149:             self._record(\"Astral Plane\")\n150: \n151:         if info is not None and info.get(\"is_ascended\", False):\n152:             self._record(ASCENSION_ACHIEVEMENT)\n153: \n154:         return self.progression\n155: \n156:     def _record(self, achievement: str) -> None:\n157:         value = ACHIEVEMENTS.get(achievement)\n158:         if value is not None and value > self.progression:\n159:             self.progression = value\n160:             self.highest_achievement = achievement\n\n(End of file - total 160 lines)\n</content>","metadata":{"preview":"from __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom dataclasses import dataclass\nfrom typing import Any\n\n# Progression values adapted from nle-progress (MIT), which adapted the BALROG\n# NetHack progression metric. Values estimate empirical ascension probability.\nACHIEVEMENTS: dict[str, float] = {\n    \"Dlvl:1\": 0.0,\n    \"Dlvl:2\": 0.015392269075361172,\n    \"Dlvl:3\": 0.017539535798967013,\n    \"Dlvl:4\": 0.021221378364235505,\n    \"Dlvl:5\": 0.026482449457437766,\n    \"Dlvl:6\": 0.035428686118173014,\n    \"Dlvl:7\": 0.04846098359243788,\n    \"Dlvl:8\": 0.0695812141543123,\n    \"Dlvl:9\": 0.09770935198701912,\n    \"Dlvl:10\": 0.12558597019922987,\n    \"Dlvl:11\": 0.16126