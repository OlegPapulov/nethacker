ook(self, item):\n        \"\"\" Read a spellbook and refresh the known-spell list. Returns True if learned. \"\"\"\n        letter = self.inventory.items.get_letter(item)\n        learned = False\n        with self.atom_operation():\n            self.step(A.Command.READ)\n            self.type_text(letter)\n            answered_continue = False\n            for _ in range(5):\n                if 'memorize the runes' in self.message or 'unintelligible' in self.message or \\\n                        \"don't seem to make sense\" in self.message or 'What do you want to read' in self.message:\n                    learned = 'memorize the runes' in self.message\n                    break\n                if 'Continue?' in self.message and not answered_continue:\n                    answered_continue = True\n                    self.type_text('y')\n                    continue\n                self.type_text(' ')\n\n        if learned:\n            self._read_spellbooks.add(item.object.name)\n            self.character.parse_spellcast_view()\n        return learned\n\n    @utils.debug_log('learn_spells')\n    @Strategy.wrap\n    def learn_spells(self):\n        if os.environ.get('AUTOASCEND_SPELLS', '1') == '0':\n            yield False\n        if self.character.known_spells:\n            yield False\n        if self.character.role != Character.WIZARD:\n            yield False\n        # reading a spellbook blinds you for a few turns, so never do it with a\n        # monster on top of us.\n        if any(utils.adjacent((y, x), (self.blstats.y, self.blstats.x))\n               for _, y, x, _, _ in self.get_visible_monsters()):\n            yield False\n\n        book = None\n        for item in self.inventory.items:\n            if item.category == nh.SPBOOK_CLASS and item.is_unambiguous() and \\\n                    item.object.name not in self._read_spellbooks:\n                book = item\n                break\n        if book is None:\n            yield False\n\n        yield True\n        self.stats_logger.log_event('read_spellbook')\n        if self.read_spellbook(book):\n            self.stats_logger.log_event('learned_spell')\n\n    def kick(self, y, x=None):\n        with self.panic_if_position_changes():\n            with self.atom_operation():\n                self.step(A.Command.KICK)\n                self.direction(self.calc_direction(self.blstats.y, self.blstats.x, y, x))\n\n    def search(self, max_count=1):\n        assert max_count >= 1\n        with self.panic_if_position_changes():\n            with self.atom_operation():\n                if max_count > 1:\n                    self.type_text(str(max_count))\n                self.step(A.Command.SEARCH)\n                # TODO: estimate the real number of searches\n                self.current_level().search_count[self.blstats.y, self.blstats.x] += max_count\n                if 'You find ' in self.message:\n                    self.check_terrain(force=True)\n        return True\n\n    def direction(self, y, x=None):\n        if x is not None:\n            dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n        else:\n            dir = y\n\n        self.step(self._direction_action(dir))\n        return True\n\n    @staticmethod\n","exit":0,"truncated":false},"title":"cd /workspace && sed -n '778,900p' autoascend/agent.py","time":{"start":1790684831983,"end":1790684832069}},"id":"prt_0ed2220d0001H274lWbi3p7wJ5","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ed21ffe1001U5UlCsTkaFVwZ3"}}
