:r for r in json.load(open('ab_base45.json'))}\nc={r['trajectory_id']:r for r in json.load(open('ab_cand45.json'))}\nks=sorted(b)\nd=[c[k]['progress']-b[k]['progress'] for k in ks]\nmb=statistics.mean(b[k]['progress'] for k in ks); mc=statistics.mean(c[k]['progress'] for k in ks)\nmd=statistics.mean(d); sd=statistics.pstdev(d)\nprint(f\"n={len(ks)}  base mean {mb:.4f}  cand mean {mc:.4f}  delta {mc-mb:+.4f}\")\nprint(f\"paired delta mean {md:+.4f}  se {sd/len(ks)**0.5:.4f}  t={md/(sd/len(ks)**0.5):+.2f}\")\nprint(f\"forward {sum(1 for x in d if x>1e-9)}  backward {sum(1 for x in d if x<-1e-9)}  same {sum(1 for x in d if abs(x)<=1e-9)}\")\ntb=statistics.mean(b[k]['turns'] for k in ks); tc=statistics.mean(c[k]['turns'] for k in ks)\nprint(f\"turns base {tb:.0f} -> cand {tc:.0f}  ({tc-tb:+.0f})\")\nd0=[c[k]['progress']-b[k]['progress'] for k in ks if k<15]\nprint(f\"seeds 0-14: base {statistics.mean(b[k]['progress'] for k in ks if k<15):.4f} cand {statistics.mean(c[k]['progress'] for k in ks if k<15):.4f} F{sum(1 for x in d0 if x>1e-9)} B{sum(1 for x in d0 if x<-1e-9)}\")\nEOF","time":{"start":1790683555492,"end":1790683555549}},"id":"prt_0ed0e9dd2001jmWe6PSNdbQCKX","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ed0e92c200126IGcK13626ga0"}}
