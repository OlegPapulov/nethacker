            \"hunger_state\": int(bl[21]), \"energy\": int(bl[14]),\n                    \"ac\": int(bl[16]), \"gold\": int(bl[13]), \"exp_pts\": int(bl[19]),\n                    \"depth_num\": int(bl[23]), \"lvl_num\": int(bl[24]),''')\ns=s.replace('''                    \"hp\": int(bl[11]), \"maxhp\": int(bl[10]),''','''                    \"hp\": int(bl[10]), \"maxhp\": int(bl[11]),''')\ns=s.replace('\"turns\": m.turns,','\"turns\": m.turns, \"nsteps\": ag.step_count,')\nopen(p,'w').write(s)\nEOF\ncd /workspace && timeout 900 python /home/agent/nhwork/diag.py 0 /home/agent/nhwork/seed0.json 600 >/dev/null 2>&1; python -c \"\nimport json\nd=json.load(open('/home/agent/nhwork/seed0.json'))\nprint(d['info']['turns'], d['info']['nsteps'])\nfor s in d['snapshots']: print(s)\n\"","time":{"start":1790680227963,"end":1790680246345}},"id":"prt_0ecdbd91d001i6kYvfN73txL6w","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ecdbbd410017mssz9M3l0ieYb"}}
