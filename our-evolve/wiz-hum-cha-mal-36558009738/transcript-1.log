evel().walkable[y, x]:\n        can_bounce = wand.is_ray_wand()\n        if not can_bounce:\n            return []\n        if dy == 0 or dx == 0:\n            return [(y - dy, x - dx, -dy, -dx, 1.0, 1)]\n        # TODO: diagonal\n        side1 = (y, x - dx)\n        side2 = (y - dy, x)\n        side1_wall = not inside(agent, *side1) or not agent.current_level().walkable[side1]","lineStart":100,"lineEnd":139,"totalLines":398,"truncated":true}},"title":"workspace/autoascend/combat/fight_heur.py","time":{"start":1790680925261,"end":1790680925270}},"id":"prt_0ece683aa001OyTz8J08tje5k9","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ece67fb1001FZ3Noa4hfvpIMI"}}
