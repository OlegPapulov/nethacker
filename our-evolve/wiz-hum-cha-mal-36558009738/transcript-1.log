_, shop_price\n        ) = matches[0]\n        # TODO: effects, uses\n\n        if info in {'being worn', 'being worn; slippery', 'wielded', 'chained to you'} or info.startswith(\n                'weapon in ') or \\\n                info.startswith('tethered weapon in '):\n            equipped = True\n            at_ready = False\n        elif info in {'at the ready', 'in quiver', 'in quiver pouch', 'lit'}:\n            equipped = False\n            at_ready = True\n        elif info in {'', 'alternate weapon; not wielded', 'alternate weapon; notwielded'}:\n            equipped = False\n            at_ready = False\n        else:\n            assert 0, info\n\n        if not shop_price:\n            shop_price = 0\n        else:\n            shop_price = int(shop_price)\n\n        count = int({'a': 1, 'an': 1, 'the': 1}.get(count, count))\n        status = {'': Item.UNKNOWN, 'cursed': Item.CURSED, 'uncursed': Item.UNCURSED, 'blessed': Item.BLESSED}[status]\n        # TODO: should be uses -- but the score is better this way\n        if uses and status == Item.UNKNOWN:\n=== equip / do_wield ===\n127:            self.agent.step(A.Command.WIELD)\n","exit":0,"truncated":false},"title":"cd /workspace && sed -n '255,310p' autoascend/item/item_manager.py; echo \"=== equip / do_wield ===\"; rg -n \"def equip|def do_wield|def do_wear|_equip|WIELD\" autoascend/item/inventory.py | head -20","time":{"start":1790683586177,"end":1790683586193}},"id":"prt_0ed0f1cb5001TMZAmmeqrnXO6R","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ed0f154d001l7m33iN0SXTFqA"}}
