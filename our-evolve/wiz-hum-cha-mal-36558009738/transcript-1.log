72-    while True:\n73-        y += dy\n","metadata":{"output":"16:def melee_monster_priority(agent, monsters, monster):\n17-    _, y, x, mon, _ = monster\n18-    ret = 1\n19-    if agent.blstats.hitpoints > 8 or is_monster_faster(agent, monster):\n20-        ret += 15\n21-    if wielding_ranged_weapon(agent) and not is_monster_faster(agent, monster):\n22-        ret -= 6\n23-    if mon.mname in EXPLODING_MONSTERS:\n24-        ret -= 17\n25-    if 'were' in mon.mname:\n26-        ret += 1\n27-    # if not wielding_melee_weapon(agent):\n28-    #     ret -= 5\n29-    if mon.mname in ONLY_RANGED_SLOW_MONSTERS:\n30-        if not consider_melee_only_ranged_if_hp_full(agent, monster):\n31-            ret -= 100\n32-            if mon.mname == 'floating eye':\n33-                ret -= 10\n34-            if mon.mname == 'gas spore':\n35-                ret -= 5\n36-\n37-    if mon.mname == 'gas spore':\n38-        # handle a specific case when you are trapped by a gas spore\n--\n51:def ranged_priority(agent, dy, dx, monsters):\n52-    ret = 11\n53-\n54-    closest_mon_dis = float('inf')\n55-    for monster in monsters:\n56-        _, my, mx, mon, _ = monster\n57-        assert my != agent.blstats.y or mx != agent.blstats.x\n58-        if mon.mname not in WEAK_MONSTERS + ONLY_RANGED_SLOW_MONSTERS:\n59-            closest_mon_dis = min(closest_mon_dis, line_dis_from(agent, my, mx))\n60-\n61-    if closest_mon_dis == 1:\n62-        ret -= 11\n63-\n64-    launcher, ammo = agent.inventory.get_best_ranged_set()\n65-    if ammo is None:\n66-        return None\n67-\n68-    if launcher is not None and not launcher.equipped:\n69-        ret -= 5\n70-\n71-    y, x = agent.blstats.y, agent.blstats.x\n72-    while True:\n73-        y += dy\n","exit":0,"truncated":false},"title":"cd /workspace && rg -n \"def melee_monster_priority|def ranged_priority\" -A 22 autoascend/combat/fight_heur.py | head -60","time":{"start":1790680929968,"end":1790680929981}},"id":"prt_0ece695ef001luj0scVbep