{"type":"tool_use","timestamp":1790680117308,"sessionID":"ses_f132db44effejOC7YW0uFAg7SL","part":{"type":"tool","tool":"write","callID":"call_function_b07pestp13xb_1","state":{"status":"completed","input":{"content":"\"\"\"In-process diagnostic driver: runs the arena bot directly against NLE.\n\nUsage: python diag.py <seed> [out.json] [budget_seconds] [--msgs N]\n\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport json\nimport os\nimport re\nimport sys\nimport tempfile\nimport threading\nimport time\nfrom collections import Counter\nfrom pathlib import Path\n\ncache = Path(tempfile.gettempdir()) / \"nethack_arena_submission_cache\"\ncache.mkdir(parents=True, exist_ok=True)\nos.environ.setdefault(\"XDG_CACHE_HOME\", str(cache / \"xdg\"))\nos.environ.setdefault(\"NUMBA_CACHE_DIR\", str(cache / \"numba\"))\n\nimport warnings\nwarnings.filterwarnings(\"ignore\", category=RuntimeWarning)\n\nsys.path.insert(0, \"/workspace\")\n\nfrom nethackers.arena.environment import NLEEnvironment  # noqa: E402\nfrom nethackers.arena.seeds import trajectory_spec  # noqa: E402\n\nfrom autoascend import agent as autoascend_agent  # noqa: E402\nfrom nle.nethack import ACTIONS as _ACTIONS  # noqa: E402\n\n\nclass DirectEnv:\n    def __init__(self, env):\n        self.env = env\n        self.agent = None\n        self.t0 = time.time()\n        self.budget = 1e18\n        self.timeline = {}     # turn -> (xp, depth, hp, maxhp)\n        self.messages = []     # (turn, message)\n        self.kills = Counter()\n        self.per_turn_actions = 0\n\n    def step(self, action):\n        res = self.env.step(_ACTIONS.index(action))\n        obs, r, term, trunc = res[:4]\n        ag = self.agent\n        if ag is not None and getattr(ag, \"last_observation\", None) is not None:\n            bl = ag.last_observation[\"blstats\"]\n            t = int(bl[0])\n            self.timeline[t] = (int(bl[18]), int(bl[12]), int(bl[11]), int(bl[10]))\n            m = getattr(ag, \"single_message\", \"\")\n            if m:\n                self.messages.append((t, m))\n                for mm in re.finditer(r\"You (?:kill|destroy) the ([a-zA-Z' -]+)!\", m):\n                    self.kills[mm.group(1)] += 1\n        if time.time() - self.t0 > self.budget:\n            raise RuntimeError(\"budget\")\n        return obs, r, term, {}\n\n\ndef main():\n    seed = int(sys.argv[1]) if len(sys.argv) > 1 else 0\n    out = sys.argv[2] if len(sys.argv) > 2 else None\n    budget = float(sys.argv[3]) if len(sys.argv) > 3 else 1200.0\n    n_msgs = 120\n    if \"--msgs\" in sys.argv:\n        n_msgs = int(sys.argv[sys.argv.index(\"--msgs\") + 1])\n    sys.setrecursionlimit(200000)\n    threading.stack_size(512 * 1024 * 1024)\n    t = threading.Thread(target=_run, args=(seed, out, budget, n_msgs))\n    t.start()\n    t.join()\n\n\ndef _run(seed, out, budget, n_msgs):\n    spec = trajectory_spec(\"public\", \"local\", seed)\n    env = NLEEnvironment(1_000_000, 10_000, \"wiz-hum-cha-mal\")\n    obs = env.reset(spec)\n    direct = DirectEnv(env)\n    direct.budget = budget\n    ag = autoascend_agent.Agent(direct, panic_on_errors=False)\n    direct.agent = ag\n\n    err = None\n    try:\n        ag.main()\n    except autoascend_agent.AgentFinished:\n        pass\n    except RuntimeError as e:\n        err = str(e)\n    except BaseException:\n        import traceback\n        err = traceback.format_exc(limit=60)\n\n    m = env.metrics()\n    tl = direct.timeline\n    turns = sorted(tl)\n    xps = [(t, tl[t]) for t in turns if (not xps_last or tl[t][0] != xps_last)]\n    xps_last = None\n    xp_timeline = []\n    prev = None\n    for t in turns:\n        cur = (tl[t][0], tl[t][1])\n        if cur != prev:\n            xp_timeline.append({\"turn\": t, \"xp\": cur[0], \"depth\": cur[1], \"hp\": tl[t][2],\n                                \"maxhp\": tl[t][3]})\n            prev = cur\n    info = {\n        \"seed\": seed, \"turns\": m.turns, \"progress\": m.progress,\n        \"death\": m.cause_of_death, \"end_status\": m.end_status, \"err\": err,\n        \"milestone\": m.milestone,\n        \"kills\": dict(direct.kills.most_common(25)),\n        \"n_kills\": sum(direct.kills.values()),\n        \"n_msgs\": len(direct.messages),\n        \"stats\": {k: v for k, v in ag.stats_logger.get_stats_dict().items()\n                  if not k.startswith(\"gold\") and (v if isinstance(v, (int, float)) else 0)},\n        \"n_panics\": len(ag.all_panics),\n    }\n    if out:\n        Path(out).write_text(json.dumps({\n            \"info\": info, \"xp_timeline\": xp_timeline,\n            \"last_messages\": direct.messages[-n_msgs:],\n        }, indent=1))\n    print(json.dumps(info, indent=1))\n    env.close()\n\n\nif __name__ == \"__main__\":\n    main()\n","filePath":"/home/agent/nhwork/diag.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/agent/nhwork/diag.py","exists":true,"truncated":false},"title":"home/agent/nhwork/diag.py","time":{"start":1790680117297,"end":1790680117306}},"id":"prt_0ecda121e001qAGT4VfcnIBM2O","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ecda084a001ni6dIpyQaTbQIc"}}
