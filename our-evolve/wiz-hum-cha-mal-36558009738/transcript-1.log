n91:     ######## CONVENIENCE FUNCTIONS\n92: \n93:     @contextlib.contextmanager\n94:     def disallow_step_calling(self):\n95:         if self._no_step_calls:\n96:             yield\n97:             return\n98: \n99:         try:\n100:             self._no_step_calls = True\n101:             yield\n102:         finally:\n103:             self._no_step_calls = False\n104: \n105:     @contextlib.contextmanager\n106:     def atom_operation(self, allow_update=False):\n107:         assert not self._no_step_calls\n108:         if self.turns_in_atom_operation is not None:\n109:             # already in an atom operation\n110:             old_allow_update = self._atom_operation_allow_update\n111:             if old_allow_update is None:\n112:                 self._atom_operation_allow_update = allow_update\n113:             else:\n114:                 assert old_allow_update or not allow_update\n115:                 self._atom_operation_allow_update = old_allow_update and allow_update\n116:             try:\n117:                 yield\n118:             finally:\n119:                 self._atom_operation_allow_update = old_allow_update\n120:             return\n121: \n122:         self.turns_in_atom_operation = 0\n123:         self._atom_operation_allow_update = allow_update\n124:         try:\n125:             yield\n126:         finally:\n127:             self.turns_in_atom_operation = None\n128:             self._atom_operation_allow_update = None\n129: \n130:         self.update_state()\n131: \n132:     @contextlib.contextmanager\n133:     def panic_if_position_changes(self):\n134:         y, x = self.blstats.y, self.blstats.x\n135: \n136:         def f(self):\n137:             if (y, x) != (self.blstats.y, self.blstats.x):\n138:                 raise AgentPanic('position changed')\n139: \n140:         fun = partial(f, self)\n141: \n142:         self.on_update.append(fun)\n143: \n144:         try:\n145:             yield\n146:         finally:\n147:             assert fun in self.on_update\n148:             self.on_update.pop(self.on_update.index(fun))\n149: \n150:     @contextlib.contextmanager\n151:     def add_on_update(self, funcs):\n152:         self.on_update.extend(funcs)\n153: \n154:         try:\n155:             yield\n156:         finally:\n157:             for f in funcs:\n158:                 self.on_update.pop(self.on_update.index(f))\n159: \n160:     @contextlib.contextmanager\n161:     def context_preempt(self, conditions):\n162:         ids = []\n163:         id2fun = {}\n164:         for cond in conditions:\n165:             def f(iden, cond=cond):\n166:                 if cond():\n167:                     raise AgentChangeStrategy(iden, cond)\n168: \n169:             fun = partial(f, id(f))\n170:             assert id(f) not in id2fun\n171:             id2fun[id(f)] = fun\n172:             ids.append(id(f))\n173:             self.on_update.append(fun)\n174: \n175:         outcome = None\n176:         for i, cond in enumerate(conditions):\n177:             if cond():\n178:                 outcome = i\n179:                 break\n180: \n181:         def outcome_f():\n182:             nonlocal outcome\n183:             return outcome\n184: \n185:         try:\n186:             yield outcome_f\n187: \n188:         except AgentChangeStrategy as e:\n189:             i = e.args[0]\n190:             if i not in id2fun:\n191:                 raise\n192:             outcome = ids.index(i)\n193:         finally:\n194:             for f in id2fun.values():\n195:                 self.on_update.pop(self.on_update.index(f))\n196: \n197:         # check if less nested ChangeStategy is present\n198:         self.call_update_functions()\n199: \n200:     def preempt(self, strategies, func, first_func=None, continue_after_preemption=True):\n201:         id2fun = {}\n202:         for strategy in strategies:\n203:             def f(iden, strategy):\n204:                 it = strategy.strategy()\n205:                 if next(it):\n206:                     raise AgentChangeStrategy(iden, it)\n207: \n208:             iden = (id(f), id(strategy))\n209:             fun = partial(f, iden, strategy)\n210:             assert iden not in id2fun\n211:             id2fun[iden] = fun\n212: \n213:         last_turn = 0\n214: \n215:         call_update = True\n216: \n217:         val = None\n218: \n219:         last_step = self.step_count\n220:         inactivity_counter = 0\n221:         is_first = True\n222:         while 1:\n223:             inactivity_counter += 1\n224:             if self.step_count != last_step:\n225:                 last_step = self.step_count\n226:                 inactivity_counter = 0\n227:             assert inactivity_counter < 5, 'cyclic preempt'\n228: \n229:             iterator = None\n230:             try:\n231:                 with self.add_on_update(list(id2fun.values())):\n232:                     if call_update:\n233:                         call_update = False\n234:                         self.call_update_functions(list(id2fun.values()))\n235: \n236:                     f = (first_func or func) if is_first else func\n237:                     if isinstance(f, Strategy):\n238:                         val = f.run()\n239:                     else:\n240:                         val = f()\n241:                     break\n242: \n243:             except AgentChangeStrategy as e:\n244:                 i = e.args[0]\n245:                 if i not in id2fun:\n246:                     raise\n247:                 iterator = e.args[1]\n248: \n249:             if iterator is not None:\n250:                 try:\n251:                     next(iterator)\n252:                     assert 0, iterator\n253:                 except StopIteration:\n254:                     pass\n255: \n256:                 if not continue_after_preemption:\n257:                     break\n258: \n259:             is_first = False\n260: \n261:         return val\n262: \n263:     ######## UPDATE FUNCTIONS\n264: \n265:     def on_panic(self):\n266:         self.check_terrain(force=True)\n267:         self.inventory.on_panic()\n268:         self.monster_tracker.on_panic()\n269:         self.update_state()\n270: \n271:     @staticmethod\n272:     def _find_marker(lines, regex=re.compile(r\"(--More--|\\(end\\)|\\(\\d+ of \\d+\\))\")):\n273:         \"\"\" Return (line, column) of markers:\n274:         --More-- | (end) | (X of N)\n275:         \"\"\"\n276:         if len(regex.findall(' '.join(lines))) > 1:\n277:             raise ValueError('Too many markers')\n278: \n279:         result, marker_type = None, None\n280:         for i, line in enumerate(lines):\n281:             res = regex.findall(line)\n282:             if res:\n283:                 assert len(res) == 1\n284:                 j = line.find(res[0])\n285:                 result, marker_type = (i, j), res[0]\n286:                 break\n287: \n288:         if result is not None and result[1] == 1:\n289:             result = (result[0], 0)  # e.g. for known items view\n290:         return result, marker_type\n291: \n292:     def get_message_and_popup(self, obs):\n293:         \"\"\" Uses MORE action to get full popup and/or message.\n294:         \"\"\"\n295: \n296:         message = bytes(obs['message']).decode().replace('\\0', ' ').replace('\\n', '').strip()\n297:         if message.endswith('--More--'):\n298:             # FIXME: It seems like in this case the environment doesn't expect additional input,\n299:             #        but I'm not 100% sure, so it's too risky to change it, because it could stall everything.\n300:             #        With the current implementation, in the worst case, we'll get \"Unknown command ' '\".\n301:             message = message[:-len('--More--')]\n302: \n303:         # assert '\\n' not in message and '\\r' not in message\n304:         popup = []\n305: \n306:         lines = [bytes(line).decode().replace('\\0', ' ').replace('\\n', '') for line in obs['tty_chars']]\n307:         marker_pos, marker_type = self._find_marker(lines)\n308: \n309:         if marker_pos is None:\n310:             return message, popup, True\n311: \n312:         pref = ''\n313:         message_lines_count = 0\n314:         if message:\n315:             for i, line in enumerate(lines[:marker_pos[0] + 1]):\n316:                 if i == marker_pos[0]:\n317:                     line = line[:marker_pos[1]]\n318:                 message_lines_count += 1\n319:                 pref += line.strip()\n320: \n321:                 # I'm not sure when the new line character in broken messages should be a space and when be ignored.\n322:                 # '#' character (and others) occasionally occurs at the beginning of the broken line and isn't in\n323:                 # the message. Sometimes the message on the screen lacks last '.'.\n324:                 replace_func = lambda x: ''.join((c for c in x if c.isalnum()))\n325:                 if replace_func(pref) == replace_func(message):\n326:                     break\n327:             else:\n328:                 if marker_pos[0] == 0:\n329:                     elems1 = [s for s in message.split() if s]\n330:                     elems2 = [s for s in pref.split() if s]\n331:                     assert len(elems1) < len(elems2) and elems2[-len(elems1):] == elems1, (elems1, elems2)\n332:                     return pref, popup, False\n333:                 raise ValueError(f\"Message:\\n{repr(message)}\\ndoesn't match the screen:\\n{repr(pref)}\")\n334: \n335:         # cut out popup\n336:         for l in lines[message_lines_count:marker_pos[0]] + [lines[marker_pos[0]][:marker_pos[1]]]:\n337:             l = l[marker_pos[1]:].strip()\n338:             if l:\n339:                 popup.append(l)\n340: \n341:         return message, popup, False\n342: \n343:     def update_message_and_popup(self, obs):\n344:         if self._is_reading_message_or_popup:\n345:             message_prefix = self.message + (' ' if self.message else '')\n346:             popup_prefix = self.popup\n347:         else:\n348:             message_prefix = ''\n349:             popup_prefix = []\n350: \n351:         self.single_message, self.single_popup, done = self.get_message_and_popup(obs)\n352:         self.single_message = self.single_message.strip()\n353:         self.single_popup = [p.strip() for p in self.single_popup]\n354: \n355:         self.message = message_prefix + self.single_message\n356:         self.popup = popup_prefix + self.single_popup\n357:         return done\n358: \n359:     def step(self, action, additional_action_iterator=None):\n360:         if self._no_step_calls:\n361:             raise ValueError(\"Shouldn't call step now\")\n362: \n363:         if isinstance(action, str):\n364:             assert len(action) == 1\n365:             action = A.ACTIONS[A.ACTIONS.index(ord(action))]\n366:         observation, reward, done, info = self.env.step(action)\n367:         observation = {k: v.copy() for k, v in observation.items()}\n368:         self.step_count += 1\n369:         self.score += reward\n370: \n371:         self.cursor_pos = (observation['tty_cursor'][0] - 1, observation['tty_cursor'][1])\n372: \n373:         if hasattr(self, 'blstats'):\n374:             for item in flatten_items(self.inventory.items):\n375:                 if item.category == nh.COIN_CLASS:\n376:                     self.stats_logger.log_gold(item.count)\n377:             else:\n378:                 self.stats_logger.log_gold(0)\n379: \n380:         if done:\n381:             raise AgentFinished()\n382: \n383:         self.update(observation, additional_action_iterator)\n384: \n385:     def update(self, observation, additional_action_iterator=None):\n386:         self._observation = observation\n387:         done = self.update_message_and_popup(observation)\n388: \n389:         self._is_reading_message_or_popup = True\n390:         if additional_action_iterator is not None:\n391:             is_next_action = True\n392:             try:\n393:                 next_action = next(additional_action_iterator)\n394:             except StopIteration:\n395:                 is_next_action = False\n396: \n397:             if is_next_action:\n398:                 self.step(next_action, additional_action_iterator)\n399:                 return\n400: \n401:         # FIXME: self.update_state() won't be called on all states sometimes.\n402:         #        Otherwise there are problems with atomic operations.\n403:         if not done or observation['misc'][2]:\n404:             self.step(A.TextCharacters.SPACE)\n405:             return\n406: \n407:         if observation['misc'][1]:  # entering text\n408:             if \"You may wish for an object.\" in self.message:\n409:                 # TODO: wishing strategy\n410:                 # TODO: assume wished item as blessed\n411:                 self.step('b', iter('lessed greased +2 gray dragon scale mail\\r'))\n412:                 return\n413:             else:\n414:                 self.step(A.Command.ESC)\n415:                 return\n416: \n417:         if 'Where do you want to be teleported?' in self.message:\n418:             # TODO: teleport control\n419:             self.step(A.Command.ESC)\n420:             return\n421: \n422:         if b'[yn]' in bytes(observation['tty_chars'].reshape(-1)):\n423:             self.type_text('y')\n424:             return\n425: \n426:         self._is_reading_message_or_popup = False\n427:         self._message_history.append(self.message)\n428: \n429:         # should_update = True\n430: \n431:         # if self.turns_in_atom_operation is not None:\n432:         #     should_update = False\n433:         #     # if any([(self.last_observation[key] != observation[key]).any()\n434:         #     #         for key in ['glyphs', 'blstats', 'inv_strs', 'inv_letters', 'inv_oclasses', 'inv_glyphs']]):\n435:         #     #     self.turns_in_atom_operation += 1\n436:         #     # assert self.turns_in_atom_operation in [0, 1]\n437: \n438:         if self.last_observation is None:\n439:             self.last_observation = observation\n440:             self._previous_glyphs = self.last_observation['glyphs']\n441:         else:\n442:             self._previous_glyphs = self.last_observation['glyphs']\n443:             self.last_observation = observation\n444: \n445:         self.blstats = BLStats(*self.last_observation['blstats'])\n446:         self.glyphs = self.last_observation['glyphs']\n447: \n448:         self.stats_logger.log_cumulative_value('max_turns_on_position',\n449:                                                key=(self.current_level().dungeon_number,\n450:                                                     self.current_level().level_number,\n451:                                                     self.blstats.y, self.blstats.x),\n452:                                                value=self.blstats.time - self._last_turn)\n453: \n454:         self._inactivity_counter += 1\n455:         if self._last_turn != self.blstats.time:\n456:             self._last_turn = self.blstats.time\n457:             self._inactivity_counter = 0\n458:         assert self._inactivity_counter < 200, ('turn inactivity', sorted(set(self._message_history[-50:])))\n459: \n460:         self.update_state(allow_update=self._atom_operation_allow_update or not self.in_atom_operation,\n461:                           allow_callbacks=not self.in_atom_operation)\n462: \n463:     def update_state(self, allow_update=True, allow_callbacks=True):\n464:         assert not self._no_step_calls\n465:         if self._is_updating_state:\n466:             return\n467:         self._is_updating_state = True\n468:         message = self.message\n469:         popup = self.popup\n470: \n471:         try:\n472:             if allow_update:\n473:                 # functions that are allowed to call state unchanging steps\n474:                 for func in [self.character.update, self.inventory.update, self.monster_tracker.update,\n475:                              partial(self.check_terrain, force=False), self.update_level,\n476:                              self.global_logic.update]:\n477:                     func()\n478:                     self.message = message\n479:                     self.popup = popup\n480: \n481:             if allow_callbacks:\n482:                 self.call_update_functions()\n483:         finally:\n484:             self._is_updating_state = False\n485: \n486:     def call_update_functions(self, funcs=None):\n487:         if funcs is None:\n488:             funcs = self.on_update\n489:         assert all((func in self.on_update for func in funcs))\n490: \n491:         with self.disallow_step_calling():\n492:             for func in funcs:\n493:                 func()\n494: \n495:     def _update_level_items(self):\n496:         level = self.current_level()\n497: \n498:         level.items[self.blstats.y, self.blstats.x] = self.inventory.items_below_me\n499:         level.item_count[self.blstats.y, self.blstats.x] = len(self.inventory.items_below_me)\n500: \n501:         # TODO: optimize\n502:         ignore_mask = utils.isin(self.glyphs, G.MONS, G.PETS)  # TODO: effects, etc\n503:         item_mask = level.item_count != 0\n504:         mask = item_mask & ~ignore_mask\n505:         level.item_disagreement_counter[~mask] = 0\n506:         for y, x in zip(*mask.nonzero()):\n507:             if (level.item_count[y, x] >= 2) == ((self.last_observation['specials'][y, x] & nh.MG_OBJPILE) > 0):\n508:                 glyphs = (glyph for item in level.items[y, x] for glyph in item.display_glyphs())\n509:                 if self.glyphs[y, x] in glyphs:\n510:                     level.item_disagreement_counter[y, x] = 0\n511:                     continue\n512: \n513:             level.item_disagreement_counter[y, x] += 1\n514:             if level.item_disagreement_counter[y, x] > 3:\n515:                 level.item_disagreement_counter[y, x] = 0\n516:                 level.items[y, x] = ()\n517:                 level.item_count[y, x] = 0\n518: \n519:     def _update_level_shops(self):\n520:         level = self.current_level()\n521: \n522:         shop_type = None\n523:         matches = re.search(f\"Welcome( again)? to [a-zA-Z' ]*({'|'.join(SHOP.name2id.keys())})!\", self.message)\n524:         if matches is not None:\n525:             shop_name = matches.groups()[1]\n526:             assert shop_name in SHOP.name2id, shop_name\n527:             shop_type = SHOP.name2id[shop_name]\n528: \n529:         shopkeepers = list(\n530:             zip(*(utils.isin(self.glyphs, G.SHOPKEEPER) & self.monster_tracker.peaceful_monster_mask).nonzero()))\n531:         for y, x in shopkeepers:\n532:             wall_mask = utils.isin(level.objects, G.WALL)\n533:             entry = ((utils.translate(wall_mask, 1, 0) & utils.translate(wall_mask, -1, 0)) |\n534:                      (utils.translate(wall_mask, 0, 1) & utils.translate(wall_mask, 0, -1))) & \\\n535:                     level.walkable\n536:             walkable = level.walkable & ~entry\n537:             mask = utils.bfs(y, x, walkable=walkable, walkable_diagonally=walkable, can_squeeze=False) != -1\n538:             mask = utils.dilate(mask, radius=1)\n539: \n540:             level.shop[mask] = True\n541:             if mask[self.blstats.y, self.blstats.x] and shop_type is not None:\n542:                 level.shop_type[mask] = shop_type\n543:             level.shop_interior[mask & ~utils.dilate(entry, radius=1, with_diagonal=False)] = True\n544: \n545:     def _update_level_corpses(self):\n546:         mnames = list(map(lambda x: x[-1],\n547:                           re.findall(r'((kills?)|(destroys?)) ((an?)|(the) )?([a-zA-Z ]+)\\!', self.message)))\n548:         mnames += list(map(lambda x: x[-4],\n549:                            re.findall(r'((An? )|(The )( *))([a-zA-Z ]+) is ((killed)|(destroyed))\\!', self.message)))\n550:         mnames = list(filter(lambda name: 'invisible' not in name and name != 'it' and not name.startswith('poor '),\n551:                              mnames))\n552:         mnames = list(map(lambda name: name[len('saddled '):] if name.startswith('saddled ') else name,\n553:                           mnames))\n554:         mnames = list(filter(lambda name: name[0].lower() == name[0],\n555:                              mnames))\n556: \n557:         level = self.current_level()\n558: \n559:         if not self.character.prop.hallu and mnames:\n560:             old_mons = self._previous_glyphs.copy()\n561:             old_mons[~utils.isin(self._previous_glyphs, G.MONS, G.INVISIBLE_MON)] = -1\n562:             new_mons = self.glyphs.copy()\n563:             new_mons[~utils.isin(self.glyphs, G.MONS, G.INVISIBLE_MON)] = -1\n564:             mask = disappearance_mask(old_mons, new_mons, 1)\n565:             mons = old_mons.copy()\n566:             mons[~mask] = -1\n567: \n568:             assert mons.any()\n569: \n570:             for mname in mnames:\n571:                 glyph = MON.from_name(mname)\n572:                 monster_id = glyph - nh.GLYPH_MON_OFF\n573:                 corpse_glyph = MON.body_from_name(mname)\n574:                 for y, x in zip(*utils.isin(mons, [glyph]).nonzero()):\n575:                     # TODO: it works because level.items is updated in `inventory.check_items`\n576:                     if all(map(lambda item: item.is_corpse() and item.monster_id != monster_id, level.items[y, x])):\n577:                         level.corpses_to_eat[y, x][monster_id] = self.blstats.time\n578: \n579:         old_possible_corpses = level.corpses_to_eat[self.blstats.y, self.blstats.x].copy()\n580:         del level.corpses_to_eat[self.blstats.y, self.blstats.x]\n581: \n582:         corpses = Counter((item for item in self.inventory.items_below_me if item.is_corpse()))\n583:         for item, count in corpses.items():\n584:             if count != 1:\n585:                 continue\n586: \n587:             level.corpses_to_eat[self.blstats.y, self.blstats.x][item.monster_id] = \\\n588:                 old_possible_corpses[item.monster_id]\n589: \n590:     def update_level(self):\n591:         if utils.isin(self.glyphs, G.SWALLOW).any():\n592:             return\n593: \n594:         if utils.any_in(self.glyphs, G.PETS):\n595:             self._last_pet_seen = self.blstats.time\n596: \n597:         level = self.current_level()\n598: \n599:         mask = utils.isin(self.glyphs, G.FLOOR, G.STAIR_UP, G.STAIR_DOWN, G.DOOR_OPENED, G.TRAPS,\n600:                           G.ALTAR, G.FOUNTAIN)\n601:         level.walkable[mask] = True\n602:         level.seen[mask] = True\n603:         level.objects[mask] = self.glyphs[mask]\n604: \n605:         mask = utils.isin(self.glyphs, G.MONS, G.PETS, G.BODIES, G.OBJECTS, G.STATUES)\n606:         level.seen[mask] = True\n607:         level.walkable[mask & (level.objects == -1)] = True\n608: \n609:         mask = utils.isin(self.glyphs, G.WALL, G.DOOR_CLOSED, G.BARS)\n610:         level.seen[mask] = True\n611:         level.objects[mask] = self.glyphs[mask]\n612:         level.walkable[mask] = False\n613: \n614:         self._update_level_items()\n615:         self._update_level_shops()\n616:         self._update_level_corpses()\n617: \n618:         for y, x in zip(*utils.isin(level.objects, G.ALTAR).nonzero()):\n619:             if (y, x) not in level.altars:\n620:                 level.altars[y, x] = Character.UNKNOWN\n621: \n622:         level.was_on[self.blstats.y, self.blstats.x] = True\n623: \n624:         for y, x in self.neighbors(self.blstats.y, self.blstats.x, shuffle=False):\n625:             if self.glyphs[y, x] in G.STONE:\n626:                 level.seen[y, x] = True\n627:                 level.objects[y, x] = self.glyphs[y, x]\n628:                 level.walkable[y, x] = False  # necessary for the exit route from vaults\n629: \n630:         # ad aerarium -- avoid valut entrance\n631:         if self.inventory.engraving_below_me and nltk.edit_distance(self.inventory.engraving_below_me,\n632:                                                                     \"ad aerarium\") <= 6:\n633:             self.stats_logger.log_event('ad_aerarium_below_me')\n634:             for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n635:                 y, x = self.blstats.y + dy, self.blstats.x + dx\n636:                 if (0 <= y < level.forbidden.shape[0] and 0 <= x < level.forbidden.shape[1]) \\\n637:                         and not level.walkable[y, x]:\n638:                     level.forbidden[y, x] = True\n639: \n640:     ######## TRIVIAL HELPERS\n641: \n642:     def current_level(self):\n643:         key = (self.blstats.dungeon_number, self.blstats.level_number)\n644:         if key not in self.levels:\n645:             self.levels[key] = Level(*key)\n646:         return self.levels[key]\n647: \n648:     @staticmethod\n649:     def calc_direction(from_y, from_x, to_y, to_x, allow_nonunit_distance=False):\n650:         if allow_nonunit_distance:\n651:             assert from_y == to_y or from_x == to_x or \\\n652:                    abs(from_y - to_y) == abs(from_x - to_x), ((from_y, from_x), (to_y, to_x))\n653:             to_y = from_y + np.sign(to_y - from_y)\n654:             to_x = from_x + np.sign(to_x - from_x)\n655: \n656:         assert abs(from_y - to_y) <= 1 and abs(from_x - to_x) <= 1, ((from_y, from_x), (to_y, to_x))\n657: \n658:         ret = ''\n659:         if to_y == from_y + 1: ret += 's'\n660:         if to_y == from_y - 1: ret += 'n'\n661:         if to_x == from_x + 1: ret += 'e'\n662:         if to_x == from_x - 1: ret += 'w'\n663:         if ret == '': ret = '.'\n664: \n665:         return ret\n666: \n667:     ######## TRIVIAL ACTIONS\n668: \n669:     def check_terrain(self, force):\n670:         if force or self._last_terrain_check is None or self.blstats.time - self._last_terrain_check > 50:\n671:             self._last_terrain_check = self.blstats.time\n672:             with self.atom_operation():\n673:                 self.type_text('#te')\n674:                 self.step(A.MiscAction.MORE, iter('b'))\n675:                 self.update_level()\n676:                 self.step(A.Command.ESC)\n677: \n678:     def wield_best_melee_weapon(self):\n679:         # TODO: move to inventory\n680:         item = self.inventory.get_best_melee_weapon()\n681:         if item != self.inventory.items.main_hand:\n682:             return self.inventory.wield(item)\n683:         return False\n684: \n685:     def type_text(self, text):\n686:         with self.atom_operation():\n687:             for char in text:\n688:                 self.step(char)\n689: \n690:     def untrap(self, trap_y, trap_x):\n691:         with self.atom_operation():\n692:             self.type_text('#u')\n693:             self.step(A.MiscAction.MORE)\n694:             assert self.single_message == \"In what direction?\", self.single_message\n695:             self.direction(trap_y, trap_x)\n696:             if self.single_message == 'You know of no traps there.':\n697:                 # assert 0, \"Trying to untrap already untraped trap\"\n698:                 return True\n699:             if self.single_message == 'You disarm the trap.':\n700:                 self.stats_logger.log_event('untrap_success')\n701:                 return True\n702:             return False\n703: \n704:     def untrap_container_below_me(self):\n705:         \"\"\" Return None if succesfull else fail message \"\"\"\n706:         with self.atom_operation():\n707:             self.type_text('#u')\n708:             self.step(A.MiscAction.MORE)\n709:             assert self.single_message == \"In what direction?\", self.single_message\n710:             self.type_text('.')\n711:             if 'There is a container and a ' in self.message:\n712:                 self.type_text('n')\n713:             if 'You know of no traps there.' in self.message:\n714:                 raise AgentPanic('no container below me to untrap')\n715:             if 'There is a container and ' in self.message and \\\n716:                     (' trap here.' in self.message or ' field here.' in self.message) and \\\n717:                     ('trap?' in self.message or 'field?' in self.message):\n718:                 self.type_text('n')\n719:             if 'You cannot disable this trap.' in self.single_message:\n720:                 return\n721:             assert 'Check it for traps?' in self.single_message, self.single_message\n722:             self.type_text('y')\n723:             if self.message.startswith('You find no traps on the'):\n724:                 return\n725:             assert 'Disarm it?' in self.message, self.message\n726:             self.type_text('y')\n727:             if 'You disarm it!' in self.message:\n728:                 self.stats_logger.log_event('container_untrap_success')\n729:                 return\n730:             self.stats_logger.log_event('container_untrap_fail')\n731:             return self.message\n732: \n733:     def is_safe_to_pray(self, limit=500):\n734:         return (\n735:                 (self.last_prayer_turn is None and self.blstats.time > 300) or\n736:                 (self.last_prayer_turn is not None and self.blstats.time - self.last_prayer_turn > limit)\n737:         )\n738: \n739:     def pray(self):\n740:         self.step(A.Command.PRAY)\n741:         self.last_prayer_turn = self.blstats.time\n742:         # TODO: return value\n743:         return True\n744: \n745:     def open_door(self, y, x):\n746:         with self.panic_if_position_changes():\n747:             assert self.glyphs[y, x] in G.DOOR_CLOSED\n748:             self.direction(y, x)\n749:             self.current_level().door_open_count[y, x] += 1\n750:             return self.glyphs[y, x] not in G.DOOR_CLOSED\n751: \n752:     def melee_attack(self, y, x):\n753:         with self.panic_if_position_changes():\n754:             assert self.glyphs[y, x] in G.MONS or self.glyphs[y, x] in G.INVISIBLE_MON or \\\n755:                    self.glyphs[y, x] in G.SWALLOW\n756:             self.direction(y, x)\n757:         return True\n758: \n759:     def zap(self, item, direction):\n760:         with self.atom_operation():\n761:             self.step(A.Command.ZAP)\n762:             self.type_text(self.inventory.items.get_letter(item))\n763:             self.direction(direction)\n764:         return True\n765: \n766:     def fire(self, item, direction):\n767:         if self.character.prop.polymorph:\n768:             # TODO: throwing is not possible if you don't have hands\n769:             # it may be possible depending on creature\n770:             return False\n771: \n772:         with self.atom_operation():\n773:             self.step(A.Command.THROW)\n774:             self.type_text(self.inventory.items.get_letter(item))\n775:             self.direction(direction)\n776:         return True\n777: \n778:     def cast(self, spell_name, direction):\n779:         with self.atom_operation():\n780:             dy, dx = direction\n781:             direction = self.calc_direction(self.blstats.y, self.blstats.x, self.blstats.y + dy, self.blstats.x + dx)\n782:             success = [False]\n783: \n784:             def type_letters():\n785:                 # while f'{letter} - ' not in '\\n'.join(self.single_popup):\n786:                 #     yield A.TextCharacters.SPACE\n787:                 # if self.single_message.startswith(\"You fail to cast the spell correctly.\"):\n788:                 #     return\n789:                 if 'You are too impaired' in self.message:\n790:                     return\n791:                 yield self.character.known_spells[spell_name]\n792:                 for _ in range(3):\n793:                     if 'In what direction?' in self.message:\n794:                         break\n795:                     yield ' '\n796:                 if 'In what direction?' in self.message:\n797:                     success[0] = True\n798:                     yield direction\n799: \n800:             self.step(A.Command.CAST, type_letters())\n801:             if success[0]:\n802:                 self.stats_logger.log_event(f'cast_{spell_name}')\n803:             else:\n804:                 self.last_cast_fail_turn[spell_name] = self._last_turn\n805:                 self.stats_logger.log_event(f'cast_fail_{spell_name}')\n806: \n807:     def kick(self, y, x=None):\n808:         with self.panic_if_position_changes():\n809:             with self.atom_operation():\n810:                 self.step(A.Command.KICK)\n811:                 self.direction(self.calc_direction(self.blstats.y, self.blstats.x, y, x))\n812: \n813:     def search(self, max_count=1):\n814:         assert max_count >= 1\n815:         with self.panic_if_position_changes():\n816:             with self.atom_operation():\n817:                 if max_count > 1:\n818:                     self.type_text(str(max_count))\n819:                 self.step(A.Command.SEARCH)\n820:                 # TODO: estimate the real number of searches\n821:                 self.current_level().search_count[self.blstats.y, self.blstats.x] += max_count\n822:                 if 'You find ' in self.message:\n823:                     self.check_terrain(force=True)\n824:         return True\n825: \n826:     def direction(self, y, x=None):\n827:         if x is not None:\n828:             dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n829:         else:\n830:             dir = y\n831: \n832:         action = {\n833:             'n': A.CompassDirection.N, 's': A.CompassDirection.S,\n834:             'e': A.CompassDirection.E, 'w': A.CompassDirection.W,\n835:             'ne': A.CompassDirection.NE, 'se': A.CompassDirection.SE,\n836:             'nw': A.CompassDirection.NW, 'sw': A.CompassDirection.SW,\n837:             '>': A.MiscDirection.DOWN, '<': A.MiscDirection.UP,\n838:             '.': A.MiscDirection.WAIT,\n839:         }[dir]\n840: \n841:         self.step(action)\n842:         return True\n843: \n844:     def move(self, y, x=None):\n845:         if x is not None:\n846:             dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n847:         else:\n848:             dir = y\n849: \n850:         expected_y = self.blstats.y + ('s' in dir) - ('n' in dir)\n851:         expected_x = self.blstats.x + ('e' in dir) - ('w' in dir)\n852: \n853:         if (expected_y != self.blstats.y or expected_x != self.blstats.x) \\\n854:                 and self.monster_tracker.monster_mask[expected_y, expected_x]:\n855:             # TODO: consider handling it in different way, since this situation is sometimes expected\n856:             raise AgentPanic(f'Monster on a next tile when moving: ({expected_y},{expected_x})')\n857: \n858:         # TODO: portals\n859:         if dir in ['<', '>']:\n860:             level = self.current_level()\n861:             with self.atom_operation():\n862:                 self.direction(dir)\n863:                 assert self.current_level().key() != level.key(), self.message\n864:                 level.stair_destination[expected_y, expected_x] = \\\n865:                     (self.current_level().key(), (self.blstats.y, self.blstats.x))\n866:                 # TODO: one way portals (elemental and astral planes)\n867:                 self.current_level().stair_destination[\n868:                     (self.blstats.y, self.blstats.x)] = (level.key(), (expected_y, expected_x))\n869: \n870:         else:\n871:             self.direction(dir)\n872: \n873:             if self.blstats.y != expected_y or self.blstats.x != expected_x:\n874:                 raise AgentPanic(f'agent position do not match after \"move\": '\n875:                                  f'expected ({expected_y}, {expected_x}), got ({self.blstats.y}, {self.blstats.x})')\n876: \n877:     def can_engrave(self):\n878:         if self.character.prop.polymorph:\n879:             return False  # TODO: only for handless monsters (which cannot write)\n880:         return (self.blstats.y, self.blstats.x) != self._forbidden_engrave_position\n881: \n882:     def engrave(self, text):\n883:         assert '\\r' not in text\n884:         ret = False\n885: \n886:         def gen():\n887:             nonlocal ret\n888:             if 'What do you want to write with?' not in self.single_message:\n889:                 self._forbidden_engrave_position = (self.blstats.y, self.blstats.x)\n890:                 yield A.Command.ESC\n891:                 return\n892:             yield '-'\n893:             if 'Do you want to add to the current engraving?' in self.single_message:\n894:                 yield 'n'\n895:             while self._observation['misc'][2]:\n896:                 yield ' '\n897:             if 'What do you want to write in the dust here?' not in self.single_message:\n898:                 self._forbidden_engrave_position = (self.blstats.y, self.blstats.x)\n899:                 yield A.Command.ESC\n900:                 return\n901:             yield from text\n902:             yield '\\r'\n903:             ret = True\n904: \n905:         with self.atom_operation():\n906:             self.step(A.Command.ENGRAVE, gen())\n907:             self.inventory.get_items_below_me()\n908: \n909:         if ret and text.lower() == 'elbereth':\n910:             self.stats_logger.log_event('elbereth_write')\n911:         return ret\n912: \n913:     ######## NON-TRIVIAL HELPERS\n914: \n915:     def neighbors(self, y, x, shuffle=True, diagonal=True):\n916:         ret = []\n917:         for dy in [-1, 0, 1]:\n918:             for dx in [-1, 0, 1]:\n919:                 if dy == 0 and dx == 0:\n920:                     continue\n921:                 if not diagonal and abs(dy) + abs(dx) > 1:\n922:                     continue\n923:                 ny = y + dy\n924:                 nx = x + dx\n925:                 if 0 <= ny < C.SIZE_Y and 0 <= nx < C.SIZE_X:\n926:                     ret.append((ny, nx))\n927: \n928:         if shuffle:\n929:             self.rng.shuffle(ret)\n930:             pass\n931: \n932:         return ret\n933: \n934:     def bfs(self, y=None, x=None):\n935:         if y is None:\n936:             y = self.blstats.y\n937:         if x is None:\n938:             x = self.blstats.x\n939: \n940:         if self.last_bfs_step == self.step_count and y == self.blstats.y and x == self.blstats.x:\n941:             return self.last_bfs_dis.copy()\n942: \n943:         level = self.current_level()\n944: \n945:         walkable = level.walkable & ~utils.isin(self.glyphs, G.BOULDER) & \\\n946:                    ~self.monster_tracker.peaceful_monster_mask & \\\n947:                    ~level.forbidden\n948: \n949:         if self._last_turn - self._allow_walking_through_traps_turn > 50:\n950:             walkable &= ~utils.isin(level.objects, G.TRAPS)\n951: \n952:         for my, mx in list(zip(*np.nonzero(utils.isin(self.glyphs, G.MONS)))):\n953:             mon = MON.permonst(self.glyphs[my][mx])\n954:             if mon.mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS:\n955:                 walkable[my, mx] = False\n956: \n957:         dis = utils.bfs(y, x,\n958:                         walkable=walkable,\n959:                         walkable_diagonally=walkable & ~utils.isin(level.objects, G.DOORS) & (level.objects != -1),\n960:                         can_squeeze=self.inventory.items.total_weight <= 600 and \\\n961:                                     self.current_level().dungeon_number != Level.SOKOBAN,\n962:                         )\n963: \n964:         if y == self.blstats.y and x == self.blstats.x:\n965:             self.last_bfs_dis = dis\n966:             self.last_bfs_step = self.step_count\n967: \n968:         return dis.copy()\n969: \n970:     def path(self, from_y, from_x, to_y, to_x, dis=None):\n971:         if from_y == to_y and from_x == to_x:\n972:             return [(to_y, to_x)]\n973: \n974:         if dis is None:\n975:             dis = self.bfs(from_y, from_x)\n976: \n977:         assert dis[to_y, to_x] != -1\n978: \n979:         # FIXME: currently the path can lead through diagonally inwalkable tiles.\n980:         #        The path is the shortest possible, so the agent is guaranteed to\n981:         #        unstuck itself eventually (usually a few panic exceptions) if that happens\n982: \n983:         cur_y, cur_x = to_y, to_x\n984:         path_rev = [(cur_y, cur_x)]\n985:         while cur_y != from_y or cur_x != from_x:\n986:             for y, x in self.neighbors(cur_y, cur_x):\n987:                 if dis[y, x] == dis[cur_y, cur_x] - 1 and dis[y, x] >= 0:\n988:                     path_rev.append((y, x))\n989:                     cur_y, cur_x = y, x\n990:                     break\n991:             else:\n992:                 assert 0\n993: \n994:         assert dis[cur_y, cur_x] == 0 and from_y == cur_y and from_x == cur_x\n995:         path = path_rev[::-1]\n996:         assert path[0] == (from_y, from_x) and path[-1] == (to_y, to_x)\n997:         return path\n998: \n999:     ######## NON-TRIVIAL ACTIONS\n1000: \n1001:     def _fast_go_to(self, y, x):\n1002:         with self.atom_operation():\n1003:             self.step(A.Command.TRAVEL)\n1004:             py, px = self.cursor_pos\n1005:             while py != y or px != x:\n1006:                 dy, dx = np.sign(y - py), np.sign(x - px)\n1007:                 self.direction(self.calc_direction(py, px, py + dy, px + dx))\n1008:                 py += dy\n1009:                 px += dx\n1010:                 assert (py, px) == self.cursor_pos\n1011:             self.direction('.')\n1012: \n1013:         if (self.blstats.y, self.blstats.x) == (y, x):\n1014:             return True\n1015: \n1016:     def go_to(self, y, x, stop_one_before=False, max_steps=None,\n1017:               debug_tiles_args=None, callback=lambda: False, fast=False):\n1018:         assert not stop_one_before or (self.blstats.y != y or self.blstats.x != x)\n1019:         assert max_steps is None or not fast\n1020: \n1021:         if stop_one_before and self.bfs()[y, x] == -1:\n1022:             dis = self.bfs()\n1023:             best_p = None\n1024:             for ny, nx in self.neighbors(y, x):\n1025:                 if dis[ny, nx] != -1 and (best_p is None or dis[best_p] > dis[ny, nx]):\n1026:                     best_p = ny, nx\n1027:             if best_p is None:\n1028:                 assert 0, 'no reachable neighbor'\n1029:             y, x = best_p\n1030:             stop_one_before = False\n1031: \n1032:         assert self.bfs()[y, x] != -1\n1033: \n1034:         if callback():\n1035:             return\n1036:         steps_taken = 0\n1037:         cont = True\n1038:         while cont and (self.blstats.y, self.blstats.x) != (y, x):\n1039:             dis = self.bfs()\n1040:             if dis[y, x] == -1:\n1041:                 raise AgentPanic('end point is no longer accessible')\n1042:             path = self.path(self.blstats.y, self.blstats.x, y, x)\n1043:             orig_path = path\n1044:             path = path[1:]\n1045:             if stop_one_before:\n1046:                 path = path[:-1]\n1047: \n1048:             if fast and len(path) > 2:\n1049:                 my_y, my_x = self.blstats.y, self.blstats.x\n1050:                 self._fast_go_to(*path[-1])\n1051:                 if (my_y, my_x) != (self.blstats.y, self.blstats.x):\n1052:                     continue\n1053: \n1054:             with self.env.debug_tiles(orig_path, **debug_tiles_args) \\\n1055:                     if debug_tiles_args is not None else contextlib.suppress():\n1056:                 for y, x in path:\n1057:                     if self.monster_tracker.peaceful_monster_mask[y, x]:\n1058:                         cont = True\n1059:                         break\n1060:                     if not self.current_level().walkable[y, x]:\n1061:                         cont = True\n1062:                         break\n1063:                     self.move(y, x)\n1064:                     if callback():\n1065:                         return\n1066:                     steps_taken += 1\n1067:                     if max_steps is not None and steps_taken >= max_steps:\n1068:                         cont = False\n1069:                         break\n1070:                 else:\n1071:                     cont = False\n1072: \n1073:     ######## LOW-LEVEL STRATEGIES\n1074: \n1075:     def get_visible_monsters(self):\n1076:         \"\"\" Returns list of tuples (distance, y, x, permonst, monster_glyph)\n1077:         \"\"\"\n1078:         mask = self.monster_tracker.monster_mask & ~self.monster_tracker.peaceful_monster_mask\n1079:         if not mask.any():\n1080:             return []\n1081: \n1082:         dis = self.bfs()\n1083:         ret = []\n1084:         for y, x in zip(*mask.nonzero()):\n1085:             if (dis[max(y - 1, 0):y + 2, max(x - 1, 0):x + 2] != -1).any():\n1086:                 if self.glyphs[y, x] == nh.GLYPH_INVISIBLE or \\\n1087:                         not MON.is_monster(self.glyphs[y, x]):  # TODO: some ghost are not visible in glyphs (?)\n1088:                     if utils.adjacent((self.blstats.y, self.blstats.x), (y, x)):\n1089:                         class dummy_permonst:\n1090:                             mname = 'unknown'\n1091:                             mlet = '0'\n1092:                             mmove = 12\n1093: \n1094:                         ret.append((dis[y][x], y, x, dummy_permonst(), self.glyphs[y][x]))\n1095:                 else:\n1096:                     ret.append((dis[y][x], y, x, MON.permonst(self.glyphs[y][x]), self.glyphs[y][x]))\n1097:         ret.sort()\n1098:         return ret\n1099: \n1100:     @utils.debug_log('fight2')\n1101:     @Strategy.wrap\n1102:     def fight2(self):\n1103:         yielded = False\n1104:         wait_counter = 0\n1105:         while 1:\n1106:             monsters = self.get_visible_monsters()\n1107:             allow_attack_all = self._last_turn - self._allow_attack_all_turn < 3\n1108:             only_ranged_slow_monsters = all([monster[3].mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS\n1109:                                              and not combat.monster_utils.consider_melee_only_ranged_if_hp_full(self,\n1110:                                                                                                                 monster)\n1111:                                              for monster in monsters])\n1112: \n1113:             dis = self.bfs()\n1114: \n1115:             if not monsters or all(dis > 7 for dis, *_ in monsters) or \\\n1116:                     (only_ranged_slow_monsters and not self.inventory.get_ranged_combinations()\n1117:                      and np.sum(dis != -1) > 1 and not allow_attack_all):\n1118:                 if wait_counter:\n1119:                     self.search()\n1120:                     wait_counter -= 1\n1121:                     continue\n1122:                 if not yielded:\n1123:                     yield False\n1124:                 return\n1125: \n1126:             if not yielded:\n1127:                 yielded = True\n1128:                 yield True\n1129:                 self.character.parse_enhance_view()\n1130:                 # self.character.parse_spellcast_view()\n1131: \n1132:             move_priority_heatmap, actions = combat.fight_heur.get_priorities(self)\n1133:             actions.extend(combat.fight_heur.get_move_actions(self, dis, move_priority_heatmap))\n1134: \n1135:             if self.character.prop.polymorph:\n1136:                 actions = list(filter(lambda x: x[1][0] != 'ranged', actions))\n1137: \n1138:             if allow_attack_all:\n1139:                 attack_actions = [a for a in actions if a[1][0] in ('melee', 'ranged', 'zap')]\n1140:                 if attack_actions:\n1141:                     actions = attack_actions\n1142: \n1143:             if not actions:\n1144:                 assert 0, 'No possible action available during fight2'\n1145: \n1146:             priority, best_action = max(actions, key=lambda x: x[0]) if actions else None\n1147: \n1148:             with self.env.debug_tiles(move_priority_heatmap, color='turbo', is_heatmap=True):\n1149:                 actions_str = '|'.join([combat.utils.action_str(self, a) for a in sorted(actions, key=lambda x: x[0])])\n1150:                 with self.env.debug_log(actions_str):\n1151:                     wait_counter = self._fight2_perform_action(best_action, wait_counter)\n1152: \n1153:     def _fight2_perform_action(self, best_action, wait_counter):\n1154:         if best_action[0] == 'move':\n1155:             _, dy, dx = best_action\n1156:             target_y, target_x = self.blstats.y + dy, self.blstats.x + dx\n1157:             with self.env.debug_tiles([[self.blstats.y, self.blstats.x],\n1158:                                        [target_y, target_x]], color=(0, 255, 0), is_path=True):\n1159:                 wait_counter = 5\n1160:                 self.move(target_y, target_x)\n1161:                 return wait_counter\n1162:         elif best_action[0] == 'melee':\n1163:             _, dy, dx = best_action\n1164:             target_y = self.blstats.y + dy\n1165:             target_x = self.blstats.x + dx\n1166:             if self.wield_best_melee_weapon():\n1167:                 return wait_counter\n1168:             with self.env.debug_tiles([[self.blstats.y, self.blstats.x],\n1169:                                        [target_y, target_x]], color=(255, 0, 255), is_path=True):\n1170:                 self.melee_attack(target_y, target_x)\n1171:                 wait_counter = 0\n1172:                 return wait_counter\n1173: \n1174:         elif best_action[0] == 'ranged':\n1175:             _, dy, dx = best_action\n1176:             target_y = self.blstats.y + dy\n1177:             target_x = self.blstats.x + dx\n1178:             launcher, ammo = self.inventory.get_best_ranged_set()\n1179:             assert ammo is not None\n1180:             if launcher is not None and not launcher.equipped:\n1181:                 if self.inventory.wield(launcher):\n1182:                     return wait_counter\n1183:             with self.env.debug_tiles([[target_y, target_x]], (0, 0, 255, 255), mode='frame'):\n1184:                 dir = self.calc_direction(self.blstats.y, self.blstats.x, target_y, target_x,\n1185:                                           allow_nonunit_distance=True)\n1186:                 fired = self.fire(ammo, dir)\n1187:                 assert fired, (ammo, dir)\n1188:                 return wait_counter\n1189: \n1190:         elif best_action[0] == 'elbereth':\n1191:             assert self.inventory.engraving_below_me.lower() != 'elbereth'\n1192:             self.engrave(\"Elbereth\")\n1193:             return wait_counter\n1194:         elif best_action[0] == 'wait':\n1195:             assert self.inventory.engraving_below_me.lower() == 'elbereth'\n1196:             self.stats_logger.log_event('wait_in_fight')\n1197:             self.search()\n1198:             return wait_counter\n1199:         elif best_action[0] == 'zap':\n1200:             if len(best_action) == 5:\n1201:                 _, dy, dx, wand, targeted_monsters = best_action\n1202:             else:\n1203:                 _, dy, dx, = best_action\n1204:                 for item in self.inventory.items:\n1205:                     if item.is_offensive_usable_wand():\n1206:                         wand = item\n1207:                         break\n1208:                 else:\n1209:                     assert 0\n1210:                 targeted_monsters = []\n1211:             dir = self.calc_direction(self.blstats.y, self.blstats.x, self.blstats.y + dy, self.blstats.x + dx,\n1212:                                       allow_nonunit_distance=True)\n1213: \n1214:             with self.env.debug_tiles([[my, mx] for my, mx, _ in targeted_monsters],\n1215:                                       (255, 0, 255, 255), mode='frame'):\n1216:                 self.zap(wand, dir)\n1217:             return wait_counter\n1218: \n1219:         elif best_action[0] == 'pickup':\n1220:             if len(best_action) == 2:\n1221:                 _, items_to_pickup = best_action\n1222:             else:\n1223:                 items_to_pickup = combat.fight_heur.decide_what_to_pickup(self)\n1224:             self.inventory.pickup(items_to_pickup)\n1225:             return wait_counter\n1226:         elif best_action[0] == 'go_to':\n1227:             _, target_y, target_x = best_action\n1228:             self.go_to(target_y, target_x, stop_one_before=True, max_steps=1,\n1229:                        debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n1230:             return wait_counter\n1231:         raise NotImplementedError(best_action)\n1232: \n1233:     @utils.debug_log('engulfed_fight')\n1234:     @Strategy.wrap\n1235:     def engulfed_fight(self):\n1236:         if not utils.any_in(self.glyphs, G.SWALLOW):\n1237:             yield False\n1238:         yield True\n1239:         while True:\n1240:             mask = utils.isin(self.glyphs, G.SWALLOW)\n1241:             if not mask.any():\n1242:                 break\n1243:             assert self.melee_attack(*list(zip(*mask.nonzero()))[0])\n1244: \n1245:     def _is_corpse_editable(self, monster_id, age_turn):\n1246:         permonst = MON.permonst(monster_id)\n1247: \n1248:         # TODO: read intrinsics\n1249:         if self.character.race != Character.ORC and permonst.mflags1 & MON.M1_POIS != 0:\n1250:             return False\n1251: \n1252:         # TODO: read intrinsics\n1253:         if permonst.mflags1 & MON.M1_ACID != 0:\n1254:             return False\n1255: \n1256:         if permonst.mflags2 & MON.M2_WERE != 0:\n1257:             return False\n1258: \n1259:         # polymorph\n1260:         if monster_id in [MON.id_from_name(name) for name in ['chameleon', 'doppelganger', 'sandestin']]:\n1261:             return False\n1262: \n1263:         # remove random intrinsic\n1264:         if monster_id in [MON.id_from_name(name) for name in ['disenchanter']]:\n1265:             return False\n1266: \n1267:         # hallucination\n1268:         if monster_id in [MON.id_from_name(name) for name in ['abbot', 'violet fungus', 'yellow mold']]:\n1269:             return False\n1270: \n1271:         # stun\n1272:         if monster_id in [MON.id_from_name(name) for name in ['bat', 'giant bat']]:\n1273:             return False\n1274: \n1275:         # aggravate monster\n1276:         if monster_id in [MON.id_from_name(name) for name in ['dog', 'little dog', 'large dog',\n1277:                                                               'kitten', 'housecat', 'large cat']]:\n1278:             return False\n1279: \n1280:         # teleportitis\n1281:         # if ord(permonst.mlet) in [MON.S_LEPRECHAUN, MON.S_NYMPH]:\n1282:         #     return False\n1283: \n1284:         # petrification\n1285:         if ord(permonst.mlet) == MON.S_COCKATRICE or monster_id == MON.id_from_name('Medusa'):\n1286:             return False\n1287: \n1288:         # temporary prevents movement\n1289:         if ord(permonst.mlet) == MON.S_MIMIC:\n1290:             return False\n1291: \n1292:         # cannibalism\n1293:         race_flag = {\n1294:             Character.HUMAN: MON.M2_HUMAN,\n1295:             Character.DWARF: MON.M2_DWARF,\n1296:             Character.ELF: MON.M2_ELF,\n\n(Output capped at 50 KB. Showing lines 1-1296. Use offset=1297 to continue.)\n</content>","metadata":{"preview":"import contextlib\nimport re\nfrom collections import namedtuple, Counter, defaultdict\nfrom functools import partial\n\nimport nle.nethack as nh\nimport nltk\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import combat\nfrom . import utils\nfrom .character import Character\nfrom .exceptions import AgentPanic, AgentFinished, AgentChangeStrategy\nfrom .exploration_logic import ExplorationLogic\nfrom .global_logic import GlobalLogic\nfrom .glyph import MON, C, Hunger, G, SHOP\nfrom .item import Item, flatten_items\nfrom .item.inventory import Inventory\nfrom .level import Level","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/agent.py","text":"import contextlib\nimport re\nfrom collections import namedtuple, Counter, defaultdict\nfrom functools import partial\n\nimport nle.nethack as nh\nimport nltk\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import combat\nfrom . import utils\nfrom .character import Character\nfrom .exceptions import AgentPanic, AgentFinished, AgentChangeStrategy\nfrom .exploration_logic import ExplorationLogic\nfrom .global_logic import GlobalLogic\nfrom .glyph import MON, C, Hunger, G, SHOP\nfrom .item import Item, flatten_items\nfrom .item.inventory import Inventory\nfrom .level import Level\nfrom .monster_tracker import MonsterTracker, disappearance_mask\nfrom .stats_logger import StatsLogger\nfrom .strategy import Strategy\n\nBLStats = namedtuple('BLStats',\n                     'x y strength_percentage strength dexterity constitution intelligence wisdom charisma score hitpoints max_hitpoints depth gold energy max_energy armor_class monster_level experience_level experience_points time hunger_state carrying_capacity dungeon_number level_number prop_mask alignment')\n\n\nclass Agent:\n    def __init__(self, env, seed=0, verbose=False, panic_on_errors=False):\n        self.env = env\n        self.verbose = verbose\n        self.rng = np.random.RandomState(seed)\n        self.panic_on_errors = panic_on_errors\n        self.all_panics = []\n\n        self.on_update = []\n        self.levels = {}\n        self.score = 0\n        self.step_count = 0\n        self._observation = None  # this should be used in additional_action_iterator generators\n        # single_{message,popup} should be used in additional_action_itertator generators.\n        # (non-single) message & popup contain cummulated content\n        self.message = self.single_message = ''\n        self.popup = self.single_popup = []\n        self._message_history = []\n        self.cursor_pos = (0, 0)\n        self.last_observation = None\n\n        self._last_pet_seen = 0\n\n        self.inventory = Inventory(self)\n        self.character = Character(self)\n        self.exploration = ExplorationLogic(self)\n        self.global_logic = GlobalLogic(self)\n        self.monster_tracker = MonsterTracker(self)\n\n        self.last_bfs_dis = None\n        self.last_bfs_step = None\n        self.last_prayer_turn = None\n        self._previous_glyphs = None\n        self._last_turn = -1\n        self._inactivity_counter = 0\n        self._is_updating_state = False\n\n        self._no_step_calls = False\n\n        self.turns_in_atom_operation = None\n        self._atom_operation_allow_update = None\n\n        self._is_reading_message_or_popup = False\n        self._last_terrain_check = None\n        self._forbidden_engrave_position = (-1, -1)\n\n        # when (number of turn) there was last decision about allowing these actions (e.g. agent is somewhat stuck)\n        self._allow_walking_through_traps_turn = -float('inf')\n        self._allow_attack_all_turn = -float('inf')\n\n        self.last_cast_fail_turn = defaultdict(lambda: -float('inf'))\n\n        self.stats_logger = StatsLogger()\n\n    @property\n    def has_pet(self):\n        return (self.blstats.time - self._last_pet_seen) <= 16\n\n    @property\n    def in_atom_operation(self):\n        return self.turns_in_atom_operation is not None\n\n    ######## CONVENIENCE FUNCTIONS\n\n    @contextlib.contextmanager\n    def disallow_step_calling(self):\n        if self._no_step_calls:\n            yield\n            return\n\n        try:\n            self._no_step_calls = True\n            yield\n        finally:\n            self._no_step_calls = False\n\n    @contextlib.contextmanager\n    def atom_operation(self, allow_update=False):\n        assert not self._no_step_calls\n        if self.turns_in_atom_operation is not None:\n            # already in an atom operation\n            old_allow_update = self._atom_operation_allow_update\n            if old_allow_update is None:\n                self._atom_operation_allow_update = allow_update\n            else:\n                assert old_allow_update or not allow_update\n                self._atom_operation_allow_update = old_allow_update and allow_update\n            try:\n                yield\n            finally:\n                self._atom_operation_allow_update = old_allow_update\n            return\n\n        self.turns_in_atom_operation = 0\n        self._atom_operation_allow_update = allow_update\n        try:\n            yield\n        finally:\n            self.turns_in_atom_operation = None\n            self._atom_operation_allow_update = None\n\n        self.update_state()\n\n    @contextlib.contextmanager\n    def panic_if_position_changes(self):\n        y, x = self.blstats.y, self.blstats.x\n\n        def f(self):\n            if (y, x) != (self.blstats.y, self.blstats.x):\n                raise AgentPanic('position changed')\n\n        fun = partial(f, self)\n\n        self.on_update.append(fun)\n\n        try:\n            yield\n        finally:\n            assert fun in self.on_update\n            self.on_update.pop(self.on_update.index(fun))\n\n    @contextlib.contextmanager\n    def add_on_update(self, funcs):\n        self.on_update.extend(funcs)\n\n        try:\n            yield\n        finally:\n            for f in funcs:\n                self.on_update.pop(self.on_update.index(f))\n\n    @contextlib.contextmanager\n    def context_preempt(self, conditions):\n        ids = []\n        id2fun = {}\n        for cond in conditions:\n            def f(iden, cond=cond):\n                if cond():\n                    raise AgentChangeStrategy(iden, cond)\n\n            fun = partial(f, id(f))\n            assert id(f) not in id2fun\n            id2fun[id(f)] = fun\n            ids.append(id(f))\n            self.on_update.append(fun)\n\n        outcome = None\n        for i, cond in enumerate(conditions):\n            if cond():\n                outcome = i\n                break\n\n        def outcome_f():\n            nonlocal outcome\n            return outcome\n\n        try:\n            yield outcome_f\n\n        except AgentChangeStrategy as e:\n            i = e.args[0]\n            if i not in id2fun:\n                raise\n            outcome = ids.index(i)\n        finally:\n            for f in id2fun.values():\n                self.on_update.pop(self.on_update.index(f))\n\n        # check if less nested ChangeStategy is present\n        self.call_update_functions()\n\n    def preempt(self, strategies, func, first_func=None, continue_after_preemption=True):\n        id2fun = {}\n        for strategy in strategies:\n            def f(iden, strategy):\n                it = strategy.strategy()\n                if next(it):\n                    raise AgentChangeStrategy(iden, it)\n\n            iden = (id(f), id(strategy))\n            fun = partial(f, iden, strategy)\n            assert iden not in id2fun\n            id2fun[iden] = fun\n\n        last_turn = 0\n\n        call_update = True\n\n        val = None\n\n        last_step = self.step_count\n        inactivity_counter = 0\n        is_first = True\n        while 1:\n            inactivity_counter += 1\n            if self.step_count != last_step:\n                last_step = self.step_count\n                inactivity_counter = 0\n            assert inactivity_counter < 5, 'cyclic preempt'\n\n            iterator = None\n            try:\n                with self.add_on_update(list(id2fun.values())):\n                    if call_update:\n                        call_update = False\n                        self.call_update_functions(list(id2fun.values()))\n\n                    f = (first_func or func) if is_first else func\n                    if isinstance(f, Strategy):\n                        val = f.run()\n                    else:\n                        val = f()\n                    break\n\n            except AgentChangeStrategy as e:\n                i = e.args[0]\n                if i not in id2fun:\n                    raise\n                iterator = e.args[1]\n\n            if iterator is not None:\n                try:\n                    next(iterator)\n                    assert 0, iterator\n                except StopIteration:\n                    pass\n\n                if not continue_after_preemption:\n                    break\n\n            is_first = False\n\n        return val\n\n    ######## UPDATE FUNCTIONS\n\n    def on_panic(self):\n        self.check_terrain(force=True)\n        self.inventory.on_panic()\n        self.monster_tracker.on_panic()\n        self.update_state()\n\n    @staticmethod\n    def _find_marker(lines, regex=re.compile(r\"(--More--|\\(end\\)|\\(\\d+ of \\d+\\))\")):\n        \"\"\" Return (line, column) of markers:\n        --More-- | (end) | (X of N)\n        \"\"\"\n        if len(regex.findall(' '.join(lines))) > 1:\n            raise ValueError('Too many markers')\n\n        result, marker_type = None, None\n        for i, line in enumerate(lines):\n            res = regex.findall(line)\n            if res:\n                assert len(res) == 1\n                j = line.find(res[0])\n                result, marker_type = (i, j), res[0]\n                break\n\n        if result is not None and result[1] == 1:\n            result = (result[0], 0)  # e.g. for known items view\n        return result, marker_type\n\n    def get_message_and_popup(self, obs):\n        \"\"\" Uses MORE action to get full popup and/or message.\n        \"\"\"\n\n        message = bytes(obs['message']).decode().replace('\\0', ' ').replace('\\n', '').strip()\n        if message.endswith('--More--'):\n            # FIXME: It seems like in this case the environment doesn't expect additional input,\n            #        but I'm not 100% sure, so it's too risky to change it, because it could stall everything.\n            #        With the current implementation, in the worst case, we'll get \"Unknown command ' '\".\n            message = message[:-len('--More--')]\n\n        # assert '\\n' not in message and '\\r' not in message\n        popup = []\n\n        lines = [bytes(line).decode().replace('\\0', ' ').replace('\\n', '') for line in obs['tty_chars']]\n        marker_pos, marker_type = self._find_marker(lines)\n\n        if marker_pos is None:\n            return message, popup, True\n\n        pref = ''\n        message_lines_count = 0\n        if message:\n            for i, line in enumerate(lines[:marker_pos[0] + 1]):\n                if i == marker_pos[0]:\n                    line = line[:marker_pos[1]]\n                message_lines_count += 1\n                pref += line.strip()\n\n                # I'm not sure when the new line character in broken messages should be a space and when be ignored.\n                # '#' character (and others) occasionally occurs at the beginning of the broken line and isn't in\n                # the message. Sometimes the message on the screen lacks last '.'.\n                replace_func = lambda x: ''.join((c for c in x if c.isalnum()))\n                if replace_func(pref) == replace_func(message):\n                    break\n            else:\n                if marker_pos[0] == 0:\n                    elems1 = [s for s in message.split() if s]\n                    elems2 = [s for s in pref.split() if s]\n                    assert len(elems1) < len(elems2) and elems2[-len(elems1):] == elems1, (elems1, elems2)\n                    return pref, popup, False\n                raise ValueError(f\"Message:\\n{repr(message)}\\ndoesn't match the screen:\\n{repr(pref)}\")\n\n        # cut out popup\n        for l in lines[message_lines_count:marker_pos[0]] + [lines[marker_pos[0]][:marker_pos[1]]]:\n            l = l[marker_pos[1]:].strip()\n            if l:\n                popup.append(l)\n\n        return message, popup, False\n\n    def update_message_and_popup(self, obs):\n        if self._is_reading_message_or_popup:\n            message_prefix = self.message + (' ' if self.message else '')\n            popup_prefix = self.popup\n        else:\n            message_prefix = ''\n            popup_prefix = []\n\n        self.single_message, self.single_popup, done = self.get_message_and_popup(obs)\n        self.single_message = self.single_message.strip()\n        self.single_popup = [p.strip() for p in self.single_popup]\n\n        self.message = message_prefix + self.single_message\n        self.popup = popup_prefix + self.single_popup\n        return done\n\n    def step(self, action, additional_action_iterator=None):\n        if self._no_step_calls:\n            raise ValueError(\"Shouldn't call step now\")\n\n        if isinstance(action, str):\n            assert len(action) == 1\n            action = A.ACTIONS[A.ACTIONS.index(ord(action))]\n        observation, reward, done, info = self.env.step(action)\n        observation = {k: v.copy() for k, v in observation.items()}\n        self.step_count += 1\n        self.score += reward\n\n        self.cursor_pos = (observation['tty_cursor'][0] - 1, observation['tty_cursor'][1])\n\n        if hasattr(self, 'blstats'):\n            for item in flatten_items(self.inventory.items):\n                if item.category == nh.COIN_CLASS:\n                    self.stats_logger.log_gold(item.count)\n            else:\n                self.stats_logger.log_gold(0)\n\n        if done:\n            raise AgentFinished()\n\n        self.update(observation, additional_action_iterator)\n\n    def update(self, observation, additional_action_iterator=None):\n        self._observation = observation\n        done = self.update_message_and_popup(observation)\n\n        self._is_reading_message_or_popup = True\n        if additional_action_iterator is not None:\n            is_next_action = True\n            try:\n                next_action = next(additional_action_iterator)\n            except StopIteration:\n                is_next_action = False\n\n            if is_next_action:\n                self.step(next_action, additional_action_iterator)\n                return\n\n        # FIXME: self.update_state() won't be called on all states sometimes.\n        #        Otherwise there are problems with atomic operations.\n        if not done or observation['misc'][2]:\n            self.step(A.TextCharacters.SPACE)\n            return\n\n        if observation['misc'][1]:  # entering text\n            if \"You may wish for an object.\" in self.message:\n                # TODO: wishing strategy\n                # TODO: assume wished item as blessed\n                self.step('b', iter('lessed greased +2 gray dragon scale mail\\r'))\n                return\n            else:\n                self.step(A.Command.ESC)\n                return\n\n        if 'Where do you want to be teleported?' in self.message:\n            # TODO: teleport control\n            self.step(A.Command.ESC)\n            return\n\n        if b'[yn]' in bytes(observation['tty_chars'].reshape(-1)):\n            self.type_text('y')\n            return\n\n        self._is_reading_message_or_popup = False\n        self._message_history.append(self.message)\n\n        # should_update = True\n\n        # if self.turns_in_atom_operation is not None:\n        #     should_update = False\n        #     # if any([(self.last_observation[key] != observation[key]).any()\n        #     #         for key in ['glyphs', 'blstats', 'inv_strs', 'inv_letters', 'inv_oclasses', 'inv_glyphs']]):\n        #     #     self.turns_in_atom_operation += 1\n        #     # assert self.turns_in_atom_operation in [0, 1]\n\n        if self.last_observation is None:\n            self.last_observation = observation\n            self._previous_glyphs = self.last_observation['glyphs']\n        else:\n            self._previous_glyphs = self.last_observation['glyphs']\n            self.last_observation = observation\n\n        self.blstats = BLStats(*self.last_observation['blstats'])\n        self.glyphs = self.last_observation['glyphs']\n\n        self.stats_logger.log_cumulative_value('max_turns_on_position',\n                                               key=(self.current_level().dungeon_number,\n                                                    self.current_level().level_number,\n                                                    self.blstats.y, self.blstats.x),\n                                               value=self.blstats.time - self._last_turn)\n\n        self._inactivity_counter += 1\n        if self._last_turn != self.blstats.time:\n            self._last_turn = self.blstats.time\n            self._inactivity_counter = 0\n        assert self._inactivity_counter < 200, ('turn inactivity', sorted(set(self._message_history[-50:])))\n\n        self.update_state(allow_update=self._atom_operation_allow_update or not self.in_atom_operation,\n                          allow_callbacks=not self.in_atom_operation)\n\n    def update_state(self, allow_update=True, allow_callbacks=True):\n        assert not self._no_step_calls\n        if self._is_updating_state:\n            return\n        self._is_updating_state = True\n        message = self.message\n        popup = self.popup\n\n        try:\n            if allow_update:\n                # functions that are allowed to call state unchanging steps\n                for func in [self.character.update, self.inventory.update, self.monster_tracker.update,\n                             partial(self.check_terrain, force=False), self.update_level,\n                             self.global_logic.update]:\n                    func()\n                    self.message = message\n                    self.popup = popup\n\n            if allow_callbacks:\n                self.call_update_functions()\n        finally:\n            self._is_updating_state = False\n\n    def call_update_functions(self, funcs=None):\n        if funcs is None:\n            funcs = self.on_update\n        assert all((func in self.on_update for func in funcs))\n\n        with self.disallow_step_calling():\n            for func in funcs:\n                func()\n\n    def _update_level_items(self):\n        level = self.current_level()\n\n        level.items[self.blstats.y, self.blstats.x] = self.inventory.items_below_me\n        level.item_count[self.blstats.y, self.blstats.x] = len(self.inventory.items_below_me)\n\n        # TODO: optimize\n        ignore_mask = utils.isin(self.glyphs, G.MONS, G.PETS)  # TODO: effects, etc\n        item_mask = level.item_count != 0\n        mask = item_mask & ~ignore_mask\n        level.item_disagreement_counter[~mask] = 0\n        for y, x in zip(*mask.nonzero()):\n            if (level.item_count[y, x] >= 2) == ((self.last_observation['specials'][y, x] & nh.MG_OBJPILE) > 0):\n                glyphs = (glyph for item in level.items[y, x] for glyph in item.display_glyphs())\n                if self.glyphs[y, x] in glyphs:\n                    level.item_disagreement_counter[y, x] = 0\n                    continue\n\n            level.item_disagreement_counter[y, x] += 1\n            if level.item_disagreement_counter[y, x] > 3:\n                level.item_disagreement_counter[y, x] = 0\n                level.items[y, x] = ()\n                level.item_count[y, x] = 0\n\n    def _update_level_shops(self):\n        level = self.current_level()\n\n        shop_type = None\n        matches = re.search(f\"Welcome( again)? to [a-zA-Z' ]*({'|'.join(SHOP.name2id.keys())})!\", self.message)\n        if matches is not None:\n            shop_name = matches.groups()[1]\n            assert shop_name in SHOP.name2id, shop_name\n            shop_type = SHOP.name2id[shop_name]\n\n        shopkeepers = list(\n            zip(*(utils.isin(self.glyphs, G.SHOPKEEPER) & self.monster_tracker.peaceful_monster_mask).nonzero()))\n        for y, x in shopkeepers:\n            wall_mask = utils.isin(level.objects, G.WALL)\n            entry = ((utils.translate(wall_mask, 1, 0) & utils.translate(wall_mask, -1, 0)) |\n                     (utils.translate(wall_mask, 0, 1) & utils.translate(wall_mask, 0, -1))) & \\\n                    level.walkable\n            walkable = level.walkable & ~entry\n            mask = utils.bfs(y, x, walkable=walkable, walkable_diagonally=walkable, can_squeeze=False) != -1\n            mask = utils.dilate(mask, radius=1)\n\n            level.shop[mask] = True\n            if mask[self.blstats.y, self.blstats.x] and shop_type is not None:\n                level.shop_type[mask] = shop_type\n            level.shop_interior[mask & ~utils.dilate(entry, radius=1, with_diagonal=False)] = True\n\n    def _update_level_corpses(self):\n        mnames = list(map(lambda x: x[-1],\n                          re.findall(r'((kills?)|(destroys?)) ((an?)|(the) )?([a-zA-Z ]+)\\!', self.message)))\n        mnames += list(map(lambda x: x[-4],\n                           re.findall(r'((An? )|(The )( *))([a-zA-Z ]+) is ((killed)|(destroyed))\\!', self.message)))\n        mnames = list(filter(lambda name: 'invisible' not in name and name != 'it' and not name.startswith('poor '),\n                             mnames))\n        mnames = list(map(lambda name: name[len('saddled '):] if name.startswith('saddled ') else name,\n                          mnames))\n        mnames = list(filter(lambda name: name[0].lower() == name[0],\n                             mnames))\n\n        level = self.current_level()\n\n        if not self.character.prop.hallu and mnames:\n            old_mons = self._previous_glyphs.copy()\n            old_mons[~utils.isin(self._previous_glyphs, G.MONS, G.INVISIBLE_MON)] = -1\n            new_mons = self.glyphs.copy()\n            new_mons[~utils.isin(self.glyphs, G.MONS, G.INVISIBLE_MON)] = -1\n            mask = disappearance_mask(old_mons, new_mons, 1)\n            mons = old_mons.copy()\n            mons[~mask] = -1\n\n            assert mons.any()\n\n            for mname in mnames:\n                glyph = MON.from_name(mname)\n                monster_id = glyph - nh.GLYPH_MON_OFF\n                corpse_glyph = MON.body_from_name(mname)\n                for y, x in zip(*utils.isin(mons, [glyph]).nonzero()):\n                    # TODO: it works because level.items is updated in `inventory.check_items`\n                    if all(map(lambda item: item.is_corpse() and item.monster_id != monster_id, level.items[y, x])):\n                        level.corpses_to_eat[y, x][monster_id] = self.blstats.time\n\n        old_possible_corpses = level.corpses_to_eat[self.blstats.y, self.blstats.x].copy()\n        del level.corpses_to_eat[self.blstats.y, self.blstats.x]\n\n        corpses = Counter((item for item in self.inventory.items_below_me if item.is_corpse()))\n        for item, count in corpses.items():\n            if count != 1:\n                continue\n\n            level.corpses_to_eat[self.blstats.y, self.blstats.x][item.monster_id] = \\\n                old_possible_corpses[item.monster_id]\n\n    def update_level(self):\n        if utils.isin(self.glyphs, G.SWALLOW).any():\n            return\n\n        if utils.any_in(self.glyphs, G.PETS):\n            self._last_pet_seen = self.blstats.time\n\n        level = self.current_level()\n\n        mask = utils.isin(self.glyphs, G.FLOOR, G.STAIR_UP, G.STAIR_DOWN, G.DOOR_OPENED, G.TRAPS,\n                          G.ALTAR, G.FOUNTAIN)\n        level.walkable[mask] = True\n        level.seen[mask] = True\n        level.objects[mask] = self.glyphs[mask]\n\n        mask = utils.isin(self.glyphs, G.MONS, G.PETS, G.BODIES, G.OBJECTS, G.STATUES)\n        level.seen[mask] = True\n        level.walkable[mask & (level.objects == -1)] = True\n\n        mask = utils.isin(self.glyphs, G.WALL, G.DOOR_CLOSED, G.BARS)\n        level.seen[mask] = True\n        level.objects[mask] = self.glyphs[mask]\n        level.walkable[mask] = False\n\n        self._update_level_items()\n        self._update_level_shops()\n        self._update_level_corpses()\n\n        for y, x in zip(*utils.isin(level.objects, G.ALTAR).nonzero()):\n            if (y, x) not in level.altars:\n                level.altars[y, x] = Character.UNKNOWN\n\n        level.was_on[self.blstats.y, self.blstats.x] = True\n\n        for y, x in self.neighbors(self.blstats.y, self.blstats.x, shuffle=False):\n            if self.glyphs[y, x] in G.STONE:\n                level.seen[y, x] = True\n                level.objects[y, x] = self.glyphs[y, x]\n                level.walkable[y, x] = False  # necessary for the exit route from vaults\n\n        # ad aerarium -- avoid valut entrance\n        if self.inventory.engraving_below_me and nltk.edit_distance(self.inventory.engraving_below_me,\n                                                                    \"ad aerarium\") <= 6:\n            self.stats_logger.log_event('ad_aerarium_below_me')\n            for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                y, x = self.blstats.y + dy, self.blstats.x + dx\n                if (0 <= y < level.forbidden.shape[0] and 0 <= x < level.forbidden.shape[1]) \\\n                        and not level.walkable[y, x]:\n                    level.forbidden[y, x] = True\n\n    ######## TRIVIAL HELPERS\n\n    def current_level(self):\n        key = (self.blstats.dungeon_number, self.blstats.level_number)\n        if key not in self.levels:\n            self.levels[key] = Level(*key)\n        return self.levels[key]\n\n    @staticmethod\n    def calc_direction(from_y, from_x, to_y, to_x, allow_nonunit_distance=False):\n        if allow_nonunit_distance:\n            assert from_y == to_y or from_x == to_x or \\\n                   abs(from_y - to_y) == abs(from_x - to_x), ((from_y, from_x), (to_y, to_x))\n            to_y = from_y + np.sign(to_y - from_y)\n            to_x = from_x + np.sign(to_x - from_x)\n\n        assert abs(from_y - to_y) <= 1 and abs(from_x - to_x) <= 1, ((from_y, from_x), (to_y, to_x))\n\n        ret = ''\n        if to_y == from_y + 1: ret += 's'\n        if to_y == from_y - 1: ret += 'n'\n        if to_x == from_x + 1: ret += 'e'\n        if to_x == from_x - 1: ret += 'w'\n        if ret == '': ret = '.'\n\n        return ret\n\n    ######## TRIVIAL ACTIONS\n\n    def check_terrain(self, force):\n        if force or self._last_terrain_check is None or self.blstats.time - self._last_terrain_check > 50:\n            self._last_terrain_check = self.blstats.time\n            with self.atom_operation():\n                self.type_text('#te')\n                self.step(A.MiscAction.MORE, iter('b'))\n                self.update_level()\n                self.step(A.Command.ESC)\n\n    def wield_best_melee_weapon(self):\n        # TODO: move to inventory\n        item = self.inventory.get_best_melee_weapon()\n        if item != self.inventory.items.main_hand:\n            return self.inventory.wield(item)\n        return False\n\n    def type_text(self, text):\n        with self.atom_operation():\n            for char in text:\n                self.step(char)\n\n    def untrap(self, trap_y, trap_x):\n        with self.atom_operation():\n            self.type_text('#u')\n            self.step(A.MiscAction.MORE)\n            assert self.single_message == \"In what direction?\", self.single_message\n            self.direction(trap_y, trap_x)\n            if self.single_message == 'You know of no traps there.':\n                # assert 0, \"Trying to untrap already untraped trap\"\n                return True\n            if self.single_message == 'You disarm the trap.':\n                self.stats_logger.log_event('untrap_success')\n                return True\n            return False\n\n    def untrap_container_below_me(self):\n        \"\"\" Return None if succesfull else fail message \"\"\"\n        with self.atom_operation():\n            self.type_text('#u')\n            self.step(A.MiscAction.MORE)\n            assert self.single_message == \"In what direction?\", self.single_message\n            self.type_text('.')\n            if 'There is a container and a ' in self.message:\n                self.type_text('n')\n            if 'You know of no traps there.' in self.message:\n                raise AgentPanic('no container below me to untrap')\n            if 'There is a container and ' in self.message and \\\n                    (' trap here.' in self.message or ' field here.' in self.message) and \\\n                    ('trap?' in self.message or 'field?' in self.message):\n                self.type_text('n')\n            if 'You cannot disable this trap.' in self.single_message:\n                return\n            assert 'Check it for traps?' in self.single_message, self.single_message\n            self.type_text('y')\n            if self.message.startswith('You find no traps on the'):\n                return\n            assert 'Disarm it?' in self.message, self.message\n            self.type_text('y')\n            if 'You disarm it!' in self.message:\n                self.stats_logger.log_event('container_untrap_success')\n                return\n            self.stats_logger.log_event('container_untrap_fail')\n            return self.message\n\n    def is_safe_to_pray(self, limit=500):\n        return (\n                (self.last_prayer_turn is None and self.blstats.time > 300) or\n                (self.last_prayer_turn is not None and self.blstats.time - self.last_prayer_turn > limit)\n        )\n\n    def pray(self):\n        self.step(A.Command.PRAY)\n        self.last_prayer_turn = self.blstats.time\n        # TODO: return value\n        return True\n\n    def open_door(self, y, x):\n        with self.panic_if_position_changes():\n            assert self.glyphs[y, x] in G.DOOR_CLOSED\n            self.direction(y, x)\n            self.current_level().door_open_count[y, x] += 1\n            return self.glyphs[y, x] not in G.DOOR_CLOSED\n\n    def melee_attack(self, y, x):\n        with self.panic_if_position_changes():\n            assert self.glyphs[y, x] in G.MONS or self.glyphs[y, x] in G.INVISIBLE_MON or \\\n                   self.glyphs[y, x] in G.SWALLOW\n            self.direction(y, x)\n        return True\n\n    def zap(self, item, direction):\n        with self.atom_operation():\n            self.step(A.Command.ZAP)\n            self.type_text(self.inventory.items.get_letter(item))\n            self.direction(direction)\n        return True\n\n    def fire(self, item, direction):\n        if self.character.prop.polymorph:\n            # TODO: throwing is not possible if you don't have hands\n            # it may be possible depending on creature\n            return False\n\n        with self.atom_operation():\n            self.step(A.Command.THROW)\n            self.type_text(self.inventory.items.get_letter(item))\n            self.direction(direction)\n        return True\n\n    def cast(self, spell_name, direction):\n        with self.atom_operation():\n            dy, dx = direction\n            direction = self.calc_direction(self.blstats.y, self.blstats.x, self.blstats.y + dy, self.blstats.x + dx)\n            success = [False]\n\n            def type_letters():\n                # while f'{letter} - ' not in '\\n'.join(self.single_popup):\n                #     yield A.TextCharacters.SPACE\n                # if self.single_message.startswith(\"You fail to cast the spell correctly.\"):\n                #     return\n                if 'You are too impaired' in self.message:\n                    return\n                yield self.character.known_spells[spell_name]\n                for _ in range(3):\n                    if 'In what direction?' in self.message:\n                        break\n                    yield ' '\n                if 'In what direction?' in self.message:\n                    success[0] = True\n                    yield direction\n\n            self.step(A.Command.CAST, type_letters())\n            if success[0]:\n                self.stats_logger.log_event(f'cast_{spell_name}')\n            else:\n                self.last_cast_fail_turn[spell_name] = self._last_turn\n                self.stats_logger.log_event(f'cast_fail_{spell_name}')\n\n    def kick(self, y, x=None):\n        with self.panic_if_position_changes():\n            with self.atom_operation():\n                self.step(A.Command.KICK)\n                self.direction(self.calc_direction(self.blstats.y, self.blstats.x, y, x))\n\n    def search(self, max_count=1):\n        assert max_count >= 1\n        with self.panic_if_position_changes():\n            with self.atom_operation():\n                if max_count > 1:\n                    self.type_text(str(max_count))\n                self.step(A.Command.SEARCH)\n                # TODO: estimate the real number of searches\n                self.current_level().search_count[self.blstats.y, self.blstats.x] += max_count\n                if 'You find ' in self.message:\n                    self.check_terrain(force=True)\n        return True\n\n    def direction(self, y, x=None):\n        if x is not None:\n            dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n        else:\n            dir = y\n\n        action = {\n            'n': A.CompassDirection.N, 's': A.CompassDirection.S,\n            'e': A.CompassDirection.E, 'w': A.CompassDirection.W,\n            'ne': A.CompassDirection.NE, 'se': A.CompassDirection.SE,\n            'nw': A.CompassDirection.NW, 'sw': A.CompassDirection.SW,\n            '>': A.MiscDirection.DOWN, '<': A.MiscDirection.UP,\n            '.': A.MiscDirection.WAIT,\n        }[dir]\n\n        self.step(action)\n        return True\n\n    def move(self, y, x=None):\n        if x is not None:\n            dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n        else:\n            dir = y\n\n        expected_y = self.blstats.y + ('s' in dir) - ('n' in dir)\n        expected_x = self.blstats.x + ('e' in dir) - ('w' in dir)\n\n        if (expected_y != self.blstats.y or expected_x != self.blstats.x) \\\n                and self.monster_tracker.monster_mask[expected_y, expected_x]:\n            # TODO: consider handling it in different way, since this situation is sometimes expected\n            raise AgentPanic(f'Monster on a next tile when moving: ({expected_y},{expected_x})')\n\n        # TODO: portals\n        if dir in ['<', '>']:\n            level = self.current_level()\n            with self.atom_operation():\n                self.direction(dir)\n                assert self.current_level().key() != level.key(), self.message\n                level.stair_destination[expected_y, expected_x] = \\\n                    (self.current_level().key(), (self.blstats.y, self.blstats.x))\n                # TODO: one way portals (elemental and astral planes)\n                self.current_level().stair_destination[\n                    (self.blstats.y, self.blstats.x)] = (level.key(), (expected_y, expected_x))\n\n        else:\n            self.direction(dir)\n\n            if self.blstats.y != expected_y or self.blstats.x != expected_x:\n                raise AgentPanic(f'agent position do not match after \"move\": '\n                                 f'expected ({expected_y}, {expected_x}), got ({self.blstats.y}, {self.blstats.x})')\n\n    def can_engrave(self):\n        if self.character.prop.polymorph:\n            return False  # TODO: only for handless monsters (which cannot write)\n        return (self.blstats.y, self.blstats.x) != self._forbidden_engrave_position\n\n    def engrave(self, text):\n        assert '\\r' not in text\n        ret = False\n\n        def gen():\n            nonlocal ret\n            if 'What do you want to write with?' not in self.single_message:\n                self._forbidden_engrave_position = (self.blstats.y, self.blstats.x)\n                yield A.Command.ESC\n                return\n            yield '-'\n            if 'Do you want to add to the current engraving?' in self.single_message:\n                yield 'n'\n            while self._observation['misc'][2]:\n                yield ' '\n            if 'What do you want to write in the dust here?' not in self.single_message:\n                self._forbidden_engrave_position = (self.blstats.y, self.blstats.x)\n                yield A.Command.ESC\n                return\n            yield from text\n            yield '\\r'\n            ret = True\n\n        with self.atom_operation():\n            self.step(A.Command.ENGRAVE, gen())\n            self.inventory.get_items_below_me()\n\n        if ret and text.lower() == 'elbereth':\n            self.stats_logger.log_event('elbereth_write')\n        return ret\n\n    ######## NON-TRIVIAL HELPERS\n\n    def neighbors(self, y, x, shuffle=True, diagonal=True):\n        ret = []\n        for dy in [-1, 0, 1]:\n            for dx in [-1, 0, 1]:\n                if dy == 0 and dx == 0:\n                    continue\n                if not diagonal and abs(dy) + abs(dx) > 1:\n                    continue\n                ny = y + dy\n                nx = x + dx\n                if 0 <= ny < C.SIZE_Y and 0 <= nx < C.SIZE_X:\n                    ret.append((ny, nx))\n\n        if shuffle:\n            self.rng.shuffle(ret)\n            pass\n\n        return ret\n\n    def bfs(self, y=None, x=None):\n        if y is None:\n            y = self.blstats.y\n        if x is None:\n            x = self.blstats.x\n\n        if self.last_bfs_step == self.step_count and y == self.blstats.y and x == self.blstats.x:\n            return self.last_bfs_dis.copy()\n\n        level = self.current_level()\n\n        walkable = level.walkable & ~utils.isin(self.glyphs, G.BOULDER) & \\\n                   ~self.monster_tracker.peaceful_monster_mask & \\\n                   ~level.forbidden\n\n        if self._last_turn - self._allow_walking_through_traps_turn > 50:\n            walkable &= ~utils.isin(level.objects, G.TRAPS)\n\n        for my, mx in list(zip(*np.nonzero(utils.isin(self.glyphs, G.MONS)))):\n            mon = MON.permonst(self.glyphs[my][mx])\n            if mon.mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS:\n                walkable[my, mx] = False\n\n        dis = utils.bfs(y, x,\n                        walkable=walkable,\n                        walkable_diagonally=walkable & ~utils.isin(level.objects, G.DOORS) & (level.objects != -1),\n                        can_squeeze=self.inventory.items.total_weight <= 600 and \\\n                                    self.current_level().dungeon_number != Level.SOKOBAN,\n                        )\n\n        if y == self.blstats.y and x == self.blstats.x:\n            self.last_bfs_dis = dis\n            self.last_bfs_step = self.step_count\n\n        return dis.copy()\n\n    def path(self, from_y, from_x, to_y, to_x, dis=None):\n        if from_y == to_y and from_x == to_x:\n            return [(to_y, to_x)]\n\n        if dis is None:\n            dis = self.bfs(from_y, from_x)\n\n        assert dis[to_y, to_x] != -1\n\n        # FIXME: currently the path can lead through diagonally inwalkable tiles.\n        #        The path is the shortest possible, so the agent is guaranteed to\n        #        unstuck itself eventually (usually a few panic exceptions) if that happens\n\n        cur_y, cur_x = to_y, to_x\n        path_rev = [(cur_y, cur_x)]\n        while cur_y != from_y or cur_x != from_x:\n            for y, x in self.neighbors(cur_y, cur_x):\n                if dis[y, x] == dis[cur_y, cur_x] - 1 and dis[y, x] >= 0:\n                    path_rev.append((y, x))\n                    cur_y, cur_x = y, x\n                    break\n            else:\n                assert 0\n\n        assert dis[cur_y, cur_x] == 0 and from_y == cur_y and from_x == cur_x\n        path = path_rev[::-1]\n        assert path[0] == (from_y, from_x) and path[-1] == (to_y, to_x)\n        return path\n\n    ######## NON-TRIVIAL ACTIONS\n\n    def _fast_go_to(self, y, x):\n        with self.atom_operation():\n            self.step(A.Command.TRAVEL)\n            py, px = self.cursor_pos\n            while py != y or px != x:\n                dy, dx = np.sign(y - py), np.sign(x - px)\n                self.direction(self.calc_direction(py, px, py + dy, px + dx))\n                py += dy\n                px += dx\n                assert (py, px) == self.cursor_pos\n            self.direction('.')\n\n        if (self.blstats.y, self.blstats.x) == (y, x):\n            return True\n\n    def go_to(self, y, x, stop_one_before=False, max_steps=None,\n              debug_tiles_args=None, callback=lambda: False, fast=False):\n        assert not stop_one_before or (self.blstats.y != y or self.blstats.x != x)\n        assert max_steps is None or not fast\n\n        if stop_one_before and self.bfs()[y, x] == -1:\n            dis = self.bfs()\n            best_p = None\n            for ny, nx in self.neighbors(y, x):\n                if dis[ny, nx] != -1 and (best_p is None or dis[best_p] > dis[ny, nx]):\n                    best_p = ny, nx\n            if best_p is None:\n                assert 0, 'no reachable neighbor'\n            y, x = best_p\n            stop_one_before = False\n\n        assert self.bfs()[y, x] != -1\n\n        if callback():\n            return\n        steps_taken = 0\n        cont = True\n        while cont and (self.blstats.y, self.blstats.x) != (y, x):\n            dis = self.bfs()\n            if dis[y, x] == -1:\n                raise AgentPanic('end point is no longer accessible')\n            path = self.path(self.blstats.y, self.blstats.x, y, x)\n            orig_path = path\n            path = path[1:]\n            if stop_one_before:\n                path = path[:-1]\n\n            if fast and len(path) > 2:\n                my_y, my_x = self.blstats.y, self.blstats.x\n                self._fast_go_to(*path[-1])\n                if (my_y, my_x) != (self.blstats.y, self.blstats.x):\n                    continue\n\n            with self.env.debug_tiles(orig_path, **debug_tiles_args) \\\n                    if debug_tiles_args is not None else contextlib.suppress():\n                for y, x in path:\n                    if self.monster_tracker.peaceful_monster_mask[y, x]:\n                        cont = True\n                        break\n                    if not self.current_level().walkable[y, x]:\n                        cont = True\n                        break\n                    self.move(y, x)\n                    if callback():\n                        return\n                    steps_taken += 1\n                    if max_steps is not None and steps_taken >= max_steps:\n                        cont = False\n                        break\n                else:\n                    cont = False\n\n    ######## LOW-LEVEL STRATEGIES\n\n    def get_visible_monsters(self):\n        \"\"\" Returns list of tuples (distance, y, x, permonst, monster_glyph)\n        \"\"\"\n        mask = self.monster_tracker.monster_mask & ~self.monster_tracker.peaceful_monster_mask\n        if not mask.any():\n            return []\n\n        dis = self.bfs()\n        ret = []\n        for y, x in zip(*mask.nonzero()):\n            if (dis[max(y - 1, 0):y + 2, max(x - 1, 0):x + 2] != -1).any():\n                if self.glyphs[y, x] == nh.GLYPH_INVISIBLE or \\\n                        not MON.is_monster(self.glyphs[y, x]):  # TODO: some ghost are not visible in glyphs (?)\n                    if utils.adjacent((self.blstats.y, self.blstats.x), (y, x)):\n                        class dummy_permonst:\n                            mname = 'unknown'\n                            mlet = '0'\n                            mmove = 12\n\n                        ret.append((dis[y][x], y, x, dummy_permonst(), self.glyphs[y][x]))\n                else:\n                    ret.append((dis[y][x], y, x, MON.permonst(self.glyphs[y][x]), self.glyphs[y][x]))\n        ret.sort()\n        return ret\n\n    @utils.debug_log('fight2')\n    @Strategy.wrap\n    def fight2(self):\n        yielded = False\n        wait_counter = 0\n        while 1:\n            monsters = self.get_visible_monsters()\n            allow_attack_all = self._last_turn - self._allow_attack_all_turn < 3\n            only_ranged_slow_monsters = all([monster[3].mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS\n                                             and not combat.monster_utils.consider_melee_only_ranged_if_hp_full(self,\n                                                                                                                monster)\n                                             for monster in monsters])\n\n            dis = self.bfs()\n\n            if not monsters or all(dis > 7 for dis, *_ in monsters) or \\\n                    (only_ranged_slow_monsters and not self.inventory.get_ranged_combinations()\n                     and np.sum(dis != -1) > 1 and not allow_attack_all):\n                if wait_counter:\n                    self.search()\n                    wait_counter -= 1\n                    continue\n                if not yielded:\n                    yield False\n                return\n\n            if not yielded:\n                yielded = True\n                yield True\n                self.character.parse_enhance_view()\n                # self.character.parse_spellcast_view()\n\n            move_priority_heatmap, actions = combat.fight_heur.get_priorities(self)\n            actions.extend(combat.fight_heur.get_move_actions(self, dis, move_priority_heatmap))\n\n            if self.character.prop.polymorph:\n                actions = list(filter(lambda x: x[1][0] != 'ranged', actions))\n\n            if allow_attack_all:\n                attack_actions = [a for a in actions if a[1][0] in ('melee', 'ranged', 'zap')]\n                if attack_actions:\n                    actions = attack_actions\n\n            if not actions:\n                assert 0, 'No possible action available during fight2'\n\n            priority, best_action = max(actions, key=lambda x: x[0]) if actions else None\n\n            with self.env.debug_tiles(move_priority_heatmap, color='turbo', is_heatmap=True):\n                actions_str = '|'.join([combat.utils.action_str(self, a) for a in sorted(actions, key=lambda x: x[0])])\n                with self.env.debug_log(actions_str):\n                    wait_counter = self._fight2_perform_action(best_action, wait_counter)\n\n    def _fight2_perform_action(self, best_action, wait_counter):\n        if best_action[0] == 'move':\n            _, dy, dx = best_action\n            target_y, target_x = self.blstats.y + dy, self.blstats.x + dx\n            with self.env.debug_tiles([[self.blstats.y, self.blstats.x],\n                                       [target_y, target_x]], color=(0, 255, 0), is_path=True):\n                wait_counter = 5\n                self.move(target_y, target_x)\n                return wait_counter\n        elif best_action[0] == 'melee':\n            _, dy, dx = best_action\n            target_y = self.blstats.y + dy\n            target_x = self.blstats.x + dx\n            if self.wield_best_melee_weapon():\n                return wait_counter\n            with self.env.debug_tiles([[self.blstats.y, self.blstats.x],\n                                       [target_y, target_x]], color=(255, 0, 255), is_path=True):\n                self.melee_attack(target_y, target_x)\n                wait_counter = 0\n                return wait_counter\n\n        elif best_action[0] == 'ranged':\n            _, dy, dx = best_action\n            target_y = self.blstats.y + dy\n            target_x = self.blstats.x + dx\n            launcher, ammo = self.inventory.get_best_ranged_set()\n            assert ammo is not None\n            if launcher is not None and not launcher.equipped:\n                if self.inventory.wield(launcher):\n                    return wait_counter\n            with self.env.debug_tiles([[target_y, target_x]], (0, 0, 255, 255), mode='frame'):\n                dir = self.calc_direction(self.blstats.y, self.blstats.x, target_y, target_x,\n                                          allow_nonunit_distance=True)\n                fired = self.fire(ammo, dir)\n                assert fired, (ammo, dir)\n                return wait_counter\n\n        elif best_action[0] == 'elbereth':\n            assert self.inventory.engraving_below_me.lower() != 'elbereth'\n            self.engrave(\"Elbereth\")\n            return wait_counter\n        elif best_action[0] == 'wait':\n            assert self.inventory.engraving_below_me.lower() == 'elbereth'\n            self.stats_logger.log_event('wait_in_fight')\n            self.search()\n            return wait_counter\n        elif best_action[0] == 'zap':\n            if len(best_action) == 5:\n                _, dy, dx, wand, targeted_monsters = best_action\n            else:\n                _, dy, dx, = best_action\n                for item in self.inventory.items:\n                    if item.is_offensive_usable_wand():\n                        wand = item\n                        break\n                else:\n                    assert 0\n                targeted_monsters = []\n            dir = self.calc_direction(self.blstats.y, self.blstats.x, self.blstats.y + dy, self.blstats.x + dx,\n                                      allow_nonunit_distance=True)\n\n            with self.env.debug_tiles([[my, mx] for my, mx, _ in targeted_monsters],\n                                      (255, 0, 255, 255), mode='frame'):\n                self.zap(wand, dir)\n            return wait_counter\n\n        elif best_action[0] == 'pickup':\n            if len(best_action) == 2:\n                _, items_to_pickup = best_action\n            else:\n                items_to_pickup = combat.fight_heur.decide_what_to_pickup(self)\n            self.inventory.pickup(items_to_pickup)\n            return wait_counter\n        elif best_action[0] == 'go_to':\n            _, target_y, target_x = best_action\n            self.go_to(target_y, target_x, stop_one_before=True, max_steps=1,\n                       debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n            return wait_counter\n        raise NotImplementedError(best_action)\n\n    @utils.debug_log('engulfed_fight')\n    @Strategy.wrap\n    def engulfed_fight(self):\n        if not utils.any_in(self.glyphs, G.SWALLOW):\n            yield False\n        yield True\n        while True:\n            mask = utils.isin(self.glyphs, G.SWALLOW)\n            if not mask.any():\n                break\n            assert self.melee_attack(*list(zip(*mask.nonzero()))[0])\n\n    def _is_corpse_editable(self, monster_id, age_turn):\n        permonst = MON.permonst(monster_id)\n\n        # TODO: read intrinsics\n        if self.character.race != Character.ORC and permonst.mflags1 & MON.M1_POIS != 0:\n            return False\n\n        # TODO: read intrinsics\n        if permonst.mflags1 & MON.M1_ACID != 0:\n            return False\n\n        if permonst.mflags2 & MON.M2_WERE != 0:\n            return False\n\n        # polymorph\n        if monster_id in [MON.id_from_name(name) for name in ['chameleon', 'doppelganger', 'sandestin']]:\n            return False\n\n        # remove random intrinsic\n        if monster_id in [MON.id_from_name(name) for name in ['disenchanter']]:\n            return False\n\n        # hallucination\n        if monster_id in [MON.id_from_name(name) for name in ['abbot', 'violet fungus', 'yellow mold']]:\n            return False\n\n        # stun\n        if monster_id in [MON.id_from_name(name) for name in ['bat', 'giant bat']]:\n            return False\n\n        # aggravate monster\n        if monster_id in [MON.id_from_name(name) for name in ['dog', 'little dog', 'large dog',\n                                                              'kitten', 'housecat', 'large cat']]:\n            return False\n\n        # teleportitis\n        # if ord(permonst.mlet) in [MON.S_LEPRECHAUN, MON.S_NYMPH]:\n        #     return False\n\n        # petrification\n        if ord(permonst.mlet) == MON.S_COCKATRICE or monster_id == MON.id_from_name('Medusa'):\n            return False\n\n        # temporary prevents movement\n        if ord(permonst.mlet) == MON.S_MIMIC:\n            return False\n\n        # cannibalism\n        race_flag = {\n            Character.HUMAN: MON.M2_HUMAN,\n            Character.DWARF: MON.M2_DWARF,\n            Character.ELF: MON.M2_ELF,","lineStart":1,"lineEnd":1296,"totalLines":1297,"truncated":true}},"title":"workspace/autoascend/agent.py","time":{"start":1790679607653,"end":1790679607675}},"id":"prt_0ecd26961001ucgrluog0t8Cks","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ecd25e1b001DwPTVlrAxy4cNe"}}
{"type":"tool_use","timestamp":1790679607732,"sessionID":"ses_f132db44effejOC7YW0uFAg7SL","part":{"type":"tool","tool":"read","callID":"call_function_e73rj61dkpkj_2","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/global_logic.py"},"output":"<path>/workspace/autoascend/global_logic.py</path>\n<type>file</type>\n<content>\n1: from enum import IntEnum, auto\n2: \n3: import nle.nethack as nh\n4: import numpy as np\n5: from nle.nethack import actions as A\n6: \n7: from . import objects as O\n8: from . import soko_solver\n9: from . import utils\n10: from .character import Character\n11: from .exceptions import AgentPanic\n12: from .glyph import Hunger, G, MON\n13: from .item import Item, flatten_items\n14: from .item.item_priority_base import ItemPriorityBase\n15: from .level import Level\n16: from .strategy import Strategy\n17: \n18: \n19: class ItemPriority(ItemPriorityBase):\n20:     MAX_NUMBER_OF_ITEMS = 26 * 2 - 1  # + coin slot, one slot should be left for item arranging\n21:     def __init__(self, agent):\n22:         self.agent = agent\n23:         self._take_sacrificial_corpses = False\n24:         self._drop_gold_till_turn = -float('inf')\n25: \n26:     def _split(self, items, forced_items, weight_capacity):\n27:         remaining_weight = weight_capacity\n28:         ret_inv = {}\n29:         for item in forced_items:\n30:             remaining_weight -= item.weight()\n31:             ret_inv[item] = item.count\n32: \n33:         ret_bag = {}\n34:         bag = None\n35: \n36:         def add_item(item, count=None, to_bag=False):\n37:             nonlocal ret_inv, ret_bag, remaining_weight\n38:             assert isinstance(item, Item)\n39:             if to_bag and bag is not None and item is not bag:\n40:                 ret = ret_bag\n41:             else:\n42:                 ret = ret_inv\n43: \n44:             if remaining_weight < 0 or \\\n45:                     (ret is ret_inv and len(ret) >= ItemPriority.MAX_NUMBER_OF_ITEMS):  # TODO: coin slot\n46:                 return\n47: \n48:             how_many_already_total = ret_inv.get(item, 0) + ret_bag.get(item, 0)\n49:             how_many_already = ret.get(item, 0)\n50:             max_to_add = int(remaining_weight // item.unit_weight(with_content=False))\n51:             if count is not None:\n52:                 max_to_add = min(max_to_add, count)\n53:             ret[item] = min(item.count, how_many_already_total + max_to_add) - (how_many_already_total - how_many_already)\n54:             remaining_weight -= item.unit_weight(with_content=False) * (ret[item] - how_many_already)\n55: \n56:         for item in items:\n57:             if item.is_container() and item.status in [Item.UNCURSED, Item.BLESSED] and item.objs[0].desc == 'bag':\n58:                 bag = item  # TODO: select the best\n59:                 add_item(bag)\n60: \n61:         if self._drop_gold_till_turn < self.agent.blstats.time:\n62:             for item in items:\n63:                 if item.category == nh.COIN_CLASS:\n64:                     add_item(item)\n65: \n66:         for allow_unknown_status in [False, True]:\n67:             item = self.agent.inventory.get_best_melee_weapon(items=forced_items + items,\n68:                                                               allow_unknown_status=allow_unknown_status)\n69:             if item is not None:\n70:                 add_item(item)\n71: \n72:             for item in self.agent.inventory.get_best_armorset(items=forced_items + items,\n73:                                                                allow_unknown_status=allow_unknown_status):\n74:                 if item is not None:\n75:                     add_item(item)\n76: \n77:         for item in items:\n78:             if item.is_unambiguous():\n79:                 if item.object in [\n80:                         O.from_name('healing', nh.POTION_CLASS),\n81:                         O.from_name('extra healing', nh.POTION_CLASS),\n82:                         O.from_name('full healing', nh.POTION_CLASS)]:\n83:                     add_item(item)\n84: \n85:                 if self.agent.character.role in [Character.RANGER, Character.ROGUE,\n86:                                                  Character.SAMURAI, Character.TOURIST] and \\\n87:                         (item.is_launcher() or item.is_fired_projectile()):\n88:                     add_item(item)\n89: \n90:         if self.agent.character.alignment == Character.LAWFUL:\n91:             for item in sorted(filter(lambda i: i.objs[0].name == 'long sword', items),\n92:                                key=lambda i: -utils.calc_dps(*self.agent.character.get_melee_bonus(i))):\n93:                 add_item(item)\n94:                 break\n95: \n96:         for item in sorted(filter(lambda i: i.is_thrown_projectile(), items),\n97:                            key=lambda i: -utils.calc_dps(*self.agent.character.get_ranged_bonus(None, i))):\n98:             add_item(item)\n99: \n100:         for item in sorted(filter(lambda i: i.is_food() and not i.is_corpse(), items),\n101:                            key=lambda x: -x.nutrition_per_weight() - 1000 * (x.objs[0].name == 'sprig of wolfsbane')):\n102:             add_item(item)\n103: \n104:         if self._take_sacrificial_corpses:\n105:             for item in filter(self.agent.global_logic.can_sacrify, items):\n106:                 add_item(item)\n107: \n108:         # TODO: take nh.COIN_CLASS once shopping is implemented.\n109:         # You have to drop all coins not to be attacked by a vault guard\n110: \n111:         for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n112:             if item.category in [nh.POTION_CLASS, nh.RING_CLASS, nh.AMULET_CLASS, nh.WAND_CLASS, nh.SCROLL_CLASS, nh.TOOL_CLASS]:\n113:                 if (not isinstance(item.objs[0], O.Container) or not item.is_chest()) and \\\n114:                         not item.is_possible_container():\n115:                     to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n116:                              not item.is_offensive_usable_wand()\n117:                     to_bag = False\n118:                     if not item.is_container():  # remove condition to pick up bags\n119:                         add_item(item, to_bag=to_bag)\n120: \n121:         categories = [nh.WEAPON_CLASS, nh.ARMOR_CLASS, nh.TOOL_CLASS, nh.FOOD_CLASS, nh.GEM_CLASS, nh.AMULET_CLASS,\n122:                       nh.RING_CLASS, nh.POTION_CLASS, nh.SCROLL_CLASS, nh.SPBOOK_CLASS, nh.WAND_CLASS]\n123:         for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n124:             if item.category in categories and not isinstance(item.objs[0], O.Container) and not item.is_corpse():\n125:                 if item.status == Item.UNKNOWN:\n126:                     to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n127:                              not item.is_offensive_usable_wand()\n128:                     to_bag = False\n129:                     if not item.is_container():  # remove condition to pick up bags\n130:                         add_item(item, to_bag=to_bag)\n131: \n132:         r = {None: [ret_inv.get(item, 0) for item in items]}\n133:         if bag is not None:\n134:             r[bag] = [ret_bag.get(item, 0) for item in items]\n135:         for item in items:\n136:             if item.is_container() and item is not bag and ret_inv.get(item, 0) != 0:\n137:                 r[item] = [0 for _ in items]\n138:         return r\n139: \n140: \n141: class Milestone(IntEnum):\n142:     BE_ON_FIRST_LEVEL = auto()\n143:     FIND_GNOMISH_MINES = auto()\n144:     # FIND_LIGHT_GNOMISH_MINES = auto()\n145:     # FARM_LIGHT_GNOMISH_MINES = auto()\n146:     FIND_MINETOWN = auto()\n147:     FIND_SOKOBAN = auto()\n148:     SOLVE_SOKOBAN = auto()\n149:     FIND_MINES_END = auto()\n150:     GO_DOWN = auto() # TODO\n151: \n152: \n153: class GlobalLogic:\n154:     def __init__(self, agent):\n155:         self.agent = agent\n156:         self.milestone = Milestone(1)\n157:         self.step_completion_log = {}  # Milestone -> (step, turn)\n158: \n159:         self.item_priority = ItemPriority(self.agent)\n160: \n161:         self.oracle_level = None\n162:         self.minetown_level = None\n163: \n164:         self._got_artifact = False\n165: \n166:     def update(self):\n167:         if not self.agent.character.prop.hallu:\n168:             if utils.isin(self.agent.glyphs, G.ORACLE).any():\n169:                 if self.oracle_level is None:\n170:                     self.oracle_level = self.agent.current_level().key()\n171:                 else:\n172:                     assert self.oracle_level == self.agent.current_level().key()\n173: \n174:             if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n175:                     utils.isin(self.agent.glyphs, G.SHOPKEEPER).any():\n176:                 if self.minetown_level is None:\n177:                     self.minetown_level = self.agent.current_level().key()\n178:                 else:\n179:                     assert self.minetown_level == self.agent.current_level().key()\n180: \n181:     @utils.debug_log('solving sokoban')\n182:     @Strategy.wrap\n183:     def solve_sokoban_strategy(self):\n184:         # TODO: refactor\n185:         if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n186:             yield False\n187:         yield True\n188: \n189:         def push_bolder(ty, tx, dy, dx):\n190:             while 1:\n191:                 if self.agent.bfs()[ty, tx] == -1:\n192:                     return False\n193:                 self.agent.go_to(ty, tx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n194:                 with self.agent.atom_operation():\n195:                     direction = self.agent.calc_direction(ty, tx, ty + dy, tx + dx)\n196:                     self.agent.direction(direction)\n197:                     message = self.agent.message\n198: \n199:                 if (self.agent.blstats.y, self.agent.blstats.x) == (ty, tx):\n200:                     assert 'You hear a monster behind the boulder.' in message or \\\n201:                            'You try to move the boulder, but in vain.' in message, message\n202:                     if self.agent.bfs()[ty + dy, tx + dx] != -1:\n203:                         self.agent.go_to(ty + dy, tx + dx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n204:                         continue\n205:                     else:\n206:                         pickaxe = None\n207:                         for item in flatten_items(self.agent.inventory.items):\n208:                             if item.is_unambiguous() and \\\n209:                                     item.object in [O.from_name('pick-axe'), O.from_name('dwarvish mattock')]:\n210:                                 pickaxe = item\n211:                                 break\n212:                         if pickaxe is not None:\n213:                             with self.agent.atom_operation():\n214:                                 pickaxe = self.agent.inventory.move_to_inventory(pickaxe)\n215:                                 self.agent.step(A.Command.APPLY)\n216:                                 self.agent.type_text(self.agent.inventory.items.get_letter(pickaxe))\n217:                                 self.agent.direction(direction)\n218:                             return True\n219:                 else:\n220:                     return True\n221: \n222:                 # TODO: not sure what to do\n223:                 self.agent.exploration.explore1(None).run()\n224: \n225:         while 1:\n226:             wall_map = utils.isin(self.agent.current_level().objects, G.WALL)\n227:             for smap, answer in soko_solver.maps.items():\n228:                 sokomap = soko_solver.convert_map(smap)\n229:                 offset = np.array(min(zip(*wall_map.nonzero()))) - \\\n230:                          np.array(min(zip(*(sokomap.sokomap == soko_solver.WALL).nonzero())))\n231:                 mask = wall_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n232:                                 offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n233:                 if (mask & (sokomap.sokomap == soko_solver.WALL) == mask).all():\n234:                     break\n235:             else:\n236:                 assert 0, 'sokomap not found'\n237: \n238:             possible_mimics = set()\n239:             last_resort_move = None\n240:             for (y, x), (dy, dx) in answer:\n241:                 boulder_map = utils.isin(self.agent.glyphs, G.BOULDER)\n242:                 mask = boulder_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n243:                                    offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n244:                 ty, tx = offset[0] + y - dy, offset[1] + x - dx,\n245:                 soko_boulder_mask = sokomap.sokomap == soko_solver.BOULDER\n246:                 if self.agent.bfs()[ty, tx] != -1 and \\\n247:                         ((soko_boulder_mask | mask) == soko_boulder_mask).all() and \\\n248:                         self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER:\n249: \n250:                     soko_dis1 = sokomap.bfs()\n251:                     sokomap.move(y, x, dy, dx)\n252:                     soko_dis2 = sokomap.bfs()\n253: \n254:                     # see points that will no longer be accessible\n255:                     with self.agent.env.debug_log('checking for monsters'):\n256:                         to_visit_mask = self.agent.bfs() != -1\n257:                         to_visit_mask[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n258:                                       offset[1] : offset[1] + sokomap.sokomap.shape[1]] &= \\\n259:                                               (soko_dis1 != -1) & (soko_dis2 == -1)\n260: \n261:                         with self.agent.env.debug_tiles(to_visit_mask, color=(255, 0, 0, 128)):\n262:                             while to_visit_mask.any():\n263:                                 vy, vx = list(zip(*to_visit_mask.nonzero()))[0]\n264:                                 to_visit_mask[vy, vx] = 0\n265: \n266:                                 def clear_neighbors():\n267:                                     to_visit_mask[self.agent.blstats.y, self.agent.blstats.x] = 0\n268:                                     to_visit_mask[utils.isin(self.agent.glyphs, G.VISIBLE_FLOOR)] = 0\n269:                                     return not to_visit_mask[vy, vx]\n270: \n271:                                 self.agent.go_to(vy, vx, callback=clear_neighbors)\n272: \n273:                     if not push_bolder(ty, tx, dy, dx):\n274:                         continue\n275: \n276:                     possible_mimics = set()\n277:                     last_resort_move = None\n278: \n279:                     if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n280:                         return\n281: \n282:                 else:\n283:                     sokomap.move(y, x, dy, dx)\n284: \n285:                 if (~soko_boulder_mask | mask).all():\n286:                     if self.agent.bfs()[ty, tx] != -1 and \\\n287:                             self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER and \\\n288:                             last_resort_move is None:\n289:                         last_resort_move = (ty, tx, dy, dx)\n290: \n291:                     if not possible_mimics:\n292:                         for mim_y, mim_x in zip(*(~soko_boulder_mask & mask).nonzero()):\n293:                             possible_mimics.add((mim_y + offset[0], mim_x + offset[1]))\n294: \n295: \n296:             # sokoban configuration is not in the list. Check for mimics\n297:             with self.agent.env.debug_log('mimics'):\n298:                 with self.agent.env.debug_tiles(possible_mimics, color=(255, 0, 0, 128)):\n299:                     for mim_y, mim_x in sorted(possible_mimics):\n300:                         if (self.agent.bfs()[max(0, mim_y - 1) : mim_y + 2, max(0, mim_x - 1) : mim_x + 2] != -1).any():\n301:                             self.agent.go_to(mim_y, mim_x, stop_one_before=True,\n302:                                              debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n303:                             for _ in range(3):\n304:                                 self.agent.search()\n305: \n306:             # last resort move (sometimes we can see a mimic diagonally but cannot reach it)\n307:             with self.agent.env.debug_log('last_resort'):\n308:                 if last_resort_move is not None:\n309:                     ty, tx, dy, dx = last_resort_move\n310:                     push_bolder(ty, tx, dy, dx)\n311:                     continue\n312: \n313:             self.agent.stats_logger.log_event('sokoban_dropped')\n314:             self.milestone = Milestone(int(self.milestone) + 1)\n315:             raise AgentPanic('sokomap unsolvable')\n316: \n317:     @Strategy.wrap\n318:     def wait_out_unexpected_state_strategy(self):\n319:         yielded = False\n320:         while (\n321:                 self.agent.character.prop.blind or\n322:                 self.agent.character.prop.confusion or\n323:                 self.agent.character.prop.stun or\n324:                 self.agent.character.prop.hallu or\n325:                 self.agent.character.prop.polymorph):\n326:             if not yielded:\n327:                 yield True\n328:                 yielded = True\n329: \n330:             self.agent.direction('.')\n331: \n332:         if not yielded:\n333:             yield False\n334: \n335:     @utils.debug_log('identify_items_on_altar')\n336:     @Strategy.wrap\n337:     def identify_items_on_altar(self):\n338:         mask = utils.isin(self.agent.current_level().objects, G.ALTAR)\n339:         if not mask.any():\n340:             yield False\n341: \n342:         dis = self.agent.bfs()\n343:         mask &= dis != -1\n344:         if not mask.any():\n345:             yield False\n346: \n347:         yield any((item.status == Item.UNKNOWN for item in flatten_items(self.agent.inventory.items)\n348:                    if item.can_be_dropped_from_inventory()))\n349: \n350:         (ty, tx), *_ = zip(*(mask & (dis == dis[mask].min())).nonzero())\n351:         self.agent.go_to(ty, tx)\n352:         items_to_drop = [item for item in flatten_items(self.agent.inventory.items)\n353:                          if item.can_be_dropped_from_inventory() and item.status == Item.UNKNOWN]\n354:         if not items_to_drop:\n355:             raise AgentPanic('items to drop on altar vanished')\n356: \n357:         # TODO: move chunking to inventory.drop\n358:         items_to_drop = items_to_drop[:self.agent.inventory.items.free_slots()]\n359: \n360:         self.agent.inventory.drop(items_to_drop)\n361: \n362:     @utils.debug_log('dip_for_excalibur')\n363:     @Strategy.wrap\n364:     def dip_for_excalibur(self):\n365:         if self.agent.character.alignment != Character.LAWFUL or self.agent.blstats.experience_level < 5:\n366:             yield False\n367:         if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n368:                 (self.minetown_level is None or self.agent.current_level().key() == self.minetown_level):\n369:             yield False\n370: \n371:         dis = self.agent.bfs()\n372:         mask = utils.isin(self.agent.current_level().objects, G.FOUNTAIN) & (dis != -1)\n373:         if not mask.any():\n374:             yield False\n375: \n376:         def excalibur_candidate():\n377:             candidate = None\n378:             for item in flatten_items(self.agent.inventory.items):\n379:                 if item.is_unambiguous() and item.object == O.from_name('long sword'):\n380:                     if item.dmg_bonus is not None: # TODO: better condition for excalibur existance\n381:                         return None\n382:                     candidate = item\n383:             return candidate\n384: \n385:         if excalibur_candidate() is None:\n386:             yield False\n387:         yield True\n388: \n389:         self.agent.go_to(*list(zip(*mask.nonzero()))[0])\n390: \n391:         candidate = excalibur_candidate()\n392:         if candidate is None:\n393:             return\n394: \n395:         # TODO: refactor\n396:         with self.agent.atom_operation():\n397:             candidate = self.agent.inventory.move_to_inventory(candidate)\n398:             self.agent.step(A.Command.DIP)\n399:             self.agent.type_text(self.agent.inventory.items.get_letter(candidate))\n400:             if 'What do you want to dip ' in self.agent.message and 'into?' in self.agent.message:\n401:                 raise AgentPanic('no fountain here')\n402: \n403:     def can_sacrify(self, item):\n404:         if not item.is_corpse() or item.comment == 'old':\n405:             return False\n406: \n407:         mname = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mname\n408:         if (mname == 'pony' and self.agent.character.role in [Character.KNIGHT, Character.BARBARIAN]) or \\\n409:                 (mname == 'kitten' and self.agent.character.role == [Character.BARBARIAN, Character.WIZARD]) or \\\n410:                 (mname == 'little dog' and item.naming):  # little dogs are always named\n411:             # sufficient condition for being an initial pet\n412:             return False\n413: \n414:         if self.agent.character.alignment != Character.CHAOTIC:\n415:             mapping = {\n416:                 Character.HUMAN: MON.M2_HUMAN | MON.M2_WERE,\n417:                 Character.DWARF: MON.M2_DWARF,\n418:                 Character.ELF: MON.M2_ELF,\n419:                 Character.GNOME: MON.M2_GNOME,\n420:                 Character.ORC: MON.M2_ORC,\n421:             }\n422:             f2 = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mflags2\n423:             if (f2 & mapping[self.agent.character.race]) > 0:\n424:                 return False\n425: \n426:         return True\n427: \n428:     @utils.debug_log('offer_corpses')\n429:     @Strategy.wrap\n430:     def offer_corpses(self):\n431:         self.item_priority._take_sacrificial_corpses = False\n432: \n433:         if self._got_artifact:\n434:             yield False\n435: \n436:         altars = [p for p, alignment in self.agent.current_level().altars.items()\n437:                   if alignment == self.agent.character.alignment]\n438: \n439:         if not altars:\n440:             yield False\n441: \n442:         dis = self.agent.bfs()\n443:         altars = [(y, x) for y, x in altars if dis[y, x] != -1]\n444: \n445:         if not altars:\n446:             yield False\n447: \n448:         self.item_priority._take_sacrificial_corpses = True\n449: \n450:         if not any((self.can_sacrify(item) for item in flatten_items(self.agent.inventory.items))):\n451:             yield False\n452: \n453:         yield True\n454: \n455:         y, x = min(altars, key=lambda p: dis[p])\n456:         self.agent.go_to(y, x)\n457:         with self.agent.panic_if_position_changes():\n458:             while 1:\n459:                 for item in flatten_items(self.agent.inventory.items):\n460:                     if self.can_sacrify(item):\n461:                         with self.agent.atom_operation():\n462:                             item = self.agent.inventory.move_to_inventory(item)\n463:                             assert self.can_sacrify(item)\n464:                             self.agent.step(A.Command.OFFER)\n465:                             while ('There is ' in self.agent.message or 'There are ' in self.agent.message) and \\\n466:                                     ('sacrifice it?' in self.agent.message or 'sacrifice one?' in self.agent.message):\n467:                                 self.agent.type_text('n')\n468:                             assert 'What do you want to sacrifice?' in self.agent.message, self.agent.message\n469:                             self.agent.type_text(self.agent.inventory.items.get_letter(item))\n470:                             if 'Nothing happens.' in self.agent.message:\n471:                                 self.agent.inventory.call_item(item, 'old')\n472:                                 return\n473:                             if 'Use my gift wisely' in self.agent.message:\n474:                                 self._got_artifact = True\n475:                                 self.agent.inventory.get_items_below_me()\n476:                                 return\n477:                             if 'So this is how you repay loyalty?' in self.agent.message:\n478:                                 raise AgentPanic('pet sacrified')\n479:                             assert 'Your sacrifice is consumed in a flash of light' in self.agent.message or \\\n480:                                 'Your sacrifice is consumed in a burst of flame' in self.agent.message or \\\n481:                                 ('The blood covers the altar!' in self.agent.message and \\\n482:                                  'You have summoned ' in self.agent.message), \\\n483:                                 self.agent.message\n484:                             break\n485:                 else:\n486:                     break\n487: \n488:     @utils.debug_log('follow_guard')\n489:     @Strategy.wrap\n490:     def follow_guard(self):\n491:         if not utils.isin(self.agent.glyphs, G.GUARD).any():\n492:             yield False\n493: \n494:         if any(item.category == nh.COIN_CLASS for item in flatten_items(self.agent.inventory.items)):\n495:             yield True\n496:             # if 'Please drop that gold and follow me.' in self.message:\n497:             self.agent.stats_logger.log_event('drop_gold')\n498:             self.item_priority._drop_gold_till_turn = self.agent.blstats.time + 100\n499:             self.agent.inventory.arrange_items().run()\n500:             return\n501: \n502:         ys, xs = utils.isin(self.agent.glyphs, G.GUARD).nonzero()\n503:         y, x = ys[0], xs[0]\n504: \n505:         if utils.adjacent((y, x), (self.agent.blstats.y, self.agent.blstats.x)):\n506:             yield False\n507: \n508:         yield True\n509: \n510:         self.agent.go_to(y, x, stop_one_before=True)\n511: \n512:     @Strategy.wrap\n513:     def current_strategy(self):\n514:         yield True\n515:         while 1:\n516:             explore_stairs_condition = lambda: False\n517:             if self.milestone == Milestone.BE_ON_FIRST_LEVEL:\n518:                 condition = lambda: self.agent.blstats.experience_level >= 8\n519:                 # explore_stairs_condition = lambda: self.agent.inventory.items.total_nutrition() == 0 and \\\n520:                 #                                    self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY\n521:                 level = (Level.DUNGEONS_OF_DOOM, 1)\n522: \n523:             elif self.milestone == Milestone.FIND_SOKOBAN:\n524:                 condition = lambda: self.agent.current_level().dungeon_number == Level.SOKOBAN\n525:                 level = (Level.SOKOBAN, 4)\n526: \n527:             elif self.milestone == Milestone.FIND_GNOMISH_MINES:\n528:                 condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES\n529:                 level = (Level.GNOMISH_MINES, 1)\n530: \n531:             # elif self.milestone == Milestone.FIND_LIGHT_GNOMISH_MINES:\n532:             #     condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES \\\n533:             #             and self.agent.current_level().is_light_level()\n534:             #     level = (Level.GNOMISH_MINES, 9)\n535: \n536:             # elif self.milestone == Milestone.FARM_LIGHT_GNOMISH_MINES:\n537:             #     condition = lambda: self.agent.blstats.experience_level >= 11\n538:             #     level = (Level.GNOMISH_MINES, self.agent.current_level().level_number)\n539: \n540:             elif self.milestone == Milestone.FIND_MINETOWN:\n541:                 condition = lambda: self.minetown_level is not None\n542:                 level = (Level.GNOMISH_MINES, 4)  # TODO\n543: \n544:             elif self.milestone == Milestone.SOLVE_SOKOBAN:\n545:                 # TODO: fix the condition, monster can destroy doors\n546:                 condition = lambda: self.agent.current_level().key() == (Level.SOKOBAN, 1) and \\\n547:                                     not utils.isin(self.agent.current_level().objects, G.DOOR_CLOSED).any()\n548:                 level = (Level.SOKOBAN, 1)\n549: \n550:             elif self.milestone == Milestone.FIND_MINES_END:\n551:                 condition = lambda: self.agent.current_level().key() == (Level.GNOMISH_MINES, 9)  # TODO\n552:                 level = (Level.GNOMISH_MINES, 9)  # TODO\n553: \n554:             else:\n555:                 # TODO\n556:                 condition = lambda: False\n557:                 level = (Level.DUNGEONS_OF_DOOM, 100)\n558: \n559:             if condition():\n560:                 self.milestone = Milestone(int(self.milestone) + 1)\n561:                 continue\n562: \n563: \n564:             def exploration_strategy(level, **kwargs):\n565:                 return (\n566:                     Strategy(lambda: self.agent.exploration.explore1(level, trap_search_offset=1,\n567:                         kick_doors=self.agent.current_level().dungeon_number != Level.GNOMISH_MINES, **kwargs).strategy())\n568:                     .preempt(self.agent, [\n569:                         self.identify_items_on_altar().every(100),\n570:                         self.identify_items_on_altar().condition(\n571:                             lambda: self.agent.current_level().objects[self.agent.blstats.y,\n572:                                                                        self.agent.blstats.x] in G.ALTAR),\n573:                         self.dip_for_excalibur().condition(\n574:                             lambda: self.agent.blstats.experience_level >= 7).every(10),\n575:                     ])\n576:                 )\n577: \n578:             def go_to_strategy(y, x):\n579:                 return (\n580:                     exploration_strategy(None)\n581:                     .preempt(self.agent, [\n582:                         self.agent.exploration.go_to_strategy(y, x).preempt(self.agent, [\n583:                             self.agent.inventory.gather_items(),\n584:                             self.identify_items_on_altar(),\n585:                             self.dip_for_excalibur().condition(lambda: self.agent.blstats.experience_level >= 7),\n586:                         ])\n587:                         .condition(lambda: self._got_artifact or\n588:                                            not any([alignment == self.agent.character.alignment\n589:                                                     for _, alignment in self.agent.current_level().altars.items()]))\n590:                     ])\n591:                     .until(self.agent, lambda: (self.agent.blstats.y, self.agent.blstats.x) == (y, x))\n592:                 )\n593: \n594:             (\n595:                 self.agent.exploration.go_to_level_strategy(*level, go_to_strategy, exploration_strategy(None))\n596:                 .before(exploration_strategy(None))#.before(self.agent.exploration.patrol())\n597:                 .preempt(self.agent, [\n598:                     exploration_strategy(0),\n599:                     exploration_strategy(None).until(\n600:                         self.agent, lambda: self.agent.blstats.hitpoints >= 0.8 * self.agent.blstats.max_hitpoints)\n601:                 ])\n602:                 .preempt(self.agent, [\n603:                     self.agent.exploration.explore_stairs(go_to_strategy, all=True).condition(explore_stairs_condition),\n604:                 ])\n605:                 .until(self.agent, condition)\n606:             ).run()\n607: \n608:     def global_strategy(self):\n609:         return (\n610:             self.current_strategy().repeat()\n611:             .preempt(self.agent, [\n612:                 self.solve_sokoban_strategy()\n613:                 .condition(lambda: self.milestone == Milestone.SOLVE_SOKOBAN and\n614:                                    self.agent.current_level().dungeon_number == Level.SOKOBAN)\n615:             ])\n616:             .preempt(self.agent, [\n617:                 self.offer_corpses().preempt(self.agent, [\n618:                     self.agent.eat_corpses_from_ground().condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n619:                 ]),\n620:             ])\n621:             .preempt(self.agent, [\n622:                 self.wait_out_unexpected_state_strategy(),\n623:             ])\n624:             .preempt(self.agent, [\n625:                 self.agent.cure_disease().every(5),\n626:             ])\n627:             .preempt(self.agent, [\n628:                 self.agent.eat_corpses_from_ground(only_below_me=True).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n629:                 self.agent.eat_corpses_from_ground().every(5).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n630:                 self.agent.eat_from_inventory().every(5),\n631:             ])\n632:             .preempt(self.agent, [\n633:                 self.follow_guard(),\n634:             ])\n635:             .preempt(self.agent, [\n636:                 self.agent.fight2(),\n637:             ])\n638:             .preempt(self.agent, [\n639:                 self.agent.engulfed_fight(),\n640:             ])\n641:             .preempt(self.agent, [\n642:                 self.agent.emergency_strategy(),\n643:             ])\n644:         )\n\n(End of file - total 644 lines)\n</content>","metadata":{"preview":"from enum import IntEnum, auto\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\nfrom . import soko_solver\nfrom . import utils\nfrom .character import Character\nfrom .exceptions import AgentPanic\nfrom .glyph import Hunger, G, MON\nfrom .item import Item, flatten_items\nfrom .item.item_priority_base import ItemPriorityBase\nfrom .level import Level\nfrom .strategy import Strategy\n\n\nclass ItemPriority(ItemPriorityBase):\n    MAX_NUMBER_OF_ITEMS = 26 * 2 - 1  # + coin slot, one slot should be left for item arranging","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/global_logic.py","text":"from enum import IntEnum, auto\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\nfrom . import soko_solver\nfrom . import utils\nfrom .character import Character\nfrom .exceptions import AgentPanic\nfrom .glyph import Hunger, G, MON\nfrom .item import Item, flatten_items\nfrom .item.item_priority_base import ItemPriorityBase\nfrom .level import Level\nfrom .strategy import Strategy\n\n\nclass ItemPriority(ItemPriorityBase):\n    MAX_NUMBER_OF_ITEMS = 26 * 2 - 1  # + coin slot, one slot should be left for item arranging\n    def __init__(self, agent):\n        self.agent = agent\n        self._take_sacrificial_corpses = False\n        self._drop_gold_till_turn = -float('inf')\n\n    def _split(self, items, forced_items, weight_capacity):\n        remaining_weight = weight_capacity\n        ret_inv = {}\n        for item in forced_items:\n            remaining_weight -= item.weight()\n            ret_inv[item] = item.count\n\n        ret_bag = {}\n        bag = None\n\n        def add_item(item, count=None, to_bag=False):\n            nonlocal ret_inv, ret_bag, remaining_weight\n            assert isinstance(item, Item)\n            if to_bag and bag is not None and item is not bag:\n                ret = ret_bag\n            else:\n                ret = ret_inv\n\n            if remaining_weight < 0 or \\\n                    (ret is ret_inv and len(ret) >= ItemPriority.MAX_NUMBER_OF_ITEMS):  # TODO: coin slot\n                return\n\n            how_many_already_total = ret_inv.get(item, 0) + ret_bag.get(item, 0)\n            how_many_already = ret.get(item, 0)\n            max_to_add = int(remaining_weight // item.unit_weight(with_content=False))\n            if count is not None:\n                max_to_add = min(max_to_add, count)\n            ret[item] = min(item.count, how_many_already_total + max_to_add) - (how_many_already_total - how_many_already)\n            remaining_weight -= item.unit_weight(with_content=False) * (ret[item] - how_many_already)\n\n        for item in items:\n            if item.is_container() and item.status in [Item.UNCURSED, Item.BLESSED] and item.objs[0].desc == 'bag':\n                bag = item  # TODO: select the best\n                add_item(bag)\n\n        if self._drop_gold_till_turn < self.agent.blstats.time:\n            for item in items:\n                if item.category == nh.COIN_CLASS:\n                    add_item(item)\n\n        for allow_unknown_status in [False, True]:\n            item = self.agent.inventory.get_best_melee_weapon(items=forced_items + items,\n                                                              allow_unknown_status=allow_unknown_status)\n            if item is not None:\n                add_item(item)\n\n            for item in self.agent.inventory.get_best_armorset(items=forced_items + items,\n                                                               allow_unknown_status=allow_unknown_status):\n                if item is not None:\n                    add_item(item)\n\n        for item in items:\n            if item.is_unambiguous():\n                if item.object in [\n                        O.from_name('healing', nh.POTION_CLASS),\n                        O.from_name('extra healing', nh.POTION_CLASS),\n                        O.from_name('full healing', nh.POTION_CLASS)]:\n                    add_item(item)\n\n                if self.agent.character.role in [Character.RANGER, Character.ROGUE,\n                                                 Character.SAMURAI, Character.TOURIST] and \\\n                        (item.is_launcher() or item.is_fired_projectile()):\n                    add_item(item)\n\n        if self.agent.character.alignment == Character.LAWFUL:\n            for item in sorted(filter(lambda i: i.objs[0].name == 'long sword', items),\n                               key=lambda i: -utils.calc_dps(*self.agent.character.get_melee_bonus(i))):\n                add_item(item)\n                break\n\n        for item in sorted(filter(lambda i: i.is_thrown_projectile(), items),\n                           key=lambda i: -utils.calc_dps(*self.agent.character.get_ranged_bonus(None, i))):\n            add_item(item)\n\n        for item in sorted(filter(lambda i: i.is_food() and not i.is_corpse(), items),\n                           key=lambda x: -x.nutrition_per_weight() - 1000 * (x.objs[0].name == 'sprig of wolfsbane')):\n            add_item(item)\n\n        if self._take_sacrificial_corpses:\n            for item in filter(self.agent.global_logic.can_sacrify, items):\n                add_item(item)\n\n        # TODO: take nh.COIN_CLASS once shopping is implemented.\n        # You have to drop all coins not to be attacked by a vault guard\n\n        for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n            if item.category in [nh.POTION_CLASS, nh.RING_CLASS, nh.AMULET_CLASS, nh.WAND_CLASS, nh.SCROLL_CLASS, nh.TOOL_CLASS]:\n                if (not isinstance(item.objs[0], O.Container) or not item.is_chest()) and \\\n                        not item.is_possible_container():\n                    to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n                             not item.is_offensive_usable_wand()\n                    to_bag = False\n                    if not item.is_container():  # remove condition to pick up bags\n                        add_item(item, to_bag=to_bag)\n\n        categories = [nh.WEAPON_CLASS, nh.ARMOR_CLASS, nh.TOOL_CLASS, nh.FOOD_CLASS, nh.GEM_CLASS, nh.AMULET_CLASS,\n                      nh.RING_CLASS, nh.POTION_CLASS, nh.SCROLL_CLASS, nh.SPBOOK_CLASS, nh.WAND_CLASS]\n        for item in sorted(items, key=lambda i: i.unit_weight(with_content=False)):\n            if item.category in categories and not isinstance(item.objs[0], O.Container) and not item.is_corpse():\n                if item.status == Item.UNKNOWN:\n                    to_bag = O.from_name('cancellation', nh.WAND_CLASS) not in item.objs and \\\n                             not item.is_offensive_usable_wand()\n                    to_bag = False\n                    if not item.is_container():  # remove condition to pick up bags\n                        add_item(item, to_bag=to_bag)\n\n        r = {None: [ret_inv.get(item, 0) for item in items]}\n        if bag is not None:\n            r[bag] = [ret_bag.get(item, 0) for item in items]\n        for item in items:\n            if item.is_container() and item is not bag and ret_inv.get(item, 0) != 0:\n                r[item] = [0 for _ in items]\n        return r\n\n\nclass Milestone(IntEnum):\n    BE_ON_FIRST_LEVEL = auto()\n    FIND_GNOMISH_MINES = auto()\n    # FIND_LIGHT_GNOMISH_MINES = auto()\n    # FARM_LIGHT_GNOMISH_MINES = auto()\n    FIND_MINETOWN = auto()\n    FIND_SOKOBAN = auto()\n    SOLVE_SOKOBAN = auto()\n    FIND_MINES_END = auto()\n    GO_DOWN = auto() # TODO\n\n\nclass GlobalLogic:\n    def __init__(self, agent):\n        self.agent = agent\n        self.milestone = Milestone(1)\n        self.step_completion_log = {}  # Milestone -> (step, turn)\n\n        self.item_priority = ItemPriority(self.agent)\n\n        self.oracle_level = None\n        self.minetown_level = None\n\n        self._got_artifact = False\n\n    def update(self):\n        if not self.agent.character.prop.hallu:\n            if utils.isin(self.agent.glyphs, G.ORACLE).any():\n                if self.oracle_level is None:\n                    self.oracle_level = self.agent.current_level().key()\n                else:\n                    assert self.oracle_level == self.agent.current_level().key()\n\n            if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n                    utils.isin(self.agent.glyphs, G.SHOPKEEPER).any():\n                if self.minetown_level is None:\n                    self.minetown_level = self.agent.current_level().key()\n                else:\n                    assert self.minetown_level == self.agent.current_level().key()\n\n    @utils.debug_log('solving sokoban')\n    @Strategy.wrap\n    def solve_sokoban_strategy(self):\n        # TODO: refactor\n        if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n            yield False\n        yield True\n\n        def push_bolder(ty, tx, dy, dx):\n            while 1:\n                if self.agent.bfs()[ty, tx] == -1:\n                    return False\n                self.agent.go_to(ty, tx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n                with self.agent.atom_operation():\n                    direction = self.agent.calc_direction(ty, tx, ty + dy, tx + dx)\n                    self.agent.direction(direction)\n                    message = self.agent.message\n\n                if (self.agent.blstats.y, self.agent.blstats.x) == (ty, tx):\n                    assert 'You hear a monster behind the boulder.' in message or \\\n                           'You try to move the boulder, but in vain.' in message, message\n                    if self.agent.bfs()[ty + dy, tx + dx] != -1:\n                        self.agent.go_to(ty + dy, tx + dx, debug_tiles_args=dict(color=(255, 255, 255), is_path=True))\n                        continue\n                    else:\n                        pickaxe = None\n                        for item in flatten_items(self.agent.inventory.items):\n                            if item.is_unambiguous() and \\\n                                    item.object in [O.from_name('pick-axe'), O.from_name('dwarvish mattock')]:\n                                pickaxe = item\n                                break\n                        if pickaxe is not None:\n                            with self.agent.atom_operation():\n                                pickaxe = self.agent.inventory.move_to_inventory(pickaxe)\n                                self.agent.step(A.Command.APPLY)\n                                self.agent.type_text(self.agent.inventory.items.get_letter(pickaxe))\n                                self.agent.direction(direction)\n                            return True\n                else:\n                    return True\n\n                # TODO: not sure what to do\n                self.agent.exploration.explore1(None).run()\n\n        while 1:\n            wall_map = utils.isin(self.agent.current_level().objects, G.WALL)\n            for smap, answer in soko_solver.maps.items():\n                sokomap = soko_solver.convert_map(smap)\n                offset = np.array(min(zip(*wall_map.nonzero()))) - \\\n                         np.array(min(zip(*(sokomap.sokomap == soko_solver.WALL).nonzero())))\n                mask = wall_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n                if (mask & (sokomap.sokomap == soko_solver.WALL) == mask).all():\n                    break\n            else:\n                assert 0, 'sokomap not found'\n\n            possible_mimics = set()\n            last_resort_move = None\n            for (y, x), (dy, dx) in answer:\n                boulder_map = utils.isin(self.agent.glyphs, G.BOULDER)\n                mask = boulder_map[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                   offset[1] : offset[1] + sokomap.sokomap.shape[1]]\n                ty, tx = offset[0] + y - dy, offset[1] + x - dx,\n                soko_boulder_mask = sokomap.sokomap == soko_solver.BOULDER\n                if self.agent.bfs()[ty, tx] != -1 and \\\n                        ((soko_boulder_mask | mask) == soko_boulder_mask).all() and \\\n                        self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER:\n\n                    soko_dis1 = sokomap.bfs()\n                    sokomap.move(y, x, dy, dx)\n                    soko_dis2 = sokomap.bfs()\n\n                    # see points that will no longer be accessible\n                    with self.agent.env.debug_log('checking for monsters'):\n                        to_visit_mask = self.agent.bfs() != -1\n                        to_visit_mask[offset[0] : offset[0] + sokomap.sokomap.shape[0],\n                                      offset[1] : offset[1] + sokomap.sokomap.shape[1]] &= \\\n                                              (soko_dis1 != -1) & (soko_dis2 == -1)\n\n                        with self.agent.env.debug_tiles(to_visit_mask, color=(255, 0, 0, 128)):\n                            while to_visit_mask.any():\n                                vy, vx = list(zip(*to_visit_mask.nonzero()))[0]\n                                to_visit_mask[vy, vx] = 0\n\n                                def clear_neighbors():\n                                    to_visit_mask[self.agent.blstats.y, self.agent.blstats.x] = 0\n                                    to_visit_mask[utils.isin(self.agent.glyphs, G.VISIBLE_FLOOR)] = 0\n                                    return not to_visit_mask[vy, vx]\n\n                                self.agent.go_to(vy, vx, callback=clear_neighbors)\n\n                    if not push_bolder(ty, tx, dy, dx):\n                        continue\n\n                    possible_mimics = set()\n                    last_resort_move = None\n\n                    if not utils.isin(self.agent.current_level().objects, G.TRAPS).any():\n                        return\n\n                else:\n                    sokomap.move(y, x, dy, dx)\n\n                if (~soko_boulder_mask | mask).all():\n                    if self.agent.bfs()[ty, tx] != -1 and \\\n                            self.agent.glyphs[ty + dy, tx + dx] in G.BOULDER and \\\n                            last_resort_move is None:\n                        last_resort_move = (ty, tx, dy, dx)\n\n                    if not possible_mimics:\n                        for mim_y, mim_x in zip(*(~soko_boulder_mask & mask).nonzero()):\n                            possible_mimics.add((mim_y + offset[0], mim_x + offset[1]))\n\n\n            # sokoban configuration is not in the list. Check for mimics\n            with self.agent.env.debug_log('mimics'):\n                with self.agent.env.debug_tiles(possible_mimics, color=(255, 0, 0, 128)):\n                    for mim_y, mim_x in sorted(possible_mimics):\n                        if (self.agent.bfs()[max(0, mim_y - 1) : mim_y + 2, max(0, mim_x - 1) : mim_x + 2] != -1).any():\n                            self.agent.go_to(mim_y, mim_x, stop_one_before=True,\n                                             debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n                            for _ in range(3):\n                                self.agent.search()\n\n            # last resort move (sometimes we can see a mimic diagonally but cannot reach it)\n            with self.agent.env.debug_log('last_resort'):\n                if last_resort_move is not None:\n                    ty, tx, dy, dx = last_resort_move\n                    push_bolder(ty, tx, dy, dx)\n                    continue\n\n            self.agent.stats_logger.log_event('sokoban_dropped')\n            self.milestone = Milestone(int(self.milestone) + 1)\n            raise AgentPanic('sokomap unsolvable')\n\n    @Strategy.wrap\n    def wait_out_unexpected_state_strategy(self):\n        yielded = False\n        while (\n                self.agent.character.prop.blind or\n                self.agent.character.prop.confusion or\n                self.agent.character.prop.stun or\n                self.agent.character.prop.hallu or\n                self.agent.character.prop.polymorph):\n            if not yielded:\n                yield True\n                yielded = True\n\n            self.agent.direction('.')\n\n        if not yielded:\n            yield False\n\n    @utils.debug_log('identify_items_on_altar')\n    @Strategy.wrap\n    def identify_items_on_altar(self):\n        mask = utils.isin(self.agent.current_level().objects, G.ALTAR)\n        if not mask.any():\n            yield False\n\n        dis = self.agent.bfs()\n        mask &= dis != -1\n        if not mask.any():\n            yield False\n\n        yield any((item.status == Item.UNKNOWN for item in flatten_items(self.agent.inventory.items)\n                   if item.can_be_dropped_from_inventory()))\n\n        (ty, tx), *_ = zip(*(mask & (dis == dis[mask].min())).nonzero())\n        self.agent.go_to(ty, tx)\n        items_to_drop = [item for item in flatten_items(self.agent.inventory.items)\n                         if item.can_be_dropped_from_inventory() and item.status == Item.UNKNOWN]\n        if not items_to_drop:\n            raise AgentPanic('items to drop on altar vanished')\n\n        # TODO: move chunking to inventory.drop\n        items_to_drop = items_to_drop[:self.agent.inventory.items.free_slots()]\n\n        self.agent.inventory.drop(items_to_drop)\n\n    @utils.debug_log('dip_for_excalibur')\n    @Strategy.wrap\n    def dip_for_excalibur(self):\n        if self.agent.character.alignment != Character.LAWFUL or self.agent.blstats.experience_level < 5:\n            yield False\n        if self.agent.current_level().dungeon_number == Level.GNOMISH_MINES and \\\n                (self.minetown_level is None or self.agent.current_level().key() == self.minetown_level):\n            yield False\n\n        dis = self.agent.bfs()\n        mask = utils.isin(self.agent.current_level().objects, G.FOUNTAIN) & (dis != -1)\n        if not mask.any():\n            yield False\n\n        def excalibur_candidate():\n            candidate = None\n            for item in flatten_items(self.agent.inventory.items):\n                if item.is_unambiguous() and item.object == O.from_name('long sword'):\n                    if item.dmg_bonus is not None: # TODO: better condition for excalibur existance\n                        return None\n                    candidate = item\n            return candidate\n\n        if excalibur_candidate() is None:\n            yield False\n        yield True\n\n        self.agent.go_to(*list(zip(*mask.nonzero()))[0])\n\n        candidate = excalibur_candidate()\n        if candidate is None:\n            return\n\n        # TODO: refactor\n        with self.agent.atom_operation():\n            candidate = self.agent.inventory.move_to_inventory(candidate)\n            self.agent.step(A.Command.DIP)\n            self.agent.type_text(self.agent.inventory.items.get_letter(candidate))\n            if 'What do you want to dip ' in self.agent.message and 'into?' in self.agent.message:\n                raise AgentPanic('no fountain here')\n\n    def can_sacrify(self, item):\n        if not item.is_corpse() or item.comment == 'old':\n            return False\n\n        mname = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mname\n        if (mname == 'pony' and self.agent.character.role in [Character.KNIGHT, Character.BARBARIAN]) or \\\n                (mname == 'kitten' and self.agent.character.role == [Character.BARBARIAN, Character.WIZARD]) or \\\n                (mname == 'little dog' and item.naming):  # little dogs are always named\n            # sufficient condition for being an initial pet\n            return False\n\n        if self.agent.character.alignment != Character.CHAOTIC:\n            mapping = {\n                Character.HUMAN: MON.M2_HUMAN | MON.M2_WERE,\n                Character.DWARF: MON.M2_DWARF,\n                Character.ELF: MON.M2_ELF,\n                Character.GNOME: MON.M2_GNOME,\n                Character.ORC: MON.M2_ORC,\n            }\n            f2 = MON.permonst(item.monster_id + nh.GLYPH_MON_OFF).mflags2\n            if (f2 & mapping[self.agent.character.race]) > 0:\n                return False\n\n        return True\n\n    @utils.debug_log('offer_corpses')\n    @Strategy.wrap\n    def offer_corpses(self):\n        self.item_priority._take_sacrificial_corpses = False\n\n        if self._got_artifact:\n            yield False\n\n        altars = [p for p, alignment in self.agent.current_level().altars.items()\n                  if alignment == self.agent.character.alignment]\n\n        if not altars:\n            yield False\n\n        dis = self.agent.bfs()\n        altars = [(y, x) for y, x in altars if dis[y, x] != -1]\n\n        if not altars:\n            yield False\n\n        self.item_priority._take_sacrificial_corpses = True\n\n        if not any((self.can_sacrify(item) for item in flatten_items(self.agent.inventory.items))):\n            yield False\n\n        yield True\n\n        y, x = min(altars, key=lambda p: dis[p])\n        self.agent.go_to(y, x)\n        with self.agent.panic_if_position_changes():\n            while 1:\n                for item in flatten_items(self.agent.inventory.items):\n                    if self.can_sacrify(item):\n                        with self.agent.atom_operation():\n                            item = self.agent.inventory.move_to_inventory(item)\n                            assert self.can_sacrify(item)\n                            self.agent.step(A.Command.OFFER)\n                            while ('There is ' in self.agent.message or 'There are ' in self.agent.message) and \\\n                                    ('sacrifice it?' in self.agent.message or 'sacrifice one?' in self.agent.message):\n                                self.agent.type_text('n')\n                            assert 'What do you want to sacrifice?' in self.agent.message, self.agent.message\n                            self.agent.type_text(self.agent.inventory.items.get_letter(item))\n                            if 'Nothing happens.' in self.agent.message:\n                                self.agent.inventory.call_item(item, 'old')\n                                return\n                            if 'Use my gift wisely' in self.agent.message:\n                                self._got_artifact = True\n                                self.agent.inventory.get_items_below_me()\n                                return\n                            if 'So this is how you repay loyalty?' in self.agent.message:\n                                raise AgentPanic('pet sacrified')\n                            assert 'Your sacrifice is consumed in a flash of light' in self.agent.message or \\\n                                'Your sacrifice is consumed in a burst of flame' in self.agent.message or \\\n                                ('The blood covers the altar!' in self.agent.message and \\\n                                 'You have summoned ' in self.agent.message), \\\n                                self.agent.message\n                            break\n                else:\n                    break\n\n    @utils.debug_log('follow_guard')\n    @Strategy.wrap\n    def follow_guard(self):\n        if not utils.isin(self.agent.glyphs, G.GUARD).any():\n            yield False\n\n        if any(item.category == nh.COIN_CLASS for item in flatten_items(self.agent.inventory.items)):\n            yield True\n            # if 'Please drop that gold and follow me.' in self.message:\n            self.agent.stats_logger.log_event('drop_gold')\n            self.item_priority._drop_gold_till_turn = self.agent.blstats.time + 100\n            self.agent.inventory.arrange_items().run()\n            return\n\n        ys, xs = utils.isin(self.agent.glyphs, G.GUARD).nonzero()\n        y, x = ys[0], xs[0]\n\n        if utils.adjacent((y, x), (self.agent.blstats.y, self.agent.blstats.x)):\n            yield False\n\n        yield True\n\n        self.agent.go_to(y, x, stop_one_before=True)\n\n    @Strategy.wrap\n    def current_strategy(self):\n        yield True\n        while 1:\n            explore_stairs_condition = lambda: False\n            if self.milestone == Milestone.BE_ON_FIRST_LEVEL:\n                condition = lambda: self.agent.blstats.experience_level >= 8\n                # explore_stairs_condition = lambda: self.agent.inventory.items.total_nutrition() == 0 and \\\n                #                                    self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY\n                level = (Level.DUNGEONS_OF_DOOM, 1)\n\n            elif self.milestone == Milestone.FIND_SOKOBAN:\n                condition = lambda: self.agent.current_level().dungeon_number == Level.SOKOBAN\n                level = (Level.SOKOBAN, 4)\n\n            elif self.milestone == Milestone.FIND_GNOMISH_MINES:\n                condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES\n                level = (Level.GNOMISH_MINES, 1)\n\n            # elif self.milestone == Milestone.FIND_LIGHT_GNOMISH_MINES:\n            #     condition = lambda: self.agent.current_level().dungeon_number == Level.GNOMISH_MINES \\\n            #             and self.agent.current_level().is_light_level()\n            #     level = (Level.GNOMISH_MINES, 9)\n\n            # elif self.milestone == Milestone.FARM_LIGHT_GNOMISH_MINES:\n            #     condition = lambda: self.agent.blstats.experience_level >= 11\n            #     level = (Level.GNOMISH_MINES, self.agent.current_level().level_number)\n\n            elif self.milestone == Milestone.FIND_MINETOWN:\n                condition = lambda: self.minetown_level is not None\n                level = (Level.GNOMISH_MINES, 4)  # TODO\n\n            elif self.milestone == Milestone.SOLVE_SOKOBAN:\n                # TODO: fix the condition, monster can destroy doors\n                condition = lambda: self.agent.current_level().key() == (Level.SOKOBAN, 1) and \\\n                                    not utils.isin(self.agent.current_level().objects, G.DOOR_CLOSED).any()\n                level = (Level.SOKOBAN, 1)\n\n            elif self.milestone == Milestone.FIND_MINES_END:\n                condition = lambda: self.agent.current_level().key() == (Level.GNOMISH_MINES, 9)  # TODO\n                level = (Level.GNOMISH_MINES, 9)  # TODO\n\n            else:\n                # TODO\n                condition = lambda: False\n                level = (Level.DUNGEONS_OF_DOOM, 100)\n\n            if condition():\n                self.milestone = Milestone(int(self.milestone) + 1)\n                continue\n\n\n            def exploration_strategy(level, **kwargs):\n                return (\n                    Strategy(lambda: self.agent.exploration.explore1(level, trap_search_offset=1,\n                        kick_doors=self.agent.current_level().dungeon_number != Level.GNOMISH_MINES, **kwargs).strategy())\n                    .preempt(self.agent, [\n                        self.identify_items_on_altar().every(100),\n                        self.identify_items_on_altar().condition(\n                            lambda: self.agent.current_level().objects[self.agent.blstats.y,\n                                                                       self.agent.blstats.x] in G.ALTAR),\n                        self.dip_for_excalibur().condition(\n                            lambda: self.agent.blstats.experience_level >= 7).every(10),\n                    ])\n                )\n\n            def go_to_strategy(y, x):\n                return (\n                    exploration_strategy(None)\n                    .preempt(self.agent, [\n                        self.agent.exploration.go_to_strategy(y, x).preempt(self.agent, [\n                            self.agent.inventory.gather_items(),\n                            self.identify_items_on_altar(),\n                            self.dip_for_excalibur().condition(lambda: self.agent.blstats.experience_level >= 7),\n                        ])\n                        .condition(lambda: self._got_artifact or\n                                           not any([alignment == self.agent.character.alignment\n                                                    for _, alignment in self.agent.current_level().altars.items()]))\n                    ])\n                    .until(self.agent, lambda: (self.agent.blstats.y, self.agent.blstats.x) == (y, x))\n                )\n\n            (\n                self.agent.exploration.go_to_level_strategy(*level, go_to_strategy, exploration_strategy(None))\n                .before(exploration_strategy(None))#.before(self.agent.exploration.patrol())\n                .preempt(self.agent, [\n                    exploration_strategy(0),\n                    exploration_strategy(None).until(\n                        self.agent, lambda: self.agent.blstats.hitpoints >= 0.8 * self.agent.blstats.max_hitpoints)\n                ])\n                .preempt(self.agent, [\n                    self.agent.exploration.explore_stairs(go_to_strategy, all=True).condition(explore_stairs_condition),\n                ])\n                .until(self.agent, condition)\n            ).run()\n\n    def global_strategy(self):\n        return (\n            self.current_strategy().repeat()\n            .preempt(self.agent, [\n                self.solve_sokoban_strategy()\n                .condition(lambda: self.milestone == Milestone.SOLVE_SOKOBAN and\n                                   self.agent.current_level().dungeon_number == Level.SOKOBAN)\n            ])\n            .preempt(self.agent, [\n                self.offer_corpses().preempt(self.agent, [\n                    self.agent.eat_corpses_from_ground().condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                ]),\n            ])\n            .preempt(self.agent, [\n                self.wait_out_unexpected_state_strategy(),\n            ])\n            .preempt(self.agent, [\n                self.agent.cure_disease().every(5),\n            ])\n            .preempt(self.agent, [\n                self.agent.eat_corpses_from_ground(only_below_me=True).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                self.agent.eat_corpses_from_ground().every(5).condition(lambda: self.agent.blstats.hunger_state >= Hunger.NOT_HUNGRY),\n                self.agent.eat_from_inventory().every(5),\n            ])\n            .preempt(self.agent, [\n                self.follow_guard(),\n            ])\n            .preempt(self.agent, [\n                self.agent.fight2(),\n            ])\n            .preempt(self.agent, [\n                self.agent.engulfed_fight(),\n            ])\n            .preempt(self.agent, [\n                self.agent.emergency_strategy(),\n            ])\n        )","lineStart":1,"lineEnd":644,"totalLines":644,"truncated":false}},"title":"workspace/autoascend/global_logic.py","time":{"start":1790679607683,"end":1790679607715}},"id":"prt_0ecd26967001HPOX8pwqf6zkGn","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ecd25e1b001DwPTVlrAxy4cNe"}}
