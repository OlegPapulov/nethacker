ent the Evoker               St:12 Dx:14 Co:12 In:18 Wi:8 Ch:11 Chaotic S:0   \nDlvl:1 $:0 HP:12(12) Pw:6(6) AC:9 Xp:1/0 T:1                                    \n=== after 12 steps\nchar: 12 0 0\nknown_spells: None\nskill: None\nmessages: \n---raw tty---\n                                                                                \n                                                                                \n                                                                                \n                                                                                \n                                                                                \n                                                                                \n                                                                                \n                                                                                \n                                                                                \n                                                                                \n    ---+-----                                                                   \n    |.@f....|                                                                   \n    |F.......                                                                   \n    |.......|                                                                   \n    |.......|                                                                   \n    |.......|                                                                   \n    |.......|                                                                   \n    ---------                                                                   \n                                                                                \n                                                                                \n                                                                                \n                                                                                \nAgent the Evoker               St:12 Dx:14 Co:12 In:18 Wi:8 Ch:11 Chaotic S:0   \nDlvl:1 $:0 HP:12(12) Pw:6(6) AC:9 Xp:1/0 T:1                                    \n","exit":0,"truncated":false},"title":"cd /workspace && timeout 300 python - <<'EOF' 2>&1 | tail -40\nimport os, sys, tempfile, warnings, threading, contextlib, json\nfrom pathlib import Path\ncache = Path(tempfile.gettempdir()) / \"nethack_arena_submission_cache\"\nos.environ.setdefault(\"XDG_CACHE_HOME\", str(cache / \"xdg\")); os.environ.setdefault(\"NUMBA_CACHE_DIR\", str(cache / \"numba\"))\nwarnings.filterwarnings(\"ignore\", category=RuntimeWarning)\nsys.path.insert(0, \"/workspace\"); sys.setrecursionlimit(200000)\nfrom nethackers.arena.environment import NLEEnvironment\nfrom nethackers.arena.seeds import trajectory_spec\nfrom autoascend import agent as A\nfrom nle.nethack import ACTIONS\n\ndef run():\n    env = NLEEnvironment(1_000_000, 10_000, \"wiz-hum-cha-mal\")\n    obs = env.reset(trajectory_spec(\"public\",\"local\",0))\n    class D:\n        n = 0\n        def step(self, action):\n            res = env.step(ACTIONS.index(action)); D.n += 1\n            return res[0], res[1], res[2], {}\n        def debug_tiles(self,*a,**k): return contextlib.nullcontext()\n        def debug_log(self,*a,**k): return contextlib.nullcontext()\n    ag = A.Agent(D(), panic_on_errors=True)\n    d = D()\n    ag._d = d\n    # step a few times to let parse() run, then dump\n    orig = ag.step\n    def step(action, *a, **k):\n        r = orig(action, *a, **k)\n        if d.n == 12:\n            print(\"=== after\", d.n, \"steps\")\n            print(\"char:\", ag.character.role, ag.character.race, ag.character.alignment)\n            print(\"known_spells:\", getattr(ag.character, \"known_spells\", None))\n            print(\"skill:\", getattr(ag.character, \"skill\", None))\n            for it in ag.inventory.items:\n                print(\"  inv:\", it, \"|\", getattr(it,'category',None))\n            print(\"messages:\", ag.message)\n            print(\"---raw tty---\")\n            for line in obs.get(\"tty_chars\", [])[:24]:\n                print(bytes(line).decode().replace(\"\\0\",\" \"))\n        return r\n    ag.step = step\n    try:\n        ag.main()\n    except BaseException as e:\n        pass\nthreading.stack_size(512*1024*1024)\nt = threading.Thread(target=run); t.start(); t.join()\nEOF","time":{"start":1790680267389,"end":1790680285952}},"id":"prt_0ecdc691e001KBecCW9y4duqhW","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ecdc285a001u80pN1L30tkNcj"}}
