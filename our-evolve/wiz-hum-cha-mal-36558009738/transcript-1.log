ts.time)\n    for line in ag.message.split('  '):\n        for w in _WATCH:\n            if _re.search(w, line):\n                _TRACKED.append((turn, w, line[:60]))\n                break\n\n\ndef _run(''')\nopen(p,'w').write(s)\nEOF\nrg -n \"_watch\\(ag\\)|msg_hist\" diag.py | head","time":{"start":1790683732782,"end":1790683732820}},"id":"prt_0ed1153f800143iWjBreneosrq","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ed10f98c0017AzByYeQROc3L9"}}
