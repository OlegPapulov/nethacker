/home/agent/nhwork/b0.json 600 2>/dev/null | python -c \"\nimport json,sys\nd=json.load(sys.stdin)\na=d['actions']; tot=sum(a.values())\nprint('total steps', tot)\nfor k,v in sorted(a.items(), key=lambda x:-x[1]): print(f'  {k:>10} {v:>5} {100*v/tot:>5.1f}%')\nprint('events', {k:v for k,v in (d.get('events') or {}).items() if v})\n\"","time":{"start":1790683661935,"end":1790683680684}},"id":"prt_0ed1044bf001Zoz20MLoPgYV5g","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ed0fd1ef001OZEfemerfU0tpq"}}
