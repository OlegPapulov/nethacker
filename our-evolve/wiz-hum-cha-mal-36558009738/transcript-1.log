eq=False  5 crude daggers\n  t= 10836         2 eq=False  6 crude daggers\n  t= 11639         2 eq=False  a scroll labeled TEMOV\n  t= 11639         2 eq=False  a candle\n","exit":0,"truncated":false},"title":"cd /home/agent/nhwork && python - <<'EOF'\np='diag.py'; s=open(p).read()\ns=s.replace('\"inv\": sorted(str(i) for i in getattr(ag.inventory, \"items_strs\", [])) if False else None,',\n            '\"inv\": [(i.text, i.status, i.equipped) for i in ag.inventory.items],')\nopen(p,'w').write(s)\nEOF\ncd /workspace && AUTOASCEND_SPELLS=0 timeout 600 python /home/agent/nhwork/diag.py 0 /home/agent/nhwork/b0.json 600 >/dev/null 2>&1; python -c \"\nimport json\nd=json.load(open('/home/agent/nhwork/b0.json'))\nprint('turns',d['info']['turns'],'kills',d['info']['n_kills'])\nseen=set()\nfor s in d['snapshots']:\n    for t,st,eq in (s['inv'] or []):\n        if t not in seen:\n            seen.add(t)\n            print(f\\\"  t={s['turn']:>6} {st:>9} eq={eq}  {t}\\\")\n\"","time":{"start":1790683613653,"end":1790683632092}},"id":"prt_0ed0f84de001us7f4tt2W26DdN","sessionID":"ses_f132db44effejOC7YW0uFAg7SL","messageID":"msg_0ed0f7eea001nb6e20laUEwLAm"}}
