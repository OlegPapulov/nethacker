rom original): baseline would be mean of {0: 0.117, 1: 0.075, 2: 0.024, 3: 0.037, 4: 0.117}\nOriginal mean (these 5 seeds): 2.0000\n","exit":0,"truncated":false},"title":"cd /workspace && python3 -c \"\nimport json\nd = json.load(open('/tmp/eval_early1.json'))\nold_scores = {0:0.117, 1:0.075, 2:0.024, 3:0.037, 4:0.117}\nfor r in d:\n    tid = r['trajectory_id']\n    old = old_scores.get(tid, '?')\n    change = r['progress'] - old if isinstance(old, float) else '?'\n    print(f'seed {tid:2d}: old={str(old):>5} new={r[\\\"progress\\\"]:.3f}  delta={change:+.3f}  depth={r[\\\"max_depth\\\"]:2d}  {r[\\\"cause_of_death\\\"]}')\nnew_mean = sum(r['progress'] for r in d) / len(d)\nprint(f'\\nNew mean: {new_mean:.4f}')\nprint(f'Old mean (5 seeds from original): baseline would be mean of {old_scores}')\n# Compute original mean for these 5 seeds\nold_mean = sum(old_scores) / len(old_scores)\nprint(f'Original mean (these 5 seeds): {old_mean:.4f}')\n\"","time":{"start":1790521231177,"end":1790521231219}},"id":"prt_0e361c740001GkK1wenh9P6tOm","sessionID":"ses_f1d0b999fffeBrMKM4fI8Jnoph","messageID":"msg_0e36196fc0018FrbU5N0A6sskV"}}
