{"type":"tool_use","timestamp":1790510434080,"sessionID":"ses_f1d43fee7ffegxFfEwzzxm36mC","part":{"type":"tool","tool":"read","callID":"call-07460931-f9f2-4210-a959-69ccea298970","state":{"status":"completed","input":{"filePath":"/workspace/arena_adapter.py"},"output":"<path>/workspace/arena_adapter.py</path>\n<type>file</type>\n<content>\n1: from __future__ import annotations\n2: \n3: import contextlib\n4: import ctypes\n5: import queue\n6: import threading\n7: import time\n8: import traceback\n9: from collections.abc import Mapping\n10: from typing import Any\n11: \n12: import nle.nethack as nh\n13: from autoascend import agent as autoascend_agent\n14: from autoascend import jf_log\n15: \n16: _ACTIONS = tuple(nh.ACTIONS)\n17: _ACTION_TO_INDEX = {int(action): index for index, action in enumerate(_ACTIONS)}\n18: \n19: \n20: class AgentHang(autoascend_agent.AgentPanic):\n21:     \"\"\"Injected into an agent thread that stopped producing actions (a livelock).\"\"\"\n22: \n23: \n24: def _copy_observation(observation: Mapping[str, Any]) -> dict[str, Any]:\n25:     copied: dict[str, Any] = {}\n26:     for key, value in observation.items():\n27:         copy = getattr(value, \"copy\", None)\n28:         copied[key] = copy() if callable(copy) else value\n29:     return copied\n30: \n31: \n32: def _action_index(action: Any) -> int:\n33:     try:\n34:         return _ACTION_TO_INDEX[int(action)]\n35:     except (KeyError, TypeError, ValueError) as error:\n36:         raise ValueError(f\"AutoAscend produced invalid action {action!r}\") from error\n37: \n38: \n39: def _raise_in_thread(thread: threading.Thread, exc_type: type) -> bool:\n40:     ident = thread.ident\n41:     if ident is None:\n42:         return False\n43:     res = ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(ident), ctypes.py_object(exc_type))\n44:     if res > 1:  # affected more than one thread: undo\n45:         ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(ident), None)\n46:         return False\n47:     return res == 1\n48: \n49: \n50: class ArenaEnvAdapter:\n51:     \"\"\"Minimal env-like object for AutoAscend.\n52: \n53:     AutoAscend's blocking env.step(action) call is translated into one action returned from\n54:     Bot.act(...), then resumed when the arena supplies the next observation.\n55:     \"\"\"\n56: \n57:     def __init__(self) -> None:\n58:         self._actions: queue.Queue[Any] = queue.Queue(maxsize=1)\n59:         self._observations: queue.Queue[Mapping[str, Any] | None] = queue.Queue(maxsize=1)\n60:         self._closed = threading.Event()\n61: \n62:     def step(self, action: Any) -> tuple[dict[str, Any], float, bool, dict[str, Any]]:\n63:         if self._closed.is_set():\n64:             raise autoascend_agent.AgentFinished()\n65:         self._actions.put(action)\n66:         observation = self._observations.get()\n67:         if observation is None or self._closed.is_set():\n68:             raise autoascend_agent.AgentFinished()\n69:         return _copy_observation(observation), 0.0, False, {}\n70: \n71:     def next_action_index(self, timeout: float) -> int:\n72:         action = self._actions.get(timeout=timeout)\n73:         return _action_index(action)\n74: \n75:     def provide_observation(self, observation: Mapping[str, Any]) -> bool:\n76:         if self._closed.is_set():\n77:             return False\n78:         try:\n79:             self._observations.put_nowait(observation)\n80:         except queue.Full:\n81:             return False\n82:         return True\n83: \n84:     def close(self) -> None:\n85:         self._closed.set()\n86:         with contextlib.suppress(queue.Full):\n87:             self._observations.put_nowait(None)\n88: \n89:     def debug_tiles(self, *args: Any, **kwargs: Any) -> contextlib.AbstractContextManager[None]:\n90:         return contextlib.nullcontext()\n91: \n92:     def debug_log(self, *args: Any, **kwargs: Any) -> contextlib.AbstractContextManager[None]:\n93:         return contextlib.nullcontext()\n94: \n95: \n96: class AutoAscendDriver:\n97:     \"\"\"Runs AutoAscend in a thread and keeps it alive for the whole episode.\n98: \n99:     - The first action after a (re)start may include a cold numba JIT compile, so it gets\n100:       ``action_timeout`` (just under the arena's 120s hang guard).\n101:     - Afterwards an action that takes longer than ``hang_timeout`` is treated as a livelock:\n102:       an AgentHang panic is injected into the agent thread, which recovers like any panic.\n103:     - If the thread still does not answer, or dies, a fresh agent takes over the same game.\n104:     Every fallback returns ESC, which is always a legal, harmless action.\n105:     \"\"\"\n106: \n107:     # `nethackers eval` kills the whole batch after 3600 s per wave: one runaway episode would void\n108:     # every score. Past this budget the driver only sends ESC, so NLE's no-progress cutoff ends the\n109:     # game within seconds and the progress reached so far is kept.\n110:     WALL_BUDGET_SECONDS = 50 * 60\n111: \n112:     # Timing: the arena kills a bot (and zeroes the episode) when one act() takes over 120 s.\n113:     # Only the episode's first action may need a cold numba JIT compile (up to FIRST_ACTION_TIMEOUT);\n114:     # afterwards the worst case is HANG + RECOVER + RESTART = 20 + 5 + 20 = 45 s. The hang threshold\n115:     # stays well above slow-but-legit actions under CPU contention (p99 of per-episode max ~16 s,\n116:     # mostly the cold first action), so it only fires on real livelocks.\n117:     FIRST_ACTION_TIMEOUT = 100.0\n118:     RECOVER_TIMEOUT = 5.0\n119:     RESTART_TIMEOUT = 20.0\n120: \n121:     def __init__(self, action_timeout: float = 100.0, hang_timeout: float = 20.0) -> None:\n122:         self._action_timeout = action_timeout\n123:         self._hang_timeout = hang_timeout\n124:         self._warm = False  # set once any agent in this process produced an action\n125:         self._episode_start = time.monotonic()\n126:         self._gave_up = False\n127:         self._env: ArenaEnvAdapter | None = None\n128:         self._agent: autoascend_agent.Agent | None = None\n129:         self._thread: threading.Thread | None = None\n130:         self._thread_error: str | None = None\n131:         self._sent_first_action = False\n132:         self._restarts = 0\n133:         self._fallback_action = _ACTION_TO_INDEX[int(autoascend_agent.A.Command.ESC)]\n134: \n135:     def reset(self, initial_observation: Mapping[str, Any]) -> None:\n136:         del initial_observation\n137:         self.close()\n138:         self._restarts = 0\n139:         self._episode_start = time.monotonic()\n140:         self._gave_up = False\n141:         self._start(fresh_game=True)\n142: \n143:     def _start(self, fresh_game: bool) -> None:\n144:         previous = self._agent\n145:         self._thread_error = None\n146:         self._sent_first_action = False\n147:         self._env = ArenaEnvAdapter()\n148:         self._agent = autoascend_agent.Agent(self._env, panic_on_errors=True)\n149:         self._agent.resumed_game = not fresh_game\n150:         if not fresh_game and previous is not None:\n151:             self._agent.previous_character = previous.character\n152:         self._thread = threading.Thread(target=self._run_agent, args=(self._agent,), name=\"autoascend\",\n153:                                         daemon=True)\n154:         self._thread.start()\n155: \n156:     def _restart(self, reason: str) -> None:\n157:         jf_log.log(f\"DRIVER restart #{self._restarts + 1}: {reason}\")\n158:         if self._env is not None:\n159:             self._env.close()\n160:         old = self._thread\n161:         if old is not None and old.is_alive():\n162:             _raise_in_thread(old, SystemExit)  # a livelocked thread would keep burning CPU\n163:         self._restarts += 1\n164:         self._start(fresh_game=False)\n165: \n166:     def act(self, observation: Mapping[str, Any]) -> int:\n167:         try:\n168:             return self._act(observation)\n169:         except Exception:\n170:             jf_log.log(\"DRIVER error: \" + traceback.format_exc(limit=5))\n171:             return self._fallback_action\n172: \n173:     def _act(self, observation: Mapping[str, Any]) -> int:\n174:         if self._env is None or self._gave_up:\n175:             return self._fallback_action\n176:         if time.monotonic() - self._episode_start > self.WALL_BUDGET_SECONDS:\n177:             jf_log.log(\"DRIVER wall-clock budget exhausted: ending the episode\")\n178:             self._gave_up = True\n179:             self.close()\n180:             return self._fallback_action\n181:         if self._thread is None or not self._thread.is_alive() or self._thread_error is not None:\n182:             if self._restarts >= 50:\n183:                 return self._fallback_action\n184:             self._restart(f\"agent thread died: {(self._thread_error or '')[-500:]}\")\n185:         if self._sent_first_action and not self._env.provide_observation(observation):\n186:             self._restart(\"observation not accepted\")\n187:         if not self._sent_first_action:\n188:             timeout = self.RESTART_TIMEOUT if self._warm else self._action_timeout\n189:         else:\n190:             timeout = self._hang_timeout\n191:         try:\n192:             action = self._env.next_action_index(timeout=timeout)\n193:         except queue.Empty:\n194:             if not self._sent_first_action:\n195:                 return self._fallback_action\n196:             # livelock: interrupt the agent thread and give it a moment to recover\n197:             jf_log.log(\"DRIVER hang: injecting AgentHang\")\n198:             if self._thread is not None:\n199:                 _raise_in_thread(self._thread, AgentHang)\n200:             try:\n201:                 action = self._env.next_action_index(timeout=self.RECOVER_TIMEOUT)\n202:             except queue.Empty:\n203:                 self._restart(\"agent did not recover from hang\")\n204:                 try:\n205:                     action = self._env.next_action_index(timeout=self.RESTART_TIMEOUT)\n206:                 except queue.Empty:\n207:                     return self._fallback_action\n208:                 self._sent_first_action = True\n209:                 return action\n210:             # the recovered agent's ESC answers the observation it already has\n211:         self._sent_first_action = True\n212:         self._warm = True\n213:         return action\n214: \n215:     def close(self) -> None:\n216:         if self._env is not None:\n217:             self._env.close()\n218:         self._env = None\n219:         self._agent = None\n220:         self._thread = None\n221: \n222:     @property\n223:     def thread_error(self) -> str | None:\n224:         return self._thread_error\n225: \n226:     def _run_agent(self, agent: autoascend_agent.Agent) -> None:\n227:         try:\n228:             agent.main()\n229:         except autoascend_agent.AgentFinished:\n230:             pass\n231:         except BaseException:\n232:             if agent is self._agent:\n233:                 self._thread_error = traceback.format_exc(limit=20)[-8_000:]\n\n(End of file - total 233 lines)\n</content>","metadata":{"preview":"from __future__ import annotations\n\nimport contextlib\nimport ctypes\nimport queue\nimport threading\nimport time\nimport traceback\nfrom collections.abc import Mapping\nfrom typing import Any\n\nimport nle.nethack as nh\nfrom autoascend import agent as autoascend_agent\nfrom autoascend import jf_log\n\n_ACTIONS = tuple(nh.ACTIONS)\n_ACTION_TO_INDEX = {int(action): index for index, action in enumerate(_ACTIONS)}\n\n\nclass AgentHang(autoascend_agent.AgentPanic):","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/arena_adapter.py","text":"from __future__ import annotations\n\nimport contextlib\nimport ctypes\nimport queue\nimport threading\nimport time\nimport traceback\nfrom collections.abc import Mapping\nfrom typing import Any\n\nimport nle.nethack as nh\nfrom autoascend import agent as autoascend_agent\nfrom autoascend import jf_log\n\n_ACTIONS = tuple(nh.ACTIONS)\n_ACTION_TO_INDEX = {int(action): index for index, action in enumerate(_ACTIONS)}\n\n\nclass AgentHang(autoascend_agent.AgentPanic):\n    \"\"\"Injected into an agent thread that stopped producing actions (a livelock).\"\"\"\n\n\ndef _copy_observation(observation: Mapping[str, Any]) -> dict[str, Any]:\n    copied: dict[str, Any] = {}\n    for key, value in observation.items():\n        copy = getattr(value, \"copy\", None)\n        copied[key] = copy() if callable(copy) else value\n    return copied\n\n\ndef _action_index(action: Any) -> int:\n    try:\n        return _ACTION_TO_INDEX[int(action)]\n    except (KeyError, TypeError, ValueError) as error:\n        raise ValueError(f\"AutoAscend produced invalid action {action!r}\") from error\n\n\ndef _raise_in_thread(thread: threading.Thread, exc_type: type) -> bool:\n    ident = thread.ident\n    if ident is None:\n        return False\n    res = ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(ident), ctypes.py_object(exc_type))\n    if res > 1:  # affected more than one thread: undo\n        ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(ident), None)\n        return False\n    return res == 1\n\n\nclass ArenaEnvAdapter:\n    \"\"\"Minimal env-like object for AutoAscend.\n\n    AutoAscend's blocking env.step(action) call is translated into one action returned from\n    Bot.act(...), then resumed when the arena supplies the next observation.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._actions: queue.Queue[Any] = queue.Queue(maxsize=1)\n        self._observations: queue.Queue[Mapping[str, Any] | None] = queue.Queue(maxsize=1)\n        self._closed = threading.Event()\n\n    def step(self, action: Any) -> tuple[dict[str, Any], float, bool, dict[str, Any]]:\n        if self._closed.is_set():\n            raise autoascend_agent.AgentFinished()\n        self._actions.put(action)\n        observation = self._observations.get()\n        if observation is None or self._closed.is_set():\n            raise autoascend_agent.AgentFinished()\n        return _copy_observation(observation), 0.0, False, {}\n\n    def next_action_index(self, timeout: float) -> int:\n        action = self._actions.get(timeout=timeout)\n        return _action_index(action)\n\n    def provide_observation(self, observation: Mapping[str, Any]) -> bool:\n        if self._closed.is_set():\n            return False\n        try:\n            self._observations.put_nowait(observation)\n        except queue.Full:\n            return False\n        return True\n\n    def close(self) -> None:\n        self._closed.set()\n        with contextlib.suppress(queue.Full):\n            self._observations.put_nowait(None)\n\n    def debug_tiles(self, *args: Any, **kwargs: Any) -> contextlib.AbstractContextManager[None]:\n        return contextlib.nullcontext()\n\n    def debug_log(self, *args: Any, **kwargs: Any) -> contextlib.AbstractContextManager[None]:\n        return contextlib.nullcontext()\n\n\nclass AutoAscendDriver:\n    \"\"\"Runs AutoAscend in a thread and keeps it alive for the whole episode.\n\n    - The first action after a (re)start may include a cold numba JIT compile, so it gets\n      ``action_timeout`` (just under the arena's 120s hang guard).\n    - Afterwards an action that takes longer than ``hang_timeout`` is treated as a livelock:\n      an AgentHang panic is injected into the agent thread, which recovers like any panic.\n    - If the thread still does not answer, or dies, a fresh agent takes over the same game.\n    Every fallback returns ESC, which is always a legal, harmless action.\n    \"\"\"\n\n    # `nethackers eval` kills the whole batch after 3600 s per wave: one runaway episode would void\n    # every score. Past this budget the driver only sends ESC, so NLE's no-progress cutoff ends the\n    # game within seconds and the progress reached so far is kept.\n    WALL_BUDGET_SECONDS = 50 * 60\n\n    # Timing: the arena kills a bot (and zeroes the episode) when one act() takes over 120 s.\n    # Only the episode's first action may need a cold numba JIT compile (up to FIRST_ACTION_TIMEOUT);\n    # afterwards the worst case is HANG + RECOVER + RESTART = 20 + 5 + 20 = 45 s. The hang threshold\n    # stays well above slow-but-legit actions under CPU contention (p99 of per-episode max ~16 s,\n    # mostly the cold first action), so it only fires on real livelocks.\n    FIRST_ACTION_TIMEOUT = 100.0\n    RECOVER_TIMEOUT = 5.0\n    RESTART_TIMEOUT = 20.0\n\n    def __init__(self, action_timeout: float = 100.0, hang_timeout: float = 20.0) -> None:\n        self._action_timeout = action_timeout\n        self._hang_timeout = hang_timeout\n        self._warm = False  # set once any agent in this process produced an action\n        self._episode_start = time.monotonic()\n        self._gave_up = False\n        self._env: ArenaEnvAdapter | None = None\n        self._agent: autoascend_agent.Agent | None = None\n        self._thread: threading.Thread | None = None\n        self._thread_error: str | None = None\n        self._sent_first_action = False\n        self._restarts = 0\n        self._fallback_action = _ACTION_TO_INDEX[int(autoascend_agent.A.Command.ESC)]\n\n    def reset(self, initial_observation: Mapping[str, Any]) -> None:\n        del initial_observation\n        self.close()\n        self._restarts = 0\n        self._episode_start = time.monotonic()\n        self._gave_up = False\n        self._start(fresh_game=True)\n\n    def _start(self, fresh_game: bool) -> None:\n        previous = self._agent\n        self._thread_error = None\n        self._sent_first_action = False\n        self._env = ArenaEnvAdapter()\n        self._agent = autoascend_agent.Agent(self._env, panic_on_errors=True)\n        self._agent.resumed_game = not fresh_game\n        if not fresh_game and previous is not None:\n            self._agent.previous_character = previous.character\n        self._thread = threading.Thread(target=self._run_agent, args=(self._agent,), name=\"autoascend\",\n                                        daemon=True)\n        self._thread.start()\n\n    def _restart(self, reason: str) -> None:\n        jf_log.log(f\"DRIVER restart #{self._restarts + 1}: {reason}\")\n        if self._env is not None:\n            self._env.close()\n        old = self._thread\n        if old is not None and old.is_alive():\n            _raise_in_thread(old, SystemExit)  # a livelocked thread would keep burning CPU\n        self._restarts += 1\n        self._start(fresh_game=False)\n\n    def act(self, observation: Mapping[str, Any]) -> int:\n        try:\n            return self._act(observation)\n        except Exception:\n            jf_log.log(\"DRIVER error: \" + traceback.format_exc(limit=5))\n            return self._fallback_action\n\n    def _act(self, observation: Mapping[str, Any]) -> int:\n        if self._env is None or self._gave_up:\n            return self._fallback_action\n        if time.monotonic() - self._episode_start > self.WALL_BUDGET_SECONDS:\n            jf_log.log(\"DRIVER wall-clock budget exhausted: ending the episode\")\n            self._gave_up = True\n            self.close()\n            return self._fallback_action\n        if self._thread is None or not self._thread.is_alive() or self._thread_error is not None:\n            if self._restarts >= 50:\n                return self._fallback_action\n            self._restart(f\"agent thread died: {(self._thread_error or '')[-500:]}\")\n        if self._sent_first_action and not self._env.provide_observation(observation):\n            self._restart(\"observation not accepted\")\n        if not self._sent_first_action:\n            timeout = self.RESTART_TIMEOUT if self._warm else self._action_timeout\n        else:\n            timeout = self._hang_timeout\n        try:\n            action = self._env.next_action_index(timeout=timeout)\n        except queue.Empty:\n            if not self._sent_first_action:\n                return self._fallback_action\n            # livelock: interrupt the agent thread and give it a moment to recover\n            jf_log.log(\"DRIVER hang: injecting AgentHang\")\n            if self._thread is not None:\n                _raise_in_thread(self._thread, AgentHang)\n            try:\n                action = self._env.next_action_index(timeout=self.RECOVER_TIMEOUT)\n            except queue.Empty:\n                self._restart(\"agent did not recover from hang\")\n                try:\n                    action = self._env.next_action_index(timeout=self.RESTART_TIMEOUT)\n                except queue.Empty:\n                    return self._fallback_action\n                self._sent_first_action = True\n                return action\n            # the recovered agent's ESC answers the observation it already has\n        self._sent_first_action = True\n        self._warm = True\n        return action\n\n    def close(self) -> None:\n        if self._env is not None:\n            self._env.close()\n        self._env = None\n        self._agent = None\n        self._thread = None\n\n    @property\n    def thread_error(self) -> str | None:\n        return self._thread_error\n\n    def _run_agent(self, agent: autoascend_agent.Agent) -> None:\n        try:\n            agent.main()\n        except autoascend_agent.AgentFinished:\n            pass\n        except BaseException:\n            if agent is self._agent:\n                self._thread_error = traceback.format_exc(limit=20)[-8_000:]","lineStart":1,"lineEnd":233,"totalLines":233,"truncated":false}},"title":"arena_adapter.py","time":{"start":1790510434069,"end":1790510434077}},"id":"prt_0e2bd0710001jTdVz3baPr7XGF","sessionID":"ses_f1d43fee7ffegxFfEwzzxm36mC","messageID":"msg_0e2bd00e7001ZsZjId5BydEjXo"}}
{"type":"tool_use","timestamp":1790510434823,"sessionID":"ses_f1d43fee7ffegxFfEwzzxm36mC","part":{"type":"tool","tool":"read","callID":"call-caafa95b-3cde-405f-8e00-a2904cf77400","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/strategy.py"},"output":"<path>/workspace/autoascend/strategy.py</path>\n<type>file</type>\n<content>\n1: from functools import wraps\n2: \n3: \n4: class Strategy:\n5:     \"\"\"\n6:     A class representing strategy together with the condition for entering.\n7: \n8:     A strategy is defined as a function returning a generator which yields exactly once.\n9:     An yielded value indicate the condition for entering the strategy. Before the first yield no agent actions\n10:     should be called!\n11: \n12:     For example (pseudocode):\n13:     ```\n14:     Strategy.wrap\n15:     def brutal_fight_strategy(agent, max_distance):\n16:         # check condition\n17:         y, x = find_closest_monster()\n18:         if y == -1:  # no monster on the map\n19:             yield False\n20:         if max(abs(y - agent.blstats.y), abs(x - agent.blstats.x)) > max_distance:\n21:             yield False\n22: \n23:         yield True\n24:         # execute action\n25:         agent.go_to(y, x, stop_one_before=True)\n26:         agent.fight(y, x)\n27:     ```\n28:     \"\"\"\n29: \n30:     @classmethod\n31:     def wrap(cls, func):\n32:         return lambda *a, **k: Strategy(wraps(func)(lambda: func(*a, **k)))\n33: \n34:     def __init__(self, strategy, config=None):\n35:         self.strategy = strategy\n36:         if config is None:\n37:             self.config = str(self.strategy)\n38:         else:\n39:             self.config = config\n40: \n41:     def run(self, return_condition=False):\n42:         gen = self.strategy()\n43:         if not next(gen):\n44:             if return_condition:\n45:                 return False\n46:             return None\n47:         try:\n48:             next(gen)\n49:             assert 0\n50:         except StopIteration as e:\n51:             if return_condition:\n52:                 return True\n53:             return e.value\n54: \n55:     def check_condition(self):\n56:         gen = self.strategy()\n57:         return next(gen)\n58: \n59:     def condition(self, condition):\n60:         \"\"\" Add additional condition for entering the strategy \"\"\"\n61:         def f(self=self, condition=condition):\n62:             if not condition():\n63:                 yield False\n64:                 assert 0\n65:             it = self.strategy()\n66:             yield next(it)\n67:             try:\n68:                 next(it)\n69:                 assert 0\n70:             except StopIteration as e:\n71:                 return e.value\n72: \n73:         return Strategy(f, {'strategy': self.config, 'condition': str(condition)})\n74: \n75:     def until(self, agent, condition):\n76:         \"\"\" Run the strategy until condition \"\"\"\n77:         def f():\n78:             if not condition():\n79:                 yield False\n80:                 assert 0\n81:             yield True\n82: \n83:         strategy = self.condition(lambda: not condition()).preempt(agent, [Strategy(f)],\n84:                                                                    continue_after_preemption=False)\n85:         strategy.config = {'strategy': self.config, 'until': str(condition)}\n86:         return strategy\n87: \n88:     def before(self, strategy):\n89:         \"\"\" Stack sequentially two strategies \"\"\"\n90:         def f(self=self, strategy=strategy):\n91:             yielded = False\n92:             r1, r2 = None, None\n93: \n94:             v1 = self.strategy()\n95:             if next(v1):\n96:                 if not yielded:\n97:                     yielded = True\n98:                     yield True\n99:                 try:\n100:                     next(v1)\n101:                     assert 0, v1\n102:                 except StopIteration as e:\n103:                     r1 = e.value\n104: \n105:             v2 = strategy.strategy()\n106:             if next(v2):\n107:                 if not yielded:\n108:                     yielded = True\n109:                     yield True\n110:                 try:\n111:                     next(v2)\n112:                     assert 0, v2\n113:                 except StopIteration as e:\n114:                     r2 = e.value\n115: \n116:             if not yielded:\n117:                 yield False\n118: \n119:             return (r1, r2)\n120: \n121:         return Strategy(f, {'1': self.config, '2': strategy.config})\n122: \n123:     def preempt(self, agent, strategies, continue_after_preemption=True):\n124:         \"\"\" Specify other strategies that may preempt the strategy \"\"\"\n125:         def f(self=self, agent=agent, strategies=strategies):\n126:             gen = self.strategy()\n127:             condition_passed = False\n128:             with agent.disallow_step_calling():\n129:                 condition_passed = next(gen)\n130: \n131:             if not condition_passed:\n132:                 yield False\n133:             yield True\n134: \n135:             assert not agent._no_step_calls\n136: \n137:             def f2():\n138:                 try:\n139:                     next(gen)\n140:                     assert 0, gen\n141:                 except StopIteration as e:\n142:                     return e.value\n143: \n144:             return agent.preempt(strategies, self, first_func=f2, continue_after_preemption=continue_after_preemption)\n145: \n146:         return Strategy(f, {'strategy': self.config, 'preempt': [s.config for s in strategies]})\n147: \n148:     def repeat(self):\n149:         \"\"\" Repeat strategy until the condition is true \"\"\"\n150:         def f(self=self):\n151:             yielded = False\n152:             val = None\n153:             while 1:\n154:                 gen = self.strategy()\n155:                 if not next(gen):\n156:                     if not yielded:\n157:                         yield False\n158:                     return\n159: \n160:                 if not yielded:\n161:                     yielded = True\n162:                     yield True\n163: \n164:                 try:\n165:                     next(gen)\n166:                     assert 0, gen\n167:                 except StopIteration as e:\n168:                     val = e.value\n169:             return val\n170: \n171:         return Strategy(f, {'repeat': self.config})\n172: \n173:     def every(self, num_of_iterations):\n174:         \"\"\"\n175:         Check the condition only every `num_of_iterations` iterations. Otherwise assume false.\n176:         Used for execution time optimization.\n177:         \"\"\"\n178:         current_num = -1\n179: \n180:         def f():\n181:             nonlocal current_num\n182:             current_num += 1\n183:             if current_num % num_of_iterations != 0:\n184:                 yield False\n185:                 assert 0\n186:             it = self.strategy()\n187:             yield next(it)\n188:             current_num = -1\n189:             try:\n190:                 next(it)\n191:                 assert 0\n192:             except StopIteration as e:\n193:                 return e.value\n194: \n195:         return Strategy(f, {'strategy': self.config, 'every': num_of_iterations})\n196: \n197:     def __repr__(self):\n198:         return str(self.config)\n\n(End of file - total 198 lines)\n</content>","metadata":{"preview":"from functools import wraps\n\n\nclass Strategy:\n    \"\"\"\n    A class representing strategy together with the condition for entering.\n\n    A strategy is defined as a function returning a generator which yields exactly once.\n    An yielded value indicate the condition for entering the strategy. Before the first yield no agent actions\n    should be called!\n\n    For example (pseudocode):\n    ```\n    Strategy.wrap\n    def brutal_fight_strategy(agent, max_distance):\n        # check condition\n        y, x = find_closest_monster()\n        if y == -1:  # no monster on the map\n            yield False\n        if max(abs(y - agent.blstats.y), abs(x - agent.blstats.x)) > max_distance:","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/strategy.py","text":"from functools import wraps\n\n\nclass Strategy:\n    \"\"\"\n    A class representing strategy together with the condition for entering.\n\n    A strategy is defined as a function returning a generator which yields exactly once.\n    An yielded value indicate the condition for entering the strategy. Before the first yield no agent actions\n    should be called!\n\n    For example (pseudocode):\n    ```\n    Strategy.wrap\n    def brutal_fight_strategy(agent, max_distance):\n        # check condition\n        y, x = find_closest_monster()\n        if y == -1:  # no monster on the map\n            yield False\n        if max(abs(y - agent.blstats.y), abs(x - agent.blstats.x)) > max_distance:\n            yield False\n\n        yield True\n        # execute action\n        agent.go_to(y, x, stop_one_before=True)\n        agent.fight(y, x)\n    ```\n    \"\"\"\n\n    @classmethod\n    def wrap(cls, func):\n        return lambda *a, **k: Strategy(wraps(func)(lambda: func(*a, **k)))\n\n    def __init__(self, strategy, config=None):\n        self.strategy = strategy\n        if config is None:\n            self.config = str(self.strategy)\n        else:\n            self.config = config\n\n    def run(self, return_condition=False):\n        gen = self.strategy()\n        if not next(gen):\n            if return_condition:\n                return False\n            return None\n        try:\n            next(gen)\n            assert 0\n        except StopIteration as e:\n            if return_condition:\n                return True\n            return e.value\n\n    def check_condition(self):\n        gen = self.strategy()\n        return next(gen)\n\n    def condition(self, condition):\n        \"\"\" Add additional condition for entering the strategy \"\"\"\n        def f(self=self, condition=condition):\n            if not condition():\n                yield False\n                assert 0\n            it = self.strategy()\n            yield next(it)\n            try:\n                next(it)\n                assert 0\n            except StopIteration as e:\n                return e.value\n\n        return Strategy(f, {'strategy': self.config, 'condition': str(condition)})\n\n    def until(self, agent, condition):\n        \"\"\" Run the strategy until condition \"\"\"\n        def f():\n            if not condition():\n                yield False\n                assert 0\n            yield True\n\n        strategy = self.condition(lambda: not condition()).preempt(agent, [Strategy(f)],\n                                                                   continue_after_preemption=False)\n        strategy.config = {'strategy': self.config, 'until': str(condition)}\n        return strategy\n\n    def before(self, strategy):\n        \"\"\" Stack sequentially two strategies \"\"\"\n        def f(self=self, strategy=strategy):\n            yielded = False\n            r1, r2 = None, None\n\n            v1 = self.strategy()\n            if next(v1):\n                if not yielded:\n                    yielded = True\n                    yield True\n                try:\n                    next(v1)\n                    assert 0, v1\n                except StopIteration as e:\n                    r1 = e.value\n\n            v2 = strategy.strategy()\n            if next(v2):\n                if not yielded:\n                    yielded = True\n                    yield True\n                try:\n                    next(v2)\n                    assert 0, v2\n                except StopIteration as e:\n                    r2 = e.value\n\n            if not yielded:\n                yield False\n\n            return (r1, r2)\n\n        return Strategy(f, {'1': self.config, '2': strategy.config})\n\n    def preempt(self, agent, strategies, continue_after_preemption=True):\n        \"\"\" Specify other strategies that may preempt the strategy \"\"\"\n        def f(self=self, agent=agent, strategies=strategies):\n            gen = self.strategy()\n            condition_passed = False\n            with agent.disallow_step_calling():\n                condition_passed = next(gen)\n\n            if not condition_passed:\n                yield False\n            yield True\n\n            assert not agent._no_step_calls\n\n            def f2():\n                try:\n                    next(gen)\n                    assert 0, gen\n                except StopIteration as e:\n                    return e.value\n\n            return agent.preempt(strategies, self, first_func=f2, continue_after_preemption=continue_after_preemption)\n\n        return Strategy(f, {'strategy': self.config, 'preempt': [s.config for s in strategies]})\n\n    def repeat(self):\n        \"\"\" Repeat strategy until the condition is true \"\"\"\n        def f(self=self):\n            yielded = False\n            val = None\n            while 1:\n                gen = self.strategy()\n                if not next(gen):\n                    if not yielded:\n                        yield False\n                    return\n\n                if not yielded:\n                    yielded = True\n                    yield True\n\n                try:\n                    next(gen)\n                    assert 0, gen\n                except StopIteration as e:\n                    val = e.value\n            return val\n\n        return Strategy(f, {'repeat': self.config})\n\n    def every(self, num_of_iterations):\n        \"\"\"\n        Check the condition only every `num_of_iterations` iterations. Otherwise assume false.\n        Used for execution time optimization.\n        \"\"\"\n        current_num = -1\n\n        def f():\n            nonlocal current_num\n            current_num += 1\n            if current_num % num_of_iterations != 0:\n                yield False\n                assert 0\n            it = self.strategy()\n            yield next(it)\n            current_num = -1\n            try:\n                next(it)\n                assert 0\n            except StopIteration as e:\n                return e.value\n\n        return Strategy(f, {'strategy': self.config, 'every': num_of_iterations})\n\n    def __repr__(self):\n        return str(self.config)","lineStart":1,"lineEnd":198,"totalLines":198,"truncated":false}},"title":"autoascend/strategy.py","time":{"start":1790510434813,"end":1790510434820}},"id":"prt_0e2bd09f7001qUqYau7KFj2J8W","sessionID":"ses_f1d43fee7ffegxFfEwzzxm36mC","messageID":"msg_0e2bd00e7001ZsZjId5BydEjXo"}}
{"type":"tool_use","timestamp":1790510436755,"sessionID":"ses_f1d43fee7ffegxFfEwzzxm36mC","part":{"type":"tool","tool":"read","callID":"call-46a0514c-e568-4e89-8354-2730f0bfaf09","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/character.py"},"output":"<path>/workspace/autoascend/character.py</path>\n<type>file</type>\n<content>\n1: import re\n2: \n3: import nle.nethack as nh\n4: import numpy as np\n5: from nle.nethack import actions as A\n6: \n7: from . import objects as O\n8: \n9: ALL_SPELL_NAMES = [\n10:     \"force bolt\",\n11:     \"drain life\",\n12:     \"magic missile\",\n13:     \"cone of cold\",\n14:     \"fireball\",\n15:     \"finger of death\",\n16:     \"protection\",\n17:     \"create monster\",\n18:     \"remove curse\",\n19:     \"create familiar\",\n20:     \"turn undead\",\n21:     \"detect monsters\",\n22:     \"light\",\n23:     \"detect food\",\n24:     \"clairvoyance\",\n25:     \"detect unseen\",\n26:     \"identify\",\n27:     \"detect treasure\",\n28:     \"magic mapping\",\n29:     \"sleep\",\n30:     \"confuse monster\",\n31:     \"slow monster\",\n32:     \"cause fear\",\n33:     \"charm monster\",\n34:     \"jumping\",\n35:     \"haste self\",\n36:     \"invisibility\",\n37:     \"levitation\",\n38:     \"teleport away\",\n39:     \"healing\",\n40:     \"cure blindness\",\n41:     \"cure sickness\",\n42:     \"extra healing\",\n43:     \"stone to flesh\",\n44:     \"restore ability\",\n45:     \"knock\",\n46:     \"wizard lock\",\n47:     \"dig\",\n48:     \"polymorph\",\n49:     \"cancellation\",\n50: ]\n51: \n52: ALL_SPELL_CATEGORIES = [\n53:     \"attack\",\n54:     \"healing\",\n55:     \"divination\",\n56:     \"enchantment\",\n57:     \"clerical\",\n58:     \"escape\",\n59:     \"matter\",\n60: ]\n61: \n62: \n63: class Property:\n64:     def __init__(self, agent):\n65:         self.agent = agent\n66: \n67:     # The tty status line abbreviates conditions when it gets long (e.g. 'Hallu' -> 'Hl'),\n68:     # so read them from the blstats condition bitmask instead.\n69:     def _condition(self, mask):\n70:         return bool(self.agent.last_observation['blstats'][nh.NLE_BL_CONDITION] & mask)\n71: \n72:     @property\n73:     def confusion(self):\n74:         return self._condition(nh.BL_MASK_CONF)\n75: \n76:     @property\n77:     def stun(self):\n78:         return self._condition(nh.BL_MASK_STUN)\n79: \n80:     @property\n81:     def hallu(self):\n82:         return self._condition(nh.BL_MASK_HALLU)\n83: \n84:     @property\n85:     def blind(self):\n86:         return self._condition(nh.BL_MASK_BLIND)\n87: \n88:     @property\n89:     def polymorph(self):\n90:         if not nh.glyph_is_monster(self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]):\n91:             return False\n92:         return self.agent.character.self_glyph != self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n93: \n94: \n95: class Character:\n96:     UNKNOWN = -1  # for everything, e.g. alignment\n97: \n98:     ARCHEOLOGIST = 0\n99:     BARBARIAN = 1\n100:     CAVEMAN = 2\n101:     HEALER = 3\n102:     KNIGHT = 4\n103:     MONK = 5\n104:     PRIEST = 6\n105:     RANGER = 7\n106:     ROGUE = 8\n107:     SAMURAI = 9\n108:     TOURIST = 10\n109:     VALKYRIE = 11\n110:     WIZARD = 12\n111: \n112:     name_to_role = {\n113:         'Archeologist': ARCHEOLOGIST,\n114:         'Barbarian': BARBARIAN,\n115:         'Caveman': CAVEMAN,\n116:         'Cavewoman': CAVEMAN,\n117:         'Healer': HEALER,\n118:         'Knight': KNIGHT,\n119:         'Monk': MONK,\n120:         'Priest': PRIEST,\n121:         'Priestess': PRIEST,\n122:         'Ranger': RANGER,\n123:         'Rogue': ROGUE,\n124:         'Samurai': SAMURAI,\n125:         'Tourist': TOURIST,\n126:         'Valkyrie': VALKYRIE,\n127:         'Wizard': WIZARD,\n128:     }\n129: \n130:     CHAOTIC = 0\n131:     NEUTRAL = 1\n132:     LAWFUL = 2\n133:     UNALIGNED = 3\n134: \n135:     name_to_alignment = {\n136:         'chaotic': CHAOTIC,\n137:         'neutral': NEUTRAL,\n138:         'lawful': LAWFUL,\n139:         'unaligned': UNALIGNED,\n140:     }\n141: \n142:     HUMAN = 0\n143:     DWARF = 1\n144:     ELF = 2\n145:     GNOME = 3\n146:     ORC = 4\n147: \n148:     name_to_race = {\n149:         'human': HUMAN,\n150:         'dwarf': DWARF,\n151:         'dwarven': DWARF,\n152:         'elf': ELF,\n153:         'elven': ELF,\n154:         'gnome': GNOME,\n155:         'gnomish': GNOME,\n156:         'orc': ORC,\n157:         'orcish': ORC,\n158:     }\n159: \n160:     MALE = 0\n161:     FEMALE = 1\n162: \n163:     name_to_gender = {\n164:         'male': MALE,\n165:         'female': FEMALE,\n166:     }\n167: \n168:     name_to_skill_type = {\n169:         # \"\": O.P_NONE,\n170:         \"dagger\": O.P_DAGGER,\n171:         \"knife\": O.P_KNIFE,\n172:         \"axe\": O.P_AXE,\n173:         \"pick-axe\": O.P_PICK_AXE,\n174:         \"short sword\": O.P_SHORT_SWORD,\n175:         \"broadsword\": O.P_BROAD_SWORD,\n176:         \"long sword\": O.P_LONG_SWORD,\n177:         \"two-handed sword\": O.P_TWO_HANDED_SWORD,\n178:         \"scimitar\": O.P_SCIMITAR,\n179:         \"saber\": O.P_SABER,\n180:         \"club\": O.P_CLUB,\n181:         \"mace\": O.P_MACE,\n182:         \"morning star\": O.P_MORNING_STAR,\n183:         \"flail\": O.P_FLAIL,\n184:         \"hammer\": O.P_HAMMER,\n185:         \"quarterstaff\": O.P_QUARTERSTAFF,\n186:         \"polearms\": O.P_POLEARMS,\n187:         \"spear\": O.P_SPEAR,\n188:         \"trident\": O.P_TRIDENT,\n189:         \"lance\": O.P_LANCE,\n190:         \"bow\": O.P_BOW,\n191:         \"sling\": O.P_SLING,\n192:         \"crossbow\": O.P_CROSSBOW,\n193:         \"dart\": O.P_DART,\n194:         \"shuriken\": O.P_SHURIKEN,\n195:         \"boomerang\": O.P_BOOMERANG,\n196:         \"whip\": O.P_WHIP,\n197:         \"unicorn horn\": O.P_UNICORN_HORN,\n198: \n199:         \"attack spells\": O.P_ATTACK_SPELL,\n200:         \"healing spells\": O.P_HEALING_SPELL,\n201:         \"divination spells\": O.P_DIVINATION_SPELL,\n202:         \"enchantment spells\": O.P_ENCHANTMENT_SPELL,\n203:         \"clerical spells\": O.P_CLERIC_SPELL,\n204:         \"escape spells\": O.P_ESCAPE_SPELL,\n205:         \"matter spells\": O.P_MATTER_SPELL,\n206: \n207:         \"bare handed combat\": O.P_BARE_HANDED_COMBAT,\n208:         \"martial arts\": O.P_BARE_HANDED_COMBAT,\n209:         \"two weapon combat\": O.P_TWO_WEAPON_COMBAT,\n210:         \"riding\": O.P_RIDING,\n211:     }\n212: \n213:     possible_skill_types = ['Fighting Skills', 'Weapon Skills', 'Spellcasting Skills']\n214:     possible_skill_levels = ['Unskilled', 'Basic', 'Skilled', 'Expert', 'Master', 'Grand Master']\n215: \n216:     SKILL_LEVEL_RESTRICTED = 0\n217:     SKILL_LEVEL_UNSKILLED = 1\n218:     SKILL_LEVEL_BASIC = 2\n219:     SKILL_LEVEL_SKILLED = 3\n220:     SKILL_LEVEL_EXPERT = 4\n221:     SKILL_LEVEL_MASTER = 5\n222:     SKILL_LEVEL_GRAND_MASTER = 6\n223: \n224:     weapon_bonus = {\n225:         SKILL_LEVEL_RESTRICTED: (-4, 2),\n226:         SKILL_LEVEL_UNSKILLED: (-4, 2),\n227:         SKILL_LEVEL_BASIC: (0, 0),\n228:         SKILL_LEVEL_SKILLED: (2, 1),\n229:         SKILL_LEVEL_EXPERT: (3, 2),\n230:     }\n231:     two_weapon_bonus = {\n232:         SKILL_LEVEL_RESTRICTED: (-9, -3),\n233:         SKILL_LEVEL_UNSKILLED: (-9, -3),\n234:         SKILL_LEVEL_BASIC: (-7, -1),\n235:         SKILL_LEVEL_SKILLED: (-5, 0),\n236:         SKILL_LEVEL_EXPERT: (-3, 1),\n237:     }\n238:     riding_bonus = {\n239:         SKILL_LEVEL_RESTRICTED: (-2, 0),\n240:         SKILL_LEVEL_UNSKILLED: (-2, 0),\n241:         SKILL_LEVEL_BASIC: (-1, 0),\n242:         SKILL_LEVEL_SKILLED: (0, 1),\n243:         SKILL_LEVEL_EXPERT: (0, 2),\n244:     }\n245:     unarmed_bonus = {\n246:         SKILL_LEVEL_RESTRICTED: (1, 0),\n247:         SKILL_LEVEL_UNSKILLED: (1, 0),\n248:         SKILL_LEVEL_BASIC: (1, 1),\n249:         SKILL_LEVEL_SKILLED: (2, 1),\n250:         SKILL_LEVEL_EXPERT: (2, 2),\n251:         SKILL_LEVEL_MASTER: (3, 2),\n252:         SKILL_LEVEL_GRAND_MASTER: (3, 3),\n253:     }\n254:     martial_bonus = {\n255:         SKILL_LEVEL_RESTRICTED: (1, 0),  # no one has it restricted\n256:         SKILL_LEVEL_UNSKILLED: (2, 1),\n257:         SKILL_LEVEL_BASIC: (3, 3),\n258:         SKILL_LEVEL_SKILLED: (4, 4),\n259:         SKILL_LEVEL_EXPERT: (5, 6),\n260:         SKILL_LEVEL_MASTER: (6, 7),\n261:         SKILL_LEVEL_GRAND_MASTER: (7, 9),\n262:     }\n263: \n264:     name_to_skill_level = {k: v for k, v in zip(['Restricted'] + possible_skill_levels,\n265:                                                 [SKILL_LEVEL_RESTRICTED,\n266:                                                  SKILL_LEVEL_UNSKILLED, SKILL_LEVEL_BASIC, SKILL_LEVEL_SKILLED,\n267:                                                  SKILL_LEVEL_EXPERT,\n268:                                                  SKILL_LEVEL_MASTER, SKILL_LEVEL_GRAND_MASTER])}\n269: \n270:     def __init__(self, agent):\n271:         self.agent = agent\n272:         self.prop = Property(agent)\n273:         self.role = None\n274:         self.alignment = None\n275:         self.race = None\n276:         self.gender = None\n277:         self.self_glyph = None\n278:         self.skill_levels = np.zeros(max(self.name_to_skill_type.values()) + 1, dtype=int)\n279:         self.upgradable_skills = dict()\n280: \n281:         self.is_lycanthrope = False\n282:         # 'rat' / 'jackal' / 'wolf' (were.c were_beastie families), None if unknown (LYCAN_FIXES)\n283:         self.lycanthrope_kind = None\n284:         # HP before the current polymorph: while polymorphed, blstats show the form's HP, and that form\n285:         # dying only rehumanizes us (polyself.c rehumanize) back to this HP (LYCAN_FIXES)\n286:         self.hp_before_poly = None\n287:         self._was_polymorphed = False\n288: \n289:     _WERE_KIND = re.compile(r'\\bwere(rat|jackal|wolf)\\b')\n290:     _TURN_INTO_WERE = re.compile(r'You turn into an? were(rat|jackal|wolf)!')\n291: \n292:     def update(self):\n293:         from . import jf_config\n294:         if not jf_config.LYCAN_FIXES:\n295:             if 'You feel feverish.' in self.agent.message:\n296:                 self.is_lycanthrope = True\n297:             if 'You feel purified.' in self.agent.message:\n298:                 self.is_lycanthrope = False\n299:             return\n300:         # every message since the last update: infections and changes happen inside atomic operations\n301:         # (fights, searches), and the old check of the last message alone missed some of them\n302:         history = self.agent._message_history\n303:         start = getattr(self, '_history_seen', 0)\n304:         if start > len(history):   # a fresh agent after a driver restart\n305:             start = 0\n306:         self._history_seen = len(history)\n307:         msg = ' '.join(history[start:] + [self.agent.message])\n308:         # infected while fainted or asleep the message is 'You dream that you feel feverish.' (75 of 591\n309:         # infections in the dev runs): the old exact match never saw it, so no cure prayer came and the\n310:         # bot went on eating jackal corpses (jf25 s10: 'You cannibal!', Luck -2..-5, next prayer failed)\n311:         pos = msg.rfind('feel feverish')\n312:         if pos >= 0:\n313:             self.is_lycanthrope = True\n314:             # the bite may come a turn earlier than the fever ('The wererat bites!' T9061, 'You feel\n315:             # feverish.' T9062 in public s4): look a few messages back for the biter\n316:             context = ' '.join(history[max(0, start - 8):start]) + ' ' + msg[:pos]\n317:             kinds = self._WERE_KIND.findall(context)\n318:             self.lycanthrope_kind = kinds[-1] if kinds else None\n319:             self.agent.log(f'LYCAN infected (kind {self.lycanthrope_kind})')\n320:         m = None\n321:         for m in self._TURN_INTO_WERE.finditer(msg):\n322:             pass\n323:         if m is not None:\n324:             if not self.is_lycanthrope or self.lycanthrope_kind != m.group(1):\n325:                 self.agent.log(f'LYCAN changed into a were{m.group(1)}')\n326:             self.is_lycanthrope = True\n327:             self.lycanthrope_kind = m.group(1)\n328:         if 'You feel purified' in msg[max(pos, 0):]:\n329:             self.is_lycanthrope = False\n330:             self.lycanthrope_kind = None\n331:             self.agent.log('LYCAN cured')\n332:         polymorphed = self.prop.polymorph\n333:         if polymorphed and not self._was_polymorphed:\n334:             bl = self.agent.blstats\n335:             # the last HP seen before the change (this step already shows the new form's HP)\n336:             self.hp_before_poly = getattr(self, '_last_normal_hp', None)\n337:             self.agent.log(f'POLY changed form; HP before: {self.hp_before_poly} now {bl.hitpoints}/{bl.max_hitpoints}')\n338:         if not polymorphed:\n339:             bl = self.agent.blstats\n340:             self._last_normal_hp = (bl.hitpoints, bl.max_hitpoints)\n341:             self.hp_before_poly = None\n342:         self._was_polymorphed = polymorphed\n343: \n344:     def were_family(self):\n345:         \"\"\"Corpse species that are cannibalism for us now (eat.c maybe_cannibal: were_beastie(pm) ==\n346:         u.ulycn): the whole family of our lycanthropy, or of all three when we don't know which.\"\"\"\n347:         families = {'rat': ('sewer rat', 'giant rat', 'rabid rat', 'wererat'),\n348:                     'jackal': ('jackal', 'fox', 'coyote', 'werejackal'),\n349:                     'wolf': ('wolf', 'warg', 'winter wolf', 'werewolf')}\n350:         if not self.is_lycanthrope:\n351:             return ()\n352:         if self.lycanthrope_kind in families:\n353:             return families[self.lycanthrope_kind]\n354:         return tuple(n for names in families.values() for n in names)\n355: \n356:     def poly_hp_is_buffer(self):\n357:         \"\"\"Polymorphed (a were form) with healthy HP to return to: the form's low HP is no emergency\n358:         -- when it hits 0 we just rehumanize (polyself.c) with the HP we had before the change.\"\"\"\n359:         if not self.prop.polymorph or self.hp_before_poly is None:\n360:             return False\n361:         hp, maxhp = self.hp_before_poly\n362:         return hp >= max(12, maxhp / 3)\n363: \n364:     @property\n365:     def carrying_capacity(self):\n366:         # TODO: levitation, etc\n367:         cap = min(1000, (self.agent.blstats.strength_percentage + self.agent.blstats.constitution) * 25 + 50)\n368:         # UNSQUEEZE: boxed in by diagonal squeezes (hack.c cant_squeeze_thru: > 600 carried), keep under 600\n369:         if self.agent.blstats.time < getattr(self.agent, '_squeeze_cap_until', -1):\n370:             cap = min(cap, 550)\n371:         return cap\n372: \n373:     def parse(self):\n374:         with self.agent.atom_operation():\n375:             self.agent.step(A.Command.ATTRIBUTES)\n376:             text = ' '.join(self.agent.popup)\n377:             self._parse(text)\n378:             self.self_glyph = self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n379: \n380:     def _parse(self, text):\n381:         matches = re.findall('You are a ([a-z]+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+).', text)\n382:         if len(matches) == 1:\n383:             alignment, _, gender, race, role = matches[0]\n384:         else:\n385:             matches = re.findall(\n386:                 # rank titles can contain hyphens (a Valkyrie at XL 10-13 is a \"Woman-at-arms\")\n387:                 'You are an? ([a-zA-Z -]+), a level (\\d+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+). *You are ([a-z]+)',\n388:                 text)\n389:             assert len(matches) == 1, repr(text)\n390:             _, _, _, gender, race, role, alignment = matches[0]\n391: \n392:         if not gender:\n393:             if role == 'Priestess':\n394:                 gender = 'female'\n395:             elif role == 'Priest':\n396:                 gender = 'male'\n397:             elif role == 'Caveman':\n398:                 gender = 'male'\n399:             elif role == 'Cavewoman':\n400:                 gender = 'female'\n401:             elif role == 'Valkyrie':\n402:                 gender = 'female'\n403:             else:\n404:                 assert 0, repr(text)\n405: \n406:         self.role = self.name_to_role[role]\n407:         self.alignment = self.name_to_alignment[alignment]\n408:         self.race = self.name_to_race[race]\n409:         self.gender = self.name_to_gender[gender]\n410: \n411:     def parse_spellcast_view(self):\n412:         self.known_spells = dict()\n413:         self.spell_fail_chance = dict()\n414: \n415:         # TODO: parse for other spellcaster classes\n416:         if self.role not in (self.HEALER,):\n417:             return\n418: \n419:         with self.agent.atom_operation():\n420:             self.agent.step(A.Command.CAST)\n421:             if not self.agent.popup:\n422:                 self.known_spells[self.agent.message] = None\n423:                 return\n424:             if self.agent.popup[0] not in ('Choose which spell to cast') or \\\n425:                     not self.agent.popup[1].startswith('Name'):\n426:                 raise ValueError(f'Invalid cast popup text format: {self.agent.popup}')\n427:             for line in self.agent.popup[2:]:\n428:                 matches = re.findall(r'^([a-zA-Z]) - *' +\n429:                                      r'(' + '|'.join(ALL_SPELL_NAMES) + ') *' +\n430:                                      r'([0-9]*) *' +\n431:                                      r'(' + '|'.join(ALL_SPELL_CATEGORIES) + ') *' +\n432:                                      r'([0-9]*)\\% *' +\n433:                                      r'([0-9]*\\%|\\(gone\\))', line)\n434:                 assert len(matches) == 1, (matches, line)\n435:                 letter, spell_name, level, category, fail, retention = matches[0]\n436:                 assert len(letter) == 1, letter\n437:                 self.known_spells[spell_name] = letter\n438:                 self.spell_fail_chance[spell_name] = int(fail) / 100\n439:         self.agent.step(A.Command.ESC)\n440: \n441:     def parse_enhance_view(self):\n442:         with self.agent.atom_operation():\n443:             self.agent.step(A.Command.ENHANCE)\n444:             self._parse_enhance_view()\n445:             while self.upgradable_skills:\n446:                 to_upgrade = self.select_skill_to_upgrade()\n447:                 old_skill_level = self.skill_levels.copy()\n448:                 letter = self.upgradable_skills[to_upgrade]\n449: \n450:                 def type_letter():\n451:                     while f'{letter} - ' not in '\\n'.join(self.agent.single_popup):\n452:                         yield A.TextCharacters.SPACE\n453:                     yield letter\n454: \n455:                 self.agent.step(A.Command.ENHANCE, type_letter())\n456: \n457:                 self.agent.step(A.Command.ENHANCE)\n458:                 self._parse_enhance_view()\n459:                 assert (old_skill_level != self.skill_levels).any(), (old_skill_level, self.skill_levels)\n460: \n461:     def select_skill_to_upgrade(self):\n462:         assert self.upgradable_skills\n463:         # TODO: logic\n464:         return next(iter(self.upgradable_skills.keys()))\n465: \n466:     def _parse_enhance_view(self):\n467:         if self.agent.popup[0] not in ('Current skills:', 'Pick a skill to advance:'):\n468:             raise ValueError('Invalid ehance popup text format.' + str(self.agent.popup))\n469:         self.upgradable_skills = dict()\n470:         for line in self.agent.popup[1:]:\n471:             if line.strip() in self.possible_skill_types or \\\n472:                     line.strip() == '(Skill flagged by \"#\" cannot be enhanced any further.)' or \\\n473:                     line.strip() == '(Skills flagged by \"#\" cannot be enhanced any further.)' or \\\n474:                     line.strip() == '(Skill flagged by \"*\" may be enhanced when you\\'re more experienced.)' or \\\n475:                     line.strip() == '(Skills flagged by \"*\" may be enhanced when you\\'re more experienced.)':\n476:                 continue\n477:             matches = re.findall(r'^([a-zA-Z] -)?#?\\*? *' +\n478:                                  r'(' + '|'.join(self.name_to_skill_type.keys()) + ') *' +\n479:                                  r'\\[(' + '|'.join(self.possible_skill_levels) + ')\\]', line)\n480:             assert len(matches) == 1, (matches, line)\n481:             letter, skill_type, skill_level = matches[0]\n482:             if letter:\n483:                 letter = letter[0]\n484:                 assert letter not in self.upgradable_skills.values()\n485:                 self.upgradable_skills[self.name_to_skill_type[skill_type]] = letter\n486:             self.skill_levels[self.name_to_skill_type[skill_type]] = self.name_to_skill_level[skill_level]\n487: \n488:     def _get_str_dex_to_hit_bonus(self):\n489:         bonus = 0\n490:         # /* attack bonus for strength & dexterity */\n491:         # int\n492:         # abon()\n493:         # {\n494:         #     int sbon;\n495:         #     int str = ACURR(A_STR), dex = ACURR(A_DEX);\n496:         strength = self.agent.blstats.strength\n497:         dexterity = self.agent.blstats.dexterity\n498: \n499:         #     if (Upolyd)\n500:         #         return (adj_lev(&mons[u.umonnum]) - 3);\n501: \n502:         #     if (str < 6)\n503:         #         sbon = -2;\n504:         #     else if (str < 8)\n505:         #         sbon = -1;\n506:         #     else if (str < 17)\n507:         #         sbon = 0;\n508:         #     else if (str <= STR18(50))\n509:         #         sbon = 1; /* up to 18/50 */\n510:         #     else if (str < STR18(100))\n511:         #         sbon = 2;\n512:         #     else\n513:         #         sbon = 3;\n514:         if strength < 6:\n515:             bonus -= 2\n516:         elif strength < 8:\n517:             bonus -= 1\n518:         elif strength < 17:\n519:             pass\n520:         elif strength <= 18 + 50:\n521:             bonus += 1\n522:         elif strength < 18 + 100:\n523:             bonus += 2\n524:         else:\n525:             bonus += 3\n526: \n527:         #     /* Game tuning kludge: make it a bit easier for a low level character to\n528:         #      * hit */\n529:         #     sbon += (u.ulevel < 3) ? 1 : 0;\n530: \n531:         #     if (dex < 4)\n532:         #         return (sbon - 3);\n533:         #     else if (dex < 6)\n534:         #         return (sbon - 2);\n535:         #     else if (dex < 8)\n536:         #         return (sbon - 1);\n537:         #     else if (dex < 14)\n538:         #         return sbon;\n539:         #     else\n540:         #         return (sbon + dex - 14);\n541:         #\n542: \n543:         if dexterity < 4:\n544:             bonus -= 3\n545:         elif dexterity < 6:\n546:             bonus -= 2\n547:         elif dexterity < 8:\n548:             bonus -= 1\n549:         elif dexterity < 14:\n550:             pass\n551:         else:\n552:             return bonus + dexterity - 14\n553: \n554:         return bonus\n555: \n556:     def _get_weapon_skill_bonus(self, item):\n557:         \"\"\" Retuns a pair (to hit bonus, damage bonus) \"\"\"\n558: \n559:         if item is None:\n560:             if self.role in (self.MONK, self.SAMURAI):\n561:                 return self.martial_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n562:             else:\n563:                 return self.unarmed_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n564:         else:\n565:             # TODO: two weapon, riding\n566: \n567:             # TODO: proper sub\n568:             assert all(item.objs[0].sub == obj.sub for obj in item.objs), item.objs\n569:             sub = abs(item.objs[0].sub)\n570: \n571:             if not (0 <= sub < len(self.skill_levels)):\n572:                 raise ValueError('Invalid item sub: ' + str(item) + ' sub: ' + str(sub))\n573:             # TODO:\n574:             return self.weapon_bonus[self.skill_levels[sub]]\n575: \n576:     def get_ranged_bonus(self, launcher, ammo, monster=None, large_monster=False):\n577:         # TODO: check code/wiki\n578: \n579:         if launcher is not None:\n580:             assert launcher.is_launcher()\n581:             assert ammo.is_fired_projectile()\n582:         else:\n583:             assert ammo.is_thrown_projectile()\n584: \n585:         roll_offset = 0\n586:         dmg_bonus = 0\n587:         if launcher is not None:\n588:             skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(launcher)\n589:             roll_offset += skill_hit_bonus\n590:             roll_offset += launcher.get_weapon_bonus(large_monster)[0]\n591:             dmg_bonus += launcher.get_weapon_bonus(large_monster)[1]\n592: \n593:         roll_offset += ammo.get_weapon_bonus(large_monster)[0]\n594:         dmg_bonus += ammo.get_weapon_bonus(large_monster)[1]\n595: \n596:         return roll_offset, max(0, dmg_bonus)\n597: \n598:     def get_range(self, launcher, ammo):\n599:         # TODO: implement\n600:         return 7\n601: \n602:     def get_melee_bonus(self, item, monster=None, large_monster=False):\n603:         \"\"\" Returns a pair (to_hit, damaga)\n604:         https://github.com/facebookresearch/nle/blob/master/src/uhitm.c : find_roll_to_hit\n605:          \"\"\"\n606:         if monster is not None:\n607:             raise NotImplementedError()\n608: \n609:         # TODO:\n610:         # tmp = 1 + Luck + abon() + find_mac(mtmp) + u.uhitinc\n611:         # + maybe_polyd(youmonst.data->mlevel, u.ulevel);\n612:         roll_offset = 1 + self._get_str_dex_to_hit_bonus() + self.agent.blstats.experience_level\n613: \n614:         # TODO:\n615:         # /* some actions should occur only once during multiple attacks */\n616:         # if (!(*attk_count)++) {\n617:         #     /* knight's chivalry or samurai's giri */\n618:         #     check_caitiff(mtmp);\n619:         # }\n620: \n621:         # TODO:\n622:         # /* adjust vs. (and possibly modify) monster state */\n623:         # if (mtmp->mstun)\n624:         #     tmp += 2;\n625:         # if (mtmp->mflee)\n626:         #     tmp += 2;\n627: \n628:         # TODO:\n629:         # if (mtmp->msleeping) {\n630:         #     mtmp->msleeping = 0;\n631:         #     tmp += 2;\n632:         # }\n633: \n634:         # TODO:\n635:         # if (!mtmp->mcanmove) {\n636:         #     tmp += 4;\n637:         #     if (!rn2(10)) {\n638:         #         mtmp->mcanmove = 1;\n639:         #         mtmp->mfrozen = 0;\n640:         #     }\n641:         # }\n642: \n643:         # /* role/race adjustments */\n644: \n645:         # TODO: polymorphed\n646:         # if (Role_if(PM_MONK) && !Upolyd) {\n647:         if self.role == self.MONK:\n648:             # if (uarm)\n649:             if self.agent.inventory.items.suit is not None:\n650:                 # tmp -= (*role_roll_penalty = urole.spelarmr);\n651:                 roll_offset -= 20\n652:             elif item is None and self.agent.inventory.items.off_hand is None:\n653:                 #  else if (!uwep && !uarms)\n654:                 # tmp += (u.ulevel / 3) + 2;\n655:                 roll_offset += (self.agent.blstats.experience_level // 3) + 2\n656: \n657:         # TODO:\n658:         # if (is_orc(mtmp->data)\n659:         #     && maybe_polyd(is_elf(youmonst.data), Race_if(PM_ELF)))\n660:         #     tmp++;\n661: \n662:         # TODO:\n663:         # /* encumbrance: with a lot of luggage, your agility diminishes */\n664:         # if ((tmp2 = near_capacity()) != 0)\n665:         #     tmp -= (tmp2 * 2) - 1;\n666:         # if (u.utrap)\n667:         #     tmp -= 3;\n668: \n669:         # /*\n670:         #  * hitval applies if making a weapon attack while wielding a weapon;\n671:         #  * weapon_hit_bonus applies if doing a weapon attack even bare-handed\n672:         #  * or if kicking as martial artist\n673:         #  */\n674:         # if (aatyp == AT_WEAP || aatyp == AT_CLAW) {\n675:         #     if (weapon)\n676:         #         tmp += hitval(weapon, mtmp);\n677:         #     tmp += weapon_hit_bonus(weapon);\n678:         # } else if (aatyp == AT_KICK && martial_bonus()) {\n679:         #     tmp += weapon_hit_bonus((struct obj *) 0);\n680:         # }\n681:         skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(item)\n682:         roll_offset += skill_hit_bonus\n683: \n684:         if item is not None:\n685:             if item.is_launcher() or item.is_fired_projectile() or item.objs[0].name in ['dart', 'shuriken']:\n686:                 # TODO: rocks, boomerang\n687:                 dmg_bonus = 1.5  # 1d2\n688:             else:\n689:                 dmg_bonus += item.get_weapon_bonus(large_monster)[1]\n690:             roll_offset += item.get_weapon_bonus(large_monster)[0]\n691:         else:\n692:             # TODO: proper unarmed base damage\n693:             dmg_bonus += 1.5\n694:         return roll_offset, max(0, dmg_bonus)\n695: \n696:     def get_skill_str_list(self):\n697:         inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n698:         inv_skill_level = {v: k for k, v in self.name_to_skill_level.items()}\n699:         return list(inv_skill_type[skill_type] + '-' + inv_skill_level[level]\n700:                     for skill_type, level in enumerate(self.skill_levels)\n701:                     if level in inv_skill_level and skill_type in inv_skill_type and level != 0)\n702: \n703:     def __str__(self):\n704:         if self.role is None:\n705:             return 'unparsed_character'\n706:         skill_str = '| '.join(self.get_skill_str_list())\n707:         if self.upgradable_skills:\n708:             inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n709:             skill_str += '\\n Upgradable: ' + '|'.join(letter + '-' + inv_skill_type[skill]\n710:                                                       for skill, letter in self.upgradable_skills.items())\n711:         return '-'.join([f'{list(d.keys())[list(d.values()).index(v)][:3].lower()}'\n712:                          for d, v in [(self.name_to_role, self.role),\n713:                                       (self.name_to_race, self.race),\n714:                                       (self.name_to_gender, self.gender),\n715:                                       (self.name_to_alignment, self.alignment),\n716:                                       ]]) + '\\n Skills: ' + skill_str\n\n(End of file - total 716 lines)\n</content>","metadata":{"preview":"import re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\n\nALL_SPELL_NAMES = [\n    \"force bolt\",\n    \"drain life\",\n    \"magic missile\",\n    \"cone of cold\",\n    \"fireball\",\n    \"finger of death\",\n    \"protection\",\n    \"create monster\",\n    \"remove curse\",\n    \"create familiar\",\n    \"turn undead\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/character.py","text":"import re\n\nimport nle.nethack as nh\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import objects as O\n\nALL_SPELL_NAMES = [\n    \"force bolt\",\n    \"drain life\",\n    \"magic missile\",\n    \"cone of cold\",\n    \"fireball\",\n    \"finger of death\",\n    \"protection\",\n    \"create monster\",\n    \"remove curse\",\n    \"create familiar\",\n    \"turn undead\",\n    \"detect monsters\",\n    \"light\",\n    \"detect food\",\n    \"clairvoyance\",\n    \"detect unseen\",\n    \"identify\",\n    \"detect treasure\",\n    \"magic mapping\",\n    \"sleep\",\n    \"confuse monster\",\n    \"slow monster\",\n    \"cause fear\",\n    \"charm monster\",\n    \"jumping\",\n    \"haste self\",\n    \"invisibility\",\n    \"levitation\",\n    \"teleport away\",\n    \"healing\",\n    \"cure blindness\",\n    \"cure sickness\",\n    \"extra healing\",\n    \"stone to flesh\",\n    \"restore ability\",\n    \"knock\",\n    \"wizard lock\",\n    \"dig\",\n    \"polymorph\",\n    \"cancellation\",\n]\n\nALL_SPELL_CATEGORIES = [\n    \"attack\",\n    \"healing\",\n    \"divination\",\n    \"enchantment\",\n    \"clerical\",\n    \"escape\",\n    \"matter\",\n]\n\n\nclass Property:\n    def __init__(self, agent):\n        self.agent = agent\n\n    # The tty status line abbreviates conditions when it gets long (e.g. 'Hallu' -> 'Hl'),\n    # so read them from the blstats condition bitmask instead.\n    def _condition(self, mask):\n        return bool(self.agent.last_observation['blstats'][nh.NLE_BL_CONDITION] & mask)\n\n    @property\n    def confusion(self):\n        return self._condition(nh.BL_MASK_CONF)\n\n    @property\n    def stun(self):\n        return self._condition(nh.BL_MASK_STUN)\n\n    @property\n    def hallu(self):\n        return self._condition(nh.BL_MASK_HALLU)\n\n    @property\n    def blind(self):\n        return self._condition(nh.BL_MASK_BLIND)\n\n    @property\n    def polymorph(self):\n        if not nh.glyph_is_monster(self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]):\n            return False\n        return self.agent.character.self_glyph != self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n\n\nclass Character:\n    UNKNOWN = -1  # for everything, e.g. alignment\n\n    ARCHEOLOGIST = 0\n    BARBARIAN = 1\n    CAVEMAN = 2\n    HEALER = 3\n    KNIGHT = 4\n    MONK = 5\n    PRIEST = 6\n    RANGER = 7\n    ROGUE = 8\n    SAMURAI = 9\n    TOURIST = 10\n    VALKYRIE = 11\n    WIZARD = 12\n\n    name_to_role = {\n        'Archeologist': ARCHEOLOGIST,\n        'Barbarian': BARBARIAN,\n        'Caveman': CAVEMAN,\n        'Cavewoman': CAVEMAN,\n        'Healer': HEALER,\n        'Knight': KNIGHT,\n        'Monk': MONK,\n        'Priest': PRIEST,\n        'Priestess': PRIEST,\n        'Ranger': RANGER,\n        'Rogue': ROGUE,\n        'Samurai': SAMURAI,\n        'Tourist': TOURIST,\n        'Valkyrie': VALKYRIE,\n        'Wizard': WIZARD,\n    }\n\n    CHAOTIC = 0\n    NEUTRAL = 1\n    LAWFUL = 2\n    UNALIGNED = 3\n\n    name_to_alignment = {\n        'chaotic': CHAOTIC,\n        'neutral': NEUTRAL,\n        'lawful': LAWFUL,\n        'unaligned': UNALIGNED,\n    }\n\n    HUMAN = 0\n    DWARF = 1\n    ELF = 2\n    GNOME = 3\n    ORC = 4\n\n    name_to_race = {\n        'human': HUMAN,\n        'dwarf': DWARF,\n        'dwarven': DWARF,\n        'elf': ELF,\n        'elven': ELF,\n        'gnome': GNOME,\n        'gnomish': GNOME,\n        'orc': ORC,\n        'orcish': ORC,\n    }\n\n    MALE = 0\n    FEMALE = 1\n\n    name_to_gender = {\n        'male': MALE,\n        'female': FEMALE,\n    }\n\n    name_to_skill_type = {\n        # \"\": O.P_NONE,\n        \"dagger\": O.P_DAGGER,\n        \"knife\": O.P_KNIFE,\n        \"axe\": O.P_AXE,\n        \"pick-axe\": O.P_PICK_AXE,\n        \"short sword\": O.P_SHORT_SWORD,\n        \"broadsword\": O.P_BROAD_SWORD,\n        \"long sword\": O.P_LONG_SWORD,\n        \"two-handed sword\": O.P_TWO_HANDED_SWORD,\n        \"scimitar\": O.P_SCIMITAR,\n        \"saber\": O.P_SABER,\n        \"club\": O.P_CLUB,\n        \"mace\": O.P_MACE,\n        \"morning star\": O.P_MORNING_STAR,\n        \"flail\": O.P_FLAIL,\n        \"hammer\": O.P_HAMMER,\n        \"quarterstaff\": O.P_QUARTERSTAFF,\n        \"polearms\": O.P_POLEARMS,\n        \"spear\": O.P_SPEAR,\n        \"trident\": O.P_TRIDENT,\n        \"lance\": O.P_LANCE,\n        \"bow\": O.P_BOW,\n        \"sling\": O.P_SLING,\n        \"crossbow\": O.P_CROSSBOW,\n        \"dart\": O.P_DART,\n        \"shuriken\": O.P_SHURIKEN,\n        \"boomerang\": O.P_BOOMERANG,\n        \"whip\": O.P_WHIP,\n        \"unicorn horn\": O.P_UNICORN_HORN,\n\n        \"attack spells\": O.P_ATTACK_SPELL,\n        \"healing spells\": O.P_HEALING_SPELL,\n        \"divination spells\": O.P_DIVINATION_SPELL,\n        \"enchantment spells\": O.P_ENCHANTMENT_SPELL,\n        \"clerical spells\": O.P_CLERIC_SPELL,\n        \"escape spells\": O.P_ESCAPE_SPELL,\n        \"matter spells\": O.P_MATTER_SPELL,\n\n        \"bare handed combat\": O.P_BARE_HANDED_COMBAT,\n        \"martial arts\": O.P_BARE_HANDED_COMBAT,\n        \"two weapon combat\": O.P_TWO_WEAPON_COMBAT,\n        \"riding\": O.P_RIDING,\n    }\n\n    possible_skill_types = ['Fighting Skills', 'Weapon Skills', 'Spellcasting Skills']\n    possible_skill_levels = ['Unskilled', 'Basic', 'Skilled', 'Expert', 'Master', 'Grand Master']\n\n    SKILL_LEVEL_RESTRICTED = 0\n    SKILL_LEVEL_UNSKILLED = 1\n    SKILL_LEVEL_BASIC = 2\n    SKILL_LEVEL_SKILLED = 3\n    SKILL_LEVEL_EXPERT = 4\n    SKILL_LEVEL_MASTER = 5\n    SKILL_LEVEL_GRAND_MASTER = 6\n\n    weapon_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-4, 2),\n        SKILL_LEVEL_UNSKILLED: (-4, 2),\n        SKILL_LEVEL_BASIC: (0, 0),\n        SKILL_LEVEL_SKILLED: (2, 1),\n        SKILL_LEVEL_EXPERT: (3, 2),\n    }\n    two_weapon_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-9, -3),\n        SKILL_LEVEL_UNSKILLED: (-9, -3),\n        SKILL_LEVEL_BASIC: (-7, -1),\n        SKILL_LEVEL_SKILLED: (-5, 0),\n        SKILL_LEVEL_EXPERT: (-3, 1),\n    }\n    riding_bonus = {\n        SKILL_LEVEL_RESTRICTED: (-2, 0),\n        SKILL_LEVEL_UNSKILLED: (-2, 0),\n        SKILL_LEVEL_BASIC: (-1, 0),\n        SKILL_LEVEL_SKILLED: (0, 1),\n        SKILL_LEVEL_EXPERT: (0, 2),\n    }\n    unarmed_bonus = {\n        SKILL_LEVEL_RESTRICTED: (1, 0),\n        SKILL_LEVEL_UNSKILLED: (1, 0),\n        SKILL_LEVEL_BASIC: (1, 1),\n        SKILL_LEVEL_SKILLED: (2, 1),\n        SKILL_LEVEL_EXPERT: (2, 2),\n        SKILL_LEVEL_MASTER: (3, 2),\n        SKILL_LEVEL_GRAND_MASTER: (3, 3),\n    }\n    martial_bonus = {\n        SKILL_LEVEL_RESTRICTED: (1, 0),  # no one has it restricted\n        SKILL_LEVEL_UNSKILLED: (2, 1),\n        SKILL_LEVEL_BASIC: (3, 3),\n        SKILL_LEVEL_SKILLED: (4, 4),\n        SKILL_LEVEL_EXPERT: (5, 6),\n        SKILL_LEVEL_MASTER: (6, 7),\n        SKILL_LEVEL_GRAND_MASTER: (7, 9),\n    }\n\n    name_to_skill_level = {k: v for k, v in zip(['Restricted'] + possible_skill_levels,\n                                                [SKILL_LEVEL_RESTRICTED,\n                                                 SKILL_LEVEL_UNSKILLED, SKILL_LEVEL_BASIC, SKILL_LEVEL_SKILLED,\n                                                 SKILL_LEVEL_EXPERT,\n                                                 SKILL_LEVEL_MASTER, SKILL_LEVEL_GRAND_MASTER])}\n\n    def __init__(self, agent):\n        self.agent = agent\n        self.prop = Property(agent)\n        self.role = None\n        self.alignment = None\n        self.race = None\n        self.gender = None\n        self.self_glyph = None\n        self.skill_levels = np.zeros(max(self.name_to_skill_type.values()) + 1, dtype=int)\n        self.upgradable_skills = dict()\n\n        self.is_lycanthrope = False\n        # 'rat' / 'jackal' / 'wolf' (were.c were_beastie families), None if unknown (LYCAN_FIXES)\n        self.lycanthrope_kind = None\n        # HP before the current polymorph: while polymorphed, blstats show the form's HP, and that form\n        # dying only rehumanizes us (polyself.c rehumanize) back to this HP (LYCAN_FIXES)\n        self.hp_before_poly = None\n        self._was_polymorphed = False\n\n    _WERE_KIND = re.compile(r'\\bwere(rat|jackal|wolf)\\b')\n    _TURN_INTO_WERE = re.compile(r'You turn into an? were(rat|jackal|wolf)!')\n\n    def update(self):\n        from . import jf_config\n        if not jf_config.LYCAN_FIXES:\n            if 'You feel feverish.' in self.agent.message:\n                self.is_lycanthrope = True\n            if 'You feel purified.' in self.agent.message:\n                self.is_lycanthrope = False\n            return\n        # every message since the last update: infections and changes happen inside atomic operations\n        # (fights, searches), and the old check of the last message alone missed some of them\n        history = self.agent._message_history\n        start = getattr(self, '_history_seen', 0)\n        if start > len(history):   # a fresh agent after a driver restart\n            start = 0\n        self._history_seen = len(history)\n        msg = ' '.join(history[start:] + [self.agent.message])\n        # infected while fainted or asleep the message is 'You dream that you feel feverish.' (75 of 591\n        # infections in the dev runs): the old exact match never saw it, so no cure prayer came and the\n        # bot went on eating jackal corpses (jf25 s10: 'You cannibal!', Luck -2..-5, next prayer failed)\n        pos = msg.rfind('feel feverish')\n        if pos >= 0:\n            self.is_lycanthrope = True\n            # the bite may come a turn earlier than the fever ('The wererat bites!' T9061, 'You feel\n            # feverish.' T9062 in public s4): look a few messages back for the biter\n            context = ' '.join(history[max(0, start - 8):start]) + ' ' + msg[:pos]\n            kinds = self._WERE_KIND.findall(context)\n            self.lycanthrope_kind = kinds[-1] if kinds else None\n            self.agent.log(f'LYCAN infected (kind {self.lycanthrope_kind})')\n        m = None\n        for m in self._TURN_INTO_WERE.finditer(msg):\n            pass\n        if m is not None:\n            if not self.is_lycanthrope or self.lycanthrope_kind != m.group(1):\n                self.agent.log(f'LYCAN changed into a were{m.group(1)}')\n            self.is_lycanthrope = True\n            self.lycanthrope_kind = m.group(1)\n        if 'You feel purified' in msg[max(pos, 0):]:\n            self.is_lycanthrope = False\n            self.lycanthrope_kind = None\n            self.agent.log('LYCAN cured')\n        polymorphed = self.prop.polymorph\n        if polymorphed and not self._was_polymorphed:\n            bl = self.agent.blstats\n            # the last HP seen before the change (this step already shows the new form's HP)\n            self.hp_before_poly = getattr(self, '_last_normal_hp', None)\n            self.agent.log(f'POLY changed form; HP before: {self.hp_before_poly} now {bl.hitpoints}/{bl.max_hitpoints}')\n        if not polymorphed:\n            bl = self.agent.blstats\n            self._last_normal_hp = (bl.hitpoints, bl.max_hitpoints)\n            self.hp_before_poly = None\n        self._was_polymorphed = polymorphed\n\n    def were_family(self):\n        \"\"\"Corpse species that are cannibalism for us now (eat.c maybe_cannibal: were_beastie(pm) ==\n        u.ulycn): the whole family of our lycanthropy, or of all three when we don't know which.\"\"\"\n        families = {'rat': ('sewer rat', 'giant rat', 'rabid rat', 'wererat'),\n                    'jackal': ('jackal', 'fox', 'coyote', 'werejackal'),\n                    'wolf': ('wolf', 'warg', 'winter wolf', 'werewolf')}\n        if not self.is_lycanthrope:\n            return ()\n        if self.lycanthrope_kind in families:\n            return families[self.lycanthrope_kind]\n        return tuple(n for names in families.values() for n in names)\n\n    def poly_hp_is_buffer(self):\n        \"\"\"Polymorphed (a were form) with healthy HP to return to: the form's low HP is no emergency\n        -- when it hits 0 we just rehumanize (polyself.c) with the HP we had before the change.\"\"\"\n        if not self.prop.polymorph or self.hp_before_poly is None:\n            return False\n        hp, maxhp = self.hp_before_poly\n        return hp >= max(12, maxhp / 3)\n\n    @property\n    def carrying_capacity(self):\n        # TODO: levitation, etc\n        cap = min(1000, (self.agent.blstats.strength_percentage + self.agent.blstats.constitution) * 25 + 50)\n        # UNSQUEEZE: boxed in by diagonal squeezes (hack.c cant_squeeze_thru: > 600 carried), keep under 600\n        if self.agent.blstats.time < getattr(self.agent, '_squeeze_cap_until', -1):\n            cap = min(cap, 550)\n        return cap\n\n    def parse(self):\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.ATTRIBUTES)\n            text = ' '.join(self.agent.popup)\n            self._parse(text)\n            self.self_glyph = self.agent.glyphs[self.agent.blstats.y, self.agent.blstats.x]\n\n    def _parse(self, text):\n        matches = re.findall('You are a ([a-z]+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+).', text)\n        if len(matches) == 1:\n            alignment, _, gender, race, role = matches[0]\n        else:\n            matches = re.findall(\n                # rank titles can contain hyphens (a Valkyrie at XL 10-13 is a \"Woman-at-arms\")\n                'You are an? ([a-zA-Z -]+), a level (\\d+) (([a-z]+) )?([a-z]+) ([A-Z][a-z]+). *You are ([a-z]+)',\n                text)\n            assert len(matches) == 1, repr(text)\n            _, _, _, gender, race, role, alignment = matches[0]\n\n        if not gender:\n            if role == 'Priestess':\n                gender = 'female'\n            elif role == 'Priest':\n                gender = 'male'\n            elif role == 'Caveman':\n                gender = 'male'\n            elif role == 'Cavewoman':\n                gender = 'female'\n            elif role == 'Valkyrie':\n                gender = 'female'\n            else:\n                assert 0, repr(text)\n\n        self.role = self.name_to_role[role]\n        self.alignment = self.name_to_alignment[alignment]\n        self.race = self.name_to_race[race]\n        self.gender = self.name_to_gender[gender]\n\n    def parse_spellcast_view(self):\n        self.known_spells = dict()\n        self.spell_fail_chance = dict()\n\n        # TODO: parse for other spellcaster classes\n        if self.role not in (self.HEALER,):\n            return\n\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.CAST)\n            if not self.agent.popup:\n                self.known_spells[self.agent.message] = None\n                return\n            if self.agent.popup[0] not in ('Choose which spell to cast') or \\\n                    not self.agent.popup[1].startswith('Name'):\n                raise ValueError(f'Invalid cast popup text format: {self.agent.popup}')\n            for line in self.agent.popup[2:]:\n                matches = re.findall(r'^([a-zA-Z]) - *' +\n                                     r'(' + '|'.join(ALL_SPELL_NAMES) + ') *' +\n                                     r'([0-9]*) *' +\n                                     r'(' + '|'.join(ALL_SPELL_CATEGORIES) + ') *' +\n                                     r'([0-9]*)\\% *' +\n                                     r'([0-9]*\\%|\\(gone\\))', line)\n                assert len(matches) == 1, (matches, line)\n                letter, spell_name, level, category, fail, retention = matches[0]\n                assert len(letter) == 1, letter\n                self.known_spells[spell_name] = letter\n                self.spell_fail_chance[spell_name] = int(fail) / 100\n        self.agent.step(A.Command.ESC)\n\n    def parse_enhance_view(self):\n        with self.agent.atom_operation():\n            self.agent.step(A.Command.ENHANCE)\n            self._parse_enhance_view()\n            while self.upgradable_skills:\n                to_upgrade = self.select_skill_to_upgrade()\n                old_skill_level = self.skill_levels.copy()\n                letter = self.upgradable_skills[to_upgrade]\n\n                def type_letter():\n                    while f'{letter} - ' not in '\\n'.join(self.agent.single_popup):\n                        yield A.TextCharacters.SPACE\n                    yield letter\n\n                self.agent.step(A.Command.ENHANCE, type_letter())\n\n                self.agent.step(A.Command.ENHANCE)\n                self._parse_enhance_view()\n                assert (old_skill_level != self.skill_levels).any(), (old_skill_level, self.skill_levels)\n\n    def select_skill_to_upgrade(self):\n        assert self.upgradable_skills\n        # TODO: logic\n        return next(iter(self.upgradable_skills.keys()))\n\n    def _parse_enhance_view(self):\n        if self.agent.popup[0] not in ('Current skills:', 'Pick a skill to advance:'):\n            raise ValueError('Invalid ehance popup text format.' + str(self.agent.popup))\n        self.upgradable_skills = dict()\n        for line in self.agent.popup[1:]:\n            if line.strip() in self.possible_skill_types or \\\n                    line.strip() == '(Skill flagged by \"#\" cannot be enhanced any further.)' or \\\n                    line.strip() == '(Skills flagged by \"#\" cannot be enhanced any further.)' or \\\n                    line.strip() == '(Skill flagged by \"*\" may be enhanced when you\\'re more experienced.)' or \\\n                    line.strip() == '(Skills flagged by \"*\" may be enhanced when you\\'re more experienced.)':\n                continue\n            matches = re.findall(r'^([a-zA-Z] -)?#?\\*? *' +\n                                 r'(' + '|'.join(self.name_to_skill_type.keys()) + ') *' +\n                                 r'\\[(' + '|'.join(self.possible_skill_levels) + ')\\]', line)\n            assert len(matches) == 1, (matches, line)\n            letter, skill_type, skill_level = matches[0]\n            if letter:\n                letter = letter[0]\n                assert letter not in self.upgradable_skills.values()\n                self.upgradable_skills[self.name_to_skill_type[skill_type]] = letter\n            self.skill_levels[self.name_to_skill_type[skill_type]] = self.name_to_skill_level[skill_level]\n\n    def _get_str_dex_to_hit_bonus(self):\n        bonus = 0\n        # /* attack bonus for strength & dexterity */\n        # int\n        # abon()\n        # {\n        #     int sbon;\n        #     int str = ACURR(A_STR), dex = ACURR(A_DEX);\n        strength = self.agent.blstats.strength\n        dexterity = self.agent.blstats.dexterity\n\n        #     if (Upolyd)\n        #         return (adj_lev(&mons[u.umonnum]) - 3);\n\n        #     if (str < 6)\n        #         sbon = -2;\n        #     else if (str < 8)\n        #         sbon = -1;\n        #     else if (str < 17)\n        #         sbon = 0;\n        #     else if (str <= STR18(50))\n        #         sbon = 1; /* up to 18/50 */\n        #     else if (str < STR18(100))\n        #         sbon = 2;\n        #     else\n        #         sbon = 3;\n        if strength < 6:\n            bonus -= 2\n        elif strength < 8:\n            bonus -= 1\n        elif strength < 17:\n            pass\n        elif strength <= 18 + 50:\n            bonus += 1\n        elif strength < 18 + 100:\n            bonus += 2\n        else:\n            bonus += 3\n\n        #     /* Game tuning kludge: make it a bit easier for a low level character to\n        #      * hit */\n        #     sbon += (u.ulevel < 3) ? 1 : 0;\n\n        #     if (dex < 4)\n        #         return (sbon - 3);\n        #     else if (dex < 6)\n        #         return (sbon - 2);\n        #     else if (dex < 8)\n        #         return (sbon - 1);\n        #     else if (dex < 14)\n        #         return sbon;\n        #     else\n        #         return (sbon + dex - 14);\n        #\n\n        if dexterity < 4:\n            bonus -= 3\n        elif dexterity < 6:\n            bonus -= 2\n        elif dexterity < 8:\n            bonus -= 1\n        elif dexterity < 14:\n            pass\n        else:\n            return bonus + dexterity - 14\n\n        return bonus\n\n    def _get_weapon_skill_bonus(self, item):\n        \"\"\" Retuns a pair (to hit bonus, damage bonus) \"\"\"\n\n        if item is None:\n            if self.role in (self.MONK, self.SAMURAI):\n                return self.martial_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n            else:\n                return self.unarmed_bonus[self.skill_levels[O.P_BARE_HANDED_COMBAT]]\n        else:\n            # TODO: two weapon, riding\n\n            # TODO: proper sub\n            assert all(item.objs[0].sub == obj.sub for obj in item.objs), item.objs\n            sub = abs(item.objs[0].sub)\n\n            if not (0 <= sub < len(self.skill_levels)):\n                raise ValueError('Invalid item sub: ' + str(item) + ' sub: ' + str(sub))\n            # TODO:\n            return self.weapon_bonus[self.skill_levels[sub]]\n\n    def get_ranged_bonus(self, launcher, ammo, monster=None, large_monster=False):\n        # TODO: check code/wiki\n\n        if launcher is not None:\n            assert launcher.is_launcher()\n            assert ammo.is_fired_projectile()\n        else:\n            assert ammo.is_thrown_projectile()\n\n        roll_offset = 0\n        dmg_bonus = 0\n        if launcher is not None:\n            skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(launcher)\n            roll_offset += skill_hit_bonus\n            roll_offset += launcher.get_weapon_bonus(large_monster)[0]\n            dmg_bonus += launcher.get_weapon_bonus(large_monster)[1]\n\n        roll_offset += ammo.get_weapon_bonus(large_monster)[0]\n        dmg_bonus += ammo.get_weapon_bonus(large_monster)[1]\n\n        return roll_offset, max(0, dmg_bonus)\n\n    def get_range(self, launcher, ammo):\n        # TODO: implement\n        return 7\n\n    def get_melee_bonus(self, item, monster=None, large_monster=False):\n        \"\"\" Returns a pair (to_hit, damaga)\n        https://github.com/facebookresearch/nle/blob/master/src/uhitm.c : find_roll_to_hit\n         \"\"\"\n        if monster is not None:\n            raise NotImplementedError()\n\n        # TODO:\n        # tmp = 1 + Luck + abon() + find_mac(mtmp) + u.uhitinc\n        # + maybe_polyd(youmonst.data->mlevel, u.ulevel);\n        roll_offset = 1 + self._get_str_dex_to_hit_bonus() + self.agent.blstats.experience_level\n\n        # TODO:\n        # /* some actions should occur only once during multiple attacks */\n        # if (!(*attk_count)++) {\n        #     /* knight's chivalry or samurai's giri */\n        #     check_caitiff(mtmp);\n        # }\n\n        # TODO:\n        # /* adjust vs. (and possibly modify) monster state */\n        # if (mtmp->mstun)\n        #     tmp += 2;\n        # if (mtmp->mflee)\n        #     tmp += 2;\n\n        # TODO:\n        # if (mtmp->msleeping) {\n        #     mtmp->msleeping = 0;\n        #     tmp += 2;\n        # }\n\n        # TODO:\n        # if (!mtmp->mcanmove) {\n        #     tmp += 4;\n        #     if (!rn2(10)) {\n        #         mtmp->mcanmove = 1;\n        #         mtmp->mfrozen = 0;\n        #     }\n        # }\n\n        # /* role/race adjustments */\n\n        # TODO: polymorphed\n        # if (Role_if(PM_MONK) && !Upolyd) {\n        if self.role == self.MONK:\n            # if (uarm)\n            if self.agent.inventory.items.suit is not None:\n                # tmp -= (*role_roll_penalty = urole.spelarmr);\n                roll_offset -= 20\n            elif item is None and self.agent.inventory.items.off_hand is None:\n                #  else if (!uwep && !uarms)\n                # tmp += (u.ulevel / 3) + 2;\n                roll_offset += (self.agent.blstats.experience_level // 3) + 2\n\n        # TODO:\n        # if (is_orc(mtmp->data)\n        #     && maybe_polyd(is_elf(youmonst.data), Race_if(PM_ELF)))\n        #     tmp++;\n\n        # TODO:\n        # /* encumbrance: with a lot of luggage, your agility diminishes */\n        # if ((tmp2 = near_capacity()) != 0)\n        #     tmp -= (tmp2 * 2) - 1;\n        # if (u.utrap)\n        #     tmp -= 3;\n\n        # /*\n        #  * hitval applies if making a weapon attack while wielding a weapon;\n        #  * weapon_hit_bonus applies if doing a weapon attack even bare-handed\n        #  * or if kicking as martial artist\n        #  */\n        # if (aatyp == AT_WEAP || aatyp == AT_CLAW) {\n        #     if (weapon)\n        #         tmp += hitval(weapon, mtmp);\n        #     tmp += weapon_hit_bonus(weapon);\n        # } else if (aatyp == AT_KICK && martial_bonus()) {\n        #     tmp += weapon_hit_bonus((struct obj *) 0);\n        # }\n        skill_hit_bonus, dmg_bonus = self._get_weapon_skill_bonus(item)\n        roll_offset += skill_hit_bonus\n\n        if item is not None:\n            if item.is_launcher() or item.is_fired_projectile() or item.objs[0].name in ['dart', 'shuriken']:\n                # TODO: rocks, boomerang\n                dmg_bonus = 1.5  # 1d2\n            else:\n                dmg_bonus += item.get_weapon_bonus(large_monster)[1]\n            roll_offset += item.get_weapon_bonus(large_monster)[0]\n        else:\n            # TODO: proper unarmed base damage\n            dmg_bonus += 1.5\n        return roll_offset, max(0, dmg_bonus)\n\n    def get_skill_str_list(self):\n        inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n        inv_skill_level = {v: k for k, v in self.name_to_skill_level.items()}\n        return list(inv_skill_type[skill_type] + '-' + inv_skill_level[level]\n                    for skill_type, level in enumerate(self.skill_levels)\n                    if level in inv_skill_level and skill_type in inv_skill_type and level != 0)\n\n    def __str__(self):\n        if self.role is None:\n            return 'unparsed_character'\n        skill_str = '| '.join(self.get_skill_str_list())\n        if self.upgradable_skills:\n            inv_skill_type = {v: k for k, v in self.name_to_skill_type.items()}\n            skill_str += '\\n Upgradable: ' + '|'.join(letter + '-' + inv_skill_type[skill]\n                                                      for skill, letter in self.upgradable_skills.items())\n        return '-'.join([f'{list(d.keys())[list(d.values()).index(v)][:3].lower()}'\n                         for d, v in [(self.name_to_role, self.role),\n                                      (self.name_to_race, self.race),\n                                      (self.name_to_gender, self.gender),\n                                      (self.name_to_alignment, self.alignment),\n                                      ]]) + '\\n Skills: ' + skill_str","lineStart":1,"lineEnd":716,"totalLines":716,"truncated":false}},"title":"autoascend/character.py","time":{"start":1790510436732,"end":1790510436750}},"id":"prt_0e2bd114f001XYvmtArBm7JiiL","sessionID":"ses_f1d43fee7ffegxFfEwzzxm36mC","messageID":"msg_0e2bd00e7001ZsZjId5BydEjXo"}}
