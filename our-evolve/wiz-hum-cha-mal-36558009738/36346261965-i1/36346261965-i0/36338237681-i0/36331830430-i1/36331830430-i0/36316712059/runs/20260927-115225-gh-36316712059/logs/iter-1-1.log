cker, unknown potions, unknown scrolls.\n2376:         # Overtaxed or worse: NetHack refuses zapping, reading and quaffing without using a turn, and the last\n2377:         # resort looped on it (330 turn-inactivity asserts in one jf24 game)\n2378:         if jf_config.LAST_RESORT and self._critically_low_hp() and self.blstats.carrying_capacity < 4 and \\\n2379:                 not poly_buffer:\n2380:             y, x = self.blstats.y, self.blstats.x\n2381:             adjacent = [m for m in self.get_visible_monsters() if utils.adjacent((m[1], m[2]), (y, x))]\n2382:             # LR_ELBERETH: with every monster close by respecting Elbereth, the Elbereth rest (below us) is the\n2383:             # safer answer: a scared monster doesn't melee, while a zap from the square erases it ('You feel\n2384:             # like a hypocrite') and an unknown ray can bounce back (base2-jf25 s1: a wand of cold at an adjacent\n2385:             # jackal at 2 HP; base2-public s3: zapped from a fresh Elbereth, then a potion of sickness killed\n2386:             # at 3 HP)\n2387:             if adjacent and jf_config.LR_ELBERETH and self.current_level().dungeon_number != 1:  # not Gehennom\n2388:                 dive = self.global_logic.dive\n2389:                 close = dive._near_hostiles(radius=3)\n2390:                 engraving = (self.inventory.engraving_below_me or '').lower()\n2391:                 if not any(dive._ignores_elbereth(m[3]) for m in close) and not self.character.prop.blind and \\\n2392:                         (engraving == 'elbereth' or self.can_engrave()):\n2393:                     adjacent = []\n2394:             if adjacent:\n2395:                 level = self.current_level()\n2396:                 here = level.objects[y, x]\n2397:                 # the stairs once: after that the same crowd followed us (an s9 rescue dive ping-ponged\n2398:                 # down/retreat-up at 15 HP until it died, never trying its wands or potions)\n2399:                 stai