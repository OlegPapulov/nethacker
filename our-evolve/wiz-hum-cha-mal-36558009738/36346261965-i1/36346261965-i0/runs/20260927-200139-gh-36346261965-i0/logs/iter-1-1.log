{"type":"tool_use","timestamp":1790539461259,"sessionID":"ses_f1b882f77ffebyKXRbssgjp7gn","part":{"type":"tool","tool":"read","callID":"call-e2efbceb-fc98-417d-b896-49c308509805","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/strategy.py"},"output":"<path>/workspace/autoascend/strategy.py</path>\n<type>file</type>\n<content>\n1: from functools import wraps\n2: \n3: \n4: class Strategy:\n5:     \"\"\"\n6:     A class representing strategy together with the condition for entering.\n7: \n8:     A strategy is defined as a function returning a generator which yields exactly once.\n9:     An yielded value indicate the condition for entering the strategy. Before the first yield no agent actions\n10:     should be called!\n11: \n12:     For example (pseudocode):\n13:     ```\n14:     Strategy.wrap\n15:     def brutal_fight_strategy(agent, max_distance):\n16:         # check condition\n17:         y, x = find_closest_monster()\n18:         if y == -1:  # no monster on the map\n19:             yield False\n20:         if max(abs(y - agent.blstats.y), abs(x - agent.blstats.x)) > max_distance:\n21:             yield False\n22: \n23:         yield True\n24:         # execute action\n25:         agent.go_to(y, x, stop_one_before=True)\n26:         agent.fight(y, x)\n27:     ```\n28:     \"\"\"\n29: \n30:     @classmethod\n31:     def wrap(cls, func):\n32:         return lambda *a, **k: Strategy(wraps(func)(lambda: func(*a, **k)))\n33: \n34:     def __init__(self, strategy, config=None):\n35:         self.strategy = strategy\n36:         if config is None:\n37:             self.config = str(self.strategy)\n38:         else:\n39:             self.config = config\n40: \n41:     def run(self, return_condition=False):\n42:         gen = self.strategy()\n43:         if not next(gen):\n44:             if return_condition:\n45:                 return False\n46:             return None\n47:         try:\n48:             next(gen)\n49:             assert 0\n50:         except StopIteration as e:\n51:             if return_condition:\n52:                 return True\n53:             return e.value\n54: \n55:     def check_condition(self):\n56:         gen = self.strategy()\n57:         return next(gen)\n58: \n59:     def condition(self, condition):\n60:         \"\"\" Add additional condition for entering the strategy \"\"\"\n61:         def f(self=self, condition=condition):\n62:             if not condition():\n63:                 yield False\n64:                 assert 0\n65:             it = self.strategy()\n66:             yield next(it)\n67:             try:\n68:                 next(it)\n69:                 assert 0\n70:             except StopIteration as e:\n71:                 return e.value\n72: \n73:         return Strategy(f, {'strategy': self.config, 'condition': str(condition)})\n74: \n75:     def until(self, agent, condition):\n76:         \"\"\" Run the strategy until condition \"\"\"\n77:         def f():\n78:             if not condition():\n79:                 yield False\n80:                 assert 0\n81:             yield True\n82: \n83:         strategy = self.condition(lambda: not condition()).preempt(agent, [Strategy(f)],\n84:                                                                    continue_after_preemption=False)\n85:         strategy.config = {'strategy': self.config, 'until': str(condition)}\n86:         return strategy\n87: \n88:     def before(self, strategy):\n89:         \"\"\" Stack sequentially two strategies \"\"\"\n90:         def f(self=self, strategy=strategy):\n91:             yielded = False\n92:             r1, r2 = None, None\n93: \n94:             v1 = self.strategy()\n95:             if next(v1):\n96:                 if not yielded:\n97:                     yielded = True\n98:                     yield True\n99:                 try:\n100:                     next(v1)\n101:                     assert 0, v1\n102:                 except StopIteration as e:\n103:                     r1 = e.value\n104: \n105:             v2 = strategy.strategy()\n106:             if next(v2):\n107:                 if not yielded:\n108:                     yielded = True\n109:                     yield True\n110:                 try:\n111:                     next(v2)\n112:                     assert 0, v2\n113:                 except StopIteration as e:\n114:                     r2 = e.value\n115: \n116:             if not yielded:\n117:                 yield False\n118: \n119:             return (r1, r2)\n120: \n121:         return Strategy(f, {'1': self.config, '2': strategy.config})\n122: \n123:     def preempt(self, agent, strategies, continue_after_preemption=True):\n124:         \"\"\" Specify other strategies that may preempt the strategy \"\"\"\n125:         def f(self=self, agent=agent, strategies=strategies):\n126:             gen = self.strategy()\n127:             condition_passed = False\n128:             with agent.disallow_step_calling():\n129:                 condition_passed = next(gen)\n130: \n131:             if not condition_passed:\n132:                 yield False\n133:             yield True\n134: \n135:             assert not agent._no_step_calls\n136: \n137:             def f2():\n138:                 try:\n139:                     next(gen)\n140:                     assert 0, gen\n141:                 except StopIteration as e:\n142:                     return e.value\n143: \n144:             return agent.preempt(strategies, self, first_func=f2, continue_after_preemption=continue_after_preemption)\n145: \n146:         return Strategy(f, {'strategy': self.config, 'preempt': [s.config for s in strategies]})\n147: \n148:     def repeat(self):\n149:         \"\"\" Repeat strategy until the condition is true \"\"\"\n150:         def f(self=self):\n151:             yielded = False\n152:             val = None\n153:             while 1:\n154:                 gen = self.strategy()\n155:                 if not next(gen):\n156:                     if not yielded:\n157:                         yield False\n158:                     return\n159: \n160:                 if not yielded:\n161:                     yielded = True\n162:                     yield True\n163: \n164:                 try:\n165:                     next(gen)\n166:                     assert 0, gen\n167:                 except StopIteration as e:\n168:                     val = e.value\n169:             return val\n170: \n171:         return Strategy(f, {'repeat': self.config})\n172: \n173:     def every(self, num_of_iterations):\n174:         \"\"\"\n175:         Check the condition only every `num_of_iterations` iterations. Otherwise assume false.\n176:         Used for execution time optimization.\n177:         \"\"\"\n178:         current_num = -1\n179: \n180:         def f():\n181:             nonlocal current_num\n182:             current_num += 1\n183:             if current_num % num_of_iterations != 0:\n184:                 yield False\n185:                 assert 0\n186:             it = self.strategy()\n187:             yield next(it)\n188:             current_num = -1\n189:             try:\n190:                 next(it)\n191:                 assert 0\n192:             except StopIteration as e:\n193:                 return e.value\n194: \n195:         return Strategy(f, {'strategy': self.config, 'every': num_of_iterations})\n196: \n197:     def __repr__(self):\n198:         return str(self.config)\n\n(End of file - total 198 lines)\n</content>","metadata":{"preview":"from functools import wraps\n\n\nclass Strategy:\n    \"\"\"\n    A class representing strategy together with the condition for entering.\n\n    A strategy is defined as a function returning a generator which yields exactly once.\n    An yielded value indicate the condition for entering the strategy. Before the first yield no agent actions\n    should be called!\n\n    For example (pseudocode):\n    ```\n    Strategy.wrap\n    def brutal_fight_strategy(agent, max_distance):\n        # check condition\n        y, x = find_closest_monster()\n        if y == -1:  # no monster on the map\n            yield False\n        if max(abs(y - agent.blstats.y), abs(x - agent.blstats.x)) > max_distance:","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/strategy.py","text":"from functools import wraps\n\n\nclass Strategy:\n    \"\"\"\n    A class representing strategy together with the condition for entering.\n\n    A strategy is defined as a function returning a generator which yields exactly once.\n    An yielded value indicate the condition for entering the strategy. Before the first yield no agent actions\n    should be called!\n\n    For example (pseudocode):\n    ```\n    Strategy.wrap\n    def brutal_fight_strategy(agent, max_distance):\n        # check condition\n        y, x = find_closest_monster()\n        if y == -1:  # no monster on the map\n            yield False\n        if max(abs(y - agent.blstats.y), abs(x - agent.blstats.x)) > max_distance:\n            yield False\n\n        yield True\n        # execute action\n        agent.go_to(y, x, stop_one_before=True)\n        agent.fight(y, x)\n    ```\n    \"\"\"\n\n    @classmethod\n    def wrap(cls, func):\n        return lambda *a, **k: Strategy(wraps(func)(lambda: func(*a, **k)))\n\n    def __init__(self, strategy, config=None):\n        self.strategy = strategy\n        if config is None:\n            self.config = str(self.strategy)\n        else:\n            self.config = config\n\n    def run(self, return_condition=False):\n        gen = self.strategy()\n        if not next(gen):\n            if return_condition:\n                return False\n            return None\n        try:\n            next(gen)\n            assert 0\n        except StopIteration as e:\n            if return_condition:\n                return True\n            return e.value\n\n    def check_condition(self):\n        gen = self.strategy()\n        return next(gen)\n\n    def condition(self, condition):\n        \"\"\" Add additional condition for entering the strategy \"\"\"\n        def f(self=self, condition=condition):\n            if not condition():\n                yield False\n                assert 0\n            it = self.strategy()\n            yield next(it)\n            try:\n                next(it)\n                assert 0\n            except StopIteration as e:\n                return e.value\n\n        return Strategy(f, {'strategy': self.config, 'condition': str(condition)})\n\n    def until(self, agent, condition):\n        \"\"\" Run the strategy until condition \"\"\"\n        def f():\n            if not condition():\n                yield False\n                assert 0\n            yield True\n\n        strategy = self.condition(lambda: not condition()).preempt(agent, [Strategy(f)],\n                                                                   continue_after_preemption=False)\n        strategy.config = {'strategy': self.config, 'until': str(condition)}\n        return strategy\n\n    def before(self, strategy):\n        \"\"\" Stack sequentially two strategies \"\"\"\n        def f(self=self, strategy=strategy):\n            yielded = False\n            r1, r2 = None, None\n\n            v1 = self.strategy()\n            if next(v1):\n                if not yielded:\n                    yielded = True\n                    yield True\n                try:\n                    next(v1)\n                    assert 0, v1\n                except StopIteration as e:\n                    r1 = e.value\n\n            v2 = strategy.strategy()\n            if next(v2):\n                if not yielded:\n                    yielded = True\n                    yield True\n                try:\n                    next(v2)\n                    assert 0, v2\n                except StopIteration as e:\n                    r2 = e.value\n\n            if not yielded:\n                yield False\n\n            return (r1, r2)\n\n        return Strategy(f, {'1': self.config, '2': strategy.config})\n\n    def preempt(self, agent, strategies, continue_after_preemption=True):\n        \"\"\" Specify other strategies that may preempt the strategy \"\"\"\n        def f(self=self, agent=agent, strategies=strategies):\n            gen = self.strategy()\n            condition_passed = False\n            with agent.disallow_step_calling():\n                condition_passed = next(gen)\n\n            if not condition_passed:\n                yield False\n            yield True\n\n            assert not agent._no_step_calls\n\n            def f2():\n                try:\n                    next(gen)\n                    assert 0, gen\n                except StopIteration as e:\n                    return e.value\n\n            return agent.preempt(strategies, self, first_func=f2, continue_after_preemption=continue_after_preemption)\n\n        return Strategy(f, {'strategy': self.config, 'preempt': [s.config for s in strategies]})\n\n    def repeat(self):\n        \"\"\" Repeat strategy until the condition is true \"\"\"\n        def f(self=self):\n            yielded = False\n            val = None\n            while 1:\n                gen = self.strategy()\n                if not next(gen):\n                    if not yielded:\n                        yield False\n                    return\n\n                if not yielded:\n                    yielded = True\n                    yield True\n\n                try:\n                    next(gen)\n                    assert 0, gen\n                except StopIteration as e:\n                    val = e.value\n            return val\n\n        return Strategy(f, {'repeat': self.config})\n\n    def every(self, num_of_iterations):\n        \"\"\"\n        Check the condition only every `num_of_iterations` iterations. Otherwise assume false.\n        Used for execution time optimization.\n        \"\"\"\n        current_num = -1\n\n        def f():\n            nonlocal current_num\n            current_num += 1\n            if current_num % num_of_iterations != 0:\n                yield False\n                assert 0\n            it = self.strategy()\n            yield next(it)\n            current_num = -1\n            try:\n                next(it)\n                assert 0\n            except StopIteration as e:\n                return e.value\n\n        return Strategy(f, {'strategy': self.config, 'every': num_of_iterations})\n\n    def __repr__(self):\n        return str(self.config)","lineStart":1,"lineEnd":198,"totalLines":198,"truncated":false}},"title":"autoascend/strategy.py","time":{"start":1790539461244,"end":1790539461256}},"id":"prt_0e477f279001v0vV9iouZQK1We","sessionID":"ses_f1b882f77ffebyKXRbssgjp7gn","messageID":"msg_0e477ec7a001vTwS5vDdI1u24Q"}}
{"type":"tool_use","timestamp":1790539462040,"sessionID":"ses_f1b882f77ffebyKXRbssgjp7gn","part":{"type":"tool","tool":"read","callID":"call-56fcd807-335d-477f-b5e4-3f8afeb67fcd","state":{"status":"completed","input":{"filePath":"/workspace/autoascend/agent.py"},"output":"<path>/workspace/autoascend/agent.py</path>\n<type>file</type>\n<content>\n1: import contextlib\n2: import re\n3: from collections import namedtuple, Counter, defaultdict\n4: from functools import partial\n5: \n6: import nle.nethack as nh\n7: import nltk\n8: import numpy as np\n9: from nle.nethack import actions as A\n10: \n11: from . import combat\n12: from . import utils\n13: from .character import Character\n14: from .exceptions import AgentPanic, AgentFinished, AgentChangeStrategy\n15: from .exploration_logic import ExplorationLogic\n16: from .global_logic import GlobalLogic, early_dig_xl\n17: \n18: # ablation switches\n19: CORPSE_MAX_AGE = 30\n20: PRAY_AT_EXACT_THRESHOLD = True\n21: from .glyph import MON, C, Hunger, G, SHOP\n22: from .item import Item, flatten_items\n23: from .item.inventory import Inventory\n24: from .level import Level\n25: from .monster_tracker import MonsterTracker, disappearance_mask\n26: from .stats_logger import StatsLogger\n27: from .strategy import Strategy\n28: \n29: BLStats = namedtuple('BLStats',\n30:                      'x y strength_percentage strength dexterity constitution intelligence wisdom charisma score hitpoints max_hitpoints depth gold energy max_energy armor_class monster_level experience_level experience_points time hunger_state carrying_capacity dungeon_number level_number prop_mask alignment')\n31: \n32: \n33: # a hunger prayer waits this many turns after the previous prayer: a timeout drawn from rnz(350)\n34: # is still above the major-trouble limit (200) ~7% of the time after 900 turns, ~2.5% after 1200\n35: HUNGER_PRAYER_GAP = 1200\n36: # ...unless the character has been fainting this long (hunger then drops at 1/10 the rate)\n37: FAINTING_PRAYER_DEADLINE = 300\n38: # ...or as soon as a hostile that can move shows up this close while the character is Fainting,\n39: # provided at least this many turns have passed since the previous prayer\n40: THREAT_PRAYER_GAP = 950\n41: THREAT_PRAYER_DISTANCE = 6\n42: PRAYER_FAILED_MESSAGES = ('is displeased', 'Thou hast angered me', 'Thou art arrogant', 'Thou hast strayed',\n43:                           'Thou durst', 'relearn thy lessons', 'is bummed')\n44: \n45: \n46: class Agent:\n47:     def __init__(self, env, seed=0, verbose=False, panic_on_errors=False):\n48:         self.env = env\n49:         self.verbose = verbose\n50:         self.rng = np.random.RandomState(seed)\n51:         self.panic_on_errors = panic_on_errors\n52:         self.all_panics = []\n53: \n54:         self.on_update = []\n55:         self.levels = {}\n56:         self.score = 0\n57:         self.step_count = 0\n58:         self._observation = None  # this should be used in additional_action_iterator generators\n59:         # single_{message,popup} should be used in additional_action_itertator generators.\n60:         # (non-single) message & popup contain cummulated content\n61:         self.message = self.single_message = ''\n62:         self.popup = self.single_popup = []\n63:         self._message_history = []\n64:         self.cursor_pos = (0, 0)\n65:         self.last_observation = None\n66: \n67:         self._last_pet_seen = 0\n68: \n69:         self.inventory = Inventory(self)\n70:         self.character = Character(self)\n71:         self.exploration = ExplorationLogic(self)\n72:         self.global_logic = GlobalLogic(self)\n73:         self.monster_tracker = MonsterTracker(self)\n74: \n75:         self.last_bfs_dis = None\n76:         self.last_bfs_step = None\n77:         self.last_prayer_turn = None\n78:         self.prayer_failed = False  # the god was angered: every later prayer only smites again\n79:         self._fainting_since = None\n80:         self._monk_meat_meals = 0\n81:         self._previous_glyphs = None\n82:         self._last_turn = -1\n83:         self._inactivity_counter = 0\n84:         self._pass_turn_after_error = False\n85:         self._is_updating_state = False\n86: \n87:         self._no_step_calls = False\n88: \n89:         self.turns_in_atom_operation = None\n90:         self._atom_operation_allow_update = None\n91: \n92:         self._is_reading_message_or_popup = False\n93:         self._last_terrain_check = None\n94:         self._forbidden_engrave_position = (-1, -1)\n95: \n96:         # when (number of turn) there was last decision about allowing these actions (e.g. agent is somewhat stuck)\n97:         self._allow_walking_through_traps_turn = -float('inf')\n98:         self._allow_attack_all_turn = -float('inf')\n99: \n100:         self.last_cast_fail_turn = defaultdict(lambda: -float('inf'))\n101:         self._pick_dig_attempts = dict()\n102:         self._dig_engrave_attempts = dict()\n103:         self._undiggable_levels = set()  # level keys whose floor refused a dig\n104:         self._mines_bottom_found = False  # Mines' End reached: no more digging in the Mines\n105:         self._mapped_levels = set()\n106:         self._empty_wand_letters = set()  # inventory letters of wands that did nothing when zapped\n107: \n108:         self.stats_logger = StatsLogger()\n109: \n110:     @property\n111:     def has_pet(self):\n112:         return (self.blstats.time - self._last_pet_seen) <= 16\n113: \n114:     @property\n115:     def in_atom_operation(self):\n116:         return self.turns_in_atom_operation is not None\n117: \n118:     ######## CONVENIENCE FUNCTIONS\n119: \n120:     @contextlib.contextmanager\n121:     def disallow_step_calling(self):\n122:         if self._no_step_calls:\n123:             yield\n124:             return\n125: \n126:         try:\n127:             self._no_step_calls = True\n128:             yield\n129:         finally:\n130:             self._no_step_calls = False\n131: \n132:     @contextlib.contextmanager\n133:     def atom_operation(self, allow_update=False):\n134:         assert not self._no_step_calls\n135:         if self.turns_in_atom_operation is not None:\n136:             # already in an atom operation\n137:             old_allow_update = self._atom_operation_allow_update\n138:             if old_allow_update is None:\n139:                 self._atom_operation_allow_update = allow_update\n140:             else:\n141:                 assert old_allow_update or not allow_update\n142:                 self._atom_operation_allow_update = old_allow_update and allow_update\n143:             try:\n144:                 yield\n145:             finally:\n146:                 self._atom_operation_allow_update = old_allow_update\n147:             return\n148: \n149:         self.turns_in_atom_operation = 0\n150:         self._atom_operation_allow_update = allow_update\n151:         try:\n152:             yield\n153:         finally:\n154:             self.turns_in_atom_operation = None\n155:             self._atom_operation_allow_update = None\n156: \n157:         self.update_state()\n158: \n159:     @contextlib.contextmanager\n160:     def panic_if_position_changes(self):\n161:         y, x = self.blstats.y, self.blstats.x\n162: \n163:         def f(self):\n164:             if (y, x) != (self.blstats.y, self.blstats.x):\n165:                 raise AgentPanic('position changed')\n166: \n167:         fun = partial(f, self)\n168: \n169:         self.on_update.append(fun)\n170: \n171:         try:\n172:             yield\n173:         finally:\n174:             assert fun in self.on_update\n175:             self.on_update.pop(self.on_update.index(fun))\n176: \n177:     @contextlib.contextmanager\n178:     def add_on_update(self, funcs):\n179:         self.on_update.extend(funcs)\n180: \n181:         try:\n182:             yield\n183:         finally:\n184:             for f in funcs:\n185:                 self.on_update.pop(self.on_update.index(f))\n186: \n187:     @contextlib.contextmanager\n188:     def context_preempt(self, conditions):\n189:         ids = []\n190:         id2fun = {}\n191:         for cond in conditions:\n192:             def f(iden, cond=cond):\n193:                 if cond():\n194:                     raise AgentChangeStrategy(iden, cond)\n195: \n196:             fun = partial(f, id(f))\n197:             assert id(f) not in id2fun\n198:             id2fun[id(f)] = fun\n199:             ids.append(id(f))\n200:             self.on_update.append(fun)\n201: \n202:         outcome = None\n203:         for i, cond in enumerate(conditions):\n204:             if cond():\n205:                 outcome = i\n206:                 break\n207: \n208:         def outcome_f():\n209:             nonlocal outcome\n210:             return outcome\n211: \n212:         try:\n213:             yield outcome_f\n214: \n215:         except AgentChangeStrategy as e:\n216:             i = e.args[0]\n217:             if i not in id2fun:\n218:                 raise\n219:             outcome = ids.index(i)\n220:         finally:\n221:             for f in id2fun.values():\n222:                 self.on_update.pop(self.on_update.index(f))\n223: \n224:         # check if less nested ChangeStategy is present\n225:         self.call_update_functions()\n226: \n227:     def preempt(self, strategies, func, first_func=None, continue_after_preemption=True):\n228:         id2fun = {}\n229:         for strategy in strategies:\n230:             def f(iden, strategy):\n231:                 it = strategy.strategy()\n232:                 if next(it):\n233:                     raise AgentChangeStrategy(iden, it)\n234: \n235:             iden = (id(f), id(strategy))\n236:             fun = partial(f, iden, strategy)\n237:             assert iden not in id2fun\n238:             id2fun[iden] = fun\n239: \n240:         last_turn = 0\n241: \n242:         call_update = True\n243: \n244:         val = None\n245: \n246:         last_step = self.step_count\n247:         inactivity_counter = 0\n248:         is_first = True\n249:         while 1:\n250:             inactivity_counter += 1\n251:             if self.step_count != last_step:\n252:                 last_step = self.step_count\n253:                 inactivity_counter = 0\n254:             assert inactivity_counter < 5, 'cyclic preempt'\n255: \n256:             iterator = None\n257:             try:\n258:                 with self.add_on_update(list(id2fun.values())):\n259:                     if call_update:\n260:                         call_update = False\n261:                         self.call_update_functions(list(id2fun.values()))\n262: \n263:                     f = (first_func or func) if is_first else func\n264:                     if isinstance(f, Strategy):\n265:                         val = f.run()\n266:                     else:\n267:                         val = f()\n268:                     break\n269: \n270:             except AgentChangeStrategy as e:\n271:                 i = e.args[0]\n272:                 if i not in id2fun:\n273:                     raise\n274:                 iterator = e.args[1]\n275: \n276:             if iterator is not None:\n277:                 try:\n278:                     next(iterator)\n279:                     assert 0, iterator\n280:                 except StopIteration:\n281:                     pass\n282: \n283:                 if not continue_after_preemption:\n284:                     break\n285: \n286:             is_first = False\n287: \n288:         return val\n289: \n290:     ######## UPDATE FUNCTIONS\n291: \n292:     def on_panic(self):\n293:         self.check_terrain(force=True)\n294:         self.inventory.on_panic()\n295:         self.monster_tracker.on_panic()\n296:         self.update_state()\n297: \n298:     @staticmethod\n299:     def _find_marker(lines, regex=re.compile(r\"(--More--|\\(end\\)|\\(\\d+ of \\d+\\))\")):\n300:         \"\"\" Return (line, column) of markers:\n301:         --More-- | (end) | (X of N)\n302:         \"\"\"\n303:         if len(regex.findall(' '.join(lines))) > 1:\n304:             raise ValueError('Too many markers')\n305: \n306:         result, marker_type = None, None\n307:         for i, line in enumerate(lines):\n308:             res = regex.findall(line)\n309:             if res:\n310:                 assert len(res) == 1\n311:                 j = line.find(res[0])\n312:                 result, marker_type = (i, j), res[0]\n313:                 break\n314: \n315:         if result is not None and result[1] == 1:\n316:             result = (result[0], 0)  # e.g. for known items view\n317:         return result, marker_type\n318: \n319:     def get_message_and_popup(self, obs):\n320:         \"\"\" Uses MORE action to get full popup and/or message.\n321:         \"\"\"\n322: \n323:         message = bytes(obs['message']).decode().replace('\\0', ' ').replace('\\n', '').strip()\n324:         if message.endswith('--More--'):\n325:             # FIXME: It seems like in this case the environment doesn't expect additional input,\n326:             #        but I'm not 100% sure, so it's too risky to change it, because it could stall everything.\n327:             #        With the current implementation, in the worst case, we'll get \"Unknown command ' '\".\n328:             message = message[:-len('--More--')]\n329: \n330:         # assert '\\n' not in message and '\\r' not in message\n331:         popup = []\n332: \n333:         lines = [bytes(line).decode().replace('\\0', ' ').replace('\\n', '') for line in obs['tty_chars']]\n334:         marker_pos, marker_type = self._find_marker(lines)\n335: \n336:         if marker_pos is None:\n337:             return message, popup, True\n338: \n339:         pref = ''\n340:         message_lines_count = 0\n341:         if message:\n342:             for i, line in enumerate(lines[:marker_pos[0] + 1]):\n343:                 if i == marker_pos[0]:\n344:                     line = line[:marker_pos[1]]\n345:                 message_lines_count += 1\n346:                 pref += line.strip()\n347: \n348:                 # I'm not sure when the new line character in broken messages should be a space and when be ignored.\n349:                 # '#' character (and others) occasionally occurs at the beginning of the broken line and isn't in\n350:                 # the message. Sometimes the message on the screen lacks last '.'.\n351:                 replace_func = lambda x: ''.join((c for c in x if c.isalnum()))\n352:                 if replace_func(pref) == replace_func(message):\n353:                     break\n354:             else:\n355:                 if marker_pos[0] == 0:\n356:                     elems1 = [s for s in message.split() if s]\n357:                     elems2 = [s for s in pref.split() if s]\n358:                     assert len(elems1) < len(elems2) and elems2[-len(elems1):] == elems1, (elems1, elems2)\n359:                     return pref, popup, False\n360:                 raise ValueError(f\"Message:\\n{repr(message)}\\ndoesn't match the screen:\\n{repr(pref)}\")\n361: \n362:         # cut out popup\n363:         for l in lines[message_lines_count:marker_pos[0]] + [lines[marker_pos[0]][:marker_pos[1]]]:\n364:             l = l[marker_pos[1]:].strip()\n365:             if l:\n366:                 popup.append(l)\n367: \n368:         return message, popup, False\n369: \n370:     def update_message_and_popup(self, obs):\n371:         if self._is_reading_message_or_popup:\n372:             message_prefix = self.message + (' ' if self.message else '')\n373:             popup_prefix = self.popup\n374:         else:\n375:             message_prefix = ''\n376:             popup_prefix = []\n377: \n378:         self.single_message, self.single_popup, done = self.get_message_and_popup(obs)\n379:         self.single_message = self.single_message.strip()\n380:         self.single_popup = [p.strip() for p in self.single_popup]\n381: \n382:         self.message = message_prefix + self.single_message\n383:         self.popup = popup_prefix + self.single_popup\n384:         return done\n385: \n386:     def step(self, action, additional_action_iterator=None):\n387:         if self._no_step_calls:\n388:             raise ValueError(\"Shouldn't call step now\")\n389: \n390:         if isinstance(action, str):\n391:             assert len(action) == 1\n392:             action = A.ACTIONS[A.ACTIONS.index(ord(action))]\n393:         observation, reward, done, info = self.env.step(action)\n394:         observation = {k: v.copy() for k, v in observation.items()}\n395:         self.step_count += 1\n396:         self.score += reward\n397: \n398:         self.cursor_pos = (observation['tty_cursor'][0] - 1, observation['tty_cursor'][1])\n399: \n400:         if hasattr(self, 'blstats'):\n401:             for item in flatten_items(self.inventory.items):\n402:                 if item.category == nh.COIN_CLASS:\n403:                     self.stats_logger.log_gold(item.count)\n404:             else:\n405:                 self.stats_logger.log_gold(0)\n406: \n407:         if done:\n408:             raise AgentFinished()\n409: \n410:         self.update(observation, additional_action_iterator)\n411: \n412:     def update(self, observation, additional_action_iterator=None):\n413:         self._observation = observation\n414:         done = self.update_message_and_popup(observation)\n415: \n416:         self._is_reading_message_or_popup = True\n417:         if additional_action_iterator is not None:\n418:             is_next_action = True\n419:             try:\n420:                 next_action = next(additional_action_iterator)\n421:             except StopIteration:\n422:                 is_next_action = False\n423: \n424:             if is_next_action:\n425:                 self.step(next_action, additional_action_iterator)\n426:                 return\n427: \n428:         # FIXME: self.update_state() won't be called on all states sometimes.\n429:         #        Otherwise there are problems with atomic operations.\n430:         if not done or observation['misc'][2]:\n431:             self.step(A.TextCharacters.SPACE)\n432:             return\n433: \n434:         if observation['misc'][1]:  # entering text\n435:             if \"You may wish for an object.\" in self.message:\n436:                 # TODO: wishing strategy\n437:                 # TODO: assume wished item as blessed\n438:                 self.step('b', iter('lessed greased +2 gray dragon scale mail\\r'))\n439:                 return\n440:             else:\n441:                 self.step(A.Command.ESC)\n442:                 return\n443: \n444:         if 'Where do you want to be teleported?' in self.message:\n445:             # TODO: teleport control\n446:             self.step(A.Command.ESC)\n447:             return\n448: \n449:         if b'[yn]' in bytes(observation['tty_chars'].reshape(-1)):\n450:             self.type_text('y')\n451:             return\n452: \n453:         self._is_reading_message_or_popup = False\n454:         self._message_history.append(self.message)\n455:         if len(self._message_history) > 400:\n456:             del self._message_history[:-200]  # only the last 50 are ever read\n457: \n458:         # should_update = True\n459: \n460:         # if self.turns_in_atom_operation is not None:\n461:         #     should_update = False\n462:         #     # if any([(self.last_observation[key] != observation[key]).any()\n463:         #     #         for key in ['glyphs', 'blstats', 'inv_strs', 'inv_letters', 'inv_oclasses', 'inv_glyphs']]):\n464:         #     #     self.turns_in_atom_operation += 1\n465:         #     # assert self.turns_in_atom_operation in [0, 1]\n466: \n467:         if self.last_observation is None:\n468:             self.last_observation = observation\n469:             self._previous_glyphs = self.last_observation['glyphs']\n470:         else:\n471:             self._previous_glyphs = self.last_observation['glyphs']\n472:             self.last_observation = observation\n473: \n474:         self.blstats = BLStats(*self.last_observation['blstats'])\n475:         self.glyphs = self.last_observation['glyphs']\n476: \n477:         self.stats_logger.log_cumulative_value('max_turns_on_position',\n478:                                                key=(self.current_level().dungeon_number,\n479:                                                     self.current_level().level_number,\n480:                                                     self.blstats.y, self.blstats.x),\n481:                                                value=self.blstats.time - self._last_turn)\n482: \n483:         self._inactivity_counter += 1\n484:         if self._last_turn != self.blstats.time:\n485:             self._last_turn = self.blstats.time\n486:             self._inactivity_counter = 0\n487:         assert self._inactivity_counter < 200, ('turn inactivity', sorted(set(self._message_history[-50:])))\n488: \n489:         self.update_state(allow_update=self._atom_operation_allow_update or not self.in_atom_operation,\n490:                           allow_callbacks=not self.in_atom_operation)\n491: \n492:     def update_state(self, allow_update=True, allow_callbacks=True):\n493:         assert not self._no_step_calls\n494:         if self._is_updating_state:\n495:             return\n496:         self._is_updating_state = True\n497:         message = self.message\n498:         popup = self.popup\n499: \n500:         try:\n501:             if allow_update:\n502:                 # functions that are allowed to call state unchanging steps\n503:                 for func in [self.character.update, self.inventory.update, self.monster_tracker.update,\n504:                              partial(self.check_terrain, force=False), self.update_level,\n505:                              self.global_logic.update]:\n506:                     func()\n507:                     self.message = message\n508:                     self.popup = popup\n509: \n510:             if allow_callbacks:\n511:                 self.call_update_functions()\n512:         finally:\n513:             self._is_updating_state = False\n514: \n515:     def call_update_functions(self, funcs=None):\n516:         if funcs is None:\n517:             funcs = self.on_update\n518:         assert all((func in self.on_update for func in funcs))\n519: \n520:         with self.disallow_step_calling():\n521:             for func in funcs:\n522:                 func()\n523: \n524:     def _update_level_items(self):\n525:         level = self.current_level()\n526: \n527:         level.items[self.blstats.y, self.blstats.x] = self.inventory.items_below_me\n528:         level.item_count[self.blstats.y, self.blstats.x] = len(self.inventory.items_below_me)\n529: \n530:         # TODO: optimize\n531:         ignore_mask = utils.isin(self.glyphs, G.MONS, G.PETS)  # TODO: effects, etc\n532:         item_mask = level.item_count != 0\n533:         mask = item_mask & ~ignore_mask\n534:         level.item_disagreement_counter[~mask] = 0\n535:         for y, x in zip(*mask.nonzero()):\n536:             if (level.item_count[y, x] >= 2) == ((self.last_observation['specials'][y, x] & nh.MG_OBJPILE) > 0):\n537:                 glyphs = (glyph for item in level.items[y, x] for glyph in item.display_glyphs())\n538:                 if self.glyphs[y, x] in glyphs:\n539:                     level.item_disagreement_counter[y, x] = 0\n540:                     continue\n541: \n542:             level.item_disagreement_counter[y, x] += 1\n543:             if level.item_disagreement_counter[y, x] > 3:\n544:                 level.item_disagreement_counter[y, x] = 0\n545:                 level.items[y, x] = ()\n546:                 level.item_count[y, x] = 0\n547: \n548:     def _update_level_shops(self):\n549:         level = self.current_level()\n550: \n551:         shop_type = None\n552:         matches = re.search(f\"Welcome( again)? to [a-zA-Z' ]*({'|'.join(SHOP.name2id.keys())})!\", self.message)\n553:         if matches is not None:\n554:             shop_name = matches.groups()[1]\n555:             assert shop_name in SHOP.name2id, shop_name\n556:             shop_type = SHOP.name2id[shop_name]\n557: \n558:         shopkeepers = list(\n559:             zip(*(utils.isin(self.glyphs, G.SHOPKEEPER) & self.monster_tracker.peaceful_monster_mask).nonzero()))\n560:         for y, x in shopkeepers:\n561:             wall_mask = utils.isin(level.objects, G.WALL)\n562:             entry = ((utils.translate(wall_mask, 1, 0) & utils.translate(wall_mask, -1, 0)) |\n563:                      (utils.translate(wall_mask, 0, 1) & utils.translate(wall_mask, 0, -1))) & \\\n564:                     level.walkable\n565:             walkable = level.walkable & ~entry\n566:             mask = utils.bfs(y, x, walkable=walkable, walkable_diagonally=walkable, can_squeeze=False) != -1\n567:             mask = utils.dilate(mask, radius=1)\n568: \n569:             level.shop[mask] = True\n570:             if mask[self.blstats.y, self.blstats.x] and shop_type is not None:\n571:                 level.shop_type[mask] = shop_type\n572:             level.shop_interior[mask & ~utils.dilate(entry, radius=1, with_diagonal=False)] = True\n573: \n574:     def _update_level_corpses(self):\n575:         mnames = list(map(lambda x: x[-1],\n576:                           re.findall(r'((kills?)|(destroys?)) ((an?)|(the) )?([a-zA-Z ]+)\\!', self.message)))\n577:         mnames += list(map(lambda x: x[-4],\n578:                            re.findall(r'((An? )|(The )( *))([a-zA-Z ]+) is ((killed)|(destroyed))\\!', self.message)))\n579:         mnames = list(filter(lambda name: 'invisible' not in name and name != 'it' and not name.startswith('poor '),\n580:                              mnames))\n581:         mnames = list(map(lambda name: name[len('saddled '):] if name.startswith('saddled ') else name,\n582:                           mnames))\n583:         mnames = list(filter(lambda name: name[0].lower() == name[0],\n584:                              mnames))\n585: \n586:         level = self.current_level()\n587: \n588:         if not self.character.prop.hallu and mnames:\n589:             old_mons = self._previous_glyphs.copy()\n590:             old_mons[~utils.isin(self._previous_glyphs, G.MONS, G.INVISIBLE_MON)] = -1\n591:             new_mons = self.glyphs.copy()\n592:             new_mons[~utils.isin(self.glyphs, G.MONS, G.INVISIBLE_MON)] = -1\n593:             mask = disappearance_mask(old_mons, new_mons, 1)\n594:             mons = old_mons.copy()\n595:             mons[~mask] = -1\n596: \n597:             assert mons.any()\n598: \n599:             for mname in mnames:\n600:                 glyph = MON.from_name(mname)\n601:                 monster_id = glyph - nh.GLYPH_MON_OFF\n602:                 corpse_glyph = MON.body_from_name(mname)\n603:                 for y, x in zip(*utils.isin(mons, [glyph]).nonzero()):\n604:                     # TODO: it works because level.items is updated in `inventory.check_items`\n605:                     if all(map(lambda item: item.is_corpse() and item.monster_id != monster_id, level.items[y, x])):\n606:                         level.corpses_to_eat[y, x][monster_id] = self.blstats.time\n607: \n608:         old_possible_corpses = level.corpses_to_eat[self.blstats.y, self.blstats.x].copy()\n609:         del level.corpses_to_eat[self.blstats.y, self.blstats.x]\n610: \n611:         corpses = Counter((item for item in self.inventory.items_below_me if item.is_corpse()))\n612:         for item, count in corpses.items():\n613:             if count != 1:\n614:                 continue\n615: \n616:             level.corpses_to_eat[self.blstats.y, self.blstats.x][item.monster_id] = \\\n617:                 old_possible_corpses[item.monster_id]\n618: \n619:     def update_level(self):\n620:         if utils.isin(self.glyphs, G.SWALLOW).any():\n621:             return\n622: \n623:         if utils.any_in(self.glyphs, G.PETS):\n624:             self._last_pet_seen = self.blstats.time\n625: \n626:         level = self.current_level()\n627: \n628:         mask = utils.isin(self.glyphs, G.FLOOR, G.STAIR_UP, G.STAIR_DOWN, G.DOOR_OPENED, G.TRAPS,\n629:                           G.ALTAR, G.FOUNTAIN)\n630:         level.walkable[mask] = True\n631:         level.seen[mask] = True\n632:         level.objects[mask] = self.glyphs[mask]\n633: \n634:         mask = utils.isin(self.glyphs, G.MONS, G.PETS, G.BODIES, G.OBJECTS, G.STATUES)\n635:         level.seen[mask] = True\n636:         level.walkable[mask & (level.objects == -1)] = True\n637: \n638:         mask = utils.isin(self.glyphs, G.WALL, G.DOOR_CLOSED, G.BARS)\n639:         level.seen[mask] = True\n640:         level.objects[mask] = self.glyphs[mask]\n641:         level.walkable[mask] = False\n642: \n643:         self._update_level_items()\n644:         self._update_level_shops()\n645:         self._update_level_corpses()\n646: \n647:         for y, x in zip(*utils.isin(level.objects, G.ALTAR).nonzero()):\n648:             if (y, x) not in level.altars:\n649:                 level.altars[y, x] = Character.UNKNOWN\n650: \n651:         level.was_on[self.blstats.y, self.blstats.x] = True\n652: \n653:         for y, x in self.neighbors(self.blstats.y, self.blstats.x, shuffle=False):\n654:             if self.glyphs[y, x] in G.STONE:\n655:                 level.seen[y, x] = True\n656:                 level.objects[y, x] = self.glyphs[y, x]\n657:                 level.walkable[y, x] = False  # necessary for the exit route from vaults\n658: \n659:         # ad aerarium -- avoid valut entrance\n660:         if self.inventory.engraving_below_me and nltk.edit_distance(self.inventory.engraving_below_me,\n661:                                                                     \"ad aerarium\") <= 6:\n662:             self.stats_logger.log_event('ad_aerarium_below_me')\n663:             for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n664:                 y, x = self.blstats.y + dy, self.blstats.x + dx\n665:                 if (0 <= y < level.forbidden.shape[0] and 0 <= x < level.forbidden.shape[1]) \\\n666:                         and not level.walkable[y, x]:\n667:                     level.forbidden[y, x] = True\n668: \n669:     ######## TRIVIAL HELPERS\n670: \n671:     def current_level(self):\n672:         key = (self.blstats.dungeon_number, self.blstats.level_number)\n673:         if key not in self.levels:\n674:             self.levels[key] = Level(*key)\n675:         return self.levels[key]\n676: \n677:     @staticmethod\n678:     def calc_direction(from_y, from_x, to_y, to_x, allow_nonunit_distance=False):\n679:         if allow_nonunit_distance:\n680:             assert from_y == to_y or from_x == to_x or \\\n681:                    abs(from_y - to_y) == abs(from_x - to_x), ((from_y, from_x), (to_y, to_x))\n682:             to_y = from_y + np.sign(to_y - from_y)\n683:             to_x = from_x + np.sign(to_x - from_x)\n684: \n685:         assert abs(from_y - to_y) <= 1 and abs(from_x - to_x) <= 1, ((from_y, from_x), (to_y, to_x))\n686: \n687:         ret = ''\n688:         if to_y == from_y + 1: ret += 's'\n689:         if to_y == from_y - 1: ret += 'n'\n690:         if to_x == from_x + 1: ret += 'e'\n691:         if to_x == from_x - 1: ret += 'w'\n692:         if ret == '': ret = '.'\n693: \n694:         return ret\n695: \n696:     ######## TRIVIAL ACTIONS\n697: \n698:     def check_terrain(self, force):\n699:         if force or self._last_terrain_check is None or self.blstats.time - self._last_terrain_check > 50:\n700:             self._last_terrain_check = self.blstats.time\n701:             with self.atom_operation():\n702:                 self.type_text('#te')\n703:                 self.step(A.MiscAction.MORE, iter('b'))\n704:                 self.update_level()\n705:                 self.step(A.Command.ESC)\n706: \n707:     def wield_best_melee_weapon(self):\n708:         # TODO: move to inventory\n709:         item = self.inventory.get_best_melee_weapon()\n710:         if item != self.inventory.items.main_hand:\n711:             return self.inventory.wield(item)\n712:         return False\n713: \n714:     def type_text(self, text):\n715:         with self.atom_operation():\n716:             for char in text:\n717:                 self.step(char)\n718: \n719:     def untrap(self, trap_y, trap_x):\n720:         with self.atom_operation():\n721:             self.type_text('#u')\n722:             self.step(A.MiscAction.MORE)\n723:             assert self.single_message == \"In what direction?\", self.single_message\n724:             self.direction(trap_y, trap_x)\n725:             if self.single_message == 'You know of no traps there.':\n726:                 # assert 0, \"Trying to untrap already untraped trap\"\n727:                 return True\n728:             if self.single_message == 'You disarm the trap.':\n729:                 self.stats_logger.log_event('untrap_success')\n730:                 return True\n731:             return False\n732: \n733:     def untrap_container_below_me(self):\n734:         \"\"\" Return None if succesfull else fail message \"\"\"\n735:         with self.atom_operation():\n736:             self.type_text('#u')\n737:             self.step(A.MiscAction.MORE)\n738:             assert self.single_message == \"In what direction?\", self.single_message\n739:             self.type_text('.')\n740:             if 'too busy' in self.message:\n741:                 return 'hands busy'\n742:             if 'There is a container and a ' in self.message:\n743:                 self.type_text('n')\n744:             if 'You know of no traps there.' in self.message:\n745:                 raise AgentPanic('no container below me to untrap')\n746:             if 'There is a container and ' in self.message and \\\n747:                     (' trap here.' in self.message or ' field here.' in self.message) and \\\n748:                     ('trap?' in self.message or 'field?' in self.message):\n749:                 self.type_text('n')\n750:             if 'You cannot disable this trap.' in self.single_message:\n751:                 return\n752:             assert 'Check it for traps?' in self.single_message, self.single_message\n753:             self.type_text('y')\n754:             if self.message.startswith('You find no traps on the'):\n755:                 return\n756:             assert 'Disarm it?' in self.message, self.message\n757:             self.type_text('y')\n758:             if 'You disarm it!' in self.message:\n759:                 self.stats_logger.log_event('container_untrap_success')\n760:                 return\n761:             self.stats_logger.log_event('container_untrap_fail')\n762:             return self.message\n763: \n764:     def critically_low_hp(self):\n765:         \"\"\"NetHack 3.6 pray.c critically_low_hp(): low HP counts as major trouble.\"\"\"\n766:         hp, max_hp, level = self.blstats.hitpoints, self.blstats.max_hitpoints, self.blstats.experience_level\n767:         max_hp = min(max_hp, 15 * level)\n768:         divisor = 5 if level <= 5 else 6 if level <= 13 else 7 if level <= 21 else 8 if level <= 29 else 9\n769:         if not PRAY_AT_EXACT_THRESHOLD:\n770:             divisor, max_hp = 7, self.blstats.max_hitpoints\n771:         return hp <= 5 or hp * divisor <= max_hp\n772: \n773:     def is_safe_to_pray(self, limit=500):\n774:         # the prayer timeout starts at 300 and drops by one a turn; major trouble is fixed once it is\n775:         # at most 200, so the first prayer is safe from about turn 100 (not 300: a diver is long dead)\n776:         if self.prayer_failed:\n777:             return False\n778:         return (\n779:                 (self.last_prayer_turn is None and self.blstats.time > 110) or\n780:                 (self.last_prayer_turn is not None and self.blstats.time - self.last_prayer_turn > limit)\n781:         )\n782: \n783:     def pray(self):\n784:         self.step(A.Command.PRAY)\n785:         self.last_prayer_turn = self.blstats.time\n786:         if any(s in self.message for s in PRAYER_FAILED_MESSAGES):\n787:             self.prayer_failed = True\n788:         # TODO: return value\n789:         return True\n790: \n791:     def open_door(self, y, x):\n792:         with self.panic_if_position_changes():\n793:             assert self.glyphs[y, x] in G.DOOR_CLOSED\n794:             self.direction(y, x)\n795:             self.current_level().door_open_count[y, x] += 1\n796:             return self.glyphs[y, x] not in G.DOOR_CLOSED\n797: \n798:     def melee_attack(self, y, x):\n799:         with self.panic_if_position_changes():\n800:             assert self.glyphs[y, x] in G.MONS or self.glyphs[y, x] in G.INVISIBLE_MON or \\\n801:                    self.glyphs[y, x] in G.SWALLOW\n802:             self.direction(y, x)\n803:         return True\n804: \n805:     def zap(self, item, direction):\n806:         letter = self.inventory.items.get_letter(item)\n807:         with self.atom_operation():\n808:             self.step(A.Command.ZAP)\n809:             self.type_text(letter)\n810:             self.direction(direction)\n811:         if 'Nothing happens' in self.message or 'You wrest' in self.message:\n812:             # an empty wand: zapping it again in the next crisis wastes the turn that kills us\n813:             self._empty_wand_letters.add(letter)\n814:         return True\n815: \n816:     def wand_is_empty(self, item):\n817:         return self.inventory.items.get_letter(item) in self._empty_wand_letters\n818: \n819:     def fire(self, item, direction):\n820:         if self.character.prop.polymorph:\n821:             # TODO: throwing is not possible if you don't have hands\n822:             # it may be possible depending on creature\n823:             return False\n824: \n825:         with self.atom_operation():\n826:             self.step(A.Command.THROW)\n827:             self.type_text(self.inventory.items.get_letter(item))\n828:             self.direction(direction)\n829:         return True\n830: \n831:     def cast(self, spell_name, direction):\n832:         with self.atom_operation():\n833:             dy, dx = direction\n834:             direction = self.calc_direction(self.blstats.y, self.blstats.x, self.blstats.y + dy, self.blstats.x + dx)\n835:             success = [False]\n836: \n837:             def type_letters():\n838:                 # while f'{letter} - ' not in '\\n'.join(self.single_popup):\n839:                 #     yield A.TextCharacters.SPACE\n840:                 # if self.single_message.startswith(\"You fail to cast the spell correctly.\"):\n841:                 #     return\n842:                 if 'You are too impaired' in self.message:\n843:                     return\n844:                 yield self.character.known_spells[spell_name]\n845:                 for _ in range(3):\n846:                     if 'In what direction?' in self.message:\n847:                         break\n848:                     yield ' '\n849:                 if 'In what direction?' in self.message:\n850:                     success[0] = True\n851:                     # hypothesis: the direction used to be typed as raw keys, and with vi-keys 'n' is\n852:                     # south-east, 's' is \"at yourself\", 'e'/'w' are no direction and 'ne' etc. is two keys\n853:                     # (an assert), so a wizard's force bolt aimed at a monster hit its own pet (the god\n854:                     # is angered and the Dlvl 1 grind loses its prayer food) or bashed the wizard itself.\n855:                     # Sending the compass action makes the bolt go where it was aimed.\n856:                     yield {\n857:                         'n': A.CompassDirection.N, 's': A.CompassDirection.S,\n858:                         'e': A.CompassDirection.E, 'w': A.CompassDirection.W,\n859:                         'ne': A.CompassDirection.NE, 'se': A.CompassDirection.SE,\n860:                         'nw': A.CompassDirection.NW, 'sw': A.CompassDirection.SW,\n861:                         '.': A.MiscDirection.WAIT,\n862:                     }[direction]\n863: \n864:             self.step(A.Command.CAST, type_letters())\n865:             if success[0]:\n866:                 self.stats_logger.log_event(f'cast_{spell_name}')\n867:             else:\n868:                 self.last_cast_fail_turn[spell_name] = self._last_turn\n869:                 self.stats_logger.log_event(f'cast_fail_{spell_name}')\n870: \n871:     def kick(self, y, x=None):\n872:         with self.panic_if_position_changes():\n873:             with self.atom_operation():\n874:                 self.step(A.Command.KICK)\n875:                 self.direction(self.calc_direction(self.blstats.y, self.blstats.x, y, x))\n876: \n877:     def search(self, max_count=1):\n878:         assert max_count >= 1\n879:         with self.panic_if_position_changes():\n880:             with self.atom_operation():\n881:                 if max_count > 1:\n882:                     self.type_text(str(max_count))\n883:                 self.step(A.Command.SEARCH)\n884:                 # TODO: estimate the real number of searches\n885:                 self.current_level().search_count[self.blstats.y, self.blstats.x] += max_count\n886:                 if 'You find ' in self.message:\n887:                     self.check_terrain(force=True)\n888:         return True\n889: \n890:     def direction(self, y, x=None):\n891:         if x is not None:\n892:             dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n893:         else:\n894:             dir = y\n895: \n896:         action = {\n897:             'n': A.CompassDirection.N, 's': A.CompassDirection.S,\n898:             'e': A.CompassDirection.E, 'w': A.CompassDirection.W,\n899:             'ne': A.CompassDirection.NE, 'se': A.CompassDirection.SE,\n900:             'nw': A.CompassDirection.NW, 'sw': A.CompassDirection.SW,\n901:             '>': A.MiscDirection.DOWN, '<': A.MiscDirection.UP,\n902:             '.': A.MiscDirection.WAIT,\n903:         }[dir]\n904: \n905:         self.step(action)\n906:         return True\n907: \n908:     def move(self, y, x=None):\n909:         if x is not None:\n910:             dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n911:         else:\n912:             dir = y\n913: \n914:         expected_y = self.blstats.y + ('s' in dir) - ('n' in dir)\n915:         expected_x = self.blstats.x + ('e' in dir) - ('w' in dir)\n916: \n917:         if (expected_y != self.blstats.y or expected_x != self.blstats.x) \\\n918:                 and self.monster_tracker.monster_mask[expected_y, expected_x]:\n919:             # TODO: consider handling it in different way, since this situation is sometimes expected\n920:             raise AgentPanic(f'Monster on a next tile when moving: ({expected_y},{expected_x})')\n921: \n922:         # TODO: portals\n923:         if dir in ['<', '>']:\n924:             level = self.current_level()\n925:             with self.atom_operation():\n926:                 self.direction(dir)\n927:                 assert self.current_level().key() != level.key(), self.message\n928:                 level.stair_destination[expected_y, expected_x] = \\\n929:                     (self.current_level().key(), (self.blstats.y, self.blstats.x))\n930:                 # TODO: one way portals (elemental and astral planes)\n931:                 self.current_level().stair_destination[\n932:                     (self.blstats.y, self.blstats.x)] = (level.key(), (expected_y, expected_x))\n933: \n934:         else:\n935:             self.direction(dir)\n936: \n937:             if self.blstats.y != expected_y or self.blstats.x != expected_x:\n938:                 raise AgentPanic(f'agent position do not match after \"move\": '\n939:                                  f'expected ({expected_y}, {expected_x}), got ({self.blstats.y}, {self.blstats.x})')\n940: \n941:     def can_engrave(self):\n942:         if self.character.prop.polymorph:\n943:             return False  # TODO: only for handless monsters (which cannot write)\n944:         return (self.blstats.y, self.blstats.x) != self._forbidden_engrave_position\n945: \n946:     def engrave(self, text):\n947:         assert '\\r' not in text\n948:         ret = False\n949: \n950:         def gen():\n951:             nonlocal ret\n952:             if 'What do you want to write with?' not in self.single_message:\n953:                 self._forbidden_engrave_position = (self.blstats.y, self.blstats.x)\n954:                 yield A.Command.ESC\n955:                 return\n956:             yield '-'\n957:             if 'Do you want to add to the current engraving?' in self.single_message:\n958:                 yield 'n'\n959:             while self._observation['misc'][2]:\n960:                 yield ' '\n961:             if 'What do you want to write in the dust here?' not in self.single_message:\n962:                 self._forbidden_engrave_position = (self.blstats.y, self.blstats.x)\n963:                 yield A.Command.ESC\n964:                 return\n965:             yield from text\n966:             yield '\\r'\n967:             ret = True\n968: \n969:         with self.atom_operation():\n970:             self.step(A.Command.ENGRAVE, gen())\n971:             self.inventory.get_items_below_me()\n972: \n973:         if ret and text.lower() == 'elbereth':\n974:             self.stats_logger.log_event('elbereth_write')\n975:         return ret\n976: \n977:     ######## NON-TRIVIAL HELPERS\n978: \n979:     def neighbors(self, y, x, shuffle=True, diagonal=True):\n980:         ret = []\n981:         for dy in [-1, 0, 1]:\n982:             for dx in [-1, 0, 1]:\n983:                 if dy == 0 and dx == 0:\n984:                     continue\n985:                 if not diagonal and abs(dy) + abs(dx) > 1:\n986:                     continue\n987:                 ny = y + dy\n988:                 nx = x + dx\n989:                 if 0 <= ny < C.SIZE_Y and 0 <= nx < C.SIZE_X:\n990:                     ret.append((ny, nx))\n991: \n992:         if shuffle:\n993:             self.rng.shuffle(ret)\n994:             pass\n995: \n996:         return ret\n997: \n998:     def bfs(self, y=None, x=None, can_squeeze=None):\n999:         if y is None:\n1000:             y = self.blstats.y\n1001:         if x is None:\n1002:             x = self.blstats.x\n1003:         default_squeeze = can_squeeze is None\n1004: \n1005:         if default_squeeze and self.last_bfs_step == self.step_count and \\\n1006:                 y == self.blstats.y and x == self.blstats.x:\n1007:             return self.last_bfs_dis.copy()\n1008: \n1009:         level = self.current_level()\n1010: \n1011:         walkable = level.walkable & ~utils.isin(self.glyphs, G.BOULDER) & \\\n1012:                    ~self.monster_tracker.peaceful_monster_mask & \\\n1013:                    ~level.forbidden\n1014: \n1015:         if self._last_turn - self._allow_walking_through_traps_turn > 50:\n1016:             walkable &= ~utils.isin(level.objects, G.TRAPS)\n1017: \n1018:         for my, mx in list(zip(*np.nonzero(utils.isin(self.glyphs, G.MONS)))):\n1019:             mon = MON.permonst(self.glyphs[my][mx])\n1020:             if mon.mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS:\n1021:                 walkable[my, mx] = False\n1022: \n1023:         dis = utils.bfs(y, x,\n1024:                         walkable=walkable,\n1025:                         walkable_diagonally=walkable & ~utils.isin(level.objects, G.DOORS) & (level.objects != -1),\n1026:                         can_squeeze=(self.inventory.items.total_weight <= 600 if default_squeeze else can_squeeze) and \\\n1027:                                     self.current_level().dungeon_number != Level.SOKOBAN,\n1028:                         )\n1029: \n1030:         if default_squeeze and y == self.blstats.y and x == self.blstats.x:\n1031:             self.last_bfs_dis = dis\n1032:             self.last_bfs_step = self.step_count\n1033: \n1034:         return dis.copy()\n1035: \n1036:     def path(self, from_y, from_x, to_y, to_x, dis=None):\n1037:         if from_y == to_y and from_x == to_x:\n1038:             return [(to_y, to_x)]\n1039: \n1040:         if dis is None:\n1041:             dis = self.bfs(from_y, from_x)\n1042: \n1043:         assert dis[to_y, to_x] != -1\n1044: \n1045:         # FIXME: currently the path can lead through diagonally inwalkable tiles.\n1046:         #        The path is the shortest possible, so the agent is guaranteed to\n1047:         #        unstuck itself eventually (usually a few panic exceptions) if that happens\n1048: \n1049:         cur_y, cur_x = to_y, to_x\n1050:         path_rev = [(cur_y, cur_x)]\n1051:         while cur_y != from_y or cur_x != from_x:\n1052:             for y, x in self.neighbors(cur_y, cur_x):\n1053:                 if dis[y, x] == dis[cur_y, cur_x] - 1 and dis[y, x] >= 0:\n1054:                     path_rev.append((y, x))\n1055:                     cur_y, cur_x = y, x\n1056:                     break\n1057:             else:\n1058:                 assert 0\n1059: \n1060:         assert dis[cur_y, cur_x] == 0 and from_y == cur_y and from_x == cur_x\n1061:         path = path_rev[::-1]\n1062:         assert path[0] == (from_y, from_x) and path[-1] == (to_y, to_x)\n1063:         return path\n1064: \n1065:     ######## NON-TRIVIAL ACTIONS\n1066: \n1067:     def _fast_go_to(self, y, x):\n1068:         with self.atom_operation():\n1069:             self.step(A.Command.TRAVEL)\n1070:             py, px = self.cursor_pos\n1071:             while py != y or px != x:\n1072:                 dy, dx = np.sign(y - py), np.sign(x - px)\n1073:                 self.direction(self.calc_direction(py, px, py + dy, px + dx))\n1074:                 py += dy\n1075:                 px += dx\n1076:                 assert (py, px) == self.cursor_pos\n1077:             self.direction('.')\n1078: \n1079:         if (self.blstats.y, self.blstats.x) == (y, x):\n1080:             return True\n1081: \n1082:     def go_to(self, y, x, stop_one_before=False, max_steps=None,\n1083:               debug_tiles_args=None, callback=lambda: False, fast=False):\n1084:         assert not stop_one_before or (self.blstats.y != y or self.blstats.x != x)\n1085:         assert max_steps is None or not fast\n1086: \n1087:         if stop_one_before and self.bfs()[y, x] == -1:\n1088:             dis = self.bfs()\n1089:             best_p = None\n1090:             for ny, nx in self.neighbors(y, x):\n1091:                 if dis[ny, nx] != -1 and (best_p is None or dis[best_p] > dis[ny, nx]):\n1092:                     best_p = ny, nx\n1093:             if best_p is None:\n1094:                 assert 0, 'no reachable neighbor'\n1095:             y, x = best_p\n1096:             stop_one_before = False\n1097: \n1098:         assert self.bfs()[y, x] != -1\n1099: \n1100:         if callback():\n1101:             return\n1102:         steps_taken = 0\n1103:         cont = True\n1104:         while cont and (self.blstats.y, self.blstats.x) != (y, x):\n1105:             dis = self.bfs()\n1106:             if dis[y, x] == -1:\n1107:                 raise AgentPanic('end point is no longer accessible')\n1108:             path = self.path(self.blstats.y, self.blstats.x, y, x)\n1109:             orig_path = path\n1110:             path = path[1:]\n1111:             if stop_one_before:\n1112:                 path = path[:-1]\n1113: \n1114:             if fast and len(path) > 2:\n1115:                 my_y, my_x = self.blstats.y, self.blstats.x\n1116:                 self._fast_go_to(*path[-1])\n1117:                 if (my_y, my_x) != (self.blstats.y, self.blstats.x):\n1118:                     continue\n1119: \n1120:             with self.env.debug_tiles(orig_path, **debug_tiles_args) \\\n1121:                     if debug_tiles_args is not None else contextlib.suppress():\n1122:                 for y, x in path:\n1123:                     if self.monster_tracker.peaceful_monster_mask[y, x]:\n1124:                         cont = True\n1125:                         break\n1126:                     if not self.current_level().walkable[y, x]:\n1127:                         cont = True\n1128:                         break\n1129:                     self.move(y, x)\n1130:                     if callback():\n1131:                         return\n1132:                     steps_taken += 1\n1133:                     if max_steps is not None and steps_taken >= max_steps:\n1134:                         cont = False\n1135:                         break\n1136:                 else:\n1137:                     cont = False\n1138: \n1139:     ######## LOW-LEVEL STRATEGIES\n1140: \n1141:     def get_visible_monsters(self):\n1142:         \"\"\" Returns list of tuples (distance, y, x, permonst, monster_glyph)\n1143:         \"\"\"\n1144:         mask = self.monster_tracker.monster_mask & ~self.monster_tracker.peaceful_monster_mask\n1145:         if not mask.any():\n1146:             return []\n1147: \n1148:         dis = self.bfs()\n1149:         ret = []\n1150:         for y, x in zip(*mask.nonzero()):\n1151:             if (dis[max(y - 1, 0):y + 2, max(x - 1, 0):x + 2] != -1).any():\n1152:                 if self.glyphs[y, x] == nh.GLYPH_INVISIBLE or \\\n1153:                         not MON.is_monster(self.glyphs[y, x]):  # TODO: some ghost are not visible in glyphs (?)\n1154:                     if utils.adjacent((self.blstats.y, self.blstats.x), (y, x)):\n1155:                         class dummy_permonst:\n1156:                             mname = 'unknown'\n1157:                             mlet = '0'\n1158:                             mmove = 12\n1159: \n1160:                         ret.append((dis[y][x], y, x, dummy_permonst(), self.glyphs[y][x]))\n1161:                 else:\n1162:                     ret.append((dis[y][x], y, x, MON.permonst(self.glyphs[y][x]), self.glyphs[y][x]))\n1163:         ret.sort()\n1164:         return ret\n1165: \n1166:     @utils.debug_log('fight2')\n1167:     @Strategy.wrap\n1168:     def fight2(self):\n1169:         yielded = False\n1170:         wait_counter = 0\n1171:         while 1:\n1172:             monsters = self.get_visible_monsters()\n1173:             allow_attack_all = self._last_turn - self._allow_attack_all_turn < 3\n1174:             only_ranged_slow_monsters = all([monster[3].mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS\n1175:                                              and not combat.monster_utils.consider_melee_only_ranged_if_hp_full(self,\n1176:                                                                                                                 monster)\n1177:                                              for monster in monsters])\n1178: \n1179:             dis = self.bfs()\n1180: \n1181:             if not monsters or all(dis > 7 for dis, *_ in monsters) or \\\n1182:                     (only_ranged_slow_monsters and not self.inventory.get_ranged_combinations()\n1183:                      and np.sum(dis != -1) > 1 and not allow_attack_all):\n1184:                 if wait_counter:\n1185:                     self.search()\n1186:                     wait_counter -= 1\n1187:                     continue\n1188:                 if not yielded:\n1189:                     yield False\n1190:                 return\n1191: \n1192:             if not yielded:\n1193:                 yielded = True\n1194:                 yield True\n1195:                 self.character.parse_enhance_view()\n1196:                 # only parse spells in the deep phase so the early level-1 grind (and its RNG) is\n1197:                 # left exactly as the parent plays it; this is what keeps the strong runs intact\n1198:                 if self.blstats.experience_level >= 8 or self.character.role in (Character.WIZARD, Character.MONK):\n1199:                     self.character.parse_spellcast_view()\n1200: \n1201:             move_priority_heatmap, actions = combat.fight_heur.get_priorities(self)\n1202:             actions.extend(combat.fight_heur.get_move_actions(self, dis, move_priority_heatmap))\n1203: \n1204:             if self.character.prop.polymorph:\n1205:                 actions = list(filter(lambda x: x[1][0] != 'ranged', actions))\n1206:             actions = [a for a in actions if not self._touch_petrifies(a[1])]\n1207: \n1208:             actions = [a for a in actions if not self._touch_petrifies(a[1])]\n1209: \n1210:             if allow_attack_all:\n1211:                 attack_actions = [a for a in actions if a[1][0] in ('melee', 'kick', 'ranged', 'zap', 'force_bolt')]\n1212:                 if attack_actions:\n1213:                     actions = attack_actions\n1214: \n1215:             if not actions:\n1216:                 assert 0, 'No possible action available during fight2'\n1217: \n1218:             priority, best_action = max(actions, key=lambda x: x[0]) if actions else None\n1219: \n1220:             with self.env.debug_tiles(move_priority_heatmap, color='turbo', is_heatmap=True):\n1221:                 actions_str = '|'.join([combat.utils.action_str(self, a) for a in sorted(actions, key=lambda x: x[0])])\n1222:                 with self.env.debug_log(actions_str):\n1223:                     wait_counter = self._fight2_perform_action(best_action, wait_counter)\n1224: \n1225:     def _touch_petrifies(self, action):\n1226:         # hitting a cockatrice bare-handed (Monk martial arts) or kicking it\n1227:         # barefoot turns you to stone on the spot\n1228:         if action[0] not in ('melee', 'kick'):\n1229:             return False\n1230:         _, dy, dx = action\n1231:         glyph = self.glyphs[self.blstats.y + dy, self.blstats.x + dx]\n1232:         if glyph not in G.MONS or MON.permonst(glyph).mname not in ('cockatrice', 'chickatrice'):\n1233:             return False\n1234:         if action[0] == 'kick':\n1235:             return self.inventory.items.boots is None\n1236:         return self.inventory.items.gloves is None and self.inventory.items.main_hand is None\n1237: \n1238:     def _fight2_perform_action(self, best_action, wait_counter):\n1239:         if best_action[0] == 'move':\n1240:             _, dy, dx = best_action\n1241:             target_y, target_x = self.blstats.y + dy, self.blstats.x + dx\n1242:             with self.env.debug_tiles([[self.blstats.y, self.blstats.x],\n1243:                                        [target_y, target_x]], color=(0, 255, 0), is_path=True):\n1244:                 wait_counter = 5\n1245:                 self.move(target_y, target_x)\n1246:                 return wait_counter\n1247:         elif best_action[0] == 'melee':\n1248:             _, dy, dx = best_action\n1249:             target_y = self.blstats.y + dy\n1250:             target_x = self.blstats.x + dx\n1251:             if self.wield_best_melee_weapon():\n1252:                 return wait_counter\n1253:             with self.env.debug_tiles([[self.blstats.y, self.blstats.x],\n\n(Output capped at 50 KB. Showing lines 1-1253. Use offset=1254 to continue.)\n</content>","metadata":{"preview":"import contextlib\nimport re\nfrom collections import namedtuple, Counter, defaultdict\nfrom functools import partial\n\nimport nle.nethack as nh\nimport nltk\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import combat\nfrom . import utils\nfrom .character import Character\nfrom .exceptions import AgentPanic, AgentFinished, AgentChangeStrategy\nfrom .exploration_logic import ExplorationLogic\nfrom .global_logic import GlobalLogic, early_dig_xl\n\n# ablation switches\nCORPSE_MAX_AGE = 30\nPRAY_AT_EXACT_THRESHOLD = True","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/agent.py","text":"import contextlib\nimport re\nfrom collections import namedtuple, Counter, defaultdict\nfrom functools import partial\n\nimport nle.nethack as nh\nimport nltk\nimport numpy as np\nfrom nle.nethack import actions as A\n\nfrom . import combat\nfrom . import utils\nfrom .character import Character\nfrom .exceptions import AgentPanic, AgentFinished, AgentChangeStrategy\nfrom .exploration_logic import ExplorationLogic\nfrom .global_logic import GlobalLogic, early_dig_xl\n\n# ablation switches\nCORPSE_MAX_AGE = 30\nPRAY_AT_EXACT_THRESHOLD = True\nfrom .glyph import MON, C, Hunger, G, SHOP\nfrom .item import Item, flatten_items\nfrom .item.inventory import Inventory\nfrom .level import Level\nfrom .monster_tracker import MonsterTracker, disappearance_mask\nfrom .stats_logger import StatsLogger\nfrom .strategy import Strategy\n\nBLStats = namedtuple('BLStats',\n                     'x y strength_percentage strength dexterity constitution intelligence wisdom charisma score hitpoints max_hitpoints depth gold energy max_energy armor_class monster_level experience_level experience_points time hunger_state carrying_capacity dungeon_number level_number prop_mask alignment')\n\n\n# a hunger prayer waits this many turns after the previous prayer: a timeout drawn from rnz(350)\n# is still above the major-trouble limit (200) ~7% of the time after 900 turns, ~2.5% after 1200\nHUNGER_PRAYER_GAP = 1200\n# ...unless the character has been fainting this long (hunger then drops at 1/10 the rate)\nFAINTING_PRAYER_DEADLINE = 300\n# ...or as soon as a hostile that can move shows up this close while the character is Fainting,\n# provided at least this many turns have passed since the previous prayer\nTHREAT_PRAYER_GAP = 950\nTHREAT_PRAYER_DISTANCE = 6\nPRAYER_FAILED_MESSAGES = ('is displeased', 'Thou hast angered me', 'Thou art arrogant', 'Thou hast strayed',\n                          'Thou durst', 'relearn thy lessons', 'is bummed')\n\n\nclass Agent:\n    def __init__(self, env, seed=0, verbose=False, panic_on_errors=False):\n        self.env = env\n        self.verbose = verbose\n        self.rng = np.random.RandomState(seed)\n        self.panic_on_errors = panic_on_errors\n        self.all_panics = []\n\n        self.on_update = []\n        self.levels = {}\n        self.score = 0\n        self.step_count = 0\n        self._observation = None  # this should be used in additional_action_iterator generators\n        # single_{message,popup} should be used in additional_action_itertator generators.\n        # (non-single) message & popup contain cummulated content\n        self.message = self.single_message = ''\n        self.popup = self.single_popup = []\n        self._message_history = []\n        self.cursor_pos = (0, 0)\n        self.last_observation = None\n\n        self._last_pet_seen = 0\n\n        self.inventory = Inventory(self)\n        self.character = Character(self)\n        self.exploration = ExplorationLogic(self)\n        self.global_logic = GlobalLogic(self)\n        self.monster_tracker = MonsterTracker(self)\n\n        self.last_bfs_dis = None\n        self.last_bfs_step = None\n        self.last_prayer_turn = None\n        self.prayer_failed = False  # the god was angered: every later prayer only smites again\n        self._fainting_since = None\n        self._monk_meat_meals = 0\n        self._previous_glyphs = None\n        self._last_turn = -1\n        self._inactivity_counter = 0\n        self._pass_turn_after_error = False\n        self._is_updating_state = False\n\n        self._no_step_calls = False\n\n        self.turns_in_atom_operation = None\n        self._atom_operation_allow_update = None\n\n        self._is_reading_message_or_popup = False\n        self._last_terrain_check = None\n        self._forbidden_engrave_position = (-1, -1)\n\n        # when (number of turn) there was last decision about allowing these actions (e.g. agent is somewhat stuck)\n        self._allow_walking_through_traps_turn = -float('inf')\n        self._allow_attack_all_turn = -float('inf')\n\n        self.last_cast_fail_turn = defaultdict(lambda: -float('inf'))\n        self._pick_dig_attempts = dict()\n        self._dig_engrave_attempts = dict()\n        self._undiggable_levels = set()  # level keys whose floor refused a dig\n        self._mines_bottom_found = False  # Mines' End reached: no more digging in the Mines\n        self._mapped_levels = set()\n        self._empty_wand_letters = set()  # inventory letters of wands that did nothing when zapped\n\n        self.stats_logger = StatsLogger()\n\n    @property\n    def has_pet(self):\n        return (self.blstats.time - self._last_pet_seen) <= 16\n\n    @property\n    def in_atom_operation(self):\n        return self.turns_in_atom_operation is not None\n\n    ######## CONVENIENCE FUNCTIONS\n\n    @contextlib.contextmanager\n    def disallow_step_calling(self):\n        if self._no_step_calls:\n            yield\n            return\n\n        try:\n            self._no_step_calls = True\n            yield\n        finally:\n            self._no_step_calls = False\n\n    @contextlib.contextmanager\n    def atom_operation(self, allow_update=False):\n        assert not self._no_step_calls\n        if self.turns_in_atom_operation is not None:\n            # already in an atom operation\n            old_allow_update = self._atom_operation_allow_update\n            if old_allow_update is None:\n                self._atom_operation_allow_update = allow_update\n            else:\n                assert old_allow_update or not allow_update\n                self._atom_operation_allow_update = old_allow_update and allow_update\n            try:\n                yield\n            finally:\n                self._atom_operation_allow_update = old_allow_update\n            return\n\n        self.turns_in_atom_operation = 0\n        self._atom_operation_allow_update = allow_update\n        try:\n            yield\n        finally:\n            self.turns_in_atom_operation = None\n            self._atom_operation_allow_update = None\n\n        self.update_state()\n\n    @contextlib.contextmanager\n    def panic_if_position_changes(self):\n        y, x = self.blstats.y, self.blstats.x\n\n        def f(self):\n            if (y, x) != (self.blstats.y, self.blstats.x):\n                raise AgentPanic('position changed')\n\n        fun = partial(f, self)\n\n        self.on_update.append(fun)\n\n        try:\n            yield\n        finally:\n            assert fun in self.on_update\n            self.on_update.pop(self.on_update.index(fun))\n\n    @contextlib.contextmanager\n    def add_on_update(self, funcs):\n        self.on_update.extend(funcs)\n\n        try:\n            yield\n        finally:\n            for f in funcs:\n                self.on_update.pop(self.on_update.index(f))\n\n    @contextlib.contextmanager\n    def context_preempt(self, conditions):\n        ids = []\n        id2fun = {}\n        for cond in conditions:\n            def f(iden, cond=cond):\n                if cond():\n                    raise AgentChangeStrategy(iden, cond)\n\n            fun = partial(f, id(f))\n            assert id(f) not in id2fun\n            id2fun[id(f)] = fun\n            ids.append(id(f))\n            self.on_update.append(fun)\n\n        outcome = None\n        for i, cond in enumerate(conditions):\n            if cond():\n                outcome = i\n                break\n\n        def outcome_f():\n            nonlocal outcome\n            return outcome\n\n        try:\n            yield outcome_f\n\n        except AgentChangeStrategy as e:\n            i = e.args[0]\n            if i not in id2fun:\n                raise\n            outcome = ids.index(i)\n        finally:\n            for f in id2fun.values():\n                self.on_update.pop(self.on_update.index(f))\n\n        # check if less nested ChangeStategy is present\n        self.call_update_functions()\n\n    def preempt(self, strategies, func, first_func=None, continue_after_preemption=True):\n        id2fun = {}\n        for strategy in strategies:\n            def f(iden, strategy):\n                it = strategy.strategy()\n                if next(it):\n                    raise AgentChangeStrategy(iden, it)\n\n            iden = (id(f), id(strategy))\n            fun = partial(f, iden, strategy)\n            assert iden not in id2fun\n            id2fun[iden] = fun\n\n        last_turn = 0\n\n        call_update = True\n\n        val = None\n\n        last_step = self.step_count\n        inactivity_counter = 0\n        is_first = True\n        while 1:\n            inactivity_counter += 1\n            if self.step_count != last_step:\n                last_step = self.step_count\n                inactivity_counter = 0\n            assert inactivity_counter < 5, 'cyclic preempt'\n\n            iterator = None\n            try:\n                with self.add_on_update(list(id2fun.values())):\n                    if call_update:\n                        call_update = False\n                        self.call_update_functions(list(id2fun.values()))\n\n                    f = (first_func or func) if is_first else func\n                    if isinstance(f, Strategy):\n                        val = f.run()\n                    else:\n                        val = f()\n                    break\n\n            except AgentChangeStrategy as e:\n                i = e.args[0]\n                if i not in id2fun:\n                    raise\n                iterator = e.args[1]\n\n            if iterator is not None:\n                try:\n                    next(iterator)\n                    assert 0, iterator\n                except StopIteration:\n                    pass\n\n                if not continue_after_preemption:\n                    break\n\n            is_first = False\n\n        return val\n\n    ######## UPDATE FUNCTIONS\n\n    def on_panic(self):\n        self.check_terrain(force=True)\n        self.inventory.on_panic()\n        self.monster_tracker.on_panic()\n        self.update_state()\n\n    @staticmethod\n    def _find_marker(lines, regex=re.compile(r\"(--More--|\\(end\\)|\\(\\d+ of \\d+\\))\")):\n        \"\"\" Return (line, column) of markers:\n        --More-- | (end) | (X of N)\n        \"\"\"\n        if len(regex.findall(' '.join(lines))) > 1:\n            raise ValueError('Too many markers')\n\n        result, marker_type = None, None\n        for i, line in enumerate(lines):\n            res = regex.findall(line)\n            if res:\n                assert len(res) == 1\n                j = line.find(res[0])\n                result, marker_type = (i, j), res[0]\n                break\n\n        if result is not None and result[1] == 1:\n            result = (result[0], 0)  # e.g. for known items view\n        return result, marker_type\n\n    def get_message_and_popup(self, obs):\n        \"\"\" Uses MORE action to get full popup and/or message.\n        \"\"\"\n\n        message = bytes(obs['message']).decode().replace('\\0', ' ').replace('\\n', '').strip()\n        if message.endswith('--More--'):\n            # FIXME: It seems like in this case the environment doesn't expect additional input,\n            #        but I'm not 100% sure, so it's too risky to change it, because it could stall everything.\n            #        With the current implementation, in the worst case, we'll get \"Unknown command ' '\".\n            message = message[:-len('--More--')]\n\n        # assert '\\n' not in message and '\\r' not in message\n        popup = []\n\n        lines = [bytes(line).decode().replace('\\0', ' ').replace('\\n', '') for line in obs['tty_chars']]\n        marker_pos, marker_type = self._find_marker(lines)\n\n        if marker_pos is None:\n            return message, popup, True\n\n        pref = ''\n        message_lines_count = 0\n        if message:\n            for i, line in enumerate(lines[:marker_pos[0] + 1]):\n                if i == marker_pos[0]:\n                    line = line[:marker_pos[1]]\n                message_lines_count += 1\n                pref += line.strip()\n\n                # I'm not sure when the new line character in broken messages should be a space and when be ignored.\n                # '#' character (and others) occasionally occurs at the beginning of the broken line and isn't in\n                # the message. Sometimes the message on the screen lacks last '.'.\n                replace_func = lambda x: ''.join((c for c in x if c.isalnum()))\n                if replace_func(pref) == replace_func(message):\n                    break\n            else:\n                if marker_pos[0] == 0:\n                    elems1 = [s for s in message.split() if s]\n                    elems2 = [s for s in pref.split() if s]\n                    assert len(elems1) < len(elems2) and elems2[-len(elems1):] == elems1, (elems1, elems2)\n                    return pref, popup, False\n                raise ValueError(f\"Message:\\n{repr(message)}\\ndoesn't match the screen:\\n{repr(pref)}\")\n\n        # cut out popup\n        for l in lines[message_lines_count:marker_pos[0]] + [lines[marker_pos[0]][:marker_pos[1]]]:\n            l = l[marker_pos[1]:].strip()\n            if l:\n                popup.append(l)\n\n        return message, popup, False\n\n    def update_message_and_popup(self, obs):\n        if self._is_reading_message_or_popup:\n            message_prefix = self.message + (' ' if self.message else '')\n            popup_prefix = self.popup\n        else:\n            message_prefix = ''\n            popup_prefix = []\n\n        self.single_message, self.single_popup, done = self.get_message_and_popup(obs)\n        self.single_message = self.single_message.strip()\n        self.single_popup = [p.strip() for p in self.single_popup]\n\n        self.message = message_prefix + self.single_message\n        self.popup = popup_prefix + self.single_popup\n        return done\n\n    def step(self, action, additional_action_iterator=None):\n        if self._no_step_calls:\n            raise ValueError(\"Shouldn't call step now\")\n\n        if isinstance(action, str):\n            assert len(action) == 1\n            action = A.ACTIONS[A.ACTIONS.index(ord(action))]\n        observation, reward, done, info = self.env.step(action)\n        observation = {k: v.copy() for k, v in observation.items()}\n        self.step_count += 1\n        self.score += reward\n\n        self.cursor_pos = (observation['tty_cursor'][0] - 1, observation['tty_cursor'][1])\n\n        if hasattr(self, 'blstats'):\n            for item in flatten_items(self.inventory.items):\n                if item.category == nh.COIN_CLASS:\n                    self.stats_logger.log_gold(item.count)\n            else:\n                self.stats_logger.log_gold(0)\n\n        if done:\n            raise AgentFinished()\n\n        self.update(observation, additional_action_iterator)\n\n    def update(self, observation, additional_action_iterator=None):\n        self._observation = observation\n        done = self.update_message_and_popup(observation)\n\n        self._is_reading_message_or_popup = True\n        if additional_action_iterator is not None:\n            is_next_action = True\n            try:\n                next_action = next(additional_action_iterator)\n            except StopIteration:\n                is_next_action = False\n\n            if is_next_action:\n                self.step(next_action, additional_action_iterator)\n                return\n\n        # FIXME: self.update_state() won't be called on all states sometimes.\n        #        Otherwise there are problems with atomic operations.\n        if not done or observation['misc'][2]:\n            self.step(A.TextCharacters.SPACE)\n            return\n\n        if observation['misc'][1]:  # entering text\n            if \"You may wish for an object.\" in self.message:\n                # TODO: wishing strategy\n                # TODO: assume wished item as blessed\n                self.step('b', iter('lessed greased +2 gray dragon scale mail\\r'))\n                return\n            else:\n                self.step(A.Command.ESC)\n                return\n\n        if 'Where do you want to be teleported?' in self.message:\n            # TODO: teleport control\n            self.step(A.Command.ESC)\n            return\n\n        if b'[yn]' in bytes(observation['tty_chars'].reshape(-1)):\n            self.type_text('y')\n            return\n\n        self._is_reading_message_or_popup = False\n        self._message_history.append(self.message)\n        if len(self._message_history) > 400:\n            del self._message_history[:-200]  # only the last 50 are ever read\n\n        # should_update = True\n\n        # if self.turns_in_atom_operation is not None:\n        #     should_update = False\n        #     # if any([(self.last_observation[key] != observation[key]).any()\n        #     #         for key in ['glyphs', 'blstats', 'inv_strs', 'inv_letters', 'inv_oclasses', 'inv_glyphs']]):\n        #     #     self.turns_in_atom_operation += 1\n        #     # assert self.turns_in_atom_operation in [0, 1]\n\n        if self.last_observation is None:\n            self.last_observation = observation\n            self._previous_glyphs = self.last_observation['glyphs']\n        else:\n            self._previous_glyphs = self.last_observation['glyphs']\n            self.last_observation = observation\n\n        self.blstats = BLStats(*self.last_observation['blstats'])\n        self.glyphs = self.last_observation['glyphs']\n\n        self.stats_logger.log_cumulative_value('max_turns_on_position',\n                                               key=(self.current_level().dungeon_number,\n                                                    self.current_level().level_number,\n                                                    self.blstats.y, self.blstats.x),\n                                               value=self.blstats.time - self._last_turn)\n\n        self._inactivity_counter += 1\n        if self._last_turn != self.blstats.time:\n            self._last_turn = self.blstats.time\n            self._inactivity_counter = 0\n        assert self._inactivity_counter < 200, ('turn inactivity', sorted(set(self._message_history[-50:])))\n\n        self.update_state(allow_update=self._atom_operation_allow_update or not self.in_atom_operation,\n                          allow_callbacks=not self.in_atom_operation)\n\n    def update_state(self, allow_update=True, allow_callbacks=True):\n        assert not self._no_step_calls\n        if self._is_updating_state:\n            return\n        self._is_updating_state = True\n        message = self.message\n        popup = self.popup\n\n        try:\n            if allow_update:\n                # functions that are allowed to call state unchanging steps\n                for func in [self.character.update, self.inventory.update, self.monster_tracker.update,\n                             partial(self.check_terrain, force=False), self.update_level,\n                             self.global_logic.update]:\n                    func()\n                    self.message = message\n                    self.popup = popup\n\n            if allow_callbacks:\n                self.call_update_functions()\n        finally:\n            self._is_updating_state = False\n\n    def call_update_functions(self, funcs=None):\n        if funcs is None:\n            funcs = self.on_update\n        assert all((func in self.on_update for func in funcs))\n\n        with self.disallow_step_calling():\n            for func in funcs:\n                func()\n\n    def _update_level_items(self):\n        level = self.current_level()\n\n        level.items[self.blstats.y, self.blstats.x] = self.inventory.items_below_me\n        level.item_count[self.blstats.y, self.blstats.x] = len(self.inventory.items_below_me)\n\n        # TODO: optimize\n        ignore_mask = utils.isin(self.glyphs, G.MONS, G.PETS)  # TODO: effects, etc\n        item_mask = level.item_count != 0\n        mask = item_mask & ~ignore_mask\n        level.item_disagreement_counter[~mask] = 0\n        for y, x in zip(*mask.nonzero()):\n            if (level.item_count[y, x] >= 2) == ((self.last_observation['specials'][y, x] & nh.MG_OBJPILE) > 0):\n                glyphs = (glyph for item in level.items[y, x] for glyph in item.display_glyphs())\n                if self.glyphs[y, x] in glyphs:\n                    level.item_disagreement_counter[y, x] = 0\n                    continue\n\n            level.item_disagreement_counter[y, x] += 1\n            if level.item_disagreement_counter[y, x] > 3:\n                level.item_disagreement_counter[y, x] = 0\n                level.items[y, x] = ()\n                level.item_count[y, x] = 0\n\n    def _update_level_shops(self):\n        level = self.current_level()\n\n        shop_type = None\n        matches = re.search(f\"Welcome( again)? to [a-zA-Z' ]*({'|'.join(SHOP.name2id.keys())})!\", self.message)\n        if matches is not None:\n            shop_name = matches.groups()[1]\n            assert shop_name in SHOP.name2id, shop_name\n            shop_type = SHOP.name2id[shop_name]\n\n        shopkeepers = list(\n            zip(*(utils.isin(self.glyphs, G.SHOPKEEPER) & self.monster_tracker.peaceful_monster_mask).nonzero()))\n        for y, x in shopkeepers:\n            wall_mask = utils.isin(level.objects, G.WALL)\n            entry = ((utils.translate(wall_mask, 1, 0) & utils.translate(wall_mask, -1, 0)) |\n                     (utils.translate(wall_mask, 0, 1) & utils.translate(wall_mask, 0, -1))) & \\\n                    level.walkable\n            walkable = level.walkable & ~entry\n            mask = utils.bfs(y, x, walkable=walkable, walkable_diagonally=walkable, can_squeeze=False) != -1\n            mask = utils.dilate(mask, radius=1)\n\n            level.shop[mask] = True\n            if mask[self.blstats.y, self.blstats.x] and shop_type is not None:\n                level.shop_type[mask] = shop_type\n            level.shop_interior[mask & ~utils.dilate(entry, radius=1, with_diagonal=False)] = True\n\n    def _update_level_corpses(self):\n        mnames = list(map(lambda x: x[-1],\n                          re.findall(r'((kills?)|(destroys?)) ((an?)|(the) )?([a-zA-Z ]+)\\!', self.message)))\n        mnames += list(map(lambda x: x[-4],\n                           re.findall(r'((An? )|(The )( *))([a-zA-Z ]+) is ((killed)|(destroyed))\\!', self.message)))\n        mnames = list(filter(lambda name: 'invisible' not in name and name != 'it' and not name.startswith('poor '),\n                             mnames))\n        mnames = list(map(lambda name: name[len('saddled '):] if name.startswith('saddled ') else name,\n                          mnames))\n        mnames = list(filter(lambda name: name[0].lower() == name[0],\n                             mnames))\n\n        level = self.current_level()\n\n        if not self.character.prop.hallu and mnames:\n            old_mons = self._previous_glyphs.copy()\n            old_mons[~utils.isin(self._previous_glyphs, G.MONS, G.INVISIBLE_MON)] = -1\n            new_mons = self.glyphs.copy()\n            new_mons[~utils.isin(self.glyphs, G.MONS, G.INVISIBLE_MON)] = -1\n            mask = disappearance_mask(old_mons, new_mons, 1)\n            mons = old_mons.copy()\n            mons[~mask] = -1\n\n            assert mons.any()\n\n            for mname in mnames:\n                glyph = MON.from_name(mname)\n                monster_id = glyph - nh.GLYPH_MON_OFF\n                corpse_glyph = MON.body_from_name(mname)\n                for y, x in zip(*utils.isin(mons, [glyph]).nonzero()):\n                    # TODO: it works because level.items is updated in `inventory.check_items`\n                    if all(map(lambda item: item.is_corpse() and item.monster_id != monster_id, level.items[y, x])):\n                        level.corpses_to_eat[y, x][monster_id] = self.blstats.time\n\n        old_possible_corpses = level.corpses_to_eat[self.blstats.y, self.blstats.x].copy()\n        del level.corpses_to_eat[self.blstats.y, self.blstats.x]\n\n        corpses = Counter((item for item in self.inventory.items_below_me if item.is_corpse()))\n        for item, count in corpses.items():\n            if count != 1:\n                continue\n\n            level.corpses_to_eat[self.blstats.y, self.blstats.x][item.monster_id] = \\\n                old_possible_corpses[item.monster_id]\n\n    def update_level(self):\n        if utils.isin(self.glyphs, G.SWALLOW).any():\n            return\n\n        if utils.any_in(self.glyphs, G.PETS):\n            self._last_pet_seen = self.blstats.time\n\n        level = self.current_level()\n\n        mask = utils.isin(self.glyphs, G.FLOOR, G.STAIR_UP, G.STAIR_DOWN, G.DOOR_OPENED, G.TRAPS,\n                          G.ALTAR, G.FOUNTAIN)\n        level.walkable[mask] = True\n        level.seen[mask] = True\n        level.objects[mask] = self.glyphs[mask]\n\n        mask = utils.isin(self.glyphs, G.MONS, G.PETS, G.BODIES, G.OBJECTS, G.STATUES)\n        level.seen[mask] = True\n        level.walkable[mask & (level.objects == -1)] = True\n\n        mask = utils.isin(self.glyphs, G.WALL, G.DOOR_CLOSED, G.BARS)\n        level.seen[mask] = True\n        level.objects[mask] = self.glyphs[mask]\n        level.walkable[mask] = False\n\n        self._update_level_items()\n        self._update_level_shops()\n        self._update_level_corpses()\n\n        for y, x in zip(*utils.isin(level.objects, G.ALTAR).nonzero()):\n            if (y, x) not in level.altars:\n                level.altars[y, x] = Character.UNKNOWN\n\n        level.was_on[self.blstats.y, self.blstats.x] = True\n\n        for y, x in self.neighbors(self.blstats.y, self.blstats.x, shuffle=False):\n            if self.glyphs[y, x] in G.STONE:\n                level.seen[y, x] = True\n                level.objects[y, x] = self.glyphs[y, x]\n                level.walkable[y, x] = False  # necessary for the exit route from vaults\n\n        # ad aerarium -- avoid valut entrance\n        if self.inventory.engraving_below_me and nltk.edit_distance(self.inventory.engraving_below_me,\n                                                                    \"ad aerarium\") <= 6:\n            self.stats_logger.log_event('ad_aerarium_below_me')\n            for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                y, x = self.blstats.y + dy, self.blstats.x + dx\n                if (0 <= y < level.forbidden.shape[0] and 0 <= x < level.forbidden.shape[1]) \\\n                        and not level.walkable[y, x]:\n                    level.forbidden[y, x] = True\n\n    ######## TRIVIAL HELPERS\n\n    def current_level(self):\n        key = (self.blstats.dungeon_number, self.blstats.level_number)\n        if key not in self.levels:\n            self.levels[key] = Level(*key)\n        return self.levels[key]\n\n    @staticmethod\n    def calc_direction(from_y, from_x, to_y, to_x, allow_nonunit_distance=False):\n        if allow_nonunit_distance:\n            assert from_y == to_y or from_x == to_x or \\\n                   abs(from_y - to_y) == abs(from_x - to_x), ((from_y, from_x), (to_y, to_x))\n            to_y = from_y + np.sign(to_y - from_y)\n            to_x = from_x + np.sign(to_x - from_x)\n\n        assert abs(from_y - to_y) <= 1 and abs(from_x - to_x) <= 1, ((from_y, from_x), (to_y, to_x))\n\n        ret = ''\n        if to_y == from_y + 1: ret += 's'\n        if to_y == from_y - 1: ret += 'n'\n        if to_x == from_x + 1: ret += 'e'\n        if to_x == from_x - 1: ret += 'w'\n        if ret == '': ret = '.'\n\n        return ret\n\n    ######## TRIVIAL ACTIONS\n\n    def check_terrain(self, force):\n        if force or self._last_terrain_check is None or self.blstats.time - self._last_terrain_check > 50:\n            self._last_terrain_check = self.blstats.time\n            with self.atom_operation():\n                self.type_text('#te')\n                self.step(A.MiscAction.MORE, iter('b'))\n                self.update_level()\n                self.step(A.Command.ESC)\n\n    def wield_best_melee_weapon(self):\n        # TODO: move to inventory\n        item = self.inventory.get_best_melee_weapon()\n        if item != self.inventory.items.main_hand:\n            return self.inventory.wield(item)\n        return False\n\n    def type_text(self, text):\n        with self.atom_operation():\n            for char in text:\n                self.step(char)\n\n    def untrap(self, trap_y, trap_x):\n        with self.atom_operation():\n            self.type_text('#u')\n            self.step(A.MiscAction.MORE)\n            assert self.single_message == \"In what direction?\", self.single_message\n            self.direction(trap_y, trap_x)\n            if self.single_message == 'You know of no traps there.':\n                # assert 0, \"Trying to untrap already untraped trap\"\n                return True\n            if self.single_message == 'You disarm the trap.':\n                self.stats_logger.log_event('untrap_success')\n                return True\n            return False\n\n    def untrap_container_below_me(self):\n        \"\"\" Return None if succesfull else fail message \"\"\"\n        with self.atom_operation():\n            self.type_text('#u')\n            self.step(A.MiscAction.MORE)\n            assert self.single_message == \"In what direction?\", self.single_message\n            self.type_text('.')\n            if 'too busy' in self.message:\n                return 'hands busy'\n            if 'There is a container and a ' in self.message:\n                self.type_text('n')\n            if 'You know of no traps there.' in self.message:\n                raise AgentPanic('no container below me to untrap')\n            if 'There is a container and ' in self.message and \\\n                    (' trap here.' in self.message or ' field here.' in self.message) and \\\n                    ('trap?' in self.message or 'field?' in self.message):\n                self.type_text('n')\n            if 'You cannot disable this trap.' in self.single_message:\n                return\n            assert 'Check it for traps?' in self.single_message, self.single_message\n            self.type_text('y')\n            if self.message.startswith('You find no traps on the'):\n                return\n            assert 'Disarm it?' in self.message, self.message\n            self.type_text('y')\n            if 'You disarm it!' in self.message:\n                self.stats_logger.log_event('container_untrap_success')\n                return\n            self.stats_logger.log_event('container_untrap_fail')\n            return self.message\n\n    def critically_low_hp(self):\n        \"\"\"NetHack 3.6 pray.c critically_low_hp(): low HP counts as major trouble.\"\"\"\n        hp, max_hp, level = self.blstats.hitpoints, self.blstats.max_hitpoints, self.blstats.experience_level\n        max_hp = min(max_hp, 15 * level)\n        divisor = 5 if level <= 5 else 6 if level <= 13 else 7 if level <= 21 else 8 if level <= 29 else 9\n        if not PRAY_AT_EXACT_THRESHOLD:\n            divisor, max_hp = 7, self.blstats.max_hitpoints\n        return hp <= 5 or hp * divisor <= max_hp\n\n    def is_safe_to_pray(self, limit=500):\n        # the prayer timeout starts at 300 and drops by one a turn; major trouble is fixed once it is\n        # at most 200, so the first prayer is safe from about turn 100 (not 300: a diver is long dead)\n        if self.prayer_failed:\n            return False\n        return (\n                (self.last_prayer_turn is None and self.blstats.time > 110) or\n                (self.last_prayer_turn is not None and self.blstats.time - self.last_prayer_turn > limit)\n        )\n\n    def pray(self):\n        self.step(A.Command.PRAY)\n        self.last_prayer_turn = self.blstats.time\n        if any(s in self.message for s in PRAYER_FAILED_MESSAGES):\n            self.prayer_failed = True\n        # TODO: return value\n        return True\n\n    def open_door(self, y, x):\n        with self.panic_if_position_changes():\n            assert self.glyphs[y, x] in G.DOOR_CLOSED\n            self.direction(y, x)\n            self.current_level().door_open_count[y, x] += 1\n            return self.glyphs[y, x] not in G.DOOR_CLOSED\n\n    def melee_attack(self, y, x):\n        with self.panic_if_position_changes():\n            assert self.glyphs[y, x] in G.MONS or self.glyphs[y, x] in G.INVISIBLE_MON or \\\n                   self.glyphs[y, x] in G.SWALLOW\n            self.direction(y, x)\n        return True\n\n    def zap(self, item, direction):\n        letter = self.inventory.items.get_letter(item)\n        with self.atom_operation():\n            self.step(A.Command.ZAP)\n            self.type_text(letter)\n            self.direction(direction)\n        if 'Nothing happens' in self.message or 'You wrest' in self.message:\n            # an empty wand: zapping it again in the next crisis wastes the turn that kills us\n            self._empty_wand_letters.add(letter)\n        return True\n\n    def wand_is_empty(self, item):\n        return self.inventory.items.get_letter(item) in self._empty_wand_letters\n\n    def fire(self, item, direction):\n        if self.character.prop.polymorph:\n            # TODO: throwing is not possible if you don't have hands\n            # it may be possible depending on creature\n            return False\n\n        with self.atom_operation():\n            self.step(A.Command.THROW)\n            self.type_text(self.inventory.items.get_letter(item))\n            self.direction(direction)\n        return True\n\n    def cast(self, spell_name, direction):\n        with self.atom_operation():\n            dy, dx = direction\n            direction = self.calc_direction(self.blstats.y, self.blstats.x, self.blstats.y + dy, self.blstats.x + dx)\n            success = [False]\n\n            def type_letters():\n                # while f'{letter} - ' not in '\\n'.join(self.single_popup):\n                #     yield A.TextCharacters.SPACE\n                # if self.single_message.startswith(\"You fail to cast the spell correctly.\"):\n                #     return\n                if 'You are too impaired' in self.message:\n                    return\n                yield self.character.known_spells[spell_name]\n                for _ in range(3):\n                    if 'In what direction?' in self.message:\n                        break\n                    yield ' '\n                if 'In what direction?' in self.message:\n                    success[0] = True\n                    # hypothesis: the direction used to be typed as raw keys, and with vi-keys 'n' is\n                    # south-east, 's' is \"at yourself\", 'e'/'w' are no direction and 'ne' etc. is two keys\n                    # (an assert), so a wizard's force bolt aimed at a monster hit its own pet (the god\n                    # is angered and the Dlvl 1 grind loses its prayer food) or bashed the wizard itself.\n                    # Sending the compass action makes the bolt go where it was aimed.\n                    yield {\n                        'n': A.CompassDirection.N, 's': A.CompassDirection.S,\n                        'e': A.CompassDirection.E, 'w': A.CompassDirection.W,\n                        'ne': A.CompassDirection.NE, 'se': A.CompassDirection.SE,\n                        'nw': A.CompassDirection.NW, 'sw': A.CompassDirection.SW,\n                        '.': A.MiscDirection.WAIT,\n                    }[direction]\n\n            self.step(A.Command.CAST, type_letters())\n            if success[0]:\n                self.stats_logger.log_event(f'cast_{spell_name}')\n            else:\n                self.last_cast_fail_turn[spell_name] = self._last_turn\n                self.stats_logger.log_event(f'cast_fail_{spell_name}')\n\n    def kick(self, y, x=None):\n        with self.panic_if_position_changes():\n            with self.atom_operation():\n                self.step(A.Command.KICK)\n                self.direction(self.calc_direction(self.blstats.y, self.blstats.x, y, x))\n\n    def search(self, max_count=1):\n        assert max_count >= 1\n        with self.panic_if_position_changes():\n            with self.atom_operation():\n                if max_count > 1:\n                    self.type_text(str(max_count))\n                self.step(A.Command.SEARCH)\n                # TODO: estimate the real number of searches\n                self.current_level().search_count[self.blstats.y, self.blstats.x] += max_count\n                if 'You find ' in self.message:\n                    self.check_terrain(force=True)\n        return True\n\n    def direction(self, y, x=None):\n        if x is not None:\n            dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n        else:\n            dir = y\n\n        action = {\n            'n': A.CompassDirection.N, 's': A.CompassDirection.S,\n            'e': A.CompassDirection.E, 'w': A.CompassDirection.W,\n            'ne': A.CompassDirection.NE, 'se': A.CompassDirection.SE,\n            'nw': A.CompassDirection.NW, 'sw': A.CompassDirection.SW,\n            '>': A.MiscDirection.DOWN, '<': A.MiscDirection.UP,\n            '.': A.MiscDirection.WAIT,\n        }[dir]\n\n        self.step(action)\n        return True\n\n    def move(self, y, x=None):\n        if x is not None:\n            dir = self.calc_direction(self.blstats.y, self.blstats.x, y, x)\n        else:\n            dir = y\n\n        expected_y = self.blstats.y + ('s' in dir) - ('n' in dir)\n        expected_x = self.blstats.x + ('e' in dir) - ('w' in dir)\n\n        if (expected_y != self.blstats.y or expected_x != self.blstats.x) \\\n                and self.monster_tracker.monster_mask[expected_y, expected_x]:\n            # TODO: consider handling it in different way, since this situation is sometimes expected\n            raise AgentPanic(f'Monster on a next tile when moving: ({expected_y},{expected_x})')\n\n        # TODO: portals\n        if dir in ['<', '>']:\n            level = self.current_level()\n            with self.atom_operation():\n                self.direction(dir)\n                assert self.current_level().key() != level.key(), self.message\n                level.stair_destination[expected_y, expected_x] = \\\n                    (self.current_level().key(), (self.blstats.y, self.blstats.x))\n                # TODO: one way portals (elemental and astral planes)\n                self.current_level().stair_destination[\n                    (self.blstats.y, self.blstats.x)] = (level.key(), (expected_y, expected_x))\n\n        else:\n            self.direction(dir)\n\n            if self.blstats.y != expected_y or self.blstats.x != expected_x:\n                raise AgentPanic(f'agent position do not match after \"move\": '\n                                 f'expected ({expected_y}, {expected_x}), got ({self.blstats.y}, {self.blstats.x})')\n\n    def can_engrave(self):\n        if self.character.prop.polymorph:\n            return False  # TODO: only for handless monsters (which cannot write)\n        return (self.blstats.y, self.blstats.x) != self._forbidden_engrave_position\n\n    def engrave(self, text):\n        assert '\\r' not in text\n        ret = False\n\n        def gen():\n            nonlocal ret\n            if 'What do you want to write with?' not in self.single_message:\n                self._forbidden_engrave_position = (self.blstats.y, self.blstats.x)\n                yield A.Command.ESC\n                return\n            yield '-'\n            if 'Do you want to add to the current engraving?' in self.single_message:\n                yield 'n'\n            while self._observation['misc'][2]:\n                yield ' '\n            if 'What do you want to write in the dust here?' not in self.single_message:\n                self._forbidden_engrave_position = (self.blstats.y, self.blstats.x)\n                yield A.Command.ESC\n                return\n            yield from text\n            yield '\\r'\n            ret = True\n\n        with self.atom_operation():\n            self.step(A.Command.ENGRAVE, gen())\n            self.inventory.get_items_below_me()\n\n        if ret and text.lower() == 'elbereth':\n            self.stats_logger.log_event('elbereth_write')\n        return ret\n\n    ######## NON-TRIVIAL HELPERS\n\n    def neighbors(self, y, x, shuffle=True, diagonal=True):\n        ret = []\n        for dy in [-1, 0, 1]:\n            for dx in [-1, 0, 1]:\n                if dy == 0 and dx == 0:\n                    continue\n                if not diagonal and abs(dy) + abs(dx) > 1:\n                    continue\n                ny = y + dy\n                nx = x + dx\n                if 0 <= ny < C.SIZE_Y and 0 <= nx < C.SIZE_X:\n                    ret.append((ny, nx))\n\n        if shuffle:\n            self.rng.shuffle(ret)\n            pass\n\n        return ret\n\n    def bfs(self, y=None, x=None, can_squeeze=None):\n        if y is None:\n            y = self.blstats.y\n        if x is None:\n            x = self.blstats.x\n        default_squeeze = can_squeeze is None\n\n        if default_squeeze and self.last_bfs_step == self.step_count and \\\n                y == self.blstats.y and x == self.blstats.x:\n            return self.last_bfs_dis.copy()\n\n        level = self.current_level()\n\n        walkable = level.walkable & ~utils.isin(self.glyphs, G.BOULDER) & \\\n                   ~self.monster_tracker.peaceful_monster_mask & \\\n                   ~level.forbidden\n\n        if self._last_turn - self._allow_walking_through_traps_turn > 50:\n            walkable &= ~utils.isin(level.objects, G.TRAPS)\n\n        for my, mx in list(zip(*np.nonzero(utils.isin(self.glyphs, G.MONS)))):\n            mon = MON.permonst(self.glyphs[my][mx])\n            if mon.mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS:\n                walkable[my, mx] = False\n\n        dis = utils.bfs(y, x,\n                        walkable=walkable,\n                        walkable_diagonally=walkable & ~utils.isin(level.objects, G.DOORS) & (level.objects != -1),\n                        can_squeeze=(self.inventory.items.total_weight <= 600 if default_squeeze else can_squeeze) and \\\n                                    self.current_level().dungeon_number != Level.SOKOBAN,\n                        )\n\n        if default_squeeze and y == self.blstats.y and x == self.blstats.x:\n            self.last_bfs_dis = dis\n            self.last_bfs_step = self.step_count\n\n        return dis.copy()\n\n    def path(self, from_y, from_x, to_y, to_x, dis=None):\n        if from_y == to_y and from_x == to_x:\n            return [(to_y, to_x)]\n\n        if dis is None:\n            dis = self.bfs(from_y, from_x)\n\n        assert dis[to_y, to_x] != -1\n\n        # FIXME: currently the path can lead through diagonally inwalkable tiles.\n        #        The path is the shortest possible, so the agent is guaranteed to\n        #        unstuck itself eventually (usually a few panic exceptions) if that happens\n\n        cur_y, cur_x = to_y, to_x\n        path_rev = [(cur_y, cur_x)]\n        while cur_y != from_y or cur_x != from_x:\n            for y, x in self.neighbors(cur_y, cur_x):\n                if dis[y, x] == dis[cur_y, cur_x] - 1 and dis[y, x] >= 0:\n                    path_rev.append((y, x))\n                    cur_y, cur_x = y, x\n                    break\n            else:\n                assert 0\n\n        assert dis[cur_y, cur_x] == 0 and from_y == cur_y and from_x == cur_x\n        path = path_rev[::-1]\n        assert path[0] == (from_y, from_x) and path[-1] == (to_y, to_x)\n        return path\n\n    ######## NON-TRIVIAL ACTIONS\n\n    def _fast_go_to(self, y, x):\n        with self.atom_operation():\n            self.step(A.Command.TRAVEL)\n            py, px = self.cursor_pos\n            while py != y or px != x:\n                dy, dx = np.sign(y - py), np.sign(x - px)\n                self.direction(self.calc_direction(py, px, py + dy, px + dx))\n                py += dy\n                px += dx\n                assert (py, px) == self.cursor_pos\n            self.direction('.')\n\n        if (self.blstats.y, self.blstats.x) == (y, x):\n            return True\n\n    def go_to(self, y, x, stop_one_before=False, max_steps=None,\n              debug_tiles_args=None, callback=lambda: False, fast=False):\n        assert not stop_one_before or (self.blstats.y != y or self.blstats.x != x)\n        assert max_steps is None or not fast\n\n        if stop_one_before and self.bfs()[y, x] == -1:\n            dis = self.bfs()\n            best_p = None\n            for ny, nx in self.neighbors(y, x):\n                if dis[ny, nx] != -1 and (best_p is None or dis[best_p] > dis[ny, nx]):\n                    best_p = ny, nx\n            if best_p is None:\n                assert 0, 'no reachable neighbor'\n            y, x = best_p\n            stop_one_before = False\n\n        assert self.bfs()[y, x] != -1\n\n        if callback():\n            return\n        steps_taken = 0\n        cont = True\n        while cont and (self.blstats.y, self.blstats.x) != (y, x):\n            dis = self.bfs()\n            if dis[y, x] == -1:\n                raise AgentPanic('end point is no longer accessible')\n            path = self.path(self.blstats.y, self.blstats.x, y, x)\n            orig_path = path\n            path = path[1:]\n            if stop_one_before:\n                path = path[:-1]\n\n            if fast and len(path) > 2:\n                my_y, my_x = self.blstats.y, self.blstats.x\n                self._fast_go_to(*path[-1])\n                if (my_y, my_x) != (self.blstats.y, self.blstats.x):\n                    continue\n\n            with self.env.debug_tiles(orig_path, **debug_tiles_args) \\\n                    if debug_tiles_args is not None else contextlib.suppress():\n                for y, x in path:\n                    if self.monster_tracker.peaceful_monster_mask[y, x]:\n                        cont = True\n                        break\n                    if not self.current_level().walkable[y, x]:\n                        cont = True\n                        break\n                    self.move(y, x)\n                    if callback():\n                        return\n                    steps_taken += 1\n                    if max_steps is not None and steps_taken >= max_steps:\n                        cont = False\n                        break\n                else:\n                    cont = False\n\n    ######## LOW-LEVEL STRATEGIES\n\n    def get_visible_monsters(self):\n        \"\"\" Returns list of tuples (distance, y, x, permonst, monster_glyph)\n        \"\"\"\n        mask = self.monster_tracker.monster_mask & ~self.monster_tracker.peaceful_monster_mask\n        if not mask.any():\n            return []\n\n        dis = self.bfs()\n        ret = []\n        for y, x in zip(*mask.nonzero()):\n            if (dis[max(y - 1, 0):y + 2, max(x - 1, 0):x + 2] != -1).any():\n                if self.glyphs[y, x] == nh.GLYPH_INVISIBLE or \\\n                        not MON.is_monster(self.glyphs[y, x]):  # TODO: some ghost are not visible in glyphs (?)\n                    if utils.adjacent((self.blstats.y, self.blstats.x), (y, x)):\n                        class dummy_permonst:\n                            mname = 'unknown'\n                            mlet = '0'\n                            mmove = 12\n\n                        ret.append((dis[y][x], y, x, dummy_permonst(), self.glyphs[y][x]))\n                else:\n                    ret.append((dis[y][x], y, x, MON.permonst(self.glyphs[y][x]), self.glyphs[y][x]))\n        ret.sort()\n        return ret\n\n    @utils.debug_log('fight2')\n    @Strategy.wrap\n    def fight2(self):\n        yielded = False\n        wait_counter = 0\n        while 1:\n            monsters = self.get_visible_monsters()\n            allow_attack_all = self._last_turn - self._allow_attack_all_turn < 3\n            only_ranged_slow_monsters = all([monster[3].mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS\n                                             and not combat.monster_utils.consider_melee_only_ranged_if_hp_full(self,\n                                                                                                                monster)\n                                             for monster in monsters])\n\n            dis = self.bfs()\n\n            if not monsters or all(dis > 7 for dis, *_ in monsters) or \\\n                    (only_ranged_slow_monsters and not self.inventory.get_ranged_combinations()\n                     and np.sum(dis != -1) > 1 and not allow_attack_all):\n                if wait_counter:\n                    self.search()\n                    wait_counter -= 1\n                    continue\n                if not yielded:\n                    yield False\n                return\n\n            if not yielded:\n                yielded = True\n                yield True\n                self.character.parse_enhance_view()\n                # only parse spells in the deep phase so the early level-1 grind (and its RNG) is\n                # left exactly as the parent plays it; this is what keeps the strong runs intact\n                if self.blstats.experience_level >= 8 or self.character.role in (Character.WIZARD, Character.MONK):\n                    self.character.parse_spellcast_view()\n\n            move_priority_heatmap, actions = combat.fight_heur.get_priorities(self)\n            actions.extend(combat.fight_heur.get_move_actions(self, dis, move_priority_heatmap))\n\n            if self.character.prop.polymorph:\n                actions = list(filter(lambda x: x[1][0] != 'ranged', actions))\n            actions = [a for a in actions if not self._touch_petrifies(a[1])]\n\n            actions = [a for a in actions if not self._touch_petrifies(a[1])]\n\n            if allow_attack_all:\n                attack_actions = [a for a in actions if a[1][0] in ('melee', 'kick', 'ranged', 'zap', 'force_bolt')]\n                if attack_actions:\n                    actions = attack_actions\n\n            if not actions:\n                assert 0, 'No possible action available during fight2'\n\n            priority, best_action = max(actions, key=lambda x: x[0]) if actions else None\n\n            with self.env.debug_tiles(move_priority_heatmap, color='turbo', is_heatmap=True):\n                actions_str = '|'.join([combat.utils.action_str(self, a) for a in sorted(actions, key=lambda x: x[0])])\n                with self.env.debug_log(actions_str):\n                    wait_counter = self._fight2_perform_action(best_action, wait_counter)\n\n    def _touch_petrifies(self, action):\n        # hitting a cockatrice bare-handed (Monk martial arts) or kicking it\n        # barefoot turns you to stone on the spot\n        if action[0] not in ('melee', 'kick'):\n            return False\n        _, dy, dx = action\n        glyph = self.glyphs[self.blstats.y + dy, self.blstats.x + dx]\n        if glyph not in G.MONS or MON.permonst(glyph).mname not in ('cockatrice', 'chickatrice'):\n            return False\n        if action[0] == 'kick':\n            return self.inventory.items.boots is None\n        return self.inventory.items.gloves is None and self.inventory.items.main_hand is None\n\n    def _fight2_perform_action(self, best_action, wait_counter):\n        if best_action[0] == 'move':\n            _, dy, dx = best_action\n            target_y, target_x = self.blstats.y + dy, self.blstats.x + dx\n            with self.env.debug_tiles([[self.blstats.y, self.blstats.x],\n                                       [target_y, target_x]], color=(0, 255, 0), is_path=True):\n                wait_counter = 5\n                self.move(target_y, target_x)\n                return wait_counter\n        elif best_action[0] == 'melee':\n            _, dy, dx = best_action\n            target_y = self.blstats.y + dy\n            target_x = self.blstats.x + dx\n            if self.wield_best_melee_weapon():\n                return wait_counter\n            with self.env.debug_tiles([[self.blstats.y, self.blstats.x],","lineStart":1,"lineEnd":1253,"totalLines":1254,"truncated":true}},"title":"autoascend/agent.py","time":{"start":1790539462024,"end":1790539462034}},"id":"prt_0e477f584001L5rJg3M4LvfPrZ","sessionID":"ses_f1b882f77ffebyKXRbssgjp7gn","messageID":"msg_0e477ec7a001vTwS5vDdI1u24Q"}}
