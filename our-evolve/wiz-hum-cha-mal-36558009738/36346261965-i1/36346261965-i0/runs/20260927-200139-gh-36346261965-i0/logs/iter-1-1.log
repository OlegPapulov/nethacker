_y, target_x, stop_one_before=True, max_steps=1,\n1325:                        debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n1326:             return wait_counter\n1327:         raise NotImplementedError(best_action)\n1328: \n1329:     @utils.debug_log('engulfed_fight')\n1330:     @Strategy.wrap\n1331:     def engulfed_fight(self):\n1332:         if not utils.any_in(self.glyphs, G.SWALLOW):\n1333:             yield False\n1334:         yield True\n1335:         while True:\n1336:             mask = utils.isin(self.glyphs, G.SWALLOW)\n1337:             if not mask.any():\n1338:                 break\n1339:             assert self.melee_attack(*list(zip(*mask.nonzero()))[0])\n1340: \n1341:     def _is_corpse_editable(self, monster_id, age_turn):\n1342:         permonst = MON.permonst(monster_id)\n1343: \n1344:         # TODO: read intrinsics\n1345:         if self.character.race != Character.ORC and permonst.mflags1 & MON.M1_POIS != 0:\n1346:             return False\n1347: \n1348:         # TODO: read intrinsics\n1349:         if permonst.mflags1 & MON.M1_ACID != 0:\n1350:             return False\n1351: \n1352:         if permonst.mflags2 & MON.M2_WERE != 0:\n1353:             return False\n1354: \n1355:         # polymorph\n1356:         if monster_id in [MON.id_from_name(name) for name in ['chameleon', 'doppelganger', 'sandestin']]:\n1357:             return False\n1358: \n1359:         # remove random intrinsic\n1360:         if monster_id in [MON.id_from_name(name) for name in ['disenchanter']]:\n1361:             return False\n1362: \n1363:         # hallucination\n1364:         if monster_id in [MON.id_from_name(name) for name in ['abbot', 'violet fungus', 'yellow mold']]:\n1365:             return False\n1366: \n1367:         # stun\n1368:         if monster_id in [MON.id_from_name(name) for name in ['bat', 'giant bat']]:\n1369:             return False\n1370: \n1371:         # aggravate monster\n1372:         if monster_id in [MON.id_from_name(name) for name in ['dog', 'little dog', 'large dog',\n1373:                                                               'kitten', 'housecat', 'large cat']]:\n1374:             return False\n1375: \n1376:         # teleportitis\n1377:         # if ord(permonst.mlet) in [MON.S_LEPRECHAUN, MON.S_NYMPH]:\n1378:         #     return False\n1379: \n1380:         # petrification\n1381:         if ord(permonst.mlet) == MON.S_COCKATRICE or monster_id == MON.id_from_name('Medusa'):\n1382:             return False\n1383: \n1384:         # temporary prevents movement\n1385:         if ord(permonst.mlet) == MON.S_MIMIC:\n1386:             return False\n1387: \n1388:         # cannibalism\n1389:         race_flag = {\n1390:             Character.HUMAN: MON.M2_HUMAN,\n1391:             Character.DWARF: MON.M2_DWARF,\n1392:             Character.ELF: MON.M2_ELF,\n1393:             Character.GNOME: MON.M2_GNOME,\n1394:             Character.ORC: 0,\n1395:         }[self.character.race]\n1396:         if self.character.role == Character.CAVEMAN:\n1397:             race_flag = 0\n1398:         if permonst.mflags2 & race_flag:\n1399:             return False\n1400: \n1401:         # corpse aging: a corpse turns tainted once (age / (10 + rn2(20))) > 5, and from > 3 it can\n1402:         # blind, confuse or knock you out; the age recorded here is only the kill we saw, so an\n1403:         # older corpse of the same kind on that square passes for fresh. 30 turns keeps even the\n1404:         # worst roll at rotted <= 3.\n1405:         if self.blstats.time - age_turn >= CORPSE_MAX_AGE and \\\n1406:                 monster_id not in [MON.id_from_name('lizard'), MON.id_from_name('lichen')]:\n1407:             return False\n1408: \n1409:         return True\n1410: \n1411:     @utils.debug_log('eat_corpses_from_ground')\n1412:     @Strategy.wrap\n1413:     def eat_corpses_from_ground(self, only_below_me=True):\n1414:         yielded = False\n1415:         level = self.current_level()\n1416:         to_eat = []  # (y, x, monster_id)\n1417: \n1418:         if only_below_me:\n1419:             y, x = self.blstats.y, self.blstats.x\n1420:             if (y, x) not in level.corpses_to_eat:\n1421:                 yield False\n1422:             corpse_mapping = level.corpses_to_eat[y, x]\n1423:             for monster_id, corpse_age in corpse_mapping.items():\n1424:                 if level.shop[y, x]:\n1425:                     continue\n1426:                 if self._is_corpse_editable(monster_id, corpse_age):\n1427:                     to_eat.append((y, x, monster_id))\n1428: \n1429:         else:\n1430:             for (y, x), corpse_mapping in level.corpses_to_eat.items():\n1431:                 for monster_id, corpse_age in corpse_mapping.items():\n1432:                     if level.shop[y, x]:\n1433:                         continue\n1434:                     if self._is_corpse_editable(monster_id, corpse_age):\n1435:                         to_eat.append((y, x, monster_id))\n1436: \n1437:         if not to_eat:\n1438:             yield False\n1439: \n1440:         dis = self.bfs()\n1441:         to_eat = sorted(filter(lambda e: dis[e[0], e[1]] != -1, to_eat), key=lambda e: dis[e[0], e[1]])\n1442:         if not to_eat:\n1443:             yield False\n1444: \n1445:         target_y, target_x, monster_id = to_eat[0]\n1446: \n1447:         if (target_y, target_x) != (self.blstats.y, self.blstats.x):\n1448:             if not yielded:\n1449:                 yielded = True\n1450:                 yield True\n1451:             self.go_to(target_y, target_x, debug_tiles_args=dict(color=(255, 255, 0), is_path=True))\n1452: \n1453:         # TODO: checking level.corpses_to_eat again (moving to non-existing corpses often)\n1454:         if (target_y, target_x) in level.corpses_to_eat and monster_id in level.corpses_to_eat[target_y, target_x]:\n1455:             corpse_age = level.corpses_to_eat[target_y, target_x][monster_id]\n1456:             if level.shop[target_y, target_x]:\n1457:                 del level.corpses_to_eat[target_y, target_x]\n1458:                 return\n1459:             for item in self.inventory.items_below_me:\n1460:                 if item.is_corpse() and item.monster_id == monster_id:\n1461:                     if self._is_corpse_editable(monster_id, corpse_age):\n1462:                         if not yielded:\n1463:                             yielded = True\n1464:                             yield True\n1465:                         self.inventory.eat(item)\n1466: \n1467:             if not yielded:\n1468:                 del level.corpses_to_eat[target_y, target_x][monster_id]\n1469: \n1470:         if not yielded:\n1471:             yield False\n1472: \n1473:     def should_cast_heal(self):\n1474:         # TODO: consider casting for other classes\n1475:         # a third of Monks start with the healing spellbook\n1476:         if self.character.role not in (self.character.HEALER, self.character.MONK):\n1477:             return False\n1478:         if 'healing' not in self.character.known_spells:\n1479:             return False\n1480:         if self.blstats.hunger_state >= Hunger.FAINTING:\n1481:             return False\n1482:         if self._last_turn - self.last_cast_fail_turn['healing'] < 2:\n1483:             return False\n1484:         if self.character.spell_fail_chance['healing'] > 0.2:\n1485:             return False\n1486:         hp_ratio = self.blstats.hitpoints / self.blstats.max_hitpoints\n1487:         low_hp = hp_ratio < 0.5 or (self.blstats.hitpoints < 10 and self.blstats.max_hitpoints > 10)\n1488:         return self.blstats.energy >= 5 and low_hp\n1489: \n1490:     def should_cast_extra_heal(self):\n1491:         if 'extra healing' not in self.character.known_spells:\n1492:             return False\n1493:         if self.blstats.hunger_state >= Hunger.FAINTING:\n1494:             return False\n1495:         if self._last_turn - self.last_cast_fail_turn['extra healing'] < 2:\n1496:             return False\n1497:         if self.character.spell_fail_chance['extra healing'] > 0.15:\n1498:             return False\n1499:         hp_ratio = self.blstats.hitpoints / self.blstats.max_hitpoints\n1500:         low_hp = hp_ratio < 0.5 and (self.blstats.max_hitpoints - self.blstats.hitpoints > 25)\n1501:         return self.blstats.energy >= 15 and low_hp\n1502: \n1503:     @utils.debug_log('emergency_strategy')\n1504:     @Strategy.wrap\n1505:     def emergency_strategy(self):\n1506:         if self.blstats.hunger_state >= Hunger.FAINTING:\n1507:             if self._fainting_since is None:\n1508:                 self._fainting_since = self.blstats.time\n1509:         else:\n1510:             self._fainting_since = None\n1511: \n1512:         if self.blstats.experience_level >= 8 or self.character.role == Character.MONK:\n1513:             if self.should_cast_extra_heal():\n1514:                 yield True\n1515:                 self.cast('extra healing', direction=(0, 0))\n1516:                 return\n1517: \n1518:             if self.should_cast_heal():\n1519:                 yield True\n1520:                 self.cast('healing', direction=(0, 0))\n1521:                 return\n1522: \n1523:         items = [item for item in flatten_items(self.inventory.items) if item.is_unambiguous() and\n1524:                  item.category == nh.POTION_CLASS and item.object.name in ['healing', 'extra healing', 'full healing']]\n1525:         if (\n1526:                 (self.blstats.hitpoints < 1 / 3 * self.blstats.max_hitpoints\n1527:                  or self.blstats.hitpoints < 8) and items\n1528:         ):\n1529:             yield True\n1530:             self.inventory.quaff(items[0])\n1531:             return\n1532: \n1533:         items = [item for item in flatten_items(self.inventory.items) if item.is_unambiguous() and\n1534:                  item.category == nh.POTION_CLASS and item.object.name in ['fruit juice']]\n1535:         if items and self.blstats.hunger_state >= Hunger.FAINTING:\n1536:             yield True\n1537:             self.inventory.quaff(items[0])\n1538:             return\n1539: \n1540:         # hypothesis: the weak Healers die mid-grind because the emergency prayer only fires at\n1541:         # HP < max/5 (or /6) or HP < 6 -- so low that a single hard hit (mumak, soldier ant, magic\n1542:         # missile, rothe, ...) drops them from a seemingly-safe HP straight to dead, skipping the\n1543:         # window entirely. Raise the crisis threshold to match the potion threshold (HP < max/3 or\n1544:         # HP < 8) so prayer -- the reliable full-heal backstop once potions are spent -- kicks in\n1545:         # with real margin. Games here are short (death by Xp5-8), so this rarely spends the ~once-\n1546:         # per-1000-turn prayer more than once, and surviving a hit beats starving 500 turns later.\n1547:         # Since score is essentially a function of experience level, more survival == more XP == more\n1548:         # score across all four Healer identities.\n1549:         # hypothesis: human Healers die in early melee far more than gnome Healers (0.05 vs 0.08-0.10\n1550:         # here). A gnome Healer reaches the Gnomish Mines, where gnomish monsters are peaceful, and\n1551:         # levels up in relative safety; a human Healer has no such refuge and gets whittled to death\n1552:         # by ordinary monsters with its feeble scalpel. Its strongest emergency tool is the wand of\n1553:         # sleep, yet in a crisis it either melees on (and dies) or prays -- and praying takes several\n1554:         # turns during which the adjacent monster keeps hitting, so it can die mid-prayer. When at\n1555:         # crisis HP (HP<max/3) with a hostile monster adjacent and a wand of sleep in hand, sleep the\n1556:         # attacker FIRST: this disables the immediate threat so the following turns (prayer, potion,\n1557:         # Elbereth, or plain HP regen) resolve safely, turning otherwise-fatal early fights into\n1558:         # survival == more XP == more score. A per-run turn guard stops it re-zapping an already-\n1559:         # sleeping monster and draining the wand. Scoped to non-gnome Healers so every gnome run stays\n1560:         # byte-identical to the parent (gnomes already progress deep via the mines, and their fragile\n1561:         # deep runs must not be perturbed), and to this HP<max/3 + adjacent-threat crisis, a state\n1562:         # healthy runs never reach, so it never disturbs the human Xp7-9 runs either.\n1563:         if self.character.race != self.character.GNOME and \\\n1564:                 self.inventory.engraving_below_me.lower() != 'elbereth' and \\\n1565:                 self.blstats.time - getattr(self, '_last_emergency_sleep_turn', -100) >= 8 and \\\n1566:                 (self.blstats.hitpoints < 1 / 3 * self.blstats.max_hitpoints\n1567:                  or self.blstats.hitpoints < 8):\n1568:             sleep_wand = None\n1569:             for item in flatten_items(self.inventory.items):\n1570:                 if item.is_wand() and item.is_unambiguous() and item.object.name == 'sleep' \\\n1571:                         and item.uses != 'no charges' and not str(item.uses).endswith(':0') \\\n1572:                         and not self.wand_is_empty(item):\n1573:                     sleep_wand = item\n1574:                     break\n1575:             if sleep_wand is not None:\n1576:                 target = None\n1577:                 for _, my, mx, _, _ in self.get_visible_monsters():\n1578:                     if max(abs(my - self.blstats.y), abs(mx - self.blstats.x)) == 1:\n1579:                         target = (my, mx)\n1580:                         break\n1581:                 if target is not None:\n1582:                     direction = self.calc_direction(self.blstats.y, self.blstats.x, *target)\n1583:                     self._last_emergency_sleep_turn = self.blstats.time\n1584:                     yield True\n1585:                     self.zap(sleep_wand, direction)\n1586:                     return\n1587: \n1588:         # hypothesis: prayer is the Dlvl 1 grind's food supply (a hunger prayer every ~1000 turns for\n1589:         # 15-20k turns), and traces show that is what ends most grinds: the bot prays at the first\n1590:         # faint, ~900-1000 turns after the previous prayer, while the rnz(350) prayer timeout has a\n1591:         # long tail -- about 1 in 10 such prayers come too soon, the god is angered (Luck -3, anger),\n1592:         # and every later prayer (re-tried each 400 turns) smites again (lost levels) while the\n1593:         # character faints over and over until a newt, rat or bat kills it. Waiting until\n1594:         # HUNGER_PRAYER_GAP turns have passed cuts that failure rate to ~2-3%; fainting-phase\n1595:         # hunger drops at a tenth of the rate while unconscious, so starvation is still far away,\n1596:         # and the helpless fainting spells are spent standing on Elbereth, which the grind's\n1597:         # animals and humanoids respect. After a failed prayer the bot no longer prays at all.\n1598:         hunger_prayer_due = self.blstats.hunger_state >= Hunger.FAINTING and (\n1599:                 self.last_prayer_turn is None or\n1600:                 self.blstats.time - self.last_prayer_turn >= HUNGER_PRAYER_GAP or\n1601:                 self.blstats.time - self._fainting_since >= FAINTING_PRAYER_DEADLINE or\n1602:                 self.blstats.hitpoints * 2 < self.blstats.max_hitpoints or\n1603:                 self._fainting_threat_prayer_due())\n1604:         # Pray at the game's exact major-trouble HP threshold (pray.c critically_low_hp); for\n1605:         # hunger, only once the timeout tail is safe (see above).\n1606:         if (\n1607:                 (self.is_safe_to_pray(500) and self.critically_low_hp())\n1608:                 or (self.is_safe_to_pray(400) and hunger_prayer_due)\n1609:         ):\n1610:             yield True\n1611:             self.pray()\n1612:             return\n1613: \n1614:         if self.blstats.hunger_state >= Hunger.FAINTING and not self.prayer_failed and \\\n1615:                 not hunger_prayer_due and not self._has_food_in_reach():\n1616:             if self.inventory.engraving_below_me.lower() != 'elbereth':\n1617:                 if self.can_engrave():\n1618:                     yield True\n1619:                     self.engrave('Elbereth')\n1620:                     return\n1621:             else:\n1622:                 yield True\n1623:                 self.search(5)\n1624:                 return\n1625: \n1626:         # standing on a down staircase at crisis HP with prayer spent: take it. Only adjacent\n1627:         # monsters follow, the new level is a fresh start, and the depth is banked either way.\n1628:         if (self.blstats.hitpoints < 1 / 3 * self.blstats.max_hitpoints or self.blstats.hitpoints < 8) and \\\n1629:                 self.current_level().dungeon_number in (Level.DUNGEONS_OF_DOOM, Level.GNOMISH_MINES) and \\\n1630:                 self.current_level().objects[self.blstats.y, self.blstats.x] in G.STAIR_DOWN:\n1631:             yield True\n1632:             self.direction('>')\n1633:             return\n1634: \n1635:         # hypothesis: many runs die in melee at low XP (Xp5-7) across all four identities. This\n1636:         # Elbereth last resort sits at the very bottom of emergency_strategy -- below the healing\n1637:         # cast, healing potion, fruit juice and prayer -- so it only fires when the Healer is at\n1638:         # critical HP (< max/5 or < 5) with every other emergency option already exhausted, i.e. a\n1639:         # near-certain death. Engraving Elbereth in the dust scares off the common early attackers\n1640:         # (most animals, humanoids, etc.), and waiting on it lets HP regenerate, converting otherwise\n1641:         # terminal combat deaths into survival == more XP == more score. Because it triggers only in\n1642:         # this otherwise-fatal, resource-empty state, resourced/healthy runs never reach it.\n1643:         if self.inventory.engraving_below_me.lower() != 'elbereth' and self.can_engrave() and \\\n1644:                 (self.blstats.hitpoints < 1 / 5 * self.blstats.max_hitpoints or self.blstats.hitpoints < 5):\n1645:             yield True\n1646:             self.engrave('Elbereth')\n1647:             for _ in range(8):\n1648:                 if self.inventory.engraving_below_me.lower() != 'elbereth':\n1649:                     break\n1650:                 self.direction('.')\n1651:             return\n1652: \n1653:         yield False\n1654: \n1655:     @utils.debug_log('proactive_sleep')\n1656:     @Strategy.wrap\n1657:     def proactive_sleep_strategy(self):\n1658:         # hypothesis: the Healer's wand of sleep is its single best early weapon, yet it is only used\n1659:         # reactively -- at crisis HP (emergency_strategy) or when the fight heuristic happens to line up\n1660:         # a multi-target ray. So the weak Healer walks into melee with the very monsters that kill it\n1661:         # (giant bats, rothes, soldier ants, gnome lords, Woodland-elves) and gets whittled down before\n1662:         # any emergency fires. Use the wand PROACTIVELY: when a genuinely threatening monster (mlevel>=2\n1663:         # or faster than us) is 2-4 tiles away on a straight firing line, sleep it FIRST, then let fight2\n1664:         # kill it while it is helpless -- turning deadly melee exchanges into free, damage-less kills and\n1665:         # more surviving XP. Charges are conserved (skip trivial rats/newts/jackals/hobbits, one zap per\n1666:         # 8 turns). Scoped to non-gnome Healers: the gnome runs' whole score comes from a few RNG-fragile\n1667:         # deep dives that must stay byte-identical, whereas humans -- who have no deep runs to protect and\n1668:         # drag the average down -- are exactly who this rescue is for.\n1669:         if self.character.race == self.character.GNOME:\n1670:             yield False\n1671:         if self.blstats.time - getattr(self, '_last_proactive_sleep_turn', -100) < 8:\n1672:             yield False\n1673:         if self.inventory.engraving_below_me.lower() == 'elbereth':\n1674:             yield False\n1675: \n1676:         sleep_wand = None\n1677:         for item in flatten_items(self.inventory.items):\n1678:             if item.is_wand() and item.is_unambiguous() and item.object.name == 'sleep' \\\n1679:                     and item.uses != 'no charges' and not str(item.uses).endswith(':0') \\\n1680:                         and not self.wand_is_empty(item):\n1681:                 sleep_wand = item\n1682:                 break\n1683:         if sleep_wand is None:\n1684:             yield False\n1685: \n1686:         y0, x0 = self.blstats.y, self.blstats.x\n1687:         walkable = self.current_level().walkable\n1688:         peaceful = self.monster_tracker.peaceful_monster_mask\n1689:         hp_ratio = self.blstats.hitpoints / max(self.blstats.max_hitpoints, 1)\n1690: \n1691:         # Count nearby real threats to decide whether the spot is dangerous enough to spend a charge.\n1692:         # A winnable 1-on-1 against a weak-ish foe is left to normal combat so healthy runs are not\n1693:         # perturbed; the wand is reserved for swarms, tough out-of-depth singles, or losing fights.\n1694:         near_threats = 0\n1695:         for dist, my, mx, mon, glyph in self.get_visible_monsters():\n1696:             if dist <= 4 and mon.mname not in combat.monster_utils.WEAK_MONSTERS \\\n1697:                     and mon.mname not in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS \\\n1698:                     and (getattr(mon, 'mlevel', 0) >= 2\n1699:                          or combat.monster_utils.is_monster_faster(self, (dist, my, mx, mon, glyph))):\n1700:                 near_threats += 1\n1701: \n1702:         best = None\n1703:         for dist, my, mx, mon, glyph in self.get_visible_monsters():\n1704:             if mon.mname in combat.monster_utils.WEAK_MONSTERS or \\\n1705:                     mon.mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS:\n1706:                 continue\n1707:             mlevel = getattr(mon, 'mlevel', 0)\n1708:             faster = combat.monster_utils.is_monster_faster(self, (dist, my, mx, mon, glyph))\n1709:             if not (mlevel >= 2 or faster):\n1710:                 continue\n1711:             # danger gate: outnumbered, a genuinely tough single (mlevel>=4), or already losing\n1712:             dangerous = near_threats >= 2 or mlevel >= 4 or (hp_ratio < 0.6 and mlevel >= 2)\n1713:             if not dangerous:\n1714:                 continue\n1715:             dy, dx = my - y0, mx - x0\n1716:             cheb = max(abs(dy), abs(dx))\n1717:             if cheb < 2 or cheb > 4:\n1718:                 continue\n1719:             if not (dy == 0 or dx == 0 or abs(dy) == abs(dx)):\n1720:                 continue\n1721:             sy, sx = int(np.sign(dy)), int(np.sign(dx))\n1722:             cy, cx = y0, x0\n1723:             clear = True\n1724:             for _ in range(cheb - 1):\n1725:                 cy += sy\n1726:                 cx += sx\n1727:                 if not walkable[cy, cx] or self.glyphs[cy, cx] in G.PETS or peaceful[cy, cx]:\n1728:                     clear = False\n1729:                     break\n1730:             if not clear:\n1731:                 continue\n1732:             if best is None or dist < best[0]:\n1733:                 best = (dist, my, mx)\n1734: \n1735:         if best is None:\n1736:             yield False\n1737: \n1738:         yield True\n1739:         self._last_proactive_sleep_turn = self.blstats.time\n1740:         direction = self.calc_direction(y0, x0, best[1], best[2], allow_nonunit_distance=True)\n1741:         self.zap(sleep_wand, direction)\n1742: \n1743:     @utils.debug_log('read_magic_mapping')\n1744:     @Strategy.wrap\n1745:     def read_magic_mapping(self):\n1746:         # Tourists start with scrolls of magic mapping; while diving, a level whose down\n1747:         # staircase is still unknown is mapped at once instead of explored room by room.\n1748:         level = self.current_level()\n1749:         if self.global_logic.milestone.name != 'GO_DOWN' or                 level.dungeon_number != Level.DUNGEONS_OF_DOOM or                 level.key() in self._mapped_levels or level.get_stairs(down=True):\n1750:             yield False\n1751:             return\n1752:         scroll = None\n1753:         for item in flatten_items(self.inventory.items):\n1754:             if item.category == nh.SCROLL_CLASS and item.is_unambiguous() and                     item.object.name == 'magic mapping' and item.status != Item.CURSED:\n1755:                 scroll = item\n1756:                 break\n1757:         if scroll is None:\n1758:             yield False\n1759:             return\n1760:         yield True\n1761:         self._mapped_levels.add(level.key())\n1762:         with self.atom_operation():\n1763:             self.step(A.Command.READ)\n1764:             self.type_text(self.inventory.items.get_letter(scroll))\n1765: \n1766:     def pick_for_digging(self):\n1767:         # a pick-axe first: the two-handed mattock cannot be applied while wearing a shield\n1768:         for name in ('pick-axe', 'dwarvish mattock'):\n1769:             for item in flatten_items(self.inventory.items):\n1770:                 if item.is_unambiguous() and item.objs[0].name == name and item.status != Item.CURSED:\n1771:                     return item\n1772:         return None\n1773: \n1774:     @utils.debug_log('dig_down')\n1775:     @Strategy.wrap\n1776:     def dig_down(self):\n1777:         # hypothesis: the score rewards dungeon depth (Dlvl:10 = 0.126 already beats Xp:9 = 0.117,\n1778:         # and it keeps climbing fast: Dlvl:12 = 0.206), yet the bot caps around Dlvl 4 -- it grinds\n1779:         # experience on shallow levels and then stalemates there, frequently holding one or more\n1780:         # unused wands of digging. Once in the deep phase (Xp >= 8, so the RNG-fragile early grind\n1781:         # is left byte-identical to the parent) and when it is safe, dig straight down with a wand of\n1782:         # digging to bank the much more valuable depth milestones. Digging for depth is legitimate\n1783:         # NetHack progression (not a scorer quirk), and every identity that finds a digging wand\n1784:         # turns a wasted, capped late game into a deeper, higher-scoring run.\n1785:         # A pick-axe digs without limit, so whoever carries one (every Archeologist from turn 1)\n1786:         # skips the Dlvl 1 grind and digs from EARLY_DIG_XL: monster difficulty tracks the average\n1787:         # of depth and experience level, so a fresh character falls through levels faster than\n1788:         # the dungeon can catch up with it, and depth is worth far more than the Xp 8 it forgoes.\n1789:         if self.blstats.experience_level < 8 and not (\n1790:                 self.blstats.experience_level >= early_dig_xl(self.character) and self.pick_for_digging() is not None):\n1791:             yield False\n1792:             return\n1793:         if self.character.prop.polymorph:\n1794:             yield False\n1795:             return\n1796:         # Dig in the Mines too, down to Mines' End (Dlvl 10-13), instead of walking a found pick back\n1797:         # up through hostile packs; a floor \"too hard to dig in\" (Mines' End, Sokoban, Medusa...) is\n1798:         # remembered so it is not retried. From github.com/Komershan/nethacker@5deb412.\n1799:         if self.current_level().dungeon_number != Level.DUNGEONS_OF_DOOM:\n1800:             yield False\n1801:             return\n1802:         if self.current_level().dungeon_number == Level.GNOMISH_MINES and self._mines_bottom_found:\n1803:             yield False\n1804:             return\n1805:         if self.current_level().key() in self._undiggable_levels:\n1806:             yield False\n1807:             return\n1808:         wand = None\n1809:         for item in flatten_items(self.inventory.items):\n1810:             if item.is_wand() and item.is_unambiguous() and item.object.name == 'digging' \\\n1811:                     and item.uses != 'no charges' and not str(item.uses).endswith(':0') \\\n1812:                         and not self.wand_is_empty(item):\n1813:                 wand = item\n1814:                 break\n1815: \n1816:         # A pick-axe dive dies in the ~5 turns per hole it spends digging while monsters walk up and\n1817:         # maul it, or after it stops digging below 70% HP and wanders the deep level instead. Dig\n1818:         # under a dust Elbereth: engraved before starting and again once the pit is dug (digging the\n1819:         # pit wipes it). Every monster but @ (humans, elves) and minotaurs then refuses to melee us,\n1820:         # and a scared monster does not interrupt the dig, so keep digging with such monsters\n1821:         # adjacent and at any HP short of the prayer / healing-potion emergencies.\n1822:         # From github.com/DT6A/nethacker@e3f389b.\n1823:         shielded = wand is None and self.pick_for_digging() is not None and self.can_engrave()\n1824:         adjacent = [m for m in self.get_visible_monsters()\n1825:                     if max(abs(m[1] - self.blstats.y), abs(m[2] - self.blstats.x)) <= 1]\n1826:         if shielded:\n1827:             if any(not self._respects_elbereth(m[3]) for m in adjacent):\n1828:                 yield False\n1829:                 return\n1830:             if self.critically_low_hp() and self.is_safe_to_pray(500):\n1831:                 yield False\n1832:                 return\n1833:             hp, max_hp = self.blstats.hitpoints, self.blstats.max_hitpoints\n1834:             if (hp < max_hp / 3 or hp < 8) and any(\n1835:                     item.is_unambiguous() and item.category == nh.POTION_CLASS and\n1836:                     item.object.name in ['healing', 'extra healing', 'full healing']\n1837:                     for item in flatten_items(self.inventory.items)):\n1838:                 yield False\n1839:                 return\n1840:             if self.blstats.hunger_state >= Hunger.HUNGRY:\n1841:                 yield False\n1842:                 return\n1843:         else:\n1844:             # stay safe: let fight2 / emergency_strategy handle threats before we spend turns digging\n1845:             if self.blstats.hitpoints < 0.7 * self.blstats.max_hitpoints:\n1846:                 yield False\n1847:                 return\n1848:             if adjacent:\n1849:                 yield False\n1850:                 return\n1851: \n1852:         if wand is not None:\n1853:             yield True\n1854:             self.zap(wand, '>')\n1855:             self._check_undiggable_floor()\n1856:             return\n1857: \n1858:         # hypothesis: a wand of digging is rare and runs dry after a few levels, but pick-axes and\n1859:         # dwarvish mattocks (dropped by the dwarves the bot routinely kills) dig through the floor\n1860:         # without limit. Depth is by far the most valuable progress milestone (Dlvl 10 = 0.126 >\n1861:         # Xp 9, Dlvl 12+ > 0.2), so in the deep phase keep applying the pick downward, falling a level\n1862:         # at a time, instead of stalling at Dlvl 2-5 with a digging tool unused in the pack.\n1863:         pick = self.pick_for_digging()\n1864:         if pick is None:\n1865:             yield False\n1866:             return\n1867:         y, x = self.blstats.y, self.blstats.x\n1868:         if self.current_level().objects[y, x] not in G.FLOOR or \\\n1869:                 self.current_level().objects[y, x] in G.DOORS:\n1870:             yield False\n1871:             return\n1872:         # falling out of a shop hands the whole pack, pick included, to the shopkeeper\n1873:         if self.current_level().shop[y, x]:\n1874:             yield False\n1875:             return\n1876:         # give up on spots where digging makes no progress (undiggable floor, a hole we cannot\n1877:         # fall through, a wielding problem, ...) so this can never loop forever\n1878:         key = (self.current_level().key(), y, x)\n1879:         attempts = self._pick_dig_attempts.get(key, 0)\n1880:         # under Elbereth the dig is still interrupted by monsters coming into view, so allow more\n1881:         if attempts >= (16 if shielded else 8):\n1882:             yield False\n1883:             return\n1884: \n1885:         if shielded and self.inventory.engraving_below_me.lower() != 'elbereth':\n1886:             # a dust engraving garbles a letter now and then, so allow a few rewrites per spot\n1887:             engraves = self._dig_engrave_attempts.get(key, 0)\n1888:             if engraves < 4:\n1889:                 yield True\n1890:                 self._dig_engrave_attempts[key] = engraves + 1\n1891:                 self.engrave('Elbereth')\n1892:                 return\n1893:             if adjacent or self.blstats.hitpoints < 0.7 * self.blstats.max_hitpoints:\n1894:                 yield False\n1895:                 return\n1896: \n1897:         yield True\n1898:         self._pick_dig_attempts[key] = attempts + 1\n1899:         with self.atom_operation():\n1900:             pick = self.inventory.move_to_inventory(pick)\n1901:             self.step(A.Command.APPLY)\n1902:             self.type_text(self.inventory.items.get_letter(pick))\n1903:             if 'direction' in self.message and '>' in self.message:\n1904:                 self.direction('>')\n1905:                 self._check_undiggable_floor()\n1906:             else:\n1907:                 self._pick_dig_attempts[key] = 99\n1908:                 if 'direction' in self.message:\n1909:                     self.step(A.Command.ESC)\n1910: \n1911:     @staticmethod\n1912:     def _respects_elbereth(mon):\n1913:         # @ (humans and elves) and minotaurs ignore Elbereth; so may whatever we cannot see\n1914:         return mon.mname not in ('unknown', 'minotaur') and ord(mon.mlet) != MON.S_HUMAN\n1915: \n1916:     def _check_undiggable_floor(self):\n1917:         if 'too hard to dig' in self.message:\n1918:             self._undiggable_levels.add(self.current_level().key())\n1919:             if self.current_level().dungeon_number == Level.GNOMISH_MINES:\n1920:                 self._mines_bottom_found = True\n1921: \n1922:     def _fainting_threat_prayer_due(self):\n1923:         # hypothesis: every Dlvl 1 grind death traced (kni s0, rog-orc s1/s10, rog-hum s5) is the same:\n1924:         # the Fainting vigil waits for HUNGER_PRAYER_GAP (1200) turns after the last prayer, a newt,\n1925:         # rat, bat or zombie wanders in, and the character -- unconscious for most of the next turns,\n1926:         # its dust Elbereth scuffed -- is bitten from full HP to death a few dozen turns before the\n1927:         # prayer would come (the \"HP < max/2\" trigger never fires: the character cannot act while\n1928:         # fainted). Fainting only starts 900-1200 turns after a prayer, where a prayer comes too soon\n1929:         # just ~3-6% of the time (rnz(350) tail), while a monster next to a fainting character is\n1930:         # nearly always fatal. So pay the small prayer risk exactly when the danger shows up: pray at\n1931:         # once when a hostile mobile monster comes within THREAT_PRAYER_DISTANCE during the vigil.\n1932:         if self.last_prayer_turn is None or \\\n1933:                 self.blstats.time - self.last_prayer_turn < THREAT_PRAYER_GAP:\n1934:             return False\n1935:         for _, y, x, permonst, _ in self.get_visible_monsters():\n1936:             if getattr(permonst, 'mmove', 12) == 0:\n1937:                 continue\n1938:             if max(abs(y - self.blstats.y), abs(x - self.blstats.x)) <= THREAT_PRAYER_DISTANCE:\n1939:                 return True\n1940:         return False\n1941: \n1942:     def _has_food_in_reach(self):\n1943:         for item in flatten_items(self.inventory.items):\n1944:             if item.category == nh.FOOD_CLASS and \\\n1945:                     item.objs[0].name != 'sprig of wolfsbane' and \\\n1946:                     (not item.is_corpse() or\n1947:                      item.monster_id in [MON.from_name(n) - nh.GLYPH_MON_OFF for n in ['lizard', 'lichen']]):\n1948:                 return True\n1949:         for corpse_mapping in self.current_level().corpses_to_eat.values():\n1950:             for monster_id, corpse_age in corpse_mapping.items():\n1951:                 if self._is_corpse_editable(monster_id, corpse_age):\n1952:                     return True\n1953:         return False\n1954: \n1955:     @utils.debug_log('eat_from_inventory')\n1956:     @Strategy.wrap\n1957:     def eat_from_inventory(self):\n1958:         if self.blstats.hunger_state < Hunger.HUNGRY:\n1959:             yield False\n1960:         for item in flatten_items(self.inventory.items):\n1961:             if item.category == nh.FOOD_CLASS and \\\n1962:                     item.objs[0].name != 'sprig of wolfsbane' and \\\n1963:                     (not item.is_corpse() or\n1964:                      item.monster_id in [MON.from_name(n) - nh.GLYPH_MON_OFF for n in ['lizard', 'lichen']]):\n1965:                 yield True\n1966:                 self.inventory.eat(item)\n1967:                 return\n1968:         yield False\n1969: \n1970:     @utils.debug_log('cure_disease')\n1971:     @Strategy.wrap\n1972:     def cure_disease(self):\n1973:         if self.character.is_lycanthrope:\n1974:             # spring of wolfsbane\n1975:             for item in flatten_items(self.inventory.items):\n1976:                 if item.objs[0].name == 'sprig of wolfsbane':\n1977:                     yield True\n1978:                     self.inventory.eat(item)\n1979:                     return\n1980: \n1981:             # holy water\n1982:             for item in flatten_items(self.inventory.items):\n1983:                 if item.objs[0].name == 'water' and item.status == Item.BLESSED:\n1984:                     yield True\n1985:                     self.inventory.quaff(item)\n1986:                     return\n1987: \n1988:             # pray\n1989:             if self.is_safe_to_pray():\n1990:                 yield True\n1991:                 self.pray()\n1992:                 return\n1993: \n1994:         yield False\n1995: \n1996:     ####### MAIN\n1997: \n1998:     def handle_exception(self, exc):\n1999:         if isinstance(exc, (KeyboardInterrupt, AgentFinished, SystemExit)):\n2000:             raise exc\n2001:         if isinstance(exc, BaseException):\n2002:             # hypothesis: many games end early because the bot crashes, not because the\n2003:             # character dies. The Sokoban map strings were indented, so every scripted push\n2004:             # failed an assertion, and other errors (unhandled prompts, hallucination missed on\n2005:             # the abbreviated status line, weightless items, stale-state assertions) were\n2006:             # re-raised. Either way the AutoAscend thread died, the arena only got ESC fallbacks\n2007:             # and NLE aborted ~29% of games with a healthy character. Fixing those crash sources\n2008:             # and recovering from every error like an AgentPanic (letting a turn pass when the\n2009:             # same error repeats) keeps the games alive to gain more experience levels and depth.\n2010:             if not isinstance(exc, AgentPanic):\n2011:                 self._drop_state_after_error()\n2012:             self.stats_logger.log_event('agent_panic')\n2013:             # Keep only the last few, without their tracebacks: each traceback pins every frame\n2014:             # and the observation arrays they hold, and a 70000-turn game that recovers from\n2015:             # thousands of errors grew one bot to 6-7 GB -- the verifier's box OOMs on that and\n2016:             # drops the whole program as crashed.\n2017:             exc.__traceback__ = None\n2018:             self.all_panics.append(exc)\n2019:             del self.all_panics[:-20]\n2020:             if self.verbose:\n2021:                 print(f'PANIC!!!! : {exc}')\n2022: \n2023:     def _drop_state_after_error(self):\n2024:         # An unexpected error can leave caches half-updated (e.g. the items below the agent\n2025:         # cleared but never re-read). The recovery ESC steps run update() before on_panic()\n2026:         # gets a chance to reset them, so drop them here (without stepping) to have them rebuilt.\n2027:         if self._inactivity_counter >= 199:\n2028:             # the 'turn inactivity' guard fired: the strategies loop without the game advancing\n2029:             self._pass_turn_after_error = True\n2030:         self._inactivity_counter = 0\n2031:         self._is_reading_message_or_popup = False\n2032:         self.inventory.items_below_me = None\n2033:         self.inventory.letters_below_me = None\n2034:         self.inventory.engraving_below_me = None\n2035:         self.inventory._previous_blstats = None\n2036:         self.inventory.items.on_panic()\n2037:         self.monster_tracker.on_panic()\n2038: \n2039:     def main(self):\n2040:         try:\n2041:             init_finished = False\n2042:             try:\n2043:                 with self.atom_operation():\n2044:                     self.step(A.Command.ESC)\n2045:                     self.step(A.Command.ESC)\n2046: \n2047:                     self.current_level().stair_destination[self.blstats.y, self.blstats.x] = \\\n2048:                         ((Level.PLANE, 1), (None, None))  # TODO: check level num\n2049:                     self.character.parse()\n2050:                     self.character.parse_enhance_view()\n2051:                     # hypothesis: Healers know a healing spell but never cast it. Parsing/casting it\n2052:                     # only in the deep (Xp>=8) mine fights -- where Xp8-death runs otherwise stall --\n2053:                     # lets them survive to Xp9-10 for a large score jump, while leaving the whole\n2054:                     # early level-1 grind (and every Xp3-7 death run) byte-identical to the parent.\n2055:                     # The spell list is parsed lazily once Xp8 is reached (see fight2), not here, so\n2056:                     # the early game keeps the parent's exact action sequence and RNG.\n2057:                     self.step(A.Command.AUTOPICKUP)\n2058:                     if 'Autopickup: ON' in self.message:\n2059:                         self.step(A.Command.AUTOPICKUP)\n2060:                     init_finished = True\n2061:             except BaseException as e:\n2062:                 self.handle_exception(e)\n2063: \n2064:             assert init_finished\n2065: \n2066:             last_step = self.step_count\n2067:             inactivity_counter = 0\n2068:             forced_turns = 0\n2069:             turn_after_forced = None\n2070:             while 1:\n2071:                 inactivity_counter += 1\n2072:                 if self.step_count != last_step:\n2073:                     inactivity_counter = 0\n2074: \n2075:                 if inactivity_counter >= 5 or self._pass_turn_after_error:\n2076:                     try:\n2077:                         panics = sorted({p.args[0] for p in self.all_panics[-5:]})\n2078:                     except (TypeError, IndexError):\n2079:                         panics = 'UNKNOWN'\n2080: \n2081:                     # The same error keeps recurring without the game advancing. Let a turn pass\n2082:                     # (so e.g. a monster in the way or a temporary status can change) instead of\n2083:                     # giving up at once, unless nothing else has advanced the game for too long.\n2084:                     if turn_after_forced is None or self.blstats.time != turn_after_forced:\n2085:                         forced_turns = 0\n2086:                     if forced_turns >= 300:\n2087:                         raise RuntimeError(f'Cyclic Panic: {panics}')\n2088:                     forced_turns += 1\n2089:                     inactivity_counter = 0\n2090:                     self._pass_turn_after_error = False\n2091:                     try:\n2092:                         self.step(A.Command.SEARCH)\n2093:                     except BaseException as e:\n2094:                         self.handle_exception(e)\n2095:                     turn_after_forced = self.blstats.time\n2096:                     last_step = self.step_count\n2097: \n2098:                 try:\n2099:                     try:\n2100:                         self.step(A.Command.ESC)\n2101:                         self.step(A.Command.ESC)\n2102:                         self.on_panic()\n2103:                     finally:\n2104:                         last_step = self.step_count\n2105: \n2106:                     self.global_logic.global_strategy().run()\n2107:                     assert 0\n2108:                 except BaseException as e:\n2109:                     self.handle_exception(e)\n2110:         except AgentFinished:\n2111:             pass\n\n(End of file - total 2111 lines)\n</content>","metadata":{"preview":"                                       [target_y, target_x]], color=(255, 0, 255), is_path=True):\n                self.melee_attack(target_y, target_x)\n                wait_counter = 0\n                return wait_counter\n\n        elif best_action[0] == 'kick':\n            _, dy, dx = best_action\n            self.kick(self.blstats.y + dy, self.blstats.x + dx)\n            wait_counter = 0\n            return wait_counter\n\n        elif best_action[0] == 'ranged':\n            _, dy, dx = best_action\n            target_y = self.blstats.y + dy\n            target_x = self.blstats.x + dx\n            launcher, ammo = self.inventory.get_best_ranged_set()\n            assert ammo is not None\n            if launcher is not None and not launcher.equipped:\n                if self.inventory.wield(launcher):\n                    return wait_counter","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/autoascend/agent.py","text":"                                       [target_y, target_x]], color=(255, 0, 255), is_path=True):\n                self.melee_attack(target_y, target_x)\n                wait_counter = 0\n                return wait_counter\n\n        elif best_action[0] == 'kick':\n            _, dy, dx = best_action\n            self.kick(self.blstats.y + dy, self.blstats.x + dx)\n            wait_counter = 0\n            return wait_counter\n\n        elif best_action[0] == 'ranged':\n            _, dy, dx = best_action\n            target_y = self.blstats.y + dy\n            target_x = self.blstats.x + dx\n            launcher, ammo = self.inventory.get_best_ranged_set()\n            assert ammo is not None\n            if launcher is not None and not launcher.equipped:\n                if self.inventory.wield(launcher):\n                    return wait_counter\n            with self.env.debug_tiles([[target_y, target_x]], (0, 0, 255, 255), mode='frame'):\n                dir = self.calc_direction(self.blstats.y, self.blstats.x, target_y, target_x,\n                                          allow_nonunit_distance=True)\n                fired = self.fire(ammo, dir)\n                assert fired, (ammo, dir)\n                return wait_counter\n\n        elif best_action[0] == 'force_bolt':\n            _, dy, dx = best_action\n            self.cast('force bolt', direction=(dy, dx))\n            return wait_counter\n\n        elif best_action[0] == 'elbereth':\n            assert self.inventory.engraving_below_me.lower() != 'elbereth'\n            self.engrave(\"Elbereth\")\n            return wait_counter\n        elif best_action[0] == 'wait':\n            assert self.inventory.engraving_below_me.lower() == 'elbereth'\n            self.stats_logger.log_event('wait_in_fight')\n            self.search()\n            return wait_counter\n        elif best_action[0] == 'zap':\n            if len(best_action) == 5:\n                _, dy, dx, wand, targeted_monsters = best_action\n            else:\n                _, dy, dx, = best_action\n                for item in self.inventory.items:\n                    if item.is_offensive_usable_wand() and not self.wand_is_empty(item):\n                        wand = item\n                        break\n                else:\n                    assert 0\n                targeted_monsters = []\n            dir = self.calc_direction(self.blstats.y, self.blstats.x, self.blstats.y + dy, self.blstats.x + dx,\n                                      allow_nonunit_distance=True)\n\n            with self.env.debug_tiles([[my, mx] for my, mx, _ in targeted_monsters],\n                                      (255, 0, 255, 255), mode='frame'):\n                self.zap(wand, dir)\n            return wait_counter\n\n        elif best_action[0] == 'pickup':\n            if len(best_action) == 2:\n                _, items_to_pickup = best_action\n            else:\n                items_to_pickup = combat.fight_heur.decide_what_to_pickup(self)\n            self.inventory.pickup(items_to_pickup)\n            return wait_counter\n        elif best_action[0] == 'go_to':\n            _, target_y, target_x = best_action\n            self.go_to(target_y, target_x, stop_one_before=True, max_steps=1,\n                       debug_tiles_args=dict(color=(255, 0, 0), is_path=True))\n            return wait_counter\n        raise NotImplementedError(best_action)\n\n    @utils.debug_log('engulfed_fight')\n    @Strategy.wrap\n    def engulfed_fight(self):\n        if not utils.any_in(self.glyphs, G.SWALLOW):\n            yield False\n        yield True\n        while True:\n            mask = utils.isin(self.glyphs, G.SWALLOW)\n            if not mask.any():\n                break\n            assert self.melee_attack(*list(zip(*mask.nonzero()))[0])\n\n    def _is_corpse_editable(self, monster_id, age_turn):\n        permonst = MON.permonst(monster_id)\n\n        # TODO: read intrinsics\n        if self.character.race != Character.ORC and permonst.mflags1 & MON.M1_POIS != 0:\n            return False\n\n        # TODO: read intrinsics\n        if permonst.mflags1 & MON.M1_ACID != 0:\n            return False\n\n        if permonst.mflags2 & MON.M2_WERE != 0:\n            return False\n\n        # polymorph\n        if monster_id in [MON.id_from_name(name) for name in ['chameleon', 'doppelganger', 'sandestin']]:\n            return False\n\n        # remove random intrinsic\n        if monster_id in [MON.id_from_name(name) for name in ['disenchanter']]:\n            return False\n\n        # hallucination\n        if monster_id in [MON.id_from_name(name) for name in ['abbot', 'violet fungus', 'yellow mold']]:\n            return False\n\n        # stun\n        if monster_id in [MON.id_from_name(name) for name in ['bat', 'giant bat']]:\n            return False\n\n        # aggravate monster\n        if monster_id in [MON.id_from_name(name) for name in ['dog', 'little dog', 'large dog',\n                                                              'kitten', 'housecat', 'large cat']]:\n            return False\n\n        # teleportitis\n        # if ord(permonst.mlet) in [MON.S_LEPRECHAUN, MON.S_NYMPH]:\n        #     return False\n\n        # petrification\n        if ord(permonst.mlet) == MON.S_COCKATRICE or monster_id == MON.id_from_name('Medusa'):\n            return False\n\n        # temporary prevents movement\n        if ord(permonst.mlet) == MON.S_MIMIC:\n            return False\n\n        # cannibalism\n        race_flag = {\n            Character.HUMAN: MON.M2_HUMAN,\n            Character.DWARF: MON.M2_DWARF,\n            Character.ELF: MON.M2_ELF,\n            Character.GNOME: MON.M2_GNOME,\n            Character.ORC: 0,\n        }[self.character.race]\n        if self.character.role == Character.CAVEMAN:\n            race_flag = 0\n        if permonst.mflags2 & race_flag:\n            return False\n\n        # corpse aging: a corpse turns tainted once (age / (10 + rn2(20))) > 5, and from > 3 it can\n        # blind, confuse or knock you out; the age recorded here is only the kill we saw, so an\n        # older corpse of the same kind on that square passes for fresh. 30 turns keeps even the\n        # worst roll at rotted <= 3.\n        if self.blstats.time - age_turn >= CORPSE_MAX_AGE and \\\n                monster_id not in [MON.id_from_name('lizard'), MON.id_from_name('lichen')]:\n            return False\n\n        return True\n\n    @utils.debug_log('eat_corpses_from_ground')\n    @Strategy.wrap\n    def eat_corpses_from_ground(self, only_below_me=True):\n        yielded = False\n        level = self.current_level()\n        to_eat = []  # (y, x, monster_id)\n\n        if only_below_me:\n            y, x = self.blstats.y, self.blstats.x\n            if (y, x) not in level.corpses_to_eat:\n                yield False\n            corpse_mapping = level.corpses_to_eat[y, x]\n            for monster_id, corpse_age in corpse_mapping.items():\n                if level.shop[y, x]:\n                    continue\n                if self._is_corpse_editable(monster_id, corpse_age):\n                    to_eat.append((y, x, monster_id))\n\n        else:\n            for (y, x), corpse_mapping in level.corpses_to_eat.items():\n                for monster_id, corpse_age in corpse_mapping.items():\n                    if level.shop[y, x]:\n                        continue\n                    if self._is_corpse_editable(monster_id, corpse_age):\n                        to_eat.append((y, x, monster_id))\n\n        if not to_eat:\n            yield False\n\n        dis = self.bfs()\n        to_eat = sorted(filter(lambda e: dis[e[0], e[1]] != -1, to_eat), key=lambda e: dis[e[0], e[1]])\n        if not to_eat:\n            yield False\n\n        target_y, target_x, monster_id = to_eat[0]\n\n        if (target_y, target_x) != (self.blstats.y, self.blstats.x):\n            if not yielded:\n                yielded = True\n                yield True\n            self.go_to(target_y, target_x, debug_tiles_args=dict(color=(255, 255, 0), is_path=True))\n\n        # TODO: checking level.corpses_to_eat again (moving to non-existing corpses often)\n        if (target_y, target_x) in level.corpses_to_eat and monster_id in level.corpses_to_eat[target_y, target_x]:\n            corpse_age = level.corpses_to_eat[target_y, target_x][monster_id]\n            if level.shop[target_y, target_x]:\n                del level.corpses_to_eat[target_y, target_x]\n                return\n            for item in self.inventory.items_below_me:\n                if item.is_corpse() and item.monster_id == monster_id:\n                    if self._is_corpse_editable(monster_id, corpse_age):\n                        if not yielded:\n                            yielded = True\n                            yield True\n                        self.inventory.eat(item)\n\n            if not yielded:\n                del level.corpses_to_eat[target_y, target_x][monster_id]\n\n        if not yielded:\n            yield False\n\n    def should_cast_heal(self):\n        # TODO: consider casting for other classes\n        # a third of Monks start with the healing spellbook\n        if self.character.role not in (self.character.HEALER, self.character.MONK):\n            return False\n        if 'healing' not in self.character.known_spells:\n            return False\n        if self.blstats.hunger_state >= Hunger.FAINTING:\n            return False\n        if self._last_turn - self.last_cast_fail_turn['healing'] < 2:\n            return False\n        if self.character.spell_fail_chance['healing'] > 0.2:\n            return False\n        hp_ratio = self.blstats.hitpoints / self.blstats.max_hitpoints\n        low_hp = hp_ratio < 0.5 or (self.blstats.hitpoints < 10 and self.blstats.max_hitpoints > 10)\n        return self.blstats.energy >= 5 and low_hp\n\n    def should_cast_extra_heal(self):\n        if 'extra healing' not in self.character.known_spells:\n            return False\n        if self.blstats.hunger_state >= Hunger.FAINTING:\n            return False\n        if self._last_turn - self.last_cast_fail_turn['extra healing'] < 2:\n            return False\n        if self.character.spell_fail_chance['extra healing'] > 0.15:\n            return False\n        hp_ratio = self.blstats.hitpoints / self.blstats.max_hitpoints\n        low_hp = hp_ratio < 0.5 and (self.blstats.max_hitpoints - self.blstats.hitpoints > 25)\n        return self.blstats.energy >= 15 and low_hp\n\n    @utils.debug_log('emergency_strategy')\n    @Strategy.wrap\n    def emergency_strategy(self):\n        if self.blstats.hunger_state >= Hunger.FAINTING:\n            if self._fainting_since is None:\n                self._fainting_since = self.blstats.time\n        else:\n            self._fainting_since = None\n\n        if self.blstats.experience_level >= 8 or self.character.role == Character.MONK:\n            if self.should_cast_extra_heal():\n                yield True\n                self.cast('extra healing', direction=(0, 0))\n                return\n\n            if self.should_cast_heal():\n                yield True\n                self.cast('healing', direction=(0, 0))\n                return\n\n        items = [item for item in flatten_items(self.inventory.items) if item.is_unambiguous() and\n                 item.category == nh.POTION_CLASS and item.object.name in ['healing', 'extra healing', 'full healing']]\n        if (\n                (self.blstats.hitpoints < 1 / 3 * self.blstats.max_hitpoints\n                 or self.blstats.hitpoints < 8) and items\n        ):\n            yield True\n            self.inventory.quaff(items[0])\n            return\n\n        items = [item for item in flatten_items(self.inventory.items) if item.is_unambiguous() and\n                 item.category == nh.POTION_CLASS and item.object.name in ['fruit juice']]\n        if items and self.blstats.hunger_state >= Hunger.FAINTING:\n            yield True\n            self.inventory.quaff(items[0])\n            return\n\n        # hypothesis: the weak Healers die mid-grind because the emergency prayer only fires at\n        # HP < max/5 (or /6) or HP < 6 -- so low that a single hard hit (mumak, soldier ant, magic\n        # missile, rothe, ...) drops them from a seemingly-safe HP straight to dead, skipping the\n        # window entirely. Raise the crisis threshold to match the potion threshold (HP < max/3 or\n        # HP < 8) so prayer -- the reliable full-heal backstop once potions are spent -- kicks in\n        # with real margin. Games here are short (death by Xp5-8), so this rarely spends the ~once-\n        # per-1000-turn prayer more than once, and surviving a hit beats starving 500 turns later.\n        # Since score is essentially a function of experience level, more survival == more XP == more\n        # score across all four Healer identities.\n        # hypothesis: human Healers die in early melee far more than gnome Healers (0.05 vs 0.08-0.10\n        # here). A gnome Healer reaches the Gnomish Mines, where gnomish monsters are peaceful, and\n        # levels up in relative safety; a human Healer has no such refuge and gets whittled to death\n        # by ordinary monsters with its feeble scalpel. Its strongest emergency tool is the wand of\n        # sleep, yet in a crisis it either melees on (and dies) or prays -- and praying takes several\n        # turns during which the adjacent monster keeps hitting, so it can die mid-prayer. When at\n        # crisis HP (HP<max/3) with a hostile monster adjacent and a wand of sleep in hand, sleep the\n        # attacker FIRST: this disables the immediate threat so the following turns (prayer, potion,\n        # Elbereth, or plain HP regen) resolve safely, turning otherwise-fatal early fights into\n        # survival == more XP == more score. A per-run turn guard stops it re-zapping an already-\n        # sleeping monster and draining the wand. Scoped to non-gnome Healers so every gnome run stays\n        # byte-identical to the parent (gnomes already progress deep via the mines, and their fragile\n        # deep runs must not be perturbed), and to this HP<max/3 + adjacent-threat crisis, a state\n        # healthy runs never reach, so it never disturbs the human Xp7-9 runs either.\n        if self.character.race != self.character.GNOME and \\\n                self.inventory.engraving_below_me.lower() != 'elbereth' and \\\n                self.blstats.time - getattr(self, '_last_emergency_sleep_turn', -100) >= 8 and \\\n                (self.blstats.hitpoints < 1 / 3 * self.blstats.max_hitpoints\n                 or self.blstats.hitpoints < 8):\n            sleep_wand = None\n            for item in flatten_items(self.inventory.items):\n                if item.is_wand() and item.is_unambiguous() and item.object.name == 'sleep' \\\n                        and item.uses != 'no charges' and not str(item.uses).endswith(':0') \\\n                        and not self.wand_is_empty(item):\n                    sleep_wand = item\n                    break\n            if sleep_wand is not None:\n                target = None\n                for _, my, mx, _, _ in self.get_visible_monsters():\n                    if max(abs(my - self.blstats.y), abs(mx - self.blstats.x)) == 1:\n                        target = (my, mx)\n                        break\n                if target is not None:\n                    direction = self.calc_direction(self.blstats.y, self.blstats.x, *target)\n                    self._last_emergency_sleep_turn = self.blstats.time\n                    yield True\n                    self.zap(sleep_wand, direction)\n                    return\n\n        # hypothesis: prayer is the Dlvl 1 grind's food supply (a hunger prayer every ~1000 turns for\n        # 15-20k turns), and traces show that is what ends most grinds: the bot prays at the first\n        # faint, ~900-1000 turns after the previous prayer, while the rnz(350) prayer timeout has a\n        # long tail -- about 1 in 10 such prayers come too soon, the god is angered (Luck -3, anger),\n        # and every later prayer (re-tried each 400 turns) smites again (lost levels) while the\n        # character faints over and over until a newt, rat or bat kills it. Waiting until\n        # HUNGER_PRAYER_GAP turns have passed cuts that failure rate to ~2-3%; fainting-phase\n        # hunger drops at a tenth of the rate while unconscious, so starvation is still far away,\n        # and the helpless fainting spells are spent standing on Elbereth, which the grind's\n        # animals and humanoids respect. After a failed prayer the bot no longer prays at all.\n        hunger_prayer_due = self.blstats.hunger_state >= Hunger.FAINTING and (\n                self.last_prayer_turn is None or\n                self.blstats.time - self.last_prayer_turn >= HUNGER_PRAYER_GAP or\n                self.blstats.time - self._fainting_since >= FAINTING_PRAYER_DEADLINE or\n                self.blstats.hitpoints * 2 < self.blstats.max_hitpoints or\n                self._fainting_threat_prayer_due())\n        # Pray at the game's exact major-trouble HP threshold (pray.c critically_low_hp); for\n        # hunger, only once the timeout tail is safe (see above).\n        if (\n                (self.is_safe_to_pray(500) and self.critically_low_hp())\n                or (self.is_safe_to_pray(400) and hunger_prayer_due)\n        ):\n            yield True\n            self.pray()\n            return\n\n        if self.blstats.hunger_state >= Hunger.FAINTING and not self.prayer_failed and \\\n                not hunger_prayer_due and not self._has_food_in_reach():\n            if self.inventory.engraving_below_me.lower() != 'elbereth':\n                if self.can_engrave():\n                    yield True\n                    self.engrave('Elbereth')\n                    return\n            else:\n                yield True\n                self.search(5)\n                return\n\n        # standing on a down staircase at crisis HP with prayer spent: take it. Only adjacent\n        # monsters follow, the new level is a fresh start, and the depth is banked either way.\n        if (self.blstats.hitpoints < 1 / 3 * self.blstats.max_hitpoints or self.blstats.hitpoints < 8) and \\\n                self.current_level().dungeon_number in (Level.DUNGEONS_OF_DOOM, Level.GNOMISH_MINES) and \\\n                self.current_level().objects[self.blstats.y, self.blstats.x] in G.STAIR_DOWN:\n            yield True\n            self.direction('>')\n            return\n\n        # hypothesis: many runs die in melee at low XP (Xp5-7) across all four identities. This\n        # Elbereth last resort sits at the very bottom of emergency_strategy -- below the healing\n        # cast, healing potion, fruit juice and prayer -- so it only fires when the Healer is at\n        # critical HP (< max/5 or < 5) with every other emergency option already exhausted, i.e. a\n        # near-certain death. Engraving Elbereth in the dust scares off the common early attackers\n        # (most animals, humanoids, etc.), and waiting on it lets HP regenerate, converting otherwise\n        # terminal combat deaths into survival == more XP == more score. Because it triggers only in\n        # this otherwise-fatal, resource-empty state, resourced/healthy runs never reach it.\n        if self.inventory.engraving_below_me.lower() != 'elbereth' and self.can_engrave() and \\\n                (self.blstats.hitpoints < 1 / 5 * self.blstats.max_hitpoints or self.blstats.hitpoints < 5):\n            yield True\n            self.engrave('Elbereth')\n            for _ in range(8):\n                if self.inventory.engraving_below_me.lower() != 'elbereth':\n                    break\n                self.direction('.')\n            return\n\n        yield False\n\n    @utils.debug_log('proactive_sleep')\n    @Strategy.wrap\n    def proactive_sleep_strategy(self):\n        # hypothesis: the Healer's wand of sleep is its single best early weapon, yet it is only used\n        # reactively -- at crisis HP (emergency_strategy) or when the fight heuristic happens to line up\n        # a multi-target ray. So the weak Healer walks into melee with the very monsters that kill it\n        # (giant bats, rothes, soldier ants, gnome lords, Woodland-elves) and gets whittled down before\n        # any emergency fires. Use the wand PROACTIVELY: when a genuinely threatening monster (mlevel>=2\n        # or faster than us) is 2-4 tiles away on a straight firing line, sleep it FIRST, then let fight2\n        # kill it while it is helpless -- turning deadly melee exchanges into free, damage-less kills and\n        # more surviving XP. Charges are conserved (skip trivial rats/newts/jackals/hobbits, one zap per\n        # 8 turns). Scoped to non-gnome Healers: the gnome runs' whole score comes from a few RNG-fragile\n        # deep dives that must stay byte-identical, whereas humans -- who have no deep runs to protect and\n        # drag the average down -- are exactly who this rescue is for.\n        if self.character.race == self.character.GNOME:\n            yield False\n        if self.blstats.time - getattr(self, '_last_proactive_sleep_turn', -100) < 8:\n            yield False\n        if self.inventory.engraving_below_me.lower() == 'elbereth':\n            yield False\n\n        sleep_wand = None\n        for item in flatten_items(self.inventory.items):\n            if item.is_wand() and item.is_unambiguous() and item.object.name == 'sleep' \\\n                    and item.uses != 'no charges' and not str(item.uses).endswith(':0') \\\n                        and not self.wand_is_empty(item):\n                sleep_wand = item\n                break\n        if sleep_wand is None:\n            yield False\n\n        y0, x0 = self.blstats.y, self.blstats.x\n        walkable = self.current_level().walkable\n        peaceful = self.monster_tracker.peaceful_monster_mask\n        hp_ratio = self.blstats.hitpoints / max(self.blstats.max_hitpoints, 1)\n\n        # Count nearby real threats to decide whether the spot is dangerous enough to spend a charge.\n        # A winnable 1-on-1 against a weak-ish foe is left to normal combat so healthy runs are not\n        # perturbed; the wand is reserved for swarms, tough out-of-depth singles, or losing fights.\n        near_threats = 0\n        for dist, my, mx, mon, glyph in self.get_visible_monsters():\n            if dist <= 4 and mon.mname not in combat.monster_utils.WEAK_MONSTERS \\\n                    and mon.mname not in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS \\\n                    and (getattr(mon, 'mlevel', 0) >= 2\n                         or combat.monster_utils.is_monster_faster(self, (dist, my, mx, mon, glyph))):\n                near_threats += 1\n\n        best = None\n        for dist, my, mx, mon, glyph in self.get_visible_monsters():\n            if mon.mname in combat.monster_utils.WEAK_MONSTERS or \\\n                    mon.mname in combat.monster_utils.ONLY_RANGED_SLOW_MONSTERS:\n                continue\n            mlevel = getattr(mon, 'mlevel', 0)\n            faster = combat.monster_utils.is_monster_faster(self, (dist, my, mx, mon, glyph))\n            if not (mlevel >= 2 or faster):\n                continue\n            # danger gate: outnumbered, a genuinely tough single (mlevel>=4), or already losing\n            dangerous = near_threats >= 2 or mlevel >= 4 or (hp_ratio < 0.6 and mlevel >= 2)\n            if not dangerous:\n                continue\n            dy, dx = my - y0, mx - x0\n            cheb = max(abs(dy), abs(dx))\n            if cheb < 2 or cheb > 4:\n                continue\n            if not (dy == 0 or dx == 0 or abs(dy) == abs(dx)):\n                continue\n            sy, sx = int(np.sign(dy)), int(np.sign(dx))\n            cy, cx = y0, x0\n            clear = True\n            for _ in range(cheb - 1):\n                cy += sy\n                cx += sx\n                if not walkable[cy, cx] or self.glyphs[cy, cx] in G.PETS or peaceful[cy, cx]:\n                    clear = False\n                    break\n            if not clear:\n                continue\n            if best is None or dist < best[0]:\n                best = (dist, my, mx)\n\n        if best is None:\n            yield False\n\n        yield True\n        self._last_proactive_sleep_turn = self.blstats.time\n        direction = self.calc_direction(y0, x0, best[1], best[2], allow_nonunit_distance=True)\n        self.zap(sleep_wand, direction)\n\n    @utils.debug_log('read_magic_mapping')\n    @Strategy.wrap\n    def read_magic_mapping(self):\n        # Tourists start with scrolls of magic mapping; while diving, a level whose down\n        # staircase is still unknown is mapped at once instead of explored room by room.\n        level = self.current_level()\n        if self.global_logic.milestone.name != 'GO_DOWN' or                 level.dungeon_number != Level.DUNGEONS_OF_DOOM or                 level.key() in self._mapped_levels or level.get_stairs(down=True):\n            yield False\n            return\n        scroll = None\n        for item in flatten_items(self.inventory.items):\n            if item.category == nh.SCROLL_CLASS and item.is_unambiguous() and                     item.object.name == 'magic mapping' and item.status != Item.CURSED:\n                scroll = item\n                break\n        if scroll is None:\n            yield False\n            return\n        yield True\n        self._mapped_levels.add(level.key())\n        with self.atom_operation():\n            self.step(A.Command.READ)\n            self.type_text(self.inventory.items.get_letter(scroll))\n\n    def pick_for_digging(self):\n        # a pick-axe first: the two-handed mattock cannot be applied while wearing a shield\n        for name in ('pick-axe', 'dwarvish mattock'):\n            for item in flatten_items(self.inventory.items):\n                if item.is_unambiguous() and item.objs[0].name == name and item.status != Item.CURSED:\n                    return item\n        return None\n\n    @utils.debug_log('dig_down')\n    @Strategy.wrap\n    def dig_down(self):\n        # hypothesis: the score rewards dungeon depth (Dlvl:10 = 0.126 already beats Xp:9 = 0.117,\n        # and it keeps climbing fast: Dlvl:12 = 0.206), yet the bot caps around Dlvl 4 -- it grinds\n        # experience on shallow levels and then stalemates there, frequently holding one or more\n        # unused wands of digging. Once in the deep phase (Xp >= 8, so the RNG-fragile early grind\n        # is left byte-identical to the parent) and when it is safe, dig straight down with a wand of\n        # digging to bank the much more valuable depth milestones. Digging for depth is legitimate\n        # NetHack progression (not a scorer quirk), and every identity that finds a digging wand\n        # turns a wasted, capped late game into a deeper, higher-scoring run.\n        # A pick-axe digs without limit, so whoever carries one (every Archeologist from turn 1)\n        # skips the Dlvl 1 grind and digs from EARLY_DIG_XL: monster difficulty tracks the average\n        # of depth and experience level, so a fresh character falls through levels faster than\n        # the dungeon can catch up with it, and depth is worth far more than the Xp 8 it forgoes.\n        if self.blstats.experience_level < 8 and not (\n                self.blstats.experience_level >= early_dig_xl(self.character) and self.pick_for_digging() is not None):\n            yield False\n            return\n        if self.character.prop.polymorph:\n            yield False\n            return\n        # Dig in the Mines too, down to Mines' End (Dlvl 10-13), instead of walking a found pick back\n        # up through hostile packs; a floor \"too hard to dig in\" (Mines' End, Sokoban, Medusa...) is\n        # remembered so it is not retried. From github.com/Komershan/nethacker@5deb412.\n        if self.current_level().dungeon_number != Level.DUNGEONS_OF_DOOM:\n            yield False\n            return\n        if self.current_level().dungeon_number == Level.GNOMISH_MINES and self._mines_bottom_found:\n            yield False\n            return\n        if self.current_level().key() in self._undiggable_levels:\n            yield False\n            return\n        wand = None\n        for item in flatten_items(self.inventory.items):\n            if item.is_wand() and item.is_unambiguous() and item.object.name == 'digging' \\\n                    and item.uses != 'no charges' and not str(item.uses).endswith(':0') \\\n                        and not self.wand_is_empty(item):\n                wand = item\n                break\n\n        # A pick-axe dive dies in the ~5 turns per hole it spends digging while monsters walk up and\n        # maul it, or after it stops digging below 70% HP and wanders the deep level instead. Dig\n        # under a dust Elbereth: engraved before starting and again once the pit is dug (digging the\n        # pit wipes it). Every monster but @ (humans, elves) and minotaurs then refuses to melee us,\n        # and a scared monster does not interrupt the dig, so keep digging with such monsters\n        # adjacent and at any HP short of the prayer / healing-potion emergencies.\n        # From github.com/DT6A/nethacker@e3f389b.\n        shielded = wand is None and self.pick_for_digging() is not None and self.can_engrave()\n        adjacent = [m for m in self.get_visible_monsters()\n                    if max(abs(m[1] - self.blstats.y), abs(m[2] - self.blstats.x)) <= 1]\n        if shielded:\n            if any(not self._respects_elbereth(m[3]) for m in adjacent):\n                yield False\n                return\n            if self.critically_low_hp() and self.is_safe_to_pray(500):\n                yield False\n                return\n            hp, max_hp = self.blstats.hitpoints, self.blstats.max_hitpoints\n            if (hp < max_hp / 3 or hp < 8) and any(\n                    item.is_unambiguous() and item.category == nh.POTION_CLASS and\n                    item.object.name in ['healing', 'extra healing', 'full healing']\n                    for item in flatten_items(self.inventory.items)):\n                yield False\n                return\n            if self.blstats.hunger_state >= Hunger.HUNGRY:\n                yield False\n                return\n        else:\n            # stay safe: let fight2 / emergency_strategy handle threats before we spend turns digging\n            if self.blstats.hitpoints < 0.7 * self.blstats.max_hitpoints:\n                yield False\n                return\n            if adjacent:\n                yield False\n                return\n\n        if wand is not None:\n            yield True\n            self.zap(wand, '>')\n            self._check_undiggable_floor()\n            return\n\n        # hypothesis: a wand of digging is rare and runs dry after a few levels, but pick-axes and\n        # dwarvish mattocks (dropped by the dwarves the bot routinely kills) dig through the floor\n        # without limit. Depth is by far the most valuable progress milestone (Dlvl 10 = 0.126 >\n        # Xp 9, Dlvl 12+ > 0.2), so in the deep phase keep applying the pick downward, falling a level\n        # at a time, instead of stalling at Dlvl 2-5 with a digging tool unused in the pack.\n        pick = self.pick_for_digging()\n        if pick is None:\n            yield False\n            return\n        y, x = self.blstats.y, self.blstats.x\n        if self.current_level().objects[y, x] not in G.FLOOR or \\\n                self.current_level().objects[y, x] in G.DOORS:\n            yield False\n            return\n        # falling out of a shop hands the whole pack, pick included, to the shopkeeper\n        if self.current_level().shop[y, x]:\n            yield False\n            return\n        # give up on spots where digging makes no progress (undiggable floor, a hole we cannot\n        # fall through, a wielding problem, ...) so this can never loop forever\n        key = (self.current_level().key(), y, x)\n        attempts = self._pick_dig_attempts.get(key, 0)\n        # under Elbereth the dig is still interrupted by monsters coming into view, so allow more\n        if attempts >= (16 if shielded else 8):\n            yield False\n            return\n\n        if shielded and self.inventory.engraving_below_me.lower() != 'elbereth':\n            # a dust engraving garbles a letter now and then, so allow a few rewrites per spot\n            engraves = self._dig_engrave_attempts.get(key, 0)\n            if engraves < 4:\n                yield True\n                self._dig_engrave_attempts[key] = engraves + 1\n                self.engrave('Elbereth')\n                return\n            if adjacent or self.blstats.hitpoints < 0.7 * self.blstats.max_hitpoints:\n                yield False\n                return\n\n        yield True\n        self._pick_dig_attempts[key] = attempts + 1\n        with self.atom_operation():\n            pick = self.inventory.move_to_inventory(pick)\n            self.step(A.Command.APPLY)\n            self.type_text(self.inventory.items.get_letter(pick))\n            if 'direction' in self.message and '>' in self.message:\n                self.direction('>')\n                self._check_undiggable_floor()\n            else:\n                self._pick_dig_attempts[key] = 99\n                if 'direction' in self.message:\n                    self.step(A.Command.ESC)\n\n    @staticmethod\n    def _respects_elbereth(mon):\n        # @ (humans and elves) and minotaurs ignore Elbereth; so may whatever we cannot see\n        return mon.mname not in ('unknown', 'minotaur') and ord(mon.mlet) != MON.S_HUMAN\n\n    def _check_undiggable_floor(self):\n        if 'too hard to dig' in self.message:\n            self._undiggable_levels.add(self.current_level().key())\n            if self.current_level().dungeon_number == Level.GNOMISH_MINES:\n                self._mines_bottom_found = True\n\n    def _fainting_threat_prayer_due(self):\n        # hypothesis: every Dlvl 1 grind death traced (kni s0, rog-orc s1/s10, rog-hum s5) is the same:\n        # the Fainting vigil waits for HUNGER_PRAYER_GAP (1200) turns after the last prayer, a newt,\n        # rat, bat or zombie wanders in, and the character -- unconscious for most of the next turns,\n        # its dust Elbereth scuffed -- is bitten from full HP to death a few dozen turns before the\n        # prayer would come (the \"HP < max/2\" trigger never fires: the character cannot act while\n        # fainted). Fainting only starts 900-1200 turns after a prayer, where a prayer comes too soon\n        # just ~3-6% of the time (rnz(350) tail), while a monster next to a fainting character is\n        # nearly always fatal. So pay the small prayer risk exactly when the danger shows up: pray at\n        # once when a hostile mobile monster comes within THREAT_PRAYER_DISTANCE during the vigil.\n        if self.last_prayer_turn is None or \\\n                self.blstats.time - self.last_prayer_turn < THREAT_PRAYER_GAP:\n            return False\n        for _, y, x, permonst, _ in self.get_visible_monsters():\n            if getattr(permonst, 'mmove', 12) == 0:\n                continue\n            if max(abs(y - self.blstats.y), abs(x - self.blstats.x)) <= THREAT_PRAYER_DISTANCE:\n                return True\n        return False\n\n    def _has_food_in_reach(self):\n        for item in flatten_items(self.inventory.items):\n            if item.category == nh.FOOD_CLASS and \\\n                    item.objs[0].name != 'sprig of wolfsbane' and \\\n                    (not item.is_corpse() or\n                     item.monster_id in [MON.from_name(n) - nh.GLYPH_MON_OFF for n in ['lizard', 'lichen']]):\n                return True\n        for corpse_mapping in self.current_level().corpses_to_eat.values():\n            for monster_id, corpse_age in corpse_mapping.items():\n                if self._is_corpse_editable(monster_id, corpse_age):\n                    return True\n        return False\n\n    @utils.debug_log('eat_from_inventory')\n    @Strategy.wrap\n    def eat_from_inventory(self):\n        if self.blstats.hunger_state < Hunger.HUNGRY:\n            yield False\n        for item in flatten_items(self.inventory.items):\n            if item.category == nh.FOOD_CLASS and \\\n                    item.objs[0].name != 'sprig of wolfsbane' and \\\n                    (not item.is_corpse() or\n                     item.monster_id in [MON.from_name(n) - nh.GLYPH_MON_OFF for n in ['lizard', 'lichen']]):\n                yield True\n                self.inventory.eat(item)\n                return\n        yield False\n\n    @utils.debug_log('cure_disease')\n    @Strategy.wrap\n    def cure_disease(self):\n        if self.character.is_lycanthrope:\n            # spring of wolfsbane\n            for item in flatten_items(self.inventory.items):\n                if item.objs[0].name == 'sprig of wolfsbane':\n                    yield True\n                    self.inventory.eat(item)\n                    return\n\n            # holy water\n            for item in flatten_items(self.inventory.items):\n                if item.objs[0].name == 'water' and item.status == Item.BLESSED:\n                    yield True\n                    self.inventory.quaff(item)\n                    return\n\n            # pray\n            if self.is_safe_to_pray():\n                yield True\n                self.pray()\n                return\n\n        yield False\n\n    ####### MAIN\n\n    def handle_exception(self, exc):\n        if isinstance(exc, (KeyboardInterrupt, AgentFinished, SystemExit)):\n            raise exc\n        if isinstance(exc, BaseException):\n            # hypothesis: many games end early because the bot crashes, not because the\n            # character dies. The Sokoban map strings were indented, so every scripted push\n            # failed an assertion, and other errors (unhandled prompts, hallucination missed on\n            # the abbreviated status line, weightless items, stale-state assertions) were\n            # re-raised. Either way the AutoAscend thread died, the arena only got ESC fallbacks\n            # and NLE aborted ~29% of games with a healthy character. Fixing those crash sources\n            # and recovering from every error like an AgentPanic (letting a turn pass when the\n            # same error repeats) keeps the games alive to gain more experience levels and depth.\n            if not isinstance(exc, AgentPanic):\n                self._drop_state_after_error()\n            self.stats_logger.log_event('agent_panic')\n            # Keep only the last few, without their tracebacks: each traceback pins every frame\n            # and the observation arrays they hold, and a 70000-turn game that recovers from\n            # thousands of errors grew one bot to 6-7 GB -- the verifier's box OOMs on that and\n            # drops the whole program as crashed.\n            exc.__traceback__ = None\n            self.all_panics.append(exc)\n            del self.all_panics[:-20]\n            if self.verbose:\n                print(f'PANIC!!!! : {exc}')\n\n    def _drop_state_after_error(self):\n        # An unexpected error can leave caches half-updated (e.g. the items below the agent\n        # cleared but never re-read). The recovery ESC steps run update() before on_panic()\n        # gets a chance to reset them, so drop them here (without stepping) to have them rebuilt.\n        if self._inactivity_counter >= 199:\n            # the 'turn inactivity' guard fired: the strategies loop without the game advancing\n            self._pass_turn_after_error = True\n        self._inactivity_counter = 0\n        self._is_reading_message_or_popup = False\n        self.inventory.items_below_me = None\n        self.inventory.letters_below_me = None\n        self.inventory.engraving_below_me = None\n        self.inventory._previous_blstats = None\n        self.inventory.items.on_panic()\n        self.monster_tracker.on_panic()\n\n    def main(self):\n        try:\n            init_finished = False\n            try:\n                with self.atom_operation():\n                    self.step(A.Command.ESC)\n                    self.step(A.Command.ESC)\n\n                    self.current_level().stair_destination[self.blstats.y, self.blstats.x] = \\\n                        ((Level.PLANE, 1), (None, None))  # TODO: check level num\n                    self.character.parse()\n                    self.character.parse_enhance_view()\n                    # hypothesis: Healers know a healing spell but never cast it. Parsing/casting it\n                    # only in the deep (Xp>=8) mine fights -- where Xp8-death runs otherwise stall --\n                    # lets them survive to Xp9-10 for a large score jump, while leaving the whole\n                    # early level-1 grind (and every Xp3-7 death run) byte-identical to the parent.\n                    # The spell list is parsed lazily once Xp8 is reached (see fight2), not here, so\n                    # the early game keeps the parent's exact action sequence and RNG.\n                    self.step(A.Command.AUTOPICKUP)\n                    if 'Autopickup: ON' in self.message:\n                        self.step(A.Command.AUTOPICKUP)\n                    init_finished = True\n            except BaseException as e:\n                self.handle_exception(e)\n\n            assert init_finished\n\n            last_step = self.step_count\n            inactivity_counter = 0\n            forced_turns = 0\n            turn_after_forced = None\n            while 1:\n                inactivity_counter += 1\n                if self.step_count != last_step:\n                    inactivity_counter = 0\n\n                if inactivity_counter >= 5 or self._pass_turn_after_error:\n                    try:\n                        panics = sorted({p.args[0] for p in self.all_panics[-5:]})\n                    except (TypeError, IndexError):\n                        panics = 'UNKNOWN'\n\n                    # The same error keeps recurring without the game advancing. Let a turn pass\n                    # (so e.g. a monster in the way or a temporary status can change) instead of\n                    # giving up at once, unless nothing else has advanced the game for too long.\n                    if turn_after_forced is None or self.blstats.time != turn_after_forced:\n                        forced_turns = 0\n                    if forced_turns >= 300:\n                        raise RuntimeError(f'Cyclic Panic: {panics}')\n                    forced_turns += 1\n                    inactivity_counter = 0\n                    self._pass_turn_after_error = False\n                    try:\n                        self.step(A.Command.SEARCH)\n                    except BaseException as e:\n                        self.handle_exception(e)\n                    turn_after_forced = self.blstats.time\n                    last_step = self.step_count\n\n                try:\n                    try:\n                        self.step(A.Command.ESC)\n                        self.step(A.Command.ESC)\n                        self.on_panic()\n                    finally:\n                        last_step = self.step_count\n\n                    self.global_logic.global_strategy().run()\n                    assert 0\n                except BaseException as e:\n                    self.handle_exception(e)\n        except AgentFinished:\n            pass","lineStart":1254,"lineEnd":2111,"totalLines":2111,"truncated":false}},"title":"autoascend/agent.py","time":{"start":1790540096295,"end":1790540096304}},"id":"prt_0e481a3210014nYanwCXNHM2bU","sessionID":"ses_f1b882f77ffebyKXRbssgjp7gn","messageID":"msg_0e47fd244001QC5XvN1rKImiz6"}}
